import { Token } from "../stage1/token.ku"
import { Scan } from "../stage1/lexer.ku"
import { Span, SpanFromToken, SpanMerge } from "./span.ku"
import { Node, Arena, ParseOutput, ValidateParseOutput } from "./ast.ku"
import { ParseContext, DefaultParseContext, ParseContextError, RelocateTokens } from "./context.ku"
import { OperatorEntry, ValueEntry, MakeOperator, OperatorSpan, ExpressionSpan, MakeExpressionNode, IsNamedStructStart, IsBraceLiteralMarker, ReadBinaryOperator, ReadPrimaryAtom, RejectAt, RejectAtPoint } from "./expression_support.ku"

// Stage 2B uses append-only operator/value stacks and integer links. Flat
// binary and postfix chains are iterative; nested delimiters and unary prefixes
// consume the explicit depth budget. Every loop either consumes a token, pops
// an operator, or walks a value chain bounded by the 4096-token contract.

fn ParseWithContext(source: str, context: ParseContext): ParseOutput! {
    // Reject caller-controlled diagnostic identity before inspecting source.
    // The payload always uses the fixed logical source name <source>.
    stage3_domain = context.diagnostic_domain == "bootstrap.parser.stage3"
    if (!stage3_domain && context.diagnostic_domain != "bootstrap.parser") {
        RejectAtPoint("invalid_parse_context", "parse diagnostic domain is not permitted", false)?
    }
    source_characters = source.len()
    source_bytes = source.byte_len()
    tokens = Scan(source)?
    if (tokens.len() == 0) {
        RejectAtPoint("invalid_token_stream", "token stream must end in exactly one EOF", stage3_domain)?
    }
    context_error = ParseContextError(source_characters, source_bytes, tokens[tokens.len() - 1].clone(), context.clone())
    if (context_error != "") { RejectAt(tokens[0].clone(), "invalid_parse_context", context_error, stage3_domain)? }
    return ParseTokenWindow(RelocateTokens(tokens, context), stage3_domain)
}

// Validate the token window before the parser creates any arena state.
fn ValidateTokenWindow(&tokens: [Token], stage3_domain: bool): null! {
    if (tokens.len() == 0) {
        RejectAtPoint("invalid_token_stream", "token stream must end in exactly one EOF", stage3_domain)?
    }
    if (tokens.len() > 4096) {
        RejectAt(tokens[0].clone(), "invalid_token_stream", "stage-2 parser accepts at most 4096 tokens", stage3_domain)?
    }
    cursor = 0
    while (cursor < tokens.len() - 1) {
        if (tokens[cursor].kind == "Eof") {
            RejectAt(tokens[cursor].clone(), "invalid_token_stream", "EOF must be the final token", stage3_domain)?
        }
        cursor = cursor + 1
    }
    if (tokens[tokens.len() - 1].kind != "Eof") {
        RejectAt(tokens[tokens.len() - 1].clone(), "invalid_token_stream", "token stream is missing EOF", stage3_domain)?
    }
    return ok(null)
}

// Parse a bounded window whose tokens already carry absolute positions.
// The caller supplies exactly one terminal EOF, with the desired error span.
fn ParseTokenWindow(tokens: [Token], stage3_domain: bool): ParseOutput! {
    ValidateTokenWindow(tokens, stage3_domain)?
    cursor = 0
    depth = 1
    brace_depth = 0
    arena_nodes: [Node] = []
    arena_edges: [int] = []
    operators: [OperatorEntry] = []
    values: [ValueEntry] = []
    operator_top = 0
    value_top = 0

    fn AddNode(kind: str, text: str, int_value: int, span: Span, children: [int]): int! {
        if (arena_nodes.len() >= 4096) {
            RejectAt(tokens[cursor].clone(), "node_limit", "stage-2 parser accepts at most 4096 AST nodes", stage3_domain)?
        }
        if (children.len() > 8192 - arena_edges.len()) {
            RejectAt(tokens[cursor].clone(), "edge_limit", "stage-2 parser accepts at most 8192 AST edges", stage3_domain)?
        }
        first_edge = arena_edges.len()
        for child in children {
            if (child <= 0 || child > arena_nodes.len()) {
                RejectAt(tokens[cursor].clone(), "invalid_node_id", "AST edge references an invalid NodeId", stage3_domain)?
            }
            arena_edges = arena_edges.push(child)
        }
        node = MakeExpressionNode(kind, text, int_value, span, first_edge, arena_edges.len() - first_edge)
        arena_nodes = arena_nodes.push(node)
        return ok(arena_nodes.len())
    }

    // Reduction does not call back into the delimiter or continuation
    // helpers. Their references to this callable stay acyclic.
    fn ReduceTop(): null! {
        if (operator_top == 0 || operators[operator_top - 1].marker != "" || value_top == 0) {
            RejectAt(tokens[cursor].clone(), "invalid_expression", "operator has no operand", stage3_domain)?
        }
        operator = operators[operator_top - 1].clone()
        operator_top = operator.previous
        right_entry = values[value_top - 1].clone()
        value_top = right_entry.previous
        if (operator.unary) {
            child = arena_nodes[right_entry.node - 1].clone()
            if (arena_nodes.len() >= 4096) {
                RejectAt(tokens[cursor].clone(), "node_limit", "stage-2 parser accepts at most 4096 AST nodes", stage3_domain)?
            }
            if (arena_edges.len() >= 8192) {
                RejectAt(tokens[cursor].clone(), "edge_limit", "stage-2 parser accepts at most 8192 AST edges", stage3_domain)?
            }
            first_edge = arena_edges.len()
            arena_edges = arena_edges.push(right_entry.node)
            span = SpanMerge(OperatorSpan(operator), ExpressionSpan(child))
            unary_node = MakeExpressionNode("Unary", operator.text, 0, span, first_edge, 1)
            arena_nodes = arena_nodes.push(unary_node)
            combined = arena_nodes.len()
            combined_entry = ValueEntry { node: combined, previous: value_top }
            values = values.push(combined_entry)
            value_top = values.len()
            depth = depth - 1
            return ok(null)
        }
        if (value_top == 0) {
            RejectAt(tokens[cursor].clone(), "invalid_expression", "binary operator has no left operand", stage3_domain)?
        }
        left_entry = values[value_top - 1].clone()
        value_top = left_entry.previous
        left = arena_nodes[left_entry.node - 1].clone()
        right = arena_nodes[right_entry.node - 1].clone()
        if (arena_nodes.len() >= 4096) {
            RejectAt(tokens[cursor].clone(), "node_limit", "stage-2 parser accepts at most 4096 AST nodes", stage3_domain)?
        }
        if (arena_edges.len() > 8190) {
            RejectAt(tokens[cursor].clone(), "edge_limit", "stage-2 parser accepts at most 8192 AST edges", stage3_domain)?
        }
        first_edge = arena_edges.len()
        arena_edges = arena_edges.push(left_entry.node)
        arena_edges = arena_edges.push(right_entry.node)
        span = SpanMerge(ExpressionSpan(left), ExpressionSpan(right))
        binary_node = MakeExpressionNode("Binary", operator.text, 0, span, first_edge, 2)
        arena_nodes = arena_nodes.push(binary_node)
        combined = arena_nodes.len()
        combined_entry = ValueEntry { node: combined, previous: value_top }
        values = values.push(combined_entry)
        value_top = values.len()
        return ok(null)
    }

    expect_operand = true

    // Reduce pending operators, then close one matching delimiter. The
    // caller keeps ownership of the arena and both append-only stacks.
    fn CloseDelimiter(token: Token): null! {
        reducing = true
        while (reducing) {
            if (operator_top == 0 || operators[operator_top - 1].marker != "") {
                reducing = false
            } else {
                ReduceTop()?
            }
        }
        if (operator_top == 0) {
            RejectAt(token.clone(), "unexpected_token", "closing delimiter has no matching opener", stage3_domain)?
        }
        marker = operators[operator_top - 1].clone()
        brace_literal = IsBraceLiteralMarker(marker.marker)
        expected_close = "RParen"
        if (marker.marker == "array" || marker.marker == "index") { expected_close = "RBracket" }
        if (brace_literal) { expected_close = "RBrace" }
        if (token.kind == "RBrace" && expect_operand) {
            if (marker.marker == "object_field") {
                RejectAt(token.clone(), "unexpected_token", "expected expression", stage3_domain)?
            }
            if (marker.marker == "object" && marker.depth_active) {
                RejectAt(token.clone(), "unexpected_token", "expected object field name", stage3_domain)?
            }
        }
        if (token.kind != expected_close) {
            RejectAt(token.clone(), "unexpected_token", "closing delimiter does not match opener", stage3_domain)?
        }
        if (expect_operand && (marker.depth_active || (marker.marker != "array" && marker.marker != "call" && !brace_literal))) {
            RejectAt(token.clone(), "unexpected_token", "expected expression before closing delimiter", stage3_domain)?
        }
        operator_top = marker.previous
        if (marker.depth_active) { depth = depth - 1 }
        if (brace_literal) { brace_depth = brace_depth - 1 }

        reversed: [int] = []
        walk = value_top
        while (walk != marker.base_value) {
            if (walk == 0) {
                RejectAt(token.clone(), "invalid_expression", "delimiter lost its value stack base", stage3_domain)?
            }
            entry = values[walk - 1].clone()
            reversed = reversed.push(entry.node)
            walk = entry.previous
        }
        count = reversed.len()
        if ((marker.marker == "group" || marker.marker == "index") && count != 1) {
            RejectAt(token.clone(), "invalid_expression", "delimiter requires exactly one expression", stage3_domain)?
        }

        if (marker.marker == "group") {
            // Parentheses do not change the Rust AST node or its span.
        } else {
            children: [int] = []
            start_node = 0
            previous_value = marker.base_value
            if (marker.marker == "call" || marker.marker == "index") {
                target_entry = values[marker.base_value - 1].clone()
                start_node = target_entry.node
                previous_value = target_entry.previous
                children = children.push(start_node)
            }
            reverse_index = reversed.len()
            while (reverse_index > 0) {
                reverse_index = reverse_index - 1
                children = children.push(reversed[reverse_index])
            }
            value_top = previous_value
            end_span = SpanFromToken(token.clone())
            node = 0
            if (marker.marker == "array") {
                node = AddNode("Array", "", 0, SpanMerge(OperatorSpan(marker), end_span), children)?
            } else if (marker.marker == "struct") {
                node = AddNode("StructLiteral", marker.text, 0, SpanMerge(OperatorSpan(marker), end_span), children)?
            } else if (marker.marker == "object") {
                node = AddNode("ObjectLiteral", "", 0, SpanMerge(OperatorSpan(marker), end_span), children)?
            } else {
                kind = "Index"
                if (marker.marker == "call") { kind = "Call" }
                node = AddNode(kind, "", 0, SpanMerge(ExpressionSpan(arena_nodes[start_node - 1]), end_span), children)?
            }
            value_entry = ValueEntry { node: node, previous: value_top }
            values = values.push(value_entry)
            value_top = values.len()
        }
        cursor = cursor + 1
        expect_operand = false
        return ok(null)
    }

    // Continue an expression whose left operand is already on the value
    // stack. Separator, postfix and binary handling share that precondition.
    fn ContinueExpression(token: Token): null! {
    if (token.kind == "Comma") {
        while (operator_top != 0 && operators[operator_top - 1].marker == "") {
            ReduceTop()?
        }
        if (operator_top == 0 || (operators[operator_top - 1].marker != "array" && operators[operator_top - 1].marker != "call" && !IsBraceLiteralMarker(operators[operator_top - 1].marker))) {
            RejectAt(token.clone(), "unexpected_token", "comma is only valid in an array or call", stage3_domain)?
        }
        marker = operators[operator_top - 1].clone()
        if (value_top == marker.base_value) {
            RejectAt(token.clone(), "unexpected_token", "expected expression before comma", stage3_domain)?
        }
        cursor = cursor + 1
        expect_operand = true
    } else if (token.kind == "LParen" || token.kind == "LBracket") {
        marker_kind = "call"
        expected_close = "RParen"
        if (token.kind == "LBracket") { marker_kind = "index" expected_close = "RBracket" }
        active = tokens[cursor + 1].kind != expected_close
        if (marker_kind == "index" && !active) {
            RejectAt(tokens[cursor + 1].clone(), "unexpected_token", "expected expression before closing delimiter", stage3_domain)?
        }
        if (active) {
            if (depth >= 32) {
                RejectAt(token.clone(), "depth_exceeded", "maximum parse depth exceeded; expression is too deeply nested", stage3_domain)?
            }
            depth = depth + 1
        }
        operator_entry = MakeOperator(marker_kind, "", 0, false, token, operator_top, value_top, active)
        operators = operators.push(operator_entry)
        operator_top = operators.len()
        cursor = cursor + 1
        expect_operand = active
    } else if (token.kind == "Dot" || token.kind == "QuestionDot") {
        optional = token.kind == "QuestionDot"
        cursor = cursor + 1
        field = tokens[cursor].clone()
        if (field.kind != "Ident") {
            RejectAt(field.clone(), "unexpected_token", "expected field name after field operator", stage3_domain)?
        }
        target_entry = values[value_top - 1].clone()
        value_top = target_entry.previous
        target = arena_nodes[target_entry.node - 1].clone()
        merged = SpanMerge(ExpressionSpan(target), SpanFromToken(field.clone()))
        node = 0
        if (optional && target.kind == "Index") {
            unwrapped = AddNode("TryUnwrap", "", 0, merged.clone(), [target_entry.node])?
            node = AddNode("Field", field.lexeme, 0, merged, [unwrapped])?
        } else if (optional) {
            node = AddNode("OptionalField", field.lexeme, 0, merged, [target_entry.node])?
        } else {
            node = AddNode("Field", field.lexeme, 0, merged, [target_entry.node])?
        }
        value_entry = ValueEntry { node: node, previous: value_top }
        values = values.push(value_entry)
        value_top = values.len()
        cursor = cursor + 1
    } else if (token.kind == "Question") {
        target_entry = values[value_top - 1].clone()
        value_top = target_entry.previous
        target = arena_nodes[target_entry.node - 1].clone()
        merged = SpanMerge(ExpressionSpan(target), SpanFromToken(token.clone()))
        node = AddNode("TryUnwrap", "", 0, merged, [target_entry.node])?
        value_entry = ValueEntry { node: node, previous: value_top }
        values = values.push(value_entry)
        value_top = values.len()
        cursor = cursor + 1
    } else {
        binary = ReadBinaryOperator(token, stage3_domain)?
        precedence = binary.precedence
        reducing = true
        while (reducing) {
            if (operator_top == 0 || operators[operator_top - 1].marker != "" || operators[operator_top - 1].precedence < precedence) {
                reducing = false
            } else {
                ReduceTop()?
            }
        }
        operator_entry = MakeOperator("", binary.text, precedence, false, token, operator_top, 0, false)
        operators = operators.push(operator_entry)
        operator_top = operators.len()
        cursor = cursor + 1
        expect_operand = true
    }
        return ok(null)
    }

    steps = 0
    parsing = true
    while (parsing) {
        steps = steps + 1
        if (steps > 16384) {
            RejectAt(tokens[cursor].clone(), "work_limit", "stage-2 parser work budget exceeded", stage3_domain)?
        }
        token = tokens[cursor].clone()
        // A field is not an operand by itself. Once its expression has been
        // reduced, replace that one value with an ordered named field node.
        if (brace_depth > 0 && !expect_operand && (token.kind == "Comma" || token.kind == "RBrace")) {
            while (operator_top != 0 && operators[operator_top - 1].marker == "") { ReduceTop()? }
            field = operators[operator_top - 1].clone()
            if (field.marker == "struct_field" || field.marker == "object_field") {
                value = values[value_top - 1].clone()
                if (value.previous != field.base_value) {
                    RejectAt(token.clone(), "invalid_expression", "literal field requires exactly one expression", stage3_domain)?
                }
                span = SpanMerge(OperatorSpan(field), ExpressionSpan(arena_nodes[value.node - 1]))
                field_kind = "StructLiteralField"
                if (field.marker == "object_field") { field_kind = "ObjectLiteralField" }
                node = AddNode(field_kind, field.text, 0, span, [value.node])?
                values = values.push(ValueEntry { node: node, previous: value.previous })
                value_top = values.len()
                operator_top = field.previous
            }
        }
        closing = token.kind == "RParen" || token.kind == "RBracket" || (brace_depth > 0 && token.kind == "RBrace")
        if (closing) {
            CloseDelimiter(token)?
        } else if (token.kind == "Eof") {
            if (expect_operand) {
                RejectAt(token.clone(), "unexpected_eof", "expected expression", stage3_domain)?
            }
            while (operator_top != 0 && operators[operator_top - 1].marker == "") {
                ReduceTop()?
            }
            if (operator_top != 0) {
                RejectAt(token.clone(), "unexpected_eof", "expected closing delimiter", stage3_domain)?
            }
            parsing = false
        } else if (expect_operand && brace_depth > 0 && IsBraceLiteralMarker(operators[operator_top - 1].marker)) {
            field_marker = "struct_field"
            if (operators[operator_top - 1].marker == "object") {
                field_marker = "object_field"
                if (token.kind != "Ident" && token.kind != "String") {
                    RejectAt(token.clone(), "unexpected_token", "expected object field name", stage3_domain)?
                }
                if (tokens[cursor + 1].kind != "Colon") {
                    RejectAt(tokens[cursor + 1].clone(), "unexpected_token", "expected ':' after object field", stage3_domain)?
                }
            } else if (token.kind != "Ident" || tokens[cursor + 1].kind != "Colon") {
                RejectAt(token.clone(), "unexpected_token", "expected named struct field followed by ':'", stage3_domain)?
            }
            entry = MakeOperator(field_marker, token.lexeme.clone(), 0, false, token, operator_top, value_top, false)
            operators = operators.push(entry)
            operator_top = operators.len()
            cursor = cursor + 2
        } else if (expect_operand) {
            if (token.kind == "Ident" && tokens[cursor + 1].kind == "LBrace" && cursor + 3 < tokens.len()
                && IsNamedStructStart(token, tokens[cursor + 1], tokens[cursor + 2], tokens[cursor + 3])) {
                if (depth >= 32) {
                    RejectAt(token.clone(), "depth_exceeded", "maximum parse depth exceeded; expression is too deeply nested", stage3_domain)?
                }
                entry = MakeOperator("struct", token.lexeme.clone(), 0, false, token, operator_top, value_top, true)
                operators = operators.push(entry)
                operator_top = operators.len()
                depth = depth + 1
                brace_depth = brace_depth + 1
                cursor = cursor + 2
            } else if (token.kind == "Bang" || token.kind == "Minus") {
                if (depth >= 32) {
                    RejectAt(token.clone(), "depth_exceeded", "maximum parse depth exceeded; expression is too deeply nested", stage3_domain)?
                }
                depth = depth + 1
                operator_entry = MakeOperator("", token.lexeme.clone(), 7, true, token, operator_top, 0, false)
                operators = operators.push(operator_entry)
                operator_top = operators.len()
                cursor = cursor + 1
            } else if (token.kind == "LParen" || token.kind == "LBracket" || token.kind == "LBrace") {
                marker_kind = "group"
                expected_close = "RParen"
                if (token.kind == "LBracket") { marker_kind = "array" expected_close = "RBracket" }
                if (token.kind == "LBrace") {
                    marker_kind = "object"
                    expected_close = "RBrace"
                    brace_depth = brace_depth + 1
                }
                active = tokens[cursor + 1].kind != expected_close
                if (active) {
                    if (depth >= 32) {
                        RejectAt(token.clone(), "depth_exceeded", "maximum parse depth exceeded; expression is too deeply nested", stage3_domain)?
                    }
                    depth = depth + 1
                }
                operator_entry = MakeOperator(marker_kind, "", 0, false, token, operator_top, value_top, active)
                operators = operators.push(operator_entry)
                operator_top = operators.len()
                cursor = cursor + 1
            } else {
                span = SpanFromToken(token.clone())
                atom = ReadPrimaryAtom(token, stage3_domain)?
                node = AddNode(atom.kind, atom.text, atom.int_value, span, [])?
                value_entry = ValueEntry { node: node, previous: value_top }
                values = values.push(value_entry)
                value_top = values.len()
                cursor = cursor + 1
                expect_operand = false
            }
        } else {
            ContinueExpression(token)?
        }
    }

    if (value_top == 0 || values[value_top - 1].previous != 0) {
        RejectAt(tokens[cursor].clone(), "invalid_expression", "expression did not reduce to one root", stage3_domain)?
    }
    root = values[value_top - 1].node
    // AddNode/ReduceTop retain the shared cells until this frame exits. Clone
    // each completed flat arena once; self-push no longer clones per node.
    return ValidateParseOutput(ParseOutput {
        arena: Arena { nodes: arena_nodes.clone(), edges: arena_edges.clone() },
        root: root
    })
}

fn Parse(source: str): ParseOutput! {
    return ok(ParseWithContext(source, DefaultParseContext())?)
}
