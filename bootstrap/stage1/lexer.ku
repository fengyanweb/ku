import {
    Token,
    Canonical as tokenCanonical,
    EscapeCanonical as escapeCanonical
} from "./token.ku"

// This scanner implements the Rust bootstrap lexer's lexical grammar in Ku.
// ASCII identifiers, non-nested comments, and decimal floats are intentional
// language rules. The same bounded input/token/string policy applies to every
// token kind. Every scan loop advances source or stops by a flag/error.

fn Canonical(tokens: [Token]): str {
    return tokenCanonical(tokens)
}

fn EscapeCanonical(text: str): str {
    return escapeCanonical(text)
}

fn At(message: str, line: int, column: int, offset: int): str {
    return str(line) + ":" + str(column) + "@" + str(offset) + ": " + message
}

fn IsDigit(ch: str): bool {
    return ch != "" && "0123456789".contains(ch)
}

fn IsIdentifierStart(ch: str): bool {
    return ch != "" && "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ_".contains(ch)
}

fn IsIdentifierContinue(ch: str): bool {
    return ch != "" && "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ_0123456789".contains(ch)
}

fn DigitValue(ch: str): int {
    if (ch == "0") { return 0 }
    if (ch == "1") { return 1 }
    if (ch == "2") { return 2 }
    if (ch == "3") { return 3 }
    if (ch == "4") { return 4 }
    if (ch == "5") { return 5 }
    if (ch == "6") { return 6 }
    if (ch == "7") { return 7 }
    if (ch == "8") { return 8 }
    return 9
}

fn KeywordKind(text: str): str {
    if (text == "async") { return "Async" }
    if (text == "await") { return "Await" }
    if (text == "fn") { return "Fn" }
    if (text == "struct") { return "Struct" }
    if (text == "enum") { return "Enum" }
    if (text == "module") { return "Module" }
    if (text == "import") { return "Import" }
    if (text == "from") { return "From" }
    if (text == "let") { return "Let" }
    if (text == "mut") { return "Mut" }
    if (text == "if") { return "If" }
    if (text == "else") { return "Else" }
    if (text == "while") { return "While" }
    if (text == "for") { return "For" }
    if (text == "in") { return "In" }
    if (text == "break") { return "Break" }
    if (text == "continue") { return "Continue" }
    if (text == "match") { return "Match" }
    if (text == "switch") { return "Switch" }
    if (text == "try") { return "Try" }
    if (text == "catch") { return "Catch" }
    if (text == "finally") { return "Finally" }
    if (text == "fail") { return "Fail" }
    if (text == "panic") { return "Panic" }
    if (text == "return") { return "Return" }
    if (text == "print") { return "Print" }
    if (text == "true") { return "True" }
    if (text == "false") { return "False" }
    if (text == "null") { return "Null" }
    return "Ident"
}

fn CheckTokenCapacity(token_count: int): null! {
    if (token_count >= 4096) {
        fail {
            domain: "bootstrap.lexer",
            code: "too_many_tokens",
            message: "stage-1 lexer accepts at most 4096 tokens including EOF"
        }
    }
    return ok(null)
}

fn CheckStringCapacity(character_count: int): null! {
    if (character_count > 4096) {
        fail {
            domain: "bootstrap.lexer",
            code: "string_too_large",
            message: "stage-1 string literals accept at most 4096 decoded characters"
        }
    }
    return ok(null)
}

fn Scan(source: str): [Token]! {
    tokens: [Token] = []
    // The byte guard rejects certainly over-limit inputs without a full
    // Unicode scan. At most four UTF-8 bytes represent one Unicode scalar.
    if (source.byte_len() > 131072) {
        fail {
            domain: "bootstrap.lexer",
            code: "input_too_large",
            message: "stage-1 lexer accepts at most 32768 characters"
        }
    }
    length = source.len()
    if (length > 32768) {
        fail {
            domain: "bootstrap.lexer",
            code: "input_too_large",
            message: "stage-1 lexer accepts at most 32768 characters"
        }
    }
    // One materialization and monotonically advancing cursor. Lexemes use +=;
    // tokens use same-local pure push so neither collector copies its prefix.
    characters: [str] = source.chars()
    index = 0
    line = 1
    column = 1
    offset = 0

    while (index < length) {
        ch = characters[index].clone()
        whitespace = ch == " " || ch == "\t" || ch == "\r" || ch == "\n" || ch == "﻿"
        next = ""
        if (!whitespace && index + 1 < length) {
            next = characters[index + 1].clone()
        }
        start_line = line
        start_column = column
        start_offset = offset

        if (whitespace) {
            offset = offset + ch.byte_len()
            if (ch == "\n") {
                line = line + 1
                column = 1
            } else {
                column = column + 1
            }
            index = index + 1
        } else if (ch == "/" && next == "/") {
            // CR is ordinary comment content; only LF terminates //, matching
            // the Rust lexer even for a source containing a bare CR.
            scanning = true
            while (scanning && index < length) {
                current = characters[index].clone()
                if (current == "\n") {
                    scanning = false
                } else {
                    offset = offset + current.byte_len()
                    index = index + 1
                    column = column + 1
                }
            }
        } else if (ch == "/" && next == "*") {
            index = index + 2
            column = column + 2
            offset = offset + 2
            closed = false
            while (!closed && index < length) {
                current = characters[index].clone()
                closing = false
                if (current == "*" && index + 1 < length) {
                    closing = characters[index + 1].clone() == "/"
                }
                if (closing) {
                    index = index + 2
                    column = column + 2
                    offset = offset + 2
                    closed = true
                } else {
                    offset = offset + current.byte_len()
                    if (current == "\n") {
                        line = line + 1
                        column = 1
                    } else {
                        column = column + 1
                    }
                    index = index + 1
                }
            }
            if (!closed) {
                fail {
                    domain: "bootstrap.lexer",
                    code: "unterminated_block_comment",
                    message: At("unterminated block comment", start_line, start_column, start_offset)
                }
            }
        } else {
            kind = ""
            lexeme = ""
            int_value = 0
            if (IsIdentifierStart(ch.clone())) {
                scanning = true
                while (scanning && index < length) {
                    current = characters[index].clone()
                    if (IsIdentifierContinue(current.clone())) {
                        lexeme += current
                        index = index + 1
                        column = column + 1
                        offset = offset + 1
                    } else {
                        scanning = false
                    }
                }
                kind = KeywordKind(lexeme.clone())
            } else if (IsDigit(ch.clone())) {
                // An overflowing integer prefix can still be a valid decimal
                // float. Defer its integer diagnostic until the whole token kind
                // is known, preserving the float spelling instead of rounding it.
                overflow = false
                scanning = true
                while (scanning && index < length) {
                    current = characters[index].clone()
                    if (IsDigit(current.clone())) {
                        if (!overflow) {
                            digit = DigitValue(current.clone())
                            if (int_value > 922337203685477580 || (int_value == 922337203685477580 && digit > 7)) {
                                overflow = true
                            } else {
                                int_value = int_value * 10 + digit
                            }
                        }
                        lexeme += current
                        index = index + 1
                        column = column + 1
                        offset = offset + 1
                    } else {
                        scanning = false
                    }
                }
                is_float = false
                if (index + 1 < length) {
                    if (characters[index].clone() == "." && IsDigit(characters[index + 1].clone())) {
                        is_float = true
                    }
                }
                if (is_float) {
                    kind = "Float"
                    int_value = 0
                    lexeme += "."
                    index = index + 1
                    column = column + 1
                    offset = offset + 1
                    scanning = true
                    while (scanning && index < length) {
                        current = characters[index].clone()
                        if (IsDigit(current.clone())) {
                            lexeme += current
                            index = index + 1
                            column = column + 1
                            offset = offset + 1
                        } else {
                            scanning = false
                        }
                    }
                } else {
                    if (overflow) {
                        fail {
                            domain: "bootstrap.lexer",
                            code: "integer_overflow",
                            message: At("invalid int literal", start_line, start_column, start_offset)
                        }
                    }
                    kind = "Int"
                }
            } else if (ch == "\"" || ch == "'" || ch == "`") {
                quote = ch.clone()
                template = quote == "`"
                kind = "String"
                if (template) { kind = "TemplateString" }
                index = index + 1
                column = column + 1
                offset = offset + 1
                string_length = 0
                closed = false
                while (!closed && index < length) {
                    current = characters[index].clone()
                    if (current == quote) {
                        index = index + 1
                        column = column + 1
                        offset = offset + 1
                        closed = true
                    } else if (current == "\\") {
                        index = index + 1
                        column = column + 1
                        offset = offset + 1
                        if (index >= length) {
                            if (template) {
                                fail {
                                    domain: "bootstrap.lexer",
                                    code: "unterminated_template_escape",
                                    message: At("unterminated template string escape", start_line, start_column, start_offset)
                                }
                            }
                            fail {
                                domain: "bootstrap.lexer",
                                code: "unterminated_escape",
                                message: At("unterminated string escape", start_line, start_column, start_offset)
                            }
                        }
                        escaped = characters[index].clone()
                        // Unknown ordinary escapes point after the consumed
                        // character, including a literal newline or UTF-8 scalar.
                        offset = offset + escaped.byte_len()
                        index = index + 1
                        if (escaped == "\n") {
                            line = line + 1
                            column = 1
                        } else {
                            column = column + 1
                        }
                        decoded = ""
                        if (escaped == "n") {
                            decoded = "\n"
                        } else if (escaped == "r") {
                            decoded = "\r"
                        } else if (escaped == "t") {
                            decoded = "\t"
                        } else if (escaped == quote) {
                            decoded = quote.clone()
                        } else if (escaped == "\\") {
                            decoded = "\\"
                        } else if (template) {
                            // Braces and unknown escapes retain their backslash;
                            // template interpolation is the parser's job.
                            decoded = "\\" + escaped
                        } else {
                            fail {
                                domain: "bootstrap.lexer",
                                code: "unknown_escape",
                                message: At("unknown string escape '\\" + escaped + "'", line, column, offset)
                            }
                        }
                        string_length = string_length + decoded.len()
                        CheckStringCapacity(string_length)?
                        lexeme += decoded
                    } else {
                        offset = offset + current.byte_len()
                        if (current == "\n") {
                            line = line + 1
                            column = 1
                        } else {
                            column = column + 1
                        }
                        index = index + 1
                        string_length = string_length + 1
                        CheckStringCapacity(string_length)?
                        lexeme += current
                    }
                }
                if (!closed) {
                    if (template) {
                        fail {
                            domain: "bootstrap.lexer",
                            code: "unterminated_template",
                            message: At("unterminated template string", start_line, start_column, start_offset)
                        }
                    }
                    fail {
                        domain: "bootstrap.lexer",
                        code: "unterminated_string",
                        message: At("unterminated string", start_line, start_column, start_offset)
                    }
                }
            } else {
                lexeme = ch.clone()
                width = 1
                pair = ch.clone() + next.clone()
                if (pair == "..") {
                    third_dot = false
                    if (index + 2 < length) {
                        third_dot = characters[index + 2].clone() == "."
                    }
                    if (!third_dot) {
                        fail {
                            domain: "bootstrap.lexer",
                            code: "invalid_ellipsis",
                            message: At("expected third '.' for '...'", start_line, start_column, start_offset)
                        }
                    }
                    kind = "Ellipsis"
                    lexeme = "..."
                    width = 3
                } else {
                    if (pair == "++") { kind = "PlusPlus" }
                    if (pair == "+=") { kind = "PlusEqual" }
                    if (pair == "--") { kind = "MinusMinus" }
                    if (pair == "-=") { kind = "MinusEqual" }
                    if (pair == "=>") { kind = "Arrow" }
                    if (pair == "*=") { kind = "StarEqual" }
                    if (pair == "/=") { kind = "SlashEqual" }
                    if (pair == "%=") { kind = "PercentEqual" }
                    if (pair == "!=") { kind = "BangEqual" }
                    if (pair == "?.") { kind = "QuestionDot" }
                    if (pair == "==") { kind = "EqualEqual" }
                    if (pair == "<=") { kind = "LessEqual" }
                    if (pair == ">=") { kind = "GreaterEqual" }
                    if (pair == "&&") { kind = "AndAnd" }
                    if (pair == "||") { kind = "OrOr" }
                    if (kind != "") {
                        lexeme = pair
                        width = 2
                    }
                }
                if (kind == "") {
                    if (ch == "+") { kind = "Plus" }
                    if (ch == "-") { kind = "Minus" }
                    if (ch == "*") { kind = "Star" }
                    if (ch == "/") { kind = "Slash" }
                    if (ch == "%") { kind = "Percent" }
                    if (ch == "!") { kind = "Bang" }
                    if (ch == "?") { kind = "Question" }
                    if (ch == "=") { kind = "Equal" }
                    if (ch == "<") { kind = "Less" }
                    if (ch == ">") { kind = "Greater" }
                    if (ch == "|") { kind = "Pipe" }
                    if (ch == ".") { kind = "Dot" }
                    if (ch == "(") { kind = "LParen" }
                    if (ch == ")") { kind = "RParen" }
                    if (ch == "{") { kind = "LBrace" }
                    if (ch == "}") { kind = "RBrace" }
                    if (ch == "[") { kind = "LBracket" }
                    if (ch == "]") { kind = "RBracket" }
                    if (ch == ",") { kind = "Comma" }
                    if (ch == ":") { kind = "Colon" }
                    if (ch == ";") { kind = "Semicolon" }
                }
                if (kind == "") {
                    if (ch == "&") {
                        fail {
                            domain: "bootstrap.lexer",
                            code: "invalid_character",
                            message: At("expected '&' after '&'", start_line, start_column, start_offset)
                        }
                    }
                    fail {
                        domain: "bootstrap.lexer",
                        code: "invalid_character",
                        message: At("unexpected character '" + ch + "'", start_line, start_column, start_offset)
                    }
                }
                index = index + width
                column = column + width
                offset = offset + width
            }
            token = Token {
                kind: kind, lexeme: lexeme, int_value: int_value,
                line: start_line, column: start_column, offset: start_offset,
                end_line: line, end_column: column, end_offset: offset
            }
            CheckTokenCapacity(tokens.len())?
            tokens = tokens.push(token)
        }
    }
    token = Token {
        kind: "Eof", lexeme: "", int_value: 0,
        line: line, column: column, offset: offset,
        end_line: line, end_column: column, end_offset: offset
    }
    CheckTokenCapacity(tokens.len())?
    tokens = tokens.push(token)
    return ok(tokens)
}
