import { RejectLayout } from "./struct_layouts.ku"
import { LinkedNullCType, LinkedNullDropC } from "./linked_null_types_c.ku"
import { LinkedNullOwner, LinkedNullState, LinkedNullValue } from "./link_plan_c.ku"

fn LinkedMemberPath(&receiver: LinkedNullValue, ordinal: int): str {
    if (receiver.slot == 0 || (receiver.borrowed && receiver.member_path == "")) { return "" }
    return receiver.member_path.clone() + "." + str(ordinal)
}

// Selection may walk through a partially moved parent to reach an intact
// sibling. An argument that uses the whole selection needs every descendant.
fn LinkedMemberUnavailable(&state: LinkedNullState, &value: LinkedNullValue, whole: bool): bool {
    if (value.slot == 0) { return false }
    if (!state.slots[value.slot - 1].live) { return true }
    for moved in state.slots[value.slot - 1].moved_members.clone() {
        if (moved == value.member_path || value.member_path.starts_with(moved.clone() + ".")) { return true }
        if (whole && (value.member_path == "" || moved.starts_with(value.member_path.clone() + "."))) { return true }
    }
    return false
}

fn RecordLinkedMemberMove(state: LinkedNullState, &value: LinkedNullValue): LinkedNullState {
    next = state
    index = value.slot - 1
    if (value.member_path == "") {
        next.slots[index].live = false
    } else {
        members = next.slots[index].moved_members.clone()
        next.slots[index].moved_members = members.push(value.member_path.clone())
    }
    return next
}

fn MoveLinkedNullSlot(state: LinkedNullState, &value: LinkedNullValue): LinkedNullState! {
    if (value.borrowed && (value.member_path == "" || !LinkedNullOwner(value.ty))) {
        RejectLayout("linked_view_escape", "readonly values cannot be moved or stored without an explicit clone", value.ty.span.clone())?
    }
    if (LinkedMemberUnavailable(state, value, true)) {
        RejectLayout("linked_moved_member", "owned field or parent already has a moved component", value.ty.span.clone())?
    }
    next = state
    if (value.slot > 0 && LinkedNullDropC(next.layouts, next.owning_layouts, value.ty, value.text) != "") {
        next.code = next.code + "    " + value.text.clone() + " = (" + LinkedNullCType(value.ty)? + "){0};\n"
        next = RecordLinkedMemberMove(next, value)
    }
    return ok(next)
}
