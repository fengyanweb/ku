import { Node } from "../stage2/ast.ku"
import { Span } from "../stage2/span.ku"
import { DeclarationSpan } from "./names.ku"
import { ContainsIndex } from "./struct_projection_c.ku"
import { GuardOwnedDrops } from "./guarded_struct_c.ku"
import { OwningLayoutDropName } from "./nested_struct_c.ku"
import { TypeNameBinding } from "./type_names.ku"
import { HasBoundArrayMembers } from "./struct_array_c.ku"
import { EmitCheckedScalarArithmetic } from "./scalar_int_emit.ku"
import { FieldIndex, LayoutIndex, RejectLayout, StructLayout } from "./struct_layouts.ku"
import { LinkedBuiltin, LinkedNullArrayElement, LinkedNullArrayLimitName, LinkedNullArrayPrefix, LinkedNullCType, LinkedNullChild, LinkedNullNode, LinkedNullProject, SameLinkedType } from "./linked_null_types_c.ku"
import { LinkedNullBinding, LinkedNullExpression, LinkedNullFunction, LinkedNullIntArrayOwner, LinkedNullOwnedArray, LinkedNullOwner, LinkedNullReadableArray, LinkedReadonlyExpression, LinkedRecordFields, LinkedNullSlot, LinkedNullState, LinkedNullValue, LinkedSlotOwnershipMatches, LinkedViewPointee, RememberLinkedCall } from "./link_plan_c.ku"

fn LinkedNullDropC(&layouts: [StructLayout], &owning_layouts: [StructLayout], &ty: TypeNameBinding, &name: str): str {
    if (ty.declaration_kind == "OwnedStringArray") { return "    ku_managed_source_drop(&" + name.clone() + ");\n" }
    if (ty.declaration_kind == "CaughtError") {
        return "    ku_projection_string_drop(&" + name.clone() + ".domain);\n"
            + "    ku_projection_string_drop(&" + name.clone() + ".code);\n"
            + "    ku_projection_string_drop(&" + name.clone() + ".message);\n"
    }
    if (ty.name == "str" && ty.declaration_kind == "Builtin") {
        return "    ku_projection_string_drop(&" + name.clone() + ");\n"
    }
    if (ty.declaration_kind == "Struct") {
        unit = ty.module_index
        node = ty.declaration_node
        if (LayoutIndex(owning_layouts, unit, node) != 0) {
            return "    " + OwningLayoutDropName(unit, node) + "(&" + name.clone() + ");\n"
        }
        layout = LayoutIndex(layouts, unit, node)
        return GuardOwnedDrops(layouts, layout, name)
    }
    if (LinkedNullOwnedArray(ty) || LinkedNullIntArrayOwner(ty)) {
        return "    " + LinkedNullArrayPrefix(ty) + "_drop(&" + name.clone() + ");\n"
    }
    return ""
}

fn LinkedViewArgument(&parameter: TypeNameBinding, &value: LinkedNullValue): str! {
    if (parameter.declaration_kind == "StringView" && value.ty.declaration_kind == "Builtin" && value.ty.name == "str"
        && (!value.borrowed || value.slot > 0)) {
        return ok("&(" + value.text.clone() + ")")
    }
    if (parameter.declaration_kind == "StructView" && (!value.borrowed || value.slot > 0)
        && SameLinkedType(LinkedViewPointee(parameter.clone()), value.ty)) {
        return ok("&(" + value.text.clone() + ")")
    }
    if (SameLinkedType(parameter, value.ty)) { return ok(value.text.clone()) }
    if (parameter.declaration_kind == "BuiltinArray" && parameter.name == "str"
        && value.ty.declaration_kind == "OwnedStringArray" && value.slot > 0 && !value.borrowed) {
        return ok("&(" + value.text.clone() + ")")
    }
    if (MatchesLinkedIntArrayOwner(parameter, value.ty)) { return ok("&(" + value.text.clone() + ")") }
    if (matchesLinkedStructArrayOwner(parameter, value.ty)) {
        return ok("&(" + value.text.clone() + ")")
    }
    RejectLayout("linked_argument_type", "expected a matching stable source for the View argument", value.ty.span.clone())?
    return ok("")
}

fn MatchesLinkedIntArrayOwner(&target: TypeNameBinding, &origin: TypeNameBinding): bool {
    return target.declaration_kind == "BuiltinArray" && target.name == "int" && LinkedNullIntArrayOwner(origin)
}

fn LinkedDirectCallExpression(&callee: LinkedNullFunction, &arguments: str): str {
    return callee.symbol.clone() + "(" + arguments.clone() + ")"
}

fn EmitLinkedReadonlyBoolCall(input: LinkedNullExpression, callee: LinkedNullFunction, id: int, at: Span): LinkedNullExpression! {
    parameter = callee.parameters[0].clone()
    if (callee.result.declaration_kind != "Builtin" || callee.result.name != "bool") {
        RejectLayout("linked_readonly_call", "readonly direct call requires a plain bool result", at.clone())?
    }
    argument = input.value.text.clone()
    if (parameter.declaration_kind == "StringView") {
        argument = LinkedViewArgument(parameter, input.value)?
    } else if (parameter.declaration_kind != "Builtin" || (parameter.name != "int" && parameter.name != "bool")
        || !SameLinkedType(parameter, input.value.ty)) {
        RejectLayout("linked_readonly_call", "readonly direct call requires a matching str View or scalar Copy argument", at)?
    }
    name = "predicate" + str(id)
    next = input.state
    next.code += "    bool " + name.clone() + " = " + LinkedDirectCallExpression(callee, argument) + ";\n"
    ty = callee.result.clone()
    next.links = RememberLinkedCall(next.links, callee)
    return ok(LinkedReadonlyExpression(next, ty, name))
}

fn matchesLinkedStructArrayOwner(&target: TypeNameBinding, &origin: TypeNameBinding): bool {
    return target.declaration_kind == "StructArray" && LinkedNullOwnedArray(origin)
        && SameLinkedType(LinkedNullArrayElement(target.clone()), LinkedNullArrayElement(origin.clone()))
}

fn MatchesLinkedFieldValue(&target: TypeNameBinding, &origin: TypeNameBinding): bool {
    if (target.declaration_kind == "StructArray") { return matchesLinkedStructArrayOwner(target, origin) }
    return SameLinkedType(target, origin) || MatchesLinkedIntArrayOwner(target, origin)
}

fn scalarGuardSlotMove(&before: LinkedNullSlot, &after: LinkedNullSlot, &state: LinkedNullState): bool {
    ty = before.value.ty.clone()
    if (ty.declaration_kind != "Struct" || before.value.borrowed || !before.live || after.live
        || before.moved_members.len() != 0 || after.moved_members.len() != 0) { return false }
    layout = LayoutIndex(state.layouts, ty.module_index, ty.declaration_node)
    return layout > 0 && !HasBoundArrayMembers(state.layouts, layout)
        && GuardOwnedDrops(state.layouts, layout, before.value.text) == ""
}

fn CheckLinkedGuardOwners(&outer: [LinkedNullSlot], &taken: LinkedNullState, &statement: Node): null! {
    index = 0
    while (index < outer.len()) {
        if (LinkedNullOwner(outer[index].value.ty) && !LinkedSlotOwnershipMatches(outer[index], taken.slots[index])
            && !scalarGuardSlotMove(outer[index], taken.slots[index], taken)) {
            RejectLayout("linked_control_move", "conditional code cannot consume an outer owner", DeclarationSpan(statement))?
        }
        index = index + 1
    }
    // On continuation the taken-arm liveness is already conservative. The
    // untaken scalar record has no resources requiring divergent cleanup.
    return ok(null)
}

fn LinkedMemberPath(&receiver: LinkedNullValue, ordinal: int): str {
    if (receiver.slot == 0 || (receiver.borrowed && receiver.member_path == "")) { return "" }
    return receiver.member_path.clone() + "." + str(ordinal)
}

// Selection may walk through a partially moved parent to reach an intact
// sibling. An argument that uses the whole selection needs every descendant.
fn LinkedMemberUnavailable(&state: LinkedNullState, &value: LinkedNullValue, whole: bool): bool {
    if (value.slot == 0) { return false }
    if (!state.slots[value.slot - 1].live) { return true }
    for moved in state.slots[value.slot - 1].moved_members.clone() {
        if (moved == value.member_path || value.member_path.starts_with(moved.clone() + ".")) { return true }
        if (whole && (value.member_path == "" || moved.starts_with(value.member_path.clone() + "."))) { return true }
    }
    return false
}

fn RecordLinkedMemberMove(state: LinkedNullState, &value: LinkedNullValue): LinkedNullState {
    next = state
    index = value.slot - 1
    if (value.member_path == "") {
        next.slots[index].live = false
    } else {
        members = next.slots[index].moved_members.clone()
        next.slots[index].moved_members = members.push(value.member_path.clone())
    }
    return next
}

fn MoveLinkedNullSlot(state: LinkedNullState, &value: LinkedNullValue): LinkedNullState! {
    if (value.borrowed && (value.member_path == "" || !LinkedNullOwner(value.ty))) {
        RejectLayout("linked_view_escape", "readonly values cannot be moved or stored without an explicit clone", value.ty.span.clone())?
    }
    if (LinkedMemberUnavailable(state, value, true)) {
        RejectLayout("linked_moved_member", "owned field or parent already has a moved component", value.ty.span.clone())?
    }
    next = state
    if (value.slot > 0 && LinkedNullDropC(next.layouts, next.owning_layouts, value.ty, value.text) != "") {
        next.code = next.code + "    " + value.text.clone() + " = (" + LinkedNullCType(value.ty)? + "){0};\n"
        next = RecordLinkedMemberMove(next, value)
    }
    return ok(next)
}

fn dropLinkedScope(state: LinkedNullState, outer: int, unwind: bool): LinkedNullState {
    next = state
    index = next.slots.len()
    while (index > outer) {
        index = index - 1
        slot = next.slots[index].clone()
        if ((slot.live || unwind) && !slot.value.borrowed && LinkedNullOwner(slot.value.ty)) {
            next.code = next.code + LinkedNullDropC(next.layouts, next.owning_layouts, slot.value.ty, slot.value.text)
        }
        next.slots[index].binding = ""
        next.slots[index].live = false
    }
    return next
}

fn DropLinkedNullScope(state: LinkedNullState, outer: int): LinkedNullState {
    return dropLinkedScope(state, outer, false)
}

fn BindLinkedCatch(state: LinkedNullState, name: str, &binding: Node, &before: [LinkedNullSlot]): LinkedNullState! {
    if (!state.catch_edges || LinkedNullBinding(before, name) != 0) {
        RejectLayout("linked_catch_shape", "catch requires a reachable error edge and a distinct Error binding", DeclarationSpan(binding))?
    }
    next = state
    slot = next.catch_slot
    next.code += next.slots[slot - 1].value.text.clone() + "_handler:\n"
    // Every slot starts zero. A later syntactic move need not have
    // happened at the point of the failure, so unwind its owner as well.
    next = dropLinkedScope(next, slot, true)
    index = 0
    while (index < before.len()) {
        next.slots[index].live = before[index].live && !ContainsIndex(next.catch_moved, index)
        index = index + 1
    }
    next.slots[slot - 1].binding = name
    next.slots[slot - 1].live = true
    next.catch_slot = 0
    next.catch_edges = false
    cleared: [int] = []
    next.catch_moved = cleared
    return ok(next)
}

fn LinkedCountBound(&project: LinkedNullProject, &state: LinkedNullState, id: int): bool! {
    array = LinkedNullBinding(state.slots, LinkedNullArrayLimitName(project, id))
    if (array > 0) {
        return ok(LinkedNullReadableArray(state.slots[array - 1].value.ty))
    }
    member = LinkedNullNode(project, 1, id)
    array_member = false
    if (member.kind == "Call" && member.edge_count == 1) {
        method = LinkedNullNode(project, 1, LinkedNullChild(project, 1, member, 0))
        if (method.kind != "Field" || method.text != "len" || method.edge_count != 1) { return ok(false) }
        member = LinkedNullNode(project, 1, LinkedNullChild(project, 1, method, 0))
        array_member = true
    }
    if (member.kind != "Field" || member.edge_count != 1) { return ok(false) }
    receiver = LinkedNullNode(project, 1, LinkedNullChild(project, 1, member, 0))
    if (receiver.kind != "Variable" || receiver.edge_count != 0) { return ok(false) }
    slot = LinkedNullBinding(state.slots, receiver.text)
    if (slot == 0 || !state.slots[slot - 1].live) { return ok(false) }
    binding = state.slots[slot - 1].value.ty.clone()
    if (binding.declaration_kind != "Struct") { return ok(false) }
    fields = LinkedRecordFields(state.layouts, state.owning_layouts, binding)?
    field = FieldIndex(fields, member.text)
    if (field == 0) { return ok(false) }
    ty = fields[field - 1].resolved.clone()
    if (array_member) { return ok(LinkedNullReadableArray(ty)) }
    return ok(ty.declaration_kind == "Builtin" && ty.name == "int")
}

fn EmitLinkedMultiplyDivide(state: LinkedNullState, &node: Node, id: int,
                            &left: LinkedNullValue, &right: LinkedNullValue): LinkedNullExpression {
    next = state
    out = "t" + str(id)
    if (node.text == "*") {
        next.uses_mul = true
        next.code += EmitCheckedScalarArithmetic("mul", left.text, right.text, out)
    } else {
        next.uses_div = true
        next.code += "    int64_t " + out.clone() + ";\n    {\n"
            + "        const int64_t dividend = " + left.text.clone() + ";\n"
            + "        const int64_t divisor = " + right.text.clone() + ";\n"
            + "        if (divisor == 0) { division_by_zero = true; goto cleanup; }\n"
            + "        if (dividend == INT64_MIN && divisor == -1) { overflow = true; goto cleanup; }\n"
            + "        " + out.clone() + " = dividend / divisor;\n    }\n"
    }
    return LinkedReadonlyExpression(next, LinkedBuiltin("int", DeclarationSpan(node)), out)
}
