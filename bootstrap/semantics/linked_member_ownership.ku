import { Node } from "../stage2/ast.ku"
import { LinkedLocalReadCaptures } from "./call_contracts.ku"
import { Span } from "../stage2/span.ku"
import { DeclarationSpan } from "./names.ku"
import { ContainsIndex, ContainsType, ContainsAllTypes, OnlyWholeMemberMoves } from "./struct_projection_c.ku"
import { GuardOwnedDrops, ScalarGuardSlotMove } from "./guarded_struct_c.ku"
import { OwningLayoutDropName } from "./nested_struct_c.ku"
import { SameBoundTypeIdentity, TypeNameBinding } from "./type_names.ku"
import { EmitCheckedScalarArithmetic } from "./scalar_int_emit.ku"
import { FieldIndex, LayoutIndex, RejectLayout, StructLayout } from "./struct_layouts.ku"
import { LinkedBuiltin, LinkedNullArrayElement, LinkedNullArrayPrefix, LinkedNullCType, LinkedNullChild, LinkedNullNode, LinkedNullProject, SameLinkedType } from "./linked_null_types_c.ku"
import { EmitLinkedReadonlyPredicate, LinkedNullBinding, LinkedNullExpression, LinkedNullFunction, LinkedNullIntArrayOwner, LinkedNullOwnedArray, LinkedNullOwner, LinkedNullReadableArray, LinkedReadonlyExpression, LinkedRecordFields, LinkedNullSlot, LinkedNullState, LinkedNullValue, LinkedSlotOwnershipMatches, LinkedViewPointee } from "./link_plan_c.ku"

fn LinkedNullDropC(&layouts: [StructLayout], &owning_layouts: [StructLayout], &ty: TypeNameBinding, &name: str): str {
    if (ty.declaration_kind == "OwnedStringArray") { return "    ku_managed_source_drop(&" + name.clone() + ");\n" }
    if (ty.declaration_kind == "CaughtError") {
        return "    ku_projection_string_drop(&" + name.clone() + ".domain);\n"
            + "    ku_projection_string_drop(&" + name.clone() + ".code);\n"
            + "    ku_projection_string_drop(&" + name.clone() + ".message);\n"
    }
    if ((ty.name == "str" || ty.name == "bytes") && ty.declaration_kind == "Builtin") {
        return "    ku_projection_string_drop(&" + name.clone() + ");\n"
    }
    if (ty.declaration_kind == "Struct") {
        unit = ty.module_index
        node = ty.declaration_node
        if (LayoutIndex(owning_layouts, unit, node) != 0) {
            return "    " + OwningLayoutDropName(unit, node) + "(&" + name.clone() + ");\n"
        }
        layout = LayoutIndex(layouts, unit, node)
        return GuardOwnedDrops(layouts, layout, name)
    }
    if (LinkedNullOwnedArray(ty) || LinkedNullIntArrayOwner(ty)) {
        return "    " + LinkedNullArrayPrefix(ty) + "_drop(&" + name.clone() + ");\n"
    }
    return ""
}

fn LinkedViewArgument(&parameter: TypeNameBinding, &value: LinkedNullValue): str! {
    if (parameter.declaration_kind == "StringView" && value.ty.declaration_kind == "Builtin" && value.ty.name == parameter.name
        && (!value.borrowed || value.slot > 0)) {
        return ok("&(" + value.text.clone() + ")")
    }
    if (parameter.declaration_kind == "StructView" && (!value.borrowed || value.slot > 0)
        && SameLinkedType(LinkedViewPointee(parameter.clone()), value.ty)) {
        return ok("&(" + value.text.clone() + ")")
    }
    if (SameLinkedType(parameter, value.ty)) { return ok(value.text.clone()) }
    if (parameter.declaration_kind == "BuiltinArray" && parameter.name == "str"
        && value.ty.declaration_kind == "OwnedStringArray" && value.slot > 0 && !value.borrowed) {
        return ok("&(" + value.text.clone() + ")")
    }
    if (MatchesLinkedIntArrayOwner(parameter, value.ty)) { return ok("&(" + value.text.clone() + ")") }
    if (matchesLinkedStructArrayOwner(parameter, value.ty)) {
        return ok("&(" + value.text.clone() + ")")
    }
    RejectLayout("linked_argument_type", "expected a matching stable source for the View argument", value.ty.span.clone())?
    return ok("")
}

fn MatchesLinkedIntArrayOwner(&target: TypeNameBinding, &origin: TypeNameBinding): bool {
    return target.declaration_kind == "BuiltinArray" && target.name == "int" && LinkedNullIntArrayOwner(origin)
}

fn EmitLinkedReadonlyBoolCall(input: LinkedNullExpression, callee: LinkedNullFunction, id: int, at: Span): LinkedNullExpression! {
    parameter = callee.parameters[0].clone()
    if (callee.result.declaration_kind != "Builtin" || callee.result.name != "bool") {
        RejectLayout("linked_readonly_call", "readonly direct call requires a plain bool result", at.clone())?
    }
    argument = input.value.text.clone()
    if (parameter.declaration_kind == "StringView") {
        argument = LinkedViewArgument(parameter, input.value)?
    } else if (parameter.declaration_kind != "Builtin" || (parameter.name != "int" && parameter.name != "bool")
        || !SameLinkedType(parameter, input.value.ty)) {
        RejectLayout("linked_readonly_call", "readonly direct call requires a matching str View or scalar Copy argument", at)?
    }
    return ok(EmitLinkedReadonlyPredicate(input.state, callee, id, argument))
}

fn RequireLinkedNominalPredicate(&callee: LinkedNullFunction, &at: Span): null! {
    if (callee.result.declaration_kind != "Builtin" || callee.result.name != "bool") {
        RejectLayout("linked_readonly_call", "readonly direct call requires a plain bool result", at.clone())?
    }
    for parameter in callee.parameters.clone() {
        if (parameter.declaration_kind != "StructView") {
            RejectLayout("linked_readonly_call", "a readonly multi-argument call requires nominal record Views", at.clone())?
        }
    }
    return ok(null)
}

fn matchesLinkedStructArrayOwner(&target: TypeNameBinding, &origin: TypeNameBinding): bool {
    return target.declaration_kind == "StructArray" && LinkedNullOwnedArray(origin)
        && SameLinkedType(LinkedNullArrayElement(target.clone()), LinkedNullArrayElement(origin.clone()))
}

fn MatchesLinkedFieldValue(&target: TypeNameBinding, &origin: TypeNameBinding): bool {
    if (target.declaration_kind == "StructArray") { return matchesLinkedStructArrayOwner(target, origin) }
    return SameLinkedType(target, origin) || MatchesLinkedIntArrayOwner(target, origin)
}

fn MergeLinkedGuardOwners(state: LinkedNullState, &outer: [LinkedNullSlot], &statement: Node): LinkedNullState! {
    next = state
    index = 0
    while (index < outer.len()) {
        if (LinkedNullOwner(outer[index].value.ty) && !LinkedSlotOwnershipMatches(outer[index], next.slots[index])
            && !ScalarGuardSlotMove(outer[index], next.slots[index], next)) {
            // The no-else path leaves the incoming fields intact. The
            // taken arm cleared any transferred fields before continuing.
            next.slots[index].moved_members = joinedLinkedMemberMoves(outer[index], next.slots[index], statement)?
            next.slots[index].live = outer[index].live || next.slots[index].live
        }
        index = index + 1
    }
    return ok(next)
}

fn joinedLinkedMemberMoves(&first: LinkedNullSlot, &second: LinkedNullSlot, &statement: Node): [str]! {
    same_owner = SameLinkedType(first.value.ty, second.value.ty) && !first.value.borrowed && !second.value.borrowed
    string_owner = first.value.ty.declaration_kind == "Builtin" && first.value.ty.name == "str"
    record_move = first.value.ty.declaration_kind == "Struct" && first.live != second.live
        && OnlyWholeMemberMoves(first.moved_members) && OnlyWholeMemberMoves(second.moved_members)
    if (same_owner && (string_owner || record_move)) {
        // Unavailable for every later read. Cleanup still sees a live slot:
        // the arm transferring its owner zeroes the runtime carrier.
        return ok([""])
    }
    if (first.live && second.live && !first.value.borrowed && !second.value.borrowed
        && first.value.ty.declaration_kind == "Struct" && SameLinkedType(first.value.ty, second.value.ty)) {
        if (ContainsAllTypes(first.moved_members, second.moved_members)) { return ok(second.moved_members.clone()) }
        if (ContainsAllTypes(second.moved_members, first.moved_members)) { return ok(first.moved_members.clone()) }
    }
    RejectLayout("linked_control_move", "conditional code cannot consume an outer owner", DeclarationSpan(statement))?
    return ok([])
}

fn MergeLinkedConditionalMembers(state: LinkedNullState, &first: [LinkedNullSlot], &statement: Node): LinkedNullState! {
    next = state
    index = 0
    while (index < first.len()) {
        if (LinkedNullOwner(first[index].value.ty) && !LinkedSlotOwnershipMatches(first[index], next.slots[index])) {
            // Only availability merges. Actual moves zero their field in the
            // arm that executes, so cleanup still visits this live parent.
            next.slots[index].moved_members = joinedLinkedMemberMoves(first[index], next.slots[index], statement)?
            next.slots[index].live = first[index].live || next.slots[index].live
        }
        index = index + 1
    }
    return ok(next)
}

fn LinkedMemberPath(&receiver: LinkedNullValue, ordinal: int): str {
    if (receiver.slot == 0 || (receiver.borrowed && receiver.member_path == "")) { return "" }
    return receiver.member_path.clone() + "." + str(ordinal)
}

// Selection may walk through a partially moved parent to reach an intact
// sibling. An argument that uses the whole selection needs every descendant.
fn LinkedMemberUnavailable(&state: LinkedNullState, &value: LinkedNullValue, whole: bool): bool {
    if (value.slot == 0) { return false }
    if (!state.slots[value.slot - 1].live) { return true }
    for moved in state.slots[value.slot - 1].moved_members.clone() {
        if (moved == value.member_path || value.member_path.starts_with(moved.clone() + ".")) { return true }
        if (whole && (value.member_path == "" || moved.starts_with(value.member_path.clone() + "."))) { return true }
    }
    return false
}

fn RecordLinkedMemberMove(state: LinkedNullState, &value: LinkedNullValue): LinkedNullState {
    next = state
    index = value.slot - 1
    if (value.member_path == "") {
        next.slots[index].live = false
    } else {
        members = next.slots[index].moved_members.clone()
        next.slots[index].moved_members = members.push(value.member_path.clone())
    }
    return next
}

fn MoveLinkedNullSlot(state: LinkedNullState, &value: LinkedNullValue): LinkedNullState! {
    if (ContainsIndex(state.callback_owners, value.slot) || ContainsIndex(state.append_captures, value.slot)) {
        RejectLayout("linked_callback_owner", "cannot move an array captured by a local callback", value.ty.span.clone())?
    }
    if (value.borrowed && (value.member_path == "" || !LinkedNullOwner(value.ty))) {
        RejectLayout("linked_view_escape", "readonly values cannot be moved or stored without an explicit clone", value.ty.span.clone())?
    }
    if (LinkedMemberUnavailable(state, value, true)) {
        RejectLayout("linked_moved_member", "owned field or parent already has a moved component", value.ty.span.clone())?
    }
    if (value.member_path == "" && LinkedLocalReadCaptures(state.local_readers, value.slot)) {
        RejectLayout("linked_local_reader_capture_move", "cannot move an array captured by a local reader", value.ty.span.clone())?
    }
    next = state
    if (value.slot > 0 && LinkedNullDropC(next.layouts, next.owning_layouts, value.ty, value.text) != "") {
        next.code = next.code + "    " + value.text.clone() + " = (" + LinkedNullCType(value.ty)? + "){0};\n"
        next = RecordLinkedMemberMove(next, value)
    }
    return ok(next)
}

fn dropLinkedScope(state: LinkedNullState, outer: int, unwind: bool): LinkedNullState {
    next = state
    index = next.slots.len()
    while (index > outer) {
        index = index - 1
        slot = next.slots[index].clone()
        if ((slot.live || unwind) && !slot.value.borrowed && LinkedNullOwner(slot.value.ty)) {
            next.code = next.code + LinkedNullDropC(next.layouts, next.owning_layouts, slot.value.ty, slot.value.text)
        }
        next.slots[index].binding = ""
        next.slots[index].live = false
    }
    return next
}

fn DropLinkedNullScope(state: LinkedNullState, outer: int): LinkedNullState {
    return dropLinkedScope(state, outer, false)
}

fn BindLinkedCatch(state: LinkedNullState, name: str, &binding: Node, &before: [LinkedNullSlot]): LinkedNullState! {
    if (!state.catch_edges || LinkedNullBinding(before, name) != 0) {
        RejectLayout("linked_catch_shape", "catch requires a reachable error edge and a distinct Error binding", DeclarationSpan(binding))?
    }
    next = state
    slot = next.catch_slot
    next.code += next.slots[slot - 1].value.text.clone() + "_handler:\n"
    // Every slot starts zero. A later syntactic move need not have
    // happened at the point of the failure, so unwind its owner as well.
    next = dropLinkedScope(next, slot, true)
    index = 0
    while (index < before.len()) {
        next.slots[index].live = before[index].live && !ContainsIndex(next.catch_moved, index)
        index = index + 1
    }
    next.slots[slot - 1].binding = name
    next.slots[slot - 1].live = true
    next.catch_slot = 0
    next.catch_edges = false
    cleared: [int] = []
    next.catch_moved = cleared
    return ok(next)
}

fn LinkedNullArrayLimitName(&project: LinkedNullProject, node_id: int): str {
    node = LinkedNullNode(project, 1, node_id)
    if (node.kind == "Binary" && node.text == "-" && node.edge_count == 2) {
        amount = LinkedNullNode(project, 1, LinkedNullChild(project, 1, node, 1))
        if (amount.kind != "Int" || amount.edge_count != 0 || amount.int_value < 0) { return "" }
        node = LinkedNullNode(project, 1, LinkedNullChild(project, 1, node, 0))
    }
    if (node.kind != "Call" || node.edge_count != 1) { return "" }
    target = LinkedNullNode(project, 1, LinkedNullChild(project, 1, node, 0))
    if (target.kind != "Field" || target.edge_count != 1 || target.text != "len") { return "" }
    receiver = LinkedNullNode(project, 1, LinkedNullChild(project, 1, target, 0))
    if (receiver.kind != "Variable" || receiver.edge_count != 0) { return "" }
    return receiver.text
}

fn LinkedLiveIntBinding(&state: LinkedNullState, &node: Node): int {
    if (node.kind != "Variable" || node.edge_count != 0) { return 0 }
    slot = LinkedNullBinding(state.slots, node.text)
    if (slot == 0 || !state.slots[slot - 1].live || state.slots[slot - 1].value.borrowed) { return 0 }
    ty = state.slots[slot - 1].value.ty.clone()
    if (ty.declaration_kind == "Builtin" && ty.name == "int") { return slot }
    return 0
}

fn linkedCountedMember(&project: LinkedNullProject, candidate: Node): Node {
    if (candidate.kind == "Call" && candidate.edge_count == 1) {
        method = LinkedNullNode(project, 1, LinkedNullChild(project, 1, candidate, 0))
        if (method.kind == "Field" && method.text == "len" && method.edge_count == 1) {
            return LinkedNullNode(project, 1, LinkedNullChild(project, 1, method, 0))
        }
    }
    return candidate
}

fn LinkedCountBound(&project: LinkedNullProject, &state: LinkedNullState, id: int): bool! {
    bound = LinkedNullNode(project, 1, id)
    if (LinkedLiveIntBinding(state, bound) != 0) { return ok(true) }
    array = LinkedNullBinding(state.slots, LinkedNullArrayLimitName(project, id))
    if (array > 0) {
        return ok(LinkedNullReadableArray(state.slots[array - 1].value.ty))
    }
    array_member = bound.kind == "Call"
    member = linkedCountedMember(project, bound)
    if (member.kind != "Field" || member.edge_count != 1) { return ok(false) }
    receiver = LinkedNullNode(project, 1, LinkedNullChild(project, 1, member, 0))
    if (receiver.kind != "Variable" || receiver.edge_count != 0) { return ok(false) }
    slot = LinkedNullBinding(state.slots, receiver.text)
    if (slot == 0 || !state.slots[slot - 1].live) { return ok(false) }
    binding = state.slots[slot - 1].value.ty.clone()
    if (binding.declaration_kind != "Struct") { return ok(false) }
    fields = LinkedRecordFields(state.layouts, state.owning_layouts, binding)?
    field = FieldIndex(fields, member.text)
    if (field == 0) { return ok(false) }
    ty = fields[field - 1].resolved.clone()
    if (array_member) { return ok(LinkedNullReadableArray(ty)) }
    return ok(ty.declaration_kind == "Builtin" && ty.name == "int")
}

fn CheckLinkedAddition(&state: LinkedNullState, &left: LinkedNullValue, &right: LinkedNullValue, &at: Span): null! {
    if (left.ty.declaration_kind != "Builtin" || !SameBoundTypeIdentity(left.ty, right.ty)) {
        RejectLayout("linked_binary_type", "addition requires matching scalar operands", at.clone())?
    }
    if (left.slot > 0 && !state.slots[left.slot - 1].live) {
        RejectLayout("linked_addition_moved_operand", "right operand consumed the left operand's binding", at.clone())?
    }
    if (left.ty.name != "int" && left.ty.name != "str") {
        RejectLayout("linked_binary_type", "addition requires int or str", at.clone())?
    }
    return ok(null)
}

fn linkedCountedBoundWrite(&node: Node, &name: str): bool {
    return (node.kind == "Assign" || node.kind == "VarDecl" || node.kind == "ObjectDestructureLocal") && node.text == name
}

fn RejectLinkedWriteRange(&project: LinkedNullProject, start: int, end: int, &name: str, code: str, message: str): null! {
    index = start
    while (index < end) {
        if (linkedCountedBoundWrite(project.supplied[0].named.parsed.arena.nodes[index - 1], name)) {
            RejectLayout(code.clone(), message.clone(), DeclarationSpan(project.supplied[0].named.parsed.arena.nodes[index - 1]))?
        }
        index = index + 1
    }
    return ok(null)
}

fn RejectLinkedLoopWrite(&project: LinkedNullProject, &loop: Node, &name: str, code: str, message: str): null! {
    // The checked AST is contiguous and in post-order. This region includes
    // all nested writes before the terminal cursor update.
    start = LinkedNullChild(project, 1, loop, 0) + 1
    end = LinkedNullChild(project, 1, loop, loop.edge_count - 1)
    return RejectLinkedWriteRange(project, start, end, name, code, message)
}

fn LinkedIncreasingGuard(&project: LinkedNullProject, &loop: Node): Node {
    guard = LinkedNullNode(project, 1, LinkedNullChild(project, 1, loop, 0))
    if (guard.kind == "Binary" && guard.text == "&&" && guard.edge_count == 2) {
        // The readonly right operand may stop before the fixed upper bound.
        return LinkedNullNode(project, 1, LinkedNullChild(project, 1, guard, 0))
    }
    return guard
}

fn CheckLinkedCountedBoundWrites(&project: LinkedNullProject, &state: LinkedNullState, &loop: Node): null! {
    guard = LinkedIncreasingGuard(project, loop)
    bound_id = LinkedNullChild(project, 1, guard, 1)
    bound = LinkedNullNode(project, 1, bound_id)
    cursor = LinkedNullNode(project, 1, LinkedNullChild(project, 1, guard, 0))
    named_bound = LinkedLiveIntBinding(state, bound) != 0
    if (named_bound && cursor.text == bound.text) {
        RejectLayout("linked_loop_bound_cursor", "counted cursor and named int bound must be distinct", DeclarationSpan(guard))?
    }
    RejectLinkedLoopWrite(project, loop, cursor.text, "linked_loop_cursor_write", "a counted loop can change its cursor only at the end")?
    if (named_bound) {
        // The upper bound stays fixed while the cursor advances by one.
        return RejectLinkedLoopWrite(project, loop, bound.text, "linked_loop_bound_write", "a counted loop cannot rebind its named int bound")
    }
    name = LinkedNullArrayLimitName(project, bound_id)
    if (name == "") {
        // The counted header already validated the member and its receiver.
        member = linkedCountedMember(project, bound)
        if (member.kind != "Field") { return ok(null) }
        receiver = LinkedNullNode(project, 1, LinkedNullChild(project, 1, member, 0))
        return RejectLinkedLoopWrite(project, loop, receiver.text, "linked_loop_bound_write",
            "a counted loop cannot rebind the record supplying its bound")
    }
    slot = LinkedNullBinding(state.slots, name)
    if (slot == 0) { return ok(null) }
    ty = state.slots[slot - 1].value.ty.clone()
    if (!LinkedNullOwnedArray(ty) && !LinkedNullIntArrayOwner(ty)) { return ok(null) }

    return RejectLinkedLoopWrite(project, loop, name, "linked_loop_bound_write",
        "a counted loop cannot rebind its owned array length source")
}

fn EmitLinkedMultiplyDivide(state: LinkedNullState, &node: Node, id: int,
                            &left: LinkedNullValue, &right: LinkedNullValue): LinkedNullExpression {
    next = state
    out = "t" + str(id)
    if (node.text == "*") {
        next.uses_mul = true
        next.code += EmitCheckedScalarArithmetic("mul", left.text, right.text, out)
    } else {
        next.uses_div = true
        next.code += "    int64_t " + out.clone() + ";\n    {\n"
            + "        const int64_t dividend = " + left.text.clone() + ";\n"
            + "        const int64_t divisor = " + right.text.clone() + ";\n"
            + "        if (divisor == 0) { division_by_zero = true; goto cleanup; }\n"
            + "        if (dividend == INT64_MIN && divisor == -1) { overflow = true; goto cleanup; }\n"
            + "        " + out.clone() + " = dividend / divisor;\n    }\n"
    }
    return LinkedReadonlyExpression(next, LinkedBuiltin("int", DeclarationSpan(node)), out)
}
