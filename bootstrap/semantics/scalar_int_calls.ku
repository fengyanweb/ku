import { FirstSubtreeNode, Node } from "../stage2/ast.ku"
import { DeclarationSpan, TopLevelName } from "./names.ku"
import { TypeNameBinding } from "./type_names.ku"
import { ScalarIntInstruction, ScalarIntParameter } from "./scalar_int_emit.ku"
import { RejectScalarInt as rejectScalarInt, ScalarParameterIndex as scalarParameterIndex } from "./scalar_int_operands.ku"
import { ScalarType as scalarType, ScalarReturnType as scalarReturnType } from "./scalar_types.ku"

struct ScalarIntSignature {
    arity: int
    has_string_parameter: bool
    result_type: int
}

struct ScalarIntImport {
    local_name: str
    target: int
    signature: ScalarIntSignature
}

struct ScalarIntCall {
    target_node: int
    function_node: int
}

fn ScalarFunctionNode(&declarations: [TopLevelName], &name: str): int {
    index = 0
    while (index < declarations.len()) {
        if (declarations[index].kind == "Function" && declarations[index].name == name) {
            return declarations[index].node
        }
        index = index + 1
    }
    return 0
}

fn ScalarIntCalleeSignature(&nodes: [Node], &edges: [int], &bindings: [TypeNameBinding], function_node: int): ScalarIntSignature {
    function = nodes[function_node - 1].clone()
    arity = 0
    has_string = false
    parameter_limit = function.edge_count
    while (arity < parameter_limit) {
        parameter_node = edges[function.first_edge + arity]
        if (nodes[parameter_node - 1].kind != "Parameter") {
            result_type = scalarReturnType(nodes, edges, bindings, parameter_node)
            return ScalarIntSignature { arity: arity, has_string_parameter: has_string, result_type: result_type }
        }
        parameter = nodes[parameter_node - 1].clone()
        if (parameter.edge_count == 1) {
            type_node = edges[parameter.first_edge]
            parameter_type = scalarType(bindings, type_node, nodes[type_node - 1])
            if (parameter_type == 2) {
                has_string = true
            }
        }
        arity = arity + 1
    }
    return ScalarIntSignature { arity: arity, has_string_parameter: has_string, result_type: 0 }
}

fn linkIntCallee(&imports: [ScalarIntImport], &target: Node): ScalarIntImport! {
    index = 0
    while (index < imports.len()) {
        if (imports[index].local_name == target.text) { return ok(imports[index].clone()) }
        index = index + 1
    }
    rejectScalarInt("unknown_int_callee", "no local function '" + target.text.clone() + "'", DeclarationSpan(target))?
    return ok(ScalarIntImport { local_name: "", target: 0,
        signature: ScalarIntSignature { arity: 0, has_string_parameter: false, result_type: 0 } })
}

fn resolveIntCallee(&nodes: [Node], &edges: [int], &declarations: [TopLevelName],
                    &bindings: [TypeNameBinding], &imports: [ScalarIntImport], local_base: int,
                    &target: Node): ScalarIntImport! {
    function_node = ScalarFunctionNode(declarations, target.text)
    if (function_node == 0) { return linkIntCallee(imports, target) }
    signature = ScalarIntCalleeSignature(nodes, edges, bindings, function_node)
    return ok(ScalarIntImport { local_name: "", target: local_base + function_node, signature: signature })
}

fn bindIntCall(&nodes: [Node], &edges: [int], &declarations: [TopLevelName],
               &bindings: [TypeNameBinding], &parameters: [ScalarIntParameter],
               &imports: [ScalarIntImport], local_base: int, &call: Node): ScalarIntCall! {
    if (call.edge_count == 0) {
        rejectScalarInt("unsupported_int_callee", "expected a direct function call", DeclarationSpan(call))?
    }
    target_node = edges[call.first_edge]
    target = nodes[target_node - 1].clone()
    if (target.kind != "Variable" || target.edge_count != 0) {
        rejectScalarInt("unsupported_int_callee", "expected an unshadowed function name", DeclarationSpan(target))?
    }
    shadow = scalarParameterIndex(parameters, target.text)
    if (shadow >= 0) {
        rejectScalarInt("unsupported_int_callee", "expected an unshadowed function name", DeclarationSpan(target))?
    }
    callee = resolveIntCallee(nodes, edges, declarations, bindings, imports, local_base, target)?
    if (callee.signature.has_string_parameter) {
        rejectScalarInt("unsupported_int_callee_signature", "calls in the int subset cannot transfer string parameters", DeclarationSpan(call))?
    }
    arity = callee.signature.arity
    if (call.edge_count - 1 != arity) {
        rejectScalarInt("int_call_arity", "expected " + str(arity) + " arguments for '" + target.text + "'", DeclarationSpan(call))?
    }
    if (callee.signature.result_type >= 2) {
        rejectScalarInt("unsupported_int_callee_result", "calls in an int expression must return int", DeclarationSpan(call))?
    }
    return ok(ScalarIntCall { target_node: target_node, function_node: callee.target })
}

fn isIntCallTarget(&calls: [ScalarIntCall], node: int): bool {
    index = 0
    while (index < calls.len()) {
        if (calls[index].target_node == node) { return true }
        index = index + 1
    }
    return false
}

fn ScalarIntArguments(&edges: [int], start: int, count: int): [int] {
    arguments: [int] = []
    index = 0
    while (index < count) {
        arguments = arguments.push(edges[start + index])
        index = index + 1
    }
    return arguments
}

fn LowerIntExpression(&nodes: [Node], &edges: [int], &declarations: [TopLevelName],
                      &bindings: [TypeNameBinding], &parameters: [ScalarIntParameter],
                      &imports: [ScalarIntImport], local_base: int, result_node: int): [ScalarIntInstruction]! {
    // Every node from the first leaf through result_node belongs to this expression.
    start = FirstSubtreeNode(nodes, edges, result_node)
    limit = result_node + 1
    calls: [ScalarIntCall] = []
    probe = start
    while (probe < limit) {
        if (nodes[probe - 1].kind == "Call") {
            call = bindIntCall(nodes, edges, declarations, bindings, parameters, imports, local_base, nodes[probe - 1])?
            calls = calls.push(call)
        }
        probe = probe + 1
    }
    instructions: [ScalarIntInstruction] = []
    call_index = 0
    cursor = start
    while (cursor < limit) {
        node = nodes[cursor - 1].clone()
        operation = ""
        operand = 0
        right_node = 0
        argument_start = 0
        arity = 0
        target = false
        if (node.kind == "Int" && node.edge_count == 0 && node.int_value >= 0) {
            operation = "constant"
            operand = node.int_value
        } else if (node.kind == "Variable" && node.edge_count == 0) {
            // The validated AST is a tree, so only the Call can consume this
            // particular identifier. It needs no value or C temporary.
            called = isIntCallTarget(calls, cursor)
            if (called) { target = true }
            else {
                operation = "parameter"
                parameter = scalarParameterIndex(parameters, node.text)
                operand = parameter
                if (operand < 0) {
                    rejectScalarInt("undefined_int_operand", "undefined int parameter '" + node.text.clone() + "'", DeclarationSpan(node))?
                }
                if (parameters[operand].string_mode != 0) {
                    rejectScalarInt("unsupported_int_operand_type", "expected an int operand, found str", DeclarationSpan(node))?
                }
            }
        } else if (node.kind == "Unary" && node.edge_count == 1 && node.text == "-") {
            operation = "sub"
            right_node = edges[node.first_edge]
        } else if (node.kind == "Binary" && node.edge_count == 2) {
            if (node.text == "+") { operation = "add" }
            else if (node.text == "-") { operation = "sub" }
            else if (node.text == "*") { operation = "mul" }
            else if (node.text == "/") { operation = "div" }
            else if (node.text == "%") { operation = "rem" }
            operand = edges[node.first_edge]
            right_node = edges[node.first_edge + 1]
        } else if (node.kind == "Call") {
            operation = "call"
            operand = calls[call_index].function_node
            call_index = call_index + 1
            argument_start = node.first_edge + 1
            arity = node.edge_count - 1
        }
        if (!target) {
            if (operation == "") {
                rejectScalarInt("unsupported_int_expression", "expected an int literal, parameter, arithmetic, or direct int call", DeclarationSpan(node))?
            }
            arguments = ScalarIntArguments(edges, argument_start, arity)
            instruction = ScalarIntInstruction { operation: operation, result_node: cursor, operand: operand,
                                                right_node: right_node, arguments: arguments }
            instructions = instructions.push(instruction)
        }
        cursor = cursor + 1
    }
    return ok(instructions)
}
