import { Node, ParseOutput, ValidateParseOutput } from "../stage2/ast.ku"
import { DiagnosticCanonical, MakeDiagnostic } from "../stage2/diagnostic.ku"
import { Span, SpanCanonical } from "../stage2/span.ku"

struct TopLevelName {
    kind: str
    name: str
    node: int
    span: Span
}

struct ModuleNameTable {
    declarations: [TopLevelName]
    imports: [int]
}

struct NamedModule {
    parsed: ParseOutput
    names: ModuleNameTable
}

fn DeclarationSpan(&node: Node): Span {
    return Span {
        line: node.line, column: node.column, offset: node.offset,
        end_line: node.end_line, end_column: node.end_column, end_offset: node.end_offset
    }
}

fn RejectName(code: str, message: str, span: Span): null! {
    domain = "bootstrap.semantics.names"
    diagnostic = MakeDiagnostic("error", domain.clone(), code.clone(), message, "<source>", span)
    fail { domain: domain, code: code, message: DiagnosticCanonical(diagnostic) }
}

fn CheckReserved(&name: str, span: Span): null! {
    // Match the Stage0 checker; the import expander owns these exceptions.
    if (name.starts_with("__ku_") && !name.starts_with("__ku_import") && !name.starts_with("__ku_ns")) {
        RejectName("reserved_name", "name '" + name.clone() + "' is reserved: identifiers starting with '__ku_' are used by the compiler", span)?
    }
    return ok(null)
}

fn IsNamedFunction(&kind: str): bool {
    return kind == "Function" || kind == "AsyncFunction"
}

// The Stage0 checker visits all siblings when inferring a function's return,
// and in a for body. Ordinary nested blocks stop at a non-fallthrough statement.
fn parameterBlockExit(&nodes: [Node], &edges: [int], start: int, stop: int, seeking_break: bool): bool {
    cursor = start
    while (cursor < stop) {
        statement = nodes[edges[cursor] - 1].clone()
        first = statement.first_edge
        end = first + statement.edge_count
        if (statement.kind == "If") {
            then_start = first + 1
            else_start = then_start + statement.int_value
            if (seeking_break) {
                if (parameterBlockExit(nodes, edges, then_start, end, true)) { return true }
            } else if (else_start < end && parameterBlockExit(nodes, edges, then_start, else_start, false)
                       && parameterBlockExit(nodes, edges, else_start, end, false)) {
                return true
            }
        } else if (seeking_break) {
            if (statement.kind == "Break") { return true }
            if (statement.kind == "Try") {
                try_body = nodes[edges[first] - 1].clone()
                catch_clause = nodes[edges[first + 1] - 1].clone()
                catch_body = nodes[edges[catch_clause.first_edge + 1] - 1].clone()
                if (parameterBlockExit(nodes, edges, try_body.first_edge, try_body.first_edge + try_body.edge_count, true)
                    || parameterBlockExit(nodes, edges, catch_body.first_edge, catch_body.first_edge + catch_body.edge_count, true)) {
                    return true
                }
            }
        } else if (statement.kind == "Break" || statement.kind == "Continue" || statement.kind == "Return"
                   || statement.kind == "Fail" || statement.kind == "Panic") {
            return true
        } else if (statement.kind == "While") {
            condition = nodes[edges[first] - 1].clone()
            if (condition.kind == "Bool" && condition.text == "true"
                && !parameterBlockExit(nodes, edges, first + 1, end, true)) {
                return true
            }
        }
        cursor = cursor + 1
    }
    return false
}

fn writesParameter(&nodes: [Node], &edges: [int], &statement: Node, &name: str): bool {
    if (statement.kind == "Assign") { return statement.text == name }
    if (statement.kind == "CompoundAssign") {
        target = nodes[edges[statement.first_edge] - 1].clone()
        return target.kind == "Variable" && target.text == name
    }
    if (statement.kind == "ObjectDestructureAssign") {
        start = statement.first_edge
        stop = start + statement.edge_count - 1
        cursor = start
        while (cursor < stop) {
            field = nodes[edges[cursor] - 1].clone()
            if (field.kind == "ObjectDestructureRest") {
                if (field.text == name) { return true }
            } else if (nodes[edges[field.first_edge] - 1].text == name) {
                return true
            }
            cursor = cursor + 1
        }
    }
    return false
}

fn ParameterEnd(&nodes: [Node], &edges: [int], start: int, stop: int): int {
    cursor = start
    while (cursor < stop && nodes[edges[cursor] - 1].kind == "Parameter") { cursor = cursor + 1 }
    return cursor
}

// Inspect one known formal through lexical block edges only. A local which
// shadows it masks the remainder of that block, never a sibling branch.
fn checkParameterBlock(&nodes: [Node], &edges: [int], start: int, stop: int, &name: str,
                       infer_return: bool, stop_at_exit: bool): null! {
    cursor = start
    while (cursor < stop) {
        statement = nodes[edges[cursor] - 1].clone()
        first = statement.first_edge
        end = first + statement.edge_count
        if (statement.kind == "If") {
            then_start = first + 1
            else_start = then_start + statement.int_value
            checkParameterBlock(nodes, edges, then_start, else_start, name, infer_return, !infer_return)?
            checkParameterBlock(nodes, edges, else_start, end, name, infer_return, !infer_return)?
        } else if (statement.kind == "While") {
            checkParameterBlock(nodes, edges, first + 1, end, name, false, true)?
        } else if (statement.kind == "For") {
            if (statement.text != name) {
                checkParameterBlock(nodes, edges, first + 1, end, name, false, false)?
            }
        } else if (statement.kind == "Try") {
            try_body = nodes[edges[first] - 1].clone()
            checkParameterBlock(nodes, edges, try_body.first_edge, try_body.first_edge + try_body.edge_count, name, false, true)?
            catch_clause = nodes[edges[first + 1] - 1].clone()
            if (nodes[edges[catch_clause.first_edge] - 1].text != name) {
                catch_body = nodes[edges[catch_clause.first_edge + 1] - 1].clone()
                checkParameterBlock(nodes, edges, catch_body.first_edge, catch_body.first_edge + catch_body.edge_count, name, false, true)?
            }
        } else {
            if (writesParameter(nodes, edges, statement, name)) {
                RejectName("immutable_parameter", "cannot assign to immutable parameter '" + name.clone() + "'", DeclarationSpan(statement))?
            }
            nested = 0
            if (IsNamedFunction(statement.kind)) { nested = edges[cursor] }
            else if (statement.kind == "VarDecl" || statement.kind == "Assign") {
                if (end > first && nodes[edges[end - 1] - 1].kind == "FunctionExpr") { nested = edges[end - 1] }
            }
            if (nested != 0) {
                function = nodes[nested - 1].clone()
                args = function.first_edge
                body_stop = args + function.edge_count
                body_start = ParameterEnd(nodes, edges, args, body_stop)
                captures = function.text != name
                while (args < body_start && captures) {
                    captures = nodes[edges[args] - 1].text != name
                    args = args + 1
                }
                if (captures) { checkParameterBlock(nodes, edges, body_start, body_stop, name, true, false)? }
            }
            if ((statement.kind == "VarDecl" || IsNamedFunction(statement.kind)) && statement.text == name) {
                return ok(null)
            }
        }
        if (stop_at_exit && cursor + 1 < stop && parameterBlockExit(nodes, edges, cursor, cursor + 1, false)) {
            return ok(null)
        }
        cursor = cursor + 1
    }
    return ok(null)
}

fn CheckParameterWrites(&nodes: [Node], &edges: [int], &function: Node): null! {
    start = function.first_edge
    stop = start + function.edge_count
    body = ParameterEnd(nodes, edges, start, stop)
    cursor = start
    while (cursor < body) {
        checkParameterBlock(nodes, edges, body, stop, nodes[edges[cursor] - 1].text, true, false)?
        cursor = cursor + 1
    }
    return ok(null)
}

fn CheckSignatureBindings(&nodes: [Node], &edges: [int], &item: Node): null! {
    item_span = DeclarationSpan(item)
    index = 0
    while (index < item.edge_count) {
        child = nodes[edges[item.first_edge + index] - 1].clone()
        if (IsNamedFunction(item.kind) && child.kind == "Parameter") {
            CheckReserved(child.text, DeclarationSpan(child))?
        } else if (item.kind == "Struct" && child.kind == "StructField") {
            CheckReserved(child.text, item_span.clone())?
        } else if (item.kind == "Enum" && child.kind == "EnumVariant") {
            CheckReserved(child.text, item_span.clone())?
            field_index = 0
            while (field_index < child.edge_count) {
                field = nodes[edges[child.first_edge + field_index] - 1].clone()
                if (field.kind == "EnumVariantField") {
                    CheckReserved(field.text, item_span.clone())?
                }
                field_index = field_index + 1
            }
        }
        index = index + 1
    }
    return ok(null)
}

fn CollectNames(&nodes: [Node], &edges: [int], root: int): ModuleNameTable! {
    program = nodes[root - 1].clone()
    program_span = DeclarationSpan(program)
    if (program.kind != "Program") {
        RejectName("invalid_module_tree", "name collection requires a Stage 3 Program root", program_span.clone())?
    }
    // A 512-token Stage 3 file can contain at most 255 direct items. Keep the
    // same bound even when a caller constructs an AST with valid arena links.
    if (program.edge_count > 255) {
        RejectName("item_limit", "name collection accepts at most 255 top-level items", program_span)?
    }
    declarations: [TopLevelName] = []
    imports: [int] = []
    index = 0
    while (index < program.edge_count) {
        node_id = edges[program.first_edge + index]
        item = nodes[node_id - 1].clone()
        if (item.kind == "Import") {
            imports = imports.push(node_id)
        } else {
            span = DeclarationSpan(item)
            if (item.kind != "Module" && !IsNamedFunction(item.kind) && item.kind != "Struct" && item.kind != "Enum") {
                RejectName("invalid_module_tree", "unsupported top-level AST item '" + item.kind.clone() + "'", span.clone())?
            }
            if (item.kind != "Module") {
                CheckReserved(item.text, span.clone())?
                CheckSignatureBindings(nodes, edges, item)?
            }
            previous = 0
            while (previous < declarations.len()) {
                if (declarations[previous].name == item.text) {
                    RejectName("duplicate_name", "top-level name '" + item.text.clone() + "' is already defined", span.clone())?
                }
                previous = previous + 1
            }
            declaration = TopLevelName { kind: item.kind, name: item.text, node: node_id, span: span }
            declarations = declarations.push(declaration)
        }
        index = index + 1
    }
    return ok(ModuleNameTable { declarations: declarations, imports: imports })
}

// No import files are opened here. Keep their NodeIds for a separate module
// resolution pass, and keep the graph as the owner of all arena positions.
fn BuildNameTable(output: ParseOutput): NamedModule! {
    parsed = ValidateParseOutput(output)?
    root = parsed.root
    names = CollectNames(parsed.arena.nodes, parsed.arena.edges, root)?
    return ok(NamedModule { parsed: parsed, names: names })
}

fn FormatNames(&declarations: [TopLevelName], import_count: int): str {
    text = "IMPORTS|" + str(import_count)
    index = 0
    while (index < declarations.len()) {
        name = declarations[index].clone()
        text += "\nNAME|" + name.kind + "|" + name.name + "|" + str(name.node) + "|" + SpanCanonical(name.span)
        index = index + 1
    }
    return text
}

fn NamesCanonical(&table: ModuleNameTable): str {
    import_count = table.imports.len()
    return FormatNames(table.declarations, import_count)
}

struct DirectMovePlace {
    binding: int
    path: str
}

struct DirectMoveFlow {
    bindings: [int]
    moved: [DirectMovePlace]
    terminal: bool
}

fn FindDirectMoveBinding(&nodes: [Node], &bindings: [int], &name: str): int {
    found = 0
    index = 0
    while (index < bindings.len()) {
        id = bindings[index]
        if (nodes[id - 1].text == name) { found = id }
        index = index + 1
    }
    return found
}

fn DirectMovePath(&nodes: [Node], &edges: [int], &bindings: [int], id: int): DirectMovePlace {
    path = ""
    current = id
    reading = nodes[current - 1].kind == "Field"
    while (reading) {
        path = "." + nodes[current - 1].text.clone() + path
        current = edges[nodes[current - 1].first_edge]
        reading = nodes[current - 1].kind == "Field"
    }
    binding = 0
    if (nodes[current - 1].kind == "Variable") { binding = FindDirectMoveBinding(nodes, bindings, nodes[current - 1].text) }
    return DirectMovePlace { binding: binding, path: path }
}

fn directStructOrigin(&nodes: [Node], &edges: [int], binding: int): int {
    owner = nodes[binding - 1].clone()
    if (owner.edge_count == 0) { return 0 }
    origin = edges[owner.first_edge]
    kind = nodes[origin - 1].kind.clone()
    if ((owner.kind == "Parameter" || owner.kind == "VarDecl") && kind == "TypeName") { return origin }
    if (owner.kind == "Assign" && kind == "StructLiteral") { return origin }
    return 0
}

fn hasDirectOwnedStringField(&nodes: [Node], &edges: [int], &record: Node, &name: str): bool {
    count = record.edge_count
    index = 0
    while (index < count) {
        field = nodes[edges[record.first_edge + index] - 1].clone()
        if (field.kind == "StructField" && field.text == name && field.edge_count == 1) {
            annotation = nodes[edges[field.first_edge] - 1].clone()
            return annotation.kind == "TypeName" && annotation.text == "str"
        }
        index = index + 1
    }
    return false
}

fn ProvesDirectFieldTransfer(&nodes: [Node], &edges: [int], binding: int, &field: Node): bool {
    // Only a direct, declared struct field denotes storage which the call
    // consumes. Object/map lookup reads can produce independent values.
    if (field.kind != "Field" || field.edge_count != 1 || nodes[edges[field.first_edge] - 1].kind != "Variable") { return false }
    origin = directStructOrigin(nodes, edges, binding)
    if (origin == 0) { return false }
    root = nodes[nodes.len() - 1].clone()
    count = root.edge_count
    index = 0
    while (index < count) {
        record = nodes[edges[root.first_edge + index] - 1].clone()
        if (record.kind == "Struct" && record.text == nodes[origin - 1].text) {
            return hasDirectOwnedStringField(nodes, edges, record, field.text)
        }
        index = index + 1
    }
    return false
}

fn DirectMoveContains(&parent: str, &path: str): bool {
    if (parent == "" || parent == path) { return true }
    prefix = parent + "."
    if (path.starts_with(prefix)) { return true }
    return false
}

fn CheckDirectMoveRead(&nodes: [Node], &moved: [DirectMovePlace], &place: DirectMovePlace, id: int): null! {
    index = 0
    while (index < moved.len()) {
        if (moved[index].binding == place.binding && DirectMoveContains(moved[index].path, place.path)) {
            name = nodes[place.binding - 1].text.clone() + place.path.clone()
            RejectName("read_after_owned_transfer", "use of moved value '" + name + "'", DeclarationSpan(nodes[id - 1]))?
        }
        index = index + 1
    }
    return ok(null)
}

fn ResetDirectMove(moved: [DirectMovePlace], &place: DirectMovePlace): [DirectMovePlace] {
    kept: [DirectMovePlace] = []
    for old in moved {
        if (old.binding != place.binding || !DirectMoveContains(place.path, old.path)) { kept = kept.push(old) }
    }
    return kept
}

fn JoinDirectMoves(left: [DirectMovePlace], right: [DirectMovePlace]): [DirectMovePlace] {
    joined = left
    for place in right {
        duplicate = false
        index = 0
        while (!duplicate && index < joined.len()) {
            duplicate = joined[index].binding == place.binding && joined[index].path == place.path
            index = index + 1
        }
        if (!duplicate) { joined = joined.push(place) }
    }
    return joined
}
