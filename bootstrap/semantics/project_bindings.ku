import { EscapeCanonical } from "../stage1/token.ku"
import { Span } from "../stage2/span.ku"
import { CheckDirectCallArities } from "./call_contracts.ku"
import { BindProjectImports, ImportBinding, SuppliedModule } from "./imports.ku"
import { RejectName } from "./names.ku"
import { BindImportedTypeNames, TypeNameBinding } from "./type_names.ku"

struct ProjectModuleBindings {
    path: str
    imports: [ImportBinding]
    types: [TypeNameBinding]
}

struct ProjectBindings {
    modules: [ProjectModuleBindings]
    order: [int]
}

fn resolveProjectModule(&entry: SuppliedModule, &supplied: [SuppliedModule]): ProjectModuleBindings! {
    try {
        imports = BindProjectImports(entry, supplied)?
        types = BindImportedTypeNames(entry.named, imports, supplied)?
        CheckDirectCallArities(entry.named, imports, supplied)?
        return ok(ProjectModuleBindings { path: entry.path.clone(), imports: imports, types: types })
    } catch (err) {
        fail {
            domain: err.domain, code: err.code,
            message: EscapeCanonical(entry.path.clone()) + ": " + err.message
        }
    }
}

fn projectImportOrder(&modules: [ProjectModuleBindings]): [int]! {
    done: [bool] = []
    while (done.len() < modules.len()) { done = done.push(false) }
    order: [int] = []
    while (order.len() < modules.len()) {
        index = 0
        next = -1
        blocked_path = ""
        blocked_at = Span { line: 1, column: 1, offset: 0, end_line: 1, end_column: 1, end_offset: 0 }
        while (index < modules.len() && next < 0) {
            if (!done[index]) {
                ready = true
                edge = 0
                edge_count = modules[index].imports.len()
                while (edge < edge_count) {
                    dependency = modules[index].imports[edge].module_index
                    if (dependency > 0 && !done[dependency - 1]) {
                        ready = false
                        blocked_at = modules[index].imports[edge].span.clone()
                        blocked_path = modules[index].path.clone()
                        break
                    }
                    edge = edge + 1
                }
                if (ready) { next = index }
            }
            index = index + 1
        }
        if (next < 0) {
            RejectName("cyclic_import", "no remaining project module has resolved dependencies, including '" + blocked_path + "'", blocked_at)?
        }
        done[next] = true
        order = order.push(next)
    }
    return ok(order)
}


fn BindProjectModules(&supplied: [SuppliedModule]): ProjectBindings! {
    modules: [ProjectModuleBindings] = []
    index = 0
    while (index < supplied.len()) {
        bound = resolveProjectModule(supplied[index], supplied)?
        modules = modules.push(bound)
        index = index + 1
    }
    order = projectImportOrder(modules)?
    return ok(ProjectBindings { modules: modules, order: order })
}
