import { CheckDirectOwnedMoves } from "./call_contracts.ku"
import { EscapeCanonical } from "../stage1/token.ku"
import { FirstSubtreeNode, Node } from "../stage2/ast.ku"
import { Span } from "../stage2/span.ku"
import { BindProjectImports, ImportBinding, ProjectNamespaceModule, ReadImportNode, ResolveProjectNamespaceFunction, SuppliedModule } from "./imports.ku"
import { DeclarationSpan, IsNamedFunction, NamedModule, RejectName, CheckParameterWrites } from "./names.ku"
import { BindImportedTypeNames, TypeNameBinding } from "./type_names.ku"

struct ProjectModuleBindings {
    path: str
    imports: [ImportBinding]
    types: [TypeNameBinding]
}

struct ProjectBindings {
    modules: [ProjectModuleBindings]
    order: [int]
}

fn resolveProjectModule(&entry: SuppliedModule, &supplied: [SuppliedModule]): ProjectModuleBindings! {
    try {
        imports = BindProjectImports(entry, supplied)?
        types = BindImportedTypeNames(entry.named, imports, supplied)?
        CheckDirectCallContracts(entry.named, imports, supplied)?
        CheckFunctionContracts(entry.named)?
        return ok(ProjectModuleBindings { path: entry.path.clone(), imports: imports, types: types })
    } catch (err) {
        fail {
            domain: err.domain, code: err.code,
            message: EscapeCanonical(entry.path.clone()) + ": " + err.message
        }
    }
}

struct ProjectImportSchedule { order: [int] }

fn projectImportSpan(&span: Span): Span {
    return Span { line: span.line, column: span.column, offset: span.offset,
        end_line: span.end_line, end_column: span.end_column, end_offset: span.end_offset }
}

fn projectImportOrder(&modules: [ProjectModuleBindings]): ProjectImportSchedule! {
    module_count = modules.len()
    done: [int] = []
    init = 0
    while (init < module_count) {
        done = done.push(0)
        init = init + 1
    }
    order: [int] = []
    placed = 0
    while (placed < module_count) {
        next = 0 - 1
        blocked_module = 0
        blocked_edge = 0
        index = 0
        while (index < module_count && next < 0) {
            if (done[index] == 0) {
                ready = true
                edge_count = modules[index].imports.len()
                edge = 0
                while (edge < edge_count && ready) {
                    dependency = modules[index].imports[edge].module_index
                    if (dependency > 0 && done[dependency - 1] == 0) {
                        ready = false
                        blocked_module = index
                        blocked_edge = edge
                    }
                    edge = edge + 1
                }
                if (ready) { next = index }
            }
            index = index + 1
        }
        if (next < 0) {
            // At least one unplaced module was blocked. Materialize its
            // diagnostic at failure, rather than on every dependency check.
            blocked_at = projectImportSpan(modules[blocked_module].imports[blocked_edge].span)
            blocked_path = modules[blocked_module].path.clone()
            RejectName("cyclic_import", "no remaining project module has resolved dependencies, including '" + blocked_path + "'", blocked_at)?
        }
        done[next] = 1
        order = order.push(next)
        placed = placed + 1
    }
    return ok(ProjectImportSchedule { order: order })
}


fn BindProjectModules(&supplied: [SuppliedModule]): ProjectBindings! {
    modules: [ProjectModuleBindings] = []
    index = 0
    while (index < supplied.len()) {
        bound = resolveProjectModule(supplied[index], supplied)?
        modules = modules.push(bound)
        index = index + 1
    }
    {order} = projectImportOrder(modules)?
    return ok(ProjectBindings { modules: modules, order: order })
}

struct DirectSignature {
    name: str
    parameters: [ScalarAnnotation]
}

struct ScalarAnnotation {
    scalars: [str]
    owns_string: bool
}

fn scalarType(&name: str): bool {
    return name == "int" || name == "float" || name == "bool" || name == "str" || name == "null"
}

// Use only exact primitive annotations and their finite unions. Generic,
// unannotated and other types are left to contextual type checking.
fn scalarAnnotation(&nodes: [Node], &edges: [int], &annotation: Node): ScalarAnnotation {
    scalars: [str] = []
    if (annotation.kind == "TypeName" && scalarType(annotation.text)) {
        scalars = scalars.push(annotation.text.clone())
    } else if (annotation.kind == "TypeUnion") {
        start = annotation.first_edge
        stop = start + annotation.edge_count
        cursor = start
        while (cursor < stop) {
            item = edges[cursor] - 1
            if (nodes[item].kind != "TypeName" || !scalarType(nodes[item].text)) {
                return ScalarAnnotation { scalars: [], owns_string: false }
            }
            scalars = scalars.push(nodes[item].text.clone())
            cursor = cursor + 1
        }
    }
    return ScalarAnnotation { scalars: scalars, owns_string: false }
}

fn parameterAnnotation(&nodes: [Node], &edges: [int], &parameter: Node): ScalarAnnotation {
    if (parameter.edge_count != 1) { return ScalarAnnotation { scalars: [], owns_string: false } }
    type = nodes[edges[parameter.first_edge] - 1].clone()
    annotation = scalarAnnotation(nodes, edges, type)
    annotation.owns_string = parameter.int_value == 0 && type.kind == "TypeName" && type.text == "str"
    return annotation
}

fn directSignature(&nodes: [Node], &edges: [int], &function: Node, name: str): DirectSignature {
    parameters: [ScalarAnnotation] = []
    start = function.first_edge
    stop = start + function.edge_count
    cursor = start
    while (cursor < stop && nodes[edges[cursor] - 1].kind == "Parameter") {
        parameters = parameters.push(parameterAnnotation(nodes, edges, nodes[edges[cursor] - 1]))
        cursor = cursor + 1
    }
    return DirectSignature { name: name, parameters: parameters }
}

fn directSignatures(&named: NamedModule, &imports: [ImportBinding], &supplied: [SuppliedModule]): [DirectSignature]! {
    signatures: [DirectSignature] = []
    declaration_count = named.names.declarations.len()
    index = 0
    while (index < declaration_count) {
        if (IsNamedFunction(named.names.declarations[index].kind)) {
            id = named.names.declarations[index].node
            signature = directSignature(named.parsed.arena.nodes, named.parsed.arena.edges, named.parsed.arena.nodes[id - 1],
                                        named.names.declarations[index].name.clone())
            signatures = signatures.push(signature)
        }
        index = index + 1
    }
    index = 0
    while (index < imports.len()) {
        module_index = imports[index].module_index
        if (module_index > 0 && imports[index].target_node > 0) {
            source = ReadImportNode(supplied[module_index - 1].named.parsed.arena.nodes,
                                    imports[index].target_node, imports[index].span.clone())?
            if (IsNamedFunction(source.kind)) {
                signature = directSignature(supplied[module_index - 1].named.parsed.arena.nodes,
                                            supplied[module_index - 1].named.parsed.arena.edges, source,
                                            imports[index].local_name.clone())
                signatures = signatures.push(signature)
            }
        }
        index = index + 1
    }
    return ok(signatures)
}

fn directSignatureIndex(&signatures: [DirectSignature], &name: str): int {
    index = 0
    while (index < signatures.len()) {
        if (signatures[index].name == name) { return index + 1 }
        index = index + 1
    }
    return 0
}

fn containsName(&names: [str], &name: str): bool {
    index = 0
    while (index < names.len()) {
        if (names[index] == name) { return true }
        index = index + 1
    }
    return false
}

fn couldBindLocal(&kind: str): bool {
    return kind == "Parameter" || kind == "VarDecl" || kind == "Assign"
        || kind == "For" || kind == "CatchBinding" || IsNamedFunction(kind)
        || kind == "ObjectDestructureLocal" || kind == "ObjectDestructureRest"
}

fn scalarLiteral(&node: Node): str {
    if (node.edge_count != 0) { return "" }
    if (node.kind == "Int") { return "int" }
    if (node.kind == "Float") { return "float" }
    if (node.kind == "Bool") { return "bool" }
    if (node.kind == "String") { return "str" }
    if (node.kind == "Null") { return "null" }
    return ""
}

fn checkLiteralType(&annotation: ScalarAnnotation, &nodes: [Node], &edges: [int], &argument: Node, error_code: str): null! {
    scalar_count = annotation.scalars.len()
    if (scalar_count == 0) { return ok(null) }
    actual = scalarLiteral(argument)
    if (argument.kind == "Unary" && argument.edge_count == 1 && argument.text == "-") {
        operand = scalarLiteral(nodes[edges[argument.first_edge] - 1])
        if (operand == "int" || operand == "float") { actual = operand }
    }
    if (actual == "") { return ok(null) }
    accepted = containsName(annotation.scalars, actual)
    if (accepted) { return ok(null) }
    expected = annotation.scalars[0].clone()
    first_remaining = 1
    cursor = first_remaining
    while (cursor < scalar_count) {
        expected += " | " + annotation.scalars[cursor].clone()
        cursor = cursor + 1
    }
    RejectName(error_code, "expected " + expected + " but got " + actual, DeclarationSpan(argument))?
    return ok(null)
}

fn checkBoundCall(&nodes: [Node], &edges: [int], &signature: DirectSignature, &call: Node, transfers: [int]): [int]! {
    arity = signature.parameters.len()
    count = call.edge_count - 1
    if (count != arity) {
        RejectName("call_arity", "function '" + signature.name.clone() + "' expects "
                   + str(arity) + " arguments but got " + str(count), DeclarationSpan(call))?
    }
    moved = transfers
    argument = 0
    while (argument < count) {
        node = edges[call.first_edge + argument + 1]
        checkLiteralType(signature.parameters[argument], nodes, edges, nodes[node - 1], "call_argument_type")?
        if (signature.parameters[argument].owns_string &&
            (nodes[node - 1].kind == "Variable" || nodes[node - 1].kind == "Field")) {
            moved = moved.push(node)
        }
        argument = argument + 1
    }
    return ok(moved)
}

fn checkFunctionCalls(&nodes: [Node], &edges: [int], &signatures: [DirectSignature],
                      &imports: [ImportBinding], &supplied: [SuppliedModule], function: int): null! {
    start = FirstSubtreeNode(nodes, edges, function)
    // This pass proves direct targets. Defer potentially shadowed names,
    // including local functions/captures, to a later lexical binding pass.
    shadowed: [str] = []
    index = start
    while (index < function) {
        if (couldBindLocal(nodes[index - 1].kind)) {
            candidate = directSignatureIndex(signatures, nodes[index - 1].text)
            if (candidate > 0 || ProjectNamespaceModule(imports, nodes[index - 1].text) > 0) {
                present = containsName(shadowed, nodes[index - 1].text)
                if (!present) { shadowed = shadowed.push(nodes[index - 1].text.clone()) }
            }
        }
        index = index + 1
    }

    transfers: [int] = []
    index = start
    while (index < function) {
        if (nodes[index - 1].kind == "Call" && nodes[index - 1].edge_count > 0) {
            target = edges[nodes[index - 1].first_edge]
            if (nodes[target - 1].kind == "Variable") {
                present = containsName(shadowed, nodes[target - 1].text)
                if (!present) {
                    signature = directSignatureIndex(signatures, nodes[target - 1].text)
                    if (signature > 0) {
                        transfers = checkBoundCall(nodes, edges, signatures[signature - 1], nodes[index - 1], transfers)?
                    }
                }
            } else if (nodes[target - 1].kind == "Field" && nodes[target - 1].edge_count == 1) {
                receiver = edges[nodes[target - 1].first_edge]
                if (nodes[receiver - 1].kind == "Variable" && nodes[receiver - 1].edge_count == 0 &&
                    !containsName(shadowed, nodes[receiver - 1].text)) {
                    unit = ProjectNamespaceModule(imports, nodes[receiver - 1].text)
                    if (unit > 0) {
                        declaration = ResolveProjectNamespaceFunction(supplied[unit - 1], nodes[target - 1])?
                        provider = supplied[unit - 1].named.parsed.arena.nodes[declaration - 1].clone()
                        member = nodes[receiver - 1].text + "." + nodes[target - 1].text
                        bound = directSignature(supplied[unit - 1].named.parsed.arena.nodes,
                                                supplied[unit - 1].named.parsed.arena.edges, provider, member)
                        transfers = checkBoundCall(nodes, edges, bound, nodes[index - 1], transfers)?
                    }
                }
            }
        }
        index = index + 1
    }
    if (transfers.len() != 0) { CheckDirectOwnedMoves(nodes, edges, transfers, start, function)? }
    return ok(null)
}

fn checkReturnsInStatement(&nodes: [Node], &edges: [int], &result: ScalarAnnotation,
                           &statement: Node, checked: bool): null! {
    if (statement.kind == "Return" && statement.edge_count == 1) {
        value = edges[statement.first_edge]
        if (checked) {
            call = value - 1
            if (nodes[call].kind != "Call" || nodes[call].edge_count != 2) { return ok(null) }
            first = nodes[call].first_edge
            callee = edges[first] - 1
            if (nodes[callee].kind != "Variable" || nodes[callee].edge_count != 0 || nodes[callee].text != "ok") {
                return ok(null)
            }
            value = edges[first + 1]
        }
        return checkLiteralType(result, nodes, edges, nodes[value - 1], "return_type")
    }
    // These blocks share the current function's result type. Declaration,
    // expression and nested function nodes establish no returns in this scope.
    if (statement.kind == "If" || statement.kind == "While" || statement.kind == "For" ||
        statement.kind == "Try" || statement.kind == "TryBody" ||
        statement.kind == "Catch" || statement.kind == "CatchBody") {
        start = statement.first_edge
        stop = start + statement.edge_count
        cursor = start
        while (cursor < stop) {
            checkReturnsInStatement(nodes, edges, result, nodes[edges[cursor] - 1], checked)?
            cursor = cursor + 1
        }
    }
    return ok(null)
}

fn checkLiteralReturns(&nodes: [Node], &edges: [int], &function: Node, can_use_ok: bool): null! {
    start = function.first_edge
    stop = start + function.edge_count
    cursor = start
    while (cursor < stop && nodes[edges[cursor] - 1].kind == "Parameter") {
        cursor = cursor + 1
    }
    if (cursor == stop) { return ok(null) }
    // Return annotations follow the parameters. An omitted annotation
    // begins directly with a statement and yields the empty scalar set.
    type_node = edges[cursor] - 1
    checked = nodes[type_node].kind == "TypeResult"
    if (checked) {
        if (!can_use_ok || nodes[type_node].edge_count != 1) { return ok(null) }
        type_node = edges[nodes[type_node].first_edge] - 1
        if (nodes[type_node].kind != "TypeName") { return ok(null) }
    }
    annotation = scalarAnnotation(nodes, edges, nodes[type_node])
    if (annotation.scalars.len() == 0) { return ok(null) }
    first_statement = cursor + 1
    body_cursor = first_statement
    while (body_cursor < stop) {
        checkReturnsInStatement(nodes, edges, annotation, nodes[edges[body_cursor] - 1], checked)?
        body_cursor = body_cursor + 1
    }
    return ok(null)
}

// Use the arenas and import identities from the declaration/explicit type pass.
// Leave the project's AST IDs and successful output unchanged.
fn CheckDirectCallContracts(&named: NamedModule, &imports: [ImportBinding], &supplied: [SuppliedModule]): null! {
    signatures = directSignatures(named, imports, supplied)?
    if (signatures.len() == 0) { return ok(null) }
    declaration_count = named.names.declarations.len()
    index = 0
    while (index < declaration_count) {
        if (IsNamedFunction(named.names.declarations[index].kind)) {
            function = named.names.declarations[index].node
            checkFunctionCalls(named.parsed.arena.nodes, named.parsed.arena.edges,
                               signatures, imports, supplied, function)?
        }
        index = index + 1
    }
    return ok(null)
}

fn CheckFunctionContracts(&named: NamedModule): null! {
    node_count = named.parsed.arena.nodes.len()
    // A local may also shadow ok in a nested capturing function. Until
    // lexical binding is available here, only inspect the builtin when no
    // declaration in the module can replace it.
    can_use_ok = true
    probe = 0
    while (probe < node_count) {
        if (named.parsed.arena.nodes[probe].text == "ok") {
            if (couldBindLocal(named.parsed.arena.nodes[probe].kind)
                || named.parsed.arena.nodes[probe].kind == "ImportName"
                || named.parsed.arena.nodes[probe].kind == "ImportAlias"
                || named.parsed.arena.nodes[probe].kind == "ImportNamespace"
                || named.parsed.arena.nodes[probe].kind == "Struct"
                || named.parsed.arena.nodes[probe].kind == "Enum") {
                can_use_ok = false
            }
        }
        probe = probe + 1
    }
    index = 0
    while (index < node_count) {
        // The kind and function check only borrow the original AST node.
        is_named = IsNamedFunction(named.parsed.arena.nodes[index].kind)
        if (is_named || named.parsed.arena.nodes[index].kind == "FunctionExpr") {
            checkLiteralReturns(named.parsed.arena.nodes, named.parsed.arena.edges, named.parsed.arena.nodes[index], can_use_ok)?
            CheckParameterWrites(named.parsed.arena.nodes, named.parsed.arena.edges, named.parsed.arena.nodes[index])?
        }
        index = index + 1
    }
    return ok(null)
}
