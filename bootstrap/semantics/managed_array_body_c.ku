import { Node } from "../stage2/ast.ku"
import { DeclarationSpan, NamedModule } from "./names.ku"
import { ImportBinding, SuppliedModule } from "./imports.ku"
import { TypeNameBinding } from "./type_names.ku"
import { FieldIndex, RejectLayout, StructLayout } from "./struct_layouts.ku"
import { GuardRecordCarrierDrops } from "./guarded_struct_c.ku"
import { LinkPlanDeclaration } from "./link_plan_c.ku"
import { OrderCStructLayouts } from "./nested_struct_c.ku"
import { ContainsIndex, EmitLayout } from "./struct_projection_c.ku"
import { LowerOwnedRecordCall, OwnedRecordCall, RecordResultCallId } from "./struct_result_link_c.ku"
import { GuardBinding, GuardBindingIndex, GuardBindingName, GuardBoundType, GuardCType } from "./guarded_struct_expr.ku"
import { AddGuardCode, EmitManagedAssignment, EmitManagedStringAppend, JoinManagedCode, ManagedBlank, ManagedCode, ManagedExpression, ManagedType } from "./managed_array_values_c.ku"
import { HasScalarBuiltin } from "./scalar_int_operands.ku"
import { ScalarStaticErrorFields } from "./scalar_result_null.ku"
import { LowerManagedRecordError, ManagedDeferredMessageId } from "./guarded_string_parts.ku"

struct ManagedBlock {
    code: ManagedCode
    declarations: str
    drops: str
    returns: bool
    bindings: [GuardBinding]
    error_exits: str
    record_links: [ManagedRecordLink]
}

struct ManagedRecordLink {
    payload_layout: int
    payload_type: str
    prototype: str
    plan: LinkPlanDeclaration
}

struct ManagedRecordFields {
    code: ManagedCode
    link: ManagedRecordLink
    next: int
}

fn consumeManagedRecord(&named: NamedModule, &types: [TypeNameBinding], &layouts: [StructLayout],
                        &locals: [GuardBinding], caller_id: int, call_id: int,
                        start: int, end: int, &indent: str): ManagedRecordFields! {
    source = named.parsed.arena.nodes[named.parsed.arena.edges[start] - 1].clone()
    if (GuardBindingIndex(locals, source.text) != 0) {
        RejectLayout("managed_record_binding", "checked result needs a fresh lexical binding", DeclarationSpan(source))?
    }
    call = LowerOwnedRecordCall(named, types, layouts, locals, caller_id, call_id, true, indent)?
    name = call.name
    code = call.code
    inside = indent.clone() + "    "
    code.text += indent.clone() + "if (" + name.clone() + ".ok) {\n"
    used: [int] = []
    cursor = start + 1
    while (cursor < end) {
        statement = named.parsed.arena.nodes[named.parsed.arena.edges[cursor] - 1].clone()
        if (statement.kind != "Assign" || statement.edge_count != 1) { break }
        field = named.parsed.arena.nodes[named.parsed.arena.edges[statement.first_edge] - 1].clone()
        if (field.kind != "Field" || field.edge_count != 1) { break }
        base = named.parsed.arena.nodes[named.parsed.arena.edges[field.first_edge] - 1].clone()
        if (base.kind != "Variable" || base.text != source.text) { break }
        ordinal = FieldIndex(layouts[call.payload_layout - 1].fields, field.text)
        found = GuardBindingIndex(locals, statement.text)
        if (found == 0 || ordinal == 0 || ContainsIndex(used, ordinal)) {
            RejectLayout("managed_record_field", "assign a distinct declared result field to an existing local", DeclarationSpan(statement))?
        }
        ty = GuardBoundType(layouts[call.payload_layout - 1].fields[ordinal - 1].resolved, layouts)?
        target = locals[found - 1].clone()
        if (target.parameter || target.view || target.ty.kind != ty.kind || (ty.kind != "str" && ty.kind != "bool" && ty.kind != "int")) {
            RejectLayout("managed_record_field", "a result field needs a matching local str or Copy scalar", DeclarationSpan(statement))?
        }
        destination = GuardBindingName(target)
        value = name.clone() + ".value.f" + str(ordinal - 1)
        if (ty.kind == "str") { code.text += inside.clone() + "ku_projection_string_drop(&" + destination.clone() + ");\n" }
        code.text += inside.clone() + destination + " = " + value.clone() + ";\n"
        if (ty.kind == "str") { code.text += inside.clone() + value + " = (KuProjectionString){0};\n" }
        used = used.push(ordinal)
        cursor = cursor + 1
    }
    if (used.len() == 0) {
        RejectLayout("managed_record_binding", "consume the checked result in immediately following field assignments", DeclarationSpan(source))?
    }
    code.text += indent.clone() + "} else {\n" + inside.clone() + "result.error = " + name.clone() + ".error;\n"
    code.text += inside + name.clone() + ".error = (KuBootstrapError){0};\n" + indent.clone() + "}\n"
    code.text += GuardRecordCarrierDrops(layouts, call.payload_layout, name, indent)
    link = ManagedRecordLink { payload_layout: call.payload_layout, payload_type: call.payload_type,
        prototype: call.prototype, plan: call.plan }
    return ok(ManagedRecordFields { code: code, link: link, next: cursor })
}

fn ownedDrop(&root: ManagedType, &binding: GuardBinding, &indent: str): str {
    if (binding.ty.kind == "str") { return indent.clone() + "ku_projection_string_drop(&" + GuardBindingName(binding) + ");\n" }
    if (binding.ty.kind == "str_array") { return indent.clone() + "ku_managed_source_drop(&" + GuardBindingName(binding) + ");\n" }
    operation = "_element_drop(&"
    if (binding.ty.kind == "array") { operation = "_drop(&" }
    return indent.clone() + root.array.prefix.clone() + operation + GuardBindingName(binding) + ");\n"
}

fn managedReturn(&nodes: [Node], &edges: [int], &locals: [GuardBinding], &root: ManagedType,
                 &statement: Node, &indent: str, checked: bool, can_use_ok: bool): str! {
    if (statement.edge_count != 1) {
        RejectLayout("unsupported_managed_return", "expected a returned array owner", DeclarationSpan(statement))?
    }
    result = nodes[edges[statement.first_edge] - 1].clone()
    if (checked) {
        if (result.kind != "Call" || result.edge_count != 2 || !can_use_ok || GuardBindingIndex(locals, "ok") != 0) {
            RejectLayout("managed_result_ok", "expected return ok with an owned array", DeclarationSpan(result))?
        }
        callee = nodes[edges[result.first_edge] - 1].clone()
        if (callee.kind != "Variable" || callee.edge_count != 0 || callee.text != "ok") {
            RejectLayout("managed_result_ok", "expected the builtin ok constructor", DeclarationSpan(callee))?
        }
        result = nodes[edges[result.first_edge + 1] - 1].clone()
    }
    found = GuardBindingIndex(locals, result.text)
    if (result.kind != "Variable" || found == 0 || locals[found - 1].view ||
        locals[found - 1].ty.kind != "array" || locals[found - 1].ty.layout != root.layout) {
        RejectLayout("unsupported_managed_return", "return requires an initialized array owner of the declared type", DeclarationSpan(result))?
    }
    name = GuardBindingName(locals[found - 1])
    prefix = "result = "
    if (checked) { prefix = "result.value = " }
    text = indent.clone() + prefix + root.array.prefix.clone() + "_move(&" + name + ");\n"
    if (checked) { text += indent.clone() + "result.ok = true;\n" }
    return ok(text + indent.clone() + "goto cleanup;\n")
}

fn EmitManagedBlock(&named: NamedModule, &types: [TypeNameBinding], &imports: [ImportBinding],
                   &supplied: [SuppliedModule], &layouts: [StructLayout], &root: ManagedType,
                   bindings: [GuardBinding], start: int, end: int, depth: int, &indent: str): ManagedBlock! {
    return emitManagedBlock(named, types, imports, supplied, layouts, root, bindings, start, end, depth, indent, false, false)
}

fn EmitManagedResultBlock(&named: NamedModule, &types: [TypeNameBinding], &imports: [ImportBinding],
                         &supplied: [SuppliedModule], &layouts: [StructLayout], &root: ManagedType,
                         bindings: [GuardBinding], start: int, end: int): ManagedBlock! {
    return emitManagedBlock(named, types, imports, supplied, layouts, root, bindings, start, end, 0, "    ", true, HasScalarBuiltin(named, "ok"))
}

fn emitManagedBlock(&named: NamedModule, &types: [TypeNameBinding], &imports: [ImportBinding],
                    &supplied: [SuppliedModule], &layouts: [StructLayout], &root: ManagedType,
                    bindings: [GuardBinding], start: int, end: int, depth: int, &indent: str, checked: bool, can_use_ok: bool): ManagedBlock! {
    locals = bindings
    code = ManagedBlank()
    declarations = ""
    drops = ""
    scope_drops = ""
    error_exits = ""
    record_links: [ManagedRecordLink] = []
    returns = false
    cursor = start
    while (cursor < end) {
        statement_id = named.parsed.arena.edges[cursor]
        statement = named.parsed.arena.nodes[statement_id - 1].clone()
        if (returns) {
            RejectLayout("unreachable_managed_statement", "a prior managed statement always returns", DeclarationSpan(statement))?
        }
        call_id = 0
        if (checked && root.source_strings) { call_id = RecordResultCallId(named, statement_id) }
        if (call_id != 0) {
            read = consumeManagedRecord(named, types, layouts, locals, root.function_id, call_id, cursor, end, indent)?
            code = JoinManagedCode(code, read.code)
            record_links = record_links.push(read.link)
            cursor = read.next - 1
        } else if (statement.kind == "Return") {
            if (root.string_locals) {
                RejectLayout("unsupported_managed_return", "result loops require one return after the managed body", DeclarationSpan(statement))?
            }
            code.text = code.text + managedReturn(named.parsed.arena.nodes, named.parsed.arena.edges, locals, root, statement, indent, checked, can_use_ok)?
            returns = true
        } else if ((root.string_locals || checked) && statement.kind == "Fail" && statement.edge_count == 1) {
            failure = named.parsed.arena.nodes[named.parsed.arena.edges[statement.first_edge] - 1].clone()
            if (root.string_locals || ManagedDeferredMessageId(named.parsed.arena.nodes, named.parsed.arena.edges, failure) != 0) {
                lowered = LowerManagedRecordError(named.parsed.arena.nodes, named.parsed.arena.edges, locals, layouts,
                    root.leaves, failure, statement_id, indent)?
                code = AddGuardCode(code, lowered.prep)
                declarations += lowered.declarations
                error_exits += lowered.after_cleanup
            } else {
                fields = ScalarStaticErrorFields(named.parsed.arena.nodes, named.parsed.arena.edges, failure, "KuProjectionString")?
                code.text = code.text + indent.clone() + "result.error = (KuBootstrapError){" + fields + "};\n" + indent.clone() + "goto cleanup;\n"
            }
            returns = true
        } else if ((root.string_locals || root.source_strings) && statement.kind == "CompoundAssign" && statement.text == "+" && statement.edge_count == 2) {
            update = EmitManagedStringAppend(named, locals, layouts, root, statement, indent)?
            code = JoinManagedCode(code, update)
        } else if ((statement.kind == "Assign" && statement.edge_count == 1) ||
                   (statement.kind == "VarDecl" && statement.edge_count == 2)) {
            assignment = EmitManagedAssignment(named, types, imports, supplied, layouts, root, locals, statement_id, indent)?
            code = JoinManagedCode(code, assignment.code)
            if (assignment.introduces) {
                binding = assignment.binding
                if (binding.ty.kind == "struct" || binding.ty.kind == "array" || binding.ty.kind == "str" || binding.ty.kind == "str_array") {
                    // Predeclare only managed owners. Any goto cleanup can
                    // then safely drop zero, partial, complete or moved slots.
                    declarations += "    " + GuardCType(binding.ty, layouts) + " " + GuardBindingName(binding) + " = {0};\n"
                    drops = ownedDrop(root, binding, "    ") + drops
                    scope_drops = ownedDrop(root, binding, indent) + scope_drops
                }
                locals = locals.push(binding)
            }
        } else if ((statement.kind == "If" || statement.kind == "While") && statement.edge_count >= 1) {
            count = statement.edge_count - 1
            then_count = count
            if (statement.kind == "If") { then_count = statement.int_value }
            if (depth >= 32 || then_count < 0 || then_count > count) {
                RejectLayout("managed_block_limit", "managed C accepts at most 32 validated control levels", DeclarationSpan(statement))?
            }
            inside = indent.clone() + "    "
            guard_indent = indent.clone()
            if (statement.kind == "While") { guard_indent = inside.clone() }
            guard = ManagedExpression(named, locals, layouts, root, named.parsed.arena.edges[statement.first_edge], guard_indent)?
            if (guard.ty.kind != "bool") {
                RejectLayout("managed_condition_type", "managed if and while require bool", DeclarationSpan(statement))?
            }
            child_start = statement.first_edge + 1
            child = emitManagedBlock(named, types, imports, supplied, layouts, root, locals.clone(),
                child_start, child_start + then_count, depth + 1, inside, checked, can_use_ok)?
            if (statement.kind == "While") { code.text = code.text + indent.clone() + "while (true) {\n" }
            code = AddGuardCode(code, guard)
            if (statement.kind == "While") {
                code.text = code.text + inside.clone() + "if (!(bool)" + guard.value + ") break;\n"
            } else {
                code.text = code.text + indent.clone() + "if ((bool)" + guard.value + ") {\n"
            }
            code = JoinManagedCode(code, child.code)
            code.text = code.text + indent.clone() + "}"
            declarations += child.declarations
            drops = child.drops + drops
            error_exits += child.error_exits
            for link in child.record_links { record_links = record_links.push(link) }
            if (then_count < count) {
                otherwise = emitManagedBlock(named, types, imports, supplied, layouts, root, locals.clone(),
                    child_start + then_count, child_start + count, depth + 1, inside, checked, can_use_ok)?
                code.text = code.text + " else {\n"
                code = JoinManagedCode(code, otherwise.code)
                code.text = code.text + indent.clone() + "}"
                declarations += otherwise.declarations
                drops = otherwise.drops + drops
                error_exits += otherwise.error_exits
                for link in otherwise.record_links { record_links = record_links.push(link) }
                returns = child.returns && otherwise.returns
            }
            code.text = code.text + "\n"
        } else {
            RejectLayout("unsupported_managed_statement", "expected an owner local, Copy local, if, while or return", DeclarationSpan(statement))?
        }
        cursor = cursor + 1
    }
    if (!returns && (!root.string_locals || depth != 0)) { code.text = code.text + scope_drops }
    return ok(ManagedBlock { code: code, declarations: declarations, drops: drops, returns: returns,
        bindings: locals, error_exits: error_exits, record_links: record_links })
}

struct OwnedRecordPattern {
    code: str
    declarations: str
    drops: str
    bindings: [GuardBinding]
}

fn LowerOwnedRecordPattern(&named: NamedModule, &layouts: [StructLayout], &call: OwnedRecordCall,
                           &statement: Node, &pattern: Node, bindings: [GuardBinding]): OwnedRecordPattern! {
    if (pattern.kind != "ObjectDestructureAssign" || pattern.edge_count != pattern.int_value + 1 || pattern.int_value < 0) {
        RejectLayout("record_call_pattern", "consume the checked record with a named field pattern without rest", DeclarationSpan(pattern))?
    }
    source = named.parsed.arena.nodes[named.parsed.arena.edges[pattern.first_edge + pattern.int_value] - 1].clone()
    if (source.kind != "Variable" || source.edge_count != 0 || source.text != statement.text || GuardBindingIndex(bindings, source.text) != 0) {
        RejectLayout("record_call_pattern", "consume the fresh checked record binding", DeclarationSpan(source))?
    }
    locals = bindings
    code = ""
    declarations = ""
    drops = ""
    seen: [int] = []
    index = 0
    while (index < pattern.int_value) {
        field = named.parsed.arena.nodes[named.parsed.arena.edges[pattern.first_edge + index] - 1].clone()
        ordinal = FieldIndex(layouts[call.payload_layout - 1].fields, field.text)
        if (field.kind != "ObjectDestructureBinding" || field.edge_count != 1 || ordinal == 0 || ContainsIndex(seen, ordinal)) {
            RejectLayout("record_call_field", "expected one declared result field and no default expression", DeclarationSpan(field))?
        }
        local_id = named.parsed.arena.edges[field.first_edge]
        local = named.parsed.arena.nodes[local_id - 1].clone()
        if (local.kind != "ObjectDestructureLocal" || local.edge_count != 0 || local.int_value < 0 || local.int_value > 1) {
            RejectLayout("record_call_field", "expected a local or ignored result field", DeclarationSpan(local))?
        }
        if (local.int_value == 1) {
            if (GuardBindingIndex(locals, local.text) != 0) {
                RejectLayout("record_call_field", "bind the result field to a fresh local", DeclarationSpan(local))?
            }
            ty = GuardBoundType(layouts[call.payload_layout - 1].fields[ordinal - 1].resolved, layouts)?
            if (ty.kind != "int" && ty.kind != "bool" && ty.kind != "str") {
                RejectLayout("record_call_field", "selected fields require Copy scalars or owned str", DeclarationSpan(field))?
            }
            binding = GuardBinding { name: local.text, ty: ty, slot: local_id, parameter: false, view: false }
            name = GuardBindingName(binding)
            before = GuardCType(binding.ty, layouts)
            source_field = call.name.clone() + ".value.f" + str(ordinal - 1)
            declarations += "    " + before + " " + name.clone() + " = {0};\n"
            code += "        " + name.clone() + " = " + source_field.clone() + ";\n"
            if (binding.ty.kind == "str") {
                code += "        " + source_field + " = (KuProjectionString){0};\n"
                drops = "    ku_projection_string_drop(&" + name.clone() + ");\n" + drops
            }
            code += "        (void)" + name + ";\n"
            locals = locals.push(binding)
        }
        seen = seen.push(ordinal)
        index = index + 1
    }
    return ok(OwnedRecordPattern { code: code, declarations: declarations, drops: drops, bindings: locals })
}

struct RecordResultPrelude {
    code: ManagedCode
    prototype: str
    declarations: str
    drops: str
    bindings: [GuardBinding]
    plan: [LinkPlanDeclaration]
    next_edge: int
}

fn EmitRecordResultPrelude(&named: NamedModule, &types: [TypeNameBinding], &layouts: [StructLayout],
                     &bindings: [GuardBinding], &declared: [int], start: int, end: int, caller_id: int, call_id: int, layout: int): RecordResultPrelude! {
    if (call_id == 0) {
        return ok(RecordResultPrelude { code: ManagedBlank(), prototype: "", declarations: "", drops: "",
            bindings: bindings.clone(), plan: [], next_edge: start })
    }
    statement = named.parsed.arena.nodes[named.parsed.arena.edges[start] - 1].clone()
    if (start + 1 >= end) {
        RejectLayout("record_call_pattern", "consume the checked result in a following field pattern", DeclarationSpan(statement))?
    }
    call = LowerOwnedRecordCall(named, types, layouts, bindings, caller_id, call_id, false, "    ")?
    binding = LowerOwnedRecordPattern(named, layouts, call, statement,
        named.parsed.arena.nodes[named.parsed.arena.edges[start + 1] - 1], bindings.clone())?
    order = OrderCStructLayouts(layouts, layouts[call.payload_layout - 1].module_index, layouts[call.payload_layout - 1].node, DeclarationSpan(statement))?
    header = ""
    for entry in order.entries {
        if (!ContainsIndex(declared, entry.layout_index)) {
            header += EmitLayout(layouts[entry.layout_index - 1], true, true)?
        }
    }
    if (call.payload_layout != layout) {
        header += "typedef struct { bool ok; " + call.payload_type.clone() + " value; KuBootstrapError error; } " + call.result_type.clone() + ";\n"
    }
    code = call.code
    name = call.name
    code.text = code.text + "    if (" + name.clone() + ".ok) {\n" + binding.code + "    } else {\n"
    code.text = code.text + "        result.error = " + name.clone() + ".error;\n"
    code.text = code.text + "        " + name.clone() + ".error = (KuBootstrapError){0};\n    }\n"
    code.text = code.text + GuardRecordCarrierDrops(layouts, call.payload_layout, name, "    ")
    return ok(RecordResultPrelude { code: code, prototype: header + call.prototype, declarations: binding.declarations,
        drops: binding.drops, bindings: binding.bindings, plan: [call.plan], next_edge: start + 2 })
}
