import { Span } from "../stage2/span.ku"
import { SuppliedModule } from "./imports.ku"
import { BuiltinLinkPlanType, LinkPlanDeclaration, LinkPlanType } from "./link_plan_c.ku"
import { EmitLinkPlan } from "./link_plan_json_c.ku"
import { BindProjectModules, ProjectModuleBindings } from "./project_bindings.ku"
import { EmitScalarIntModule, LowerScalarIntFunction, ScalarIntC, AppendScalarIntCallees } from "./scalar_int_c.ku"
import { ScalarFunctionNode, ScalarIntCalleeSignature, ScalarIntImport } from "./scalar_int_calls.ku"
import { ScalarIntFunction, ScalarParameterCType, ScalarResultCType } from "./scalar_int_emit.ku"
import { HasScalarBuiltin, RejectScalarInt } from "./scalar_int_operands.ku"
import { ComposeScalarProgramC, LowerScalarProgramEntry } from "./scalar_program_c.ku"

struct ScalarProjectModule {
    imports: [ScalarIntImport]
    has_str: bool
    has_ok: bool
}

fn linkedImports(&current: ProjectModuleBindings, &supplied: [SuppliedModule],
                 &bindings: [ProjectModuleBindings]): [ScalarIntImport] {
    calls: [ScalarIntImport] = []
    index = 0
    while (index < current.imports.len()) {
        link = current.imports[index].clone()
        if (link.module_index > 0) {
            module_slot = link.module_index - 1
            if (supplied[module_slot].named.parsed.arena.nodes[link.target_node - 1].kind == "Function") {
                signature = ScalarIntCalleeSignature(supplied[module_slot].named.parsed.arena.nodes,
                    supplied[module_slot].named.parsed.arena.edges, bindings[module_slot].types, link.target_node)
                calls = calls.push(ScalarIntImport { local_name: link.local_name,
                    target: module_slot * 4096 + link.target_node, signature: signature })
            }
        }
        index = index + 1
    }
    return calls
}

fn scalarModules(&supplied: [SuppliedModule], &bindings: [ProjectModuleBindings]): [ScalarProjectModule] {
    modules: [ScalarProjectModule] = []
    index = 0
    while (index < supplied.len()) {
        calls = linkedImports(bindings[index], supplied, bindings)
        modules = modules.push(ScalarProjectModule { imports: calls,
            has_str: HasScalarBuiltin(supplied[index].named, "str"),
            has_ok: HasScalarBuiltin(supplied[index].named, "ok") })
        index = index + 1
    }
    return modules
}

fn scalarProjectLinkPlan(&plan: ScalarIntFunction, symbol: str): LinkPlanDeclaration {
    parameters: [LinkPlanType] = []
    index = 0
    while (index < plan.parameters.len()) {
        mode = plan.parameters[index].string_mode
        name = "int"
        if (mode != 0) { name = "str" }
        parameters = parameters.push(BuiltinLinkPlanType(name, ScalarParameterCType(mode), mode == 2))
        index = index + 1
    }
    name = "int"
    if (plan.result_type == 2) { name = "str" }
    else if (plan.result_type == 3) { name = "bool" }
    else if (plan.result_type == 4) { name = "null" }
    result = BuiltinLinkPlanType(name, ScalarResultCType(plan.result_type), false)
    return LinkPlanDeclaration { unit: 1, node: plan.function_node, symbol: symbol, parameters: parameters,
        result: result, returns_result: plan.result_type == 4 }
}

fn lowerProjectFunction(&unit: SuppliedModule, &binding: ProjectModuleBindings, &info: ScalarProjectModule,
                        base: int, function: int, program_entry: bool): ScalarIntFunction! {
    if (program_entry) {
        return LowerScalarProgramEntry(unit.named.parsed.arena.nodes, unit.named.parsed.arena.edges,
            unit.named.names.declarations, binding.types, info.imports, function,
            HasScalarBuiltin(unit.named, "println"), info.has_ok)
    }
    return LowerScalarIntFunction(unit.named.parsed.arena.nodes, unit.named.parsed.arena.edges,
        unit.named.names.declarations, binding.types, info.imports, base, function, info.has_str, info.has_ok,
        HasScalarBuiltin(unit.named, "println"))
}

fn scalarProjectPlans(&supplied: [SuppliedModule], &function: str, program: bool): [ScalarIntFunction]! {
    if (supplied.len() == 0) {
        start = Span { line: 1, column: 1, offset: 0, end_line: 1, end_column: 1, end_offset: 0 }
        RejectScalarInt("unknown_int_function", "a selected project module is required", start)?
    }
    entry = ScalarFunctionNode(supplied[0].named.names.declarations, function)
    if (entry == 0) {
        start = Span { line: 1, column: 1, offset: 0, end_line: 1, end_column: 1, end_offset: 0 }
        RejectScalarInt("unknown_int_function", "undefined function '" + function.clone() + "'", start)?
    }
    project = BindProjectModules(supplied)?
    binding = project.modules
    modules = scalarModules(supplied, binding)
    reachable = [entry]
    plans: [ScalarIntFunction] = []
    // BindProjectModules limits the supplied module count and each parsed arena
    // has at most 4096 nodes. Each (module, node) key is queued at most once.
    work_limit = supplied.len() * 4096
    index = 0
    while (index < work_limit) {
        if (index >= reachable.len()) { return ok(plans) }
        key = reachable[index]
        // Keys combine the module ordinal and one-based node ID, without collisions.
        module_slot = (key - 1) / 4096
        base = module_slot * 4096
        plan = lowerProjectFunction(supplied[module_slot], binding[module_slot], modules[module_slot],
            base, key - base, program && index == 0)?
        reachable = AppendScalarIntCallees(plan, reachable)
        plans = plans.push(plan)
        index = index + 1
    }
    if (index < reachable.len()) {
        start = Span { line: 1, column: 1, offset: 0, end_line: 1, end_column: 1, end_offset: 0 }
        RejectScalarInt("project_work_limit", "scalar call graph exceeds the validated project node count", start)?
    }
    return ok(plans)
}

fn EmitScalarProjectC(&supplied: [SuppliedModule], &function: str): ScalarIntC! {
    plans = scalarProjectPlans(supplied, function, false)?
    return EmitScalarIntModule(plans, supplied[0].named.parsed.arena.nodes, supplied, plans[0].function_node)
}

fn EmitScalarProjectProgramC(&supplied: [SuppliedModule]): str! {
    plans = scalarProjectPlans(supplied, "main", true)?
    generated = EmitScalarIntModule(plans, supplied[0].named.parsed.arena.nodes, supplied, plans[0].function_node)?
    return ok(ComposeScalarProgramC(generated.source, generated.symbol))
}

fn EmitScalarProjectLinkPlan(&supplied: [SuppliedModule], &function: str): str! {
    plans = scalarProjectPlans(supplied, function, false)?
    generated = EmitScalarIntModule(plans, supplied[0].named.parsed.arena.nodes, supplied, plans[0].function_node)?
    // Callees are validated and emitted as internal definitions in this C unit.
    export = scalarProjectLinkPlan(plans[0], generated.symbol)
    return EmitLinkPlan(supplied, "project-int", export, [])
}
