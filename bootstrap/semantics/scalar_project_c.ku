import { ScalarFunctionNode, ScalarIntCalleeSignature, ScalarIntImport } from "./scalar_int_calls.ku"
import { ScalarIntFunction, ScalarParameterCType, ScalarResultCType } from "./scalar_int_emit.ku"
import { HasScalarBuiltin, RejectScalarInt } from "./scalar_int_operands.ku"
import { ComposeScalarProgramC, LowerScalarProgramEntry } from "./scalar_program_c.ku"

struct ScalarProjectModule {
    imports: [ScalarIntImport]
    has_str: bool
    has_ok: bool
}

fn linkedImports(&current: ProjectModuleBindings, &supplied: [SuppliedModule],
                 &bindings: [ProjectModuleBindings]): [ScalarIntImport] {
    calls: [ScalarIntImport] = []
    index = 0
    while (index < current.imports.len()) {
        link = current.imports[index].clone()
        if (link.module_index > 0 && link.target_node > 0) {
            module_slot = link.module_index - 1
            if (supplied[module_slot].named.parsed.arena.nodes[link.target_node - 1].kind == "Function") {
                signature = ScalarIntCalleeSignature(supplied[module_slot].named.parsed.arena.nodes,
                    supplied[module_slot].named.parsed.arena.edges, bindings[module_slot].types, link.target_node)
                calls = calls.push(ScalarIntImport { local_name: link.local_name,
                    target: module_slot * 4096 + link.target_node, signature: signature })
            }
        }
        index = index + 1
    }
    return calls
}

fn scalarModules(&supplied: [SuppliedModule], &bindings: [ProjectModuleBindings]): [ScalarProjectModule] {
    modules: [ScalarProjectModule] = []
    index = 0
    while (index < supplied.len()) {
        calls = linkedImports(bindings[index], supplied, bindings)
        modules = modules.push(ScalarProjectModule { imports: calls,
            has_str: HasScalarBuiltin(supplied[index].named, "str"),
            has_ok: HasScalarBuiltin(supplied[index].named, "ok") })
        index = index + 1
    }
    return modules
}

fn scalarProjectLinkPlan(&plan: ScalarIntFunction, symbol: str): LinkPlanDeclaration {
    parameters: [LinkPlanType] = []
    index = 0
    while (index < plan.parameters.len()) {
        mode = plan.parameters[index].string_mode
        name = "int"
        if (mode != 0) { name = "str" }
        parameters = parameters.push(BuiltinLinkPlanType(name, ScalarParameterCType(mode), mode == 2))
        index = index + 1
    }
    name = "int"
    if (plan.result_type == 2) { name = "str" }
    else if (plan.result_type == 3) { name = "bool" }
    else if (plan.result_type == 4) { name = "null" }
    result = BuiltinLinkPlanType(name, ScalarResultCType(plan.result_type), false)
    return LinkPlanDeclaration { unit: 1, node: plan.function_node, symbol: symbol, parameters: parameters,
        result: result, returns_result: plan.result_type == 4 }
}

fn lowerProjectFunction(&unit: SuppliedModule, &binding: ProjectModuleBindings, &info: ScalarProjectModule,
                        base: int, function: int, program_entry: bool): ScalarIntFunction! {
    if (program_entry) {
        return LowerScalarProgramEntry(unit.named.parsed.arena.nodes, unit.named.parsed.arena.edges,
            unit.named.names.declarations, binding.types, info.imports, function,
            HasScalarBuiltin(unit.named, "println"), info.has_ok)
    }
    return LowerScalarIntFunction(unit.named.parsed.arena.nodes, unit.named.parsed.arena.edges,
        unit.named.names.declarations, binding.types, info.imports, base, function, info.has_str, info.has_ok,
        HasScalarBuiltin(unit.named, "println"))
}

fn scalarProjectPlans(&supplied: [SuppliedModule], &function: str, program: bool): [ScalarIntFunction]! {
    if (supplied.len() == 0) {
        start = Span { line: 1, column: 1, offset: 0, end_line: 1, end_column: 1, end_offset: 0 }
        RejectScalarInt("unknown_int_function", "a selected project module is required", start)?
    }
    entry = ScalarFunctionNode(supplied[0].named.names.declarations, function)
    if (entry == 0) {
        start = Span { line: 1, column: 1, offset: 0, end_line: 1, end_column: 1, end_offset: 0 }
        RejectScalarInt("unknown_int_function", "undefined function '" + function.clone() + "'", start)?
    }
    project = BindProjectModules(supplied)?
    binding = project.modules
    modules = scalarModules(supplied, binding)
    reachable = [entry]
    plans: [ScalarIntFunction] = []
    // BindProjectModules limits the supplied module count and each parsed arena
    // has at most 4096 nodes. Each (module, node) key is queued at most once.
    work_limit = supplied.len() * 4096
    index = 0
    while (index < work_limit) {
        if (index >= reachable.len()) { return ok(plans) }
        key = reachable[index]
        // Keys combine the module ordinal and one-based node ID, without collisions.
        module_slot = (key - 1) / 4096
        base = module_slot * 4096
        plan = lowerProjectFunction(supplied[module_slot], binding[module_slot], modules[module_slot],
            base, key - base, program && index == 0)?
        reachable = AppendScalarIntCallees(plan, reachable)
        plans = plans.push(plan)
        index = index + 1
    }
    if (index < reachable.len()) {
        start = Span { line: 1, column: 1, offset: 0, end_line: 1, end_column: 1, end_offset: 0 }
        RejectScalarInt("project_work_limit", "scalar call graph exceeds the validated project node count", start)?
    }
    return ok(plans)
}

fn EmitScalarProjectC(&supplied: [SuppliedModule], &function: str): ScalarIntC! {
    plans = scalarProjectPlans(supplied, function, false)?
    return EmitScalarIntModule(plans, supplied[0].named.parsed.arena.nodes, supplied, plans[0].function_node)
}

fn EmitScalarProjectProgramC(&supplied: [SuppliedModule]): str! {
    plans = scalarProjectPlans(supplied, "main", true)?
    generated = EmitScalarIntModule(plans, supplied[0].named.parsed.arena.nodes, supplied, plans[0].function_node)?
    return ok(ComposeScalarProgramC(generated.source, generated.symbol))
}

fn EmitScalarProjectLinkPlan(&supplied: [SuppliedModule], &function: str): str! {
    plans = scalarProjectPlans(supplied, function, false)?
    generated = EmitScalarIntModule(plans, supplied[0].named.parsed.arena.nodes, supplied, plans[0].function_node)?
    // Callees are validated and emitted as internal definitions in this C unit.
    export = scalarProjectLinkPlan(plans[0], generated.symbol)
    return EmitLinkPlan(supplied, "project-int", export, [])
}

fn LinkedNullLayout(&project: LinkedNullProject, &ty: TypeNameBinding, layouts: [StructLayout], depth: int): [StructLayout]! {
    if (ty.declaration_kind != "Struct") {
        LinkedNullCType(ty)?
        return ok(layouts)
    }
    unit = ty.module_index
    if (LayoutIndex(layouts, unit, ty.declaration_node) != 0) { return ok(layouts) }
    if (depth >= 8) {
        RejectLayout("linked_layout_depth", "linked structs require an acyclic layout of at most 8 levels", ty.span.clone())?
    }
    declaration = LinkedNullNode(project, unit, ty.declaration_node)
    module_index = unit - 1
    relocated: [StructFieldLayout] = []
    ordered = layouts
    for field in CollectFields(project.supplied[module_index].named.parsed.arena.nodes,
                               project.supplied[module_index].named.parsed.arena.edges,
                               project.binding.modules[module_index].types, declaration, false)? {
        resolved = LinkedAbsoluteType(field.resolved, unit)
        ordered = LinkedNullLayout(project, resolved, ordered, depth + 1)?
        local = StructFieldLayout { name: field.name, ordinal: field.ordinal, node: field.node, resolved: resolved }
        relocated = relocated.push(local)
    }
    ordered = ordered.push(StructLayout { name: ty.name.clone(), module_index: unit, node: ty.declaration_node, fields: relocated })
    OrderCStructLayouts(ordered, unit, ty.declaration_node, ty.span.clone())?
    return ok(ordered)
}

fn RegisterLinkedOwnedRecord(&project: LinkedNullProject, state: LinkedNullState, &element: TypeNameBinding): LinkedNullState! {
    next = state
    try {
        next.layouts = LinkedNullLayout(project, element, next.layouts.clone(), 0)?
        return ok(next)
    } catch (err) {
        // A cached owning child can reach the scalar layout order check
        // before a new parent exposes the same array field to collection.
        if (err.code != "unsupported_layout_type" && err.code != "unsupported_nested_layout") { fail err }
    }
    unit = element.module_index
    node = element.declaration_node
    layout = BuildProjectOwningLayouts(project.supplied, project.binding, unit, node, element.span.clone())?
    order = OrderProjectOwningLayouts(layout, unit, node, element.span.clone())?
    next.owning_strings = next.owning_strings || order.contains_string
    count = order.entries.len()
    index = 0
    while (index < count) {
        item = layout[order.entries[index].layout_index - 1].clone()
        if (LayoutIndex(next.owning_layouts, item.module_index, item.node) == 0) {
            next.owning_layouts = next.owning_layouts.push(item.clone())
        }
        if (LayoutIndex(next.layouts, item.module_index, item.node) == 0) {
            next.layouts = next.layouts.push(item)
        }
        index = index + 1
    }
    return ok(next)
}


fn LinkedSlotPrefix(&slots: [LinkedNullSlot], length: int): [LinkedNullSlot] {
    result: [LinkedNullSlot] = []
    index = 0
    while (index < length) {
        result = result.push(slots[index].clone())
        index = index + 1
    }
    return result
}

struct LinkedEnumSelection {
    ty: TypeNameBinding
    index: int
}

fn FindLinkedEnumSelection(&project: LinkedNullProject, &state: LinkedNullState, &field: Node): LinkedEnumSelection! {
    receiver = LinkedNullNode(project, 1, LinkedNullChild(project, 1, field, 0))
    qualifier = receiver.clone()
    if (receiver.kind == "Field" && receiver.edge_count == 1) {
        qualifier = LinkedNullNode(project, 1, LinkedNullChild(project, 1, receiver, 0))
    }
    empty = LinkedBuiltin("", DeclarationSpan(field))
    if (qualifier.kind != "Variable" || LinkedNullBinding(state.slots, qualifier.text) != 0 ||
        LinkedLocalAppendIndex(state, qualifier.text) != 0 || FindLinkedLocalRead(state.local_readers, qualifier.text) != 0) {
        return ok(LinkedEnumSelection { ty: empty, index: 0 })
    }
    if (receiver.kind == "Field") {
        receiver.text = qualifier.text.clone() + "." + receiver.text
        receiver.kind = "TypeName"
    }
    ty = FindUnitEnumType(project.supplied[0].named, project.binding.modules[0].imports, project.supplied, receiver)?
    if (ty.declaration_kind != "UnitEnum") { return ok(LinkedEnumSelection { ty: empty, index: 0 }) }
    ordinal = ReadUnitEnumVariant(project.supplied, ty, field.text, DeclarationSpan(field))?
    return ok(LinkedEnumSelection { ty: ty, index: ordinal + 1 })
}

fn RequireLinkedReadonlyCall(&callee: LinkedNullFunction, &at: Span): null! {
    scalar = callee.result.declaration_kind == "Builtin" && (callee.result.name == "int" || callee.result.name == "bool")
    if (callee.returns_result || (!scalar && callee.result.declaration_kind != "UnitEnum")) {
        RejectLayout("linked_readonly_call", "readonly direct call requires a plain int, bool, or payload-free enum result", at.clone())?
    }
    for parameter in callee.parameters.clone() {
        scalar = parameter.declaration_kind == "Builtin" && (parameter.name == "int" || parameter.name == "bool")
        if (!scalar && !LinkedNullView(parameter)) {
            RejectLayout("linked_readonly_call", "readonly direct call requires View or scalar Copy arguments", at.clone())?
        }
    }
    return ok(null)
}

fn HoldLinkedEnumTag(value: LinkedNullExpression, id: int): LinkedNullExpression {
    next = value
    tag = "enum_left_tag_" + str(id)
    next.state.code += "    const int32_t " + tag.clone() + " = (" + next.value.text.clone() + ").tag;\n"
    next.value.text = tag
    return next
}

fn FinishLinkedEnumComparison(value: LinkedNullExpression, &left: LinkedNullValue,
                              &node: Node, id: int, before: int): LinkedNullExpression! {
    right = value
    at = DeclarationSpan(node)
    if (!SameBoundTypeIdentity(left.ty, right.value.ty)) {
        RejectLayout("linked_enum_comparison", "expected two values of the same payload-free enum", at.clone())?
    }
    result = "enum_comparison_" + str(id)
    right.state.code += "    const bool " + result.clone() + " = " + left.text.clone() + " "
        + node.text.clone() + " (" + right.value.text.clone() + ").tag;\n"
    done = DropLinkedNullScope(right.state, before)
    return ok(LinkedReadonlyExpression(done, LinkedBuiltin("bool", at), result))
}
