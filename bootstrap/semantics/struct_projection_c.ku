import { Node } from "../stage2/ast.ku"
import { Span } from "../stage2/span.ku"
import { ImportBinding, SuppliedModule } from "./imports.ku"
import { TypeNameBinding } from "./type_names.ku"
import { DeclarationSpan, NamedModule } from "./names.ku"
import { ExplicitType, LayoutIndex, RejectLayout, StructLayout, StructReturnPlan } from "./struct_layouts.ku"

fn InvalidPlan(message: str): null! {
    point = Span { line: 1, column: 1, offset: 0, end_line: 1, end_column: 1, end_offset: 0 }
    RejectLayout("invalid_projection_plan", message, point)?
    return ok(null)
}

fn ScalarCType(&ty: TypeNameBinding): str! {
    if (ty.declaration_kind == "Builtin") {
        if (ty.name == "int") { return ok("int64_t") }
        if (ty.name == "float") { return ok("double") }
        if (ty.name == "bool") { return ok("bool") }
        if (ty.name == "null") { return ok("uint8_t") }
    }
    InvalidPlan("C projection fields must be Copy scalars")?
    return ok("")
}

fn CTypeName(module_index: int, node: int): str {
    if (module_index == 0) { return "KuStruct_" + str(node) }
    return "KuStruct_m" + str(module_index) + "_" + str(node)
}

fn ContainsType(&names: [str], &name: str): bool {
    index = 0
    while (index < names.len()) {
        if (names[index] == name) { return true }
        index = index + 1
    }
    return false
}

fn ContainsAllTypes(&members: [str], &possible: [str]): bool {
    if (members.len() > possible.len()) { return false }
    index = 0
    while (index < members.len()) {
        if (!ContainsType(possible, members[index])) { return false }
        index = index + 1
    }
    return true
}

fn OnlyWholeMemberMoves(&members: [str]): bool {
    return members.len() == 0 || (members.len() == 1 && members[0] == "")
}

fn StringField(&field: TypeNameBinding): bool {
    return field.declaration_kind == "Builtin" && field.name == "str"
}

fn ContainsIndex(&ids: [int], id: int): bool {
    index = 0
    while (index < ids.len()) {
        if (ids[index] == id) { return true }
        index = index + 1
    }
    return false
}

fn RequireProjectionBuiltin(&imports: [ImportBinding], &supplied: [SuppliedModule], &receiver: Node,
                            &namespace: str, &provider: str, at: Span): null! {
    found = false
    if (receiver.kind == "Variable" && receiver.edge_count == 0) {
        index = 0
        while (index < imports.len()) {
            if (imports[index].local_name == receiver.text && imports[index].source_name == namespace
                && imports[index].module_index == 0) {
                found = true
                break
            }
            index = index + 1
        }
    }
    if (!found) {
        expected = "expected the bound standard string namespace"
        if (namespace == "fs") { expected = "expected the bound standard filesystem namespace" }
        RejectLayout("undefined_linked_dependency", expected, at.clone())?
    }
    index = 0
    while (index < supplied.len()) {
        if (supplied[index].path == provider) {
            RejectLayout("linked_builtin_collision", "a source module occupies the builtin " + namespace.clone() + " provider path", at.clone())?
        }
        index = index + 1
    }
    return ok(null)
}

fn ProjectionPlaceRoot(&nodes: [Node], &edges: [int], id: int): str {
    cursor = id
    depth = 0
    while (depth < 32) {
        kind = nodes[cursor - 1].kind.clone()
        if (kind == "Variable") { return nodes[cursor - 1].text.clone() }
        if (kind != "Field" && kind != "OptionalField" && kind != "Index" && kind != "TryUnwrap") { return "" }
        cursor = edges[nodes[cursor - 1].first_edge]
        depth = depth + 1
    }
    return ""
}

fn ProjectionCloneSource(&nodes: [Node], &edges: [int], id: int): int {
    call = nodes[id - 1].clone()
    if (call.kind != "Call" || call.edge_count != 1) { return 0 }
    member = nodes[edges[call.first_edge] - 1].clone()
    if (member.kind != "Field" || member.text != "clone" || member.edge_count != 1) { return 0 }
    return edges[member.first_edge]
}

fn ProjectionIsStringArray(&types: [TypeNameBinding], &nodes: [Node], &edges: [int], id: int): bool! {
    array = nodes[id - 1].clone()
    if (array.kind != "TypeArray" || array.edge_count != 1) { return ok(false) }
    element = edges[array.first_edge]
    item = nodes[element - 1].clone()
    if (item.kind != "TypeName" || item.text != "str") { return ok(false) }
    bound = ExplicitType(types, element, DeclarationSpan(item))?
    return ok(bound.declaration_kind == "Builtin" && bound.name == "str")
}

struct ProjectionLengthCode {
    setup: str
    value: str
}

fn ProjectionStringLength(&value: str, view: bool, characters: bool, id: int, &indent: str): ProjectionLengthCode {
    access = "."
    if (view) { access = "->" }
    size = value.clone() + access.clone() + "len"
    if (!characters) { return ProjectionLengthCode { setup: "", value: "((int64_t)" + size + ")" } }
    count = "char_count" + str(id)
    index = "char_index" + str(id)
    text = indent.clone() + "size_t " + count.clone() + " = 0;\n"
    text += indent.clone() + "for (size_t " + index.clone() + " = 0; " + index.clone() + " < " + size + "; ++" + index.clone() + ") {\n"
    text += indent.clone() + "    if ((" + value.clone() + access + "ptr[" + index + "] & 0xC0u) != 0x80u) ++" + count.clone() + ";\n"
    text += indent.clone() + "}\n"
    return ProjectionLengthCode { setup: text, value: "((int64_t)" + count + ")" }
}

fn StructArrayTypeName(&field: TypeNameBinding): str {
    return "KuArray_" + CTypeName(field.module_index, field.declaration_node)
}

fn ProjectionArrayHeader(&element: str, &array: str): str {
    return "\ntypedef struct { size_t len; " + element.clone() + " *data; size_t capacity; } " + array.clone() + ";\n"
}

fn emitLayout(&layout: StructLayout, allow_string: bool, allow_nested: bool, arrays: bool): str! {
    text = "typedef struct {\n"
    count = layout.fields.len()
    if (count == 0) { text += "    unsigned char empty;\n" }
    index = 0
    while (index < count) {
        field = layout.fields[index].resolved.clone()
        kind = "KuProjectionString"
        if (allow_nested && field.declaration_kind == "Struct") {
            kind = CTypeName(field.module_index, field.declaration_node)
        } else if (arrays && field.declaration_kind == "StructArray") {
            kind = StructArrayTypeName(field)
        } else if (arrays && field.declaration_kind == "BuiltinArray" && field.name == "int") {
            kind = "KuArrayInt"
        } else if (arrays && field.declaration_kind == "BuiltinArray" && field.name == "str") {
            kind = "KuGuardStringArray"
        } else if (!(allow_string && StringField(field))) {
            kind = ScalarCType(field)?
        }
        text += "    " + kind + " f" + str(index) + ";\n"
        index = index + 1
    }
    text += "} " + CTypeName(layout.module_index, layout.node) + ";\n\n"
    return ok(text)
}

fn EmitLayout(&layout: StructLayout, allow_string: bool, allow_nested: bool): str! {
    return emitLayout(layout, allow_string, allow_nested, false)
}

fn EmitOwningLayout(&layout: StructLayout): str! {
    return emitLayout(layout, true, true, true)
}

fn FindLayout(&layouts: [StructLayout], module_index: int, node: int): StructLayout! {
    index = LayoutIndex(layouts, module_index, node)
    if (index == 0 || module_index < 0 || node <= 0) { InvalidPlan("unknown struct layout ID")? }
    return ok(layouts[index - 1].clone())
}

// Emits one checked function as standalone C11. Only numeric arena IDs and
// ordinals enter identifiers. A View parameter is a pointer to const storage;
// owned inputs are C values. Supported string carriers in owned inputs are
// released after the Copy projections. No owned output or transfer is emitted.
fn EmitStructProjectionC(&layouts: [StructLayout], &plan: StructReturnPlan): str! {
    if (plan.function_node <= 0) { InvalidPlan("expected a positive function ID")? }
    result = FindLayout(layouts, 0, plan.result_layout)?
    text = EmitLayout(result, false, false)?
    emitted: [str] = [CTypeName(0, result.node)]
    signature = CTypeName(0, result.node) + " ku_project_" + str(plan.function_node) + "("
    parameters_count = plan.parameters.len()
    if (parameters_count == 0) { signature += "void" }
    drops = ""
    needs_string = false
    index = 0
    while (index < parameters_count) {
        parameter = plan.parameters[index].clone()
        input = FindLayout(layouts, parameter.layout_module, parameter.layout_node)?
        type_name = CTypeName(parameter.layout_module, parameter.layout_node)
        if (!ContainsType(emitted, type_name)) {
            text += EmitLayout(input, true, false)?
            emitted = emitted.push(type_name.clone())
        }
        if (index > 0) { signature += ", " }
        if (parameter.mode == 0) {
            signature += type_name + " a" + str(index)
        } else if (parameter.mode == 1) {
            signature += "const " + type_name + " *a" + str(index)
        } else {
            InvalidPlan("expected an owned or View parameter")?
        }
        field = 0
        while (field < input.fields.len()) {
            if (StringField(input.fields[field].resolved)) {
                needs_string = true
                if (parameter.mode == 0) {
                    drops += "    ku_projection_string_drop(&a" + str(index) + ".f" + str(field) + ");\n"
                }
            }
            field = field + 1
        }
        index = index + 1
    }
    text += signature + ") {\n    " + CTypeName(0, result.node) + " result;\n"
    field_count = result.fields.len()
    if (field_count != plan.projections.len()) { InvalidPlan("expected exactly one projection for each result field")? }
    seen: [int] = []
    index = 0
    while (index < plan.projections.len()) {
        projection = plan.projections[index].clone()
        if (projection.output_field < 0 || projection.output_field >= field_count
            || ContainsIndex(seen, projection.output_field)) {
            InvalidPlan("each output field must appear once")?
        }
        if (projection.parameter < 0 || projection.parameter >= parameters_count) {
            InvalidPlan("projection refers to an unknown parameter")?
        }
        parameter = plan.parameters[projection.parameter].clone()
        input = FindLayout(layouts, parameter.layout_module, parameter.layout_node)?
        if (projection.input_field < 0 || projection.input_field >= input.fields.len()) {
            InvalidPlan("projection refers to an unknown input field")?
        }
        actual = ScalarCType(input.fields[projection.input_field].resolved)?
        expected = ScalarCType(result.fields[projection.output_field].resolved)?
        if (actual != expected) { InvalidPlan("projection changes field type")? }
        access = "."
        if (parameter.mode == 1) { access = "->" }
        text += "    result.f" + str(projection.output_field) + " = a" + str(projection.parameter)
            + access + "f" + str(projection.input_field) + ";\n"
        field = projection.output_field
        seen = seen.push(field)
        index = index + 1
    }
    if (field_count == 0) { text += "    result.empty = 0;\n" }
    text += drops + "    return result;\n}\n"
    return ok(ProjectionHeaders(needs_string, drops != "") + text)
}

fn ProjectionHeaders(needs_string: bool, drop_strings: bool): str {
    header = "#include <stdbool.h>\n#include <stdint.h>\n\n"
    if (needs_string) {
        // Private emitted ABI. The carrier and storage tags match Stage0
        // KuString. A caller moves malloc-compatible OWNED fields into an
        // owned argument and retains all fields when passing a View.
        header += "#include <stddef.h>\n"
        if (drop_strings) { header += "#include <stdlib.h>\n" }
        header += "/* KuString-compatible carrier: STATIC is borrowed storage; OWNED uses free. */\n"
        header += "typedef struct { uint8_t *ptr; size_t len; size_t capacity; uint8_t storage; } KuProjectionString;\n"
        header += "enum { KU_PROJECTION_STRING_STATIC = 0, KU_PROJECTION_STRING_OWNED = 1 };\n\n"
        if (drop_strings) {
            header += "static void ku_projection_string_drop(KuProjectionString *value) {\n"
            header += "    if (value->storage == KU_PROJECTION_STRING_OWNED && value->ptr) free(value->ptr);\n"
            header += "    *value = (KuProjectionString){0};\n}\n\n"
        }
    }
    return header
}

fn LinkedFsReadReference(&symbol: str): str {
    return "#define KU_BOOTSTRAP_FS_NO_COMPAT_STRING\n#include \"fs_read.h\"\n#undef KU_BOOTSTRAP_FS_NO_COMPAT_STRING\nextern KuResult_str " + symbol.clone() + "(const KuString*);\n"
        + "static KuProjectionString ku_linked_from_fs_string(KuString value) {\n"
        + "    return (KuProjectionString){value.ptr,value.len,value.capacity,value.storage};\n}\n"
        + "static KuBootstrapResult_KuProjectionString ku_linked_fs_read(const KuProjectionString* path) {\n"
        + "    KuString input = {path->ptr,path->len,path->capacity,path->storage};\n"
        + "    KuResult_str read = " + symbol.clone() + "(&input);\n"
        + "    KuBootstrapResult_KuProjectionString out = {0};\n"
        + "    out.ok = read.ok;\n"
        + "    if (read.ok) out.value = ku_linked_from_fs_string(read.value);\n"
        + "    else out.error = (KuBootstrapError){ku_linked_from_fs_string(read.error.domain), "
        + "ku_linked_from_fs_string(read.error.code), ku_linked_from_fs_string(read.error.message)};\n"
        + "    return out;\n}\n"
}

struct ProjectionBuiltinLink {
    name: str
    namespace: str
    path: str
    symbol: str
}

fn ProjectionBuiltinLinkFor(id: int): ProjectionBuiltinLink {
    if (id == 1) {
        return ProjectionBuiltinLink { name: "read", namespace: "fs", path: "std/fs.ku", symbol: "ku_linked_dep_fs_read" }
    }
    if (id == 2) {
        return ProjectionBuiltinLink { name: "slice", namespace: "string", path: "std/string.ku", symbol: "ku_linked_dep_string_slice" }
    }
    name = ""
    if (id == 3) { name = "from_str" }
    else if (id == 4) { name = "get" }
    symbol = "ku_linked_dep_bytes_" + name.clone()
    return ProjectionBuiltinLink { name: name, namespace: "bytes", path: "std/bytes.ku", symbol: symbol }
}

fn ProjectionBuiltinLinkId(&name: str, checked: bool): int {
    if (!checked) { return 0 }
    if (name == "read") { return 1 }
    if (name == "slice") { return 2 }
    if (name == "from_str") { return 3 }
    return 0
}

fn ProjectionBytesGet(&target: Node, &receiver: TypeNameBinding, arguments: int, checked: bool): bool {
    return checked && target.kind == "Field" && target.edge_count == 1 && target.text == "get" && arguments == 1
        && receiver.declaration_kind == "Builtin" && receiver.name == "bytes"
}

fn ProjectionLocalFunction(&supplied: [SuppliedModule], unit: int, &name: str): int {
    for entry in supplied[unit - 1].named.names.declarations.clone() {
        if (entry.kind == "Function" && entry.name == name) { return entry.node }
    }
    return 0
}

fn ResolveProjectionDirectFunction(&supplied: [SuppliedModule], &imports: [ImportBinding], unit: int, &target: Node): [int]! {
    if (target.kind == "Variable" && target.edge_count == 0) {
        local = ProjectionLocalFunction(supplied, unit, target.text)
        if (local > 0) { return ok([unit, local]) }
        for binding in imports.clone() {
            if (binding.local_name == target.text && binding.module_index > 0) {
                if (supplied[binding.module_index - 1].named.parsed.arena.nodes[binding.target_node - 1].kind == "Function") {
                    return ok([binding.module_index, binding.target_node])
                }
            }
        }
    }
    RejectLayout("undefined_linked_dependency", "expected a bound direct function", DeclarationSpan(target))?
    return ok([])
}

fn linkedCallbackBuiltinType(&named: NamedModule, id: int, array: bool, &name: str): bool {
    node = named.parsed.arena.nodes[id - 1].clone()
    if (array) {
        if (node.kind != "TypeArray" || node.edge_count != 1) { return false }
        node = named.parsed.arena.nodes[named.parsed.arena.edges[node.first_edge] - 1].clone()
    }
    return node.kind == "TypeName" && node.edge_count == 0 && node.text == name
}

fn LinkedIntArrayCallbackNominal(&named: NamedModule, &node: Node): int! {
    nominal = 0
    index = 0
    while (index < 4) {
        part = named.parsed.arena.nodes[named.parsed.arena.edges[node.first_edge + index] - 1].clone()
        if (part.kind != "TypeParameter" || part.edge_count != 1 || part.text != "") {
            RejectLayout("linked_callback_type", "scoped array callback arguments must be by-value", DeclarationSpan(part))?
        }
        ty = named.parsed.arena.edges[part.first_edge]
        if (index == 3) { nominal = ty }
        else if (!linkedCallbackBuiltinType(named, ty, index == 0, "int")) {
            RejectLayout("linked_callback_type", "scoped array callback needs [int], int, int and a named record", DeclarationSpan(part))?
        }
        index += 1
    }
    result = named.parsed.arena.nodes[named.parsed.arena.edges[node.first_edge + 4] - 1].clone()
    if (result.kind != "TypeResult" || result.edge_count != 1 ||
        !linkedCallbackBuiltinType(named, named.parsed.arena.edges[result.first_edge], true, "int")) {
        RejectLayout("linked_callback_type", "scoped array callback must return [int]!", DeclarationSpan(result))?
    }
    return ok(nominal)
}

fn LinkedIntAppendCallbackNominals(&named: NamedModule, &node: Node): [int]! {
    nominals: [int] = []
    count = node.edge_count - 1
    arena = count == 3
    index = 0
    while (index < count) {
        part = named.parsed.arena.nodes[named.parsed.arena.edges[node.first_edge + index] - 1].clone()
        if (part.kind != "TypeParameter" || part.edge_count != 1 || part.text != "") {
            RejectLayout("linked_callback_type", "scoped append callback arguments must be by-value", DeclarationSpan(part))?
        }
        ty = named.parsed.arena.edges[part.first_edge]
        if (arena) {
            if (index < 2) { nominals = nominals.push(ty) }
            else if (!linkedCallbackBuiltinType(named, ty, false, "bool")) {
                RejectLayout("linked_callback_type", "scoped arena callback needs two records and a bool", DeclarationSpan(part))?
            }
        } else if (index == 3 || index == 5) { nominals = nominals.push(ty) }
        else {
            name = "int"
            if (index < 2) { name = "str" }
            if (!linkedCallbackBuiltinType(named, ty, index == 4, name)) {
                RejectLayout("linked_callback_type", "scoped append callback needs str, str, int, a record, [int] and a record", DeclarationSpan(part))?
            }
        }
        index += 1
    }
    result = named.parsed.arena.nodes[named.parsed.arena.edges[node.first_edge + count] - 1].clone()
    if (result.kind != "TypeResult" || result.edge_count != 1 ||
        !linkedCallbackBuiltinType(named, named.parsed.arena.edges[result.first_edge], false, "int")) {
        RejectLayout("linked_callback_type", "scoped append callback must return int!", DeclarationSpan(result))?
    }
    return ok(nominals)
}

fn RequireProjectionLocalFunction(&supplied: [SuppliedModule], &name: str): int! {
    entry = ProjectionLocalFunction(supplied, 1, name)
    if (entry == 0) {
        point = Span { line: 1, column: 1, offset: 0, end_line: 1, end_column: 1, end_offset: 0 }
        RejectLayout("unknown_linked_null_entry", "expected a selected null! function", point)?
    }
    return ok(entry)
}

fn LinkedAppendFailureDeclaration(): str {
    return "\ntypedef struct { int append_status; bool out_of_memory, overflow, index_failed; const char *array_error; int64_t index; size_t length; } KuLocalAppendFailure;\n"
}

fn LinkedIntArrayCallbackDeclaration(&name: str, &nominal: str): str {
    return "typedef struct { KuBootstrapResult_KuArrayInt (*entry)(void*, KuLocalAppendFailure*, KuArrayInt, int64_t, int64_t, "
        + nominal.clone() + "); void *environment; KuLocalAppendFailure *failure; } " + name.clone() + ";\n"
}

fn LinkedIntAppendCallbackDeclaration(&name: str, &first: str, &second: str, arena: bool): str {
    params = "KuProjectionString, KuProjectionString, int64_t, " + first.clone() + ", KuArrayInt, " + second.clone()
    if (arena) { params = first.clone() + ", " + second.clone() + ", bool" }
    return "typedef struct { KuBootstrapResult_int64_t (*entry)(void*, KuLocalAppendFailure*, "
        + params + "); void *environment; KuLocalAppendFailure *failure; } " + name.clone() + ";\n"
}

fn LinkedIntArrayCallbackFaultPending(&pointer: str): str {
    p = "(" + pointer.clone() + ")"
    return p.clone() + " && (" + p.clone() + "->out_of_memory || " + p.clone() + "->array_error || "
        + p.clone() + "->append_status || " + p.clone() + "->overflow || " + p + "->index_failed)"
}

fn LinkedAppendFaultRelayCode(&fault: str): str {
    return "    if (" + fault.clone() + ".out_of_memory) { out_of_memory = true; goto cleanup; }\n"
        + "    if (" + fault.clone() + ".array_error) { captured_array_failure = " + fault.clone() + ".array_error; goto cleanup; }\n"
        + "    if (" + fault.clone() + ".append_status != KU_STRUCT_ARRAY_OK) { append_status = "
        + fault.clone() + ".append_status; goto cleanup; }\n"
        + "    if (" + fault.clone() + ".overflow) { overflow = true; goto cleanup; }\n"
        + "    if (" + fault.clone() + ".index_failed) { index_failed = true; failure_index = " + fault.clone()
        + ".index; failure_length = " + fault.clone() + ".length; goto cleanup; }\n"
}

fn LinkedBufferResult(&binding: TypeNameBinding): bool {
    return binding.declaration_kind == "Builtin" && (binding.name == "str" || binding.name == "bytes")
}
