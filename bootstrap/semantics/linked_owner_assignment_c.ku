import { CheckLinkedLocalInitializer, LinkedLocalCaptures, ReadLinkedParameterCaptures, RetainLinkedField } from "./linked_nullable_reader_c.ku"
import { RejectLocalCapture } from "./call_contracts.ku"
import { ContainsIndex, ContainsType } from "./struct_projection_c.ku"
import { TypeNameBinding } from "./type_names.ku"
import { Node } from "../stage2/ast.ku"
import { DeclarationSpan } from "./names.ku"
import { RejectLayout } from "./struct_layouts.ku"
import { LinkedAppendFailureRelay, RestoreLinkedThunkFrame } from "./link_plan_json_c.ku"
import { StartLinkedThunkFrame } from "./scalar_result_null.ku"
import { AppendLinkedArrayElement, LowerLinkedArrayBinding } from "./linked_array_fields_c.ku"
import { LinkedCountBound, LinkedIncreasingGuard, LinkedLiveIntBinding, LinkedMemberUnavailable, LinkedNullDropC, MoveLinkedNullSlot, RecordLinkedMemberMove, RequireLinkedMove } from "./linked_member_ownership.ku"
import { LinkedLocalAppend, LinkedNullBinding, LinkedNullExpression, LinkedNullFunction, LinkedNullIntArrayOwner, LinkedNullOwnedArray, LinkedNullRegion, LinkedNullSlot, LinkedNullState, LinkedNullValue } from "./link_plan_c.ku"
import { LinkedCheckedResultCType, LinkedIntResult, LinkedNullArrayElement, LinkedNullCType, LinkedNullChild, LinkedNullNode, LinkedNullProject, LinkedNullType, LinkedStringResult, ReadLinkedOwnedArray, SameLinkedType } from "./linked_null_types_c.ku"
import { AddLinkedNullSlot, ReadLinkedNullParametersFrom } from "./linked_parameters_c.ku"
import { FinishLinkedFunctionC } from "./guarded_struct_c.ku"
import { ReadOwnedArrayPushArgument } from "./struct_array_c.ku"
import { CloneLinkedStringArray } from "./struct_string_calls.ku"
import { CloneLinkedRecordArray } from "./linked_null_read_c.ku"
import { LowerLinkedExpectedValue, LowerLinkedNullValue } from "./linked_null_values_c.ku"

fn LowerLinkedArrayAppend(&project: LinkedNullProject, state: LinkedNullState, &statement: Node, index: int): LinkedNullState! {
    array = state.slots[index - 1].value.clone()
    copy = LinkedNullIntArrayOwner(array.ty)
    if (!state.slots[index - 1].live || (!copy && !LinkedNullOwnedArray(array.ty) && array.ty.declaration_kind != "OwnedStringArray")) {
        RejectLayout("linked_move_append", "expected an initialized array assigned its own push result", DeclarationSpan(statement))?
    }
    id = ReadOwnedArrayPushArgument(project.supplied[0].named, statement)?
    if (id == 0) {
        if (ContainsIndex(state.append_captures, index)) {
            RejectLayout("linked_capture_rebind", "a local append capture can only be assigned its own push result", DeclarationSpan(statement))?
        }
        return LowerLinkedOwnerRebind(project, state, statement)
    }
    value = LowerLinkedNullValue(project, state, id, 0)?
    element = value.value
    matches = false
    if (value.state.slots[index - 1].live) {
        expected = LinkedNullArrayElement(array.ty.clone())
        matches = SameLinkedType(element.ty, expected)
    }
    if (!matches || element.borrowed && (copy || element.member_path == "")
        || !copy && (element.slot == 0 || element.slot == index)) {
        RejectLayout("linked_move_append", "push requires one element of the declared type", element.ty.span.clone())?
    }
    if (!copy) {
        if (element.member_path != "") {
            drop = LinkedNullDropC(value.state.layouts, value.state.owning_layouts, element.ty, element.text)
            if (drop == "") {
                RejectLayout("linked_move_append", "field transfer requires an owning element", element.ty.span.clone())?
            }
        }
        RequireLinkedMove(value.state, element)?
    }
    return ok(AppendLinkedArrayElement(value.state, array, element))
}

fn LowerLinkedOwnerRebind(&project: LinkedNullProject, state: LinkedNullState, &assignment: Node): LinkedNullState! {
    index = LinkedNullBinding(state.slots, assignment.text)
    if (index == 0) {
        RejectLayout("linked_rebind_target", "expected a declared local owner", DeclarationSpan(assignment))?
    }
    target = state.slots[index - 1].value.clone()
    if (target.ty.declaration_kind == "Struct" && state.slots[index - 1].parameter && ContainsIndex(state.append_captures, index)) {
        RejectLayout("linked_capture_rebind", "a local callback cannot replace its captured record", DeclarationSpan(assignment))?
    }
    value = LowerLinkedNullValue(project, state, LinkedNullChild(project, 1, assignment, 0), 0)?
    record = target.ty.declaration_kind == "Struct"
    owner = record || LinkedStringResult(target.ty) || LinkedNullOwnedArray(target.ty) || LinkedNullIntArrayOwner(target.ty)
        || target.ty.declaration_kind == "OwnedStringArray"
    // A selected owned field has a tracked path in a separate owner.
    // A View or an indexed borrowed element cannot supply that ownership.
    owned_field = (record || LinkedStringResult(target.ty)) && value.value.member_path != ""
    if (target.borrowed || !owner || !SameLinkedType(target.ty, value.value.ty)
        || (value.value.borrowed && !owned_field)
        || value.value.slot == index || (record && value.value.slot == 0)) {
        RejectLayout("linked_rebind_type", "replacement requires a separate owner of the declared type", DeclarationSpan(assignment))?
    }
    // Keep the original fields in cleanup until the checked RHS succeeds.
    drop = LinkedNullDropC(value.state.layouts, value.state.owning_layouts, target.ty, target.text)
    value.state.code += drop + "    " + target.text + " = " + value.value.text.clone() + ";\n"
    value.state.slots[index - 1].live = true
    moved = value.value.clone()
    next = MoveLinkedNullSlot(value.state, moved)?
    if (record || LinkedStringResult(target.ty)) {
        cleared: [str] = []
        next.slots[index - 1].moved_members = cleared
    }
    if (record && !LinkedMemberUnavailable(next, moved, true)) {
        // A nominal struct with only Copy fields still moves in Ku.
        next = RecordLinkedMemberMove(next, moved)
    }
    return ok(next)
}

struct LinkedForLoop {
    state: LinkedNullState
    outer: [LinkedNullSlot]
    before: int
}

fn OpenLinkedOwnedForLoop(&project: LinkedNullProject, state: LinkedNullState, &statement: Node,
                            source: int, id: int, depth: int): LinkedForLoop! {
    at = DeclarationSpan(statement)
    if (depth >= 32 || LinkedNullBinding(state.slots, statement.text) != 0) {
        RejectLayout("linked_record_for_scope", "owned array iteration needs a fresh local binding within the control bound", at.clone())?
    }
    before = state.slots.len()
    input = LowerLinkedNullValue(project, state, source, 0)?
    owner = input.value.clone()
    strings = owner.ty.declaration_kind == "OwnedStringArray"
    if ((!LinkedNullOwnedArray(owner.ty) && !strings) || owner.borrowed || owner.slot == 0 ||
        LinkedMemberUnavailable(input.state, owner, true)) {
        RejectLayout("linked_record_for_source", "expected a live owned record or string array", at)?
    }
    if (owner.slot <= before || owner.member_path != "" || input.state.slots[owner.slot - 1].binding != "") {
        // The language keeps a named source usable after iteration. Move
        // elements out of its independent snapshot, as for a fresh result.
        if (strings) { input = CloneLinkedStringArray(project, input, id)? }
        else { input = CloneLinkedRecordArray(project, input, id)? }
        owner = input.value.clone()
    }

    // The checked call or clone has already admitted this private header.
    // Keep it in cleanup, and move each item out before entering the body.
    outer = input.state.slots.clone()
    ty = LinkedNullArrayElement(owner.ty)
    suffix = str(id) + "_records"
    if (strings) { suffix = str(id) + "_strings" }
    item = AddLinkedNullSlot(project, input.state, statement.text.clone(), "t" + suffix.clone(), ty.clone(), false)?
    item.state.slots[item.value.slot - 1].live = true
    index = "i" + suffix
    element = owner.text.clone() + ".data[" + index.clone() + "]"
    item.state.code += "    for (size_t " + index.clone() + " = 0; " + index.clone() + " < "
        + owner.text + ".len; ++" + index + ") {\n"
        + "    " + item.value.text + " = " + element.clone() + ";\n"
        + "    " + element + " = (" + LinkedNullCType(ty)? + "){0};\n"
    return ok(LinkedForLoop { state: item.state, outer: outer, before: before })
}

fn OpenLinkedBooleanWhile(state: LinkedNullState, &statement: Node, condition: str, depth: int): LinkedForLoop! {
    if (depth >= 32) {
        RejectLayout("linked_control_depth", "linked control flow allows at most 32 levels", DeclarationSpan(statement))?
    }
    before = state.slots.len()
    outer = state.slots.clone()
    next = state
    // This local is reevaluated by C at the original loop boundary.
    next.code += "    while (" + condition + ") {\n"
    return ok(LinkedForLoop { state: next, outer: outer, before: before })
}

fn ReadLinkedLocalCaptures(&project: LinkedNullProject, &state: LinkedNullState,
                           &function: Node, id: int, body_start: int): LinkedLocalCaptures! {
    return ReadLinkedParameterCaptures(project, state, function, id, body_start, body_start - 1)
}

struct LinkedAppendThunk {
    body_start: int
    signature: str
    result: TypeNameBinding
    arguments: [TypeNameBinding]
    sources: [int]
    environment: str
    typedef_fields: str
    initializers: str
}

struct LinkedAppendBody {
    state: LinkedNullState
    thunk: LinkedAppendThunk
}

fn IsLinkedAppendThunk(&project: LinkedNullProject, &function: Node): bool {
    limit = function.edge_count - 1
    index = 0
    while (index < limit) {
        node = LinkedNullNode(project, 1, LinkedNullChild(project, 1, function, index))
        if (node.kind != "Parameter") {
            if (node.kind != "TypeResult" || node.edge_count != 1) { return false }
            if (index <= 1) { return true }
            payload = LinkedNullNode(project, 1, LinkedNullChild(project, 1, node, 0))
            if (payload.kind == "TypeArray" && payload.edge_count == 1) {
                payload = LinkedNullNode(project, 1, LinkedNullChild(project, 1, payload, 0))
            }
            return payload.kind == "TypeName" && payload.text == "int"
        }
        index = index + 1
    }
    return false
}

fn ReadLinkedAppendThunk(&project: LinkedNullProject, &parent: LinkedNullState,
                         &function: Node, id: int): LinkedAppendBody! {
    parameters = ReadLinkedNullParametersFrom(project, function, StartLinkedThunkFrame(parent))?
    arguments: [TypeNameBinding] = []
    slots = parameters.state.slots.clone()
    null_result = parameters.result.declaration_kind == "Builtin" && parameters.result.name == "null"
    nullary = null_result && parameters.body_start == 1
    one_input = null_result && parameters.body_start == 2
    record_input = one_input && slots[0].value.ty.declaration_kind == "Struct"
    copy_input = one_input && LinkedIntResult(slots[0].value.ty)
    int_result = LinkedIntResult(parameters.result) || LinkedNullIntArrayOwner(parameters.result)
    if (parameters.state.plain_value_result || !nullary && !record_input && !copy_input &&
        (!int_result || slots.len() == 0 || slots.len() > 8)) {
        RejectLocalCapture(function, "a local append function requires int! or [int]! with one to eight arguments, or null! with zero arguments, one int or one owned record")?
    }
    // Direct synchronous calls use the ordinary owning argument slots.
    // Views and callable descriptors still require a separate lifetime proof.
    for slot in slots {
        ty = slot.value.ty
        if (slot.value.borrowed || (ty.declaration_kind != "Struct" && !LinkedIntResult(ty) &&
            !LinkedStringResult(ty) && !(ty.declaration_kind == "Builtin" && ty.name == "bool") &&
            !LinkedNullIntArrayOwner(ty) && !LinkedNullOwnedArray(ty))) {
            RejectLocalCapture(function, "local append arguments require a supported Copy or owning parameter type")?
        }
        arguments = arguments.push(ty)
    }
    body = parameters.state
    environment = "ku_local_append_environment_" + str(id)
    body.code += "    " + environment.clone() + " *const capture = raw;\n"
    fields = ""
    initializers = ""
    sources: [int] = []
    captures = ReadLinkedLocalCaptures(project, parent, function, id, parameters.body_start)?
    captured_slots = captures.slots
    for index in captured_slots {
        outer = parent.slots[index - 1].clone()
        ty = outer.value.ty.clone()
        array = LinkedNullOwnedArray(ty) || LinkedNullIntArrayOwner(ty)
        scalar = ty.declaration_kind == "Builtin" && (ty.name == "int" || ty.name == "bool")
        record = copy_input && ty.declaration_kind == "Struct" && !outer.parameter
        if (!outer.live || outer.value.borrowed || outer.moved_members.len() > 0 ||
            ContainsIndex(parent.callback_owners, index) || (!scalar && !array && !record)) {
            RejectLocalCapture(function, "a local append capture requires live Copy storage or an exclusive array or record")?
        }
        field = "c" + str(index)
        fields += " " + LinkedNullCType(ty)? + " *" + field.clone() + ";"
        initializers += " ." + field.clone() + " = &(" + outer.value.text + "),"
        outer.value.text = "(*capture->" + field + ")"
        outer.value.slot = body.slots.len() + 1
        // These are references to automatic storage in the caller. Only
        // that caller drops these owners, including any successfully
        // appended prefix. The entry borrows their stable storage.
        outer.parameter = true
        if (array || record) {
            body.append_captures = body.append_captures.push(outer.value.slot)
            sources = sources.push(index)
        }
        body.slots = body.slots.push(outer)
    }
    if (sources.len() == 0) {
        RejectLocalCapture(function, "a local append function requires an exclusive array capture")?
    }
    // Only previously declared local callees are available. Forward their
    // original environment address, never a rebuilt copy of its owners.
    captured_calls = captures.calls
    for index in captured_calls {
        callee = parent.local_appends[index - 1].clone()
        suffix = str(callee.function.node)
        field = "f" + suffix.clone()
        fields += " ku_local_append_environment_" + suffix + " *" + field.clone() + ";"
        initializers += " ." + field.clone() + " = " + callee.environment + ","
        callee.environment = "capture->" + field
        body.local_appends = body.local_appends.push(callee)
    }
    thunk = LinkedAppendThunk { body_start: parameters.body_start, signature: parameters.signature,
        result: parameters.result, arguments: arguments, sources: sources,
        environment: environment, typedef_fields: fields, initializers: initializers }
    return ok(LinkedAppendBody { state: body, thunk: thunk })
}

fn FinishLinkedAppendThunk(&parent: LinkedNullState, &thunk: LinkedAppendThunk,
                           lowered: LinkedNullRegion, &function: Node, id: int): LinkedNullState! {
    next = lowered.state
    if (!lowered.terminal || (next.append_slots.len() == 0 && !LinkedNullIntArrayOwner(thunk.result)) ||
        next.uses_print || next.uses_chars ||
        next.uses_str_view || next.uses_struct_view || next.uses_concat || next.uses_div) {
        RejectLocalCapture(function, "a local append function needs checked exits and append-only captured array effects")?
    }
    count = next.append_slots.len()
    cursor = 0
    while (cursor < count) {
        index = next.append_slots[cursor]
        ty = next.slots[index - 1].value.ty.clone()
        next.local_append_types = next.local_append_types.push(ty)
        cursor = cursor + 1
    }
    signature = "void *raw, KuLocalAppendFailure *failure"
    if (thunk.body_start > 1) { signature += ", " + thunk.signature.clone() }
    symbol = "ku_local_append_" + str(id)
    next.callback_helpers += "\ntypedef struct {" + thunk.typedef_fields.clone() + " } " + thunk.environment.clone() + ";\nstatic "
        + FinishLinkedFunctionC("", next, symbol, signature, LinkedCheckedResultCType(thunk.result)?,
            "", "", LinkedAppendFailureRelay(next))
    next = RestoreLinkedThunkFrame(next, parent)
    source_count = thunk.sources.len()
    cursor = 0
    while (cursor < source_count) {
        index = thunk.sources[cursor]
        if (!ContainsIndex(next.append_captures, index)) { next.append_captures = next.append_captures.push(index) }
        cursor = cursor + 1
    }
    frame = "environment" + str(id)
    callee = LinkedNullFunction { unit: 1, node: id, symbol: symbol.clone(), parameters: thunk.arguments.clone(),
        result: thunk.result.clone(), returns_result: true }
    next.local_appends = next.local_appends.push(LinkedLocalAppend { binding: function.text.clone(),
        function: callee, environment: "&" + frame.clone() })
    next.declarations += "    " + thunk.environment.clone() + " " + frame.clone() + " = {0};\n"
    next.code += "    " + frame.clone() + " = (" + thunk.environment.clone() + "){" + thunk.initializers.clone() + " };\n"
        + "    (void)" + frame + "; (void)" + symbol + ";\n"
    return ok(next)
}

fn LowerLinkedLocal(&project: LinkedNullProject, state: LinkedNullState, &statement: Node, id: int,
                    retained: bool): LinkedNullState! {
    if (LinkedNullBinding(state.slots, statement.text) != 0) {
        RejectLayout("linked_binding_shadowed", "expected a new initialized local binding", DeclarationSpan(statement))?
    }
    initializer = statement.edge_count - 1
    source = LinkedNullChild(project, 1, statement, initializer)
    value = LowerLinkedNullValue(project, state, source, 0)?
    if (retained) { value = RetainLinkedField(project, value, source)? }
    ty = value.value.ty.clone()
    CheckLinkedLocalInitializer(project, statement, ty)?
    slot = AddLinkedNullSlot(project, value.state, statement.text.clone(), "l" + str(id), ty, false)?
    slot.state.code = slot.state.code + "    " + slot.value.text.clone() + " = " + value.value.text.clone() + ";\n"
    slot.state.slots[slot.value.slot - 1].live = true
    return MoveLinkedNullSlot(slot.state, value.value)
}

fn LowerLinkedTypedArrayLocal(&project: LinkedNullProject, state: LinkedNullState, &statement: Node, id: int): LinkedNullState! {
    ty = ReadLinkedOwnedArray(project, 1, LinkedNullChild(project, 1, statement, 0), true, true)?
    value_id = LinkedNullChild(project, 1, statement, 1)
    value = LinkedNullNode(project, 1, value_id)
    if (LinkedNullBinding(state.slots, statement.text) != 0) {
        RejectLayout("linked_array_local", "expected a new typed array owner", DeclarationSpan(statement))?
    }
    if (value.kind == "Array" && value.edge_count > 0 && LinkedNullOwnedArray(ty)) {
        literal = LowerLinkedExpectedValue(project, state, ty, value_id, 0)?
        slot = literal.value.slot - 1
        next = literal.state
        next.slots[slot].binding = statement.text.clone()
        return ok(next)
    }
    return LowerLinkedArrayBinding(project, state, statement, id, value, value_id, ty)
}

fn StoreLinkedCopyAssignment(&destination: LinkedNullValue, live: bool, value: LinkedNullExpression, &assignment: Node): LinkedNullState! {
    if (!live || destination.borrowed || !SameLinkedType(destination.ty, value.value.ty)) {
        RejectLayout("linked_copy_assignment", "assignment requires a live Copy target and matching scalar expression",
                     DeclarationSpan(assignment))?
    }
    next = value.state
    next.code += "    " + destination.text + " = " + value.value.text + ";\n"
    return ok(next)
}

fn ValidLinkedCountedStart(&project: LinkedNullProject, &state: LinkedNullState, id: int, slot: int, named_bound: bool): bool {
    initial = LinkedNullNode(project, 1, id)
    if (initial.kind == "Int" && initial.edge_count == 0 && initial.int_value == 0) { return true }
    if (!named_bound) { return false }
    if (initial.kind == "Binary" && initial.text == "+" && initial.edge_count == 2) {
        offset = LinkedNullNode(project, 1, LinkedNullChild(project, 1, initial, 1))
        if (offset.kind != "Int" || offset.edge_count != 0 || offset.int_value < 0) { return false }
        initial = LinkedNullNode(project, 1, LinkedNullChild(project, 1, initial, 0))
    }
    input = LinkedLiveIntBinding(state, initial)
    return input > 0 && input != slot
}

fn CheckLinkedCountedIndex(&project: LinkedNullProject, &state: LinkedNullState, &loop: Node, &initial: Node, &step: Node): int! {
    guard = LinkedIncreasingGuard(project, loop)
    bounded = false
    if (guard.kind == "Binary" && guard.edge_count == 2 && guard.text == "<") {
        bounded = LinkedCountBound(project, state, LinkedNullChild(project, 1, guard, 1))?
    }
    if (!bounded) {
        RejectLayout("unsupported_linked_loop", "counted while requires a readonly array length or stable int bound", DeclarationSpan(guard))?
    }
    left = LinkedNullNode(project, 1, LinkedNullChild(project, 1, guard, 0))
    slot = LinkedLiveIntBinding(state, left)
    if (slot == 0 ||
        initial.kind != "Assign" || initial.edge_count != 1 || initial.text != left.text ||
        step.kind != "Assign" || step.edge_count != 1 || step.text != left.text) {
        RejectLayout("unsupported_linked_loop", "counted while requires one distinct int cursor", DeclarationSpan(loop))?
    }
    bound = LinkedNullNode(project, 1, LinkedNullChild(project, 1, guard, 1))
    named_bound = LinkedLiveIntBinding(state, bound) > 0
    valid_start = ValidLinkedCountedStart(project, state, LinkedNullChild(project, 1, initial, 0), slot, named_bound)
    rhs = LinkedNullNode(project, 1, LinkedNullChild(project, 1, step, 0))
    if (!valid_start || rhs.kind != "Binary" || rhs.edge_count != 2 || rhs.text != "+") {
        RejectLayout("unsupported_linked_loop", "counted while requires initialization to zero or a supported stable int start and a fixed increment", DeclarationSpan(loop))?
    }
    cursor = LinkedNullNode(project, 1, LinkedNullChild(project, 1, rhs, 0))
    amount = LinkedNullNode(project, 1, LinkedNullChild(project, 1, rhs, 1))
    if (cursor.kind != "Variable" || cursor.edge_count != 0 || cursor.text != left.text ||
        amount.kind != "Int" || amount.edge_count != 0 || amount.int_value <= 0 || (!named_bound && amount.int_value != 1)) {
        RejectLayout("unsupported_linked_loop", "counted while requires a positive constant step with a named int bound and a unit step otherwise", DeclarationSpan(step))?
    }
    return ok(slot)
}
