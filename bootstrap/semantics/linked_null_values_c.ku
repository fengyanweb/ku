import { LinkedDirectCallExpression, LinkedMemberUnavailable, LinkedNullDropC, LinkedViewArgument, MatchesLinkedFieldValue, MoveLinkedNullSlot } from "./linked_member_ownership.ku"
import { Node } from "../stage2/ast.ku"
import { FindLinkedLocalRead } from "./call_contracts.ku"
import { TypeNameBinding } from "./type_names.ku"
import { DeclarationSpan } from "./names.ku"
import { FieldIndex, LayoutIndex, RejectLayout } from "./struct_layouts.ku"
import { ContainsIndex, ProjectionCloneSource } from "./struct_projection_c.ku"
import { ReadLinkedNullBinding, AppendLinkedCheckedInvocation, LinkedCheckedCall, LinkedNullArguments, RememberLinkedCall, LinkedNullBinding, LinkedNullExpression, LinkedNullFunction, LinkedNullOwnedArray, LinkedNullIntArrayOwner, LinkedNullOwner, LinkedNullState, LinkedNullValue } from "./link_plan_c.ku"
import { EmitLinkedIntAppend } from "./struct_array_c.ku"
import { LinkedCheckedResultCType, LinkedIntResult, LinkedNullArrayElement, LinkedNullArrayPrefix, LinkedNullCallSymbol, LinkedNullCType, LinkedNullChild, ResolveLinkedCall, LinkedNullHasResultValue, LinkedNullLiteralType,
         LinkedNullNode, LinkedNullProject, LinkedNullResultType, LinkedNullView, LinkedStringResult, SameLinkedType } from "./linked_null_types_c.ku"
import { CloneLinkedLocalArrayItem, CloneLinkedRecord, CloneLinkedRecordArray, EmitLinkedAddition, LowerLinkedIntArrayLiteral, LowerLinkedNullLeaf, LowerLinkedNullRead } from "./linked_null_read_c.ku"
import { AddLinkedNullSlot, CheckedLinkedCallbackExpression, CloneLinkedStringSlot, IsLinkedIntConversion, LowerLinkedIntString, RegisterLinkedNullType, RequireLinkedArrayValidation, RestoreLinkedConcatPrefix } from "./linked_parameters_c.ku"

fn emitLinkedClone(&project: LinkedNullProject, state: LinkedNullState, &target: Node, id: int, depth: int): LinkedNullExpression! {
    subject_id = LinkedNullChild(project, 1, target, 0)
    subject = LinkedNullNode(project, 1, subject_id)
    field = subject.kind == "Field" && subject.edge_count == 1
    if (!field && subject.kind != "Index" && (subject.kind != "Variable" || subject.edge_count != 0)) {
        RejectLayout("unsupported_linked_clone", "expected a bound variable, indexed element or str field for clone", DeclarationSpan(subject))?
    }
    source = LowerLinkedNullRead(project, state, subject_id, depth + 1)?
    ty = source.value.ty.clone()
    if (ty.declaration_kind == "Builtin" && ty.name == "str") {
        return CloneLinkedStringSlot(project, source, "t" + str(id))
    }
    if (field) {
        RejectLayout("unsupported_linked_clone", "field clone requires a bound str", DeclarationSpan(subject))?
    }
    if (LinkedNullOwnedArray(ty)) { return CloneLinkedRecordArray(project, source, id) }
    if (ty.declaration_kind != "Struct") {
        RejectLayout("unsupported_linked_clone", "expected str or a finite struct for clone", DeclarationSpan(subject))?
    }
    if (subject.kind != "Index" && subject.kind != "Variable") {
        RejectLayout("unsupported_linked_clone", "struct clone needs a bound or indexed value", DeclarationSpan(subject))?
    }
    return CloneLinkedRecord(project, source, subject, id)
}

fn forwardLinkedCallback(&project: LinkedNullProject, &state: LinkedNullState, id: int,
                         &parameter: TypeNameBinding): str! {
    source = ProjectionCloneSource(project.supplied[0].named.parsed.arena.nodes,
        project.supplied[0].named.parsed.arena.edges, id)
    node = LinkedNullNode(project, 1, id)
    if (source != 0) { node = LinkedNullNode(project, 1, source) }
    slot = LinkedNullBinding(state.slots, node.text)
    if (node.kind != "Variable" || node.edge_count != 0 || slot == 0 || !state.slots[slot - 1].parameter ||
        !state.slots[slot - 1].live || !SameLinkedType(state.slots[slot - 1].value.ty, parameter)) {
        RejectLayout("linked_callback_forward", "expected a live callback parameter with the same checked signature", DeclarationSpan(node))?
    }
    // Even an explicit clone keeps the same environment. Both descriptors
    // are borrowed from the invoking frame for this synchronous call.
    return ok(state.slots[slot - 1].value.text.clone())
}

fn LowerLinkedArguments(&project: LinkedNullProject, state: LinkedNullState, &call: Node, &callee: LinkedNullFunction,
                         id: int, depth: int): LinkedNullArguments! {
    next = state
    next.links = RememberLinkedCall(next.links, callee.clone())
    args = ""
    handoff = ""
    loans: [LinkedNullValue] = []
    index = 0
    while (index < callee.parameters.len()) {
        argument_id = LinkedNullChild(project, 1, call, index + 1)
        if (args != "") { args += ", " }
        if (callee.parameters[index].declaration_kind == "IntPairResultCallback") {
            args += forwardLinkedCallback(project, next, argument_id, callee.parameters[index])?
            index = index + 1
            continue
        }
        argument = LowerLinkedNullValue(project, next.clone(), argument_id, depth + 1)?
        if (LinkedNullView(callee.parameters[index])) {
            args += LinkedViewArgument(callee.parameters[index], argument.value)?
            if (argument.value.slot > 0) { loans = loans.push(argument.value.clone()) }
            next = argument.state
            index = index + 1
            continue
        }
        if (!SameLinkedType(callee.parameters[index], argument.value.ty)) {
            RejectLayout("linked_argument_type", "argument type differs from the bound function parameter", argument.value.ty.span.clone())?
        }
        // Pending argument slots own their values until the actual call. A
        // later argument can fail while computing a nested call or a clone.
        ty = argument.value.ty.clone()
        pending = AddLinkedNullSlot(project, argument.state, "", "p" + str(id) + "_" + str(index), ty, false)?
        pending.state.code = pending.state.code + "    " + pending.value.text.clone() + " = " + argument.value.text.clone() + ";\n"
        next = MoveLinkedNullSlot(pending.state, argument.value)?
        args += pending.value.text.clone()
        if (LinkedNullOwner(pending.value.ty)) {
            handoff += "    " + pending.value.text + " = (" + LinkedNullCType(pending.value.ty)? + "){0};\n"
        }
        index = index + 1
    }
    // Evaluating a later argument may move an earlier lent binding. The
    // final direct call cannot outlive a moved source, including nested calls.
    for loan in loans {
        if (LinkedMemberUnavailable(next, loan, true)) {
            RejectLayout("linked_view_move", "a later argument consumes an earlier View source", DeclarationSpan(call))?
        }
    }
    return ok(LinkedNullArguments { state: next, args: args, handoff: handoff })
}

fn emitLinkedCall(&project: LinkedNullProject, state: LinkedNullState, &call: Node, id: int, depth: int): LinkedNullExpression! {
    target = LinkedNullNode(project, 1, LinkedNullChild(project, 1, call, 0))
    if (target.kind == "Field" && target.text == "clone" && target.edge_count == 1 && call.edge_count == 1) {
        return emitLinkedClone(project, state, target, id, depth)
    }
    if (target.kind == "Field" && target.text == "len" && target.edge_count == 1 && call.edge_count == 1) {
        return LowerLinkedNullRead(project, state, id, depth)
    }
    if (target.kind == "Variable" && target.edge_count == 0) {
        local = FindLinkedLocalRead(state.local_readers, target.text)
        if (local != 0) {
            if (call.edge_count != 2 || LinkedNullBinding(state.slots, target.text) != 0) {
                RejectLayout("linked_local_reader_call", "expected a direct local reader call with one int argument", DeclarationSpan(call))?
            }
            read = state.local_readers[local - 1].clone()
            argument = LowerLinkedNullValue(project, state, LinkedNullChild(project, 1, call, 1), depth + 1)?
            return CloneLinkedLocalArrayItem(project, read, argument, call, id)
        }
    }
    if (IsLinkedIntConversion(project, state, target, call.edge_count - 1)) {
        input = LowerLinkedNullValue(project, state, LinkedNullChild(project, 1, call, 1), depth + 1)?
        return LowerLinkedIntString(project, input, call, id)
    }
    callee = ResolveLinkedCall(project, state.slots, call, target, false)?
    arguments = LowerLinkedArguments(project, state, call, callee, id, depth)?
    output = AddLinkedNullSlot(project, arguments.state, "", "t" + str(id), callee.result, false)?
    output.state.code = output.state.code + "    " + output.value.text.clone() + " = " + LinkedDirectCallExpression(callee, arguments.args) + ";\n" + arguments.handoff
    output.state.slots[output.value.slot - 1].live = true
    return ok(output)
}

fn emitCheckedCallback(&project: LinkedNullProject, state: LinkedNullState, &call: Node,
                       slot: int, id: int, depth: int): LinkedCheckedCall! {
    if (!state.slots[slot - 1].parameter || !state.slots[slot - 1].live || call.edge_count != 3) {
        RejectLayout("linked_callback_call", "expected a live checked callback parameter with two int arguments", DeclarationSpan(call))?
    }
    callback = state.slots[slot - 1].value.clone()
    payload = callback.ty
    payload.declaration_kind = "Struct"
    next = state
    args = ""
    index = 1
    while (index < 3) {
        argument = LowerLinkedNullValue(project, next, LinkedNullChild(project, 1, call, index), depth + 1)?
        if (!LinkedIntResult(argument.value.ty)) {
            RejectLayout("linked_callback_argument", "checked callback arguments must be Copy int values", argument.value.ty.span.clone())?
        }
        name = "callback_arg" + str(id) + "_" + str(index)
        next = argument.state
        // Materialize the first int before evaluating the second expression.
        next.code += "    int64_t " + name.clone() + " = " + argument.value.text + ";\n"
        if (index > 1) { args += ", " }
        args += name
        index += 1
    }
    result = "dependency" + str(id)
    carrier = LinkedCheckedResultCType(payload)?
    next = AppendLinkedCheckedInvocation(next, carrier, result, CheckedLinkedCallbackExpression(carrier, callback.text, args), "")
    return ok(LinkedCheckedCall { state: next, result: payload, text: result, id: id })
}

fn emitCheckedCall(&project: LinkedNullProject, state: LinkedNullState, &unwrap: Node, owns_value: bool, depth: int): LinkedCheckedCall! {
    if (state.plain_value_result && state.catch_slot == 0) {
        RejectLayout("linked_value_failure", "a checked call needs a catch before returning a plain value", DeclarationSpan(unwrap))?
    }
    if (unwrap.kind != "TryUnwrap" || unwrap.edge_count != 1) {
        RejectLayout("unsupported_linked_try", "expected a direct checked call followed by ?", DeclarationSpan(unwrap))?
    }
    id = LinkedNullChild(project, 1, unwrap, 0)
    call = LinkedNullNode(project, 1, id)
    if (call.kind != "Call" || call.edge_count == 0) {
        RejectLayout("unsupported_linked_try", "expected a direct checked dependency call", DeclarationSpan(call))?
    }
    target = LinkedNullNode(project, 1, LinkedNullChild(project, 1, call, 0))
    if (target.kind == "Variable" && target.edge_count == 0) {
        slot = LinkedNullBinding(state.slots, target.text)
        if (slot != 0 && state.slots[slot - 1].value.ty.declaration_kind == "IntPairResultCallback") {
            return emitCheckedCallback(project, state, call, slot, id, depth)
        }
    }
    callee = ResolveLinkedCall(project, state.slots, call, target, true)?
    if (owns_value && !LinkedNullHasResultValue(callee.result)) {
        RejectLayout("linked_dependency_result", "expected a Result with a value payload", DeclarationSpan(unwrap))?
    }
    arguments = LowerLinkedArguments(project, state, call, callee, id, depth)?
    result = "dependency" + str(id)
    carrier = LinkedNullResultType(callee)?
    symbol = LinkedNullCallSymbol(callee)
    args = arguments.args
    handoff = arguments.handoff
    next = AppendLinkedCheckedInvocation(arguments.state, carrier, result, symbol + "(" + args + ")", handoff)
    return ok(LinkedCheckedCall { state: next, result: callee.result, text: result, id: id })
}

fn validateLinkedPayload(state: LinkedNullState, &result: TypeNameBinding, &payload: str): LinkedNullState {
    next = state
    prefix = "ku_linked_view_str_array"
    if (LinkedNullOwnedArray(result)) {
        prefix = LinkedNullArrayPrefix(result)
    } else if (result.declaration_kind != "OwnedStringArray") { return next }
    next = RequireLinkedArrayValidation(next, result.clone())
    next.code += "    if (!" + prefix + "_valid(&" + payload.clone() + ") || (uintmax_t)"
        + payload.clone() + ".len > (uintmax_t)INT64_MAX) { invalid_array = true; goto cleanup; }\n"
    return next
}

fn LowerLinkedNullTry(&project: LinkedNullProject, state: LinkedNullState, &statement: Node): LinkedNullState! {
    unwrap = LinkedNullNode(project, 1, LinkedNullChild(project, 1, statement, 0))
    call = emitCheckedCall(project, state, unwrap, false, 0)?
    if (!LinkedNullHasResultValue(call.result)) { return ok(call.state) }
    payload = call.text + ".value"
    next = RegisterLinkedNullType(project, call.state, call.result.clone())?
    next = validateLinkedPayload(next, call.result, payload)
    drop = LinkedNullDropC(next.layouts, next.owning_layouts, call.result, payload)
    next.owning_strings = next.owning_strings || drop.contains("ku_projection_string_drop")
    next.code += drop
    return ok(next)
}

fn emitCheckedValue(&project: LinkedNullProject, state: LinkedNullState, &unwrap: Node, depth: int): LinkedNullExpression! {
    call = emitCheckedCall(project, state, unwrap, true, depth)?
    slot = AddLinkedNullSlot(project, call.state, "", "t" + str(call.id), call.result, false)?
    payload = call.text + ".value"
    ty = slot.value.ty.clone()
    slot.state = validateLinkedPayload(slot.state, ty, payload)
    slot.state.code = slot.state.code + "    " + slot.value.text.clone() + " = " + payload.clone() + ";\n"
        + "    " + payload + " = (" + LinkedNullCType(slot.value.ty)? + "){0};\n"
    slot.state.slots[slot.value.slot - 1].live = true
    return ok(slot)
}

fn AppendLinkedArrayElement(state: LinkedNullState, &array: LinkedNullValue, &value: LinkedNullValue): LinkedNullState {
    next = RequireLinkedArrayValidation(state, array.ty.clone())
    if (!ContainsIndex(next.append_slots, array.slot)) { next.append_slots = next.append_slots.push(array.slot) }
    if (LinkedNullIntArrayOwner(array.ty)) {
        next.code += EmitLinkedIntAppend(array.text, value.text)
        return next
    }
    prefix = LinkedNullArrayPrefix(array.ty)
    next.code += "    append_status = " + prefix + "_append_move(&" + array.text.clone()
        + ", &" + value.text.clone() + ");\n    if (append_status != KU_STRUCT_ARRAY_OK) goto cleanup;\n"
    // The C helper clears the element only after transfer. Cleanup keeps
    // ownership of the separate element and the initialized array prefix.
    next.slots[value.slot - 1].live = false
    return next
}

fn lowerLinkedFieldValue(&project: LinkedNullProject, state: LinkedNullState, &target: TypeNameBinding, id: int, depth: int): LinkedNullExpression! {
    record = target.declaration_kind == "StructArray"
    integer = target.declaration_kind == "BuiltinArray" && target.name == "int"
    if (depth >= 32 || (!record && !integer)) {
        return LowerLinkedNullValue(project, state, id, depth)
    }
    literal = LinkedNullNode(project, 1, id)
    if (literal.kind != "Array" || (integer && literal.edge_count != 0)) {
        return LowerLinkedNullValue(project, state, id, depth)
    }
    ty = target.clone()
    ty.declaration_kind = "OwnedIntArray"
    if (record) { ty.declaration_kind = "OwnedStructArray" }
    output = AddLinkedNullSlot(project, state, "", "t" + str(id), ty.clone(), false)?
    array = output.value
    next = output.state
    next.slots[array.slot - 1].live = true
    expected = LinkedNullArrayElement(ty)
    index = 0
    while (index < literal.edge_count) {
        value = LowerLinkedNullValue(project, next, LinkedNullChild(project, 1, literal, index), depth + 1)?
        element = value.value
        if (!SameLinkedType(element.ty, expected) || element.borrowed || element.slot == 0 || element.member_path != "") {
            RejectLayout("linked_record_array_literal", "expected a separate owner of the declared record element", element.ty.span.clone())?
        }
        next = AppendLinkedArrayElement(value.state, array, element)
        index = index + 1
    }
    return ok(LinkedNullExpression { state: next, value: array })
}

fn lowerLinkedLiteral(&project: LinkedNullProject, state: LinkedNullState, &node: Node, id: int, depth: int): LinkedNullExpression! {
    ty = LinkedNullLiteralType(project, 1, node, id)?
    output = AddLinkedNullSlot(project, state, "", "t" + str(id), ty, false)?
    layout = LayoutIndex(output.state.layouts, output.value.ty.module_index, output.value.ty.declaration_node)
    fields = output.state.layouts[layout - 1].fields.clone()
    target = output.value.text.clone()
    next = output.state
    seen: [int] = []
    index = 0
    while (index < node.edge_count) {
        field = LinkedNullNode(project, 1, LinkedNullChild(project, 1, node, index))
        ordinal = FieldIndex(fields, field.text)
        if (field.kind != "StructLiteralField" || field.edge_count != 1 || ordinal == 0 || ContainsIndex(seen, ordinal)) {
            RejectLayout("invalid_linked_literal_field", "expected each declared struct field once", DeclarationSpan(field))?
        }
        value = lowerLinkedFieldValue(project, next.clone(), fields[ordinal - 1].resolved, LinkedNullChild(project, 1, field, 0), depth + 1)?
        if (!MatchesLinkedFieldValue(fields[ordinal - 1].resolved, value.value.ty)) {
            RejectLayout("linked_literal_field_type", "field value differs from the bound struct field type", value.value.ty.span.clone())?
        }
        value.state.code = value.state.code + "    " + target.clone() + ".f" + str(ordinal - 1) + " = " + value.value.text.clone() + ";\n"
        owner = value.value.clone()
        next = MoveLinkedNullSlot(value.state, owner)?
        seen = seen.push(ordinal)
        index = index + 1
    }
    if (seen.len() != fields.len()) {
        RejectLayout("missing_linked_literal_field", "expected all declared struct fields", DeclarationSpan(node))?
    }
    next.slots[output.value.slot - 1].live = true
    return ok(LinkedNullExpression { state: next, value: output.value })
}

fn LowerLinkedNullValue(&project: LinkedNullProject, state: LinkedNullState, id: int, depth: int): LinkedNullExpression! {
    node = LinkedNullNode(project, 1, id)
    at = DeclarationSpan(node)
    if (depth >= 32) {
        RejectLayout("linked_expression_depth", "linked null! expressions allow at most 32 levels", at.clone())?
    }
    if (node.kind == "Call" && node.edge_count > 0) { return emitLinkedCall(project, state, node, id, depth) }
    if (node.kind == "TryUnwrap") { return emitCheckedValue(project, state, node, depth) }
    if (node.kind == "StructLiteral") { return lowerLinkedLiteral(project, state, node, id, depth) }
    if (node.kind == "Array" && node.edge_count > 0) { return LowerLinkedIntArrayLiteral(project, state, node, id, "") }
    if (node.kind == "Binary" && node.text == "+" && node.edge_count == 2) {
        left = LowerLinkedNullValue(project, state, LinkedNullChild(project, 1, node, 0), depth + 1)?
        rhs = LinkedNullChild(project, 1, node, 1)
        if (left.value.ty.name != "str" || (left.value.borrowed && left.value.slot == 0)) {
            right = LowerLinkedNullRead(project, left.state, rhs, depth + 1)?
            value = right.value
            return EmitLinkedAddition(project, right.state, left.value, value, id, at)
        }
        before = ""
        if (left.value.slot > 0) {
            before = left.state.code
            left.state.code = ""
        }
        right = LowerLinkedNullValue(project, left.state, rhs, depth + 1)?
        value = right.value
        if (left.value.slot == 0) { return EmitLinkedAddition(project, right.state, left.value, value, id, at) }
        kept = RestoreLinkedConcatPrefix(project, right.state, left.value, before, id)?
        previous = kept.value
        return EmitLinkedAddition(project, kept.state, previous, value, id, at)
    }
    if (node.kind == "Binary" || node.kind == "Index" || node.kind == "Field") {
        return LowerLinkedNullRead(project, state, id, depth)
    }
    return LowerLinkedNullLeaf(state, node)
}
