import { Node } from "../stage2/ast.ku"
import { TypeNameBinding } from "./type_names.ku"
import { DeclarationSpan } from "./names.ku"
import { FieldIndex, LayoutIndex, RejectLayout } from "./struct_layouts.ku"
import { ContainsIndex } from "./struct_projection_c.ku"
import { GuardOwnedDrops } from "./guarded_struct_c.ku"
import { LinkedNullArrayElement, LinkedNullArrayPrefix, LinkedNullCType, LinkedNullChild, LinkedNullDependency, LinkedNullFunction, LinkedNullHasResultValue, LinkedNullLiteralType,
         LinkedNullNode, LinkedNullOwnedArray, LinkedNullOwner, LinkedNullProject, LinkedNullResultType, LinkedNullView, SameLinkedType } from "./linked_null_types_c.ku"
import { AddLinkedNullSlot, LinkedNullBinding, LinkedNullExpression, LinkedNullState, LinkedNullValue, LowerLinkedNullLeaf,
         LowerLinkedNullRead, MoveLinkedNullSlot, ReadLinkedNullBinding, RequireLinkedArrayValidation } from "./linked_null_read_c.ku"

struct LinkedNullArguments {
    state: LinkedNullState
    args: str
    handoff: str
}

fn rememberLinkedCall(calls: [LinkedNullFunction], dependency: LinkedNullFunction): [LinkedNullFunction] {
    result = calls
    for old in result {
        if (old.unit == dependency.unit && old.node == dependency.node) { return result }
    }
    return result.push(dependency)
}

fn cloneLinkedString(&project: LinkedNullProject, source: LinkedNullExpression, id: int): LinkedNullExpression! {
    ty = source.value.ty.clone()
    output = AddLinkedNullSlot(project, source.state, "", "t" + str(id), ty, false)?
    output.state.code = output.state.code + "    if (!ku_linked_clone_string(" + source.value.text + ", &" + output.value.text.clone()
        + ")) { out_of_memory = true; goto cleanup; }\n"
    output.state.uses_clone = true
    output.state.slots[output.value.slot - 1].live = true
    return ok(output)
}

fn emitLinkedClone(&project: LinkedNullProject, state: LinkedNullState, &target: Node, id: int, depth: int): LinkedNullExpression! {
    subject_id = LinkedNullChild(project, 1, target, 0)
    subject = LinkedNullNode(project, 1, subject_id)
    if (subject.kind == "Index") {
        source = LowerLinkedNullRead(project, state, subject_id, depth + 1)?
        if (source.value.ty.declaration_kind == "Builtin" && source.value.ty.name == "str") {
            return cloneLinkedString(project, source, id)
        }
        ty = source.value.ty.clone()
        if (LayoutIndex(source.state.owning_layouts, ty.module_index, ty.declaration_node) != 0) {
            RejectLayout("linked_nested_array_clone", "an element with nested owning arrays does not yet support clone", ty.span.clone())?
        }
        layout = LayoutIndex(source.state.layouts, ty.module_index, ty.declaration_node)
        output = AddLinkedNullSlot(project, source.state, "", "t" + str(id), ty, false)?
        if (GuardOwnedDrops(output.state.layouts, layout, source.value.text) == "") {
            output.state.code = output.state.code + "    " + output.value.text.clone() + " = " + source.value.text + ";\n"
        } else {
            if (!ContainsIndex(output.state.element_clones, layout)) {
                output.state.element_clones = output.state.element_clones.push(layout)
            }
            output.state.code = output.state.code + "    if (!ku_linked_element_" + str(layout) + "_clone_element(&"
                + source.value.text + ", &" + output.value.text.clone() + ")) { out_of_memory = true; goto cleanup; }\n"
        }
        output.state.slots[output.value.slot - 1].live = true
        return ok(output)
    }
    if (subject.kind != "Variable" || subject.edge_count != 0) {
        RejectLayout("unsupported_linked_clone", "expected a bound str variable for clone", DeclarationSpan(subject))?
    }
    source = ReadLinkedNullBinding(state, subject)?
    if (source.value.ty.declaration_kind != "Builtin" || source.value.ty.name != "str") {
        RejectLayout("unsupported_linked_clone", "only str.clone is in this checked subset", DeclarationSpan(subject))?
    }
    return cloneLinkedString(project, source, id)
}

fn resolveLinkedCall(&project: LinkedNullProject, &state: LinkedNullState, &call: Node, &target: Node, checked: bool): LinkedNullFunction! {
    if (LinkedNullBinding(state.slots, target.text) != 0) {
        RejectLayout("shadowed_linked_dependency", "direct dependency name is shadowed by a local", DeclarationSpan(target))?
    }
    callee = LinkedNullDependency(project, 1, target, checked)?
    if (callee.parameters.len() != call.edge_count - 1) {
        RejectLayout("linked_dependency_arity", "argument count differs from the bound function declaration", DeclarationSpan(call))?
    }
    return ok(callee)
}

fn linkedViewArgument(&parameter: TypeNameBinding, &value: LinkedNullValue): str! {
    if (parameter.declaration_kind == "StringView" && value.ty.declaration_kind == "Builtin" && value.ty.name == "str"
        && (!value.borrowed || value.slot > 0)) {
        return ok("&(" + value.text.clone() + ")")
    }
    if (SameLinkedType(parameter, value.ty)) { return ok(value.text.clone()) }
    if (parameter.declaration_kind == "StructArray" && LinkedNullOwnedArray(value.ty)
        && SameLinkedType(LinkedNullArrayElement(parameter.clone()), LinkedNullArrayElement(value.ty.clone()))) {
        return ok("&(" + value.text.clone() + ")")
    }
    RejectLayout("linked_argument_type", "expected a matching stable source for the View argument", value.ty.span.clone())?
    return ok("")
}

fn lowerLinkedArguments(&project: LinkedNullProject, state: LinkedNullState, &call: Node, &callee: LinkedNullFunction,
                         id: int, depth: int): LinkedNullArguments! {
    next = state
    next.links = rememberLinkedCall(next.links, callee.clone())
    args = ""
    handoff = ""
    loans: [int] = []
    index = 0
    while (index < callee.parameters.len()) {
        argument = LowerLinkedNullValue(project, next.clone(), LinkedNullChild(project, 1, call, index + 1), depth + 1)?
        if (args != "") { args += ", " }
        if (LinkedNullView(callee.parameters[index])) {
            args += linkedViewArgument(callee.parameters[index], argument.value)?
            if (argument.value.slot > 0) { loans = loans.push(argument.value.slot) }
            next = argument.state
            index = index + 1
            continue
        }
        if (!SameLinkedType(callee.parameters[index], argument.value.ty)) {
            RejectLayout("linked_argument_type", "argument type differs from the bound function parameter", argument.value.ty.span.clone())?
        }
        // Pending argument slots own their values until the actual call. A
        // later argument can fail while computing a nested call or a clone.
        ty = argument.value.ty.clone()
        pending = AddLinkedNullSlot(project, argument.state, "", "p" + str(id) + "_" + str(index), ty, false)?
        pending.state.code = pending.state.code + "    " + pending.value.text.clone() + " = " + argument.value.text.clone() + ";\n"
        next = MoveLinkedNullSlot(pending.state, argument.value)?
        args += pending.value.text.clone()
        if (LinkedNullOwner(pending.value.ty)) {
            handoff += "    " + pending.value.text + " = (" + LinkedNullCType(pending.value.ty)? + "){0};\n"
        }
        index = index + 1
    }
    // Evaluating a later argument may move an earlier lent binding. The
    // final direct call cannot outlive a moved source, including nested calls.
    for loan in loans {
        if (!next.slots[loan - 1].live) {
            RejectLayout("linked_view_move", "a later argument consumes an earlier View source", DeclarationSpan(call))?
        }
    }
    return ok(LinkedNullArguments { state: next, args: args, handoff: handoff })
}

fn emitLinkedCall(&project: LinkedNullProject, state: LinkedNullState, &call: Node, id: int, depth: int): LinkedNullExpression! {
    target = LinkedNullNode(project, 1, LinkedNullChild(project, 1, call, 0))
    if (target.kind == "Field" && target.text == "clone" && target.edge_count == 1 && call.edge_count == 1) {
        return emitLinkedClone(project, state, target, id, depth)
    }
    if (target.kind == "Field" && target.text == "len" && target.edge_count == 1 && call.edge_count == 1) {
        return LowerLinkedNullRead(project, state, id, depth)
    }
    callee = resolveLinkedCall(project, state, call, target, false)?
    arguments = lowerLinkedArguments(project, state, call, callee, id, depth)?
    output = AddLinkedNullSlot(project, arguments.state, "", "t" + str(id), callee.result, false)?
    output.state.code = output.state.code + "    " + output.value.text.clone() + " = " + callee.symbol + "(" + arguments.args + ");\n" + arguments.handoff
    output.state.slots[output.value.slot - 1].live = true
    return ok(output)
}

struct LinkedCheckedCall {
    state: LinkedNullState
    result: TypeNameBinding
    text: str
    id: int
}

fn emitCheckedCall(&project: LinkedNullProject, state: LinkedNullState, &unwrap: Node, owns_value: bool, depth: int): LinkedCheckedCall! {
    if (unwrap.kind != "TryUnwrap" || unwrap.edge_count != 1) {
        RejectLayout("unsupported_linked_try", "expected a direct checked call followed by ?", DeclarationSpan(unwrap))?
    }
    id = LinkedNullChild(project, 1, unwrap, 0)
    call = LinkedNullNode(project, 1, id)
    if (call.kind != "Call" || call.edge_count == 0) {
        RejectLayout("unsupported_linked_try", "expected a direct checked dependency call", DeclarationSpan(call))?
    }
    target = LinkedNullNode(project, 1, LinkedNullChild(project, 1, call, 0))
    callee = resolveLinkedCall(project, state, call, target, true)?
    if (LinkedNullHasResultValue(callee.result) != owns_value) {
        RejectLayout("linked_dependency_result", "expected an owning Result for a local, or null! for a statement", DeclarationSpan(unwrap))?
    }
    arguments = lowerLinkedArguments(project, state, call, callee, id, depth)?
    result = "dependency" + str(id)
    // The callee owns the arguments at this point. An error skips subsequent
    // statements and transfers its strings before the caller's cleanup.
    arguments.state.code = arguments.state.code + "    " + LinkedNullResultType(callee)? + " " + result.clone() + " = " + callee.symbol
        + "(" + arguments.args + ");\n" + arguments.handoff
        + "    if (!" + result.clone() + ".ok) {\n        result.error = " + result.clone() + ".error;\n"
        + "        " + result.clone() + ".error = (KuBootstrapError){0};\n        goto cleanup;\n    }\n"
    return ok(LinkedCheckedCall { state: arguments.state, result: callee.result, text: result, id: id })
}

fn LowerLinkedNullTry(&project: LinkedNullProject, state: LinkedNullState, &statement: Node): LinkedNullState! {
    unwrap = LinkedNullNode(project, 1, LinkedNullChild(project, 1, statement, 0))
    call = emitCheckedCall(project, state, unwrap, false, 0)?
    return ok(call.state)
}

fn emitCheckedValue(&project: LinkedNullProject, state: LinkedNullState, &unwrap: Node, depth: int): LinkedNullExpression! {
    call = emitCheckedCall(project, state, unwrap, true, depth)?
    slot = AddLinkedNullSlot(project, call.state, "", "t" + str(call.id), call.result, false)?
    payload = call.text + ".value"
    if (LinkedNullOwnedArray(slot.value.ty)) {
        ty = slot.value.ty.clone()
        slot.state = RequireLinkedArrayValidation(slot.state, ty)
        prefix = LinkedNullArrayPrefix(slot.value.ty)
        slot.state.code = slot.state.code + "    if (!" + prefix + "_valid(&" + payload.clone() + ") || (uintmax_t)"
            + payload.clone() + ".len > (uintmax_t)INT64_MAX) { invalid_array = true; goto cleanup; }\n"
    }
    slot.state.code = slot.state.code + "    " + slot.value.text.clone() + " = " + payload.clone() + ";\n"
        + "    " + payload + " = (" + LinkedNullCType(slot.value.ty)? + "){0};\n"
    slot.state.slots[slot.value.slot - 1].live = true
    return ok(slot)
}

fn lowerLinkedLiteral(&project: LinkedNullProject, state: LinkedNullState, &node: Node, id: int, depth: int): LinkedNullExpression! {
    ty = LinkedNullLiteralType(project, 1, node, id)?
    output = AddLinkedNullSlot(project, state, "", "t" + str(id), ty, false)?
    layout = LayoutIndex(output.state.layouts, output.value.ty.module_index, output.value.ty.declaration_node)
    fields = output.state.layouts[layout - 1].fields.clone()
    target = output.value.text.clone()
    next = output.state
    seen: [int] = []
    index = 0
    while (index < node.edge_count) {
        field = LinkedNullNode(project, 1, LinkedNullChild(project, 1, node, index))
        ordinal = FieldIndex(fields, field.text)
        if (field.kind != "StructLiteralField" || field.edge_count != 1 || ordinal == 0 || ContainsIndex(seen, ordinal)) {
            RejectLayout("invalid_linked_literal_field", "expected each declared struct field once", DeclarationSpan(field))?
        }
        value = LowerLinkedNullValue(project, next.clone(), LinkedNullChild(project, 1, field, 0), depth + 1)?
        if (!SameLinkedType(fields[ordinal - 1].resolved, value.value.ty)) {
            RejectLayout("linked_literal_field_type", "field value differs from the bound struct field type", value.value.ty.span.clone())?
        }
        value.state.code = value.state.code + "    " + target.clone() + ".f" + str(ordinal - 1) + " = " + value.value.text.clone() + ";\n"
        owner = value.value.clone()
        next = MoveLinkedNullSlot(value.state, owner)?
        seen = seen.push(ordinal)
        index = index + 1
    }
    if (seen.len() != fields.len()) {
        RejectLayout("missing_linked_literal_field", "expected all declared struct fields", DeclarationSpan(node))?
    }
    next.slots[output.value.slot - 1].live = true
    return ok(LinkedNullExpression { state: next, value: output.value })
}

fn LowerLinkedNullValue(&project: LinkedNullProject, state: LinkedNullState, id: int, depth: int): LinkedNullExpression! {
    node = LinkedNullNode(project, 1, id)
    at = DeclarationSpan(node)
    if (depth >= 32) {
        RejectLayout("linked_expression_depth", "linked null! expressions allow at most 32 levels", at.clone())?
    }
    if (node.kind == "Call" && node.edge_count > 0) { return emitLinkedCall(project, state, node, id, depth) }
    if (node.kind == "TryUnwrap") { return emitCheckedValue(project, state, node, depth) }
    if (node.kind == "StructLiteral") { return lowerLinkedLiteral(project, state, node, id, depth) }
    if (node.kind == "Binary" || node.kind == "Index" || node.kind == "Field") {
        return LowerLinkedNullRead(project, state, id, depth)
    }
    return LowerLinkedNullLeaf(state, node)
}

fn unshadowedOk(&project: LinkedNullProject, &state: LinkedNullState): bool {
    if (LinkedNullBinding(state.slots, "ok") != 0) { return false }
    for name in project.supplied[0].named.names.declarations.clone() {
        if (name.name == "ok") { return false }
    }
    for binding in project.binding.modules[0].imports.clone() {
        if (binding.local_name == "ok") { return false }
    }
    return true
}

fn LowerLinkedSuccess(&project: LinkedNullProject, state: LinkedNullState, &statement: Node, &result: TypeNameBinding): LinkedNullState! {
    if (statement.edge_count != 1) {
        RejectLayout("unsupported_linked_success", "expected return ok(null)", DeclarationSpan(statement))?
    }
    call = LinkedNullNode(project, 1, LinkedNullChild(project, 1, statement, 0))
    if (call.kind != "Call" || call.edge_count < 1) {
        RejectLayout("unsupported_linked_success", "expected return ok or a bound Result call", DeclarationSpan(call))?
    }
    callee = LinkedNullNode(project, 1, LinkedNullChild(project, 1, call, 0))
    if (callee.kind == "Variable" && callee.edge_count == 0 && callee.text != "ok") {
        target = resolveLinkedCall(project, state, call, callee, true)?
        if (!SameLinkedType(target.result, result)) {
            RejectLayout("linked_tail_result", "forwarded Result must match the entry's declared payload", DeclarationSpan(call))?
        }
        call_id = LinkedNullChild(project, 1, statement, 0)
        arguments = lowerLinkedArguments(project, state, call, target, call_id, 0)?
        arguments.state.code = arguments.state.code + "    result = " + target.symbol + "(" + arguments.args
            + ");\n" + arguments.handoff + "    goto cleanup;\n"
        return ok(arguments.state)
    }
    if (call.edge_count != 2 || callee.kind != "Variable" || callee.edge_count != 0 || callee.text != "ok" || !unshadowedOk(project, state)) {
        RejectLayout("unsupported_linked_success", "expected builtin ok with the declared payload", DeclarationSpan(call))?
    }
    id = LinkedNullChild(project, 1, call, 1)
    node = LinkedNullNode(project, 1, id)
    next = state
    if (LinkedNullHasResultValue(result)) {
        value = LowerLinkedNullValue(project, next, id, 0)?
        if (!SameLinkedType(value.value.ty, result) || value.value.borrowed || value.value.slot == 0) {
            RejectLayout("linked_result_return", "return requires an initialized matching owner", DeclarationSpan(node))?
        }
        value.state.code = value.state.code + "    result.value = " + value.value.text.clone() + ";\n"
        owner = value.value.clone()
        next = MoveLinkedNullSlot(value.state, owner)?
    } else if (node.kind != "Null" || node.edge_count != 0) {
        RejectLayout("unsupported_linked_success", "expected builtin ok with literal null", DeclarationSpan(call))?
    }
    next.code = next.code + "    result.ok = true;\n    goto cleanup;\n"
    return ok(next)
}

fn LowerLinkedArrayAppend(&project: LinkedNullProject, state: LinkedNullState, &statement: Node, index: int): LinkedNullState! {
    array = state.slots[index - 1].clone()
    call = LinkedNullNode(project, 1, LinkedNullChild(project, 1, statement, 0))
    if (!array.live || !LinkedNullOwnedArray(array.value.ty) || call.kind != "Call" || call.edge_count != 2) {
        RejectLayout("linked_move_append", "expected an initialized array assigned its own push result", DeclarationSpan(statement))?
    }
    method = LinkedNullNode(project, 1, LinkedNullChild(project, 1, call, 0))
    if (method.kind != "Field" || method.text != "push" || method.edge_count != 1) {
        RejectLayout("linked_move_append", "expected an initialized array assigned its own push result", DeclarationSpan(method))?
    }
    receiver = LinkedNullNode(project, 1, LinkedNullChild(project, 1, method, 0))
    if (receiver.kind != "Variable" || receiver.edge_count != 0 || receiver.text != statement.text) {
        RejectLayout("linked_move_append", "push must return to its array owner", DeclarationSpan(receiver))?
    }
    // Lowering the append value cannot move the active array that receives it.
    id = LinkedNullChild(project, 1, call, 1)
    value = LowerLinkedNullValue(project, state, id, 0)?
    if (!value.state.slots[index - 1].live || !SameLinkedType(value.value.ty, LinkedNullArrayElement(array.value.ty.clone()))
        || value.value.borrowed || value.value.slot == 0) {
        RejectLayout("linked_move_append", "push requires one independent owned element of the declared type", value.value.ty.span.clone())?
    }
    if (!ContainsIndex(value.state.append_slots, index)) { value.state.append_slots = value.state.append_slots.push(index) }
    value.state = RequireLinkedArrayValidation(value.state, array.value.ty.clone())
    prefix = LinkedNullArrayPrefix(array.value.ty)
    value.state.code = value.state.code + "    append_status = " + prefix + "_append_move(&" + array.value.text
        + ", &" + value.value.text.clone() + ");\n    if (append_status != KU_STRUCT_ARRAY_OK) goto cleanup;\n"
    // The C helper zeros this slot only after transfer. On failure, the
    // original slot still owns its complete element for the cleanup label.
    value.state.slots[value.value.slot - 1].live = false
    return ok(value.state)
}
