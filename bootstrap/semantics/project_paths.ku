import { json, string } from "std"
import { Span } from "../stage2/span.ku"
import { RejectName } from "./names.ku"

fn ProjectParent(&path: str): str! {
    characters = string.chars(path.clone())
    end = characters.len()
    while (end > 0 && characters[end - 1] != "/") { end = end - 1 }
    if (end == 0) { return ok("") }
    return string.slice(path.clone(), 0, end - 1)
}

fn AppendProjectComponent(path: str, component: str, at: Span): str! {
    if (component == "") {
        RejectName("project_path", "project paths require nonempty '/'-separated components", at.clone())?
    }
    if (component == ".") { return ok(path) }
    if (component == "..") {
        if (path == "") { RejectName("project_path", "relative path leaves the project root", at)? }
        return ProjectParent(path)
    }
    if (path == "") { return ok(component) }
    return ok(path + "/" + component)
}

fn NormalizeProjectPath(parent: str, &path: str, at: Span): str! {
    if (path.byte_len() == 0 || path.byte_len() > 512 || !path.ends_with(".ku")) {
        RejectName("project_path", "project paths must name a .ku file within 512 UTF-8 bytes", at.clone())?
    }
    result = parent
    component = ""
    zero = ProjectPathNul()?
    for character in string.chars(path.clone()) {
        if (character == "/") {
            result = AppendProjectComponent(result, component, at.clone())?
            component = ""
        } else {
            if (character == "\\" || character == ":" || character == "\n" || character == "\r" || character == "\t" || character == zero) {
                RejectName("project_path", "invalid character in project path", at.clone())?
            }
            component = component + character
        }
    }
    resolved = AppendProjectComponent(result, component, at.clone())?
    if (resolved.byte_len() > 512) { RejectName("project_path", "resolved project path exceeds 512 UTF-8 bytes", at)? }
    return ok(resolved)
}

// Keep the original checked JSON conversion behind an owned str Result.
fn ProjectPathNul(): str! {
    decoded_zero = json.parse("\"\\u0000\"")?
    return decoded_zero.as_str()
}

fn CheckProjectManifestPath(&path: str, at: Span): null! {
    if (NormalizeProjectPath("", path, at.clone())? != path) {
        RejectName("project_path", "manifest paths must be normalized and relative to the project", at)?
    }
    return ok(null)
}

fn ProjectImportFile(&requested: str): str {
    length = 0
    leading_dot = false
    suffix_dot = false
    for character in string.chars(requested.clone()) {
        if (character == "/") {
            length = 0
            leading_dot = false
            suffix_dot = false
        } else {
            if (length == 0) {
                leading_dot = character == "."
            } else if (character == ".") {
                suffix_dot = true
            }
            length = length + 1
        }
    }
    // A leading dot belongs to the basename. A later dot supplies an
    // explicit extension, including an empty or unsupported suffix.
    if (length == 0 || (length == 1 && leading_dot) || suffix_dot) {
        return requested.clone()
    }
    return requested.clone() + ".ku"
}

fn ResolveProjectImport(&importer: str, &requested: str, at: Span): str! {
    if (requested.byte_len() > 512) { return NormalizeProjectPath("", requested, at) }
    file = ProjectImportFile(requested)
    return NormalizeProjectPath(ProjectParent(importer)?, file, at)
}

// Kept as a checked JSON literal so the standalone bootstrap literal
// provider and the ordinary interpreter decode the same C0 characters.
fn LinkPlanJsonControls(): str! {
    decoded = json.parse("\"\\u0000\\u0001\\u0002\\u0003\\u0004\\u0005\\u0006\\u0007\\u0008\\u0009\\u000a\\u000b\\u000c\\u000d\\u000e\\u000f\\u0010\\u0011\\u0012\\u0013\\u0014\\u0015\\u0016\\u0017\\u0018\\u0019\\u001a\\u001b\\u001c\\u001d\\u001e\\u001f\"")?
    return decoded.as_str()
}

fn linkPlanJsonCharacter(character: str, &controls: str): str! {
    if (character == "\"") { return ok("\\\"") }
    if (character == "\\") { return ok("\\\\") }
    if (character == "\n") { return ok("\\n") }
    if (character == "\r") { return ok("\\r") }
    if (character == "\t") { return ok("\\t") }
    if (!controls.contains(character)) { return ok(character) }
    code = 0
    index = 0
    for control in string.chars(controls.clone()) {
        if (control == character) { code = index }
        index = index + 1
    }
    high = "0"
    low = code
    if (code >= 16) {
        high = "1"
        low = code - 16
    }
    digit = string.slice("0123456789abcdef", low, low + 1)?
    return ok("\\u00" + high + digit)
}

fn linkPlanJsonBody(value: str, &controls: str): str! {
    // Keep each repeated append bounded. Divide at Unicode scalar
    // coordinates to preserve UTF-8 even when a character spans bytes.
    if (value.byte_len() > 512) {
        length = value.len()
        middle = length / 2
        left = string.slice(value.clone(), 0, middle)?
        right = string.slice(value, middle, length)?
        prefix = linkPlanJsonBody(left, controls)?
        suffix = linkPlanJsonBody(right, controls)?
        if (prefix.byte_len() + suffix.byte_len() > 999998) {
            fail { domain: "json", code: "stringify_error", message: "json.stringify output is too large" }
        }
        return ok(prefix + suffix)
    }
    escaped = ""
    for character in string.chars(value) {
        escaped += linkPlanJsonCharacter(character, controls)?
    }
    return ok(escaped)
}

fn LinkPlanJsonText(value: str, &controls: str): str! {
    if (value.byte_len() > 999998) {
        fail { domain: "json", code: "stringify_error", message: "json.stringify output is too large" }
    }
    if (!value.contains("\"") && !value.contains("\\")) {
        needs_escape = false
        for control in string.chars(controls.clone()) {
            if (value.contains(control)) { needs_escape = true }
        }
        if (!needs_escape) { return ok("\"" + value + "\"") }
    }
    body = linkPlanJsonBody(value, controls)?
    return ok("\"" + body + "\"")
}
