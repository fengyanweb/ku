import { Span } from "../stage2/span.ku"
import { SuppliedModule } from "./imports.ku"
import { DeclarationSpan } from "./names.ku"
import { ProjectBindings } from "./project_bindings.ku"
import { IsBuiltinType, TypeNameBinding } from "./type_names.ku"
import { CollectOwningFields, LayoutIndex, RejectLayout, StructFieldLayout, StructLayout } from "./struct_layouts.ku"
import { ContainsIndex, ContainsType, CTypeName, EmitLayout, EmitOwningLayout, ProjectionArrayHeader, ProjectionHeaders, StringField, StructArrayTypeName } from "./struct_projection_c.ku"

struct CStructMetrics {
    layout_index: int
    depth: int
    leaves: int
    contains_string: bool
}

struct CStructOrder {
    entries: [CStructMetrics]
    contains_string: bool
}

fn dependencyIndex(&layouts: [StructLayout], &field: TypeNameBinding): int! {
    index = LayoutIndex(layouts, field.module_index, field.declaration_node)
    if (index == 0 || field.module_index < 0 || field.declaration_node <= 0) {
        RejectLayout("missing_nested_layout", "no bound struct layout for '" + field.name.clone() + "'", field.span.clone())?
    }
    return ok(index)
}

fn isLayoutDependency(&field: TypeNameBinding, owning: bool): bool {
    return field.declaration_kind == "Struct" || (owning && field.declaration_kind == "StructArray")
}

fn reachableLayouts(&layouts: [StructLayout], root: int, owning: bool): [int]! {
    reachable = [root]
    index = 0
    while (index < reachable.len()) {
        item = reachable[index] - 1
        field_index = 0
        while (field_index < layouts[item].fields.len()) {
            field = layouts[item].fields[field_index].resolved.clone()
            if (isLayoutDependency(field, owning)) {
                child = dependencyIndex(layouts, field)?
                if (!ContainsIndex(reachable, child)) { reachable = reachable.push(child) }
            } else if ((field.declaration_kind != "Builtin" || !IsBuiltinType(field.name)) &&
                       !(owning && field.declaration_kind == "BuiltinArray" && (field.name == "int" || field.name == "str"))) {
                RejectLayout("unsupported_nested_layout", "no C field layout for '" + field.name.clone() + "'", field.span)?
            }
            field_index = field_index + 1
        }
        index = index + 1
    }
    return ok(reachable)
}

fn metricIndex(&entries: [CStructMetrics], layout_index: int): int {
    index = 0
    while (index < entries.len()) {
        if (entries[index].layout_index == layout_index) { return index + 1 }
        index = index + 1
    }
    return 0
}

fn measureLayout(&layouts: [StructLayout], &entries: [CStructMetrics], index: int, owning: bool): CStructMetrics! {
    depth = 1
    leaves = 0
    contains_string = false
    field_index = 0
    while (field_index < layouts[index - 1].fields.len()) {
        field = layouts[index - 1].fields[field_index].resolved.clone()
        field_leaves = 1
        if (isLayoutDependency(field, owning)) {
            child = dependencyIndex(layouts, field)?
            completed = metricIndex(entries, child)
            if (completed == 0) {
                return ok(CStructMetrics { layout_index: index, depth: 0, leaves: 0, contains_string: false })
            }
            metric = entries[completed - 1].clone()
            if (metric.depth >= 8) {
                RejectLayout("nested_layout_depth", "C struct layouts accept at most 8 levels", field.span.clone())?
            }
            if (metric.depth + 1 > depth) { depth = metric.depth + 1 }
            if (field.declaration_kind == "Struct") { field_leaves = metric.leaves }
            contains_string = contains_string || metric.contains_string
        } else if (field.name == "str") {
            contains_string = true
        }
        if (field_leaves > 64 - leaves) {
            RejectLayout("nested_layout_fields", "C struct layouts accept at most 64 expanded fields", field.span.clone())?
        }
        leaves = leaves + field_leaves
        field_index = field_index + 1
    }
    // The C representation needs one byte even for an empty struct.
    if (leaves == 0) { leaves = 1 }
    return ok(CStructMetrics { layout_index: index, depth: depth, leaves: leaves, contains_string: contains_string })
}

fn rejectLayoutCycle(&layouts: [StructLayout], &completed: [CStructMetrics], first: int, at: Span, owning: bool): null! {
    // Each unfinished layout depends on another unfinished layout. Follow
    // these edges until one repeats to report an actual cycle edge.
    path: [int] = []
    index = first
    while (path.len() < layouts.len()) {
        path = path.push(index)
        next = 0
        cursor = 0
        while (next == 0 && cursor < layouts[index - 1].fields.len()) {
            field = layouts[index - 1].fields[cursor].resolved.clone()
            if (isLayoutDependency(field, owning)) {
                child = dependencyIndex(layouts, field)?
                if (metricIndex(completed, child) == 0) {
                    if (ContainsIndex(path, child)) {
                        name = layouts[index - 1].fields[cursor].name.clone()
                        if (owning) { RejectLayout("recursive_owned_layout", "recursive owning field '" + name.clone() + "'", field.span.clone())? }
                        RejectLayout("recursive_nested_layout", "recursive by-value struct field '" + name + "'", field.span)?
                    }
                    next = child
                }
            }
            cursor = cursor + 1
        }
        if (next == 0) {
            RejectLayout("invalid_nested_layout_order", "unfinished layout has no dependency", at.clone())?
        }
        index = next
    }
    RejectLayout("invalid_nested_layout_order", "unfinished layout has no bounded order", at)?
    return ok(null)
}

// Order only a selected layout and its by-value dependencies. Identity comes
// from binding (module ordinal and declaration node), never a C identifier
// made from a user-written type name.
fn orderCLayouts(&layouts: [StructLayout], module_index: int, node: int, at: Span, owning: bool): CStructOrder! {
    root = LayoutIndex(layouts, module_index, node)
    if (root == 0 || module_index < 0 || node <= 0) {
        RejectLayout("missing_nested_layout", "expected a bound root struct layout", at.clone())?
    }
    reachable = reachableLayouts(layouts, root, owning)?
    entries: [CStructMetrics] = []
    contains_string = false
    while (entries.len() < reachable.len()) {
        before = entries.len()
        blocked = 0
        index = 0
        while (index < reachable.len()) {
            item = reachable[index]
            if (metricIndex(entries, item) == 0) {
                metrics = measureLayout(layouts, entries, item, owning)?
                if (metrics.depth != 0) {
                    contains_string = contains_string || metrics.contains_string
                    entries = entries.push(metrics)
                } else if (blocked == 0) {
                    blocked = item
                }
            }
            index = index + 1
        }
        if (entries.len() == before) {
            rejectLayoutCycle(layouts, entries, blocked, at.clone(), owning)?
        }
    }
    return ok(CStructOrder { entries: entries, contains_string: contains_string })
}

fn OrderCStructLayouts(&layouts: [StructLayout], module_index: int, node: int, at: Span): CStructOrder! {
    return orderCLayouts(layouts, module_index, node, at, false)
}

fn EmitNestedCLayouts(&layouts: [StructLayout], &order: CStructOrder): str! {
    return ok(ProjectionHeaders(order.contains_string, false) + EmitOrderedStructLayouts(layouts, order)?)
}

fn EmitOrderedStructLayouts(&layouts: [StructLayout], &order: CStructOrder): str! {
    text = ""
    index = 0
    while (index < order.entries.len()) {
        layout_index = order.entries[index].layout_index
        text += EmitLayout(layouts[layout_index - 1], true, true)?
        index = index + 1
    }
    return ok(text)
}

fn collectProjectLayout(&supplied: [SuppliedModule], &project: ProjectBindings, unit: int, id: int,
                        at: Span, layouts: [StructLayout], depth: int): [StructLayout]! {
    if (LayoutIndex(layouts, unit, id) != 0) { return ok(layouts) }
    if (unit <= 0 || unit > supplied.len() || unit > project.modules.len() || id <= 0 ||
        id > supplied[unit - 1].named.parsed.arena.nodes.len() ||
        supplied[unit - 1].path != project.modules[unit - 1].path) {
        RejectLayout("invalid_layout_binding", "invalid bound declaration for owning C layout", at.clone())?
    }
    if (depth >= 8) {
        RejectLayout("nested_layout_depth", "C struct layouts accept at most 8 levels", at)?
    }
    node = supplied[unit - 1].named.parsed.arena.nodes[id - 1].clone()
    if (node.kind != "Struct") {
        RejectLayout("invalid_layout_binding", "owning layout root must be a bound struct", DeclarationSpan(node))?
    }
    fields = CollectOwningFields(supplied[unit - 1].named.parsed.arena.nodes, supplied[unit - 1].named.parsed.arena.edges,
                                 project.modules[unit - 1].types, node)?
    relocated: [StructFieldLayout] = []
    for field in fields {
        member = field
        if (member.resolved.module_index == 0 && isLayoutDependency(member.resolved, true)) {
            member.resolved.module_index = unit
        }
        relocated = relocated.push(member)
    }
    layout_index = layouts.len()
    result = layouts.push(StructLayout { name: node.text, module_index: unit, node: id, fields: relocated })
    cursor = 0
    while (cursor < result[layout_index].fields.len()) {
        field = result[layout_index].fields[cursor].resolved.clone()
        if (isLayoutDependency(field, true)) {
            result = collectProjectLayout(supplied, project, field.module_index, field.declaration_node,
                                          field.span, result, depth + 1)?
        }
        cursor = cursor + 1
    }
    return ok(result)
}

fn BuildProjectOwningLayouts(&supplied: [SuppliedModule], &project: ProjectBindings,
                             unit: int, declaration: int, at: Span): [StructLayout]! {
    layouts: [StructLayout] = []
    return collectProjectLayout(supplied, project, unit, declaration, at, layouts, 0)
}

fn OrderProjectOwningLayouts(&layouts: [StructLayout], unit: int, declaration: int, at: Span): CStructOrder! {
    return orderCLayouts(layouts, unit, declaration, at, true)
}

fn OwningLayoutDropName(module_index: int, declaration: int): str {
    return "ku_drop_" + CTypeName(module_index, declaration)
}

fn emitOwningLayoutDrop(&layout: StructLayout, public: bool): str {
    storage = "static "
    if (public) { storage = "" }
    type_name = CTypeName(layout.module_index, layout.node)
    text = storage + "void " + OwningLayoutDropName(layout.module_index, layout.node) + "(" + type_name.clone() + " *value) {\n"
    cursor = layout.fields.len()
    has_field = cursor > 0
    while (has_field) {
        cursor = cursor - 1
        field = layout.fields[cursor].resolved.clone()
        target = "value->f" + str(cursor)
        if (StringField(field)) {
            text += "    ku_projection_string_drop(&" + target + ");\n"
        } else if (field.declaration_kind == "Struct") {
            text += "    " + OwningLayoutDropName(field.module_index, field.declaration_node) + "(&" + target + ");\n"
        } else if (field.declaration_kind == "StructArray" || field.declaration_kind == "BuiltinArray") {
            if (field.declaration_kind == "StructArray") {
                child_drop = OwningLayoutDropName(field.module_index, field.declaration_node)
                text += "    for (size_t i = " + target.clone() + ".len; i != 0; --i) " +
                    child_drop + "(&" + target.clone() + ".data[i - 1]);\n"
            } else if (field.name == "str") {
                text += "    for (size_t i = " + target.clone() + ".len; i != 0; --i) " +
                    "ku_projection_string_drop(&" + target.clone() + ".data[i - 1]);\n"
            }
            text += "    free(" + target + ".data);\n"
        }
        has_field = cursor > 0
    }
    return text + "    *value = (" + type_name + "){0};\n}\n\n"
}

struct OwningLayoutDefinitions {
    source: str
    array_types: [str]
}

// Emit validated layouts in dependency order. Hosted call sites leave the
// individual member drops private inside their translation unit.
fn EmitOwningLayoutDefinitions(&ordered: [StructLayout], unit: int, declaration: int): OwningLayoutDefinitions! {
    text = ""
    arrays: [str] = []
    layout_index = 0
    while (layout_index < ordered.len()) {
        field_count = ordered[layout_index].fields.len()
        field_index = 0
        while (field_index < field_count) {
            field = ordered[layout_index].fields[field_index].resolved.clone()
            array = ""
            element = ""
            if (field.declaration_kind == "StructArray") {
                array = StructArrayTypeName(field)
                element = CTypeName(field.module_index, field.declaration_node)
            } else if (field.declaration_kind == "BuiltinArray") {
                if (field.name == "str") {
                    array = "KuGuardStringArray"
                    element = "KuProjectionString"
                } else {
                    array = "KuArrayInt"
                    element = "int64_t"
                }
            }
            if (array != "" && !ContainsType(arrays, array)) {
                text += ProjectionArrayHeader(element, array)
                arrays = arrays.push(array)
            }
            field_index = field_index + 1
        }
        text += EmitOwningLayout(ordered[layout_index])?
        text += emitOwningLayoutDrop(ordered[layout_index],
            ordered[layout_index].module_index == unit && ordered[layout_index].node == declaration)
        layout_index = layout_index + 1
    }
    return ok(OwningLayoutDefinitions { source: text, array_types: arrays })
}

// Every complete field and live array element owns its storage. Zeroed fields
// and array headers are safe after an interrupted construction. Array len
// identifies the initialized prefix; capacity can include unused elements.
fn EmitProjectOwningLayoutsC(&layouts: [StructLayout], unit: int, declaration: int, at: Span): str! {
    order = OrderProjectOwningLayouts(layouts, unit, declaration, at)?
    text = ProjectionHeaders(order.contains_string, order.contains_string)
    if (!order.contains_string) { text += "#include <stddef.h>\n#include <stdlib.h>\n" }
    ordered: [StructLayout] = []
    for entry in order.entries { ordered = ordered.push(layouts[entry.layout_index - 1].clone()) }
    definitions = EmitOwningLayoutDefinitions(ordered, unit, declaration)?
    return ok(text + definitions.source)
}

fn EmitCombinedCLayouts(&layouts: [StructLayout], &owning: [StructLayout]): OwningLayoutDefinitions! {
    definitions = EmitOwningLayoutDefinitions(owning, 0, 0)?
    index = 0
    while (index < layouts.len()) {
        existing = LayoutIndex(owning, layouts[index].module_index, layouts[index].node)
        if (existing == 0) {
            definitions.source += EmitLayout(layouts[index], true, true)?
        }
        index = index + 1
    }
    return ok(definitions)
}
