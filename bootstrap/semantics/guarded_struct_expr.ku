import { Node } from "../stage2/ast.ku"
import { DeclarationSpan } from "./names.ku"
import { ScalarStringLiteral } from "./scalar_int_operands.ku"
import { CTypeName } from "./struct_projection_c.ku"
import { ExplicitType, FieldIndex, LayoutIndex, RejectLayout, StructLayout } from "./struct_layouts.ku"
import { TypeNameBinding } from "./type_names.ku"

struct GuardType {
    // An aggregate uses a one-based index in the bound layout table.
    kind: str
    layout: int
}

struct GuardBinding {
    name: str
    ty: GuardType
    slot: int
    parameter: bool
    view: bool
}

struct GuardValue {
    ty: GuardType
    setup: str
    value: str
    view: bool
    uses_add: bool
    uses_sub: bool
    uses_eq: bool
}

struct GuardLeaf {
    name: str
    symbol: str
    result_kind: str
    parameters: [str]
}

fn GuardBindingIndex(&bindings: [GuardBinding], &name: str): int {
    index = 0
    while (index < bindings.len()) {
        if (bindings[index].name == name) { return index + 1 }
        index = index + 1
    }
    return 0
}

fn GuardBindingName(&binding: GuardBinding): str {
    if (binding.parameter) { return "a" + str(binding.slot) }
    return "l" + str(binding.slot)
}

fn GuardCType(&ty: GuardType, &layouts: [StructLayout]): str {
    if (ty.kind == "bool") { return "bool" }
    if (ty.kind == "str") { return "KuProjectionString" }
    if (ty.kind == "str_array") { return "KuGuardStringArray" }
    if (ty.kind == "struct" || ty.kind == "array") {
        layout = CTypeName(layouts[ty.layout - 1].module_index, layouts[ty.layout - 1].node)
        if (ty.kind == "array") { return "KuArray_" + layout }
        return layout
    }
    return "int64_t"
}

fn GuardBoundType(&type_name: TypeNameBinding, &layouts: [StructLayout]): GuardType! {
    if (type_name.declaration_kind == "Builtin" &&
        (type_name.name == "int" || type_name.name == "bool" || type_name.name == "str")) {
        return ok(GuardType { kind: type_name.name.clone(), layout: 0 })
    }
    if (type_name.declaration_kind == "Struct") {
        index = LayoutIndex(layouts, type_name.module_index, type_name.declaration_node)
        if (index > 0) { return ok(GuardType { kind: "struct", layout: index }) }
    }
    RejectLayout("unsupported_guarded_type", "no guarded C representation for '" + type_name.name.clone() + "'", type_name.span.clone())?
    return ok(GuardType { kind: "", layout: 0 })
}

fn GuardExplicitType(&types: [TypeNameBinding], &nodes: [Node], &layouts: [StructLayout], type_node: int): GuardType! {
    bound = ExplicitType(types, type_node, DeclarationSpan(nodes[type_node - 1]))?
    return GuardBoundType(bound, layouts)
}

fn GuardRead(ty: GuardType, value: str, view: bool): GuardValue {
    return GuardValue { ty: ty, setup: "", value: value, view: view, uses_add: false, uses_sub: false, uses_eq: false }
}

fn emptyGuardValue(): GuardValue {
    return GuardRead(GuardType { kind: "", layout: 0 }, "", false)
}

fn guardField(&layouts: [StructLayout], &base: GuardValue, &node: Node): GuardValue! {
    if (base.ty.kind != "struct") {
        RejectLayout("unsupported_guarded_field", "expected a bound struct field receiver", DeclarationSpan(node))?
    }
    ordinal = FieldIndex(layouts[base.ty.layout - 1].fields, node.text)
    if (ordinal == 0) {
        RejectLayout("unknown_guarded_field", "unknown field '" + node.text.clone() + "'", DeclarationSpan(node))?
    }
    ty = GuardBoundType(layouts[base.ty.layout - 1].fields[ordinal - 1].resolved, layouts)?
    access = ".f"
    if (base.view) { access = "->f" }
    return ok(GuardRead(ty, base.value.clone() + access + str(ordinal - 1), false))
}

fn guardInteger(&left: GuardValue, &right: GuardValue, &node: Node, id: int, &indent: str): GuardValue! {
    if (left.ty.kind != "int" || right.ty.kind != "int") {
        RejectLayout("guarded_operand_type", "checked arithmetic requires int operands", DeclarationSpan(node))?
    }
    add = node.text == "+"
    operation = "sub"
    if (add) { operation = "add" }
    if (node.text == "*") { operation = "mul" }
    output = "t" + str(id)
    setup = left.setup.clone() + right.setup.clone() + indent.clone() + "int64_t " + output.clone() + ";\n"
    setup += indent.clone() + "if (!ku_guard_try_" + operation + "(" + left.value.clone() + ", " + right.value.clone() + ", &" + output.clone() + ")) { overflow = true; goto cleanup; }\n"
    return ok(GuardValue { ty: GuardType { kind: "int", layout: 0 }, setup: setup, value: output, view: false,
        uses_add: left.uses_add || right.uses_add || add, uses_sub: left.uses_sub || right.uses_sub || operation == "sub",
        uses_eq: left.uses_eq || right.uses_eq })
}

fn guardBoolean(&left: GuardValue, &right: GuardValue, &node: Node, id: int, &indent: str): GuardValue! {
    logical = node.text == "&&" || node.text == "||"
    equality = node.text == "==" || node.text == "!="
    if (equality && left.ty.kind == "str" && right.ty.kind == "str") {
        prefix = ""
        if (node.text == "!=") { prefix = "!" }
        value = prefix + "ku_guard_string_equal(" + left.value.clone() + ", " + right.value.clone() + ")"
        return ok(GuardValue { ty: GuardType { kind: "bool", layout: 0 }, setup: left.setup.clone() + right.setup.clone(),
            value: value, view: false, uses_add: left.uses_add || right.uses_add,
            uses_sub: left.uses_sub || right.uses_sub, uses_eq: true })
    }
    if (logical) {
        if (left.ty.kind != "bool" || right.ty.kind != "bool") {
            RejectLayout("guarded_operand_type", "short circuit requires bool operands", DeclarationSpan(node))?
        }
    } else if (!(left.ty.kind == "int" && right.ty.kind == "int") &&
        !(equality && left.ty.kind == "bool" && right.ty.kind == "bool")) {
        RejectLayout("guarded_operand_type", "comparison requires int operands or matching bool equality", DeclarationSpan(node))?
    }
    setup = left.setup.clone()
    value = "(" + left.value.clone() + " " + node.text.clone() + " " + right.value.clone() + ")"
    if (logical && right.setup != "") {
        value = "t" + str(id)
        condition = value.clone()
        if (node.text == "||") { condition = "!" + condition }
        setup += indent.clone() + "bool " + value.clone() + " = " + left.value.clone() + ";\n"
        setup += indent.clone() + "if (" + condition + ") {\n" + right.setup.clone()
        setup += indent.clone() + "    " + value.clone() + " = " + right.value.clone() + ";\n" + indent.clone() + "}\n"
    } else {
        setup += right.setup.clone()
    }
    return ok(GuardValue { ty: GuardType { kind: "bool", layout: 0 }, setup: setup, value: value, view: false,
        uses_add: left.uses_add || right.uses_add, uses_sub: left.uses_sub || right.uses_sub,
        uses_eq: left.uses_eq || right.uses_eq })
}

fn GuardCloneSource(&nodes: [Node], &edges: [int], id: int): int {
    call = nodes[id - 1].clone()
    if (call.kind != "Call" || call.edge_count != 1) { return 0 }
    member = nodes[edges[call.first_edge] - 1].clone()
    if (member.kind != "Field" || member.text != "clone" || member.edge_count != 1) { return 0 }
    return edges[member.first_edge]
}

fn guardStringArrayCompare(&nodes: [Node], &edges: [int], &bindings: [GuardBinding], &layouts: [StructLayout],
                          &node: Node, id: int, depth: int, &indent: str): GuardValue! {
    left = edges[node.first_edge]
    right = edges[node.first_edge + 1]
    literal = nodes[right - 1].clone()
    input = left
    if (literal.kind != "String") {
        literal = nodes[left - 1].clone()
        input = right
    }
    indexed_id = GuardCloneSource(nodes, edges, input)
    if (indexed_id == 0 || literal.kind != "String" || literal.edge_count != 0) {
        return ok(emptyGuardValue())
    }
    indexed = nodes[indexed_id - 1].clone()
    if (indexed.kind != "Index" || indexed.edge_count != 2) { return ok(emptyGuardValue()) }
    // Count the clone call, its member and the indexed expression as well.
    array = GuardExpression(nodes, edges, bindings, layouts, edges[indexed.first_edge], depth + 4, indent)?
    if (array.ty.kind != "str_array" || !array.view || array.setup != "") {
        RejectLayout("guarded_string_array", "indexed string comparisons require a declared View [str]", DeclarationSpan(indexed))?
    }
    index = GuardExpression(nodes, edges, bindings, layouts, edges[indexed.first_edge + 1], depth + 4, indent)?
    if (index.ty.kind != "int") {
        RejectLayout("guarded_string_array_index", "the string array index must be an int", DeclarationSpan(indexed))?
    }
    out = "array_match" + str(id)
    setup = index.setup + indent.clone() + "bool " + out.clone() + ";\n"
    setup += indent.clone() + "if (!ku_guard_string_array_equal(" + array.value + ", " + index.value +
        ", (KuProjectionString){(uint8_t*)" + ScalarStringLiteral(literal)? + ", 0u, KU_PROJECTION_STRING_STATIC}, &" +
        out.clone() + ", &array_failure)) goto cleanup;\n"
    if (node.text == "!=") { out = "(!" + out + ")" }
    return ok(GuardValue { ty: GuardType { kind: "bool", layout: 0 }, setup: setup, value: out, view: false,
        uses_add: index.uses_add, uses_sub: index.uses_sub, uses_eq: index.uses_eq })
}

fn cloneLeafString(&nodes: [Node], &edges: [int], &bindings: [GuardBinding], &layouts: [StructLayout],
                   &node: Node, id: int, depth: int, &indent: str): GuardValue! {
    subject = GuardCloneSource(nodes, edges, edges[node.first_edge + 1])
    if (subject == 0 || depth + 3 >= 32) {
        RejectLayout("guarded_owned_argument", "a checked leaf takes an explicit clone of a live str", DeclarationSpan(node))?
    }
    source = nodes[subject - 1].clone()
    temp = "argument" + str(id)
    result = GuardRead(GuardType { kind: "str", layout: 0 }, temp.clone(), false)
    declare = indent.clone() + "KuProjectionString " + temp.clone() + " = {0};\n"
    if (source.kind == "Index" && source.edge_count == 2) {
        base = GuardExpression(nodes, edges, bindings, layouts, edges[source.first_edge], depth + 4, indent)?
        index = GuardExpression(nodes, edges, bindings, layouts, edges[source.first_edge + 1], depth + 4, indent)?
        if (base.ty.kind != "str_array" || !base.view || base.setup != "" || index.ty.kind != "int") {
            RejectLayout("guarded_owned_argument", "a checked leaf requires an indexed View [str] and an int index", DeclarationSpan(source))?
        }
        result.setup = index.setup + declare + indent.clone() + "if (!ku_guard_string_array_clone_at(" + base.value + ", " +
            index.value + ", &" + temp + ", &array_failure)) goto cleanup;\n"
        result.uses_add = index.uses_add
        result.uses_sub = index.uses_sub
        result.uses_eq = index.uses_eq
        return ok(result)
    }
    found = GuardBindingIndex(bindings, source.text)
    if (source.kind != "Variable" || found == 0 || bindings[found - 1].ty.kind != "str" || bindings[found - 1].view) {
        RejectLayout("guarded_owned_argument", "a checked leaf requires a bound str owner", DeclarationSpan(source))?
    }
    result.setup = declare + indent.clone() + "if (!ku_result_clone_string(" + GuardBindingName(bindings[found - 1]) + ", &" + temp +
        ")) { out_of_memory = true; goto cleanup; }\n"
    return ok(result)
}

fn guardLeafCall(&nodes: [Node], &edges: [int], &bindings: [GuardBinding], &layouts: [StructLayout], &leaves: [GuardLeaf],
                 &node: Node, id: int, depth: int, &indent: str): GuardValue! {
    empty = emptyGuardValue()
    if (node.edge_count == 0 || leaves.len() == 0) { return ok(empty) }
    target = nodes[edges[node.first_edge] - 1].clone()
    if (target.kind != "Variable" || target.edge_count != 0 || GuardBindingIndex(bindings, target.text) != 0) { return ok(empty) }
    position = 0
    while (position < leaves.len()) {
        leaf = leaves[position].clone()
        if (leaf.name == target.text) {
            if (node.edge_count != leaf.parameters.len() + 1) {
                RejectLayout("guarded_leaf_arity", "argument count must match the checked leaf", DeclarationSpan(node))?
            }
            value = empty.clone()
            if (leaf.parameters.len() == 1 && leaf.parameters[0] == "str") {
                value = cloneLeafString(nodes, edges, bindings, layouts, node, id, depth, indent)?
            } else {
                // For this branch each operand is a side-effect-free binding read.
                args = ""
                index = 0
                while (index < leaf.parameters.len()) {
                    arg = nodes[edges[node.first_edge + index + 1] - 1].clone()
                    found = GuardBindingIndex(bindings, arg.text)
                    kind = leaf.parameters[index].clone()
                    if (arg.kind != "Variable" || found == 0 || bindings[found - 1].ty.kind != kind ||
                        bindings[found - 1].view != (kind == "str_array")) {
                        RejectLayout("guarded_leaf_argument", "expected a matching Copy binding or View [str]", DeclarationSpan(arg))?
                    }
                    if (index > 0) { args += ", " }
                    args += GuardBindingName(bindings[found - 1])
                    index = index + 1
                }
                value.value = args
            }
            temp = "t" + str(id)
            ty = GuardType { kind: leaf.result_kind, layout: 0 }
            value.setup = value.setup + indent.clone() + GuardCType(ty, layouts) + " " + temp.clone() + " = " + leaf.symbol + "(" + value.value + ");\n"
            value.value = temp
            value.ty = ty
            return ok(value)
        }
        position = position + 1
    }
    return ok(empty)
}

fn GuardExpression(&nodes: [Node], &edges: [int], &bindings: [GuardBinding], &layouts: [StructLayout],
                   id: int, depth: int, &indent: str): GuardValue! {
    return GuardOwnedExpression(nodes, edges, bindings, layouts, id, depth, indent, false, [])
}

fn GuardOwnedExpression(&nodes: [Node], &edges: [int], &bindings: [GuardBinding], &layouts: [StructLayout],
                         id: int, depth: int, &indent: str, checked_mul: bool, &leaves: [GuardLeaf]): GuardValue! {
    node = nodes[id - 1].clone()
    if (depth >= 32) {
        RejectLayout("guarded_expression_limit", "guarded C accepts at most 32 expression levels", DeclarationSpan(node))?
    }
    if (node.kind == "Int" && node.edge_count == 0 && node.int_value >= 0) {
        return ok(GuardRead(GuardType { kind: "int", layout: 0 }, "INT64_C(" + str(node.int_value) + ")", false))
    }
    if (node.kind == "Bool" && node.edge_count == 0 && (node.text == "true" || node.text == "false")) {
        return ok(GuardRead(GuardType { kind: "bool", layout: 0 }, node.text, false))
    }
    if (node.kind == "String" && node.edge_count == 0) {
        value = "((KuProjectionString){ (uint8_t*)" + ScalarStringLiteral(node)? + ", 0u, KU_PROJECTION_STRING_STATIC })"
        return ok(GuardRead(GuardType { kind: "str", layout: 0 }, value, false))
    }
    if (node.kind == "Variable" && node.edge_count == 0) {
        found = GuardBindingIndex(bindings, node.text)
        if (found == 0) {
            RejectLayout("undefined_guarded_binding", "no initialized local '" + node.text.clone() + "'", DeclarationSpan(node))?
        }
        return ok(GuardRead(bindings[found - 1].ty.clone(), GuardBindingName(bindings[found - 1]), bindings[found - 1].view))
    }
    if (node.kind == "Field" && node.edge_count == 1) {
        base = GuardOwnedExpression(nodes, edges, bindings, layouts, edges[node.first_edge], depth + 1, indent, checked_mul, leaves)?
        return guardField(layouts, base, node)
    }
    if (node.kind == "Call" && node.edge_count == 1) {
        method = nodes[edges[node.first_edge] - 1].clone()
        if (method.kind == "Field" && method.text == "len" && method.edge_count == 1) {
            receiver = GuardOwnedExpression(nodes, edges, bindings, layouts, edges[method.first_edge], depth + 1, indent, checked_mul, leaves)?
            if (receiver.ty.kind == "array") {
                access = ".len"
                if (receiver.view) { access = "->len" }
                return ok(GuardRead(GuardType { kind: "int", layout: 0 }, "((int64_t)" + receiver.value + access + ")", false))
            }
        }
    }
    if (node.kind == "Call") {
        linked = guardLeafCall(nodes, edges, bindings, layouts, leaves, node, id, depth, indent)?
        if (linked.ty.kind != "") { return ok(linked) }
    }
    if (node.kind == "Unary" && node.edge_count == 1) {
        operand = GuardOwnedExpression(nodes, edges, bindings, layouts, edges[node.first_edge], depth + 1, indent, checked_mul, leaves)?
        if (node.text == "!" && operand.ty.kind == "bool") {
            operand.value = "(!" + operand.value + ")"
            return ok(operand)
        }
        if (node.text == "-") {
            zero = GuardRead(GuardType { kind: "int", layout: 0 }, "INT64_C(0)", false)
            return guardInteger(zero, operand, node, id, indent)
        }
    }
    if (node.kind == "Binary" && node.edge_count == 2) {
        if (node.text == "==" || node.text == "!=") {
            comparison = guardStringArrayCompare(nodes, edges, bindings, layouts, node, id, depth, indent)?
            if (comparison.ty.kind == "bool") { return ok(comparison) }
        }
        left = GuardOwnedExpression(nodes, edges, bindings, layouts, edges[node.first_edge], depth + 1, indent, checked_mul, leaves)?
        right_indent = indent.clone()
        if (node.text == "&&" || node.text == "||") { right_indent += "    " }
        right = GuardOwnedExpression(nodes, edges, bindings, layouts, edges[node.first_edge + 1], depth + 1, right_indent, checked_mul, leaves)?
        if (node.text == "+" || node.text == "-" || (checked_mul && node.text == "*")) { return guardInteger(left, right, node, id, indent) }
        if (node.text == "&&" || node.text == "||" || node.text == "==" || node.text == "!=" ||
            node.text == "<" || node.text == "<=" || node.text == ">" || node.text == ">=") {
            return guardBoolean(left, right, node, id, indent)
        }
    }
    RejectLayout("unsupported_guarded_operand", "expected a bound scalar, field read or supported scalar expression", DeclarationSpan(node))?
    return ok(emptyGuardValue())
}
