import { Span } from "../stage2/span.ku"
import { BindProjectModules } from "./project_bindings.ku"
import { DeclarationSpan } from "./names.ku"
import { LinkedNullParameters, ReadLinkedNullParametersFrom } from "./linked_parameters_c.ku"
import { RejectLayout } from "./struct_layouts.ku"
import { TypeNameBinding } from "./type_names.ku"
import { EmitLinkedNullPrototypes } from "./scalar_project_c.ku"
import { FinishLinkedFunctionC } from "./guarded_struct_c.ku"
import { ManagedSourceCharactersErrors } from "./guarded_string_parts.ku"
import { LinkedOptionalReaderHeader } from "./linked_nullable_reader_c.ku"
import { Node } from "../stage2/ast.ku"
import { SuppliedModule } from "./imports.ku"
import { BuiltinLinkPlanType, LinkedNullC, LinkedNullState, LinkPlanDeclaration, LinkPlanNominalType, LinkPlanType, NewLinkedNullState } from "./link_plan_c.ku"
import { CallbackPlanNominals, EmitLinkPlan, EmitLinkedBodyPrelude, LinkedNullDependencyPlan } from "./link_plan_json_c.ku"
import { LowerLinkedRegion } from "./linked_null_c.ku"
import { LinkedBuiltin, LinkedNullChild, LinkedNullNode, LinkedNullProject, LinkedNullType, LinkedStringResult, LinkedCheckedResultCType, LinkedNullCType, LinkedNullResultCleanupReference, LinkedResultPlan } from "./linked_null_types_c.ku"
import { RequireProjectionLocalFunction } from "./struct_projection_c.ku"
import { EmitStaticJsonString } from "./scalar_int_emit.ku"
import { ReadStaticAsciiJsonString } from "./scalar_int_operands.ku"
import { LayoutIndex, StructLayout } from "./struct_layouts.ku"
import { BoundArrayTypePosition, UnitEnumTypeName } from "./type_names.ku"

fn EmitLinkedUnit(supplied: [SuppliedModule], &function: str, plan: bool): str! {
    project = PrepareLinkedNullProject(supplied)?
    node = RequireProjectionLocalFunction(project.supplied, function)?
    literal_id = linkedJsonLiteral(project, LinkedNullNode(project, 1, node))?
    if (literal_id != 0) {
        literal = LinkedNullNode(project, 1, literal_id)
        decoded = ReadStaticAsciiJsonString(literal.text)?
        if (decoded.accepted) {
            symbol = "ku_linked_null_" + str(node)
            if (!plan) { return ok(EmitStaticJsonString(symbol, decoded.literal, decoded.length, decoded.escaped)) }
            entry = LinkPlanDeclaration { unit: 1, node: node, symbol: symbol, parameters: [],
                result: BuiltinLinkPlanType("str", "KuBootstrapResult_KuProjectionString", false), returns_result: true }
            no_dependencies: [LinkPlanDeclaration] = []
            return EmitLinkPlan(project.supplied, "linked-null", entry, no_dependencies)
        }
    }
    generated = EmitLinkedNullC(project, function)?
    if (!plan) {
        source = generated.source
        return ok(source)
    }

    links: [LinkPlanDeclaration] = []
    dependencies = generated.links
    layouts = generated.layouts
    count = dependencies.len()
    index = 0
    while (index < count) {
        links = links.push(prepareLinkedPlan(project, LinkedNullDependencyPlan(dependencies[index])?, layouts)?)
        index = index + 1
    }
    entry = prepareLinkedPlan(project, generated.entry_plan, layouts)?
    return EmitLinkPlan(project.supplied, "linked-null", entry, links)
}

fn linkedRecordPlanType(ty: LinkPlanType, &layouts: [StructLayout]): LinkPlanType {
    next = ty
    if (next.kind != "Struct") { return next }
    layout = LayoutIndex(layouts, next.unit, next.node)
    if (layout == 0) { return next }
    field_count = layouts[layout - 1].fields.len()
    index = 0
    while (index < field_count) {
        if (layouts[layout - 1].fields[index].resolved.declaration_kind == "UnitEnum") {
            member = layouts[layout - 1].fields[index].resolved.clone()
            next.nominals = next.nominals.push(LinkPlanNominalType { field: index + 1,
                unit: member.module_index, node: member.declaration_node, c_type: UnitEnumTypeName(member) })
        }
        index = index + 1
    }
    return next
}

fn prepareLinkedPlan(&project: LinkedNullProject, declaration: LinkPlanDeclaration, &layouts: [StructLayout]): LinkPlanDeclaration! {
    parameters: [LinkPlanType] = []
    count = declaration.parameters.len()
    index = 0
    while (index < count) {
        nominals = CallbackPlanNominals(project, declaration.parameters[index])?
        ty = LinkPlanType {
            kind: declaration.parameters[index].kind.clone(),
            name: declaration.parameters[index].name.clone(),
            unit: declaration.parameters[index].unit,
            node: declaration.parameters[index].node,
            c_type: declaration.parameters[index].c_type.clone(),
            view: declaration.parameters[index].view,
            nominals: nominals
        }
        parameters = parameters.push(linkedRecordPlanType(ty, layouts))
        index = index + 1
    }
    return ok(LinkPlanDeclaration { unit: declaration.unit, node: declaration.node, symbol: declaration.symbol,
        parameters: parameters, result: linkedRecordPlanType(declaration.result, layouts), returns_result: declaration.returns_result })
}

fn linkedMethodReceiver(&project: LinkedNullProject, &call: Node, &method: str, arguments: int): int {
    if (call.kind != "Call" || call.edge_count != arguments + 1) { return 0 }
    target = LinkedNullNode(project, 1, LinkedNullChild(project, 1, call, 0))
    if (target.kind != "Field" || target.edge_count != 1 || target.text != method) { return 0 }
    id = LinkedNullChild(project, 1, target, 0)
    receiver = LinkedNullNode(project, 1, id)
    if (receiver.kind != "Variable" || receiver.edge_count != 0) { return 0 }
    return id
}

fn linkedJsonLiteral(&project: LinkedNullProject, &function: Node): int! {
    if (function.kind != "Function" || function.edge_count != 3) { return ok(0) }
    result = LinkedNullNode(project, 1, LinkedNullChild(project, 1, function, 0))
    if (result.kind != "TypeResult" || result.edge_count != 1) { return ok(0) }
    binding = LinkedNullNode(project, 1, LinkedNullChild(project, 1, function, 1))
    if (binding.kind != "Assign" || binding.edge_count != 1) { return ok(0) }
    checked = LinkedNullNode(project, 1, LinkedNullChild(project, 1, binding, 0))
    if (checked.kind != "TryUnwrap" || checked.edge_count != 1) { return ok(0) }
    parse = LinkedNullNode(project, 1, LinkedNullChild(project, 1, checked, 0))
    namespace_id = linkedMethodReceiver(project, parse, "parse", 1)
    if (namespace_id == 0) { return ok(0) }
    namespace = LinkedNullNode(project, 1, namespace_id)
    if (namespace.text == binding.text) { return ok(0) }

    returned = LinkedNullNode(project, 1, LinkedNullChild(project, 1, function, 2))
    if (returned.kind != "Return" || returned.edge_count != 1) { return ok(0) }
    convert = LinkedNullNode(project, 1, LinkedNullChild(project, 1, returned, 0))
    converted_id = linkedMethodReceiver(project, convert, "as_str", 0)
    if (converted_id == 0) { return ok(0) }
    converted = LinkedNullNode(project, 1, converted_id)
    if (converted.text != binding.text) { return ok(0) }

    literal_id = LinkedNullChild(project, 1, parse, 1)
    literal = LinkedNullNode(project, 1, literal_id)
    if (literal.kind != "String" || literal.edge_count != 0) { return ok(0) }
    count = project.binding.modules[0].imports.len()
    index = 0
    while (index < count) {
        imported = project.binding.modules[0].imports[index].clone()
        if (imported.local_name == namespace.text && imported.source_name == "json" && imported.module_index == 0 &&
            (imported.path == "std" || imported.path == "std.json")) {
            ty = LinkedNullType(project, 1, LinkedNullChild(project, 1, result, 0))?
            if (LinkedStringResult(ty)) { return ok(literal_id) }
            return ok(0)
        }
        index = index + 1
    }
    return ok(0)
}

fn PrepareLinkedNullProject(supplied: [SuppliedModule]): LinkedNullProject! {
    if (supplied.len() == 0) {
        point = Span { line: 1, column: 1, offset: 0, end_line: 1, end_column: 1, end_offset: 0 }
        RejectLayout("missing_linked_entry_module", "a selected source module is required", point)?
    }
    bound = BindProjectModules(supplied)?
    return ok(LinkedNullProject { supplied: supplied, binding: bound })
}

fn readLinkedEntryParameters(&project: LinkedNullProject, &function: Node): LinkedNullParameters! {
    state = NewLinkedNullState()
    if (function.text != "main") { return ReadLinkedNullParametersFrom(project, function, state) }
    if (function.edge_count > 0) {
        first = LinkedNullNode(project, 1, LinkedNullChild(project, 1, function, 0))
        if (first.kind == "Parameter" || first.kind.starts_with("Type")) {
            return ReadLinkedNullParametersFrom(project, function, state)
        }
    }
    // Procedural main has no source result value. The program adapter already
    // uses the plain null carrier for an entry whose C return value it ignores.
    state.plain_value_result = true
    result = LinkedBuiltin("null", DeclarationSpan(function))
    return ok(LinkedNullParameters { state: state, signature: "void", body_start: 0, plan: [], result: result })
}

fn EmitLinkedNullC(&project: LinkedNullProject, &entry_name: str): LinkedNullC! {
    id = RequireProjectionLocalFunction(project.supplied, entry_name)?
    function = LinkedNullNode(project, 1, id)
    parameters = readLinkedEntryParameters(project, function)?
    result = parameters.result.clone()
    region = LowerLinkedRegion(project, function, parameters.state, parameters.body_start, result, 0)?
    if (!region.terminal) {
        if (parameters.body_start != 0) {
            RejectLayout("unsupported_linked_terminal", "expected a final return or Error fail", DeclarationSpan(function))?
        }
        region.state.code += "    goto cleanup;\n"
    }
    symbol = "ku_linked_null_" + str(id)
    source = EmitLinkedFunction(project, region.state, symbol, parameters.signature, result)?
    checked = !region.state.plain_value_result
    plan = LinkPlanDeclaration { unit: 1, node: id, symbol: symbol.clone(), parameters: parameters.plan,
        result: LinkedResultPlan(result, 1, checked)?, returns_result: checked }
    return ok(LinkedNullC { symbol: symbol, links: region.state.links, source: source, entry_plan: plan, layouts: region.state.layouts })
}

fn linkedRecordEnums(&layouts: [StructLayout]): [TypeNameBinding] {
    types: [TypeNameBinding] = []
    row = 0
    while (row < layouts.len()) {
        field_count = layouts[row].fields.len()
        field = 0
        while (field < field_count) {
            if (layouts[row].fields[field].resolved.declaration_kind == "UnitEnum") {
                ty = layouts[row].fields[field].resolved.clone()
                if (BoundArrayTypePosition(types, ty) == 0) { types = types.push(ty) }
            }
            field = field + 1
        }
        row = row + 1
    }
    return types
}

fn EmitLinkedNullDeclarations(&project: LinkedNullProject, &body: LinkedNullState, &result: TypeNameBinding): str! {
    declarations = EmitLinkedBodyPrelude(body, linkedRecordEnums(body.layouts))?
    checked = !body.plain_value_result
    return ok(declarations + LinkedOptionalReaderHeader(body.slots, result)? + EmitLinkedNullPrototypes(project, body.links, body.slots, body.local_appends, result, checked)?)
}

fn EmitLinkedFunction(&project: LinkedNullProject, &body: LinkedNullState, &symbol: str, &signature: str, &payload: TypeNameBinding): str! {
    header = EmitLinkedNullDeclarations(project, body, payload)?
    result = ""
    if (body.plain_value_result) { result = LinkedNullCType(payload)? }
    else { result = LinkedCheckedResultCType(payload)? }
    keep = LinkedNullResultCleanupReference(body.owning_layouts, payload)
    char_errors = ""
    if (body.uses_chars) { char_errors = ManagedSourceCharactersErrors() }
    return ok(FinishLinkedFunctionC(header + body.callback_helpers.clone(), body, symbol, signature, result, keep, char_errors, ""))
}
