import { SuppliedModule } from "./imports.ku"
import { EmitLinkPlan, LinkPlanDeclaration } from "./link_plan_c.ku"
import { EmitLinkedNullC, PrepareLinkedNullProject } from "./linked_null_c.ku"
import { LinkedNullDependencyPlan } from "./linked_null_types_c.ku"

fn EmitLinkedUnit(supplied: [SuppliedModule], &function: str, plan: bool): str! {
    project = PrepareLinkedNullProject(supplied)?
    generated = EmitLinkedNullC(project, function)?
    if (!plan) {
        source = generated.source
        return ok(source)
    }

    links: [LinkPlanDeclaration] = []
    dependencies = generated.links
    count = dependencies.len()
    index = 0
    while (index < count) {
        links = links.push(LinkedNullDependencyPlan(dependencies[index])?)
        index = index + 1
    }
    return EmitLinkPlan(project.supplied, "linked-null", generated.entry_plan, links)
}
