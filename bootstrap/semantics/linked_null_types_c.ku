import { LinkedScalarLiteralC } from "./scalar_int_operands.ku"
import { BoundArrayCPrefix, BoundArrayCType } from "./struct_array_c.ku"
import { Node } from "../stage2/ast.ku"
import { Span } from "../stage2/span.ku"
import { DeclarationSpan } from "./names.ku"
import { ProjectNamespaceModule, ResolveProjectNamespaceFunction, SuppliedModule } from "./imports.ku"
import { ProjectBindings } from "./project_bindings.ku"
import { IsLinkedNullableIntType, LinkedCopyResult, LinkedNominalReaderPrefix, LinkedNullableReaderParameter, RequireUnitEnum, ResolveTypeName, RetagTypeNameBinding, SameBoundTypeIdentity, TypeNameBinding, UnitEnumTypeName } from "./type_names.ku"
import { ExplicitType, RejectLayout, StructLayout } from "./struct_layouts.ku"
import { CTypeName, ResolveProjectionDirectFunction, RequireProjectionBuiltin, ProjectionBuiltinLinkId, ProjectionBuiltinLinkFor, LinkedBufferResult, LinkedIntArrayCallbackNominal, LinkedIntAppendCallbackNominals } from "./struct_projection_c.ku"
import { OwningStructDropReference } from "./nested_struct_c.ku"
import { BoundLinkPlanType, BoundLinkPlanTypeWithKind, BuiltinLinkPlanType, IntArrayLinkPlanType, LinkedNullExpression, LinkedNullFunction, LinkedNullOwnedArray, LinkedNullIntArrayOwner, LinkedNullSlot, LinkedNullState, LinkedReadonlyExpression, LinkPlanType, LinkedViewPointee, NullLinkPlanResult, PreserveLinkedOwners, ReadLinkedNullBinding, RememberLinkedCall, StrArrayViewLinkPlanType } from "./link_plan_c.ku"

struct LinkedNullProject {
    supplied: [SuppliedModule]
    binding: ProjectBindings
}

fn LinkedBuiltin(name: str, at: Span): TypeNameBinding {
    return TypeNameBinding { use_node: 0, name: name, declaration_kind: "Builtin", module_index: 0, declaration_node: 0, span: at }
}

fn SameLinkedType(&a: TypeNameBinding, &b: TypeNameBinding): bool {
    return SameBoundTypeIdentity(a, b)
}

fn LinkedNullNode(&project: LinkedNullProject, unit: int, node: int): Node {
    return project.supplied[unit - 1].named.parsed.arena.nodes[node - 1].clone()
}

fn LinkedNullChild(&project: LinkedNullProject, unit: int, &parent: Node, index: int): int {
    return project.supplied[unit - 1].named.parsed.arena.edges[parent.first_edge + index]
}

fn LinkedAbsoluteType(binding: TypeNameBinding, unit: int): TypeNameBinding {
    resolved = binding
    if (resolved.declaration_kind == "Struct" && resolved.module_index == 0) {
        resolved.module_index = unit
    }
    return resolved
}

fn LinkedNullType(&project: LinkedNullProject, unit: int, node: int): TypeNameBinding! {
    annotation = LinkedNullNode(project, unit, node)
    at = DeclarationSpan(annotation)
    if (IsLinkedNullableIntType(project.supplied[unit - 1].named, annotation)) {
        return ok(RetagTypeNameBinding(LinkedBuiltin("int", at), "NullableInt"))
    }
    resolved = ExplicitType(project.binding.modules[unit - 1].types, node, at)?
    if (resolved.declaration_kind == "Enum") { return RequireUnitEnum(project.supplied, resolved, unit) }
    return ok(LinkedAbsoluteType(resolved, unit))
}

fn LinkedNullLiteralType(&project: LinkedNullProject, unit: int, &literal: Node, id: int): TypeNameBinding! {
    binding = ResolveTypeName(literal, id, project.supplied[unit - 1].named.names.declarations,
                              project.binding.modules[unit - 1].imports, project.supplied)?
    if (binding.declaration_kind != "Struct") {
        RejectLayout("linked_literal_type", "expected the declaration of a concrete struct", DeclarationSpan(literal))?
    }
    return ok(LinkedAbsoluteType(binding, unit))
}

fn readIntCallback(&project: LinkedNullProject, unit: int, &node: Node, view: bool): TypeNameBinding! {
    count = node.edge_count - 1
    if (view || (count != 1 && count != 2)) {
        RejectLayout("linked_callback_type", "expected one int with a plain record or two ints with a checked record", DeclarationSpan(node))?
    }
    index = 0
    while (index < count) {
        part = LinkedNullNode(project, unit, LinkedNullChild(project, unit, node, index))
        if (part.kind != "TypeParameter" || part.edge_count != 1 || part.text != "") {
            RejectLayout("linked_callback_type", "callback parameters must be Copy int values", DeclarationSpan(part))?
        }
        ty = LinkedNullType(project, unit, LinkedNullChild(project, unit, part, 0))?
        if (!LinkedIntResult(ty)) {
            RejectLayout("linked_callback_type", "callback parameters must be Copy int values", ty.span.clone())?
        }
        index = index + 1
    }
    result = ReadLinkedResult(project, unit, LinkedNullChild(project, unit, node, count), count == 2)?
    if (result.declaration_kind != "Struct") {
        RejectLayout("linked_callback_type", "callback result must be a named record with the declared result mode", result.span.clone())?
    }
    if (count == 1) { return ok(RetagTypeNameBinding(result, "IntRecordReaderCallback")) }
    return ok(RetagTypeNameBinding(result, "IntPairResultCallback"))
}

fn LinkedNullParameterType(&project: LinkedNullProject, unit: int, id: int, view: bool): TypeNameBinding! {
    node = LinkedNullNode(project, unit, id)
    if (!view && node.kind == "TypeFunction" && (node.edge_count == 7 || node.edge_count == 4)) {
        LinkedIntAppendCallbackNominals(project.supplied[unit - 1].named, node)?
        kind = "IntResultAppendCallback"
        if (node.edge_count == 4) { kind = "IntResultArenaCallback" }
        return ok(TypeNameBinding { use_node: id, name: "fn", declaration_kind: kind,
            module_index: unit, declaration_node: id, span: DeclarationSpan(node) })
    }
    if (!view && node.kind == "TypeFunction" && node.edge_count == 5) {
        nominal = LinkedIntArrayCallbackNominal(project.supplied[unit - 1].named, node)?
        ty = LinkedNullType(project, unit, nominal)?
        if (ty.declaration_kind != "Struct") {
            RejectLayout("linked_callback_type", "expected a by-value nominal record", ty.span.clone())?
        }
        return ok(RetagTypeNameBinding(ty, "IntArrayResultCallback"))
    }
    if (node.kind == "TypeFunction") {
        record = LinkedNullableReaderParameter(project.supplied[unit - 1].named, node)
        if (!view && record > 0) {
            ty = LinkedNullType(project, unit, record)?
            if (ty.declaration_kind == "Struct") { return ok(RetagTypeNameBinding(ty, "NullableRecordViewReader")) }
            RejectLayout("linked_callback_type", "nullable reader requires a View of a named record", ty.span.clone())?
        }
        return readIntCallback(project, unit, node, view)
    }
    if (!view) {
        if (node.kind == "TypeArray") {
            return ReadLinkedOwnedArray(project, unit, id, true, true)
        }
        return LinkedNullType(project, unit, id)
    }
    if (node.kind == "TypeArray" && node.edge_count == 1) {
        ty = LinkedNullType(project, unit, LinkedNullChild(project, unit, node, 0))?
        if (ty.declaration_kind == "Struct") {
            return ok(RetagTypeNameBinding(ty, "StructArray"))
        }
        if (ty.declaration_kind == "Builtin" && (ty.name == "str" || ty.name == "int")) {
            return ok(RetagTypeNameBinding(ty, "BuiltinArray"))
        }
    } else if (node.kind == "TypeName") {
        ty = LinkedNullType(project, unit, id)?
        if (ty.declaration_kind == "Builtin" && ty.name == "str") {
            return ok(RetagTypeNameBinding(ty, "StringView"))
        }
        if (ty.declaration_kind == "Struct") {
            return ok(RetagTypeNameBinding(ty, "StructView"))
        }
    }
    RejectLayout("linked_entry_view", "expected a readonly str, named struct or supported array", DeclarationSpan(node))?
    return ok(LinkedBuiltin("", DeclarationSpan(node)))
}

fn LinkedNullArrayElement(binding: TypeNameBinding): TypeNameBinding {
    if (binding.declaration_kind == "BuiltinArray" || binding.declaration_kind == "OwnedStringArray" ||
        LinkedNullIntArrayOwner(binding)) { return RetagTypeNameBinding(binding, "Builtin") }
    return RetagTypeNameBinding(binding, "Struct")
}

fn LinkedNullArrayPrefix(&binding: TypeNameBinding): str {
    return BoundArrayCPrefix(binding)
}

fn LinkedNullArrayType(&binding: TypeNameBinding): str {
    return BoundArrayCType(binding)
}

fn LinkedStringResult(&binding: TypeNameBinding): bool {
    return binding.declaration_kind == "Builtin" && binding.name == "str"
}

fn LinkedIntResult(&binding: TypeNameBinding): bool {
    return binding.declaration_kind == "Builtin" && binding.name == "int"
}

fn LinkedNullHasResultValue(&binding: TypeNameBinding): bool {
    return LinkedNullOwnedArray(binding) || binding.declaration_kind == "Struct" || LinkedBufferResult(binding)
        || LinkedCopyResult(binding) || LinkedNullIntArrayOwner(binding) || binding.declaration_kind == "OwnedStringArray"
        || binding.declaration_kind == "UnitEnum"
}

fn LinkedNullCType(&binding: TypeNameBinding): str! {
    if (binding.declaration_kind == "IntResultAppendCallback" || binding.declaration_kind == "IntResultArenaCallback") {
        prefix = "KuBootstrapIntAppendCallback_m"
        if (binding.declaration_kind == "IntResultArenaCallback") { prefix = "KuBootstrapIntArenaCallback_m" }
        return ok(prefix + str(binding.module_index) + "_" + str(binding.declaration_node))
    }
    nominal_prefix = LinkedNominalReaderPrefix(binding.declaration_kind)
    if (nominal_prefix != "") { return ok(nominal_prefix + CTypeName(binding.module_index, binding.declaration_node)) }
    if (binding.declaration_kind == "OwnedStringArray") { return ok("KuGuardStringArray") }
    if (binding.declaration_kind == "UnitEnum") { return ok(UnitEnumTypeName(binding)) }
    if (binding.declaration_kind == "NullableInt") { return ok("KuBootstrapOptionalInt") }
    if (binding.declaration_kind == "CaughtError") { return ok("KuBootstrapError") }
    if (binding.declaration_kind == "BuiltinArray") {
        if (binding.name == "int") { return ok("const KuArrayInt*") }
        return ok("const KuGuardStringArray*")
    }
    if (binding.declaration_kind == "StringView") { return ok("const KuProjectionString*") }
    if (binding.declaration_kind == "Struct") { return ok(CTypeName(binding.module_index, binding.declaration_node)) }
    if (binding.declaration_kind == "StructView") {
        return ok("const " + CTypeName(binding.module_index, binding.declaration_node) + "*")
    }
    if (binding.declaration_kind == "StructArray") {
        return ok("const " + LinkedNullArrayType(binding) + "*")
    }
    if (LinkedNullOwnedArray(binding) || LinkedNullIntArrayOwner(binding)) { return ok(LinkedNullArrayType(binding)) }
    if (binding.declaration_kind == "Builtin") {
        if (LinkedBufferResult(binding)) { return ok("KuProjectionString") }
        if (binding.name == "int") { return ok("int64_t") }
        if (binding.name == "bool") { return ok("bool") }
        if (binding.name == "null") { return ok("uint8_t") }
    }
    RejectLayout("unsupported_linked_type", "expected a known struct, str, int, bool or null", binding.span.clone())?
    return ok("")
}

// Type-only layouts may be forwarded or returned exclusively on other
// branches. Keep their internal cleanup references valid under strict C.
fn LinkedNullResultCleanupReference(&owning_layouts: [StructLayout], &result: TypeNameBinding): str {
    if (result.declaration_kind == "OwnedStringArray") {
        return "    (void)ku_managed_source_drop;\n"
    }
    if (LinkedNullOwnedArray(result)) {
        return "    (void)" + LinkedNullArrayPrefix(result) + "_drop;\n"
    }
    return OwningStructDropReference(owning_layouts, result)
}

fn LinkedNullView(&binding: TypeNameBinding): bool {
    return binding.declaration_kind == "StructArray" || binding.declaration_kind == "BuiltinArray" || binding.declaration_kind == "StringView"
        || binding.declaration_kind == "StructView"
}

fn LinkedNullParameterPlan(&binding: TypeNameBinding, unit: int): LinkPlanType! {
    if (LinkedNullIntArrayOwner(binding) || binding.declaration_kind == "OwnedStringArray") {
        return ok(BoundLinkPlanTypeWithKind(binding, unit, LinkedNullCType(binding)?, false, "BuiltinArray"))
    }
    if (LinkedNullOwnedArray(binding)) {
        return ok(BoundLinkPlanTypeWithKind(binding, unit, LinkedNullCType(binding)?, false, "StructArray"))
    }
    if (binding.declaration_kind == "BuiltinArray") {
        if (binding.name == "int") { return ok(IntArrayLinkPlanType(true)) }
        return ok(StrArrayViewLinkPlanType())
    }
    if (binding.declaration_kind == "StringView") {
        return ok(BuiltinLinkPlanType(binding.name.clone(), LinkedNullCType(binding)?, true))
    }
    type = binding.clone()
    if (LinkedNullView(binding)) { type = LinkedViewPointee(type) }
    return ok(BoundLinkPlanType(type, unit, LinkedNullCType(binding)?, LinkedNullView(binding)))
}

fn ReadLinkedOwnedArray(&project: LinkedNullProject, unit: int, id: int, allow_int: bool, allow_str: bool): TypeNameBinding! {
    array = LinkedNullNode(project, unit, id)
    if (array.kind != "TypeArray" || array.edge_count != 1) {
        RejectLayout("linked_owned_array_type", "expected an explicitly typed array of named records", DeclarationSpan(array))?
    }
    element = LinkedNullType(project, unit, LinkedNullChild(project, unit, array, 0))?
    if (allow_int && element.declaration_kind == "Builtin" && element.name == "int") {
        return ok(RetagTypeNameBinding(element, "OwnedIntArray"))
    }
    if (allow_str && LinkedStringResult(element)) {
        return ok(RetagTypeNameBinding(element, "OwnedStringArray"))
    }
    if (element.declaration_kind != "Struct") {
        RejectLayout("linked_owned_array_type", "expected a bound struct element", DeclarationSpan(array))?
    }
    return ok(RetagTypeNameBinding(element, "OwnedStructArray"))
}

fn ReadLinkedResult(&project: LinkedNullProject, unit: int, id: int, checked: bool): TypeNameBinding! {
    node = LinkedNullNode(project, unit, id)
    if (!checked) {
        if (node.kind == "TypeArray") { return ReadLinkedOwnedArray(project, unit, id, true, true) }
        if (node.kind == "TypeFunction") {
            reader = LinkedNullParameterType(project, unit, id, false)?
            if (reader.declaration_kind == "NullableRecordViewReader") { return ok(reader) }
            RejectLayout("linked_callback_escape", "only the owned nullable reader may be returned", DeclarationSpan(node))?
        }
        return LinkedNullType(project, unit, id)
    }
    if (node.kind != "TypeResult" || node.edge_count != 1) {
        RejectLayout("linked_dependency_result", "checked dependency requires an explicit null! or owning Result", DeclarationSpan(node))?
    }
    payload_id = LinkedNullChild(project, unit, node, 0)
    payload = LinkedNullNode(project, unit, payload_id)
    if (payload.kind == "TypeArray") {
        return ReadLinkedOwnedArray(project, unit, payload_id, true, true)
    }
    result = LinkedNullType(project, unit, payload_id)?
    if (!LinkedNullHasResultValue(result) && (result.declaration_kind != "Builtin" || result.name != "null")) {
        RejectLayout("linked_dependency_result", "expected a checked null, bool, int, string, buffer, record, payload-free enum or supported array", result.span.clone())?
    }
    return ok(result)
}

fn LinkedBuiltinDependency(&project: LinkedNullProject, unit: int, &target: Node, id: int): LinkedNullFunction! {
    operation = ProjectionBuiltinLinkFor(id)
    at = DeclarationSpan(target)
    receiver = LinkedNullNode(project, unit, LinkedNullChild(project, unit, target, 0))
    if (id != 4) {
        RequireProjectionBuiltin(project.binding.modules[unit - 1].imports, project.supplied, receiver,
            operation.namespace, operation.path, at.clone())?
    }
    input_name = "str"
    if (id == 4) { input_name = "bytes" }
    input = RetagTypeNameBinding(LinkedBuiltin(input_name, at.clone()), "StringView")
    index_type = LinkedBuiltin("int", at.clone())
    parameters: [TypeNameBinding] = [input]
    if (id == 2) { parameters = parameters.push(index_type.clone()) }
    if (id == 2 || id == 4) { parameters = parameters.push(index_type) }
    result = "str"
    if (id == 3) { result = "bytes" }
    else if (id == 4) { result = "int" }
    return ok(LinkedNullFunction { unit: 0, node: id, symbol: operation.symbol,
        parameters: parameters, result: LinkedBuiltin(result, at), returns_result: id != 5 })
}

fn LinkedNullDependency(&project: LinkedNullProject, from_unit: int, &target: Node, checked: bool): LinkedNullFunction! {
    unit = from_unit
    id = 0
    if (target.kind == "Field" && target.edge_count == 1) {
        receiver = LinkedNullNode(project, from_unit, LinkedNullChild(project, from_unit, target, 0))
        if (receiver.kind == "Variable" && receiver.edge_count == 0) {
            unit = ProjectNamespaceModule(project.binding.modules[from_unit - 1].imports, receiver.text)
            if (unit > 0) {
                id = ResolveProjectNamespaceFunction(project.supplied[unit - 1], target)?
            }
        }
        if (id == 0) {
            builtin = ProjectionBuiltinLinkId(target.text, checked)
            if (builtin != 0) { return LinkedBuiltinDependency(project, from_unit, target, builtin) }
        }
    }
    if (id == 0) {
        identity = ResolveProjectionDirectFunction(project.supplied, project.binding.modules[from_unit - 1].imports, from_unit, target)?
        unit = identity[0]
        id = identity[1]
    }
    callee = LinkedNullNode(project, unit, id)
    parameters: [TypeNameBinding] = []
    index = 0
    scanning = true
    while (scanning && index < callee.edge_count) {
        node = LinkedNullNode(project, unit, LinkedNullChild(project, unit, callee, index))
        if (node.kind == "Parameter") {
            if (node.edge_count != 1 || node.int_value < 0 || node.int_value > 1) {
                RejectLayout("linked_parameter_mode", "direct dependencies require explicit value or View parameters", DeclarationSpan(node))?
            }
            parameters = parameters.push(LinkedNullParameterType(project, unit, LinkedNullChild(project, unit, node, 0), node.int_value == 1)?)
            index = index + 1
        } else {
            scanning = false
        }
    }
    if (index >= callee.edge_count) {
        RejectLayout("linked_dependency_result", "direct dependency needs an explicit value result", DeclarationSpan(callee))?
    }
    result = ReadLinkedResult(project, unit, LinkedNullChild(project, unit, callee, index), checked)?
    symbol = "ku_value_dependency_m" + str(unit) + "_" + str(id)
    return ok(LinkedNullFunction { unit: unit, node: id, symbol: symbol, parameters: parameters,
        result: result, returns_result: checked })
}

fn LowerLinkedContextualArgument(&project: LinkedNullProject, state: LinkedNullState,
                                 &parameter: TypeNameBinding, id: int): LinkedNullExpression! {
    carrier = "(" + LinkedNullCType(parameter)? + ")"
    if (parameter.declaration_kind != "NullableRecordViewReader") {
        // A contextual empty array has no buffer to allocate or move.
        return ok(LinkedReadonlyExpression(state, parameter.clone(), carrier + "{0}"))
    }
    node = LinkedNullNode(project, 1, id)
    callee = LinkedNullDependency(project, 1, node, false)?
    reason = "reader function must have one matching record View parameter and a plain int | null result"
    if (callee.unit <= 0 || callee.returns_result || callee.parameters.len() != 1 ||
        callee.result.declaration_kind != "NullableInt") {
        RejectLayout("linked_static_reader_signature", reason.clone(), DeclarationSpan(node))?
    }
    view = RetagTypeNameBinding(parameter.clone(), "StructView")
    if (!SameLinkedType(callee.parameters[0], view)) {
        RejectLayout("linked_static_reader_signature", reason, DeclarationSpan(node))?
    }
    next = state
    thunk = "ku_static_reader_" + str(id)
    next.callback_helpers += "static KuBootstrapOptionalInt " + thunk.clone()
        + "(const KuProjectionString* capture, " + LinkedNullCType(view)? + " row) {\n"
        + "    (void)capture;\n    return " + callee.symbol.clone() + "(row);\n}\n"
    next.links = RememberLinkedCall(next.links, callee)
    return ok(LinkedReadonlyExpression(next, parameter.clone(), carrier + "{.entry=" + thunk + ", .capture={0}}"))
}

fn LinkedCheckedResultCType(&result: TypeNameBinding): str! {
    if (result.declaration_kind == "OwnedStringArray") { return ok("KuBootstrapResultStringArray") }
    if (LinkedNullHasResultValue(result)) { return ok("KuBootstrapResult_" + LinkedNullCType(result)?) }
    return ok("KuBootstrapResultNull")
}

fn LinkedNullResultType(&callee: LinkedNullFunction): str! {
    if (callee.returns_result) { return LinkedCheckedResultCType(callee.result) }
    return LinkedNullCType(callee.result)
}

fn LinkedCheckedResultPlan(&result: TypeNameBinding, unit: int): LinkPlanType! {
    if (!LinkedNullHasResultValue(result)) { return ok(NullLinkPlanResult()) }
    carrier = LinkedCheckedResultCType(result)?
    if (LinkedNullOwnedArray(result)) { return ok(BoundLinkPlanTypeWithKind(result, unit, carrier, false, "StructArray")) }
    if (result.declaration_kind == "OwnedStringArray" || LinkedNullIntArrayOwner(result)) {
        return ok(BoundLinkPlanTypeWithKind(result, unit, carrier, false, "BuiltinArray"))
    }
    return ok(BoundLinkPlanType(result, unit, carrier, false))
}

fn LinkedResultPlan(&result: TypeNameBinding, unit: int, checked: bool): LinkPlanType! {
    if (checked) { return LinkedCheckedResultPlan(result, unit) }
    return LinkedNullParameterPlan(result, unit)
}

fn LowerLinkedNullLeaf(state: LinkedNullState, &node: Node): LinkedNullExpression! {
    at = DeclarationSpan(node)
    if (node.kind == "Variable" && node.edge_count == 0) { return ReadLinkedNullBinding(state, node) }
    value = LinkedScalarLiteralC(node)?
    if (value.kind != "") { return ok(LinkedReadonlyExpression(state, LinkedBuiltin(value.kind, at), value.text)) }
    RejectLayout("unsupported_linked_operand", "expected a bound value, literal or checked direct call", at.clone())?
    return ok(LinkedReadonlyExpression(state, LinkedBuiltin("", at), ""))
}

fn CheckLinkedFinallyMoves(&before: [LinkedNullSlot], &state: LinkedNullState, &node: Node): null! {
    PreserveLinkedOwners(before, state.slots, node)?
    index = 0
    while (index < state.catch_moved.len()) {
        slot = state.catch_moved[index]
        // Catching the protected block can place hidden pending owners
        // above the source scope. This check only examines source owners.
        if (slot < before.len() && before[slot].live) {
            RejectLayout("linked_finally_move", "protected error cannot consume an outer owner", DeclarationSpan(node))?
        }
        index = index + 1
    }
    return ok(null)
}
