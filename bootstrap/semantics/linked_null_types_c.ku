import { BoundArrayCPrefix, BoundArrayCType, BoundArrayTypePosition } from "./struct_array_c.ku"
import { Node } from "../stage2/ast.ku"
import { Span } from "../stage2/span.ku"
import { DeclarationSpan } from "./names.ku"
import { SuppliedModule } from "./imports.ku"
import { ProjectBindings } from "./project_bindings.ku"
import { ResolveTypeName, SameBoundTypeIdentity, TypeNameBinding } from "./type_names.ku"
import { CollectFields, ExplicitType, LayoutIndex, RejectLayout, StructFieldLayout, StructLayout } from "./struct_layouts.ku"
import { CTypeName } from "./struct_projection_c.ku"
import { OrderCStructLayouts, OwningLayoutDropName } from "./nested_struct_c.ku"
import { BoundLinkPlanType, BuiltinLinkPlanType, FsReadLinkPlan, IntArrayLinkPlanType, LinkedNullBinding, LinkedNullSlot, LinkedNullFunction, LinkedNullOwnedArray, LinkedNullIntArrayOwner, LinkPlanDeclaration, LinkPlanType, LinkedViewPointee, NullLinkPlanResult, StrArrayViewLinkPlanType } from "./link_plan_c.ku"

struct LinkedNullProject {
    supplied: [SuppliedModule]
    binding: ProjectBindings
}

fn LinkedBuiltin(name: str, at: Span): TypeNameBinding {
    return TypeNameBinding { use_node: 0, name: name, declaration_kind: "Builtin", module_index: 0, declaration_node: 0, span: at }
}

fn SameLinkedType(&a: TypeNameBinding, &b: TypeNameBinding): bool {
    return SameBoundTypeIdentity(a, b)
}

fn LinkedNullArrayPosition(&arrays: [TypeNameBinding], &type_name: TypeNameBinding): int {
    return BoundArrayTypePosition(arrays, type_name)
}

fn LinkedNullNode(&project: LinkedNullProject, unit: int, node: int): Node {
    return project.supplied[unit - 1].named.parsed.arena.nodes[node - 1].clone()
}

fn LinkedNullChild(&project: LinkedNullProject, unit: int, &parent: Node, index: int): int {
    return project.supplied[unit - 1].named.parsed.arena.edges[parent.first_edge + index]
}

fn absoluteType(binding: TypeNameBinding, unit: int): TypeNameBinding {
    resolved = binding
    if (resolved.declaration_kind == "Struct" && resolved.module_index == 0) {
        resolved.module_index = unit
    }
    return resolved
}

fn LinkedNullType(&project: LinkedNullProject, unit: int, node: int): TypeNameBinding! {
    resolved = ExplicitType(project.binding.modules[unit - 1].types, node, DeclarationSpan(LinkedNullNode(project, unit, node)))?
    return ok(absoluteType(resolved, unit))
}

fn LinkedNullLiteralType(&project: LinkedNullProject, unit: int, &literal: Node, id: int): TypeNameBinding! {
    binding = ResolveTypeName(literal, id, project.supplied[unit - 1].named.names.declarations,
                              project.binding.modules[unit - 1].imports, project.supplied)?
    if (binding.declaration_kind != "Struct") {
        RejectLayout("linked_literal_type", "expected the declaration of a concrete struct", DeclarationSpan(literal))?
    }
    return ok(absoluteType(binding, unit))
}

fn readIntPairResultCallback(&project: LinkedNullProject, unit: int, &node: Node, view: bool): TypeNameBinding! {
    if (view || node.edge_count != 3) {
        RejectLayout("linked_callback_type", "expected fn(int, int) with a checked named record result", DeclarationSpan(node))?
    }
    index = 0
    while (index < 2) {
        part = LinkedNullNode(project, unit, LinkedNullChild(project, unit, node, index))
        if (part.kind != "TypeParameter" || part.edge_count != 1 || part.text != "") {
            RejectLayout("linked_callback_type", "callback parameters must be Copy int values", DeclarationSpan(part))?
        }
        ty = LinkedNullType(project, unit, LinkedNullChild(project, unit, part, 0))?
        if (!LinkedIntResult(ty)) {
            RejectLayout("linked_callback_type", "callback parameters must be Copy int values", ty.span.clone())?
        }
        index = index + 1
    }
    result = ReadLinkedResult(project, unit, LinkedNullChild(project, unit, node, 2), true)?
    if (result.declaration_kind != "Struct") {
        RejectLayout("linked_callback_type", "callback must return a checked named record", result.span.clone())?
    }
    result.declaration_kind = "IntPairResultCallback"
    return ok(result)
}

fn LinkedNullParameterType(&project: LinkedNullProject, unit: int, id: int, view: bool): TypeNameBinding! {
    node = LinkedNullNode(project, unit, id)
    if (node.kind == "TypeFunction") { return readIntPairResultCallback(project, unit, node, view) }
    if (!view) {
        if (node.kind == "TypeArray") {
            owner = ReadLinkedOwnedArray(project, unit, id, true)?
            if (LinkedNullIntArrayOwner(owner)) { return ok(owner) }
            RejectLayout("linked_array_value_parameter", "linked array parameters by value require [int]", DeclarationSpan(node))?
        }
        return LinkedNullType(project, unit, id)
    }
    if (node.kind == "TypeArray" && node.edge_count == 1) {
        ty = LinkedNullType(project, unit, LinkedNullChild(project, unit, node, 0))?
        if (ty.declaration_kind == "Struct") {
            ty.declaration_kind = "StructArray"
            return ok(ty)
        }
        if (ty.declaration_kind == "Builtin" && (ty.name == "str" || ty.name == "int")) {
            ty.declaration_kind = "BuiltinArray"
            return ok(ty)
        }
    } else if (node.kind == "TypeName") {
        ty = LinkedNullType(project, unit, id)?
        if (ty.declaration_kind == "Builtin" && ty.name == "str") {
            ty.declaration_kind = "StringView"
            return ok(ty)
        }
        if (ty.declaration_kind == "Struct") {
            ty.declaration_kind = "StructView"
            return ok(ty)
        }
    }
    RejectLayout("linked_entry_view", "expected a readonly str, named struct or supported array", DeclarationSpan(node))?
    return ok(LinkedBuiltin("", DeclarationSpan(node)))
}

fn LinkedNullArrayElement(binding: TypeNameBinding): TypeNameBinding {
    result = binding
    if (result.declaration_kind == "BuiltinArray" || LinkedNullIntArrayOwner(result)) { result.declaration_kind = "Builtin" }
    else { result.declaration_kind = "Struct" }
    return result
}

fn LinkedNullArrayPrefix(&binding: TypeNameBinding): str {
    return BoundArrayCPrefix(binding)
}

fn LinkedNullArrayType(&binding: TypeNameBinding): str {
    return BoundArrayCType(binding)
}

fn LinkedStringResult(&binding: TypeNameBinding): bool {
    return binding.declaration_kind == "Builtin" && binding.name == "str"
}

fn LinkedIntResult(&binding: TypeNameBinding): bool {
    return binding.declaration_kind == "Builtin" && binding.name == "int"
}

fn LinkedNullHasResultValue(&binding: TypeNameBinding): bool {
    return LinkedNullOwnedArray(binding) || binding.declaration_kind == "Struct" || LinkedStringResult(binding)
        || LinkedIntResult(binding) || binding.declaration_kind == "OwnedStringArray"
}

fn LinkedNullCType(&binding: TypeNameBinding): str! {
    if (binding.declaration_kind == "IntPairResultCallback") {
        return ok("KuBootstrapIntPairCallback_" + CTypeName(binding.module_index, binding.declaration_node))
    }
    if (binding.declaration_kind == "OwnedStringArray") { return ok("KuGuardStringArray") }
    if (binding.declaration_kind == "CaughtError") { return ok("KuBootstrapError") }
    if (binding.declaration_kind == "BuiltinArray") {
        if (binding.name == "int") { return ok("const KuArrayInt*") }
        return ok("const KuGuardStringArray*")
    }
    if (binding.declaration_kind == "StringView") { return ok("const KuProjectionString*") }
    if (binding.declaration_kind == "Struct") { return ok(CTypeName(binding.module_index, binding.declaration_node)) }
    if (binding.declaration_kind == "StructView") {
        return ok("const " + CTypeName(binding.module_index, binding.declaration_node) + "*")
    }
    if (binding.declaration_kind == "StructArray") {
        return ok("const " + LinkedNullArrayType(binding) + "*")
    }
    if (LinkedNullOwnedArray(binding) || LinkedNullIntArrayOwner(binding)) { return ok(LinkedNullArrayType(binding)) }
    if (binding.declaration_kind == "Builtin") {
        if (binding.name == "str") { return ok("KuProjectionString") }
        if (binding.name == "int") { return ok("int64_t") }
        if (binding.name == "bool") { return ok("bool") }
    }
    RejectLayout("unsupported_linked_type", "expected a known struct, str, int or bool", binding.span.clone())?
    return ok("")
}

// Type-only layouts may be forwarded or returned exclusively on other
// branches. Keep their internal cleanup references valid under strict C.
fn LinkedNullResultCleanupReference(&owning_layouts: [StructLayout], &result: TypeNameBinding): str {
    if (result.declaration_kind == "OwnedStringArray") {
        return "    (void)ku_managed_source_drop;\n    (void)ku_linked_view_str_array_valid;\n"
    }
    if (LinkedNullOwnedArray(result)) {
        return "    (void)" + LinkedNullArrayPrefix(result) + "_drop;\n"
    }
    if (result.declaration_kind == "Struct" && LayoutIndex(owning_layouts, result.module_index, result.declaration_node) > 0) {
        return "    (void)" + OwningLayoutDropName(result.module_index, result.declaration_node) + ";\n"
    }
    return ""
}

fn LinkedNullView(&binding: TypeNameBinding): bool {
    return binding.declaration_kind == "StructArray" || binding.declaration_kind == "BuiltinArray" || binding.declaration_kind == "StringView"
        || binding.declaration_kind == "StructView"
}

fn LinkedNullParameterPlan(&binding: TypeNameBinding, unit: int): LinkPlanType! {
    if (LinkedNullIntArrayOwner(binding)) { return ok(IntArrayLinkPlanType(false)) }
    if (binding.declaration_kind == "BuiltinArray") {
        if (binding.name == "int") { return ok(IntArrayLinkPlanType(true)) }
        return ok(StrArrayViewLinkPlanType())
    }
    if (binding.declaration_kind == "StringView") {
        return ok(BuiltinLinkPlanType("str", LinkedNullCType(binding)?, true))
    }
    type = LinkedViewPointee(binding.clone())
    return ok(BoundLinkPlanType(type, unit, LinkedNullCType(binding)?, LinkedNullView(binding)))
}

fn LinkedNullLayout(&project: LinkedNullProject, &ty: TypeNameBinding, layouts: [StructLayout], depth: int): [StructLayout]! {
    if (ty.declaration_kind != "Struct") {
        LinkedNullCType(ty)?
        return ok(layouts)
    }
    unit = ty.module_index
    if (LayoutIndex(layouts, unit, ty.declaration_node) != 0) { return ok(layouts) }
    if (depth >= 8) {
        RejectLayout("linked_layout_depth", "linked structs require an acyclic layout of at most 8 levels", ty.span.clone())?
    }
    named = project.supplied[unit - 1].named.clone()
    declaration = LinkedNullNode(project, unit, ty.declaration_node)
    fields = CollectFields(named.parsed.arena.nodes, named.parsed.arena.edges, project.binding.modules[unit - 1].types, declaration, false)?
    relocated: [StructFieldLayout] = []
    ordered = layouts
    for field in fields {
        local = field
        local.resolved = absoluteType(local.resolved, unit)
        ordered = LinkedNullLayout(project, local.resolved, ordered, depth + 1)?
        relocated = relocated.push(local)
    }
    ordered = ordered.push(StructLayout { name: ty.name.clone(), module_index: unit, node: ty.declaration_node, fields: relocated })
    OrderCStructLayouts(ordered, unit, ty.declaration_node, ty.span.clone())?
    return ok(ordered)
}

fn localFunction(&project: LinkedNullProject, unit: int, &name: str): int {
    for entry in project.supplied[unit - 1].named.names.declarations.clone() {
        if (entry.kind == "Function" && entry.name == name) { return entry.node }
    }
    return 0
}

fn linkedDirectFunction(&project: LinkedNullProject, unit: int, &target: Node): [int]! {
    if (target.kind == "Variable" && target.edge_count == 0) {
        local = localFunction(project, unit, target.text)
        if (local > 0) { return ok([unit, local]) }
        for binding in project.binding.modules[unit - 1].imports.clone() {
            if (binding.local_name == target.text && binding.module_index > 0) {
                item = LinkedNullNode(project, binding.module_index, binding.target_node)
                if (item.kind == "Function") { return ok([binding.module_index, binding.target_node]) }
            }
        }
    }
    RejectLayout("undefined_linked_dependency", "expected a bound direct function", DeclarationSpan(target))?
    return ok([])
}

fn ReadLinkedOwnedArray(&project: LinkedNullProject, unit: int, id: int, allow_int: bool): TypeNameBinding! {
    array = LinkedNullNode(project, unit, id)
    if (array.kind != "TypeArray" || array.edge_count != 1) {
        RejectLayout("linked_owned_array_type", "expected an explicitly typed array of named records", DeclarationSpan(array))?
    }
    element = LinkedNullType(project, unit, LinkedNullChild(project, unit, array, 0))?
    if (allow_int && element.declaration_kind == "Builtin" && element.name == "int") {
        element.declaration_kind = "OwnedIntArray"
        return ok(element)
    }
    if (element.declaration_kind != "Struct") {
        RejectLayout("linked_owned_array_type", "expected a bound struct element", DeclarationSpan(array))?
    }
    element.declaration_kind = "OwnedStructArray"
    return ok(element)
}

fn ReadLinkedResult(&project: LinkedNullProject, unit: int, id: int, checked: bool): TypeNameBinding! {
    node = LinkedNullNode(project, unit, id)
    if (!checked) {
        if (node.kind == "TypeArray") { return ReadLinkedOwnedArray(project, unit, id, true) }
        return LinkedNullType(project, unit, id)
    }
    if (node.kind != "TypeResult" || node.edge_count != 1) {
        RejectLayout("linked_dependency_result", "checked dependency requires an explicit null! or owning Result", DeclarationSpan(node))?
    }
    payload_id = LinkedNullChild(project, unit, node, 0)
    payload = LinkedNullNode(project, unit, payload_id)
    if (payload.kind == "TypeArray") {
        if (payload.edge_count == 1) {
            element = LinkedNullType(project, unit, LinkedNullChild(project, unit, payload, 0))?
            if (LinkedStringResult(element)) {
                element.declaration_kind = "OwnedStringArray"
                return ok(element)
            }
        }
        return ReadLinkedOwnedArray(project, unit, payload_id, false)
    }
    result = LinkedNullType(project, unit, payload_id)?
    if (!LinkedNullHasResultValue(result) && (result.declaration_kind != "Builtin" || result.name != "null")) {
        RejectLayout("linked_dependency_result", "expected null!, str!, [str]!, a named record Result or a struct array Result", result.span.clone())?
    }
    return ok(result)
}

fn linkedFsRead(&project: LinkedNullProject, unit: int, &target: Node): LinkedNullFunction! {
    at = DeclarationSpan(target)
    receiver = LinkedNullNode(project, unit, LinkedNullChild(project, unit, target, 0))
    found = false
    if (receiver.kind == "Variable" && receiver.edge_count == 0) {
        index = 0
        while (index < project.binding.modules[unit - 1].imports.len()) {
            binding = project.binding.modules[unit - 1].imports[index].clone()
            if (binding.local_name == receiver.text && binding.source_name == "fs" && binding.module_index == 0) {
                found = true
                break
            }
            index = index + 1
        }
    }
    if (!found) {
        RejectLayout("undefined_linked_dependency", "expected the bound standard filesystem namespace", at.clone())?
    }
    index = 0
    while (index < project.supplied.len()) {
        if (project.supplied[index].path == "std/fs.ku") {
            RejectLayout("linked_builtin_collision", "a source module occupies the builtin fs provider path", at.clone())?
        }
        index = index + 1
    }
    path = LinkedBuiltin("str", at.clone())
    path.declaration_kind = "StringView"
    return ok(LinkedNullFunction { unit: 0, node: 1, symbol: "ku_linked_dep_fs_read", parameters: [path],
        result: LinkedBuiltin("str", at), returns_result: true })
}

fn LinkedNullCallSymbol(&callee: LinkedNullFunction): str {
    if (callee.unit == 0) { return "ku_linked_fs_read" }
    return callee.symbol.clone()
}

fn LinkedNullDependency(&project: LinkedNullProject, from_unit: int, &target: Node, checked: bool): LinkedNullFunction! {
    if (checked && target.kind == "Field" && target.text == "read" && target.edge_count == 1) {
        return linkedFsRead(project, from_unit, target)
    }
    identity = linkedDirectFunction(project, from_unit, target)?
    unit = identity[0]
    id = identity[1]
    callee = LinkedNullNode(project, unit, id)
    parameters: [TypeNameBinding] = []
    index = 0
    while (index < callee.edge_count) {
        node = LinkedNullNode(project, unit, LinkedNullChild(project, unit, callee, index))
        if (node.kind != "Parameter") { break }
        if (node.edge_count != 1 || node.int_value < 0 || node.int_value > 1) {
            RejectLayout("linked_parameter_mode", "direct dependencies require explicit value or View parameters", DeclarationSpan(node))?
        }
        parameters = parameters.push(LinkedNullParameterType(project, unit, LinkedNullChild(project, unit, node, 0), node.int_value == 1)?)
        index = index + 1
    }
    if (index >= callee.edge_count) {
        RejectLayout("linked_dependency_result", "direct dependency needs an explicit value result", DeclarationSpan(callee))?
    }
    result = ReadLinkedResult(project, unit, LinkedNullChild(project, unit, callee, index), checked)?
    symbol = "ku_value_dependency_m" + str(unit) + "_" + str(id)
    return ok(LinkedNullFunction { unit: unit, node: id, symbol: symbol, parameters: parameters,
        result: result, returns_result: checked })
}

fn LinkedCheckedResultCType(&result: TypeNameBinding): str! {
    if (result.declaration_kind == "OwnedStringArray") { return ok("KuBootstrapResultStringArray") }
    if (LinkedNullHasResultValue(result)) { return ok("KuBootstrapResult_" + LinkedNullCType(result)?) }
    return ok("KuBootstrapResultNull")
}

fn LinkedNullResultType(&callee: LinkedNullFunction): str! {
    if (callee.returns_result) { return LinkedCheckedResultCType(callee.result) }
    return LinkedNullCType(callee.result)
}

fn LinkedCheckedResultPlan(&result: TypeNameBinding, unit: int): LinkPlanType! {
    if (!LinkedNullHasResultValue(result)) { return ok(NullLinkPlanResult()) }
    plan = BoundLinkPlanType(result, unit, LinkedCheckedResultCType(result)?, false)
    if (LinkedNullOwnedArray(result)) { plan.kind = "StructArray" }
    if (result.declaration_kind == "OwnedStringArray") { plan.kind = "BuiltinArray" }
    return ok(plan)
}

fn LinkedResultPlan(&result: TypeNameBinding, unit: int, checked: bool): LinkPlanType! {
    if (checked) { return LinkedCheckedResultPlan(result, unit) }
    if (LinkedNullIntArrayOwner(result)) { return ok(IntArrayLinkPlanType(false)) }
    plan = BoundLinkPlanType(result, unit, LinkedNullCType(result)?, false)
    if (LinkedNullOwnedArray(result)) { plan.kind = "StructArray" }
    return ok(plan)
}

fn ResolveLinkedCall(&project: LinkedNullProject, &slots: [LinkedNullSlot], &call: Node, &target: Node, checked: bool): LinkedNullFunction! {
    name = target.text.clone()
    if (target.kind == "Field" && target.edge_count == 1) {
        receiver = LinkedNullNode(project, 1, LinkedNullChild(project, 1, target, 0))
        name = receiver.text.clone()
    }
    if (LinkedNullBinding(slots, name) != 0) {
        RejectLayout("shadowed_linked_dependency", "direct dependency name is shadowed by a local", DeclarationSpan(target))?
    }
    callee = LinkedNullDependency(project, 1, target, checked)?
    if (callee.parameters.len() != call.edge_count - 1) {
        RejectLayout("linked_dependency_arity", "argument count differs from the bound function declaration", DeclarationSpan(call))?
    }
    return ok(callee)
}

fn LinkedNullDependencyPlan(&callee: LinkedNullFunction): LinkPlanDeclaration! {
    if (callee.unit == 0) { return ok(FsReadLinkPlan(callee.symbol.clone())) }
    parameters: [LinkPlanType] = []
    index = 0
    while (index < callee.parameters.len()) {
        ty = callee.parameters[index].clone()
        parameters = parameters.push(LinkedNullParameterPlan(ty, callee.unit)?)
        index = index + 1
    }
    result = LinkedResultPlan(callee.result, callee.unit, callee.returns_result)?
    return ok(LinkPlanDeclaration { unit: callee.unit, node: callee.node, symbol: callee.symbol.clone(),
        parameters: parameters, result: result, returns_result: callee.returns_result })
}

fn LinkedNullEntry(&project: LinkedNullProject, &name: str): int! {
    entry = localFunction(project, 1, name)
    if (entry == 0) {
        point = Span { line: 1, column: 1, offset: 0, end_line: 1, end_column: 1, end_offset: 0 }
        RejectLayout("unknown_linked_null_entry", "expected a selected null! function", point)?
    }
    return ok(entry)
}
