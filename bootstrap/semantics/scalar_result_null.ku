fn LinkedSlotDeclaration(kind: str, name: str, named: bool, &drop_c: str): str {
    ending = ";\n"
    // An unused source local is legal. Refer to its storage without loading
    // its value or changing when its initializer runs.
    if (named && drop_c == "") { ending = "; (void)&" + name.clone() + ";\n" }
    return "    " + kind + " " + name + " = {0}" + ending
}

fn ScalarStaticErrorFields(&nodes: [Node], &edges: [int], &object: Node, &string_type: str): str! {
    if (object.kind != "ObjectLiteral" || object.edge_count != 3) {
        RejectScalarInt("unsupported_static_error", "expected an Error literal with domain, code, and message", DeclarationSpan(object))?
    }
    domain = ""
    code = ""
    message = ""
    index = 0
    while (index < object.edge_count) {
        field = nodes[edges[object.first_edge + index] - 1].clone()
        if (field.kind != "ObjectLiteralField" || field.edge_count != 1) {
            RejectScalarInt("unsupported_static_error_field", "expected a named Error field", DeclarationSpan(field))?
        }
        value = nodes[edges[field.first_edge] - 1].clone()
        if (value.kind != "String" || value.edge_count != 0) {
            RejectScalarInt("unsupported_static_error_field", "expected a string literal in the Error field", DeclarationSpan(value))?
        }
        rendered = "(" + string_type.clone() + "){(uint8_t*)" + ScalarStringLiteral(value)? + ", 0u, 0u}"
        if (field.text == "domain" && domain == "") { domain = rendered }
        else if (field.text == "code" && code == "") { code = rendered }
        else if (field.text == "message" && message == "") { message = rendered }
        else {
            RejectScalarInt("unsupported_static_error_field", "unexpected or duplicate Error field '" + field.text + "'", DeclarationSpan(field))?
        }
        index = index + 1
    }
    // Once each of the three names has been seen, the static C carrier can
    // be initialized directly. Its fields never borrow a parameter owner.
    return ok(domain + ", " + code + ", " + message)
}

fn LowerNullResultExit(&nodes: [Node], &edges: [int], &parameters: [ScalarIntParameter],
                       &statement: Node, can_use_ok: bool): str! {
    value = nodes[edges[statement.first_edge] - 1].clone()
    if (statement.kind == "Fail") {
        fields = ScalarStaticErrorFields(nodes, edges, value, "KuString")?
        return ok("(KuResult_null){false, 0u, (KuError){" + fields + "}}")
    }
    if (value.kind == "Call" && value.edge_count == 2 && can_use_ok) {
        parameter = ScalarParameterIndex(parameters, "ok")
        if (parameter < 0) {
            target = nodes[edges[value.first_edge] - 1].clone()
            payload = nodes[edges[value.first_edge + 1] - 1].clone()
            if (target.kind == "Variable" && target.edge_count == 0 && target.text == "ok"
                && payload.kind == "Null" && payload.edge_count == 0) {
                return ok("(KuResult_null){true, 0u, (KuError){0}}")
            }
        }
    }
    RejectScalarInt("unsupported_null_result", "expected return with the builtin ok(null)", DeclarationSpan(value))?
    return ok("")
}

struct ManagedErrorEmission {
    prep: GuardValue
    declarations: str
    after_cleanup: str
}

struct DeferredStringArgument {
    declarations: str
    capture: str
    setup: str
    value: str
}

fn deferredJoinedString(&nodes: [Node], &edges: [int], &bindings: [GuardBinding],
                        &expression: Node, id: int, &indent: str): DeferredStringArgument! {
    if (expression.kind != "Binary" || expression.text != "+" || expression.edge_count != 2) {
        RejectLayout("managed_error_argument", "expected a literal prefix and suffix around one owned string", DeclarationSpan(expression))?
    }
    left = nodes[edges[expression.first_edge] - 1].clone()
    suffix = nodes[edges[expression.first_edge + 1] - 1].clone()
    if (left.kind != "Binary" || left.text != "+" || left.edge_count != 2 || suffix.kind != "String") {
        RejectLayout("managed_error_argument", "expected a literal prefix and suffix around one owned string", DeclarationSpan(expression))?
    }
    prefix = nodes[edges[left.first_edge] - 1].clone()
    value = nodes[edges[left.first_edge + 1] - 1].clone()
    binding = GuardBindingIndex(bindings, value.text)
    if (prefix.kind != "String" || value.kind != "Variable" || binding == 0 ||
        bindings[binding - 1].ty.kind != "str" || bindings[binding - 1].view) {
        RejectLayout("managed_error_argument", "expected a literal prefix and suffix around one owned string", DeclarationSpan(expression))?
    }
    saved = "saved_error" + str(id)
    message = "joined_error" + str(id)
    source = GuardBindingName(bindings[binding - 1])
    capture = indent.clone() + saved.clone() + " = " + source.clone() + ";\n" +
        indent.clone() + source + " = (KuProjectionString){0};\n"
    left_value = "(KuProjectionString){(uint8_t*)" + ScalarStringLiteral(prefix)? + ", 0u, KU_PROJECTION_STRING_STATIC}"
    right_value = "(KuProjectionString){(uint8_t*)" + ScalarStringLiteral(suffix)? + ", 0u, KU_PROJECTION_STRING_STATIC}"
    setup = "        KuProjectionString " + message.clone() + " = " + left_value + ";\n"
    setup += "        bool message_too_large = false;\n"
    setup += "        if (!ku_managed_string_append(&" + message.clone() + ", " + saved.clone() + ", &message_too_large) ||\n"
    setup += "            !ku_managed_string_append(&" + message.clone() + ", " + right_value + ", &message_too_large)) {\n"
    setup += "            ku_projection_string_drop(&" + saved.clone() + ");\n"
    setup += "            ku_projection_string_drop(&" + message.clone() + ");\n"
    setup += "            fputs(message_too_large ? \"string allocation is too large\\n\" : \"out of memory\\n\", stderr);\n"
    setup += "            exit(EXIT_FAILURE);\n        }\n"
    setup += "        ku_projection_string_drop(&" + saved.clone() + ");\n"
    return ok(DeferredStringArgument { declarations: "    KuProjectionString " + saved + " = {0};\n",
        capture: capture, setup: setup, value: message })
}

fn managedErrorProvider(&nodes: [Node], &edges: [int], &bindings: [GuardBinding], &leaves: [GuardLeaf], &call: Node): GuardLeaf! {
    if (call.edge_count > 0) {
        target = nodes[edges[call.first_edge] - 1].clone()
        if (target.kind == "Variable" && target.edge_count == 0 && GuardBindingIndex(bindings, target.text) == 0) {
            for leaf in leaves.clone() {
                if (leaf.name == target.text && leaf.result_kind == "str" && leaf.parameters.len() + 1 == call.edge_count) { return ok(leaf) }
            }
        }
    }
    RejectLayout("managed_error_provider", "expected an unshadowed, typed str message provider", DeclarationSpan(call))?
    return ok(GuardLeaf { name: "", symbol: "", result_kind: "", parameters: [] })
}

fn deferredMessage(&nodes: [Node], &edges: [int], &bindings: [GuardBinding], &layouts: [StructLayout],
                   &leaves: [GuardLeaf], &call: Node, id: int, &indent: str, allow_join: bool): ManagedErrorEmission! {
    leaf = managedErrorProvider(nodes, edges, bindings, leaves, call)?
    prep = GuardRead(GuardType { kind: "str", layout: 0 }, "", false)
    declarations = ""
    arguments = ""
    composed = DeferredStringArgument { declarations: "", capture: "", setup: "", value: "" }
    index = 0
    while (index < leaf.parameters.len()) {
        arg = edges[call.first_edge + index + 1]
        kind = leaf.parameters[index].clone()
        item = nodes[arg - 1].clone()
        if (allow_join && index == 0 && kind == "str" && item.kind == "Binary") {
            composed = deferredJoinedString(nodes, edges, bindings, item, id, indent)?
            arguments = composed.value.clone()
            index = index + 1
            continue
        }
        if (composed.value != "" && (kind != "int" || (item.kind != "Int" && item.kind != "Variable"))) {
            RejectLayout("managed_error_argument", "a joined message can defer only pure int reads", DeclarationSpan(item))?
        }
        if (kind != "int" && (kind != "str" || item.kind != "String")) {
            RejectLayout("managed_error_argument", "message providers use Copy int or literal str arguments", DeclarationSpan(item))?
        }
        value = GuardExpression(nodes, edges, bindings, layouts, arg, 0, indent)?
        if (value.ty.kind != kind || value.view) {
            RejectLayout("managed_error_argument", "message argument must match its declared type", DeclarationSpan(item))?
        }
        rendered = value.value
        prep.setup = prep.setup + value.setup
        prep.uses_add = prep.uses_add || value.uses_add
        prep.uses_sub = prep.uses_sub || value.uses_sub
        prep.uses_eq = prep.uses_eq || value.uses_eq
        if (kind == "int") {
            name = "error_arg" + str(id) + "_" + str(index)
            declarations += "    int64_t " + name.clone() + " = 0;\n"
            prep.setup = prep.setup + indent.clone() + name.clone() + " = " + rendered + ";\n"
            rendered = name
        }
        if (index > 0) { arguments += ", " }
        arguments += rendered
        index = index + 1
    }
    // Capture the last owned argument after all validation succeeds. On a
    // joined path only this argument and Copy snapshots cross cleanup.
    declarations += composed.declarations
    prep.setup += composed.capture
    prep.setup = prep.setup + indent.clone() + "record_error = " + str(id) + ";\n"
    invoke = "result.error.message = " + leaf.symbol + "(" + arguments + ");\n"
    begin = "    if (record_error == " + str(id) + ") "
    finish = begin.clone() + invoke.clone()
    if (composed.setup != "") { finish = begin + "{\n" + composed.setup + "        " + invoke + "    }\n" }
    return ok(ManagedErrorEmission { prep: prep, declarations: declarations, after_cleanup: finish })
}

fn LowerManagedRecordError(&nodes: [Node], &edges: [int], &bindings: [GuardBinding], &layouts: [StructLayout],
                           &leaves: [GuardLeaf], &literal: Node, id: int, &indent: str, allow_join: bool): ManagedErrorEmission! {
    if (literal.kind != "ObjectLiteral" || literal.edge_count != 3) {
        RejectLayout("managed_record_error", "expected Error domain, code, and message", DeclarationSpan(literal))?
    }
    prep = GuardRead(GuardType { kind: "str", layout: 0 }, "", false)
    declarations = ""
    finish = ""
    seen: [str] = []
    index = 0
    while (index < literal.edge_count) {
        field = nodes[edges[literal.first_edge + index] - 1].clone()
        label = field.text.clone()
        if (field.kind != "ObjectLiteralField" || field.edge_count != 1 || (label != "domain" && label != "code" && label != "message") || ContainsType(seen, label)) {
            RejectLayout("managed_record_error_field", "expected each named Error field once", DeclarationSpan(field))?
        }
        child = edges[field.first_edge]
        value = nodes[child - 1].clone()
        if (label == "message" && value.kind == "Call") {
            dynamic = deferredMessage(nodes, edges, bindings, layouts, leaves, value, id, indent, allow_join)?
            prep.setup = prep.setup + dynamic.prep.setup
            prep.uses_add = dynamic.prep.uses_add
            prep.uses_sub = dynamic.prep.uses_sub
            prep.uses_eq = dynamic.prep.uses_eq
            declarations = dynamic.declarations
            finish = dynamic.after_cleanup
        } else {
            if (value.kind != "String" || value.edge_count != 0) {
                RejectLayout("managed_record_error_field", "expected a static Error field or direct message provider", DeclarationSpan(value))?
            }
            rendered = GuardExpression(nodes, edges, bindings, layouts, child, 0, indent)?
            prep.setup = prep.setup + indent.clone() + "result.error." + label.clone() + " = " + rendered.value + ";\n"
        }
        seen = seen.push(label)
        index = index + 1
    }
    prep.setup = prep.setup + indent.clone() + "goto cleanup;\n"
    return ok(ManagedErrorEmission { prep: prep, declarations: declarations, after_cleanup: finish })
}

struct LinkedCatchParts {
    protected: Node
    binding: Node
    recovery: Node
}

fn StartLinkedThunkFrame(&parent: LinkedNullState): LinkedNullState {
    // Keep the accumulated C requirements and bound identities. The new
    // frame starts with independent locals, code and failure bookkeeping.
    body = NewLinkedNullState()
    body.layouts = parent.layouts.clone()
    body.owning_layouts = parent.owning_layouts.clone()
    body.owning_strings = parent.owning_strings
    body.links = parent.links.clone()
    body.callback_helpers = parent.callback_helpers.clone()
    body.uses_scoped_reader = parent.uses_scoped_reader
    body.local_append_types = parent.local_append_types.clone()
    body.uses_clone = parent.uses_clone
    body.uses_int_snapshot = parent.uses_int_snapshot
    body.uses_str_snapshot = parent.uses_str_snapshot
    body.arrays = parent.arrays.clone()
    body.validated_arrays = parent.validated_arrays.clone()
    body.owned_arrays = parent.owned_arrays.clone()
    body.uses_str_array = parent.uses_str_array
    body.uses_str_view = parent.uses_str_view
    body.uses_struct_view = parent.uses_struct_view
    body.element_clones = parent.element_clones.clone()
    body.uses_index = parent.uses_index
    body.checks_str_item = parent.checks_str_item
    body.uses_add = parent.uses_add
    body.uses_sub = parent.uses_sub
    body.uses_mul = parent.uses_mul
    body.uses_div = parent.uses_div
    body.uses_string_equal = parent.uses_string_equal
    body.uses_print = parent.uses_print
    body.uses_concat = parent.uses_concat
    body.uses_int_format = parent.uses_int_format
    body.uses_prefix_suffix = parent.uses_prefix_suffix
    body.uses_string_contains = parent.uses_string_contains
    body.uses_chars = parent.uses_chars
    return body
}

fn ReadLinkedCatchParts(&named: NamedModule, &node: Node): LinkedCatchParts! {
    edge = node.first_edge
    protected = named.parsed.arena.nodes[named.parsed.arena.edges[edge] - 1].clone()
    handler = named.parsed.arena.nodes[named.parsed.arena.edges[edge + 1] - 1].clone()
    if (protected.kind != "TryBody" || handler.kind != "Catch" || handler.edge_count != 2) {
        RejectLayout("unsupported_linked_catch", "expected a protected body and named catch", DeclarationSpan(node))?
    }
    edge = handler.first_edge
    binding = named.parsed.arena.nodes[named.parsed.arena.edges[edge] - 1].clone()
    recovery = named.parsed.arena.nodes[named.parsed.arena.edges[edge + 1] - 1].clone()
    if (binding.kind != "CatchBinding" || binding.text == "" || binding.edge_count != 0 || recovery.kind != "CatchBody") {
        RejectLayout("unsupported_linked_catch", "expected a named catch and handler body", DeclarationSpan(handler))?
    }
    return ok(LinkedCatchParts { protected: protected, binding: binding, recovery: recovery })
}

fn LinkedOptionalIntHeader(&slots: [LinkedNullSlot], &result: TypeNameBinding): str {
    needed = result.declaration_kind == "NullableInt"
    index = 0
    while (!needed && index < slots.len()) {
        needed = slots[index].value.ty.declaration_kind == "NullableInt"
        index = index + 1
    }
    if (!needed) { return "" }
    return "typedef struct { bool is_null; int64_t value; } KuBootstrapOptionalInt;\n"
}

fn EmitLinkedOptionalIntReturn(value: LinkedNullExpression, &statement: Node): LinkedNullState! {
    expression = value.value.text.clone()
    if (value.value.ty.declaration_kind == "Builtin" && value.value.ty.name == "int") {
        expression = "(KuBootstrapOptionalInt){false, " + expression + "}"
    } else if (value.value.ty.declaration_kind != "NullableInt") {
        RejectLayout("linked_value_return", "expected int, null, or int | null", DeclarationSpan(statement))?
    }
    next = value.state
    next.code += "    result = " + expression + ";\n    goto cleanup;\n"
    return ok(next)
}

fn EmitLinkedOptionalIntTest(input: LinkedNullExpression, &node: Node): LinkedNullExpression! {
    at = DeclarationSpan(node)
    if (input.value.ty.declaration_kind != "NullableInt") {
        RejectLayout("linked_binary_type", "a linked null comparison requires an int | null value", at.clone())?
    }
    expression = "(" + input.value.text + ").is_null"
    if (node.text == "!=") { expression = "!" + expression }
    ty = TypeNameBinding { use_node: 0, name: "bool", declaration_kind: "Builtin", module_index: 0, declaration_node: 0, span: at }
    return ok(LinkedReadonlyExpression(input.state, ty, expression))
}

fn LinkedNullCallSymbol(&callee: LinkedNullFunction): str {
    if (callee.unit == 0 && callee.node == 1) { return "ku_linked_fs_read" }
    return callee.symbol.clone()
}

fn CheckLinkedIntString(&ty: TypeNameBinding, &at: Span): bool! {
    if (ty.declaration_kind == "NullableInt") { return ok(true) }
    if (ty.declaration_kind != "Builtin" || ty.name != "int") {
        RejectLayout("linked_int_format", "linked str conversion requires an int or int | null argument", at.clone())?
    }
    return ok(false)
}

fn EmitLinkedIntString(&value: str, &out: str, optional: bool): str {
    if (!optional) { return EmitScalarIntString(value, out) }
    // Never read the payload of null. Non-null values use the existing formatter.
    saved = out + "_optional"
    return "    const KuBootstrapOptionalInt " + saved + " = " + value + ";\n"
        + "    if (" + saved + ".is_null) {\n"
        + "        " + out + " = (KuProjectionString){.ptr=(uint8_t*)\"null\", .len=4u};\n"
        + "    } else {\n" + EmitScalarIntString(saved + ".value", out) + "    }\n"
}

fn linkedHasLocalFunction(&state: LinkedNullState, &name: str): bool {
    return FindLinkedLocalRead(state.local_readers, name) != 0 || LinkedLocalAppendIndex(state, name) != 0
}

fn HasLinkedContextualArgument(&project: LinkedNullProject, &state: LinkedNullState,
                               &parameter: TypeNameBinding, id: int, depth: int): bool! {
    if (depth >= 32) { return ok(false) }
    if (LinkedScalarArrayOwner(parameter)) {
        node = LinkedNullNode(project, 1, id)
        return ok(node.kind == "Array" && node.edge_count == 0)
    }
    if (parameter.declaration_kind != "NullableRecordViewReader") { return ok(false) }
    node = LinkedNullNode(project, 1, id)
    if (node.kind == "Variable" && node.edge_count == 0) {
        selected = LinkedNullBinding(state.slots, node.text) == 0 && !linkedHasLocalFunction(state, node.text)
        return CheckLinkedStaticReaderSite(project.supplied[0].named, node, id, selected)
    }
    if (node.kind != "Field" || node.edge_count != 1) { return ok(false) }
    receiver = LinkedNullNode(project, 1, LinkedNullChild(project, 1, node, 0))
    selected = receiver.kind == "Variable" && receiver.edge_count == 0 &&
        LinkedNullBinding(state.slots, receiver.text) == 0 && !linkedHasLocalFunction(state, receiver.text) &&
        ProjectNamespaceModule(project.binding.modules[0].imports, receiver.text) > 0
    return CheckLinkedStaticReaderSite(project.supplied[0].named, node, id, selected)
}

fn ResolveLinkedCall(&project: LinkedNullProject, &state: LinkedNullState, &call: Node, &target: Node, checked: bool): LinkedNullFunction! {
    name = target.text.clone()
    if (target.kind == "Field" && target.edge_count == 1) {
        receiver = LinkedNullNode(project, 1, LinkedNullChild(project, 1, target, 0))
        name = receiver.text.clone()
        if (receiver.kind == "Variable" && receiver.edge_count == 0 &&
            ProjectNamespaceModule(project.binding.modules[0].imports, name) != 0 &&
            linkedHasLocalFunction(state, name)) {
            RejectLayout("shadowed_linked_dependency", "direct dependency name is shadowed by a local", DeclarationSpan(target))?
        }
    }
    local = LinkedNullBinding(state.slots, name)
    if (local != 0) {
        if (!state.slots[local - 1].value.borrowed
            && ProjectionBytesGet(target, state.slots[local - 1].value.ty, call.edge_count - 1, checked)) {
            return LinkedBuiltinDependency(project, 1, target, 4)
        }
        RejectLayout("shadowed_linked_dependency", "direct dependency name is shadowed by a local", DeclarationSpan(target))?
    }
    callee = LinkedNullDependency(project, 1, target, checked)?
    if (callee.parameters.len() != call.edge_count - 1) {
        RejectLayout("linked_dependency_arity", "argument count differs from the bound function declaration", DeclarationSpan(call))?
    }
    if (callee.unit == 0 && callee.node >= 2 && callee.node <= 4) {
        input = LinkedNullChild(project, 1, call, 1)
        root = ProjectionPlaceRoot(project.supplied[0].named.parsed.arena.nodes,
                                   project.supplied[0].named.parsed.arena.edges, input)
        slot = LinkedNullBinding(state.slots, root)
        if (slot != 0 && state.slots[slot - 1].value.borrowed) {
            RejectLinkedBuiltinBorrow(callee.node, DeclarationSpan(LinkedNullNode(project, 1, input)))?
        }
    }
    return ok(callee)
}
