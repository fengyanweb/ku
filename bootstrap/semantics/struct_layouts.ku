import { Node } from "../stage2/ast.ku"
import { DiagnosticCanonical, MakeDiagnostic } from "../stage2/diagnostic.ku"
import { Span } from "../stage2/span.ku"
import { DeclarationSpan, NamedModule, TopLevelName } from "./names.ku"
import { SuppliedModule } from "./imports.ku"
import { IsBuiltinType, TypeNameBinding } from "./type_names.ku"

struct StructFieldLayout {
    name: str
    ordinal: int
    node: int
    resolved: TypeNameBinding
}

struct StructLayout {
    name: str
    module_index: int
    node: int
    fields: [StructFieldLayout]
}

struct StructParameter {
    name: str
    mode: int
    layout_module: int
    layout_node: int
}

// The output ordinal is independent of the position in projections. That
// array records source evaluation order; the field ordinals describe layout.
struct StructProjection {
    output_field: int
    parameter: int
    input_field: int
    value_node: int
}

struct StructReturnPlan {
    function_name: str
    function_node: int
    result_layout: int
    parameters: [StructParameter]
    projections: [StructProjection]
}

fn RejectLayout(code: str, message: str, span: Span): null! {
    domain = "bootstrap.semantics.structs"
    diagnostic = MakeDiagnostic("error", domain.clone(), code.clone(), message, "<source>", span)
    fail { domain: domain, code: code, message: DiagnosticCanonical(diagnostic) }
}

fn ExplicitType(&bindings: [TypeNameBinding], use_node: int, at: Span): TypeNameBinding! {
    lo = 0
    hi = bindings.len()
    // BindTypeNames produces ascending AST IDs.
    searching = lo < hi
    while (searching) {
        middle = lo + (hi - lo) / 2
        if (bindings[middle].use_node < use_node) { lo = middle + 1 }
        else { hi = middle }
        searching = lo < hi
    }
    if (lo >= bindings.len() || bindings[lo].use_node != use_node) {
        RejectLayout("unsupported_layout_type", "expected a bound explicit TypeName", at)?
    }
    return ok(bindings[lo].clone())
}

fn FieldIndex(&fields: [StructFieldLayout], &name: str): int {
    index = 0
    while (index < fields.len()) {
        if (fields[index].name == name) { return index + 1 }
        index = index + 1
    }
    return 0
}

fn LayoutIndex(&layouts: [StructLayout], module_index: int, node: int): int {
    index = 0
    while (index < layouts.len()) {
        if (layouts[index].module_index == module_index && layouts[index].node == node) { return index + 1 }
        index = index + 1
    }
    return 0
}

fn ImportedFieldType(&node: Node, use_node: int): TypeNameBinding! {
    at = DeclarationSpan(node)
    if (node.kind != "TypeName" || !IsBuiltinType(node.text)) {
        RejectLayout("unsupported_layout_type", "imported struct fields require explicit builtin scalar or str types", at.clone())?
    }
    return ok(TypeNameBinding { use_node: use_node, name: node.text.clone(), declaration_kind: "Builtin",
                                module_index: 0, declaration_node: 0, span: at })
}

fn owningFieldType(&nodes: [Node], &edges: [int], &bindings: [TypeNameBinding], id: int): TypeNameBinding! {
    at = DeclarationSpan(nodes[id - 1])
    if (nodes[id - 1].kind != "TypeArray") { return ExplicitType(bindings, id, at) }
    if (nodes[id - 1].edge_count != 1) {
        RejectLayout("unsupported_layout_type", "an array field must declare one element type", at.clone())?
    }
    element = ExplicitType(bindings, edges[nodes[id - 1].first_edge], at.clone())?
    if (element.declaration_kind == "Struct") {
        element.declaration_kind = "StructArray"
    } else if (element.declaration_kind == "Builtin" && (element.name == "int" || element.name == "str")) {
        element.declaration_kind = "BuiltinArray"
    } else {
        RejectLayout("unsupported_layout_type", "owning C layout supports [int], [str] or an array of bound structs", at.clone())?
    }
    element.use_node = id
    element.span = at
    return ok(element)
}

fn collectFields(&nodes: [Node], &edges: [int], &bindings: [TypeNameBinding],
                 &decl: Node, imported: bool, owning: bool): [StructFieldLayout]! {
    fields: [StructFieldLayout] = []
    index = 0
    while (index < decl.edge_count) {
        id = edges[decl.first_edge + index]
        field = nodes[id - 1].clone()
        if (field.kind != "StructField" || field.edge_count != 1) {
            RejectLayout("unsupported_layout_type", "struct fields must have an explicit type", DeclarationSpan(field))?
        }
        if (FieldIndex(fields, field.text) != 0) {
            RejectLayout("duplicate_layout_field", "duplicate struct field '" + field.text.clone() + "'", DeclarationSpan(field))?
        }
        type_id = edges[field.first_edge]
        if (imported) {
            resolved = ImportedFieldType(nodes[type_id - 1], type_id)?
            fields = fields.push(StructFieldLayout { name: field.text, ordinal: index, node: id, resolved: resolved })
        } else if (owning) {
            resolved = owningFieldType(nodes, edges, bindings, type_id)?
            fields = fields.push(StructFieldLayout { name: field.text, ordinal: index, node: id, resolved: resolved })
        } else {
            resolved = ExplicitType(bindings, type_id, DeclarationSpan(field))?
            fields = fields.push(StructFieldLayout { name: field.text, ordinal: index, node: id, resolved: resolved })
        }
        index = index + 1
    }
    return ok(fields)
}

fn CollectFields(&nodes: [Node], &edges: [int], &bindings: [TypeNameBinding],
                 &decl: Node, imported: bool): [StructFieldLayout]! {
    return collectFields(nodes, edges, bindings, decl, imported, false)
}

fn CollectOwningFields(&nodes: [Node], &edges: [int], &bindings: [TypeNameBinding],
                       &decl: Node): [StructFieldLayout]! {
    return collectFields(nodes, edges, bindings, decl, false, true)
}

fn CollectLayouts(&nodes: [Node], &edges: [int], &bindings: [TypeNameBinding],
                  &names: [TopLevelName]): [StructLayout]! {
    layouts: [StructLayout] = []
    index = 0
    while (index < names.len()) {
        name = names[index].clone()
        if (name.kind == "Struct") {
            decl = nodes[name.node - 1].clone()
            fields = CollectFields(nodes, edges, bindings, decl, false)?
            layout = StructLayout { name: name.name, module_index: 0, node: name.node, fields: fields }
            layouts = layouts.push(layout)
        }
        index = index + 1
    }
    return ok(layouts)
}

fn ImportedLayout(&named: NamedModule, module_index: int, node: int, at: Span): StructLayout! {
    count = named.parsed.arena.nodes.len()
    if (node <= 0 || node > count) {
        RejectLayout("invalid_layout_binding", "imported layout refers to an invalid declaration", at.clone())?
    }
    declaration = named.parsed.arena.nodes[node - 1].clone()
    if (declaration.kind != "Struct") {
        RejectLayout("invalid_layout_binding", "imported layout does not refer to a struct", at)?
    }
    no_local_bindings: [TypeNameBinding] = []
    fields = CollectFields(named.parsed.arena.nodes, named.parsed.arena.edges, no_local_bindings, declaration, true)?
    return ok(StructLayout { name: declaration.text, module_index: module_index, node: node, fields: fields })
}

// Build layouts from the validated current graph and explicitly resolved
// imports. Imported dependency fields are limited to builtin scalar/str.
fn BuildStructLayouts(&named: NamedModule, &bindings: [TypeNameBinding], &supplied: [SuppliedModule]): [StructLayout]! {
    layouts = CollectLayouts(named.parsed.arena.nodes, named.parsed.arena.edges,
                             bindings, named.names.declarations)?
    index = 0
    while (index < bindings.len()) {
        binding = bindings[index].clone()
        module_index = binding.module_index
        node = binding.declaration_node
        if (binding.declaration_kind == "Struct" && module_index > 0 && LayoutIndex(layouts, module_index, node) == 0) {
            if (module_index > supplied.len()) {
                RejectLayout("invalid_layout_binding", "missing supplied module for imported layout", binding.span.clone())?
            }
            layout = ImportedLayout(supplied[module_index - 1].named, module_index, node, binding.span)?
            layouts = layouts.push(layout)
        }
        index = index + 1
    }
    return ok(layouts)
}

fn ProjectionFieldsFit(&fields: [StructFieldLayout], input: bool): bool {
    index = 0
    while (index < fields.len()) {
        leaf = fields[index].resolved.clone()
        copy = leaf.name == "int" || leaf.name == "float" || leaf.name == "bool" || leaf.name == "null"
        if (leaf.declaration_kind != "Builtin" || !(copy || (input && leaf.name == "str"))) {
            return false
        }
        index = index + 1
    }
    return true
}

fn CheckedLayout(&layouts: [StructLayout], &binding: TypeNameBinding, input: bool, at: Span): int! {
    index = LayoutIndex(layouts, binding.module_index, binding.declaration_node)
    if (binding.declaration_kind != "Struct" || index == 0 || (!input && binding.module_index != 0)
        || !ProjectionFieldsFit(layouts[index - 1].fields, input)) {
        if (input) {
            RejectLayout("unsupported_aggregate_layout", "projection inputs require structs containing Copy scalar or str fields", at.clone())?
        }
        RejectLayout("unsupported_aggregate_layout", "projection returns require local structs containing Copy scalar fields", at)?
    }
    return ok(index)
}

fn ParameterIndex(&parameters: [StructParameter], &name: str): int {
    index = 0
    while (index < parameters.len()) {
        if (parameters[index].name == name) { return index + 1 }
        index = index + 1
    }
    return 0
}

fn CheckProjectionType(&expected: TypeNameBinding, &actual: TypeNameBinding, at: Span): null! {
    if (expected.name != actual.name) {
        RejectLayout("projection_type_mismatch", "type error: expected " + expected.name.clone() + " but got " + actual.name.clone(), at)?
    }
    return ok(null)
}

fn ProjectionOperand(&nodes: [Node], &edges: [int], &layouts: [StructLayout],
                     &parameters: [StructParameter], &expected: StructFieldLayout, value_id: int): StructProjection! {
    value = nodes[value_id - 1].clone()
    at = DeclarationSpan(value)
    if (value.kind != "Field" || value.edge_count != 1) {
        RejectLayout("unsupported_projection", "expected a field read from a parameter", at.clone())?
    }
    receiver = nodes[edges[value.first_edge] - 1].clone()
    parameter = ParameterIndex(parameters, receiver.text)
    if (receiver.kind != "Variable" || parameter == 0) {
        RejectLayout("unsupported_projection", "expected a struct parameter as the field receiver", DeclarationSpan(receiver))?
    }
    source = parameters[parameter - 1].clone()
    layout = LayoutIndex(layouts, source.layout_module, source.layout_node)
    input_field = FieldIndex(layouts[layout - 1].fields, value.text)
    if (input_field == 0) {
        RejectLayout("unknown_projection_field", "struct '" + layouts[layout - 1].name.clone() + "' has no field '" + value.text.clone() + "'", at.clone())?
    }
    field = layouts[layout - 1].fields[input_field - 1].clone()
    CheckProjectionType(expected.resolved, field.resolved, at)?
    return ok(StructProjection { output_field: expected.ordinal, parameter: parameter - 1, input_field: field.ordinal, value_node: value_id })
}

fn ProjectFields(&nodes: [Node], &edges: [int], &layouts: [StructLayout],
                 &parameters: [StructParameter], &expected: StructLayout, &literal: Node): [StructProjection]! {
    projected: [StructProjection] = []
    seen: [int] = []
    index = 0
    while (index < literal.edge_count) {
        item = nodes[edges[literal.first_edge + index] - 1].clone()
        if (item.kind != "StructLiteralField" || item.edge_count != 1) {
            RejectLayout("unsupported_projection", "expected a struct literal field", DeclarationSpan(item))?
        }
        value_id = edges[item.first_edge]
        at = DeclarationSpan(nodes[value_id - 1])
        field = FieldIndex(expected.fields, item.text)
        if (field == 0) {
            RejectLayout("unknown_literal_field", "struct '" + expected.name.clone() + "' has no field '" + item.text.clone() + "'", at.clone())?
        }
        previous = 0
        while (previous < seen.len()) {
            if (seen[previous] == field) {
                RejectLayout("duplicate_literal_field", "duplicate field '" + item.text.clone() + "' in struct literal", at.clone())?
            }
            previous = previous + 1
        }
        projection = ProjectionOperand(nodes, edges, layouts, parameters, expected.fields[field - 1], value_id)?
        projected = projected.push(projection)
        seen = seen.push(field)
        index = index + 1
    }
    index = 0
    while (index < expected.fields.len()) {
        previous = 0
        present = false
        while (previous < seen.len()) {
            if (seen[previous] == index + 1) { present = true }
            previous = previous + 1
        }
        if (!present) {
            name = expected.fields[index].name.clone()
            RejectLayout("missing_literal_field", "missing field '" + name + "' in struct literal '" + expected.name.clone() + "'", DeclarationSpan(literal))?
        }
        index = index + 1
    }
    return ok(projected)
}

fn ProjectionPlan(&nodes: [Node], &edges: [int], &bindings: [TypeNameBinding],
                  &layouts: [StructLayout], function_id: int): StructReturnPlan! {
    function = nodes[function_id - 1].clone()
    at = DeclarationSpan(function)
    parameters: [StructParameter] = []
    cursor = function.first_edge
    end = cursor + function.edge_count
    while (cursor < end && nodes[edges[cursor] - 1].kind == "Parameter") {
        parameter = nodes[edges[cursor] - 1].clone()
        position = DeclarationSpan(parameter)
        if (parameter.edge_count != 1) {
            RejectLayout("unsupported_projection_signature", "struct projection parameters need explicit types", position.clone())?
        }
        if (ParameterIndex(parameters, parameter.text) != 0) {
            RejectLayout("duplicate_projection_parameter", "duplicate function parameter '" + parameter.text.clone() + "'", position.clone())?
        }
        resolved = ExplicitType(bindings, edges[parameter.first_edge], position.clone())?
        layout = CheckedLayout(layouts, resolved, true, position)?
        entry = StructParameter { name: parameter.text, mode: parameter.int_value,
                                  layout_module: layouts[layout - 1].module_index, layout_node: layouts[layout - 1].node }
        parameters = parameters.push(entry)
        cursor = cursor + 1
    }
    if (end - cursor != 2) {
        RejectLayout("unsupported_projection_body", "expected an explicit result type and a single return statement", at.clone())?
    }
    result = ExplicitType(bindings, edges[cursor], at.clone())?
    layout = CheckedLayout(layouts, result, false, at.clone())?
    statement = nodes[edges[cursor + 1] - 1].clone()
    if (statement.kind != "Return" || statement.edge_count != 1) {
        RejectLayout("unsupported_projection_body", "expected a return of a struct literal", DeclarationSpan(statement))?
    }
    literal = nodes[edges[statement.first_edge] - 1].clone()
    expected = layouts[layout - 1].clone()
    if (literal.kind != "StructLiteral" || literal.text != expected.name) {
        RejectLayout("unsupported_projection_body", "returned literal must match the declared local struct", DeclarationSpan(literal))?
    }
    projections = ProjectFields(nodes, edges, layouts, parameters, expected, literal)?
    return ok(StructReturnPlan { function_name: function.text, function_node: function_id,
                                result_layout: expected.node, parameters: parameters, projections: projections })
}

// The caller selects a function. No parser, interpreter or runtime fallback
// is used when its shape is outside this projection-return subset.
fn BindStructReturn(&named: NamedModule, &bindings: [TypeNameBinding], &layouts: [StructLayout],
                    &function_name: str): StructReturnPlan! {
    count = named.names.declarations.len()
    index = 0
    while (index < count) {
        declaration = named.names.declarations[index].clone()
        if (declaration.kind == "Function" && declaration.name == function_name) {
            function_id = declaration.node
            return ProjectionPlan(named.parsed.arena.nodes, named.parsed.arena.edges,
                                  bindings, layouts, function_id)
        }
        index = index + 1
    }
    start = Span { line: 1, column: 1, offset: 0, end_line: 1, end_column: 1, end_offset: 0 }
    RejectLayout("unknown_projection_function", "undefined function '" + function_name.clone() + "'", start)?
    return ok(StructReturnPlan { function_name: "", function_node: 0, result_layout: 0, parameters: [], projections: [] })
}

struct LinkedErrorInitializerField {
    name: str
    expression: int
}

struct LinkedErrorInitializer {
    fields: [LinkedErrorInitializerField]
    scratch: bool
}

fn isLinkedErrorMember(&name: str): bool {
    return name == "domain" || name == "code" || name == "message"
}

fn ReadLinkedErrorMember(&owner: str, &name: str, &moved: [str], at: Span): str! {
    if (!isLinkedErrorMember(name)) {
        RejectLayout("linked_error_member", "expected a caught Error field", at.clone())?
    }
    member = owner.clone() + "." + name.clone()
    index = 0
    while (index < moved.len()) {
        if (moved[index] == member) {
            RejectLayout("linked_error_member_moved", "caught Error field already moved", at.clone())?
        }
        index = index + 1
    }
    return ok(member)
}

fn ReadLinkedErrorInitializer(&named: NamedModule, &literal: Node): LinkedErrorInitializer! {
    if (literal.kind != "ObjectLiteral" || literal.edge_count != 3) {
        RejectLayout("unsupported_linked_error", "expected Error domain, code and message", DeclarationSpan(literal))?
    }
    fields: [LinkedErrorInitializerField] = []
    scratch = false
    index = 0
    while (index < literal.edge_count) {
        field = named.parsed.arena.nodes[named.parsed.arena.edges[literal.first_edge + index] - 1].clone()
        repeat = false
        for existing in fields {
            if (existing.name == field.text) { repeat = true }
        }
        if (field.kind != "ObjectLiteralField" || field.edge_count != 1 || !isLinkedErrorMember(field.text) || repeat) {
            RejectLayout("invalid_linked_error_field", "expected each named Error field once", DeclarationSpan(field))?
        }
        expression = named.parsed.arena.edges[field.first_edge]
        operand = named.parsed.arena.nodes[expression - 1].clone()
        scratch = scratch || operand.edge_count != 0 || (operand.kind != "Variable" && operand.kind != "String")
        fields = fields.push(LinkedErrorInitializerField { name: field.text, expression: expression })
        index = index + 1
    }
    return ok(LinkedErrorInitializer { fields: fields, scratch: scratch })
}
