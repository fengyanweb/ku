import { Node } from "../stage2/ast.ku"
import { Span } from "../stage2/span.ku"
import { DeclarationSpan, NamedModule, TopLevelName } from "./names.ku"
import { TypeNameBinding } from "./type_names.ku"
import { ScalarIntInstruction, ScalarIntParameter, ScalarIntClause, ScalarIntFunction, ScalarStringPart, ScalarIntegerHelpers, ScalarStringHelpers, ScalarSymbol, EmitScalarIntPlan } from "./scalar_int_emit.ku"
import { RejectScalarInt as rejectScalarInt, ScalarParameterIndex as scalarParameterIndex,
    ScalarStringLiteral as scalarStringLiteral, ScalarStringOperand as scalarStringOperand,
    HasScalarStringConversion, LowerScalarStringParts } from "./scalar_int_operands.ku"

struct ScalarIntCall {
    target_node: int
    function_node: int
    arguments: [int]
}

struct ScalarBoolC {
    source: str
    uses_string_comparison: bool
    uses_string_contains: bool
}

struct ScalarIntC {
    symbol: str
    source: str
}

fn scalarType(&bindings: [TypeNameBinding], use_node: int, &ty: Node): int {
    lo = 0
    hi = bindings.len()
    while (lo < hi) {
        middle = lo + (hi - lo) / 2
        if (bindings[middle].use_node < use_node) { lo = middle + 1 }
        else { hi = middle }
    }
    if (ty.kind == "TypeName" && lo < bindings.len() && bindings[lo].use_node == use_node
        && bindings[lo].declaration_kind == "Builtin") {
        if (bindings[lo].name == "int") { return 1 }
        if (bindings[lo].name == "str") { return 2 }
        if (bindings[lo].name == "bool") { return 3 }
    }
    return 0
}

fn requireInt(&bindings: [TypeNameBinding], use_node: int, &ty: Node): null! {
    if (scalarType(bindings, use_node, ty) != 1) {
        rejectScalarInt("unsupported_int_type", "expected a bound builtin int type", DeclarationSpan(ty))?
    }
    return ok(null)
}

fn scalarFunctionNode(&declarations: [TopLevelName], &name: str): int {
    index = 0
    while (index < declarations.len()) {
        if (declarations[index].kind == "Function" && declarations[index].name == name) {
            return declarations[index].node
        }
        index = index + 1
    }
    return 0
}

fn bindIntCall(&nodes: [Node], &edges: [int], &declarations: [TopLevelName],
               &bindings: [TypeNameBinding], &parameters: [ScalarIntParameter], &call: Node): ScalarIntCall! {
    if (call.edge_count == 0) {
        rejectScalarInt("unsupported_int_callee", "expected a direct local function call", DeclarationSpan(call))?
    }
    target_node = edges[call.first_edge]
    target = nodes[target_node - 1].clone()
    if (target.kind != "Variable" || target.edge_count != 0 || scalarParameterIndex(parameters, target.text) >= 0) {
        rejectScalarInt("unsupported_int_callee", "expected an unshadowed local function name", DeclarationSpan(target))?
    }
    function_node = scalarFunctionNode(declarations, target.text)
    if (function_node == 0) {
        rejectScalarInt("unknown_int_callee", "no local function '" + target.text.clone() + "'", DeclarationSpan(target))?
    }
    function = nodes[function_node - 1].clone()
    arity = 0
    while (arity < function.edge_count && nodes[edges[function.first_edge + arity] - 1].kind == "Parameter") {
        parameter = nodes[edges[function.first_edge + arity] - 1].clone()
        if (parameter.edge_count == 1) {
            type_node = edges[parameter.first_edge]
            if (scalarType(bindings, type_node, nodes[type_node - 1]) == 2) {
                rejectScalarInt("unsupported_int_callee_signature", "calls in the int subset cannot transfer string parameters", DeclarationSpan(call))?
            }
        }
        arity = arity + 1
    }
    if (call.edge_count - 1 != arity) {
        rejectScalarInt("int_call_arity", "expected " + str(arity) + " arguments for '" + target.text + "'", DeclarationSpan(call))?
    }
    if (arity < function.edge_count) {
        result_node = edges[function.first_edge + arity]
        result_type = scalarType(bindings, result_node, nodes[result_node - 1])
        if (result_type == 2 || result_type == 3) {
            rejectScalarInt("unsupported_int_callee_result", "calls in an int expression must return int", DeclarationSpan(call))?
        }
    }
    arguments: [int] = []
    index = 1
    while (index < call.edge_count) {
        argument = edges[call.first_edge + index]
        arguments = arguments.push(argument)
        index = index + 1
    }
    return ok(ScalarIntCall { target_node: target_node, function_node: function_node, arguments: arguments })
}

fn isIntCallTarget(&calls: [ScalarIntCall], node: int): bool {
    index = 0
    while (index < calls.len()) {
        if (calls[index].target_node == node) { return true }
        index = index + 1
    }
    return false
}

fn lowerIntExpression(&nodes: [Node], &edges: [int], &declarations: [TopLevelName],
                      &bindings: [TypeNameBinding], &parameters: [ScalarIntParameter], result_node: int): [ScalarIntInstruction]! {
    // BuildNameTable validated a contiguous post-order tree. The first child
    // chain reaches its leftmost leaf, and every node in that range belongs
    // to this expression. Neither a recursive stack nor a copied AST is needed.
    cursor = result_node
    while (nodes[cursor - 1].edge_count > 0) {
        cursor = edges[nodes[cursor - 1].first_edge]
    }
    calls: [ScalarIntCall] = []
    probe = cursor
    while (probe <= result_node) {
        if (nodes[probe - 1].kind == "Call") {
            call = bindIntCall(nodes, edges, declarations, bindings, parameters, nodes[probe - 1])?
            calls = calls.push(call)
        }
        probe = probe + 1
    }
    instructions: [ScalarIntInstruction] = []
    call_index = 0
    while (cursor <= result_node) {
        node = nodes[cursor - 1].clone()
        operation = ""
        operand = 0
        right_node = 0
        arguments: [int] = []
        if (node.kind == "Int" && node.edge_count == 0 && node.int_value >= 0) {
            operation = "constant"
            operand = node.int_value
        } else if (node.kind == "Variable" && node.edge_count == 0) {
            // The validated AST is a tree, so only the Call can consume this
            // particular identifier. It needs no value or C temporary.
            if (isIntCallTarget(calls, cursor)) {
                cursor = cursor + 1
                continue
            }
            operation = "parameter"
            operand = scalarParameterIndex(parameters, node.text)
            if (operand < 0) {
                rejectScalarInt("undefined_int_operand", "undefined int parameter '" + node.text.clone() + "'", DeclarationSpan(node))?
            }
            if (parameters[operand].string_mode != 0) {
                rejectScalarInt("unsupported_int_operand_type", "expected an int operand, found str", DeclarationSpan(node))?
            }
        } else if (node.kind == "Unary" && node.edge_count == 1 && node.text == "-") {
            operation = "sub"
            right_node = edges[node.first_edge]
        } else if (node.kind == "Binary" && node.edge_count == 2) {
            if (node.text == "+") { operation = "add" }
            else if (node.text == "-") { operation = "sub" }
            else if (node.text == "*") { operation = "mul" }
            operand = edges[node.first_edge]
            right_node = edges[node.first_edge + 1]
        } else if (node.kind == "Call") {
            call = calls[call_index].clone()
            call_index = call_index + 1
            operation = "call"
            operand = call.function_node
            arguments = call.arguments
        }
        if (operation == "") {
            rejectScalarInt("unsupported_int_expression", "expected an int literal, parameter, arithmetic, or direct int call", DeclarationSpan(node))?
        }
        instruction = ScalarIntInstruction { operation: operation, result_node: cursor, operand: operand,
                                            right_node: right_node, arguments: arguments }
        instructions = instructions.push(instruction)
        cursor = cursor + 1
    }
    return ok(instructions)
}

fn lowerScalarBool(&nodes: [Node], &edges: [int], &parameters: [ScalarIntParameter], node_id: int, depth: int): ScalarBoolC! {
    node = nodes[node_id - 1].clone()
    // The parser bounds parentheses and prefix chains. Binary chains can
    // be deeper without parentheses, so bound this emitter's descent too.
    if (depth >= 32) {
        rejectScalarInt("bool_depth_limit", "standalone C boolean expressions accept at most 32 levels", DeclarationSpan(node))?
    }
    if (node.kind == "Bool" && node.edge_count == 0) {
        literal = "0"
        if (node.text == "true") { literal = "1" }
        return ok(ScalarBoolC { source: literal, uses_string_comparison: false, uses_string_contains: false })
    }
    if (node.kind == "Unary" && node.edge_count == 1 && node.text == "!") {
        child = lowerScalarBool(nodes, edges, parameters, edges[node.first_edge], depth + 1)?
        return ok(ScalarBoolC { source: "(!" + child.source + ")", uses_string_comparison: child.uses_string_comparison,
            uses_string_contains: child.uses_string_contains })
    }
    if (node.kind == "Binary" && node.edge_count == 2) {
        left_id = edges[node.first_edge]
        right_id = edges[node.first_edge + 1]
        if (node.text == "&&" || node.text == "||") {
            left = lowerScalarBool(nodes, edges, parameters, left_id, depth + 1)?
            right = lowerScalarBool(nodes, edges, parameters, right_id, depth + 1)?
            // Keep evaluation of the right operand inside C's short circuit.
            return ok(ScalarBoolC { source: "(" + left.source + " " + node.text + " " + right.source + ")",
                uses_string_comparison: left.uses_string_comparison || right.uses_string_comparison,
                uses_string_contains: left.uses_string_contains || right.uses_string_contains })
        }
        if (node.text == "==" || node.text == "!=") {
            left = scalarStringOperand(parameters, nodes[left_id - 1])?
            right = scalarStringOperand(parameters, nodes[right_id - 1])?
            prefix = ""
            if (node.text == "!=") { prefix = "!" }
            return ok(ScalarBoolC { source: prefix + "ku_scalar_string_equal(" + left + ", " + right + ")",
                uses_string_comparison: true, uses_string_contains: false })
        }
    }
    if (node.kind == "Call" && node.edge_count == 2) {
        target = nodes[edges[node.first_edge] - 1].clone()
        if (target.kind == "Field" && target.edge_count == 1 && target.text == "contains") {
            // Both operands are checked string literals or pure parameter
            // reads, so C's argument order cannot reorder effects.
            hay = scalarStringOperand(parameters, nodes[edges[target.first_edge] - 1])?
            needle = scalarStringOperand(parameters, nodes[edges[node.first_edge + 1] - 1])?
            return ok(ScalarBoolC { source: "ku_scalar_string_contains(" + hay + ", " + needle + ")",
                uses_string_comparison: false, uses_string_contains: true })
        }
    }
    rejectScalarInt("unsupported_bool_expression", "expected a bool literal, logical operator, string comparison, or str.contains call", DeclarationSpan(node))?
    return ok(ScalarBoolC { source: "", uses_string_comparison: false, uses_string_contains: false })
}

fn lowerScalarIntFunction(&nodes: [Node], &edges: [int], &declarations: [TopLevelName],
                          &bindings: [TypeNameBinding], function_id: int, can_convert: bool): ScalarIntFunction! {
    function = nodes[function_id - 1].clone()
    cursor = function.first_edge
    end = cursor + function.edge_count
    parameters: [ScalarIntParameter] = []
    has_string = false
    while (cursor < end && nodes[edges[cursor] - 1].kind == "Parameter") {
        parameter = nodes[edges[cursor] - 1].clone()
        if (parameter.edge_count != 1 || parameter.int_value < 0 || parameter.int_value > 1) {
            rejectScalarInt("unsupported_int_signature", "expected an explicitly typed int, str or &str parameter", DeclarationSpan(parameter))?
        }
        if (scalarParameterIndex(parameters, parameter.text) >= 0) {
            rejectScalarInt("duplicate_int_parameter", "duplicate function parameter '" + parameter.text.clone() + "'", DeclarationSpan(parameter))?
        }
        type_id = edges[parameter.first_edge]
        string_mode = 0
        if (scalarType(bindings, type_id, nodes[type_id - 1]) == 2) {
            string_mode = parameter.int_value + 1
            has_string = true
        } else {
            requireInt(bindings, type_id, nodes[type_id - 1])?
            if (parameter.int_value != 0) {
                rejectScalarInt("unsupported_int_signature", "the int subset requires by-value int parameters", DeclarationSpan(parameter))?
            }
        }
        parameters = parameters.push(ScalarIntParameter { name: parameter.text, string_mode: string_mode })
        cursor = cursor + 1
    }
    if (end - cursor < 2) {
        rejectScalarInt("unsupported_int_body", "expected an explicit scalar result type and a final return", DeclarationSpan(function))?
    }
    type_id = edges[cursor]
    result_type = scalarType(bindings, type_id, nodes[type_id - 1])
    if (result_type == 0) { requireInt(bindings, type_id, nodes[type_id - 1])? }
    cursor = cursor + 1
    clauses: [ScalarIntClause] = []
    uses_comparison = false
    uses_contains = false
    uses_join = false
    while (cursor < end) {
        statement = nodes[edges[cursor] - 1].clone()
        condition = ""
        if (cursor < end - 1) {
            if (statement.kind != "If" || statement.edge_count != 2 || statement.int_value != 1) {
                rejectScalarInt("unsupported_int_body", "expected a guarded return with no else before the final return", DeclarationSpan(statement))?
            }
            guard = lowerScalarBool(nodes, edges, parameters, edges[statement.first_edge], 0)?
            condition = guard.source
            uses_comparison = uses_comparison || guard.uses_string_comparison
            uses_contains = uses_contains || guard.uses_string_contains
            return_node = edges[statement.first_edge + 1]
            statement = nodes[return_node - 1].clone()
        }
        if (statement.kind != "Return" || statement.edge_count != 1) {
            rejectScalarInt("unsupported_int_body", "expected a return with one value", DeclarationSpan(statement))?
        }
        result_node = edges[statement.first_edge]
        result = nodes[result_node - 1].clone()
        instructions: [ScalarIntInstruction] = []
        scalar_result = ""
        string_parts: [ScalarStringPart] = []
        if (result_type == 2) {
            if (result.kind == "String" && result.edge_count == 0) {
                scalar_result = "(KuBootstrapString){ (uint8_t*)" + scalarStringLiteral(result)? + ", 0u, 0u }"
            } else {
                string_parts = LowerScalarStringParts(nodes, edges, parameters, can_convert, result_node)?
                uses_join = true
            }
        } else if (result_type == 3) {
            boolean = lowerScalarBool(nodes, edges, parameters, result_node, 0)?
            scalar_result = boolean.source
            uses_comparison = uses_comparison || boolean.uses_string_comparison
            uses_contains = uses_contains || boolean.uses_string_contains
        } else {
            // No trapped expression can bypass the owned-parameter cleanup.
            if (has_string && (result.kind != "Int" && result.kind != "Variable")) {
                rejectScalarInt("unsupported_string_leaf_return", "functions with str parameters return an int literal or parameter", DeclarationSpan(result))?
            }
            instructions = lowerIntExpression(nodes, edges, declarations, bindings, parameters, result_node)?
        }
        clauses = clauses.push(ScalarIntClause { condition: condition, instructions: instructions,
            scalar_result: scalar_result, string_parts: string_parts })
        cursor = cursor + 1
    }
    return ok(ScalarIntFunction { function_node: function_id, parameters: parameters, clauses: clauses,
        result_type: result_type, uses_string_comparison: uses_comparison, uses_string_contains: uses_contains,
        uses_string_join: uses_join })
}

fn containsIntNode(&nodes: [int], node: int): bool {
    index = 0
    while (index < nodes.len()) {
        if (nodes[index] == node) { return true }
        index = index + 1
    }
    return false
}

fn planScalarIntModule(&nodes: [Node], &edges: [int], &declarations: [TopLevelName],
                       &bindings: [TypeNameBinding], entry: int, can_convert: bool): [ScalarIntFunction]! {
    reachable = [entry]
    plans: [ScalarIntFunction] = []
    index = 0
    while (index < reachable.len()) {
        plan = lowerScalarIntFunction(nodes, edges, declarations, bindings, reachable[index], can_convert)?
        clause = 0
        while (clause < plan.clauses.len()) {
            step = 0
            while (step < plan.clauses[clause].instructions.len()) {
                if (plan.clauses[clause].instructions[step].operation == "call") {
                    callee = plan.clauses[clause].instructions[step].operand
                    if (!containsIntNode(reachable, callee)) { reachable = reachable.push(callee) }
                }
                step = step + 1
            }
            clause = clause + 1
        }
        plans = plans.push(plan)
        index = index + 1
    }
    return ok(plans)
}

fn unresolvedIntCall(&plan: ScalarIntFunction, &completed: [int]): int {
    clause = 0
    while (clause < plan.clauses.len()) {
        index = 0
        while (index < plan.clauses[clause].instructions.len()) {
            if (plan.clauses[clause].instructions[index].operation == "call" && !containsIntNode(completed, plan.clauses[clause].instructions[index].operand)) {
                return plan.clauses[clause].instructions[index].result_node
            }
            index = index + 1
        }
        clause = clause + 1
    }
    return 0
}

fn emitScalarIntModule(&plans: [ScalarIntFunction], &nodes: [Node], entry: int): ScalarIntC! {
    // Each round removes ready functions. If nothing is ready, following
    // unresolved edges among the remaining finite set must encounter a cycle.
    completed: [int] = []
    uses_add = false
    uses_sub = false
    uses_mul = false
    uses_string = false
    uses_string_comparison = false
    uses_string_contains = false
    uses_owned_string = false
    uses_string_join = false
    uses_string_format = false
    returns_bool = false
    text = ""
    symbol = ""
    while (completed.len() < plans.len()) {
        blocked_at = 0
        before = completed.len()
        index = 0
        while (index < plans.len()) {
            function_node = plans[index].function_node
            if (!containsIntNode(completed, function_node)) {
                blocked = unresolvedIntCall(plans[index], completed)
                if (blocked == 0) {
                    if (function_node == entry) {
                        symbol = ScalarSymbol(entry, plans[index].result_type)
                        returns_bool = plans[index].result_type == 3
                    }
                    body = EmitScalarIntPlan(plans[index], function_node == entry)
                    uses_add = uses_add || body.uses_add
                    uses_sub = uses_sub || body.uses_sub
                    uses_mul = uses_mul || body.uses_mul
                    uses_string = uses_string || body.uses_string
                    uses_string_comparison = uses_string_comparison || body.uses_string_comparison
                    uses_string_contains = uses_string_contains || body.uses_string_contains
                    uses_owned_string = uses_owned_string || body.uses_owned_string
                    uses_string_join = uses_string_join || plans[index].uses_string_join
                    uses_string_format = uses_string_format || body.uses_string_format
                    text += body.source
                    completed = completed.push(function_node)
                } else {
                    blocked_at = blocked
                }
            }
            index = index + 1
        }
        if (completed.len() == before) {
            rejectScalarInt("recursive_int_call", "recursive call graph is outside the bootstrap int subset",
                            DeclarationSpan(nodes[blocked_at - 1]))?
        }
    }
    headers = ScalarIntegerHelpers(uses_add, uses_sub, uses_mul)
    if (returns_bool || uses_string_contains) { headers += "#include <stdbool.h>\n" }
    return ok(ScalarIntC { symbol: symbol, source: headers
        + ScalarStringHelpers(uses_string, uses_string_comparison, uses_string_contains,
            uses_owned_string, uses_string_join, uses_string_format) + text })
}

// The selected function is the only external symbol. Every reachable local
// callee must also be a checked int function. String and bool results are leaf expressions.
fn EmitScalarIntC(&named: NamedModule, &bindings: [TypeNameBinding], &function_name: str): ScalarIntC! {
    entry = scalarFunctionNode(named.names.declarations, function_name)
    if (entry > 0) {
        plans = planScalarIntModule(named.parsed.arena.nodes, named.parsed.arena.edges,
                                    named.names.declarations, bindings, entry, HasScalarStringConversion(named))?
        return emitScalarIntModule(plans, named.parsed.arena.nodes, entry)
    }
    start = Span { line: 1, column: 1, offset: 0, end_line: 1, end_column: 1, end_offset: 0 }
    rejectScalarInt("unknown_int_function", "undefined function '" + function_name.clone() + "'", start)?
    return ok(ScalarIntC { symbol: "", source: "" })
}
