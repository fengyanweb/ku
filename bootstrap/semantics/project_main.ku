import "std.fs"
import { EscapeCanonical } from "../stage1/token.ku"
import { Span } from "../stage2/span.ku"
import { ManifestPaths, ReadProjectModules } from "./project_manifest.ku"
import { BindProjectModules } from "./project_bindings.ku"

fn main(): null! {
    at = Span { line: 1, column: 1, offset: 0, end_line: 1, end_column: 1, end_offset: 0 }
    paths = ManifestPaths(fs.read("modules.txt")?, at)?
    supplied = ReadProjectModules(paths)?
    project = BindProjectModules(supplied)?
    order = project.order
    modules = project.modules
    for index in order {
        entry = modules[index].clone()
        display_path = EscapeCanonical(entry.path)
        println("MODULE|" + display_path.clone())
        for binding in entry.imports {
            if (binding.module_index == 0) {
                println("STD|" + display_path.clone() + "|" + binding.local_name + "|" + str(binding.import_node) + "|" + str(binding.request_node))
            } else {
                target = EscapeCanonical(paths[binding.module_index - 1].clone())
                println("IMPORT|" + display_path.clone() + "|" + binding.local_name + "|" + target + "|" + binding.source_name + "|" + str(binding.target_node))
            }
        }
        for binding in entry.types {
            if (binding.module_index > 0) {
                target = EscapeCanonical(paths[binding.module_index - 1].clone())
                println("TYPE|" + display_path.clone() + "|" + binding.name + "|" + target + "|" + str(binding.use_node) + "|" + str(binding.declaration_node))
            }
        }
    }
    return ok(null)
}
