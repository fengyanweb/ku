import { bytes } from "std"
import { Node } from "../stage2/ast.ku"
import { DiagnosticCanonical, MakeDiagnostic } from "../stage2/diagnostic.ku"
import { Span } from "../stage2/span.ku"
import { DeclarationSpan, NamedModule } from "./names.ku"
import { ScalarIntParameter, ScalarStringPart } from "./scalar_int_emit.ku"

fn RejectScalarInt(code: str, message: str, span: Span): null! {
    domain = "bootstrap.semantics.int"
    diagnostic = MakeDiagnostic("error", domain.clone(), code.clone(), message, "<source>", span)
    fail { domain: domain, code: code, message: DiagnosticCanonical(diagnostic) }
}

fn ScalarParameterIndex(&parameters: [ScalarIntParameter], &name: str): int {
    index = 0
    while (index < parameters.len()) {
        if (parameters[index].name == name) { return index }
        index = index + 1
    }
    return 0 - 1
}

struct ScalarLiteral {
    kind: str
    text: str
}

fn ScalarValueLiteralC(&node: Node): ScalarLiteral! {
    if (node.kind == "String" && node.edge_count == 0) {
        value = "(KuProjectionString){(uint8_t*)" + ScalarStringLiteral(node)? + ", 0u, KU_PROJECTION_STRING_STATIC}"
        return ok(ScalarLiteral { kind: "str", text: value })
    }
    if (node.kind == "Bool" && node.edge_count == 0 && (node.text == "true" || node.text == "false")) {
        return ok(ScalarLiteral { kind: "bool", text: node.text.clone() })
    }
    if (node.kind == "Int" && node.edge_count == 0 && node.int_value >= 0) {
        return ok(ScalarLiteral { kind: "int", text: "INT64_C(" + str(node.int_value) + ")" })
    }
    return ok(ScalarLiteral { kind: "", text: "" })
}

// Decimal source bytes never enter a C identifier or an unescaped literal.
// Three-digit C octal escapes preserve all UTF-8 bytes and embedded zeros.
fn ScalarStringLiteral(&node: Node): str! {
    encoded = bytes.from_str(node.text.clone())?
    length = encoded.len()
    if (length > 4095) {
        RejectScalarInt("string_literal_limit", "standalone C accepts at most 4095 bytes in a string literal", DeclarationSpan(node))?
    }
    literal = "\""
    index = 0
    while (index < length) {
        byte = encoded.get(index)?
        high = byte / 64
        pair = byte / 8
        literal += "\\" + str(high) + str(pair - high * 8) + str(byte - pair * 8)
        index = index + 1
    }
    return ok(literal + "\", " + str(length) + "u")
}

fn ScalarStringOperand(&parameters: [ScalarIntParameter], &node: Node): str! {
    if (node.kind == "String" && node.edge_count == 0) {
        return ok("(const uint8_t*)" + ScalarStringLiteral(node)?)
    }
    if (node.kind == "Variable" && node.edge_count == 0) {
        index = ScalarParameterIndex(parameters, node.text)
        if (index >= 0 && parameters[index].string_mode != 0) {
            access = "."
            if (parameters[index].string_mode == 2) { access = "->" }
            name = "a" + str(index)
            return ok(name.clone() + access.clone() + "ptr, " + name + access + "len")
        }
    }
    RejectScalarInt("unsupported_string_operand", "expected a bound str parameter or string literal", DeclarationSpan(node))?
    return ok("")
}

// A local declaration or imported alias can shadow a builtin call.
fn HasScalarBuiltin(&named: NamedModule, &name: str): bool {
    declaration_count = named.names.declarations.len()
    index = 0
    while (index < declaration_count) {
        if (named.names.declarations[index].name == name) { return false }
        index = index + 1
    }
    import_count = named.names.imports.len()
    import_index = 0
    while (import_index < import_count) {
        group = named.parsed.arena.nodes[named.names.imports[import_index] - 1].clone()
        child = 0
        while (child < group.edge_count) {
            request = named.parsed.arena.nodes[named.parsed.arena.edges[group.first_edge + child] - 1].clone()
            if (request.edge_count == 1) {
                alias = named.parsed.arena.edges[request.first_edge]
                if (named.parsed.arena.nodes[alias - 1].text == name) { return false }
            } else if (request.text == name) { return false }
            child = child + 1
        }
        import_index = import_index + 1
    }
    return true
}

fn knownScalarIntegerOperand(&nodes: [Node], &edges: [int], &parameters: [ScalarIntParameter], &value: Node): str {
    if (value.kind == "Variable" && value.edge_count == 0) {
        index = ScalarParameterIndex(parameters, value.text)
        if (index >= 0 && parameters[index].string_mode == 0) {
            return "a" + str(index)
        }
    }
    if (value.kind == "Int" && value.edge_count == 0 && value.int_value >= 0) {
        return "INT64_C(" + str(value.int_value) + ")"
    }
    if (value.kind == "Unary" && value.text == "-" && value.edge_count == 1) {
        literal = nodes[edges[value.first_edge] - 1].clone()
        if (literal.kind == "Int" && literal.edge_count == 0 && literal.int_value >= 0) {
            return "-INT64_C(" + str(literal.int_value) + ")"
        }
    }
    return ""
}

fn scalarStringInteger(&nodes: [Node], &edges: [int], &parameters: [ScalarIntParameter], &value: Node): str! {
    source = knownScalarIntegerOperand(nodes, edges, parameters, value)
    if (source == "") {
        RejectScalarInt("unsupported_string_int_operand", "expected an int parameter or literal in str conversion", DeclarationSpan(value))?
    }
    return ok(source)
}

fn ScalarIntComparison(&nodes: [Node], &edges: [int], &parameters: [ScalarIntParameter], &operator: Node): str! {
    ordered = operator.text == "<" || operator.text == "<=" || operator.text == ">" || operator.text == ">="
    if (!ordered && operator.text != "==" && operator.text != "!=") { return ok("") }
    left_node = nodes[edges[operator.first_edge] - 1].clone()
    right_node = nodes[edges[operator.first_edge + 1] - 1].clone()
    left = knownScalarIntegerOperand(nodes, edges, parameters, left_node)
    right = knownScalarIntegerOperand(nodes, edges, parameters, right_node)
    if (left != "" && right != "") {
        return ok("(" + left + " " + operator.text.clone() + " " + right + ")")
    }
    if (ordered) {
        at = DeclarationSpan(left_node)
        if (left != "") { at = DeclarationSpan(right_node) }
        RejectScalarInt("unsupported_int_comparison", "expected an int literal or parameter in ordered comparison", at)?
    }
    // Preserve the existing string equality path and diagnostics.
    return ok("")
}

struct ScalarBoolC {
    source: str
    uses_string_comparison: bool
    uses_string_contains: bool
}

fn LowerScalarBool(&nodes: [Node], &edges: [int], &parameters: [ScalarIntParameter], node_id: int, depth: int): ScalarBoolC! {
    node = nodes[node_id - 1].clone()
    // The parser bounds parentheses and prefix chains. Binary chains can
    // be deeper without parentheses, so bound this emitter's descent too.
    if (depth >= 32) {
        RejectScalarInt("bool_depth_limit", "standalone C boolean expressions accept at most 32 levels", DeclarationSpan(node))?
    }
    if (node.kind == "Bool" && node.edge_count == 0) {
        literal = "0"
        if (node.text == "true") { literal = "1" }
        return ok(ScalarBoolC { source: literal, uses_string_comparison: false, uses_string_contains: false })
    }
    if (node.kind == "Unary" && node.edge_count == 1 && node.text == "!") {
        child = LowerScalarBool(nodes, edges, parameters, edges[node.first_edge], depth + 1)?
        return ok(ScalarBoolC { source: "(!" + child.source + ")", uses_string_comparison: child.uses_string_comparison,
            uses_string_contains: child.uses_string_contains })
    }
    if (node.kind == "Binary" && node.edge_count == 2) {
        left_id = edges[node.first_edge]
        right_id = edges[node.first_edge + 1]
        if (node.text == "&&" || node.text == "||") {
            left = LowerScalarBool(nodes, edges, parameters, left_id, depth + 1)?
            right = LowerScalarBool(nodes, edges, parameters, right_id, depth + 1)?
            // Keep evaluation of the right operand inside C's short circuit.
            return ok(ScalarBoolC { source: "(" + left.source + " " + node.text + " " + right.source + ")",
                uses_string_comparison: left.uses_string_comparison || right.uses_string_comparison,
                uses_string_contains: left.uses_string_contains || right.uses_string_contains })
        }
        comparison = ScalarIntComparison(nodes, edges, parameters, node)?
        if (comparison != "") {
            return ok(ScalarBoolC { source: comparison, uses_string_comparison: false, uses_string_contains: false })
        }
        if (node.text == "==" || node.text == "!=") {
            left = ScalarStringOperand(parameters, nodes[left_id - 1])?
            right = ScalarStringOperand(parameters, nodes[right_id - 1])?
            prefix = ""
            if (node.text == "!=") { prefix = "!" }
            return ok(ScalarBoolC { source: prefix + "ku_scalar_string_equal(" + left + ", " + right + ")",
                uses_string_comparison: true, uses_string_contains: false })
        }
    }
    if (node.kind == "Call" && node.edge_count == 2) {
        target = nodes[edges[node.first_edge] - 1].clone()
        if (target.kind == "Field" && target.edge_count == 1 && target.text == "contains") {
            // Both operands are checked string literals or pure parameter
            // reads, so C's argument order cannot reorder effects.
            hay = ScalarStringOperand(parameters, nodes[edges[target.first_edge] - 1])?
            needle = ScalarStringOperand(parameters, nodes[edges[node.first_edge + 1] - 1])?
            return ok(ScalarBoolC { source: "ku_scalar_string_contains(" + hay + ", " + needle + ")",
                uses_string_comparison: false, uses_string_contains: true })
        }
    }
    RejectScalarInt("unsupported_bool_expression", "expected a bool literal, logical operator, string comparison, or str.contains call", DeclarationSpan(node))?
    return ok(ScalarBoolC { source: "", uses_string_comparison: false, uses_string_contains: false })
}

fn collectStringParts(&nodes: [Node], &edges: [int], &parameters: [ScalarIntParameter], can_convert: bool,
                      node_id: int, depth: int, parts: [ScalarStringPart]): [ScalarStringPart]! {
    node = nodes[node_id - 1].clone()
    if (depth >= 32) {
        RejectScalarInt("string_depth_limit", "standalone C string expressions accept at most 32 levels", DeclarationSpan(node))?
    }
    if (node.kind == "Binary" && node.text == "+" && node.edge_count == 2) {
        left = collectStringParts(nodes, edges, parameters, can_convert, edges[node.first_edge], depth + 1, parts)?
        return collectStringParts(nodes, edges, parameters, can_convert, edges[node.first_edge + 1], depth + 1, left)
    }
    if (node.kind == "Call" && node.edge_count > 0) {
        target = nodes[edges[node.first_edge] - 1].clone()
        if (!can_convert || target.kind != "Variable" || target.edge_count != 0 || target.text != "str") {
            RejectScalarInt("unsupported_string_int_call", "expected an unshadowed str conversion with one argument", DeclarationSpan(node))?
        }
        shadow = ScalarParameterIndex(parameters, "str")
        if (shadow >= 0 || node.edge_count != 2) {
            RejectScalarInt("unsupported_string_int_call", "expected an unshadowed str conversion with one argument", DeclarationSpan(node))?
        }
        argument = nodes[edges[node.first_edge + 1] - 1].clone()
        source = scalarStringInteger(nodes, edges, parameters, argument)?
        return ok(parts.push(ScalarStringPart { source: source, integer: true }))
    }
    source = ScalarStringOperand(parameters, node)?
    return ok(parts.push(ScalarStringPart { source: source, integer: false }))
}

fn LowerScalarStringParts(&nodes: [Node], &edges: [int], &parameters: [ScalarIntParameter], can_convert: bool,
                          root_id: int): [ScalarStringPart]! {
    root = nodes[root_id - 1].clone()
    if (root.kind != "Call" && (root.kind != "Binary" || root.text != "+")) {
        RejectScalarInt("unsupported_string_return", "expected a str literal or checked string composition", DeclarationSpan(root))?
    }
    empty: [ScalarStringPart] = []
    return collectStringParts(nodes, edges, parameters, can_convert, root_id, 0, empty)
}
