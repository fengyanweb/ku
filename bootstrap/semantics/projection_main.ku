import { fs, string } from "std"
import { Span } from "../stage2/span.ku"
import { ParseModule } from "../stage3/parser.ku"
import { EmitGuardedStructC } from "./guarded_struct_c.ku"
import { BindProjectImports, SuppliedModule } from "./imports.ku"
import { BuildNameTable } from "./names.ku"
import { ManifestPaths, ReadProjectModules } from "./project_manifest.ku"
import { EmitScalarIntC } from "./scalar_int_c.ku"
import { EmitScalarProjectC } from "./scalar_project_c.ku"
import { BindStructReturn, BuildStructLayouts } from "./struct_layouts.ku"
import { EmitStructConstructorC } from "./struct_literal_c.ku"
import { EmitStructProjectionC } from "./struct_projection_c.ku"
import { BindImportedTypeNames, BindTypeNames } from "./type_names.ku"

fn selectedFunction(): str! {
    function = string.trim(fs.read("function.txt")?)
    if (function.len() == 0) {
        fail {
            domain: "bootstrap.projection",
            code: "missing_function",
            message: "function.txt must name a function"
        }
    }
    return ok(function)
}

fn emitProjectFunction(&selected: SuppliedModule, &supplied: [SuppliedModule], &function: str, guarded: bool): null! {
    imports = BindProjectImports(selected, supplied)?
    types = BindImportedTypeNames(selected.named, imports, supplied)?
    layouts = BuildStructLayouts(selected.named, types, supplied)?
    if (guarded) {
        generated = EmitGuardedStructC(selected.named, types, layouts, function)?
        print(generated.source)
        return ok(null)
    }
    generated = EmitStructConstructorC(selected.named, types, imports, supplied, layouts, function)?
    print(generated.text)
    return ok(null)
}

fn main(): null! {
    mode = "projection"
    if (fs.exists("mode.txt")) { mode = string.trim(fs.read("mode.txt")?) }
    if (mode == "construct" || mode == "guarded" || mode == "project-int") {
        function = selectedFunction()?
        at = Span { line: 1, column: 1, offset: 0, end_line: 1, end_column: 1, end_offset: 0 }
        paths = ManifestPaths(fs.read("modules.txt")?, at)?
        supplied = ReadProjectModules(paths)?
        if (mode == "project-int") {
            generated = EmitScalarProjectC(supplied, function)?
            print(generated.source)
            return ok(null)
        }
        return emitProjectFunction(supplied[0], supplied, function, mode == "guarded")
    }

    input = BuildNameTable(ParseModule(fs.read("input.ku")?)?)?
    function = selectedFunction()?

    supplied: [SuppliedModule] = []
    if (fs.exists("supplier.ku")) {
        path = string.trim(fs.read("supplier_path.txt")?)
        library = BuildNameTable(ParseModule(fs.read("supplier.ku")?)?)?
        supplied = supplied.push(SuppliedModule { path: path, named: library })
    }
    bindings = BindTypeNames(input, supplied)?
    if (mode == "int") {
        generated = EmitScalarIntC(input, bindings, function)?
        print(generated.source)
        return ok(null)
    }
    if (mode != "projection") {
        fail { domain: "bootstrap.projection", code: "invalid_mode", message: "mode.txt must contain projection, int, project-int, construct or guarded" }
    }
    layouts = BuildStructLayouts(input, bindings, supplied)?
    plan = BindStructReturn(input, bindings, layouts, function)?
    c = EmitStructProjectionC(layouts, plan)?
    print(c)
    return ok(null)
}
