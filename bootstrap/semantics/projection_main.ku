import { fs, string } from "std"
import { Span } from "../stage2/span.ku"
import { ParseModule } from "../stage3/parser.ku"
import { EmitGuardedStructC } from "./guarded_struct_c.ku"
import { BindProjectImports, SuppliedModule } from "./imports.ku"
import { EmitLinkedUnit } from "./linked_unit.ku"
import { EmitLinkPlan, LinkPlanDeclaration, NamedProjectionLinkPlan, StructProjectionLinkPlan } from "./link_plan_c.ku"
import { EmitManagedArrayC } from "./managed_array_c.ku"
import { BuildNameTable } from "./names.ku"
import { ManifestPaths, ReadProjectModules } from "./project_manifest.ku"
import { EmitProjectStructStringC } from "./project_struct_string_c.ku"
import { EmitScalarIntC } from "./scalar_int_c.ku"
import { EmitScalarProjectC, EmitScalarProjectLinkPlan } from "./scalar_project_c.ku"
import { BindStructReturn, BuildStructLayouts } from "./struct_layouts.ku"
import { EmitStructConstructorC } from "./struct_literal_c.ku"
import { EmitStructProjectionC } from "./struct_projection_c.ku"
import { EmitStructResultC } from "./struct_result_c.ku"
import { StructStringDependencyPlan } from "./struct_string_calls.ku"
import { BindImportedTypeNames, BindTypeNames } from "./type_names.ku"

fn selectedFunction(): str! {
    function = string.trim(fs.read("function.txt")?)
    if (function.len() == 0) {
        fail {
            domain: "bootstrap.projection",
            code: "missing_function",
            message: "function.txt must name a function"
        }
    }
    return ok(function)
}

fn emitProjectFunction(&selected: SuppliedModule, &supplied: [SuppliedModule], &function: str, &mode: str, link_plan: bool): null! {
    imports = BindProjectImports(selected, supplied)?
    types = BindImportedTypeNames(selected.named, imports, supplied)?
    layouts = BuildStructLayouts(selected.named, types, supplied)?
    if (mode == "project-fields") {
        plan = BindStructReturn(selected.named, types, layouts, function)?
        source = EmitStructProjectionC(layouts, plan)?
        if (link_plan) { print(EmitLinkPlan(supplied, mode, StructProjectionLinkPlan(plan), [])?) }
        else { print(source) }
        return ok(null)
    }
    if (mode == "struct-result") {
        generated = EmitStructResultC(selected.named, types, imports, supplied, layouts, function)?
        if (link_plan) { print(EmitLinkPlan(supplied, "struct-result", generated.entry_plan, generated.link_plan)?) }
        else { print(generated.source) }
        return ok(null)
    }
    if (mode == "managed") {
        generated = EmitManagedArrayC(selected.named, types, imports, supplied, layouts, function)?
        if (link_plan) { print(EmitLinkPlan(supplied, mode, generated.entry_plan, generated.link_plan)?) }
        else { print(generated.source) }
        return ok(null)
    }
    if (mode == "guarded") {
        generated = EmitGuardedStructC(selected.named, types, layouts, function)?
        if (link_plan) {
            export = NamedProjectionLinkPlan(selected, types, layouts, function, generated.symbol, true)?
            print(EmitLinkPlan(supplied, mode, export, [])?)
        } else { print(generated.source) }
        return ok(null)
    }
    generated = EmitStructConstructorC(selected.named, types, imports, supplied, layouts, function)?
    if (link_plan) {
        export = NamedProjectionLinkPlan(selected, types, layouts, function, generated.symbol, false)?
        print(EmitLinkPlan(supplied, mode, export, [])?)
    } else { print(generated.text) }
    return ok(null)
}

fn emitLinkedString(&supplied: [SuppliedModule], &function: str, plan: bool): null! {
    generated = EmitProjectStructStringC(supplied, function)?
    if (!plan) {
        print(generated.source)
        return ok(null)
    }
    links: [LinkPlanDeclaration] = []
    for dependency in generated.dependencies {
        links = links.push(StructStringDependencyPlan(dependency))
    }
    print(EmitLinkPlan(supplied, "linked-str", generated.entry_plan, links)?)
    return ok(null)
}

fn main(): null! {
    mode = "projection"
    if (fs.exists("mode.txt")) { mode = string.trim(fs.read("mode.txt")?) }
    link_plan = true
    if (mode == "linked-null-plan") { mode = "linked-null" }
    else if (mode == "linked-str-plan") { mode = "linked-str" }
    else if (mode == "struct-result-plan") { mode = "struct-result" }
    else if (mode == "construct-plan") { mode = "construct" }
    else if (mode == "project-fields-plan") { mode = "project-fields" }
    else if (mode == "guarded-plan") { mode = "guarded" }
    else if (mode == "project-int-plan") { mode = "project-int" }
    else if (mode == "managed-plan") { mode = "managed" }
    else { link_plan = false }
    if (mode == "construct" || mode == "guarded" || mode == "project-int" || mode == "managed" ||
        mode == "linked-str" || mode == "struct-result" || mode == "linked-null" || mode == "project-fields") {
        function = selectedFunction()?
        at = Span { line: 1, column: 1, offset: 0, end_line: 1, end_column: 1, end_offset: 0 }
        paths = ManifestPaths(fs.read("modules.txt")?, at)?
        supplied = ReadProjectModules(paths)?
        if (mode == "linked-null") {
            print(EmitLinkedUnit(supplied, function, link_plan)?)
            return ok(null)
        }
        if (mode == "linked-str") {
            return emitLinkedString(supplied, function, link_plan)
        }
        if (mode == "project-int") {
            if (link_plan) { print(EmitScalarProjectLinkPlan(supplied, function)?) }
            else {
                generated = EmitScalarProjectC(supplied, function)?
                print(generated.source)
            }
            return ok(null)
        }
        return emitProjectFunction(supplied[0], supplied, function, mode, link_plan)
    }

    input = BuildNameTable(ParseModule(fs.read("input.ku")?)?)?
    function = selectedFunction()?

    supplied: [SuppliedModule] = []
    if (fs.exists("supplier.ku")) {
        path = string.trim(fs.read("supplier_path.txt")?)
        library = BuildNameTable(ParseModule(fs.read("supplier.ku")?)?)?
        supplied = supplied.push(SuppliedModule { path: path, named: library })
    }
    bindings = BindTypeNames(input, supplied)?
    if (mode == "int") {
        generated = EmitScalarIntC(input, bindings, function)?
        print(generated.source)
        return ok(null)
    }
    if (mode != "projection") {
        fail { domain: "bootstrap.projection", code: "invalid_mode", message: "mode.txt must contain projection, int, project-int, project-fields, construct, guarded, managed, linked-str, linked-null, struct-result or a supported -plan mode" }
    }
    layouts = BuildStructLayouts(input, bindings, supplied)?
    plan = BindStructReturn(input, bindings, layouts, function)?
    c = EmitStructProjectionC(layouts, plan)?
    print(c)
    return ok(null)
}
