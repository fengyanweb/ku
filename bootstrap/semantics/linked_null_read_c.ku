import { LinkedMemberPath, LinkedMemberUnavailable } from "./linked_member_ownership.ku"
import { Span } from "../stage2/span.ku"
import { Node } from "../stage2/ast.ku"
import { DeclarationSpan } from "./names.ku"
import { TypeNameBinding } from "./type_names.ku"
import { FieldIndex, LayoutIndex, ReadLinkedErrorMember, RejectLayout, StructLayout } from "./struct_layouts.ku"
import { BuildProjectOwningLayouts, OrderProjectOwningLayouts } from "./nested_struct_c.ku"
import { RegisterLinkedIntArray, LinkedErrorField, ReadLinkedNullBinding, CheckLinkedAddition, LinkedNullArrayHeader, LinkedNullReadableArray, LinkedNullBinding, LinkedReadonlyExpression, LinkedRecordFields, LinkedViewPointee, LinkedNullExpression, LinkedNullOwnedArray, LinkedNullOwner, LinkedNullSlot, LinkedNullState, LinkedNullValue } from "./link_plan_c.ku"
import { EmitCheckedScalarArithmetic, EmitScalarStringPair } from "./scalar_int_emit.ku"
import { ScalarValueLiteralC } from "./scalar_int_operands.ku"
import { LinkedBuiltin, LinkedNullArrayElement, LinkedNullArrayPosition, LinkedNullArrayPrefix, LinkedNullCType, LinkedNullChild, LinkedNullDropC,
         LinkedNullLayout, LinkedNullNode, LinkedNullProject, LinkedNullResultCleanupReference, LinkedStringResult, LinkedNullView, ReadLinkedOwnedArray, SameLinkedType } from "./linked_null_types_c.ku"

fn registerOwnedElement(&project: LinkedNullProject, state: LinkedNullState, &element: TypeNameBinding): LinkedNullState! {
    next = state
    try {
        next.layouts = LinkedNullLayout(project, element, next.layouts.clone(), 0)?
        return ok(next)
    } catch (err) {
        if (err.code != "unsupported_layout_type") { fail err }
    }
    unit = element.module_index
    node = element.declaration_node
    layout = BuildProjectOwningLayouts(project.supplied, project.binding, unit, node, element.span.clone())?
    order = OrderProjectOwningLayouts(layout, unit, node, element.span.clone())?
    next.owning_strings = next.owning_strings || order.contains_string
    for entry in order.entries {
        item = layout[entry.layout_index - 1].clone()
        if (LayoutIndex(next.owning_layouts, item.module_index, item.node) == 0) {
            next.owning_layouts = next.owning_layouts.push(item.clone())
        }
        if (LayoutIndex(next.layouts, item.module_index, item.node) == 0) {
            next.layouts = next.layouts.push(item)
        }
    }
    return ok(next)
}

fn RegisterLinkedNullType(&project: LinkedNullProject, state: LinkedNullState, ty: TypeNameBinding): LinkedNullState! {
    next = state
    if (ty.declaration_kind == "BuiltinArray") {
        if (ty.name == "str") { next.uses_str_array = true }
        else { next = RegisterLinkedIntArray(next, ty.clone()) }
    }
    if (ty.declaration_kind == "StringView") { next.uses_str_view = true }
    if (ty.declaration_kind == "StructView") { next.uses_struct_view = true }
    if (ty.declaration_kind == "StructArray" || LinkedNullOwnedArray(ty)) {
        element = LinkedNullArrayElement(ty.clone())
        next = registerOwnedElement(project, next, element)?
        if (LinkedNullOwnedArray(ty) && LinkedNullArrayPosition(next.owned_arrays, ty) == 0) {
            next.owned_arrays = next.owned_arrays.push(ty.clone())
        }
        carrier = ty.clone()
        carrier.declaration_kind = "StructArray"
        if (LinkedNullArrayPosition(next.arrays, carrier) == 0) { next.arrays = next.arrays.push(carrier) }
    } else if (ty.declaration_kind == "Struct" || ty.declaration_kind == "StructView") {
        next = registerOwnedElement(project, next, LinkedViewPointee(ty))?
    }
    return ok(next)
}

fn RequireLinkedArrayValidation(state: LinkedNullState, ty: TypeNameBinding): LinkedNullState {
    next = state
    carrier = ty
    carrier.declaration_kind = "StructArray"
    if (LinkedNullArrayPosition(next.validated_arrays, carrier) == 0) {
        next.validated_arrays = next.validated_arrays.push(carrier)
    }
    return next
}

fn AddLinkedNullSlot(&project: LinkedNullProject, state: LinkedNullState, binding: str,
                     name: str, ty: TypeNameBinding, parameter: bool): LinkedNullExpression! {
    next = RegisterLinkedNullType(project, state, ty.clone())?
    view = LinkedNullView(ty)
    if (ty.declaration_kind == "StructArray") {
        next = RequireLinkedArrayValidation(next, ty.clone())
        element = LinkedNullArrayElement(ty.clone())
        next.code += LinkedNullResultCleanupReference(next.owning_layouts, element)
    }
    kind = LinkedNullCType(ty)?
    value = LinkedNullValue { ty: ty, text: name.clone(), slot: next.slots.len() + 1, borrowed: view, member_path: "" }
    if (value.ty.declaration_kind == "StringView" || value.ty.declaration_kind == "StructView") {
        value.ty = LinkedViewPointee(value.ty)
        value.text = "(*" + name.clone() + ")"
        next.code += LinkedNullResultCleanupReference(next.owning_layouts, value.ty)
    }
    next.slots = next.slots.push(LinkedNullSlot { binding: binding, value: value.clone(), live: parameter, moved_members: [] })
    if (!parameter) { next.declarations = next.declarations + "    " + kind + " " + name + " = {0};\n" }
    if (!view) { next.drops = LinkedNullDropC(next.layouts, next.owning_layouts, value.ty, value.text) + next.drops }
    return ok(LinkedNullExpression { state: next, value: value })
}

fn LowerLinkedArrayLocal(&project: LinkedNullProject, state: LinkedNullState, &statement: Node, id: int): LinkedNullState! {
    ty = ReadLinkedOwnedArray(project, 1, LinkedNullChild(project, 1, statement, 0))?
    value = LinkedNullNode(project, 1, LinkedNullChild(project, 1, statement, 1))
    if (value.kind != "Array" || value.edge_count != 0
        || LinkedNullBinding(state.slots, statement.text) != 0) {
        RejectLayout("linked_array_local", "expected a new typed array owner initialized empty", DeclarationSpan(statement))?
    }
    local = AddLinkedNullSlot(project, state, statement.text.clone(), "l" + str(id), ty, false)?
    local.state.slots[local.value.slot - 1].live = true
    return ok(local.state)
}

fn LowerLinkedNullRead(&project: LinkedNullProject, state: LinkedNullState, id: int, depth: int): LinkedNullExpression! {
    node = LinkedNullNode(project, 1, id)
    if (depth >= 32) {
        RejectLayout("linked_expression_depth", "linked null! expressions allow at most 32 levels", DeclarationSpan(node))?
    }
    if (node.kind == "Index" && node.edge_count == 2) {
        return readLinkedIndex(project, state, node, id, depth)
    }
    if (node.kind == "Field" && node.edge_count == 1) {
        return readLinkedField(project, state, node, depth)
    }
    if (node.kind == "Binary" && node.edge_count == 2) {
        return readLinkedBinary(project, state, node, id, depth)
    }
    if (node.kind == "Unary" && node.edge_count == 1 && node.text == "!") {
        operand = LowerLinkedNullRead(project, state, LinkedNullChild(project, 1, node, 0), depth + 1)?
        if (operand.value.ty.declaration_kind != "Builtin" || operand.value.ty.name != "bool") {
            RejectLayout("linked_unary_type", "logical negation requires bool", DeclarationSpan(node))?
        }
        return ok(LinkedReadonlyExpression(operand.state, operand.value.ty, "!(" + operand.value.text + ")"))
    }
    if (node.kind == "Call" && node.edge_count > 0) {
        target = LinkedNullNode(project, 1, LinkedNullChild(project, 1, node, 0))
        if (target.kind == "Field" && target.edge_count == 1) {
            return readLinkedMethod(project, state, node, target, depth)
        }
    }
    if (node.edge_count == 0 && (node.kind == "Variable" || node.kind == "Int" ||
        node.kind == "Bool" || node.kind == "String")) {
        return LowerLinkedNullLeaf(state, node)
    }
    RejectLayout("unsupported_linked_read", "expected a readonly scalar expression or array view", DeclarationSpan(node))?
    return ok(LinkedReadonlyExpression(state, LinkedBuiltin("", DeclarationSpan(node)), ""))
}

fn readLinkedMethod(&project: LinkedNullProject, state: LinkedNullState, &call: Node, &target: Node, depth: int): LinkedNullExpression! {
    next = state
    at = DeclarationSpan(call)
    if (call.edge_count == 1 && (target.text == "len" || target.text == "byte_len")) {
        value = LowerLinkedNullRead(project, next, LinkedNullChild(project, 1, target, 0), depth + 1)?
        if (target.text == "byte_len" && LinkedStringResult(value.value.ty)) {
            return ok(LinkedReadonlyExpression(value.state, LinkedBuiltin("int", at), "(int64_t)(" + value.value.text + ").len"))
        }
        if (target.text == "len" && LinkedNullReadableArray(value.value.ty)) {
            return ok(LinkedReadonlyExpression(value.state, LinkedBuiltin("int", at),
                "(int64_t)" + LinkedNullArrayHeader(value.value.ty, value.value.text) + "->len"))
        }
        next = value.state
        if (target.text == "len") {
            RejectLayout("linked_array_length", "len requires a struct array", at.clone())?
        }
    } else if (call.edge_count == 2 && target.text == "ends_with") {
        left = LowerLinkedNullRead(project, next, LinkedNullChild(project, 1, target, 0), depth + 1)?
        right = LowerLinkedNullRead(project, left.state, LinkedNullChild(project, 1, call, 1), depth + 1)?
        if (LinkedStringResult(left.value.ty) && LinkedStringResult(right.value.ty)) {
            right.state.uses_suffix = true
            return ok(LinkedReadonlyExpression(right.state, LinkedBuiltin("bool", at),
                "ku_scalar_ends_with(" + left.value.text + ", " + right.value.text + ")"))
        }
        next = right.state
    }
    RejectLayout("unsupported_linked_read", "expected a readonly scalar expression or array view", at.clone())?
    return ok(LinkedReadonlyExpression(next, LinkedBuiltin("", at), ""))
}

fn readLinkedIndex(&project: LinkedNullProject, state: LinkedNullState, &node: Node, id: int, depth: int): LinkedNullExpression! {
    array = LowerLinkedNullRead(project, state, LinkedNullChild(project, 1, node, 0), depth + 1)?
    index = LowerLinkedNullRead(project, array.state, LinkedNullChild(project, 1, node, 1), depth + 1)?
    if (!LinkedNullReadableArray(array.value.ty) || index.value.ty.name != "int" ||
        index.value.ty.declaration_kind != "Builtin") {
        RejectLayout("linked_index_type", "expected a readonly struct array and int index", DeclarationSpan(node))?
    }
    offset = "i" + str(id)
    header = LinkedNullArrayHeader(array.value.ty, array.value.text)
    index.state.uses_index = true
    index.state.code = index.state.code + "    int64_t " + offset.clone() + " = " + index.value.text + ";\n"
        + "    if (" + offset.clone() + " < 0 || (uint64_t)" + offset.clone() + " >= " + header.clone() + "->len) {\n"
        + "        index_failed = true; failure_index = " + offset.clone() + "; failure_length = " + header.clone() + "->len; goto cleanup;\n    }\n"
    item = LinkedReadonlyExpression(index.state, LinkedNullArrayElement(array.value.ty), header + "->data[" + offset + "]")
    if (item.value.ty.declaration_kind == "Builtin" && item.value.ty.name == "str") {
        item.state.code += "    if (" + item.value.text.clone() + ".len && !" + item.value.text.clone()
            + ".ptr) { invalid_array = true; goto cleanup; }\n"
    }
    item.value.borrowed = LinkedNullOwner(item.value.ty)
    item.value.slot = array.value.slot
    return ok(item)
}

fn readLinkedField(&project: LinkedNullProject, state: LinkedNullState, &node: Node, depth: int): LinkedNullExpression! {
    receiver = LowerLinkedNullRead(project, state, LinkedNullChild(project, 1, node, 0), depth + 1)?
    ty = receiver.value.ty.clone()
    if (ty.declaration_kind == "CaughtError") {
        at = DeclarationSpan(node)
        member = ReadLinkedErrorMember(receiver.value.text, node.text, receiver.state.moved_error_fields, at.clone())?
        return ok(LinkedErrorField(receiver, member, at))
    }
    if (ty.declaration_kind != "Struct") {
        RejectLayout("linked_field_type", "expected a readonly struct field receiver", DeclarationSpan(node))?
    }
    fields = LinkedRecordFields(receiver.state.layouts, receiver.state.owning_layouts, ty)?
    ordinal = FieldIndex(fields, node.text)
    if (ordinal == 0) {
        RejectLayout("linked_unknown_field", "unknown field '" + node.text.clone() + "'", DeclarationSpan(node))?
    }
    field_type = fields[ordinal - 1].resolved.clone()
    member = receiver.value.text + ".f" + str(ordinal - 1)
    field = LinkedReadonlyExpression(receiver.state, field_type, member)
    field.value.slot = receiver.value.slot
    field.value.member_path = LinkedMemberPath(receiver.value, ordinal)
    if (LinkedMemberUnavailable(field.state, field.value, false)) {
        RejectLayout("linked_moved_member", "cannot read a field already moved from its parent", DeclarationSpan(node))?
    }
    if (field.value.ty.declaration_kind == "StructArray" || field.value.ty.declaration_kind == "BuiltinArray") {
        ty = field.value.ty.clone()
        next = RegisterLinkedNullType(project, field.state, ty)?
        if (field.value.ty.declaration_kind == "StructArray") {
            next = RequireLinkedArrayValidation(next, field.value.ty.clone())
            element = LinkedNullArrayElement(field.value.ty.clone())
            next.code += LinkedNullResultCleanupReference(next.owning_layouts, element)
        }
        address = "(&(" + field.value.text.clone() + "))"
        next.code += "    if (!" + LinkedNullArrayPrefix(field.value.ty) + "_valid(" + address.clone()
            + ") || (uintmax_t)" + address.clone() + "->len > (uintmax_t)INT64_MAX) { invalid_array = true; goto cleanup; }\n"
        field.state = next
        // Keep a real lvalue for arrays inside an owned record. A view
        // receiver still exposes only the readonly address of that field.
        if (field.value.ty.declaration_kind == "StructArray" && field.value.member_path != "") {
            field.value.ty.declaration_kind = "OwnedStructArray"
        } else {
            field.value.text = address
            field.value.borrowed = true
        }
    } else {
        field.value.borrowed = LinkedNullOwner(field.value.ty)
    }
    return ok(field)
}

fn EmitLinkedAddition(&project: LinkedNullProject, state: LinkedNullState, &left: LinkedNullValue,
                      &right: LinkedNullValue, id: int, &at: Span): LinkedNullExpression! {
    CheckLinkedAddition(state, left, right, at)?
    if (left.ty.name == "int") {
        scalar = state
        out = "t" + str(id)
        scalar.uses_add = true
        scalar.code += EmitCheckedScalarArithmetic("add", left.text, right.text, out)
        return ok(LinkedReadonlyExpression(scalar, LinkedBuiltin("int", at.clone()), out))
    }
    output = AddLinkedNullSlot(project, state, "", "t" + str(id), left.ty.clone(), false)?
    output.state.uses_concat = true
    output.state.code += EmitScalarStringPair(left.text, right.text, output.value.text)
    output.state.slots[output.value.slot - 1].live = true
    return ok(output)
}

fn readLinkedBinary(&project: LinkedNullProject, state: LinkedNullState, &node: Node, id: int, depth: int): LinkedNullExpression! {
    left = LowerLinkedNullRead(project, state, LinkedNullChild(project, 1, node, 0), depth + 1)?
    op = node.text.clone()
    logical = op == "&&" || op == "||"
    result = ""
    if (logical) {
        result = "b" + str(id)
        negate = ""
        if (op == "||") { negate = "!" }
        left.state.code += "    bool " + result.clone() + " = " + left.value.text.clone() + ";\n"
            + "    if (" + negate + result.clone() + ") {\n"
    }
    right = LowerLinkedNullRead(project, left.state, LinkedNullChild(project, 1, node, 1), depth + 1)?
    if (left.value.ty.declaration_kind != "Builtin" || !SameLinkedType(left.value.ty, right.value.ty)) {
        RejectLayout("linked_binary_type", "readonly operation requires matching scalar inputs", DeclarationSpan(node))?
    }
    if (logical && left.value.ty.name == "bool") {
        right.state.code += "    " + result.clone() + " = " + right.value.text + ";\n    }\n"
        return ok(LinkedReadonlyExpression(right.state, LinkedBuiltin("bool", DeclarationSpan(node)), result))
    }
    equality = op == "==" || op == "!="
    if (left.value.ty.name == "str" && equality) {
        right.state.uses_string_equal = true
        compare = "ku_guard_string_equal(" + left.value.text + ", " + right.value.text + ")"
        if (op == "!=") { compare = "!" + compare }
        return ok(LinkedReadonlyExpression(right.state, LinkedBuiltin("bool", DeclarationSpan(node)), compare))
    }
    if ((left.value.ty.name == "str" || left.value.ty.name == "int") && op == "+") {
        value = right.value
        return EmitLinkedAddition(project, right.state, left.value, value, id, DeclarationSpan(node))
    }
    if (left.value.ty.name == "int" && op == "-") {
        right.state.uses_sub = true
        out = "t" + str(id)
        right.state.code += EmitCheckedScalarArithmetic("sub", left.value.text, right.value.text, out)
        return ok(LinkedReadonlyExpression(right.state, LinkedBuiltin("int", DeclarationSpan(node)), out))
    }
    integer_comparison = left.value.ty.name == "int" && (equality || op == "<" || op == ">" || op == "<=" || op == ">=")
    if (integer_comparison || (left.value.ty.name == "bool" && equality)) {
        return ok(LinkedReadonlyExpression(right.state, LinkedBuiltin("bool", DeclarationSpan(node)),
            "(" + left.value.text + " " + op + " " + right.value.text + ")"))
    }
    RejectLayout("linked_binary_type", "unsupported readonly scalar operation", DeclarationSpan(node))?
    return ok(LinkedReadonlyExpression(right.state, LinkedBuiltin("", DeclarationSpan(node)), ""))
}

fn LowerLinkedNullLeaf(state: LinkedNullState, &node: Node): LinkedNullExpression! {
    at = DeclarationSpan(node)
    if (node.kind == "Variable" && node.edge_count == 0) { return ReadLinkedNullBinding(state, node) }
    value = ScalarValueLiteralC(node)?
    if (value.kind != "") { return ok(LinkedReadonlyExpression(state, LinkedBuiltin(value.kind, at), value.text)) }
    RejectLayout("unsupported_linked_operand", "expected a bound value, literal or checked direct call", at.clone())?
    return ok(LinkedReadonlyExpression(state, LinkedBuiltin("", at), ""))
}
