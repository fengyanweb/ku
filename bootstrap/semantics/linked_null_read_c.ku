import { Node } from "../stage2/ast.ku"
import { DeclarationSpan } from "./names.ku"
import { TypeNameBinding } from "./type_names.ku"
import { FieldIndex, LayoutIndex, RejectLayout, StructLayout } from "./struct_layouts.ku"
import { GuardArithmetic, GuardOwnedDrops, GuardStringEquality } from "./guarded_struct_c.ku"
import { ContainsType, CTypeName, EmitLayout, ProjectionHeaders } from "./struct_projection_c.ku"
import { BuildProjectOwningLayouts, EmitOwningLayoutDefinitions, OrderProjectOwningLayouts, OwningLayoutDropName } from "./nested_struct_c.ku"
import { EmitOwnedStructArrayDrop, EmitOwnedStructOperations, EmitStructArrayHeader, EmitStructArrayReadValidation,
         EmitStructArrayResultHeader, EmitStructArrayDropUsing, EmitTryCloneString, EmitOwnedStructArrayAppend, StructArrayStatuses } from "./struct_array_c.ku"
import { StructResultHeader } from "./struct_result_c.ku"
import { ScalarStringLiteral } from "./scalar_int_operands.ku"
import { LinkedBuiltin, LinkedNullArrayElement, LinkedNullArrayPrefix, LinkedNullArrayType, LinkedNullCType, LinkedNullChild, LinkedNullFunction,
         LinkedNullLayout, LinkedNullNode, LinkedNullOwnedArray, LinkedNullOwner, LinkedNullProject, EmitLinkedNullPrototypes, LinkedNullView, SameLinkedType } from "./linked_null_types_c.ku"

struct LinkedNullValue {
    ty: TypeNameBinding
    text: str
    slot: int
    borrowed: bool
}

struct LinkedNullSlot {
    binding: str
    value: LinkedNullValue
    live: bool
}

struct LinkedNullState {
    layouts: [StructLayout]
    owning_layouts: [StructLayout]
    owning_strings: bool
    slots: [LinkedNullSlot]
    links: [LinkedNullFunction]
    declarations: str
    code: str
    drops: str
    uses_clone: bool
    arrays: [TypeNameBinding]
    validated_arrays: [TypeNameBinding]
    owned_arrays: [TypeNameBinding]
    append_slots: [int]
    uses_str_array: bool
    uses_str_view: bool
    element_clones: [int]
    uses_index: bool
    uses_add: bool
    uses_sub: bool
    uses_string_equal: bool
}

struct LinkedNullExpression {
    state: LinkedNullState
    value: LinkedNullValue
}

fn NewLinkedNullState(): LinkedNullState {
    return LinkedNullState { layouts: [], owning_layouts: [], owning_strings: false,
        slots: [], links: [], declarations: "", code: "", drops: "", uses_clone: false,
        arrays: [], validated_arrays: [], owned_arrays: [], append_slots: [], uses_str_array: false, uses_str_view: false,
        element_clones: [], uses_index: false, uses_add: false, uses_sub: false, uses_string_equal: false }
}

fn LinkedNullBinding(&slots: [LinkedNullSlot], &name: str): int {
    if (name == "") { return 0 }
    index = 0
    while (index < slots.len()) {
        if (slots[index].binding == name) { return index + 1 }
        index = index + 1
    }
    return 0
}

fn linkedDrop(&state: LinkedNullState, &value: LinkedNullValue): str {
    if (value.ty.name == "str" && value.ty.declaration_kind == "Builtin") {
        return "    ku_projection_string_drop(&" + value.text.clone() + ");\n"
    }
    if (value.ty.declaration_kind == "Struct") {
        unit = value.ty.module_index
        node = value.ty.declaration_node
        if (LayoutIndex(state.owning_layouts, unit, node) != 0) {
            return "    " + OwningLayoutDropName(unit, node) + "(&" + value.text.clone() + ");\n"
        }
        layout = LayoutIndex(state.layouts, unit, node)
        return GuardOwnedDrops(state.layouts, layout, value.text)
    }
    if (LinkedNullOwnedArray(value.ty)) {
        return "    " + LinkedNullArrayPrefix(value.ty) + "_drop(&" + value.text.clone() + ");\n"
    }
    return ""
}

fn registerOwnedElement(&project: LinkedNullProject, state: LinkedNullState, &element: TypeNameBinding): LinkedNullState! {
    next = state
    try {
        next.layouts = LinkedNullLayout(project, element, next.layouts.clone(), 0)?
        return ok(next)
    } catch (err) {
        if (err.code != "unsupported_layout_type") { fail err }
    }
    unit = element.module_index
    node = element.declaration_node
    layout = BuildProjectOwningLayouts(project.supplied, project.binding, unit, node, element.span.clone())?
    order = OrderProjectOwningLayouts(layout, unit, node, element.span.clone())?
    next.owning_strings = next.owning_strings || order.contains_string
    for entry in order.entries {
        item = layout[entry.layout_index - 1].clone()
        if (LayoutIndex(next.owning_layouts, item.module_index, item.node) == 0) {
            next.owning_layouts = next.owning_layouts.push(item.clone())
        }
        if (LayoutIndex(next.layouts, item.module_index, item.node) == 0) {
            next.layouts = next.layouts.push(item)
        }
    }
    return ok(next)
}

fn RegisterLinkedNullType(&project: LinkedNullProject, state: LinkedNullState, ty: TypeNameBinding): LinkedNullState! {
    next = state
    if (ty.declaration_kind == "BuiltinArray") { next.uses_str_array = true }
    if (ty.declaration_kind == "StringView") { next.uses_str_view = true }
    if (ty.declaration_kind == "StructArray" || LinkedNullOwnedArray(ty)) {
        element = LinkedNullArrayElement(ty.clone())
        if (LinkedNullOwnedArray(ty)) { next = registerOwnedElement(project, next, element)? }
        else { next.layouts = LinkedNullLayout(project, element, next.layouts, 0)? }
        if (LinkedNullOwnedArray(ty) && arrayPosition(next.owned_arrays, ty) == 0) {
            next.owned_arrays = next.owned_arrays.push(ty.clone())
        }
        carrier = ty.clone()
        carrier.declaration_kind = "StructArray"
        if (arrayPosition(next.arrays, carrier) == 0) { next.arrays = next.arrays.push(carrier) }
    } else if (ty.declaration_kind == "Struct") {
        next = registerOwnedElement(project, next, ty)?
    }
    return ok(next)
}

fn RequireLinkedArrayValidation(state: LinkedNullState, ty: TypeNameBinding): LinkedNullState {
    next = state
    carrier = ty
    carrier.declaration_kind = "StructArray"
    if (arrayPosition(next.validated_arrays, carrier) == 0) {
        next.validated_arrays = next.validated_arrays.push(carrier)
    }
    return next
}

fn AddLinkedNullSlot(&project: LinkedNullProject, state: LinkedNullState, binding: str,
                     name: str, ty: TypeNameBinding, parameter: bool): LinkedNullExpression! {
    next = RegisterLinkedNullType(project, state, ty.clone())?
    view = LinkedNullView(ty)
    if (ty.declaration_kind == "StructArray") { next = RequireLinkedArrayValidation(next, ty.clone()) }
    kind = LinkedNullCType(ty)?
    value = LinkedNullValue { ty: ty, text: name.clone(), slot: next.slots.len() + 1, borrowed: view }
    if (value.ty.declaration_kind == "StringView") {
        value.ty.declaration_kind = "Builtin"
        value.text = "(*" + name.clone() + ")"
    }
    next.slots = next.slots.push(LinkedNullSlot { binding: binding, value: value.clone(), live: parameter })
    if (!parameter) { next.declarations = next.declarations + "    " + kind + " " + name + " = {0};\n" }
    if (!view) { next.drops = linkedDrop(next, value) + next.drops }
    return ok(LinkedNullExpression { state: next, value: value })
}

fn arrayPosition(&arrays: [TypeNameBinding], &type_name: TypeNameBinding): int {
    index = 0
    while (index < arrays.len()) {
        if (SameLinkedType(arrays[index], type_name)) { return index + 1 }
        index = index + 1
    }
    return 0
}

fn MoveLinkedNullSlot(state: LinkedNullState, &value: LinkedNullValue): LinkedNullState! {
    if (value.borrowed) {
        RejectLayout("linked_view_escape", "readonly values cannot be moved or stored without an explicit clone", value.ty.span.clone())?
    }
    next = state
    if (value.slot > 0 && LinkedNullOwner(value.ty)) {
        next.code = next.code + "    " + value.text.clone() + " = (" + LinkedNullCType(value.ty)? + "){0};\n"
        next.slots[value.slot - 1].live = false
    }
    return ok(next)
}

fn DropLinkedNullScope(state: LinkedNullState, outer: int): LinkedNullState {
    next = state
    index = next.slots.len()
    while (index > outer) {
        index = index - 1
        slot = next.slots[index].clone()
        if (slot.live && LinkedNullOwner(slot.value.ty)) {
            next.code = next.code + linkedDrop(next, slot.value)
        }
        next.slots[index].binding = ""
        next.slots[index].live = false
    }
    return next
}

fn linkedValue(state: LinkedNullState, ty: TypeNameBinding, text: str): LinkedNullExpression {
    return LinkedNullExpression { state: state, value: LinkedNullValue { ty: ty, text: text, slot: 0, borrowed: false } }
}

fn readableArray(&value: LinkedNullValue): bool {
    return value.ty.declaration_kind == "StructArray" || value.ty.declaration_kind == "BuiltinArray" || LinkedNullOwnedArray(value.ty)
}

fn arrayHeader(&value: LinkedNullValue): str {
    if (LinkedNullOwnedArray(value.ty)) { return "(&" + value.text.clone() + ")" }
    return value.text.clone()
}

fn ReadLinkedNullBinding(state: LinkedNullState, &node: Node): LinkedNullExpression! {
    index = LinkedNullBinding(state.slots, node.text)
    if (index == 0 || !state.slots[index - 1].live) {
        RejectLayout("unavailable_linked_binding", "expected an initialized, unconsumed binding", DeclarationSpan(node))?
    }
    value = state.slots[index - 1].value.clone()
    return ok(LinkedNullExpression { state: state, value: value })
}

fn LowerLinkedNullRead(&project: LinkedNullProject, state: LinkedNullState, id: int, depth: int): LinkedNullExpression! {
    node = LinkedNullNode(project, 1, id)
    if (depth >= 32) {
        RejectLayout("linked_expression_depth", "linked null! expressions allow at most 32 levels", DeclarationSpan(node))?
    }
    if (node.kind == "Index" && node.edge_count == 2) {
        return readLinkedIndex(project, state, node, id, depth)
    }
    if (node.kind == "Field" && node.edge_count == 1) {
        return readLinkedField(project, state, node, depth)
    }
    if (node.kind == "Binary" && node.edge_count == 2) {
        return readLinkedBinary(project, state, node, id, depth)
    }
    if (node.kind == "Call" && node.edge_count == 1) {
        target = LinkedNullNode(project, 1, LinkedNullChild(project, 1, node, 0))
        if (target.kind == "Field" && target.edge_count == 1 && target.text == "len") {
            value = LowerLinkedNullRead(project, state, LinkedNullChild(project, 1, target, 0), depth + 1)?
            if (!readableArray(value.value)) {
                RejectLayout("linked_array_length", "len requires a struct array", DeclarationSpan(node))?
            }
            header = arrayHeader(value.value)
            return ok(linkedValue(value.state, LinkedBuiltin("int", DeclarationSpan(node)),
                "(int64_t)" + header + "->len"))
        }
    }
    if (node.edge_count == 0 && (node.kind == "Variable" || node.kind == "Int" ||
        node.kind == "Bool" || node.kind == "String")) {
        return LowerLinkedNullLeaf(state, node)
    }
    RejectLayout("unsupported_linked_read", "expected a readonly scalar expression or array view", DeclarationSpan(node))?
    return ok(linkedValue(state, LinkedBuiltin("", DeclarationSpan(node)), ""))
}

fn readLinkedIndex(&project: LinkedNullProject, state: LinkedNullState, &node: Node, id: int, depth: int): LinkedNullExpression! {
    array = LowerLinkedNullRead(project, state, LinkedNullChild(project, 1, node, 0), depth + 1)?
    index = LowerLinkedNullRead(project, array.state, LinkedNullChild(project, 1, node, 1), depth + 1)?
    if (!readableArray(array.value) || index.value.ty.name != "int" ||
        index.value.ty.declaration_kind != "Builtin") {
        RejectLayout("linked_index_type", "expected a readonly struct array and int index", DeclarationSpan(node))?
    }
    offset = "i" + str(id)
    header = arrayHeader(array.value)
    index.state.uses_index = true
    index.state.code = index.state.code + "    int64_t " + offset.clone() + " = " + index.value.text + ";\n"
        + "    if (" + offset.clone() + " < 0 || (uint64_t)" + offset.clone() + " >= " + header.clone() + "->len) {\n"
        + "        index_failed = true; failure_index = " + offset.clone() + "; failure_length = " + header.clone() + "->len; goto cleanup;\n    }\n"
    item = linkedValue(index.state, LinkedNullArrayElement(array.value.ty), header + "->data[" + offset + "]")
    if (item.value.ty.declaration_kind == "Builtin") {
        item.state.code += "    if (" + item.value.text.clone() + ".len && !" + item.value.text.clone()
            + ".ptr) { invalid_array = true; goto cleanup; }\n"
    }
    item.value.borrowed = true
    return ok(item)
}

fn readLinkedField(&project: LinkedNullProject, state: LinkedNullState, &node: Node, depth: int): LinkedNullExpression! {
    receiver = LowerLinkedNullRead(project, state, LinkedNullChild(project, 1, node, 0), depth + 1)?
    ty = receiver.value.ty.clone()
    if (ty.declaration_kind != "Struct") {
        RejectLayout("linked_field_type", "expected a readonly struct field receiver", DeclarationSpan(node))?
    }
    layout = LayoutIndex(receiver.state.layouts, ty.module_index, ty.declaration_node)
    ordinal = FieldIndex(receiver.state.layouts[layout - 1].fields, node.text)
    if (ordinal == 0) {
        RejectLayout("linked_unknown_field", "unknown field '" + node.text.clone() + "'", DeclarationSpan(node))?
    }
    field_type = receiver.state.layouts[layout - 1].fields[ordinal - 1].resolved.clone()
    if (field_type.declaration_kind == "StructArray" || field_type.declaration_kind == "BuiltinArray") {
        RejectLayout("linked_nested_array_projection", "a nested owning array field does not yet support projection", DeclarationSpan(node))?
    }
    field = linkedValue(receiver.state, field_type, receiver.value.text + ".f" + str(ordinal - 1))
    field.value.borrowed = LinkedNullOwner(field.value.ty)
    return ok(field)
}

fn readLinkedBinary(&project: LinkedNullProject, state: LinkedNullState, &node: Node, id: int, depth: int): LinkedNullExpression! {
    left = LowerLinkedNullRead(project, state, LinkedNullChild(project, 1, node, 0), depth + 1)?
    right = LowerLinkedNullRead(project, left.state, LinkedNullChild(project, 1, node, 1), depth + 1)?
    if (left.value.ty.declaration_kind != "Builtin" || !SameLinkedType(left.value.ty, right.value.ty)) {
        RejectLayout("linked_binary_type", "readonly operation requires matching scalar inputs", DeclarationSpan(node))?
    }
    op = node.text.clone()
    equality = op == "==" || op == "!="
    if (left.value.ty.name == "str" && equality) {
        right.state.uses_string_equal = true
        compare = "ku_guard_string_equal(" + left.value.text + ", " + right.value.text + ")"
        if (op == "!=") { compare = "!" + compare }
        return ok(linkedValue(right.state, LinkedBuiltin("bool", DeclarationSpan(node)), compare))
    }
    if (left.value.ty.name == "int" && (op == "+" || op == "-")) {
        operation = "sub"
        if (op == "+") { operation = "add" right.state.uses_add = true }
        else { right.state.uses_sub = true }
        out = "t" + str(id)
        right.state.code = right.state.code + "    int64_t " + out.clone() + ";\n"
            + "    if (!ku_guard_try_" + operation + "(" + left.value.text + ", " + right.value.text + ", &"
            + out.clone() + ")) { overflow = true; goto cleanup; }\n"
        return ok(linkedValue(right.state, LinkedBuiltin("int", DeclarationSpan(node)), out))
    }
    integer_comparison = left.value.ty.name == "int" && (equality || op == "<" || op == ">" || op == "<=" || op == ">=")
    if (integer_comparison || (left.value.ty.name == "bool" && equality)) {
        return ok(linkedValue(right.state, LinkedBuiltin("bool", DeclarationSpan(node)),
            "(" + left.value.text + " " + op + " " + right.value.text + ")"))
    }
    RejectLayout("linked_binary_type", "unsupported readonly scalar operation", DeclarationSpan(node))?
    return ok(linkedValue(right.state, LinkedBuiltin("", DeclarationSpan(node)), ""))
}

fn LowerLinkedNullLeaf(state: LinkedNullState, &node: Node): LinkedNullExpression! {
    at = DeclarationSpan(node)
    if (node.kind == "Variable" && node.edge_count == 0) { return ReadLinkedNullBinding(state, node) }
    if (node.kind == "String" && node.edge_count == 0) {
        value = "(KuProjectionString){(uint8_t*)" + ScalarStringLiteral(node)? + ", 0u, KU_PROJECTION_STRING_STATIC}"
        return ok(linkedValue(state, LinkedBuiltin("str", at), value))
    }
    if (node.kind == "Bool" && node.edge_count == 0 && (node.text == "true" || node.text == "false")) {
        return ok(linkedValue(state, LinkedBuiltin("bool", at), node.text.clone()))
    }
    if (node.kind == "Int" && node.edge_count == 0 && node.int_value >= 0) {
        return ok(linkedValue(state, LinkedBuiltin("int", at), "INT64_C(" + str(node.int_value) + ")"))
    }
    RejectLayout("unsupported_linked_operand", "expected a bound value, literal or checked direct call", at.clone())?
    return ok(linkedValue(state, LinkedBuiltin("", at), ""))
}

fn EmitLinkedNullDeclarations(&body: LinkedNullState): str! {
    // Keep the external prototypes independent of the selected entry's C
    // name. The linker consumes declarations resolved from the source graph.
    text = ProjectionHeaders(true, body.drops.contains("ku_projection_string_drop") || body.owning_strings) + GuardArithmetic(body.uses_add, body.uses_sub)
        + GuardStringEquality(body.uses_string_equal)
    if (body.arrays.len() > 0 || body.uses_str_array || body.uses_str_view) {
        text += "#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n"
    }
    if (body.uses_clone) {
        text += "#include <stdio.h>\n#include <string.h>\n\n" + EmitTryCloneString("ku_linked_clone_string")
    }
    definitions = EmitOwningLayoutDefinitions(body.owning_layouts, 0, 0)?
    text += definitions.source
    for layout in body.layouts.clone() {
        if (LayoutIndex(body.owning_layouts, layout.module_index, layout.node) == 0) {
            text += EmitLayout(layout, true, true)?
        }
    }
    for array in body.arrays.clone() {
        element = CTypeName(array.module_index, array.declaration_node)
        array_type = "KuArray_" + element.clone()
        if (!ContainsType(definitions.array_types, array_type)) { text += EmitStructArrayHeader(element, array_type) }
        if (arrayPosition(body.validated_arrays, array) > 0) {
            text += EmitStructArrayReadValidation(element, array_type, LinkedNullArrayPrefix(array))
        }
    }
    if (body.uses_str_array) {
        if (!ContainsType(definitions.array_types, "KuGuardStringArray")) {
            text += EmitStructArrayHeader("KuProjectionString", "KuGuardStringArray")
        }
        text += EmitStructArrayReadValidation("KuProjectionString", "KuGuardStringArray", "ku_linked_view_str_array")
    }
    for layout in body.element_clones.clone() {
        text += EmitOwnedStructOperations(body.layouts, layout, "ku_linked_element_" + str(layout), true)
    }
    text += StructResultHeader()
    for owned in body.owned_arrays.clone() {
        array_type = LinkedNullArrayType(owned)
        layout = LayoutIndex(body.layouts, owned.module_index, owned.declaration_node)
        text += EmitStructArrayResultHeader(array_type)
        prefix = LinkedNullArrayPrefix(owned)
        if (LayoutIndex(body.owning_layouts, owned.module_index, owned.declaration_node) != 0) {
            text += EmitStructArrayDropUsing(array_type, prefix, OwningLayoutDropName(owned.module_index, owned.declaration_node), true)
        } else { text += EmitOwnedStructArrayDrop(body.layouts, layout, array_type, prefix) }
    }
    if (body.append_slots.len() > 0) { text += StructArrayStatuses() }
    seen_arrays: [str] = []
    for index in body.append_slots.clone() {
        ty = body.slots[index - 1].value.ty.clone()
        array = LinkedNullArrayType(ty)
        if (!ContainsType(seen_arrays, array)) {
            text += EmitOwnedStructArrayAppend(CTypeName(ty.module_index, ty.declaration_node), array, LinkedNullArrayPrefix(ty))
            seen_arrays = seen_arrays.push(array)
        }
    }
    return ok(text + EmitLinkedNullPrototypes(body.links)?)
}
