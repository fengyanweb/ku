import { GuardExplicitType, GuardType } from "./guarded_struct_expr.ku"
import { ManagedSourceCharactersRuntime, ManagedStringArrayDrop } from "./guarded_string_parts.ku"
import { LinkedNullIntArrayOwner, LinkedNullState } from "./link_plan_c.ku"
import { EmitCheckedRecordArrayClone, EmitOwnedStringArrayClone, EmitProjectionCloneString, EmitProjectionStringJoinHelpers, ScalarStringPrefixSuffixC } from "./scalar_int_emit.ku"
import { Node } from "../stage2/ast.ku"
import { Span } from "../stage2/span.ku"
import { DeclarationSpan, NamedModule } from "./names.ku"
import { CanCloneManagedRecord, CollectOwnedMemberPaths, EmitCombinedCLayouts, EmitLinkedManagedElementClone, EmitNestedCLayouts, OrderCStructLayouts, OwningLayoutDropName } from "./nested_struct_c.ku"
import { ContainsIndex, ContainsType, CTypeName, ProjectionArrayHeader, ProjectionIsStringArray } from "./struct_projection_c.ku"
import { ExplicitType, HasBoundArrayMembers, LayoutIndex, RejectLayout, StructLayout } from "./struct_layouts.ku"
import { BoundArrayTypePosition, EmitUnitEnumHeader, RetagTypeNameBinding, TypeNameBinding } from "./type_names.ku"

struct StructArrayC {
    element_type: str
    array_type: str
    prefix: str
    source: str
}

fn collectOwnedFields(&layouts: [StructLayout], index: int, &prefix: str, paths: [str]): [str] {
    return CollectOwnedMemberPaths(layouts, index, prefix, paths, false)
}

fn EmitTryCloneString(&symbol: str): str {
    return EmitProjectionCloneString(symbol)
}

fn emitOwnedStructElement(&element: str, &prefix: str, &fields: [str], private_drop: bool): str {
    text = ""
    if (fields.len() != 0) { text = EmitTryCloneString(prefix.clone() + "_clone_string") }
    text += emitOwnedElementDrop(element, prefix, fields, private_drop)
    text += "static bool " + prefix.clone() + "_clone_element(const " + element.clone() + " *source, " + element.clone() + " *out) {\n"
    text += "    " + element + " copy = *source;\n"
    // Establish an empty owner for every managed field before any fallible
    // allocation. An error may then unwind just the initialized fields.
    index = 0
    while (index < fields.len()) {
        text += "    copy" + fields[index].clone() + " = (KuProjectionString){0};\n"
        index = index + 1
    }
    index = 0
    while (index < fields.len()) {
        field = fields[index].clone()
        text += "    if (!" + prefix.clone() + "_clone_string((*source)" + field.clone() + ", &copy" + field + ")) {\n"
        text += "        " + prefix.clone() + "_element_drop(&copy);\n        return false;\n    }\n"
        index = index + 1
    }
    return text + "    *out = copy;\n    return true;\n}\n\n"
}

fn emitOwnedElementDrop(&element: str, &prefix: str, &fields: [str], private_drop: bool): str {
    text = ""
    if (private_drop) { text += "static " }
    text += "void " + prefix.clone() + "_element_drop(" + element.clone() + " *value) {\n"
    index = 0
    while (index < fields.len()) {
        access = "(*value)" + fields[index].clone()
        text += "    if (" + access.clone() + ".storage == KU_PROJECTION_STRING_OWNED) free(" + access + ".ptr);\n"
        index = index + 1
    }
    return text + "    *value = (" + element.clone() + "){0};\n}\n\n"
}

// The caller first validates the finite by-value layout graph. This is shared
// by typed array storage and stand-alone scratch owners in checked calls.
fn EmitOwnedStructOperations(&layouts: [StructLayout], root: int, &prefix: str, private_drop: bool): str {
    element = CTypeName(layouts[root - 1].module_index, layouts[root - 1].node)
    owned = collectOwnedFields(layouts, root, "", [])
    return emitOwnedStructElement(element, prefix, owned, private_drop)
}

fn EmitStructArrayHeader(&element: str, &array: str): str { return ProjectionArrayHeader(element, array) }

fn EmitStructArrayResultHeader(&array: str): str {
    return "typedef struct { bool ok; " + array.clone() + " value; KuBootstrapError error; } KuBootstrapResult_" + array.clone() + ";\n"
}

fn EmitCheckedStringArrayResultHeader(): str {
    return "typedef struct { bool ok; KuGuardStringArray value; KuBootstrapError error; } KuBootstrapResultStringArray;\n\n"
}

fn EmitOwnedStructArrayDrop(&layouts: [StructLayout], root: int, &array: str, &prefix: str): str {
    element = CTypeName(layouts[root - 1].module_index, layouts[root - 1].node)
    fields = collectOwnedFields(layouts, root, "", [])
    return emitOwnedElementDrop(element, prefix, fields, true) + EmitStructArrayDropUsing(array, prefix, prefix.clone() + "_element_drop", true)
}

fn EmitLinkedStringArrayPrelude(&validated: [TypeNameBinding], needs_header: bool): str {
    source = ""
    if (needs_header) { source += EmitStructArrayHeader("KuProjectionString", "KuGuardStringArray") }
    index = 0
    while (index < validated.len()) {
        if (validated[index].declaration_kind == "BuiltinArray" && validated[index].name == "str") {
            return source + EmitStructArrayReadValidation("KuProjectionString", "KuGuardStringArray", "ku_linked_view_str_array")
        }
        index = index + 1
    }
    return source
}

fn EmitStructArrayReadValidation(&element: str, &array: str, &prefix: str): str {
    text = "static size_t " + prefix.clone() + "_capacity(const " + array.clone() + " *array) {\n"
    // Stage0 still accepts a zero explicit capacity for legacy len-slot
    // initializers. Every newly produced header writes its full capacity.
    text += "    return array->capacity ? array->capacity : array->len;\n}\n\n"
    text += "static bool " + prefix.clone() + "_valid(const " + array.clone() + " *array) {\n"
    text += "    if (!array) return false;\n    size_t capacity = " + prefix.clone() + "_capacity(array);\n"
    text += "    return array->len <= capacity && capacity <= SIZE_MAX / sizeof(" + element.clone() + ") && (array->data || !capacity);\n}\n\n"
    return text
}

fn emitArrayContains(&element: str, &array: str, &prefix: str): str {
    text = "static bool " + prefix.clone() + "_contains(const " + array.clone() + " *array, const " + element.clone() + " *value) {\n"
    text += "    uintptr_t slot = (uintptr_t)value, base = (uintptr_t)array->data;\n"
    return text + "    return array->data && slot >= base && slot - base < " + prefix.clone() + "_capacity(array) * sizeof(" + element.clone() + ");\n}\n\n"
}

fn emitArrayBoundary(&element: str, &array: str, &prefix: str): str {
    text = EmitStructArrayReadValidation(element, array, prefix)
    text += emitArrayContains(element, array, prefix)
    text += "int " + prefix.clone() + "_clone_at(const " + array + " *array, int64_t index, " + element + " *out) {\n"
    text += "    if (!out || !" + prefix.clone() + "_valid(array) || " + prefix.clone() + "_contains(array, out)) return KU_STRUCT_ARRAY_INVALID;\n"
    text += "    if (index < 0 || (uint64_t)index >= array->len) return KU_STRUCT_ARRAY_BOUNDS;\n"
    text += "    return " + prefix.clone() + "_clone_element(&array->data[index], out) ? KU_STRUCT_ARRAY_OK : KU_STRUCT_ARRAY_OOM;\n}\n\n"
    return text
}

fn emitArrayAppend(&element: str, &array: str, &prefix: str, private_append: bool): str {
    text = ""
    if (private_append) { text = "static " }
    text += "int " + prefix.clone() + "_append_move(" + array.clone() + " *array, " + element.clone() + " *value) {\n"
    text += "    if (!value || !" + prefix.clone() + "_valid(array) || " + prefix.clone() + "_contains(array, value)) return KU_STRUCT_ARRAY_INVALID;\n"
    // One allocated C object must fit in the pointer-difference range.
    text += "    size_t limit = (size_t)PTRDIFF_MAX / sizeof(" + element.clone() + ");\n"
    text += "    size_t capacity = " + prefix.clone() + "_capacity(array);\n"
    text += "    if (capacity > limit || array->len == limit) return KU_STRUCT_ARRAY_CAPACITY;\n"
    text += "    if (array->len == capacity) {\n"
    text += "        size_t next = capacity ? (capacity > limit / 2 ? limit : capacity * 2) : (limit < 8 ? limit : 8);\n"
    text += "        " + element.clone() + " *data = realloc(array->data, next * sizeof(" + element.clone() + "));\n"
    text += "        if (!data) return KU_STRUCT_ARRAY_OOM;\n        array->data = data;\n        capacity = next;\n    }\n"
    text += "    array->data[array->len++] = *value;\n    array->capacity = capacity;\n    *value = (" + element.clone() + "){0};\n    return KU_STRUCT_ARRAY_OK;\n}\n\n"
    return text
}

fn EmitOwnedStructArrayAppend(&element: str, &array: str, &prefix: str): str {
    return emitArrayContains(element, array, prefix) + emitArrayAppend(element, array, prefix, true)
}

fn StructArrayStatuses(): str {
    return "enum { KU_STRUCT_ARRAY_OK, KU_STRUCT_ARRAY_INVALID, KU_STRUCT_ARRAY_BOUNDS, KU_STRUCT_ARRAY_CAPACITY, KU_STRUCT_ARRAY_OOM };\n\n"
}

fn emitArrayTransfer(&element: str, &array: str, &prefix: str): str {
    text = array.clone() + " " + prefix.clone() + "_move(" + array.clone() + " *array) {\n"
    text += "    " + array.clone() + " moved = *array;\n    *array = (" + array.clone() + "){0};\n    return moved;\n}\n\n"
    text += EmitStructArrayDropUsing(array, prefix, prefix.clone() + "_element_drop", false)
    text += emitArrayAppend(element, array, prefix, false)
    text += "int " + prefix.clone() + "_append_clone(" + array.clone() + " *array, const " + element.clone() + " *value) {\n"
    text += "    if (!value || !" + prefix.clone() + "_valid(array)) return KU_STRUCT_ARRAY_INVALID;\n"
    // Clone before grow, so a well-typed borrowed source may be an element
    // of this same array without leaving a pointer into reallocated storage.
    text += "    " + element + " copy = {0};\n"
    text += "    if (!" + prefix.clone() + "_clone_element(value, &copy)) return KU_STRUCT_ARRAY_OOM;\n"
    text += "    int status = " + prefix.clone() + "_append_move(array, &copy);\n"
    text += "    if (status != KU_STRUCT_ARRAY_OK) " + prefix.clone() + "_element_drop(&copy);\n"
    return text + "    return status;\n}\n"
}

fn EmitStructArrayDropUsing(&array: str, &prefix: str, &element_drop: str, private_drop: bool): str {
    linkage = ""
    if (private_drop) { linkage = "static " }
    return linkage + "void " + prefix.clone() + "_drop(" + array.clone() + " *array) {\n"
        + "    for (size_t i = 0; i < array->len; ++i) " + element_drop.clone() + "(&array->data[i]);\n"
        + "    free(array->data);\n    *array = (" + array.clone() + "){0};\n}\n\n"
}

// Build standalone array operations for one bound struct layout. The private
// ABI matches Stage0's header/member order. clone_at initializes an empty
// destination only on success. append_move consumes a separate element
// owner only on success. The enclosing lowered function owns unwinding.
fn EmitStructArrayC(&layouts: [StructLayout], module_index: int, declaration: int, at: Span): StructArrayC! {
    order = OrderCStructLayouts(layouts, module_index, declaration, at)?
    root = LayoutIndex(layouts, module_index, declaration)
    ops = EmitStructArrayOperations(layouts, root)
    ops.source = EmitNestedCLayouts(layouts, order)? + ops.source
    return ok(ops)
}

// Emit operations after the caller has validated and declared the layouts.
// These parts can be shared in the same translation unit with other roots.
fn EmitStructArrayOperations(&layouts: [StructLayout], root: int): StructArrayC {
    module_index = layouts[root - 1].module_index
    declaration = layouts[root - 1].node
    element = CTypeName(module_index, declaration)
    array = "KuArray_" + element.clone()
    prefix = "ku_owned_array_" + element.clone()
    owned = collectOwnedFields(layouts, root, "", [])
    text = "#include <stddef.h>\n#include <stdlib.h>\n"
    if (owned.len() != 0) { text += "#include <string.h>\n" }
    text += EmitStructArrayHeader(element, array)
    text += StructArrayStatuses()
    text += emitOwnedStructElement(element, prefix, owned, false) + emitArrayBoundary(element, array, prefix) + emitArrayTransfer(element, array, prefix)
    return StructArrayC { element_type: element, array_type: array, prefix: prefix, source: text }
}

fn CheckStructArrayType(&nodes: [Node], &edges: [int], &bindings: [TypeNameBinding], id: int): TypeNameBinding! {
    ty = nodes[id - 1].clone()
    if (ty.kind != "TypeArray" || ty.edge_count != 1) {
        RejectLayout("unsupported_struct_array_type", "expected a declared array of known structs", DeclarationSpan(ty))?
    }
    element = ExplicitType(bindings, edges[ty.first_edge], DeclarationSpan(ty))?
    if (element.declaration_kind != "Struct") {
        RejectLayout("unsupported_struct_array_type", "expected a bound struct element type", element.span.clone())?
    }
    return ok(element)
}

// Select support routines from a function's real typed result, independent
// of its body lowering. Array identity is the bound element, not its spelling.
fn EmitReturnedStructArrayC(&named: NamedModule, &bindings: [TypeNameBinding], &layouts: [StructLayout],
                            &function_name: str): StructArrayC! {
    index = 0
    while (index < named.names.declarations.len()) {
        entry = named.names.declarations[index].clone()
        if (entry.kind == "Function" && entry.name == function_name) {
            function = named.parsed.arena.nodes[entry.node - 1].clone()
            cursor = function.first_edge
            end = cursor + function.edge_count
            while (cursor < end && named.parsed.arena.nodes[named.parsed.arena.edges[cursor] - 1].kind == "Parameter") {
                cursor = cursor + 1
            }
            if (cursor >= end) {
                RejectLayout("unsupported_struct_array_type", "expected an explicit struct array result", entry.span.clone())?
            }
            element = CheckStructArrayType(named.parsed.arena.nodes, named.parsed.arena.edges, bindings, named.parsed.arena.edges[cursor])?
            return EmitStructArrayC(layouts, element.module_index, element.declaration_node, element.span)
        }
        index = index + 1
    }
    start = Span { line: 1, column: 1, offset: 0, end_line: 1, end_column: 1, end_offset: 0 }
    RejectLayout("unknown_struct_array_function", "undefined function '" + function_name.clone() + "'", start)?
    return ok(StructArrayC { element_type: "", array_type: "", prefix: "", source: "" })
}

fn BoundArrayCType(&binding: TypeNameBinding): str {
    if (binding.declaration_kind == "OwnedStringArray") { return "KuGuardStringArray" }
    if ((binding.declaration_kind == "BuiltinArray" && binding.name == "int") || LinkedNullIntArrayOwner(binding)) { return "KuArrayInt" }
    return "KuArray_" + CTypeName(binding.module_index, binding.declaration_node)
}

fn BoundArrayCPrefix(&binding: TypeNameBinding): str {
    if (binding.declaration_kind == "OwnedStringArray") { return "ku_linked_view_str_array" }
    if (LinkedNullIntArrayOwner(binding)) { return "ku_linked_view_int_array" }
    if (binding.declaration_kind == "BuiltinArray") {
        if (binding.name == "int") { return "ku_linked_view_int_array" }
        return "ku_linked_view_str_array"
    }
    return "ku_linked_view_" + CTypeName(binding.module_index, binding.declaration_node)
}

fn EmitBoundCarrierDeclarations(&types: [TypeNameBinding], &validated: [TypeNameBinding],
                            &defined: [str], str_array: bool): str {
    source = ""
    index = 0
    while (index < types.len()) {
        carrier = types[index].clone()
        if (carrier.declaration_kind == "UnitEnum") {
            source += EmitUnitEnumHeader(carrier)
        } else {
            element = CTypeName(carrier.module_index, carrier.declaration_node)
            if (carrier.declaration_kind == "BuiltinArray" && carrier.name == "int") { element = "int64_t" }
            array_type = BoundArrayCType(carrier)
            if (!ContainsType(defined, array_type)) { source += EmitStructArrayHeader(element, array_type) }
            validation = BoundArrayTypePosition(validated, carrier)
            if (validation > 0) {
                source += EmitStructArrayReadValidation(element, array_type, BoundArrayCPrefix(carrier))
            }
        }
        index = index + 1
    }
    if (str_array) {
        source += EmitLinkedStringArrayPrelude(validated, !ContainsType(defined, "KuGuardStringArray"))
    }
    return source
}

fn EmitBoundArrayResults(&layouts: [StructLayout], &owning_layouts: [StructLayout],
                         &types: [TypeNameBinding], chars: bool): str {
    source = ""
    index = 0
    while (index < types.len()) {
        owned = types[index].clone()
        if (owned.declaration_kind == "OwnedStringArray") {
            source += EmitCheckedStringArrayResultHeader()
            if (!chars) { source += ManagedStringArrayDrop() }
        } else if (LinkedNullIntArrayOwner(owned)) {
            source += "static void ku_linked_view_int_array_drop(KuArrayInt *array) {\n"
                + "    free(array->data);\n    *array = (KuArrayInt){0};\n}\n\n"
        } else {
            array_type = BoundArrayCType(owned)
            layout = LayoutIndex(layouts, owned.module_index, owned.declaration_node)
            source += EmitStructArrayResultHeader(array_type)
            prefix = BoundArrayCPrefix(owned)
            managed = LayoutIndex(owning_layouts, owned.module_index, owned.declaration_node)
            if (managed != 0) {
                source += EmitStructArrayDropUsing(array_type, prefix, OwningLayoutDropName(owned.module_index, owned.declaration_node), true)
            } else { source += EmitOwnedStructArrayDrop(layouts, layout, array_type, prefix) }
        }
        index = index + 1
    }
    return source
}

fn EmitBoundStringOperations(clone: bool, concat: bool, format: bool, prefix_suffix: bool): str {
    text = ""
    if (clone) { text += "#include <stdio.h>\n#include <string.h>\n\n" + EmitTryCloneString("ku_linked_clone_string") }
    if (concat) { text += EmitProjectionStringJoinHelpers(format) }
    if (prefix_suffix) { text += ScalarStringPrefixSuffixC() }
    return text
}

fn RegisterLinkedElementClone(state: LinkedNullState, layout: int): LinkedNullState {
    next = state
    if (!ContainsIndex(next.element_clones, layout)) { next.element_clones = next.element_clones.push(layout) }
    return next
}

fn EmitBoundElementClones(&layouts: [StructLayout], &requested: [int]): str {
    text = ""
    index = 0
    while (index < requested.len()) {
        layout = requested[index]
        prefix = "ku_linked_element_" + str(layout)
        if (HasBoundArrayMembers(layouts, layout)) {
            text += EmitLinkedManagedElementClone(layouts, layout, prefix)
        } else {
            text += EmitOwnedStructOperations(layouts, layout, prefix, true)
        }
        index = index + 1
    }
    return text
}

fn EmitBoundArrayAppenders(&types: [TypeNameBinding]): str {
    if (types.len() == 0) { return "" }
    text = StructArrayStatuses()
    seen: [str] = []
    index = 0
    while (index < types.len()) {
        ty = types[index].clone()
        array = BoundArrayCType(ty)
        if (!ContainsType(seen, array)) {
            element = "int64_t"
            if (ty.declaration_kind == "OwnedStringArray") { element = "KuProjectionString" }
            else if (!LinkedNullIntArrayOwner(ty)) { element = CTypeName(ty.module_index, ty.declaration_node) }
            text += EmitOwnedStructArrayAppend(element, array, BoundArrayCPrefix(ty))
            seen = seen.push(array)
        }
        index = index + 1
    }
    return text
}

// Snapshot a Copy element before realloc can invalidate an indexed source.
fn EmitLinkedIntAppend(&array: str, &value: str): str {
    return "    {\n        int64_t element = " + value.clone() + ";\n"
        + "        append_status = ku_linked_view_int_array_append_move(&" + array.clone() + ", &element);\n"
        + "    }\n    if (append_status != KU_STRUCT_ARRAY_OK) goto cleanup;\n"
}

fn OwnedRecordArrayCloneLayout(&layouts: [StructLayout], &array: TypeNameBinding): int {
    index = LayoutIndex(layouts, array.module_index, array.declaration_node)
    if (index == 0) { return 0 }
    if (HasBoundArrayMembers(layouts, index)) {
        if (CanCloneManagedRecord(layouts, index)) { return index }
        return 0
    }
    empty_paths: [str] = []
    owned_paths = collectOwnedFields(layouts, index, "", empty_paths)
    if (owned_paths.len() == 0) { return 0 }
    return index
}

fn OwnedRecordArrayCloneType(&array: TypeNameBinding): TypeNameBinding {
    return RetagTypeNameBinding(array.clone(), "OwnedStructArray")
}

fn EmitLinkedOwnedArrayClone(&layouts: [StructLayout], &source: str, &target: str, &array: TypeNameBinding, layout: int, view: bool): str {
    prefix = BoundArrayCPrefix(array)
    nested = HasBoundArrayMembers(layouts, layout)
    if (view) {
        return EmitCheckedRecordArrayClone("(*" + source.clone() + ")", target, prefix, layout, nested)
    }
    return EmitCheckedRecordArrayClone(source, target, prefix, layout, nested)
}

fn EmitLinkedArrayBody(&body: LinkedNullState, header: str, result_header: str): str! {
    text = header
    text += EmitBoundStringOperations(body.uses_clone, body.uses_concat, body.uses_int_format, body.uses_prefix_suffix)
    definitions = EmitCombinedCLayouts(body.layouts, body.owning_layouts)?
    if (definitions.array_types.len() > 0 && !text.contains("#include <stdlib.h>")) {
        text += "#include <stdlib.h>\n"
    }
    text += definitions.source
    text += EmitBoundCarrierDeclarations(body.carriers, body.validated_arrays, definitions.array_types, body.uses_str_array)
    if (body.uses_chars) {
        text += "#include <stdio.h>\n" + ManagedSourceCharactersRuntime(!body.uses_str_array &&
            !ContainsType(definitions.array_types, "KuGuardStringArray"))
    }
    if (body.uses_str_snapshot) { text += EmitOwnedStringArrayClone("ku_linked_str_array", "ku_linked_clone_string") }
    text += EmitBoundElementClones(body.layouts, body.element_clones)
    text += result_header + EmitBoundArrayResults(body.layouts, body.owning_layouts, body.owned_arrays, body.uses_chars)
    append_types: [TypeNameBinding] = []
    local_count = body.local_append_types.len()
    index = 0
    while (index < local_count) {
        type = body.local_append_types[index].clone()
        append_types = append_types.push(type)
        index = index + 1
    }
    slot_count = body.append_slots.len()
    index = 0
    while (index < slot_count) {
        slot = body.append_slots[index]
        type = body.slots[slot - 1].value.ty.clone()
        append_types = append_types.push(type)
        index = index + 1
    }
    return ok(text + EmitBoundArrayAppenders(append_types))
}

fn ReadOwnedArrayPushArgument(&named: NamedModule, &statement: Node): int! {
    edges = statement.first_edge
    call = named.parsed.arena.nodes[named.parsed.arena.edges[edges] - 1].clone()
    if (call.kind != "Call" || call.edge_count == 0) { return ok(0) }
    method = named.parsed.arena.nodes[named.parsed.arena.edges[call.first_edge] - 1].clone()
    if (method.kind != "Field" || method.text != "push") { return ok(0) }
    if (call.edge_count != 2 || method.edge_count != 1) {
        RejectLayout("linked_move_append", "push requires a receiver and one element", DeclarationSpan(call))?
    }
    receiver = named.parsed.arena.nodes[named.parsed.arena.edges[method.first_edge] - 1].clone()
    if (receiver.kind != "Variable" || receiver.edge_count != 0 || receiver.text != statement.text) {
        RejectLayout("linked_move_append", "push must return to its array owner", DeclarationSpan(receiver))?
    }
    return ok(named.parsed.arena.edges[call.first_edge + 1])
}

fn ManagedExplicitType(&types: [TypeNameBinding], &nodes: [Node], &edges: [int],
                       &layouts: [StructLayout], id: int): GuardType! {
    if (nodes[id - 1].kind == "TypeArray") {
        if (ProjectionIsStringArray(types, nodes, edges, id)?) { return ok(GuardType { kind: "str_array", layout: 0 }) }
        item = CheckStructArrayType(nodes, edges, types, id)?
        index = LayoutIndex(layouts, item.module_index, item.declaration_node)
        if (index <= 0) { RejectLayout("unknown_managed_layout", "array element has no bound layout", item.span.clone())? }
        return ok(GuardType { kind: "array", layout: index })
    }
    return GuardExplicitType(types, nodes, layouts, id)
}
