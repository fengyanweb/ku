import { Node } from "../stage2/ast.ku"
import { Span } from "../stage2/span.ku"
import { DeclarationSpan, NamedModule } from "./names.ku"
import { OrderCStructLayouts, EmitNestedCLayouts } from "./nested_struct_c.ku"
import { CTypeName, ProjectionArrayHeader } from "./struct_projection_c.ku"
import { ExplicitType, LayoutIndex, RejectLayout, StructLayout } from "./struct_layouts.ku"
import { TypeNameBinding } from "./type_names.ku"

struct StructArrayC {
    element_type: str
    array_type: str
    prefix: str
    source: str
}

fn collectOwnedFields(&layouts: [StructLayout], index: int, &prefix: str, paths: [str]): [str] {
    owned = paths
    field_index = 0
    while (field_index < layouts[index - 1].fields.len()) {
        field = layouts[index - 1].fields[field_index].resolved.clone()
        path = prefix.clone() + ".f" + str(field_index)
        if (field.declaration_kind == "Builtin" && field.name == "str") {
            owned = owned.push(path)
        } else if (field.declaration_kind == "Struct") {
            child = LayoutIndex(layouts, field.module_index, field.declaration_node)
            // The checked layout order establishes an acyclic, eight-level
            // bound before walking this graph.
            owned = collectOwnedFields(layouts, child, path, owned)
        }
        field_index = field_index + 1
    }
    return owned
}

fn EmitTryCloneString(&symbol: str): str {
    return "static bool " + symbol.clone() + "(KuProjectionString source, KuProjectionString *out) {\n" +
        "    if (source.storage == KU_PROJECTION_STRING_STATIC) { *out = source; return true; }\n" +
        "    if (!source.ptr) return true;\n" +
        "    size_t size = source.len ? source.len : 1;\n    uint8_t *data = malloc(size);\n    if (!data) return false;\n" +
        "    if (source.len) memcpy(data, source.ptr, source.len);\n" +
        "    *out = (KuProjectionString){ data, source.len, size, KU_PROJECTION_STRING_OWNED };\n    return true;\n}\n\n"
}

fn emitOwnedStructElement(&element: str, &prefix: str, &fields: [str], private_drop: bool): str {
    text = ""
    if (fields.len() != 0) { text = EmitTryCloneString(prefix.clone() + "_clone_string") }
    text += emitOwnedElementDrop(element, prefix, fields, private_drop)
    text += "static bool " + prefix.clone() + "_clone_element(const " + element.clone() + " *source, " + element.clone() + " *out) {\n"
    text += "    " + element + " copy = *source;\n"
    // Establish an empty owner for every managed field before any fallible
    // allocation. An error may then unwind just the initialized fields.
    index = 0
    while (index < fields.len()) {
        text += "    copy" + fields[index].clone() + " = (KuProjectionString){0};\n"
        index = index + 1
    }
    index = 0
    while (index < fields.len()) {
        field = fields[index].clone()
        text += "    if (!" + prefix.clone() + "_clone_string((*source)" + field.clone() + ", &copy" + field + ")) {\n"
        text += "        " + prefix.clone() + "_element_drop(&copy);\n        return false;\n    }\n"
        index = index + 1
    }
    return text + "    *out = copy;\n    return true;\n}\n\n"
}

fn emitOwnedElementDrop(&element: str, &prefix: str, &fields: [str], private_drop: bool): str {
    text = ""
    if (private_drop) { text += "static " }
    text += "void " + prefix.clone() + "_element_drop(" + element.clone() + " *value) {\n"
    index = 0
    while (index < fields.len()) {
        access = "(*value)" + fields[index].clone()
        text += "    if (" + access.clone() + ".storage == KU_PROJECTION_STRING_OWNED) free(" + access + ".ptr);\n"
        index = index + 1
    }
    return text + "    *value = (" + element.clone() + "){0};\n}\n\n"
}

// The caller first validates the finite by-value layout graph. This is shared
// by typed array storage and stand-alone scratch owners in checked calls.
fn EmitOwnedStructOperations(&layouts: [StructLayout], root: int, &prefix: str, private_drop: bool): str {
    element = CTypeName(layouts[root - 1].module_index, layouts[root - 1].node)
    owned = collectOwnedFields(layouts, root, "", [])
    return emitOwnedStructElement(element, prefix, owned, private_drop)
}

fn EmitStructArrayHeader(&element: str, &array: str): str { return ProjectionArrayHeader(element, array) }

fn EmitStructArrayResultHeader(&array: str): str {
    return "typedef struct { bool ok; " + array.clone() + " value; KuBootstrapError error; } KuBootstrapResult_" + array.clone() + ";\n"
}

fn EmitOwnedStructArrayDrop(&layouts: [StructLayout], root: int, &array: str, &prefix: str): str {
    element = CTypeName(layouts[root - 1].module_index, layouts[root - 1].node)
    fields = collectOwnedFields(layouts, root, "", [])
    return emitOwnedElementDrop(element, prefix, fields, true) + EmitStructArrayDropUsing(array, prefix, prefix.clone() + "_element_drop", true)
}

fn EmitStructArrayReadValidation(&element: str, &array: str, &prefix: str): str {
    text = "static size_t " + prefix.clone() + "_capacity(const " + array.clone() + " *array) {\n"
    // Stage0 still accepts a zero explicit capacity for legacy len-slot
    // initializers. Every newly produced header writes its full capacity.
    text += "    return array->capacity ? array->capacity : array->len;\n}\n\n"
    text += "static bool " + prefix.clone() + "_valid(const " + array.clone() + " *array) {\n"
    text += "    if (!array) return false;\n    size_t capacity = " + prefix.clone() + "_capacity(array);\n"
    text += "    return array->len <= capacity && capacity <= SIZE_MAX / sizeof(" + element.clone() + ") && (array->data || !capacity);\n}\n\n"
    return text
}

fn emitArrayContains(&element: str, &array: str, &prefix: str): str {
    text = "static bool " + prefix.clone() + "_contains(const " + array.clone() + " *array, const " + element.clone() + " *value) {\n"
    text += "    uintptr_t slot = (uintptr_t)value, base = (uintptr_t)array->data;\n"
    return text + "    return array->data && slot >= base && slot - base < " + prefix.clone() + "_capacity(array) * sizeof(" + element.clone() + ");\n}\n\n"
}

fn emitArrayBoundary(&element: str, &array: str, &prefix: str): str {
    text = EmitStructArrayReadValidation(element, array, prefix)
    text += emitArrayContains(element, array, prefix)
    text += "int " + prefix.clone() + "_clone_at(const " + array + " *array, int64_t index, " + element + " *out) {\n"
    text += "    if (!out || !" + prefix.clone() + "_valid(array) || " + prefix.clone() + "_contains(array, out)) return KU_STRUCT_ARRAY_INVALID;\n"
    text += "    if (index < 0 || (uint64_t)index >= array->len) return KU_STRUCT_ARRAY_BOUNDS;\n"
    text += "    return " + prefix.clone() + "_clone_element(&array->data[index], out) ? KU_STRUCT_ARRAY_OK : KU_STRUCT_ARRAY_OOM;\n}\n\n"
    return text
}

fn emitArrayAppend(&element: str, &array: str, &prefix: str, private_append: bool): str {
    text = ""
    if (private_append) { text = "static " }
    text += "int " + prefix.clone() + "_append_move(" + array.clone() + " *array, " + element.clone() + " *value) {\n"
    text += "    if (!value || !" + prefix.clone() + "_valid(array) || " + prefix.clone() + "_contains(array, value)) return KU_STRUCT_ARRAY_INVALID;\n"
    text += "    size_t limit = SIZE_MAX / sizeof(" + element.clone() + ");\n    if (array->len == limit) return KU_STRUCT_ARRAY_CAPACITY;\n"
    text += "    size_t capacity = " + prefix.clone() + "_capacity(array);\n"
    text += "    if (array->len == capacity) {\n"
    text += "        size_t next = capacity ? (capacity > limit / 2 ? limit : capacity * 2) : (limit < 8 ? limit : 8);\n"
    text += "        " + element.clone() + " *data = realloc(array->data, next * sizeof(" + element.clone() + "));\n"
    text += "        if (!data) return KU_STRUCT_ARRAY_OOM;\n        array->data = data;\n        capacity = next;\n    }\n"
    text += "    array->data[array->len++] = *value;\n    array->capacity = capacity;\n    *value = (" + element.clone() + "){0};\n    return KU_STRUCT_ARRAY_OK;\n}\n\n"
    return text
}

fn EmitOwnedStructArrayAppend(&element: str, &array: str, &prefix: str): str {
    return emitArrayContains(element, array, prefix) + emitArrayAppend(element, array, prefix, true)
}

fn StructArrayStatuses(): str {
    return "enum { KU_STRUCT_ARRAY_OK, KU_STRUCT_ARRAY_INVALID, KU_STRUCT_ARRAY_BOUNDS, KU_STRUCT_ARRAY_CAPACITY, KU_STRUCT_ARRAY_OOM };\n\n"
}

fn emitArrayTransfer(&element: str, &array: str, &prefix: str): str {
    text = array.clone() + " " + prefix.clone() + "_move(" + array.clone() + " *array) {\n"
    text += "    " + array.clone() + " moved = *array;\n    *array = (" + array.clone() + "){0};\n    return moved;\n}\n\n"
    text += EmitStructArrayDropUsing(array, prefix, prefix.clone() + "_element_drop", false)
    text += emitArrayAppend(element, array, prefix, false)
    text += "int " + prefix.clone() + "_append_clone(" + array.clone() + " *array, const " + element.clone() + " *value) {\n"
    text += "    if (!value || !" + prefix.clone() + "_valid(array)) return KU_STRUCT_ARRAY_INVALID;\n"
    // Clone before grow, so a well-typed borrowed source may be an element
    // of this same array without leaving a pointer into reallocated storage.
    text += "    " + element + " copy = {0};\n"
    text += "    if (!" + prefix.clone() + "_clone_element(value, &copy)) return KU_STRUCT_ARRAY_OOM;\n"
    text += "    int status = " + prefix.clone() + "_append_move(array, &copy);\n"
    text += "    if (status != KU_STRUCT_ARRAY_OK) " + prefix.clone() + "_element_drop(&copy);\n"
    return text + "    return status;\n}\n"
}

fn EmitStructArrayDropUsing(&array: str, &prefix: str, &element_drop: str, private_drop: bool): str {
    linkage = ""
    if (private_drop) { linkage = "static " }
    return linkage + "void " + prefix.clone() + "_drop(" + array.clone() + " *array) {\n"
        + "    for (size_t i = 0; i < array->len; ++i) " + element_drop.clone() + "(&array->data[i]);\n"
        + "    free(array->data);\n    *array = (" + array.clone() + "){0};\n}\n\n"
}

// Build standalone array operations for one bound struct layout. The private
// ABI matches Stage0's header/member order. clone_at initializes an empty
// destination only on success. append_move consumes a separate element
// owner only on success. The enclosing lowered function owns unwinding.
fn EmitStructArrayC(&layouts: [StructLayout], module_index: int, declaration: int, at: Span): StructArrayC! {
    order = OrderCStructLayouts(layouts, module_index, declaration, at)?
    root = LayoutIndex(layouts, module_index, declaration)
    ops = EmitStructArrayOperations(layouts, root)
    ops.source = EmitNestedCLayouts(layouts, order)? + ops.source
    return ok(ops)
}

// Emit operations after the caller has validated and declared the layouts.
// These parts can be shared in the same translation unit with other roots.
fn EmitStructArrayOperations(&layouts: [StructLayout], root: int): StructArrayC {
    module_index = layouts[root - 1].module_index
    declaration = layouts[root - 1].node
    element = CTypeName(module_index, declaration)
    array = "KuArray_" + element.clone()
    prefix = "ku_owned_array_" + element.clone()
    owned = collectOwnedFields(layouts, root, "", [])
    text = "#include <stddef.h>\n#include <stdlib.h>\n"
    if (owned.len() != 0) { text += "#include <string.h>\n" }
    text += EmitStructArrayHeader(element, array)
    text += StructArrayStatuses()
    text += emitOwnedStructElement(element, prefix, owned, false) + emitArrayBoundary(element, array, prefix) + emitArrayTransfer(element, array, prefix)
    return StructArrayC { element_type: element, array_type: array, prefix: prefix, source: text }
}

fn CheckStructArrayType(&nodes: [Node], &edges: [int], &bindings: [TypeNameBinding], id: int): TypeNameBinding! {
    ty = nodes[id - 1].clone()
    if (ty.kind != "TypeArray" || ty.edge_count != 1) {
        RejectLayout("unsupported_struct_array_type", "expected a declared array of known structs", DeclarationSpan(ty))?
    }
    element = ExplicitType(bindings, edges[ty.first_edge], DeclarationSpan(ty))?
    if (element.declaration_kind != "Struct") {
        RejectLayout("unsupported_struct_array_type", "expected a bound struct element type", element.span.clone())?
    }
    return ok(element)
}

// Select support routines from a function's real typed result, independent
// of its body lowering. Array identity is the bound element, not its spelling.
fn EmitReturnedStructArrayC(&named: NamedModule, &bindings: [TypeNameBinding], &layouts: [StructLayout],
                            &function_name: str): StructArrayC! {
    index = 0
    while (index < named.names.declarations.len()) {
        entry = named.names.declarations[index].clone()
        if (entry.kind == "Function" && entry.name == function_name) {
            function = named.parsed.arena.nodes[entry.node - 1].clone()
            cursor = function.first_edge
            end = cursor + function.edge_count
            while (cursor < end && named.parsed.arena.nodes[named.parsed.arena.edges[cursor] - 1].kind == "Parameter") {
                cursor = cursor + 1
            }
            if (cursor >= end) {
                RejectLayout("unsupported_struct_array_type", "expected an explicit struct array result", entry.span.clone())?
            }
            element = CheckStructArrayType(named.parsed.arena.nodes, named.parsed.arena.edges, bindings, named.parsed.arena.edges[cursor])?
            return EmitStructArrayC(layouts, element.module_index, element.declaration_node, element.span)
        }
        index = index + 1
    }
    start = Span { line: 1, column: 1, offset: 0, end_line: 1, end_column: 1, end_offset: 0 }
    RejectLayout("unknown_struct_array_function", "undefined function '" + function_name.clone() + "'", start)?
    return ok(StructArrayC { element_type: "", array_type: "", prefix: "", source: "" })
}
