// The emitter formats checked scalar plans without inspecting the input AST.

// Each instruction defines one int64 value identified by its expression node.
// The instructions retain Ku's left-to-right evaluation order.
struct ScalarIntInstruction {
    operation: str
    result_node: int
    operand: int
    right_node: int
    arguments: [int]
}

struct ScalarIntParameter {
    name: str
    // Zero is int, one is owned str, and two is View<str>.
    string_mode: int
}

struct ScalarStringPart {
    // A checked int expression, or a byte pointer and explicit length.
    source: str
    integer: bool
}

struct ScalarIntClause {
    control: str
    condition: str
    instructions: [ScalarIntInstruction]
    scalar_result: str
    string_parts: [ScalarStringPart]
}

struct ScalarIntFunction {
    function_node: int
    parameters: [ScalarIntParameter]
    clauses: [ScalarIntClause]
    // One is int, two is str, three is bool, and four is null!.
    result_type: int
    uses_string_comparison: bool
    uses_string_contains: bool
    uses_string_join: bool
    uses_string_replace: bool
    owned_string_body: str
}

struct ScalarIntBodyC {
    source: str
    uses_add: bool
    uses_sub: bool
    uses_mul: bool
    uses_div: bool
    uses_rem: bool
    uses_string: bool
    uses_string_comparison: bool
    uses_string_contains: bool
    uses_owned_string: bool
    uses_string_format: bool
    uses_string_replace: bool
    uses_output: bool
}

fn ScalarIntegerHelpers(add: bool, sub: bool, mul: bool, div: bool, rem: bool): str {
    text = "#include <stdint.h>\n\n"
    if (add || sub || mul || div || rem) {
        text += "#include <stdio.h>\n#include <stdlib.h>\n\n"
        text += "static void ku_scalar_overflow(void) {\n    fputs(\"integer overflow\\n\", stderr);\n    exit(EXIT_FAILURE);\n}\n\n"
    }
    if (add) {
        text += "static int64_t ku_scalar_add(int64_t a, int64_t b) {\n"
        text += "    if ((b > 0 && a > INT64_MAX - b) || (b < 0 && a < INT64_MIN - b)) ku_scalar_overflow();\n"
        text += "    return a + b;\n}\n\n"
    }
    if (sub) {
        text += "static int64_t ku_scalar_sub(int64_t a, int64_t b) {\n"
        text += "    if ((b > 0 && a < INT64_MIN + b) || (b < 0 && a > INT64_MAX + b)) ku_scalar_overflow();\n"
        text += "    return a - b;\n}\n\n"
    }
    if (mul) {
        text += "static int64_t ku_scalar_mul(int64_t a, int64_t b) {\n"
        text += "    if (a > 0) {\n"
        text += "        if ((b > 0 && a > INT64_MAX / b) || (b < 0 && b < INT64_MIN / a)) ku_scalar_overflow();\n"
        text += "    } else if (a < 0) {\n"
        text += "        if ((b > 0 && a < INT64_MIN / b) || (b < 0 && a < INT64_MAX / b)) ku_scalar_overflow();\n"
        text += "    }\n    return a * b;\n}\n\n"
    }
    if (div || rem) {
        // C leaves both operations undefined for MIN and -1. Ku reports
        // overflow for both, even though the mathematical remainder is zero.
        text += "static void ku_scalar_check_divisor(int64_t a, int64_t b) {\n"
        text += "    if (b == 0) {\n        fputs(\"division by zero\\n\", stderr);\n        exit(EXIT_FAILURE);\n    }\n"
        text += "    if (a == INT64_MIN && b == -1) ku_scalar_overflow();\n}\n\n"
    }
    if (div) {
        text += "static int64_t ku_scalar_div(int64_t a, int64_t b) {\n"
        text += "    ku_scalar_check_divisor(a, b);\n    return a / b;\n}\n\n"
    }
    if (rem) {
        text += "static int64_t ku_scalar_rem(int64_t a, int64_t b) {\n"
        text += "    ku_scalar_check_divisor(a, b);\n    return a % b;\n}\n\n"
    }
    return text
}

fn ScalarStringHelpers(carrier: bool, comparison: bool, contains: bool, owned: bool, join: bool, format: bool, null_result: bool): str {
    text = ""
    if (carrier || comparison || contains) { text += "#include <stddef.h>\n" }
    if (comparison || contains || join) { text += "#include <string.h>\n" }
    if (owned || join) { text += "#include <stdlib.h>\n" }
    if (join) { text += "#include <stdio.h>\n" }
    if (null_result) {
        // Use the normal Stage0 tags as well as its layout for a shared C ABI.
        text += "\ntypedef struct KuString { uint8_t* ptr; size_t len; size_t capacity; uint8_t storage; } KuString;\n"
        text += "typedef KuString KuBootstrapString;\ntypedef KuString KuScalarString;\n\n"
        text += "typedef struct KuError { KuString domain; KuString code; KuString message; } KuError;\n"
        text += "typedef struct KuResult_null { bool ok; uint8_t value; KuError error; } KuResult_null;\n\n"
    } else if (carrier) {
        text += "\n/* KuString layout. Static results are immutable and never freed by the caller. */\n"
        text += "typedef struct { uint8_t* ptr; size_t len; size_t capacity; uint8_t storage; } KuBootstrapString;\n"
        text += "typedef KuBootstrapString KuScalarString;\n\n"
    }
    if (comparison) {
        text += "static int ku_scalar_string_equal(const uint8_t* a, size_t n, const uint8_t* b, size_t m) {\n"
        text += "    return n == m && (n == 0 || memcmp(a, b, n) == 0);\n}\n\n"
    }
    if (contains) {
        text += "static bool ku_scalar_string_contains(const uint8_t* hay, size_t n, const uint8_t* needle, size_t m) {\n"
        text += "    if (m == 0) return true;\n    if (m > n) return false;\n"
        text += "    size_t last = n - m;\n    for (size_t i = 0; i <= last; ++i) {\n"
        text += "        if (memcmp(hay + i, needle, m) == 0) return true;\n    }\n    return false;\n}\n\n"
    }
    if (owned) {
        text += "static void ku_scalar_string_drop(KuScalarString value) {\n"
        text += "    if (value.storage == 1 && value.ptr) free(value.ptr);\n}\n\n"
    }
    if (join) { text += ScalarStringJoinHelpers(format) }
    return text
}

fn ScalarSymbol(function_node: int, result_type: int): str {
    if (result_type == 2) { return "ku_str_" + str(function_node) }
    if (result_type == 3) { return "ku_bool_" + str(function_node) }
    if (result_type == 4) { return "ku_result_null_" + str(function_node) }
    return "ku_int_" + str(function_node)
}

fn emitIntCall(&call: ScalarIntInstruction): str {
    text = ScalarSymbol(call.operand, 1) + "("
    index = 0
    while (index < call.arguments.len()) {
        if (index > 0) { text += ", " }
        text += "t" + str(call.arguments[index])
        index = index + 1
    }
    return text + ")"
}

fn ScalarStringJoinHelpers(format: bool): str {
    text = "typedef struct { const uint8_t* ptr; size_t len; } KuScalarStringPart;\n\n"
    if (format) {
        text += "static KuScalarStringPart ku_scalar_string_int(int64_t value, uint8_t digits[20]) {\n"
        text += "    uint64_t magnitude = (uint64_t)value;\n"
        text += "    if (value < 0) magnitude = UINT64_C(0) - magnitude;\n"
        text += "    size_t first = 20;\n"
        text += "    do { digits[--first] = (uint8_t)('0' + magnitude % 10); magnitude /= 10; } while (magnitude != 0);\n"
        text += "    if (value < 0) digits[--first] = '-';\n"
        text += "    return (KuScalarStringPart){ digits + first, 20 - first };\n}\n\n"
    }
    text += "static const char* ku_scalar_string_join(const KuScalarStringPart* parts, size_t count, KuBootstrapString* result) {\n"
    text += "    size_t len = 0;\n"
    text += "    for (size_t i = 0; i < count; ++i) {\n"
    text += "        if (parts[i].len > SIZE_MAX - len) return \"string allocation is too large\\n\";\n"
    text += "        len += parts[i].len;\n    }\n"
    text += "    uint8_t* data = malloc(len ? len : 1);\n"
    text += "    if (!data) return \"out of memory\\n\";\n"
    text += "    size_t at = 0;\n"
    text += "    for (size_t i = 0; i < count; ++i) {\n"
    text += "        if (parts[i].len != 0) memcpy(data + at, parts[i].ptr, parts[i].len);\n"
    text += "        at += parts[i].len;\n    }\n"
    text += "    *result = (KuBootstrapString){ data, len, len, 1u };\n"
    return text + "    return NULL;\n}\n\n"
}

fn EmitCheckedScalarArithmetic(&operation: str, &left: str, &right: str, &output: str): str {
    return "    int64_t " + output.clone() + ";\n"
        + "    if (!ku_guard_try_" + operation.clone() + "(" + left.clone() + ", " + right.clone()
        + ", &" + output.clone() + ")) { overflow = true; goto cleanup; }\n"
}

fn ScalarCheckedMultiplyC(): str {
    return "static bool ku_guard_try_mul(int64_t a, int64_t b, int64_t *out) {\n"
        + "    if (a > 0) {\n"
        + "        if ((b > 0 && a > INT64_MAX / b) || (b < 0 && b < INT64_MIN / a)) return false;\n"
        + "    } else if (a < 0) {\n"
        + "        if ((b > 0 && a < INT64_MIN / b) || (b < 0 && a < INT64_MAX / b)) return false;\n"
        + "    }\n    *out = a * b;\n    return true;\n}\n\n"
}

fn ScalarStringPrefixSuffixC(): str {
    return "#include <string.h>\n\n"
        + "static bool ku_scalar_string_matches(KuProjectionString value, KuProjectionString pattern, bool suffix) {\n"
        + "    if (pattern.len > value.len) return false;\n"
        + "    if (!pattern.len) return true;\n"
        + "    size_t offset = suffix ? value.len - pattern.len : 0;\n"
        + "    return memcmp(value.ptr + offset, pattern.ptr, pattern.len) == 0;\n"
        + "}\n\n"
}

fn EmitProjectionStringJoinHelpers(format: bool): str {
    return "#include <stdio.h>\n#include <string.h>\n\n"
        + "typedef KuProjectionString KuBootstrapString;\n" + ScalarStringJoinHelpers(format)
}

fn EmitScalarIntString(&value: str, &out: str): str {
    name = out.clone()
    digits = name.clone() + "_digits"
    part = name.clone() + "_part"
    return "    uint8_t " + digits.clone() + "[20];\n"
        + "    KuScalarStringPart " + part.clone() + " = ku_scalar_string_int(" + value.clone() + ", " + digits + ");\n"
        + "    if ((string_failure = ku_scalar_string_join(&" + part + ", 1, &" + name
        + ")) != NULL) goto cleanup;\n"
}

// A checked binary join reads both operands once, after Ku's ordered
// lowering has evaluated them. Their source owners remain with the caller.
fn EmitScalarStringPair(&left: str, &right: str, &result: str): str {
    name = result.clone()
    left_name = name.clone() + "_left"
    right_name = name.clone() + "_right"
    return "    const KuProjectionString " + left_name.clone() + " = " + left.clone() + ";\n"
        + "    const KuProjectionString " + right_name.clone() + " = " + right.clone() + ";\n"
        + "    const KuScalarStringPart " + name.clone() + "_parts[2] = {{ " + left_name.clone() + ".ptr, "
        + left_name + ".len }, { " + right_name.clone() + ".ptr, " + right_name + ".len }};\n"
        + "    ku_projection_string_drop(&" + name.clone() + ");\n"
        + "    string_failure = ku_scalar_string_join(" + name.clone() + "_parts, 2u, &" + name + ");\n"
        + "    if (string_failure) goto cleanup;\n"
}

struct ScalarStringAssignment {
    source: str
    uses_format: bool
}

fn EmitScalarStringAssignment(&parts: [ScalarStringPart], &indent: str): ScalarStringAssignment {
    return EmitScalarStringJoinTo(parts, indent, "result")
}

fn EmitScalarStringJoinTo(&parts: [ScalarStringPart], &indent: str, &destination: str): ScalarStringAssignment {
    count = str(parts.len())
    text = indent.clone() + "KuScalarStringPart parts[" + count.clone() + "];\n"
    uses_format = false
    index = 0
    while (index < parts.len()) {
        number = str(index)
        part = parts[index].clone()
        text += indent.clone()
        if (part.integer) {
            uses_format = true
            digits = "digits" + number.clone()
            text += "uint8_t " + digits.clone() + "[20];\n" + indent.clone()
            text += "parts[" + number + "] = ku_scalar_string_int(" + part.source + ", " + digits + ");\n"
        } else {
            text += "parts[" + number + "] = (KuScalarStringPart){ " + part.source + " };\n"
        }
        index = index + 1
    }
    text += indent.clone() + "failure = ku_scalar_string_join(parts, " + count + "u, &" + destination.clone() + ");\n"
    return ScalarStringAssignment { source: text, uses_format: uses_format }
}

fn ScalarResultCType(result_type: int): str {
    if (result_type == 2) { return "KuBootstrapString" }
    if (result_type == 3) { return "bool" }
    if (result_type == 4) { return "KuResult_null" }
    return "int64_t"
}

fn ScalarParameterCType(string_mode: int): str {
    if (string_mode == 1) { return "KuScalarString" }
    if (string_mode == 2) { return "const KuScalarString*" }
    return "int64_t"
}

fn EmitScalarIntPlan(&plan: ScalarIntFunction, external: bool): ScalarIntBodyC {
    result_type = ScalarResultCType(plan.result_type)
    signature = result_type.clone() + " " + ScalarSymbol(plan.function_node, plan.result_type) + "("
    if (!external) { signature = "static " + signature }
    declarations = ""
    drops = ""
    uses_string = plan.result_type == 2 || plan.result_type == 4
    if (plan.parameters.len() == 0) { signature += "void" }
    index = 0
    while (index < plan.parameters.len()) {
        if (index > 0) { signature += ", " }
        mode = plan.parameters[index].string_mode
        kind = ScalarParameterCType(mode)
        uses_string = uses_string || mode != 0
        param = "a" + str(index)
        signature += kind + " " + param.clone()
        if (mode == 1) { drops += "    ku_scalar_string_drop(" + param.clone() + ");\n" }
        declarations += "    (void)" + param + ";\n"
        index = index + 1
    }
    if (plan.owned_string_body != "") {
        source = signature + ") {\n" + declarations + plan.owned_string_body.clone() + drops
        source += "    if (failure) { fputs(failure, stderr); exit(EXIT_FAILURE); }\n    return result;\n}\n"
        return ScalarIntBodyC { source: source, uses_add: false, uses_sub: false, uses_mul: false,
            uses_div: false, uses_rem: false, uses_string: true, uses_string_comparison: false,
            uses_string_contains: false, uses_owned_string: true, uses_string_format: false,
            uses_string_replace: plan.uses_string_replace, uses_output: false }
    }
    uses_owned = drops != ""
    uses_cleanup = uses_owned || plan.uses_string_join
    if (plan.uses_string_join) {
        declarations += "    KuBootstrapString result = {0};\n    const char* failure = NULL;\n"
    } else if (uses_owned) {
        declarations += "    " + result_type + " result;\n"
    }
    text = signature + ") {\n" + declarations
    uses_add = false
    uses_sub = false
    uses_mul = false
    uses_div = false
    uses_rem = false
    uses_format = false
    uses_output = false
    depth = 0
    index = 0
    while (index < plan.clauses.len()) {
        control = plan.clauses[index].control.clone()
        if (control == "else" || control == "end") { depth = depth - 1 }
        indent = "    "
        padding = depth
        while (padding > 0) {
            indent += "    "
            padding = padding - 1
        }
        if (control == "if") {
            text += indent + "if (0 != (" + plan.clauses[index].condition + ")) {\n"
            depth = depth + 1
        } else if (control == "else") {
            text += indent + "} else {\n"
            depth = depth + 1
        } else if (control == "end") {
            text += indent + "}\n"
        } else {
            guarded = plan.clauses[index].condition != ""
            if (guarded) {
                text += "    if (0 != (" + plan.clauses[index].condition + ")) {\n"
                indent = "        "
            }
            result_node = 0
            instruction_count = plan.clauses[index].instructions.len()
            step = 0
            while (step < instruction_count) {
                operation = plan.clauses[index].instructions[step].operation.clone()
                operand = plan.clauses[index].instructions[step].operand
                if (operation == "println") {
                    text += indent.clone() + "(void)printf(\"%lld\\n\", (long long)t" + str(operand) + ");\n"
                    text += indent.clone() + "(void)fflush(stdout);\n"
                } else {
                    expression = ""
                    if (operation == "constant") {
                        expression = "INT64_C(" + str(operand) + ")"
                    } else if (operation == "parameter") {
                        expression = "a" + str(operand)
                    } else if (operation == "call") {
                        // Evaluated arguments already have temporaries. C call
                        // argument evaluation order cannot reorder the computations.
                        expression = emitIntCall(plan.clauses[index].instructions[step])
                    } else {
                        uses_add = uses_add || operation == "add"
                        uses_sub = uses_sub || operation == "sub"
                        uses_mul = uses_mul || operation == "mul"
                        uses_div = uses_div || operation == "div"
                        uses_rem = uses_rem || operation == "rem"
                        left = "INT64_C(0)"
                        if (operand != 0) { left = "t" + str(operand) }
                        expression = "ku_scalar_" + operation + "(" + left + ", t" + str(plan.clauses[index].instructions[step].right_node) + ")"
                    }
                    result_node = plan.clauses[index].instructions[step].result_node
                    text += indent.clone() + "int64_t t" + str(result_node) + " = " + expression + ";\n"
                }
                step = step + 1
            }
            if (control == "output") {
                uses_output = true
            } else {
                result = plan.clauses[index].scalar_result.clone()
                if (plan.result_type == 1) { result = "t" + str(result_node) }
                if (plan.clauses[index].string_parts.len() != 0) {
                    assignment = EmitScalarStringAssignment(plan.clauses[index].string_parts, indent)
                    text += assignment.source
                    uses_format = uses_format || assignment.uses_format
                    if (guarded) { text += indent + "goto cleanup;\n" }
                } else if (uses_cleanup) {
                    text += indent.clone() + "result = " + result + ";\n"
                    if (guarded) { text += indent + "goto cleanup;\n" }
                } else {
                    text += indent + "return " + result + ";\n"
                }
                if (guarded) { text += "    }\n" }
            }
        }
        index = index + 1
    }
    if (uses_cleanup) {
        if (plan.clauses.len() > 1) { text += "cleanup:\n" }
        text += drops
        // Allocation is fatal in the native str ABI. Give moved input
        // parameters back before reporting it, including the overflow case.
        if (plan.uses_string_join) {
            text += "    if (failure) { fputs(failure, stderr); exit(EXIT_FAILURE); }\n"
        }
        text += "    return result;\n"
    }
    text += "}\n"
    return ScalarIntBodyC { source: text, uses_add: uses_add, uses_sub: uses_sub, uses_mul: uses_mul,
        uses_div: uses_div, uses_rem: uses_rem,
        uses_string: uses_string, uses_string_comparison: plan.uses_string_comparison,
        uses_string_contains: plan.uses_string_contains, uses_owned_string: uses_owned,
        uses_string_format: uses_format, uses_string_replace: false, uses_output: uses_output }
}
