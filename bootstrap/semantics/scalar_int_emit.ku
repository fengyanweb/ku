// The emitter formats checked scalar plans without inspecting the input AST.

// Each instruction defines one int64 value identified by its expression node.
// The instructions retain Ku's left-to-right evaluation order.
struct ScalarIntInstruction {
    operation: str
    result_node: int
    operand: int
    right_node: int
    arguments: [int]
}

struct ScalarIntParameter {
    name: str
    // Zero is int, one is owned str, and two is View<str>.
    string_mode: int
}

struct ScalarIntClause {
    condition: str
    instructions: [ScalarIntInstruction]
    scalar_result: str
}

struct ScalarIntFunction {
    function_node: int
    parameters: [ScalarIntParameter]
    clauses: [ScalarIntClause]
    // One is int, two is str, and three is bool.
    result_type: int
    uses_string_comparison: bool
    uses_string_contains: bool
}

struct ScalarIntBodyC {
    source: str
    uses_add: bool
    uses_sub: bool
    uses_mul: bool
    uses_string: bool
    uses_string_comparison: bool
    uses_string_contains: bool
    uses_owned_string: bool
}

fn ScalarIntegerHelpers(add: bool, sub: bool, mul: bool): str {
    text = "#include <stdint.h>\n\n"
    if (add || sub || mul) {
        text += "#include <stdio.h>\n#include <stdlib.h>\n\n"
        text += "static void ku_scalar_overflow(void) {\n    fputs(\"integer overflow\\n\", stderr);\n    exit(EXIT_FAILURE);\n}\n\n"
    }
    if (add) {
        text += "static int64_t ku_scalar_add(int64_t a, int64_t b) {\n"
        text += "    if ((b > 0 && a > INT64_MAX - b) || (b < 0 && a < INT64_MIN - b)) ku_scalar_overflow();\n"
        text += "    return a + b;\n}\n\n"
    }
    if (sub) {
        text += "static int64_t ku_scalar_sub(int64_t a, int64_t b) {\n"
        text += "    if ((b > 0 && a < INT64_MIN + b) || (b < 0 && a > INT64_MAX + b)) ku_scalar_overflow();\n"
        text += "    return a - b;\n}\n\n"
    }
    if (mul) {
        text += "static int64_t ku_scalar_mul(int64_t a, int64_t b) {\n"
        text += "    if (a > 0) {\n"
        text += "        if ((b > 0 && a > INT64_MAX / b) || (b < 0 && b < INT64_MIN / a)) ku_scalar_overflow();\n"
        text += "    } else if (a < 0) {\n"
        text += "        if ((b > 0 && a < INT64_MIN / b) || (b < 0 && a < INT64_MAX / b)) ku_scalar_overflow();\n"
        text += "    }\n    return a * b;\n}\n\n"
    }
    return text
}

fn ScalarStringHelpers(carrier: bool, comparison: bool, contains: bool, owned: bool): str {
    text = ""
    if (carrier || comparison || contains) { text += "#include <stddef.h>\n" }
    if (comparison || contains) { text += "#include <string.h>\n" }
    if (owned) { text += "#include <stdlib.h>\n" }
    if (carrier) {
        text += "\n/* KuString layout. Static results are immutable and never freed by the caller. */\n"
        text += "typedef struct { uint8_t* ptr; size_t len; size_t capacity; uint8_t storage; } KuBootstrapString;\n"
        text += "typedef KuBootstrapString KuScalarString;\n\n"
    }
    if (comparison) {
        text += "static int ku_scalar_string_equal(const uint8_t* a, size_t n, const uint8_t* b, size_t m) {\n"
        text += "    return n == m && (n == 0 || memcmp(a, b, n) == 0);\n}\n\n"
    }
    if (contains) {
        text += "static bool ku_scalar_string_contains(const uint8_t* hay, size_t n, const uint8_t* needle, size_t m) {\n"
        text += "    if (m == 0) return true;\n    if (m > n) return false;\n"
        text += "    size_t last = n - m;\n    for (size_t i = 0; i <= last; ++i) {\n"
        text += "        if (memcmp(hay + i, needle, m) == 0) return true;\n    }\n    return false;\n}\n\n"
    }
    if (owned) {
        text += "static void ku_scalar_string_drop(KuScalarString value) {\n"
        text += "    if (value.storage == 1 && value.ptr) free(value.ptr);\n}\n\n"
    }
    return text
}

fn ScalarSymbol(function_node: int, result_type: int): str {
    if (result_type == 2) { return "ku_str_" + str(function_node) }
    if (result_type == 3) { return "ku_bool_" + str(function_node) }
    return "ku_int_" + str(function_node)
}

fn emitIntCall(&call: ScalarIntInstruction): str {
    text = ScalarSymbol(call.operand, 1) + "("
    index = 0
    while (index < call.arguments.len()) {
        if (index > 0) { text += ", " }
        text += "t" + str(call.arguments[index])
        index = index + 1
    }
    return text + ")"
}

fn EmitScalarIntPlan(&plan: ScalarIntFunction, external: bool): ScalarIntBodyC {
    result_type = "int64_t"
    if (plan.result_type == 2) { result_type = "KuBootstrapString" }
    else if (plan.result_type == 3) { result_type = "bool" }
    signature = result_type.clone() + " " + ScalarSymbol(plan.function_node, plan.result_type) + "("
    if (!external) { signature = "static " + signature }
    declarations = ""
    drops = ""
    uses_string = plan.result_type == 2
    if (plan.parameters.len() == 0) { signature += "void" }
    index = 0
    while (index < plan.parameters.len()) {
        if (index > 0) { signature += ", " }
        mode = plan.parameters[index].string_mode
        kind = "int64_t"
        if (mode == 1) { kind = "KuScalarString" }
        else if (mode == 2) { kind = "const KuScalarString*" }
        uses_string = uses_string || mode != 0
        param = "a" + str(index)
        signature += kind + " " + param.clone()
        if (mode == 1) { drops += "    ku_scalar_string_drop(" + param.clone() + ");\n" }
        declarations += "    (void)" + param + ";\n"
        index = index + 1
    }
    uses_owned = drops != ""
    if (uses_owned) { declarations += "    " + result_type + " result;\n" }
    text = signature + ") {\n" + declarations
    uses_add = false
    uses_sub = false
    uses_mul = false
    index = 0
    while (index < plan.clauses.len()) {
        clause = plan.clauses[index].clone()
        guarded = clause.condition != ""
        indent = "    "
        if (guarded) {
            text += "    if (" + clause.condition + ") {\n"
            indent = "        "
        }
        result_node = 0
        step = 0
        while (step < clause.instructions.len()) {
            instruction = clause.instructions[step].clone()
            expression = ""
            if (instruction.operation == "constant") {
                expression = "INT64_C(" + str(instruction.operand) + ")"
            } else if (instruction.operation == "parameter") {
                expression = "a" + str(instruction.operand)
            } else if (instruction.operation == "call") {
                // Evaluated arguments already have temporaries. C call
                // argument evaluation order cannot reorder the computations.
                expression = emitIntCall(instruction)
            } else {
                uses_add = uses_add || instruction.operation == "add"
                uses_sub = uses_sub || instruction.operation == "sub"
                uses_mul = uses_mul || instruction.operation == "mul"
                left = "INT64_C(0)"
                if (instruction.operand != 0) { left = "t" + str(instruction.operand) }
                expression = "ku_scalar_" + instruction.operation + "(" + left + ", t" + str(instruction.right_node) + ")"
            }
            result_node = instruction.result_node
            text += indent.clone() + "int64_t t" + str(result_node) + " = " + expression + ";\n"
            step = step + 1
        }
        result = clause.scalar_result
        if (plan.result_type == 1) { result = "t" + str(result_node) }
        if (uses_owned) {
            text += indent.clone() + "result = " + result + ";\n"
            if (guarded) { text += indent + "goto cleanup;\n" }
        } else {
            text += indent + "return " + result + ";\n"
        }
        if (guarded) { text += "    }\n" }
        index = index + 1
    }
    if (uses_owned) {
        if (plan.clauses.len() > 1) { text += "cleanup:\n" }
        text += drops + "    return result;\n"
    }
    text += "}\n"
    return ScalarIntBodyC { source: text, uses_add: uses_add, uses_sub: uses_sub, uses_mul: uses_mul,
        uses_string: uses_string, uses_string_comparison: plan.uses_string_comparison,
        uses_string_contains: plan.uses_string_contains, uses_owned_string: uses_owned }
}
