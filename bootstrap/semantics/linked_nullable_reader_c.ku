import { Node } from "../stage2/ast.ku"
import { RejectLocalCapture } from "./call_contracts.ku"
import { FinishLinkedFunctionC } from "./guarded_struct_c.ku"
import { ManagedSourceCharactersErrors } from "./guarded_string_parts.ku"
import { DeclarationSpan, IsNamedFunction } from "./names.ku"
import { LinkedMemberUnavailable, LinkedNullDropC, LinkedViewArgument, MoveLinkedNullSlot, RecordLinkedMemberMove, RequireLinkedMove } from "./linked_member_ownership.ku"
import { AddLinkedNullSlot, CloneLinkedStringSlot, LinkedCallableSlot, RegisterLinkedNullType, ValidateLinkedPayload } from "./linked_parameters_c.ku"
import { LinkedBuiltin, LinkedIntResult, LinkedNullCType, LinkedNullChild, LinkedNullHasResultValue, LinkedNullNode, LinkedNullParameterType, LinkedNullProject, LinkedNullType, LinkedStringResult, LowerLinkedContextualArgument, ReadLinkedResult, SameLinkedType } from "./linked_null_types_c.ku"
import { LinkedCheckedCall, LinkedLocalAppendIndex, LinkedNullBinding, LinkedNullExpression, LinkedNullFunction, LinkedNullRegion, LinkedNullSlot, LinkedRecordFields, LinkedNullState, LinkedNullValue } from "./link_plan_c.ku"
import { RestoreLinkedThunkFrame } from "./link_plan_json_c.ku"
import { HasLinkedContextualArgument, LinkedOptionalIntHeader, StartLinkedThunkFrame, ResolveLinkedCall } from "./scalar_result_null.ku"
import { FieldIndex, RejectLayout } from "./struct_layouts.ku"
import { ContainsIndex, ContainsType, CTypeName, LinkedIntArrayCallbackFaultPending } from "./struct_projection_c.ku"
import { RetagTypeNameBinding, TypeNameBinding } from "./type_names.ku"

fn nullableReaderTypeDeclaration(&ty: TypeNameBinding): str! {
    record = CTypeName(ty.module_index, ty.declaration_node)
    carrier = LinkedNullCType(ty)?
    return ok("typedef struct { KuBootstrapOptionalInt (*entry)(const KuProjectionString*, const " + record
        + "*); KuProjectionString capture; } " + carrier + ";\n")
}

fn LinkedOptionalReaderHeader(&slots: [LinkedNullSlot], &result: TypeNameBinding): str! {
    declarations = ""
    known: [str] = []
    if (result.declaration_kind == "NullableRecordViewReader") {
        declarations += nullableReaderTypeDeclaration(result)?
        known = known.push(LinkedNullCType(result)?)
    }
    index = 0
    while (index < slots.len()) {
        ty = slots[index].value.ty.clone()
        if (ty.declaration_kind == "NullableRecordViewReader") {
            carrier = LinkedNullCType(ty)?
            if (!ContainsType(known, carrier)) {
                declarations += nullableReaderTypeDeclaration(ty)?
                known = known.push(carrier)
            }
        }
        index = index + 1
    }
    base = result.clone()
    if (declarations != "") { base.declaration_kind = "NullableInt" }
    return ok(LinkedOptionalIntHeader(slots, base) + declarations)
}

fn invokeLinkedOptionalReader(&project: LinkedNullProject, argument: LinkedNullExpression,
                              &callback: LinkedNullValue, &call: Node, id: int): LinkedNullExpression! {
    at = DeclarationSpan(call)
    if (LinkedMemberUnavailable(argument.state, callback, true)) {
        RejectLayout("linked_callback_argument", "a callback argument cannot consume the callback itself", at.clone())?
    }
    view = RetagTypeNameBinding(callback.ty.clone(), "StructView")
    value = LinkedViewArgument(view, argument.value)?
    result = RetagTypeNameBinding(LinkedBuiltin("int", at), "NullableInt")
    output = AddLinkedNullSlot(project, argument.state, "", "t" + str(id), result, false)?
    name = callback.text.clone()
    output.state.uses_scoped_reader = true
    output.state.code += "    if (!" + name.clone() + ".entry || (" + name.clone() + ".capture.len && !" + name.clone()
        + ".capture.ptr)) { captured_array_failure = \"invalid owned reader callback\\n\"; goto cleanup; }\n"
        + "    " + output.value.text.clone() + " = " + name.clone() + ".entry(&" + name + ".capture, " + value + ");\n"
    output.state.slots[output.value.slot - 1].live = true
    return ok(output)
}

fn InvokeLinkedReader(&project: LinkedNullProject, argument: LinkedNullExpression, &callback: LinkedNullValue,
                      &call: Node, id: int): LinkedNullExpression! {
    if (callback.ty.declaration_kind == "NullableRecordViewReader") {
        return invokeLinkedOptionalReader(project, argument, callback, call, id)
    }
    if (!LinkedIntResult(argument.value.ty)) {
        RejectLayout("linked_callback_argument", "reader callback requires a Copy int index", DeclarationSpan(call))?
    }
    result = callback.ty.clone()
    result.declaration_kind = "Struct"
    output = AddLinkedNullSlot(project, argument.state, "", "t" + str(id), result, false)?
    name = callback.text.clone()
    output.state.uses_scoped_reader = true
    output.state.code += "    if (!" + name.clone() + ".entry || !" + name.clone() + ".failure) {\n"
        + "        if (" + name.clone() + ".failure) " + name.clone() + ".failure->array_error = \"invalid scoped reader callback\\n\";\n"
        + "        else captured_array_failure = \"invalid scoped reader callback\\n\";\n        goto cleanup;\n    }\n"
        + "    " + output.value.text.clone() + " = " + name.clone() + ".entry(" + name.clone() + ".environment, "
        + name.clone() + ".failure, " + argument.value.text + ");\n"
        + "    if (" + LinkedIntArrayCallbackFaultPending(name + ".failure") + ") goto cleanup;\n"
    output.state.slots[output.value.slot - 1].live = true
    return ok(output)
}

fn LinkedReaderCallable(&state: LinkedNullState, slot: int): bool {
    return LinkedCallableSlot(state, slot) || slot > 0 && state.slots[slot - 1].live
        && state.slots[slot - 1].value.ty.declaration_kind == "NullableRecordViewReader"
}

struct LinkedLocalCaptures {
    slots: [int]
    calls: [int]
}

// The validated arena stores this function's subtree contiguously. A second
// function or a declaration that could shadow an outer slot needs its own
// binding rules before this restricted same-frame lowering can accept it.
fn ReadLinkedParameterCaptures(&project: LinkedNullProject, &state: LinkedNullState,
                           &function: Node, id: int, body_start: int, parameter_count: int): LinkedLocalCaptures! {
    names: [str] = []
    index = 0
    while (index < parameter_count) {
        parameter = LinkedNullNode(project, 1, LinkedNullChild(project, 1, function, index))
        names = names.push(parameter.text)
        index = index + 1
    }
    start = LinkedNullChild(project, 1, function, body_start)
    descending = true
    while (descending) {
        descending = project.supplied[0].named.parsed.arena.nodes[start - 1].edge_count > 0
        if (descending) {
            start = project.supplied[0].named.parsed.arena.edges[
                project.supplied[0].named.parsed.arena.nodes[start - 1].first_edge]
        }
    }
    slots: [int] = []
    calls: [int] = []
    has_local_calls = state.local_appends.len() > 0
    cursor = start
    while (cursor < id) {
        node = LinkedNullNode(project, 1, cursor)
        if (has_local_calls && node.kind == "Call" && node.edge_count > 0) {
            target = LinkedNullNode(project, 1, LinkedNullChild(project, 1, node, 0))
            if (target.kind == "Variable" && target.edge_count == 0 && !ContainsType(names, target.text) &&
                LinkedNullBinding(state.slots, target.text) == 0) {
                index = LinkedLocalAppendIndex(state, target.text)
                if (index > 0 && !ContainsIndex(calls, index)) { calls = calls.push(index) }
            }
        }
        use = node.kind == "Variable" || node.kind == "Assign"
        if (IsNamedFunction(node.kind) || node.kind == "FunctionExpr" || (use && node.text == function.text)) {
            RejectLocalCapture(node, "a local callback cannot define or reference a nested callable")?
        }
        declares = node.kind == "VarDecl" || node.kind == "For" || node.kind == "CatchBinding" ||
            node.kind == "ObjectDestructureLocal" || node.kind == "ObjectDestructureRest"
        if ((use || declares) && !ContainsType(names, node.text)) {
            slot = LinkedNullBinding(state.slots, node.text)
            if (slot > 0 && declares) {
                RejectLocalCapture(node, "a local callback binding cannot shadow an outer capture")?
            }
            if (slot > 0 && !ContainsIndex(slots, slot)) { slots = slots.push(slot) }
        }
        cursor = cursor + 1
    }
    return ok(LinkedLocalCaptures { slots: slots, calls: calls })
}


struct LinkedOwnedReaderBody {
    state: LinkedNullState
    result: TypeNameBinding
    capture: int
    function: int
    start: int
}

fn ReadLinkedOwnedReader(&project: LinkedNullProject, &parent: LinkedNullState, &statement: Node,
                         &reader: TypeNameBinding, statement_id: int, last_statement: int): LinkedOwnedReaderBody! {
    id = LinkedNullChild(project, 1, statement, 0)
    function = LinkedNullNode(project, 1, id)
    if (function.edge_count < 2) { RejectLocalCapture(function, "an owned reader requires a named View parameter and a body")? }
    parameter = LinkedNullNode(project, 1, LinkedNullChild(project, 1, function, 0))
    if (parameter.kind != "Parameter" || parameter.edge_count != 1 || parameter.int_value != 1) {
        RejectLocalCapture(parameter, "an owned reader requires one typed View parameter")?
    }
    view = LinkedNullParameterType(project, 1, LinkedNullChild(project, 1, parameter, 0), true)?
    expected = RetagTypeNameBinding(reader.clone(), "StructView")
    if (!SameLinkedType(view, expected)) {
        RejectLocalCapture(parameter, "reader View must match its declared nominal parameter")?
    }
    start = 1
    result = RetagTypeNameBinding(LinkedBuiltin("int", DeclarationSpan(function)), "NullableInt")
    second = LinkedNullNode(project, 1, LinkedNullChild(project, 1, function, 1))
    if (second.kind == "TypeUnion") {
        written = ReadLinkedResult(project, 1, LinkedNullChild(project, 1, function, 1), false)?
        if (!SameLinkedType(written, result)) { RejectLocalCapture(second, "reader result must be int | null")? }
        start = 2
    }
    if (start >= function.edge_count || second.kind == "Parameter") {
        RejectLocalCapture(function, "an owned reader requires one View parameter and a nonempty body")?
    }
    captured = ReadLinkedParameterCaptures(project, parent, function, id, start, 1)?
    if (captured.slots.len() != 1 || captured.calls.len() != 0) {
        RejectLocalCapture(function, "an owned reader requires one immutable str capture")?
    }
    source = captured.slots[0]
    owner = parent.slots[source - 1].clone()
    if (!owner.source_parameter || !owner.live || owner.value.borrowed || owner.value.ty.declaration_kind != "Builtin" || owner.value.ty.name != "str") {
        RejectLocalCapture(function, "an owned reader requires a live owning str parameter as its capture")?
    }
    RequireLinkedMove(parent, owner.value)?
    cursor = statement_id + 1
    end = last_statement + 1
    while (cursor < end) {
        use = LinkedNullNode(project, 1, cursor)
        if (use.kind == "Variable" && use.text == owner.binding) {
            RejectLocalCapture(use, "the immutable reader capture is still used after the closure is created")?
        }
        cursor = cursor + 1
    }
    frame = StartLinkedThunkFrame(parent)
    frame.plain_value_result = true
    input = AddLinkedNullSlot(project, frame, parameter.text, "input", view, true)?
    capture_type = RetagTypeNameBinding(owner.value.ty, "StringView")
    capture_slot = AddLinkedNullSlot(project, input.state, owner.binding, "capture", capture_type, true)?
    capture_slot.state.code += "    (void)input; (void)capture;\n"
    return ok(LinkedOwnedReaderBody { state: capture_slot.state, result: result, capture: source, function: id, start: start })
}

fn FinishLinkedOwnedReader(&project: LinkedNullProject, &parent: LinkedNullState, body: LinkedNullRegion,
                           &statement: Node, &reader: TypeNameBinding, capture: int, id: int): LinkedNullState! {
    if (!body.terminal) { RejectLocalCapture(statement, "an owned reader must return int or null on all paths")? }
    symbol = "ku_owned_reader_" + str(id)
    next = body.state
    signature = "const KuProjectionString *capture, const " + CTypeName(reader.module_index, reader.declaration_node) + " *input"
    character_errors = ""
    if (next.uses_chars) { character_errors = ManagedSourceCharactersErrors() }
    next.callback_helpers += "\nstatic " + FinishLinkedFunctionC("", next, symbol, signature,
        "KuBootstrapOptionalInt", "", character_errors, "")
    next = RestoreLinkedThunkFrame(next, parent)
    result = AddLinkedNullSlot(project, next, statement.text.clone(), "reader" + str(id), reader.clone(), false)?
    owner = parent.slots[capture - 1].value.clone()
    result.state.code += "    " + result.value.text.clone() + " = (" + LinkedNullCType(reader)? + "){"
        + symbol + ", " + owner.text.clone() + "};\n"
    result.state.slots[result.value.slot - 1].live = true
    return MoveLinkedNullSlot(result.state, owner)
}

fn LinkedCallArgument(&project: LinkedNullProject, &call: Node, &callee: LinkedNullFunction, index: int): int {
    if (callee.unit == 0 && callee.node == 4) {
        if (index == 1) { return LinkedNullChild(project, 1, call, 1) }
        return LinkedNullChild(project, 1, LinkedNullNode(project, 1, LinkedNullChild(project, 1, call, 0)), 0)
    }
    return LinkedNullChild(project, 1, call, index + 1)
}

fn directCheckedStatementCall(&project: LinkedNullProject, &statement: Node): int {
    if (statement.kind != "ExprStmt" || statement.edge_count != 1) { return 0 }
    unwrap = LinkedNullNode(project, 1, LinkedNullChild(project, 1, statement, 0))
    if (unwrap.kind != "TryUnwrap" || unwrap.edge_count != 1) { return 0 }
    id = LinkedNullChild(project, 1, unwrap, 0)
    call = LinkedNullNode(project, 1, id)
    if (call.kind == "Call" && call.edge_count == 2) { return id }
    return 0
}

fn retainedFieldSite(&project: LinkedNullProject, &state: LinkedNullState, &statement: Node): int {
    if ((statement.kind == "Assign" || statement.kind == "VarDecl")
        && LinkedNullBinding(state.slots, statement.text) == 0) {
        return LinkedNullChild(project, 1, statement, statement.edge_count - 1)
    }
    id = directCheckedStatementCall(project, statement)
    if (id == 0) { return 0 }
    call = LinkedNullNode(project, 1, id)
    field = LinkedNullChild(project, 1, call, 1)
    argument = LinkedNullNode(project, 1, field)
    if (argument.kind != "Field") { return 0 }
    target = LinkedNullNode(project, 1, LinkedNullChild(project, 1, call, 0))
    if (target.kind != "Variable" || LinkedLocalAppendIndex(state, target.text) != 0) { return 0 }
    try {
        callee = ResolveLinkedCall(project, state, call, target, true)?
        if (LinkedStringResult(callee.parameters[0])) { return field }
        return 0
    } catch (err) { return 0 }
}

fn readonlyOutputBetweenMoveAndView(&project: LinkedNullProject, &statement: Node): bool {
    if (statement.edge_count != 1) { return false }
    value = LinkedNullNode(project, 1, LinkedNullChild(project, 1, statement, 0))
    if (statement.kind == "ExprStmt" && value.kind == "Call" && value.edge_count == 2) {
        name = LinkedNullNode(project, 1, LinkedNullChild(project, 1, value, 0))
        if (name.kind != "Variable" || name.text != "println") { return false }
        printed = LinkedNullNode(project, 1, LinkedNullChild(project, 1, value, 1))
        return printed.kind == "Variable" || printed.kind == "String"
    }
    return statement.kind == "Print" && (value.kind == "Variable" || value.kind == "String")
}

// At entry depth, an existing record binding cannot be shadowed between the
// field use and a later direct call if only simple output intervenes. Stop on
// writes, nested regions and other calls instead of retaining their fields.
struct LinkedRetainedViewPlan {
    field: int
    end: int
}

struct LinkedViewRetention {
    field: int
    whole_view: bool
}

fn NoLinkedRetention(): LinkedViewRetention {
    return LinkedViewRetention { field: 0, whole_view: false }
}

fn RejectLinkedTerminalIteration(&body: Node, countdown: int): null! {
    update = "increment"
    if (countdown != 0) { update = "decrement" }
    return RejectLayout("unsupported_linked_loop_body", "a counted iteration must reach its checked " + update, DeclarationSpan(body))
}

fn isOwnedLinkedStringField(&state: LinkedNullState, &owner: TypeNameBinding, &expression: Node): bool {
    try {
        fields = LinkedRecordFields(state.layouts, state.owning_layouts, owner)?
        ordinal = FieldIndex(fields, expression.text)
        return ordinal > 0 && LinkedStringResult(fields[ordinal - 1].resolved)
    } catch (err) { return false }
}

fn PlanLinkedRetainedView(&project: LinkedNullProject, &state: LinkedNullState, &region: Node,
                         &statement: Node, index: int): LinkedRetainedViewPlan {
    none = LinkedRetainedViewPlan { field: 0, end: index }
    field = retainedFieldSite(project, state, statement)
    if (field == 0) { return none }
    expression = LinkedNullNode(project, 1, field)
    if (expression.kind != "Field" || expression.edge_count != 1) { return none }
    root = LinkedNullNode(project, 1, LinkedNullChild(project, 1, expression, 0))
    if (root.kind != "Variable" || root.edge_count != 0) { return none }
    slot = LinkedNullBinding(state.slots, root.text)
    if (slot == 0 || !state.slots[slot - 1].live || state.slots[slot - 1].parameter
        || state.slots[slot - 1].value.borrowed || state.slots[slot - 1].moved_members.len() != 0) { return none }
    owner = state.slots[slot - 1].value.ty.clone()
    if (owner.declaration_kind != "Struct" || !isOwnedLinkedStringField(state, owner, expression)) { return none }
    limit = region.edge_count
    start = index + 1
    cursor = start
    while (cursor < limit) {
        candidate = LinkedNullNode(project, 1, LinkedNullChild(project, 1, region, cursor))
        view = directCheckedStatementCall(project, candidate)
        if (view != 0) {
            call = LinkedNullNode(project, 1, view)
            argument = LinkedNullNode(project, 1, LinkedNullChild(project, 1, call, 1))
            target = LinkedNullNode(project, 1, LinkedNullChild(project, 1, call, 0))
            if (argument.kind != "Variable" || argument.text != root.text || target.kind != "Variable"
                || target.text == statement.text || LinkedLocalAppendIndex(state, target.text) != 0) { return none }
            try {
                callee = ResolveLinkedCall(project, state, call, target, true)?
                parameter = callee.parameters[0].clone()
                if (parameter.declaration_kind == "StructView" && parameter.module_index == owner.module_index
                    && parameter.declaration_node == owner.declaration_node) {
                    return LinkedRetainedViewPlan { field: field, end: cursor }
                }
                return none
            } catch (err) { return none }
        }
        if (!readonlyOutputBetweenMoveAndView(project, candidate)) { return none }
        cursor = cursor + 1
    }
    return none
}

fn RetainLinkedField(&project: LinkedNullProject, source: LinkedNullExpression, id: int): LinkedNullExpression! {
    if (!LinkedStringResult(source.value.ty) || source.value.member_path == "") {
        RejectLayout("linked_view_move", "expected the proven owned string member for the later View", source.value.ty.span.clone())?
    }
    RequireLinkedMove(source.state, source.value)?
    field = source.value.clone()
    snapshot = CloneLinkedStringSlot(project, source, "retained" + str(id))?
    snapshot.state = RecordLinkedMemberMove(snapshot.state, field)
    return ok(snapshot)
}

fn LowerLinkedStaticReaderLocal(&project: LinkedNullProject, state: LinkedNullState,
                                &statement: Node, declared: TypeNameBinding): LinkedNullState! {
    source = LinkedNullChild(project, 1, statement, 1)
    eligible = HasLinkedContextualArgument(project, state, declared, source, 0)?
    if (!eligible) {
        RejectLocalCapture(statement, "an owned reader declaration requires a matching static function")?
    }
    initializer = LowerLinkedContextualArgument(project, state, declared, source)?
    slot = AddLinkedNullSlot(project, initializer.state, statement.text.clone(), "l" + str(source), declared, false)?
    slot.state.code += "    " + slot.value.text.clone() + " = " + initializer.value.text.clone() + ";\n"
    slot.state.slots[slot.value.slot - 1].live = true
    return MoveLinkedNullSlot(slot.state, initializer.value)
}

fn CheckLinkedLocalInitializer(&project: LinkedNullProject, &statement: Node, &ty: TypeNameBinding): null! {
    if (statement.edge_count == 2) {
        declared = LinkedNullType(project, 1, LinkedNullChild(project, 1, statement, 0))?
        if (!SameLinkedType(declared, ty)) {
            RejectLayout("linked_local_type", "initializer must match the declared local type", ty.span.clone())?
        }
    }
    return ok(null)
}

fn LinkedRetainedViewUnavailable(&state: LinkedNullState, &value: LinkedNullValue, admit: bool): bool {
    if (admit && value.slot > 0 && value.member_path == ""
        && state.slots[value.slot - 1].live && state.slots[value.slot - 1].moved_members.len() == 1) { return false }
    return LinkedMemberUnavailable(state, value, true)
}

fn FinishLinkedCheckedStatement(&project: LinkedNullProject, call: LinkedCheckedCall): LinkedNullState! {
    next = call.state
    if (!LinkedNullHasResultValue(call.result)) { return ok(next) }
    payload = call.text + ".value"
    next = RegisterLinkedNullType(project, next, call.result.clone())?
    next = ValidateLinkedPayload(next, call.result, payload)
    drop = LinkedNullDropC(next.layouts, next.owning_layouts, call.result, payload)
    next.owning_strings = next.owning_strings || drop.contains("ku_projection_string_drop")
    next.code += drop
    return ok(next)
}
