import { Node } from "../stage2/ast.ku"
import { DeclarationSpan, NamedModule } from "./names.ku"
import { ManagedConsumedString, ManagedLiteralConcat, ManagedLiteralConcatSetup } from "./call_contracts.ku"
import { GuardBinding, GuardBindingIndex, GuardBindingName, GuardExpression, GuardLeaf, GuardRead, GuardType, GuardValue } from "./guarded_struct_expr.ku"
import { ScalarStringPart } from "./scalar_int_emit.ku"
import { ScalarStringLiteral } from "./scalar_int_operands.ku"
import { RejectLayout, StructLayout } from "./struct_layouts.ku"
import { ContainsType, ProjectionArrayHeader, ProjectionCloneSource } from "./struct_projection_c.ku"

fn collectProjectedParts(&nodes: [Node], &edges: [int], &bindings: [GuardBinding], &layouts: [StructLayout],
                         id: int, depth: int, can_convert: bool, collected: [ScalarStringPart]): [ScalarStringPart]! {
    node = nodes[id - 1].clone()
    parts = collected
    if (depth >= 32 || parts.len() >= 64) {
        RejectLayout("guarded_string_limit", "guarded string composition supports up to 32 expression levels and 64 parts", DeclarationSpan(node))?
    }
    if (node.kind == "Binary" && node.text == "+" && node.edge_count == 2) {
        parts = collectProjectedParts(nodes, edges, bindings, layouts, edges[node.first_edge], depth + 1, can_convert, parts)?
        return collectProjectedParts(nodes, edges, bindings, layouts, edges[node.first_edge + 1], depth + 1, can_convert, parts)
    }
    part = ""
    integer = false
    if (node.kind == "String" && node.edge_count == 0) {
        part = "(const uint8_t*)" + ScalarStringLiteral(node)?
    } else if (node.kind == "Field" && node.edge_count == 1) {
        field = GuardExpression(nodes, edges, bindings, layouts, id, 0, "")?
        if (field.ty.kind == "str" && field.setup == "") {
            part = field.value.clone() + ".ptr, " + field.value + ".len"
        }
    } else if (node.kind == "Call" && node.edge_count == 2 && can_convert && GuardBindingIndex(bindings, "str") == 0) {
        target = nodes[edges[node.first_edge] - 1].clone()
        if (target.kind == "Variable" && target.text == "str" && target.edge_count == 0) {
            value = GuardExpression(nodes, edges, bindings, layouts, edges[node.first_edge + 1], 0, "")?
            if (value.ty.kind == "int" && value.setup == "") {
                part = value.value
                integer = true
            }
        }
    }
    if (part == "") {
        RejectLayout("unsupported_guarded_string_part", "expected a literal, string field, or direct str conversion of a Copy int", DeclarationSpan(node))?
    }
    parts = parts.push(ScalarStringPart { source: part, integer: integer })
    return ok(parts)
}

fn LowerProjectedStringParts(&nodes: [Node], &edges: [int], &bindings: [GuardBinding], &layouts: [StructLayout],
                             id: int, can_convert: bool): [ScalarStringPart]! {
    node = nodes[id - 1].clone()
    if (node.kind != "Binary" || node.text != "+" || node.edge_count != 2) {
        RejectLayout("unsupported_guarded_return", "expected a str literal or concatenation of checked fields", DeclarationSpan(node))?
    }
    return collectProjectedParts(nodes, edges, bindings, layouts, id, 0, can_convert, [])
}

fn ManagedDeferredMessageId(&nodes: [Node], &edges: [int], &literal: Node): int {
    if (literal.kind != "ObjectLiteral") { return 0 }
    index = 0
    while (index < literal.edge_count) {
        field = nodes[edges[literal.first_edge + index] - 1].clone()
        if (field.kind == "ObjectLiteralField" && field.text == "message" && field.edge_count == 1) {
            value = edges[field.first_edge]
            if (nodes[value - 1].kind == "Call") { return value }
        }
        index = index + 1
    }
    return 0
}

fn ManagedDeferredMessageCalls(&nodes: [Node], &edges: [int], &function: Node): [int] {
    calls: [int] = []
    index = 0
    while (index < nodes.len()) {
        if (nodes[index].kind == "Fail" && nodes[index].offset >= function.offset &&
            nodes[index].end_offset <= function.end_offset && nodes[index].edge_count == 1) {
            id = ManagedDeferredMessageId(nodes, edges, nodes[edges[nodes[index].first_edge] - 1])
            if (id != 0) { calls = calls.push(id) }
        }
        index = index + 1
    }
    return calls
}

fn ManagedClonedStringCall(&nodes: [Node], &edges: [int], &call: Node): bool {
    if (call.kind != "Call" || call.edge_count != 2) { return false }
    source = ProjectionCloneSource(nodes, edges, edges[call.first_edge + 1])
    return source != 0 && nodes[source - 1].kind == "Variable"
}

fn ManagedLiteralStringReturns(&nodes: [Node], &edges: [int], &function: Node): bool {
    cursor = function.first_edge + 2
    end = function.first_edge + function.edge_count
    if (cursor >= end) { return false }
    while (cursor < end) {
        statement = nodes[edges[cursor] - 1].clone()
        if (cursor < end - 1 && statement.kind == "If" && statement.int_value == 1 && statement.edge_count == 2) {
            statement = nodes[edges[statement.first_edge + 1] - 1].clone()
        }
        if (statement.kind != "Return" || statement.edge_count != 1 || nodes[edges[statement.first_edge] - 1].kind != "String") {
            return false
        }
        cursor = cursor + 1
    }
    return true
}

fn BoundSameModuleFunction(&named: NamedModule, &name: str): int {
    for declaration in named.names.declarations.clone() {
        if (declaration.kind == "Function" && declaration.name == name) { return declaration.node }
    }
    return 0
}

fn ManagedStringLeaf(&named: NamedModule, &locals: [GuardBinding], &leaves: [GuardLeaf], &call: Node): str {
    if (!ManagedClonedStringCall(named.parsed.arena.nodes, named.parsed.arena.edges, call)) { return "" }
    target = named.parsed.arena.nodes[named.parsed.arena.edges[call.first_edge] - 1].clone()
    if (target.kind != "Variable" || GuardBindingIndex(locals, target.text) != 0) { return "" }
    for leaf in leaves.clone() {
        if (leaf.name == target.text && leaf.result_kind == "str" && leaf.parameters.len() == 1 && leaf.parameters[0] == "str") {
            // Deferred message providers may allocate only after cleanup.
            // A direct call may run while an old owner is still live.
            declaration = BoundSameModuleFunction(named, target.text)
            if (declaration != 0 && ManagedLiteralStringReturns(named.parsed.arena.nodes, named.parsed.arena.edges,
                named.parsed.arena.nodes[declaration - 1])) { return leaf.symbol }
        }
    }
    return ""
}

fn ManagedStringLeafSetup(&nodes: [Node], &edges: [int], &locals: [GuardBinding],
                          &call: Node, id: int, &symbol: str, &target: str, &indent: str): str! {
    source = ProjectionCloneSource(nodes, edges, edges[call.first_edge + 1])
    temporary = "argument" + str(id)
    prepare = ManagedCloneBoundString(locals, nodes[source - 1], temporary, indent)?
    return ok(indent.clone() + "KuProjectionString " + temporary.clone() + " = {0};\n" + prepare +
        indent.clone() + target.clone() + " = " + symbol.clone() + "(" + temporary + ");\n")
}

fn managedStringOwnerName(&locals: [GuardBinding], &source: Node): str! {
    binding = GuardBindingIndex(locals, source.text)
    if (binding == 0 || locals[binding - 1].ty.kind != "str" || locals[binding - 1].view) {
        RejectLayout("managed_string_leaf_argument", "expected a clone of a bound owned str", DeclarationSpan(source))?
    }
    return ok(GuardBindingName(locals[binding - 1]))
}

fn ManagedCloneBoundString(&locals: [GuardBinding], &source: Node, &target: str, &indent: str): str! {
    return ok(indent.clone() + "if (!ku_result_clone_string(" + managedStringOwnerName(locals, source)? + ", &" + target.clone() +
        ")) { out_of_memory = true; goto cleanup; }\n")
}

fn ManagedConcatenates(&nodes: [Node], &edges: [int], &expression: Node): bool {
    if (ManagedLiteralConcat(nodes, edges, expression)) { return true }
    if (expression.kind != "Binary" || expression.text != "+" || expression.edge_count != 2) { return false }
    left = ProjectionCloneSource(nodes, edges, edges[expression.first_edge])
    right = ProjectionCloneSource(nodes, edges, edges[expression.first_edge + 1])
    return left != 0 && right != 0 && nodes[left - 1].kind == "Variable" && nodes[right - 1].kind == "Variable"
}

fn ManagedConcatenate(&named: NamedModule, &locals: [GuardBinding], &expression: Node, id: int,
                      caller_id: int, &target: str, &indent: str): str! {
    if (ManagedLiteralConcat(named.parsed.arena.nodes, named.parsed.arena.edges, expression)) {
        return ManagedLiteralConcatSetup(named, locals, expression, caller_id, target, indent)
    }
    left = ProjectionCloneSource(named.parsed.arena.nodes, named.parsed.arena.edges, named.parsed.arena.edges[expression.first_edge])
    right = ProjectionCloneSource(named.parsed.arena.nodes, named.parsed.arena.edges, named.parsed.arena.edges[expression.first_edge + 1])
    left_source = managedStringOwnerName(locals, named.parsed.arena.nodes[left - 1])?
    right_source = managedStringOwnerName(locals, named.parsed.arena.nodes[right - 1])?
    a = "concat_left" + str(id)
    b = "concat_right" + str(id)
    text = indent.clone() + "KuProjectionString " + a.clone() + " = {0}, " + b.clone() + " = {0};\n"
    text += indent.clone() + "if (!ku_result_clone_string(" + left_source + ", &" + a.clone() + ") ||\n"
    text += indent.clone() + "    !ku_result_clone_string(" + right_source + ", &" + b.clone() + ") ||\n"
    text += indent.clone() + "    !ku_managed_string_append(&" + a.clone() + ", " + b.clone() + ", &string_too_large)) {\n"
    text += indent.clone() + "    ku_projection_string_drop(&" + a.clone() + ");\n"
    text += indent.clone() + "    ku_projection_string_drop(&" + b.clone() + ");\n"
    text += indent.clone() + "    out_of_memory = !string_too_large; goto cleanup;\n" + indent.clone() + "}\n"
    text += indent.clone() + "ku_projection_string_drop(&" + b + ");\n"
    return ok(text + indent.clone() + target.clone() + " = " + a + ";\n")
}

fn ManagedIsStringMove(&locals: [GuardBinding], &node: Node, found: int): bool {
    return node.kind == "Variable" && found != 0 && locals[found - 1].ty.kind == "str" &&
        locals[found - 1].name != node.text
}

fn ManagedMoveStringSetup(&named: NamedModule, &locals: [GuardBinding], &node: Node,
                          caller_id: int, &target: str, &indent: str): str! {
    binding = ManagedConsumedString(named, locals, node, caller_id)?
    source = GuardBindingName(binding)
    return ok(indent.clone() + target.clone() + " = " + source.clone() + ";\n" +
        indent.clone() + source + " = (KuProjectionString){0};\n")
}

fn ManagedSourceCharactersRuntime(needs_header: bool): str {
    ascii = ""
    index = 0
    while (index < 128) {
        if (index > 0) { ascii += ", " }
        ascii += str(index)
        index = index + 1
    }
    text = "#include <string.h>\n"
    if (needs_header) { text += ProjectionArrayHeader("KuProjectionString", "KuGuardStringArray") }
    text += "enum { KU_SOURCE_OK, KU_SOURCE_INVALID, KU_SOURCE_TOOBIG, KU_SOURCE_ARRAY_OOM, KU_SOURCE_CHAR_OOM };\n\n"
    text += "static void ku_managed_source_drop(KuGuardStringArray *array) {\n"
    text += "    for (size_t i = 0; i < array->len; ++i) ku_projection_string_drop(&array->data[i]);\n"
    text += "    free(array->data);\n    *array = (KuGuardStringArray){0};\n}\n\n"
    text += "static int ku_managed_source_chars(KuProjectionString input, KuGuardStringArray *out) {\n"
    text += "    static const uint8_t ascii[128] = {" + ascii + "};\n"
    text += "    if (!input.len) return KU_SOURCE_OK;\n"
    text += "    if (!input.ptr || (input.ptr[0] & 0xC0u) == 0x80u) return KU_SOURCE_INVALID;\n"
    text += "    size_t count = 0;\n"
    text += "    for (size_t i = 0; i < input.len; ++i) if ((input.ptr[i] & 0xC0u) != 0x80u) ++count;\n"
    text += "    if (count > SIZE_MAX / sizeof(*out->data)) return KU_SOURCE_TOOBIG;\n"
    text += "    out->data = calloc(count, sizeof(*out->data));\n    if (!out->data) return KU_SOURCE_ARRAY_OOM;\n    out->capacity = count;\n"
    text += "    size_t index = 0;\n    while (index < input.len) {\n"
    text += "        size_t next = index + 1;\n        while (next < input.len && (input.ptr[next] & 0xC0u) == 0x80u) ++next;\n"
    text += "        size_t bytes = next - index;\n        KuProjectionString value;\n"
    text += "        if (bytes == 1 && input.ptr[index] < 128u) {\n"
    text += "            value = (KuProjectionString){(uint8_t*)(ascii + input.ptr[index]), 1u, 0u, KU_PROJECTION_STRING_STATIC};\n"
    text += "        } else {\n            uint8_t *data = malloc(bytes);\n            if (!data) return KU_SOURCE_CHAR_OOM;\n"
    text += "            memcpy(data, input.ptr + index, bytes);\n"
    text += "            value = (KuProjectionString){data, bytes, bytes, KU_PROJECTION_STRING_OWNED};\n        }\n"
    // Publish initialized elements one at a time for rollback. No returned
    // str points into input, including the immutable ASCII representation.
    text += "        out->data[out->len++] = value;\n        index = next;\n    }\n    return KU_SOURCE_OK;\n}\n\n"
    return text
}

fn ManagedSourceCharsSetup(&locals: [GuardBinding], &receiver: Node, &target: str, &indent: str): str! {
    source = GuardBindingIndex(locals, receiver.text)
    if (receiver.kind != "Variable" || source == 0 || locals[source - 1].ty.kind != "str" || !locals[source - 1].parameter || locals[source - 1].view) {
        RejectLayout("managed_source_chars", "expected chars on a bound owned str parameter", DeclarationSpan(receiver))?
    }
    return ok(indent.clone() + "source_status = ku_managed_source_chars(" + GuardBindingName(locals[source - 1]) + ", &" +
        target.clone() + ");\n" + indent.clone() + "if (source_status != KU_SOURCE_OK) goto cleanup;\n")
}

fn RequireNewManagedOwner(found: int, &statement: Node): null! {
    if (found != 0) {
        RejectLayout("unsupported_managed_reassignment", "owner initialization requires a fresh local scope", DeclarationSpan(statement))?
    }
    return ok(null)
}

fn IsManagedLocalArrayClone(&nodes: [Node], &edges: [int], &locals: [GuardBinding], id: int): bool {
    subject = ProjectionCloneSource(nodes, edges, id)
    if (subject == 0) { return false }
    item = nodes[subject - 1].clone()
    if (item.kind != "Index" || item.edge_count != 2) { return false }
    array = nodes[edges[item.first_edge] - 1].clone()
    if (array.kind != "Variable") { return false }
    found = GuardBindingIndex(locals, array.text)
    return found != 0 && locals[found - 1].ty.kind == "str_array" && !locals[found - 1].parameter
}

fn ManagedCloneStringSetup(&base: GuardValue, &index: GuardValue, &at: Node,
                           &target: str, &indent: str): str! {
    if (base.ty.kind != "str_array" || base.setup != "" || index.ty.kind != "int") {
        RejectLayout("managed_string_index", "expected a declared [str] and a checked int index", DeclarationSpan(at))?
    }
    reference = ""
    if (!base.view) { reference = "&" }
    return ok(indent.clone() + "if (!ku_guard_string_array_clone_at(" + reference + base.value.clone() + ", " +
        index.value.clone() + ", &" + target.clone() + ", &array_failure)) goto cleanup;\n")
}

fn BindManagedLocal(&statement: Node, statement_id: int, ty: GuardType): GuardBinding {
    return GuardBinding { name: statement.text.clone(), ty: ty, slot: statement_id, parameter: false, view: false }
}

fn CheckManagedDeclaration(&declared: GuardType, &actual: GuardType, found: int, &statement: Node): null! {
    if (statement.kind == "VarDecl" && (found != 0 || declared.kind != actual.kind || declared.layout != actual.layout)) {
        RejectLayout("managed_local_type", "typed local requires a fresh slot and matching initializer", DeclarationSpan(statement))?
    }
    return ok(null)
}

fn ManagedAppendDrop(&nodes: [Node], &locals: [GuardBinding], id: int, &statement: Node,
                    function_end: int, &indent: str): str! {
    operand = nodes[id - 1].clone()
    if (operand.kind == "String") { return ok("") }
    found = GuardBindingIndex(locals, operand.text)
    if (operand.kind != "Variable" || found == 0 || locals[found - 1].parameter || locals[found - 1].view) {
        RejectLayout("managed_append_move", "append requires a literal or a distinct owned local", DeclarationSpan(operand))?
    }
    source = locals[found - 1].clone()
    born = nodes[source.slot - 1].offset
    stop = function_end
    index = 0
    while (index < nodes.len()) {
        if (nodes[index].kind == "While" && nodes[index].offset < statement.offset && nodes[index].end_offset >= statement.end_offset) {
            if (born <= nodes[index].offset) {
                RejectLayout("managed_append_move", "a loop cannot consume a string from outside its iteration", DeclarationSpan(operand))?
            }
            if (nodes[index].end_offset < stop) { stop = nodes[index].end_offset }
        }
        index = index + 1
    }
    // Admit this subset only when no later reference in the current scope
    // needs the consumed value. A new iteration creates its own binding.
    index = 0
    while (index < nodes.len()) {
        if (nodes[index].kind == "Variable" && nodes[index].offset >= statement.end_offset &&
            nodes[index].end_offset <= stop && nodes[index].text == source.name) {
            RejectLayout("managed_append_move", "append consumes the local string before this reference", DeclarationSpan(nodes[index]))?
        }
        index = index + 1
    }
    return ok(indent.clone() + "ku_projection_string_drop(&" + GuardBindingName(source) + ");\n")
}

fn ManagedRecordStringMove(&named: NamedModule, &locals: [GuardBinding], &operand: Node,
                           caller_id: int, &indent: str): str! {
    binding = ManagedConsumedString(named, locals, operand, caller_id)?
    return ok(indent.clone() + GuardBindingName(binding) + " = (KuProjectionString){0};\n")
}

fn ManagedSourceCharactersErrors(): str {
    return "    if (source_status != KU_SOURCE_OK) {\n" +
        "        const char *message = \"invalid string input\\n\";\n" +
        "        if (source_status == KU_SOURCE_TOOBIG) message = \"string.chars result is too large\\n\";\n" +
        "        if (source_status == KU_SOURCE_ARRAY_OOM) message = \"string.chars allocation failed\\n\";\n" +
        "        if (source_status == KU_SOURCE_CHAR_OOM) message = \"out of memory\\n\";\n" +
        "        fputs(message, stderr);\n        exit(EXIT_FAILURE);\n    }\n"
}

fn ManagedStringAppendRuntime(): str {
    return "static bool ku_managed_string_append(KuProjectionString *left, KuProjectionString right, bool *too_large) {\n" +
        "    if (!right.len) return true;\n" +
        "    if (right.len > SIZE_MAX - left->len) { *too_large = true; return false; }\n" +
        "    size_t length = left->len + right.len;\n" +
        "    size_t capacity = left->capacity > left->len ? left->capacity : left->len;\n" +
        "    if (left->storage != KU_PROJECTION_STRING_OWNED || length > capacity) {\n" +
        "        if (!capacity) capacity = 8u;\n" +
        "        while (capacity < length) capacity = capacity > SIZE_MAX / 2u ? SIZE_MAX : capacity * 2u;\n" +
        "        uint8_t *data = left->storage == KU_PROJECTION_STRING_OWNED ? realloc(left->ptr, capacity) : malloc(capacity);\n" +
        "        if (!data) return false;\n" +
        "        if (left->storage != KU_PROJECTION_STRING_OWNED && left->len) memcpy(data, left->ptr, left->len);\n" +
        "        left->ptr = data;\n        left->capacity = capacity;\n        left->storage = KU_PROJECTION_STRING_OWNED;\n" +
        "    }\n" +
        "    memcpy(left->ptr + left->len, right.ptr, right.len);\n" +
        "    left->len = length;\n    return true;\n}\n\n"
}

fn ManagedStringRuntime(): str {
    return "static bool ku_guard_try_mul(int64_t a, int64_t b, int64_t *out) {\n" +
        "    if (a > 0) {\n" +
        "        if ((b > 0 && a > INT64_MAX / b) || (b < 0 && b < INT64_MIN / a)) return false;\n" +
        "    } else if (a < 0) {\n" +
        "        if ((b > 0 && a < INT64_MIN / b) || (b < 0 && a < INT64_MAX / b)) return false;\n" +
        "    }\n    *out = a * b;\n    return true;\n}\n\n" + ManagedStringAppendRuntime()
}
