import { Node } from "../stage2/ast.ku"
import { DeclarationSpan } from "./names.ku"
import { GuardBinding, GuardBindingIndex, GuardBindingName, GuardExpression, GuardLeaf, GuardRead, GuardType, GuardValue } from "./guarded_struct_expr.ku"
import { ScalarStringPart } from "./scalar_int_emit.ku"
import { ScalarStringLiteral } from "./scalar_int_operands.ku"
import { RejectLayout, StructLayout } from "./struct_layouts.ku"
import { ContainsType, ProjectionArrayHeader } from "./struct_projection_c.ku"

fn collectProjectedParts(&nodes: [Node], &edges: [int], &bindings: [GuardBinding], &layouts: [StructLayout],
                         id: int, depth: int, can_convert: bool, collected: [ScalarStringPart]): [ScalarStringPart]! {
    node = nodes[id - 1].clone()
    parts = collected
    if (depth >= 32 || parts.len() >= 64) {
        RejectLayout("guarded_string_limit", "guarded string composition supports up to 32 expression levels and 64 parts", DeclarationSpan(node))?
    }
    if (node.kind == "Binary" && node.text == "+" && node.edge_count == 2) {
        parts = collectProjectedParts(nodes, edges, bindings, layouts, edges[node.first_edge], depth + 1, can_convert, parts)?
        return collectProjectedParts(nodes, edges, bindings, layouts, edges[node.first_edge + 1], depth + 1, can_convert, parts)
    }
    part = ""
    integer = false
    if (node.kind == "String" && node.edge_count == 0) {
        part = "(const uint8_t*)" + ScalarStringLiteral(node)?
    } else if (node.kind == "Field" && node.edge_count == 1) {
        field = GuardExpression(nodes, edges, bindings, layouts, id, 0, "")?
        if (field.ty.kind == "str" && field.setup == "") {
            part = field.value.clone() + ".ptr, " + field.value + ".len"
        }
    } else if (node.kind == "Call" && node.edge_count == 2 && can_convert && GuardBindingIndex(bindings, "str") == 0) {
        target = nodes[edges[node.first_edge] - 1].clone()
        if (target.kind == "Variable" && target.text == "str" && target.edge_count == 0) {
            value = GuardExpression(nodes, edges, bindings, layouts, edges[node.first_edge + 1], 0, "")?
            if (value.ty.kind == "int" && value.setup == "") {
                part = value.value
                integer = true
            }
        }
    }
    if (part == "") {
        RejectLayout("unsupported_guarded_string_part", "expected a literal, string field, or direct str conversion of a Copy int", DeclarationSpan(node))?
    }
    parts = parts.push(ScalarStringPart { source: part, integer: integer })
    return ok(parts)
}

fn LowerProjectedStringParts(&nodes: [Node], &edges: [int], &bindings: [GuardBinding], &layouts: [StructLayout],
                             id: int, can_convert: bool): [ScalarStringPart]! {
    node = nodes[id - 1].clone()
    if (node.kind != "Binary" || node.text != "+" || node.edge_count != 2) {
        RejectLayout("unsupported_guarded_return", "expected a str literal or concatenation of checked fields", DeclarationSpan(node))?
    }
    return collectProjectedParts(nodes, edges, bindings, layouts, id, 0, can_convert, [])
}

struct ManagedErrorEmission {
    prep: GuardValue
    declarations: str
    after_cleanup: str
}

fn managedErrorProvider(&nodes: [Node], &edges: [int], &bindings: [GuardBinding], &leaves: [GuardLeaf], &call: Node): GuardLeaf! {
    if (call.edge_count > 0) {
        target = nodes[edges[call.first_edge] - 1].clone()
        if (target.kind == "Variable" && target.edge_count == 0 && GuardBindingIndex(bindings, target.text) == 0) {
            for leaf in leaves.clone() {
                if (leaf.name == target.text && leaf.result_kind == "str" && leaf.parameters.len() + 1 == call.edge_count) { return ok(leaf) }
            }
        }
    }
    RejectLayout("managed_error_provider", "expected an unshadowed, typed str message provider", DeclarationSpan(call))?
    return ok(GuardLeaf { name: "", symbol: "", result_kind: "", parameters: [] })
}

fn deferredMessage(&nodes: [Node], &edges: [int], &bindings: [GuardBinding], &layouts: [StructLayout],
                   &leaves: [GuardLeaf], &call: Node, id: int, &indent: str): ManagedErrorEmission! {
    leaf = managedErrorProvider(nodes, edges, bindings, leaves, call)?
    prep = GuardRead(GuardType { kind: "str", layout: 0 }, "", false)
    declarations = ""
    arguments = ""
    index = 0
    while (index < leaf.parameters.len()) {
        arg = edges[call.first_edge + index + 1]
        kind = leaf.parameters[index].clone()
        item = nodes[arg - 1].clone()
        if (kind != "int" && (kind != "str" || item.kind != "String")) {
            RejectLayout("managed_error_argument", "message providers use Copy int or literal str arguments", DeclarationSpan(item))?
        }
        value = GuardExpression(nodes, edges, bindings, layouts, arg, 0, indent)?
        if (value.ty.kind != kind || value.view) {
            RejectLayout("managed_error_argument", "message argument must match its declared type", DeclarationSpan(item))?
        }
        rendered = value.value
        prep.setup = prep.setup + value.setup
        prep.uses_add = prep.uses_add || value.uses_add
        prep.uses_sub = prep.uses_sub || value.uses_sub
        prep.uses_eq = prep.uses_eq || value.uses_eq
        if (kind == "int") {
            name = "error_arg" + str(id) + "_" + str(index)
            declarations += "    int64_t " + name.clone() + " = 0;\n"
            prep.setup = prep.setup + indent.clone() + name.clone() + " = " + rendered + ";\n"
            rendered = name
        }
        if (index > 0) { arguments += ", " }
        arguments += rendered
        index = index + 1
    }
    // Only Copy snapshots and static bytes cross cleanup. The provider can
    // fail fatally without leaving a live owner from this record frame.
    prep.setup = prep.setup + indent.clone() + "record_error = " + str(id) + ";\n"
    finish = "    if (record_error == " + str(id) + ") result.error.message = " + leaf.symbol + "(" + arguments + ");\n"
    return ok(ManagedErrorEmission { prep: prep, declarations: declarations, after_cleanup: finish })
}

fn LowerManagedRecordError(&nodes: [Node], &edges: [int], &bindings: [GuardBinding], &layouts: [StructLayout],
                           &leaves: [GuardLeaf], &literal: Node, id: int, &indent: str): ManagedErrorEmission! {
    if (literal.kind != "ObjectLiteral" || literal.edge_count != 3) {
        RejectLayout("managed_record_error", "expected Error domain, code, and message", DeclarationSpan(literal))?
    }
    prep = GuardRead(GuardType { kind: "str", layout: 0 }, "", false)
    declarations = ""
    finish = ""
    seen: [str] = []
    index = 0
    while (index < literal.edge_count) {
        field = nodes[edges[literal.first_edge + index] - 1].clone()
        label = field.text.clone()
        if (field.kind != "ObjectLiteralField" || field.edge_count != 1 || (label != "domain" && label != "code" && label != "message") || ContainsType(seen, label)) {
            RejectLayout("managed_record_error_field", "expected each named Error field once", DeclarationSpan(field))?
        }
        child = edges[field.first_edge]
        value = nodes[child - 1].clone()
        if (label == "message" && value.kind == "Call") {
            dynamic = deferredMessage(nodes, edges, bindings, layouts, leaves, value, id, indent)?
            prep.setup = prep.setup + dynamic.prep.setup
            prep.uses_add = dynamic.prep.uses_add
            prep.uses_sub = dynamic.prep.uses_sub
            prep.uses_eq = dynamic.prep.uses_eq
            declarations = dynamic.declarations
            finish = dynamic.after_cleanup
        } else {
            if (value.kind != "String" || value.edge_count != 0) {
                RejectLayout("managed_record_error_field", "expected a static Error field or direct message provider", DeclarationSpan(value))?
            }
            rendered = GuardExpression(nodes, edges, bindings, layouts, child, 0, indent)?
            prep.setup = prep.setup + indent.clone() + "result.error." + label.clone() + " = " + rendered.value + ";\n"
        }
        seen = seen.push(label)
        index = index + 1
    }
    prep.setup = prep.setup + indent.clone() + "goto cleanup;\n"
    return ok(ManagedErrorEmission { prep: prep, declarations: declarations, after_cleanup: finish })
}

fn ManagedSourceCharactersRuntime(): str {
    ascii = ""
    index = 0
    while (index < 128) {
        if (index > 0) { ascii += ", " }
        ascii += str(index)
        index = index + 1
    }
    text = "#include <string.h>\n" + ProjectionArrayHeader("KuProjectionString", "KuGuardStringArray")
    text += "enum { KU_SOURCE_OK, KU_SOURCE_INVALID, KU_SOURCE_TOOBIG, KU_SOURCE_ARRAY_OOM, KU_SOURCE_CHAR_OOM };\n\n"
    text += "static void ku_managed_source_drop(KuGuardStringArray *array) {\n"
    text += "    for (size_t i = 0; i < array->len; ++i) ku_projection_string_drop(&array->data[i]);\n"
    text += "    free(array->data);\n    *array = (KuGuardStringArray){0};\n}\n\n"
    text += "static int ku_managed_source_chars(KuProjectionString input, KuGuardStringArray *out) {\n"
    text += "    static const uint8_t ascii[128] = {" + ascii + "};\n"
    text += "    if (!input.len) return KU_SOURCE_OK;\n"
    text += "    if (!input.ptr || (input.ptr[0] & 0xC0u) == 0x80u) return KU_SOURCE_INVALID;\n"
    text += "    size_t count = 0;\n"
    text += "    for (size_t i = 0; i < input.len; ++i) if ((input.ptr[i] & 0xC0u) != 0x80u) ++count;\n"
    text += "    if (count > SIZE_MAX / sizeof(*out->data)) return KU_SOURCE_TOOBIG;\n"
    text += "    out->data = calloc(count, sizeof(*out->data));\n    if (!out->data) return KU_SOURCE_ARRAY_OOM;\n    out->capacity = count;\n"
    text += "    size_t index = 0;\n    while (index < input.len) {\n"
    text += "        size_t next = index + 1;\n        while (next < input.len && (input.ptr[next] & 0xC0u) == 0x80u) ++next;\n"
    text += "        size_t bytes = next - index;\n        KuProjectionString value;\n"
    text += "        if (bytes == 1 && input.ptr[index] < 128u) {\n"
    text += "            value = (KuProjectionString){(uint8_t*)(ascii + input.ptr[index]), 1u, 0u, KU_PROJECTION_STRING_STATIC};\n"
    text += "        } else {\n            uint8_t *data = malloc(bytes);\n            if (!data) return KU_SOURCE_CHAR_OOM;\n"
    text += "            memcpy(data, input.ptr + index, bytes);\n"
    text += "            value = (KuProjectionString){data, bytes, bytes, KU_PROJECTION_STRING_OWNED};\n        }\n"
    // Publish initialized elements one at a time for rollback. No returned
    // str points into input, including the immutable ASCII representation.
    text += "        out->data[out->len++] = value;\n        index = next;\n    }\n    return KU_SOURCE_OK;\n}\n\n"
    return text
}

fn ManagedSourceCharsSetup(&locals: [GuardBinding], &receiver: Node, &target: str, &indent: str): str! {
    source = GuardBindingIndex(locals, receiver.text)
    if (receiver.kind != "Variable" || source == 0 || locals[source - 1].ty.kind != "str" || !locals[source - 1].parameter || locals[source - 1].view) {
        RejectLayout("managed_source_chars", "expected chars on a bound owned str parameter", DeclarationSpan(receiver))?
    }
    return ok(indent.clone() + "source_status = ku_managed_source_chars(" + GuardBindingName(locals[source - 1]) + ", &" +
        target.clone() + ");\n" + indent.clone() + "if (source_status != KU_SOURCE_OK) goto cleanup;\n")
}

fn RequireNewManagedOwner(found: int, &statement: Node): null! {
    if (found != 0) {
        RejectLayout("unsupported_managed_reassignment", "owner initialization requires a fresh local scope", DeclarationSpan(statement))?
    }
    return ok(null)
}

fn ManagedSourceCharactersErrors(): str {
    return "    if (source_status != KU_SOURCE_OK) {\n" +
        "        const char *message = \"invalid string input\\n\";\n" +
        "        if (source_status == KU_SOURCE_TOOBIG) message = \"string.chars result is too large\\n\";\n" +
        "        if (source_status == KU_SOURCE_ARRAY_OOM) message = \"string.chars allocation failed\\n\";\n" +
        "        if (source_status == KU_SOURCE_CHAR_OOM) message = \"out of memory\\n\";\n" +
        "        fputs(message, stderr);\n        exit(EXIT_FAILURE);\n    }\n"
}
