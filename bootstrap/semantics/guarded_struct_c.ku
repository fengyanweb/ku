import { Node } from "../stage2/ast.ku"
import { Span } from "../stage2/span.ku"
import { DeclarationSpan, NamedModule } from "./names.ku"
import { ScalarStringLiteral, HasScalarBuiltin } from "./scalar_int_operands.ku"
import { EmitScalarStringAssignment, ScalarStringJoinHelpers } from "./scalar_int_emit.ku"
import { LowerProjectedStringParts } from "./guarded_string_parts.ku"
import { ContainsIndex, EmitLayout, ProjectionHeaders } from "./struct_projection_c.ku"
import { ExplicitType, LayoutIndex, RejectLayout, StructLayout } from "./struct_layouts.ku"
import { OrderCStructLayouts } from "./nested_struct_c.ku"
import { EmitTryCloneString, HasBoundArrayMembers } from "./struct_array_c.ku"
import { TypeNameBinding } from "./type_names.ku"
import { GuardBinding, GuardBindingIndex, GuardBindingName, GuardCType, GuardExplicitType, GuardExpression, GuardType } from "./guarded_struct_expr.ku"

import { LinkedNullExpression, LinkedNullSlot, LinkedNullState, LinkedNullValue, LinkedReadonlyExpression } from "./link_plan_c.ku"

struct GuardedStructC {
    symbol: str
    source: str
}

struct GuardSignature {
    bindings: [GuardBinding]
    declaration: str
    definitions: str
    drops: str
    body_start: int
    result_kind: str
    string_array: bool
}

struct GuardBlock {
    source: str
    uses_add: bool
    uses_sub: bool
    uses_join: bool
    uses_format: bool
    uses_eq: bool
    returns: bool
}

fn guardOwnedDropsAt(&layouts: [StructLayout], index: int, &base: str, &indent: str): str {
    drops = ""
    cursor = 0
    while (cursor < layouts[index - 1].fields.len()) {
        field = layouts[index - 1].fields[cursor].resolved.clone()
        name = base.clone() + ".f" + str(cursor)
        if (field.declaration_kind == "Builtin" && field.name == "str") {
            drops += indent.clone() + "ku_projection_string_drop(&" + name + ");\n"
        } else if (field.declaration_kind == "Struct") {
            child = LayoutIndex(layouts, field.module_index, field.declaration_node)
            // The ordered layout has already validated this acyclic graph
            // (at most eight levels). Each path is one owned field instance.
            drops += guardOwnedDropsAt(layouts, child, name, indent)
        }
        cursor = cursor + 1
    }
    return drops
}

fn GuardOwnedDrops(&layouts: [StructLayout], index: int, &base: str): str {
    return guardOwnedDropsAt(layouts, index, base, "    ")
}

fn GuardRecordCarrierDrops(&layouts: [StructLayout], layout: int, &name: str, &indent: str): str {
    // Clear unselected payload owners even on an error. Selected
    // owned fields and a transferred Error were already cleared in-place.
    drops = guardOwnedDropsAt(layouts, layout, name.clone() + ".value", indent)
    drops += indent.clone() + "ku_projection_string_drop(&" + name.clone() + ".error.domain);\n"
    drops += indent.clone() + "ku_projection_string_drop(&" + name.clone() + ".error.code);\n"
    drops += indent.clone() + "ku_projection_string_drop(&" + name.clone() + ".error.message);\n"
    return drops + indent.clone() + "if (!" + name.clone() + ".ok) goto cleanup;\n"
}

fn GuardParameterType(&nodes: [Node], &edges: [int], &types: [TypeNameBinding],
                      &layouts: [StructLayout], id: int, view: bool): GuardType! {
    node = nodes[id - 1].clone()
    if (node.kind != "TypeArray") { return GuardExplicitType(types, nodes, layouts, id) }
    if (!view || node.edge_count != 1) {
        RejectLayout("unsupported_guarded_signature", "guarded array parameters require View [str]", DeclarationSpan(node))?
    }
    item = ExplicitType(types, edges[node.first_edge], DeclarationSpan(node))?
    if (item.declaration_kind != "Builtin" || item.name != "str") {
        RejectLayout("unsupported_guarded_signature", "guarded array parameters require View [str]", item.span.clone())?
    }
    return ok(GuardType { kind: "str_array", layout: 0 })
}

fn readGuardSignature(&nodes: [Node], &edges: [int], &types: [TypeNameBinding],
                      &layouts: [StructLayout], &function: Node, &symbol: str): GuardSignature! {
    bindings: [GuardBinding] = []
    emitted: [int] = []
    declaration = symbol.clone() + "("
    definitions = ""
    drops = ""
    string_array = false
    cursor = function.first_edge
    end = cursor + function.edge_count
    while (cursor < end && nodes[edges[cursor] - 1].kind == "Parameter") {
        parameter = nodes[edges[cursor] - 1].clone()
        at = DeclarationSpan(parameter)
        if (parameter.edge_count != 1 || parameter.int_value < 0 || parameter.int_value > 1 ||
            GuardBindingIndex(bindings, parameter.text) != 0) {
            RejectLayout("unsupported_guarded_signature", "expected a distinct, explicitly typed scalar or struct parameter", at.clone())?
        }
        view = parameter.int_value == 1
        ty = GuardParameterType(nodes, edges, types, layouts, edges[parameter.first_edge], view)?
        if (ty.kind == "str" || (view && ty.kind != "struct" && ty.kind != "str_array")) {
            RejectLayout("unsupported_guarded_signature", "guarded C accepts value scalars, value or View structs, and View [str]", at.clone())?
        }
        string_array = string_array || ty.kind == "str_array"
        binding = GuardBinding { name: parameter.text, ty: ty, slot: bindings.len(), parameter: true, view: view }
        name = GuardBindingName(binding)
        c_type = GuardCType(binding.ty, layouts)
        if (view) { c_type = "const " + c_type + "*" }
        if (bindings.len() > 0) { declaration += ", " }
        declaration += c_type + " " + name.clone()
        if (binding.ty.kind == "struct") {
            root = layouts[binding.ty.layout - 1].clone()
            order = OrderCStructLayouts(layouts, root.module_index, root.node, at)?
            for entry in order.entries {
                index = entry.layout_index
                if (!ContainsIndex(emitted, index)) {
                    definitions += EmitLayout(layouts[index - 1], true, true)?
                    emitted = emitted.push(index)
                }
            }
            if (!view) { drops += GuardOwnedDrops(layouts, binding.ty.layout, name) }
        }
        bindings = bindings.push(binding)
        cursor = cursor + 1
    }
    if (cursor >= end - 1) {
        RejectLayout("unsupported_guarded_signature", "expected an explicit scalar result and function body", DeclarationSpan(function))?
    }
    result = GuardExplicitType(types, nodes, layouts, edges[cursor])?
    if (result.kind != "str" && result.kind != "bool") {
        RejectLayout("unsupported_guarded_signature", "guarded C requires a str or bool result", DeclarationSpan(nodes[edges[cursor] - 1]))?
    }
    if (bindings.len() == 0) { declaration += "void" }
    result_type = GuardCType(result, layouts)
    return ok(GuardSignature { bindings: bindings, declaration: result_type + " " + declaration + ") {\n", definitions: definitions,
        drops: drops, body_start: cursor + 1, result_kind: result.kind, string_array: string_array })
}

fn guardReturn(&nodes: [Node], &edges: [int], &bindings: [GuardBinding], &layouts: [StructLayout],
                     &statement: Node, &indent: str, can_convert: bool, &result_kind: str): GuardBlock! {
    if (statement.edge_count != 1) {
        RejectLayout("unsupported_guarded_return", "expected one return value", DeclarationSpan(statement))?
    }
    id = edges[statement.first_edge]
    if (result_kind == "bool") {
        value = GuardExpression(nodes, edges, bindings, layouts, id, 0, indent)?
        if (value.ty.kind != "bool") {
            RejectLayout("unsupported_guarded_return", "expected a bool result", DeclarationSpan(nodes[id - 1]))?
        }
        return ok(GuardBlock { source: value.setup + indent.clone() + "result = " + value.value + ";\n" + indent.clone() + "goto cleanup;\n",
            uses_add: value.uses_add, uses_sub: value.uses_sub, uses_eq: value.uses_eq,
            uses_join: false, uses_format: false, returns: true })
    }
    if (nodes[id - 1].kind == "String") {
        literal = ScalarStringLiteral(nodes[id - 1])?
        return ok(GuardBlock { source: indent.clone() + "result = (KuProjectionString){ (uint8_t*)" + literal + ", 0u, KU_PROJECTION_STRING_STATIC };\n" +
            indent.clone() + "goto cleanup;\n", uses_add: false, uses_sub: false, uses_eq: false,
            uses_join: false, uses_format: false, returns: true })
    }
    parts = LowerProjectedStringParts(nodes, edges, bindings, layouts, id, can_convert)?
    assignment = EmitScalarStringAssignment(parts, indent)
    return ok(GuardBlock { source: assignment.source + indent.clone() + "goto cleanup;\n", uses_add: false, uses_sub: false, uses_eq: false,
        uses_join: true, uses_format: assignment.uses_format, returns: true })
}

fn emitGuardBlock(&nodes: [Node], &edges: [int], &types: [TypeNameBinding], &layouts: [StructLayout],
                  bindings: [GuardBinding], start: int, end: int, depth: int, &indent: str, can_convert: bool, &result_kind: str): GuardBlock! {
    locals = bindings
    source = ""
    uses_add = false
    uses_sub = false
    uses_join = false
    uses_format = false
    uses_eq = false
    returns = false
    cursor = start
    while (cursor < end) {
        statement_id = edges[cursor]
        statement = nodes[statement_id - 1].clone()
        if (returns) {
            RejectLayout("unreachable_guarded_statement", "a prior statement always returns", DeclarationSpan(statement))?
        }
        if (statement.kind == "Return") {
            result = guardReturn(nodes, edges, locals, layouts, statement, indent, can_convert, result_kind)?
            source += result.source
            uses_add = uses_add || result.uses_add
            uses_sub = uses_sub || result.uses_sub
            uses_eq = uses_eq || result.uses_eq
            uses_join = uses_join || result.uses_join
            uses_format = uses_format || result.uses_format
            returns = true
        } else if ((statement.kind == "Assign" && statement.edge_count == 1) ||
                   (statement.kind == "VarDecl" && statement.edge_count == 2)) {
            value_node = edges[statement.first_edge + statement.edge_count - 1]
            value = GuardExpression(nodes, edges, locals, layouts, value_node, 0, indent)?
            found = GuardBindingIndex(locals, statement.text)
            if (value.ty.kind != "int" && value.ty.kind != "bool") {
                RejectLayout("unsupported_guarded_local", "guarded C locals require Copy int or bool values", DeclarationSpan(statement))?
            }
            if (statement.kind == "VarDecl") {
                declared = GuardExplicitType(types, nodes, layouts, edges[statement.first_edge])?
                if (found != 0 || declared.kind != value.ty.kind) {
                    RejectLayout("guarded_local_type", "expected a new local with the matching explicit type", DeclarationSpan(statement))?
                }
            }
            source += value.setup
            uses_add = uses_add || value.uses_add
            uses_sub = uses_sub || value.uses_sub
            uses_eq = uses_eq || value.uses_eq
            if (found == 0) {
                local = GuardBinding { name: statement.text, ty: value.ty, slot: statement_id, parameter: false, view: false }
                name = GuardBindingName(local)
                source += indent.clone() + GuardCType(local.ty, layouts) + " " + name.clone() + " = " + value.value + ";\n"
                source += indent.clone() + "(void)" + name + ";\n"
                locals = locals.push(local)
            } else {
                if (locals[found - 1].parameter || locals[found - 1].ty.kind != value.ty.kind) {
                    RejectLayout("guarded_local_type", "assignment requires a matching initialized local", DeclarationSpan(statement))?
                }
                source += indent.clone() + GuardBindingName(locals[found - 1]) + " = " + value.value + ";\n"
            }
        } else if (statement.kind == "If" && statement.edge_count > 0 && statement.int_value >= 0 &&
                   statement.int_value <= statement.edge_count - 1) {
            if (depth >= 32) {
                RejectLayout("guarded_block_limit", "guarded C accepts at most 32 nested branches", DeclarationSpan(statement))?
            }
            condition = GuardExpression(nodes, edges, locals, layouts, edges[statement.first_edge], 0, indent)?
            if (condition.ty.kind != "bool") {
                RejectLayout("guarded_condition_type", "if requires bool", DeclarationSpan(nodes[edges[statement.first_edge] - 1]))?
            }
            start_then = statement.first_edge + 1
            start_else = start_then + statement.int_value
            stop = statement.first_edge + statement.edge_count
            inside = indent.clone() + "    "
            yes = emitGuardBlock(nodes, edges, types, layouts, locals.clone(), start_then, start_else, depth + 1, inside, can_convert, result_kind)?
            uses_add = uses_add || condition.uses_add || yes.uses_add
            uses_sub = uses_sub || condition.uses_sub || yes.uses_sub
            uses_join = uses_join || yes.uses_join
            uses_format = uses_format || yes.uses_format
            uses_eq = uses_eq || condition.uses_eq || yes.uses_eq
            source += condition.setup + indent.clone() + "if ((bool)" + condition.value + ") {\n" + yes.source + indent.clone() + "}"
            if (start_else < stop) {
                no = emitGuardBlock(nodes, edges, types, layouts, locals.clone(), start_else, stop, depth + 1, inside, can_convert, result_kind)?
                uses_add = uses_add || no.uses_add
                uses_sub = uses_sub || no.uses_sub
                uses_join = uses_join || no.uses_join
                uses_format = uses_format || no.uses_format
                uses_eq = uses_eq || no.uses_eq
                returns = yes.returns && no.returns
                source += " else {\n" + no.source + indent.clone() + "}"
            }
            source += "\n"
        } else {
            RejectLayout("unsupported_guarded_statement", "expected a scalar binding, if, or return", DeclarationSpan(statement))?
        }
        cursor = cursor + 1
    }
    return ok(GuardBlock { source: source, uses_add: uses_add, uses_sub: uses_sub, uses_eq: uses_eq,
        uses_join: uses_join, uses_format: uses_format, returns: returns })
}

fn GuardArithmetic(add: bool, sub: bool): str {
    text = ""
    if (add || sub) { text = "#include <stdio.h>\n#include <stdlib.h>\n\n" }
    if (add) {
        text += "static bool ku_guard_try_add(int64_t a, int64_t b, int64_t *out) {\n"
        text += "    if ((b > 0 && a > INT64_MAX - b) || (b < 0 && a < INT64_MIN - b)) return false;\n"
        text += "    *out = a + b;\n    return true;\n}\n\n"
    }
    if (sub) {
        text += "static bool ku_guard_try_sub(int64_t a, int64_t b, int64_t *out) {\n"
        text += "    if ((b > 0 && a < INT64_MIN + b) || (b < 0 && a > INT64_MAX + b)) return false;\n"
        text += "    *out = a - b;\n    return true;\n}\n\n"
    }
    return text
}

fn GuardLinkedStringPredicate(&method: str, &left: LinkedNullValue, right: LinkedNullExpression,
                               result: TypeNameBinding): LinkedNullExpression {
    next = right.state
    needle = right.value.text
    if (method == "contains") {
        next.uses_string_contains = true
        return LinkedReadonlyExpression(next, result,
            "ku_linked_string_contains(" + left.text.clone() + ", " + needle + ")")
    }
    next.uses_prefix_suffix = true
    return LinkedReadonlyExpression(next, result,
        "ku_scalar_string_matches(" + left.text.clone() + ", " + needle + ", " + str(method == "ends_with") + ")")
}

fn GuardStringEquality(needed: bool): str {
    if (!needed) { return "" }
    return "#include <string.h>\n\nstatic bool ku_guard_string_equal(KuProjectionString a, KuProjectionString b) {\n    return a.len == b.len && (a.len == 0 || memcmp(a.ptr, b.ptr, a.len) == 0);\n}\n\n"
}

fn GuardStringArrayCloneC(): str {
    text = "typedef struct { int code; int64_t index; size_t length; } KuGuardArrayFailure;\n\n"
    text += EmitTryCloneString("ku_guard_clone_string")
    text += "static bool ku_guard_string_array_clone_at(const KuGuardStringArray *array, int64_t index, KuProjectionString *item, KuGuardArrayFailure *failure) {\n"
    text += "    if (!array) { failure->code = 1; return false; }\n"
    text += "    size_t capacity = array->capacity ? array->capacity : array->len;\n"
    text += "    if (array->len > capacity || capacity > SIZE_MAX / sizeof(*array->data) || (capacity && !array->data)) { failure->code = 1; return false; }\n"
    text += "    if (index < 0 || (uint64_t)index >= array->len) { *failure = (KuGuardArrayFailure){2, index, array->len}; return false; }\n"
    text += "    if (!ku_guard_clone_string(array->data[index], item)) { failure->code = 3; return false; }\n"
    text += "    return true;\n}\n\n"
    return text
}

fn GuardStringArrayEqualC(): str {
    text = "static bool ku_guard_string_array_equal(const KuGuardStringArray *array, int64_t index, KuProjectionString literal, bool *out, KuGuardArrayFailure *failure) {\n"
    text += "    KuProjectionString item = {0};\n"
    text += "    if (!ku_guard_string_array_clone_at(array, index, &item, failure)) return false;\n"
    text += "    *out = ku_guard_string_equal(item, literal);\n    ku_projection_string_drop(&item);\n    return true;\n}\n\n"
    return text
}

fn GuardStringArrayC(): str {
    header = "#include <stdio.h>\n\ntypedef struct { size_t len; KuProjectionString *data; size_t capacity; } KuGuardStringArray;\n"
    return header + GuardStringArrayCloneC() + GuardStringArrayEqualC()
}

fn GuardArrayErrorC(): str {
    return "    if (array_failure.code == 2) {\n"
        + "        fprintf(stderr, \"array/index_out_of_bounds: index %lld out of bounds for length %zu\\n\", (long long)array_failure.index, array_failure.length);\n"
        + "        exit(EXIT_FAILURE);\n    }\n"
        + "    if (array_failure.code) {\n"
        + "        fputs(array_failure.code == 3 ? \"out of memory\\n\" : \"invalid string array ownership\\n\", stderr);\n"
        + "        exit(EXIT_FAILURE);\n    }\n"
}

fn emitGuardedStructFunction(&nodes: [Node], &edges: [int], &types: [TypeNameBinding],
                             &layouts: [StructLayout], function_id: int, can_convert: bool): GuardedStructC! {
    function = nodes[function_id - 1].clone()
    symbol = "ku_guarded_" + str(function_id)
    signature = readGuardSignature(nodes, edges, types, layouts, function, symbol)?
    arguments = ""
    for binding in signature.bindings {
        arguments += "    (void)" + GuardBindingName(binding) + ";\n"
    }
    result_kind = signature.result_kind
    body = emitGuardBlock(nodes, edges, types, layouts, signature.bindings, signature.body_start,
        function.first_edge + function.edge_count, 0, "    ", can_convert, result_kind)?
    if (!body.returns) {
        RejectLayout("guarded_fallthrough", "every guarded C path must return its declared result", DeclarationSpan(function))?
    }
    arithmetic = body.uses_add || body.uses_sub
    text = ProjectionHeaders(true, signature.drops != "" || signature.string_array)
        + GuardArithmetic(body.uses_add, body.uses_sub) + GuardStringEquality(body.uses_eq || signature.string_array)
    if (signature.string_array) { text += GuardStringArrayC() }
    if (body.uses_join) {
        text += "#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\ntypedef KuProjectionString KuBootstrapString;\n"
        text += ScalarStringJoinHelpers(body.uses_format)
    }
    text += signature.definitions + signature.declaration
    if (result_kind == "bool") { text += "    bool result = false;\n" }
    else { text += "    KuProjectionString result = {0};\n" }
    text += arguments
    if (arithmetic) { text += "    bool overflow = false;\n" }
    if (body.uses_join) { text += "    const char *failure = NULL;\n" }
    if (signature.string_array) {
        text += "    KuGuardArrayFailure array_failure = {0};\n    (void)ku_guard_string_array_equal;\n"
    }
    text += body.source + "cleanup:\n" + signature.drops
    if (body.uses_join) { text += "    if (failure) { fputs(failure, stderr); exit(EXIT_FAILURE); }\n" }
    if (arithmetic) { text += "    if (overflow) { fputs(\"integer overflow\\n\", stderr); exit(EXIT_FAILURE); }\n" }
    if (signature.string_array) { text += GuardArrayErrorC() }
    text += "    return result;\n}\n"
    return ok(GuardedStructC { symbol: symbol, source: text })
}

// Lower a function whose only managed inputs are finite struct ownership
// trees and whose result is bool or a static or newly owned string.
fn EmitGuardedStructC(&named: NamedModule, &types: [TypeNameBinding], &layouts: [StructLayout], &function_name: str): GuardedStructC! {
    index = 0
    while (index < named.names.declarations.len()) {
        item = named.names.declarations[index].clone()
        if (item.kind == "Function" && item.name == function_name) {
            return emitGuardedStructFunction(named.parsed.arena.nodes, named.parsed.arena.edges, types, layouts, item.node, HasScalarBuiltin(named, "str"))
        }
        index = index + 1
    }
    start = Span { line: 1, column: 1, offset: 0, end_line: 1, end_column: 1, end_offset: 0 }
    RejectLayout("unknown_guarded_function", "undefined guarded function '" + function_name.clone() + "'", start)?
    return ok(GuardedStructC { symbol: "", source: "" })
}

fn FinishLinkedFunctionC(header: str, &body: LinkedNullState, &symbol: str, &signature: str,
                         &result_type: str, &payload_cleanup: str, char_errors: str, &after_cleanup: str): str {
    text = header
    calls_append = body.local_appends.len() > 0
    array_checks = body.validated_arrays.len() > 0
    arithmetic = calls_append || body.uses_add || body.uses_sub || body.uses_mul || body.uses_div
    appends = calls_append || body.append_slots.len() > 0 || body.local_append_types.len() > 0
    index_checks = calls_append || body.uses_index
    text += "\n" + result_type.clone() + " " + symbol.clone() + "(" + signature.clone() + ") {\n"
    text += "    " + result_type.clone() + " result = {0};\n"
    text += payload_cleanup.clone()
    if (appends) { text += "    int append_status = KU_STRUCT_ARRAY_OK;\n" }
    allocation = calls_append || body.uses_clone || body.uses_int_snapshot || body.element_clones.len() > 0
    if (allocation) { text += "    bool out_of_memory = false;\n" }
    if (array_checks) { text += "    bool invalid_array = false;\n" }
    if (calls_append) { text += "    const char *captured_array_failure = NULL;\n" }
    if (body.uses_print) { text += "    bool output_failed = false;\n" }
    if (body.uses_str_view) { text += "    bool invalid_str = false;\n" }
    if (body.uses_struct_view) { text += "    bool invalid_struct_view = false;\n" }
    if (arithmetic) { text += "    bool overflow = false;\n" }
    if (body.uses_div) { text += "    bool division_by_zero = false;\n" }
    if (index_checks) { text += "    bool index_failed = false;\n    int64_t failure_index = 0;\n    size_t failure_length = 0;\n" }
    if (body.uses_concat) { text += "    const char* string_failure = NULL;\n" }
    if (body.uses_chars) { text += "    int source_status = KU_SOURCE_OK;\n" }
    text += body.declarations.clone() + body.code.clone() + "cleanup:\n" + body.drops.clone()
    if (after_cleanup != "") { return text + after_cleanup.clone() + "    return result;\n}\n" }
    if (body.uses_print) { text += "    if (output_failed) { fputs(\"output write failed\\n\", stderr); exit(EXIT_FAILURE); }\n" }
    if (allocation) { text += "    if (out_of_memory) { fputs(\"out of memory\\n\", stderr); exit(EXIT_FAILURE); }\n" }
    if (calls_append) {
        text += "    if (captured_array_failure) { fputs(captured_array_failure, stderr); exit(EXIT_FAILURE); }\n"
    }
    if (array_checks) {
        message = "invalid struct array ownership"
        if (body.uses_str_array) { message = "invalid array view" }
        text += "    if (invalid_array) { fputs(\"" + message + "\\n\", stderr); exit(EXIT_FAILURE); }\n"
    }
    if (appends) {
        text += "    if (append_status != KU_STRUCT_ARRAY_OK) {\n"
            + "        const char *message = \"invalid struct array ownership\\n\";\n"
            + "        if (append_status == KU_STRUCT_ARRAY_CAPACITY) message = \"array allocation is too large\\n\";\n"
            + "        if (append_status == KU_STRUCT_ARRAY_OOM) message = \"array allocation failed\\n\";\n"
            + "        fputs(message, stderr); exit(EXIT_FAILURE);\n    }\n"
    }
    if (body.uses_str_view) { text += "    if (invalid_str) { fputs(\"invalid str view\\n\", stderr); exit(EXIT_FAILURE); }\n" }
    if (body.uses_struct_view) { text += "    if (invalid_struct_view) { fputs(\"invalid struct view\\n\", stderr); exit(EXIT_FAILURE); }\n" }
    if (body.uses_concat) { text += "    if (string_failure) { fputs(string_failure, stderr); exit(EXIT_FAILURE); }\n" }
    if (body.uses_chars) { text += char_errors }
    if (body.uses_div) { text += "    if (division_by_zero) { fputs(\"division by zero\\n\", stderr); exit(EXIT_FAILURE); }\n" }
    if (arithmetic) { text += "    if (overflow) { fputs(\"integer overflow\\n\", stderr); exit(EXIT_FAILURE); }\n" }
    if (index_checks) {
        text += "    if (index_failed) { fprintf(stderr, \"array/index_out_of_bounds: index %lld out of bounds for length %zu\\n\", "
            + "(long long)failure_index, failure_length); exit(EXIT_FAILURE); }\n"
    }
    return text + "    return result;\n}\n"
}

fn ScalarGuardSlotMove(&before: LinkedNullSlot, &after: LinkedNullSlot, &state: LinkedNullState): bool {
    ty = before.value.ty.clone()
    if (ty.declaration_kind != "Struct" || before.value.borrowed || !before.live || after.live
        || before.moved_members.len() != 0 || after.moved_members.len() != 0) { return false }
    layout = LayoutIndex(state.layouts, ty.module_index, ty.declaration_node)
    return layout > 0 && !HasBoundArrayMembers(state.layouts, layout)
        && GuardOwnedDrops(state.layouts, layout, before.value.text) == ""
}
