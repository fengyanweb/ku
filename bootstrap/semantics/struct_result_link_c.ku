import { Node } from "../stage2/ast.ku"
import { DeclarationSpan, NamedModule } from "./names.ku"
import { ExplicitType, RejectLayout, StructLayout } from "./struct_layouts.ku"
import { TypeNameBinding } from "./type_names.ku"
import { GuardBinding, GuardBindingIndex, GuardBindingName, GuardCType, GuardExplicitType, GuardExpression } from "./guarded_struct_expr.ku"
import { AddGuardCode, ManagedBlank, ManagedCode } from "./managed_array_values_c.ku"
import { ContainsIndex } from "./struct_projection_c.ku"
import { BoundLinkPlanType, LinkPlanDeclaration, LinkPlanType, NullLinkPlanResult } from "./link_plan_c.ku"

struct StructResultLink {
    symbol: str
    prototype: str
    remaining: [GuardBinding]
    code: ManagedCode
    declarations: str
    drops: str
    clone_layouts: [int]
    plan: LinkPlanDeclaration
}

fn resultFunctionNode(&named: NamedModule, &name: str): int {
    index = 0
    while (index < named.names.declarations.len()) {
        item = named.names.declarations[index].clone()
        if (item.kind == "Function" && item.name == name) { return item.node }
        index = index + 1
    }
    return 0
}

fn remainingBindings(&bindings: [GuardBinding], removed: int): [GuardBinding] {
    kept: [GuardBinding] = []
    index = 0
    while (index < bindings.len()) {
        if (index + 1 != removed) { kept = kept.push(bindings[index].clone()) }
        index = index + 1
    }
    return kept
}

fn checkNullResultCallee(&nodes: [Node], &edges: [int], &types: [TypeNameBinding],
                         &callee: Node, result_edge: int): null! {
    if (result_edge >= callee.first_edge + callee.edge_count) {
        RejectLayout("unsupported_struct_result_link", "checked call requires a declared null! result", DeclarationSpan(callee))?
    }
    signature = nodes[edges[result_edge] - 1].clone()
    if (signature.kind != "TypeResult" || signature.edge_count != 1) {
        RejectLayout("unsupported_struct_result_link", "checked call requires a declared null! result", DeclarationSpan(signature))?
    }
    bound = ExplicitType(types, edges[signature.first_edge], DeclarationSpan(signature))?
    if (bound.declaration_kind != "Builtin" || bound.name != "null") {
        RejectLayout("unsupported_struct_result_link", "checked dependency must return null!", bound.span)?
    }
    return ok(null)
}

fn explicitCloneSource(&nodes: [Node], &edges: [int], &argument: Node): int {
    if (argument.kind != "Call" || argument.edge_count != 1) { return 0 }
    method = nodes[edges[argument.first_edge] - 1].clone()
    if (method.kind != "Field" || method.text != "clone" || method.edge_count != 1) { return 0 }
    return edges[method.first_edge]
}

fn ResultLinkClonePrefix(layout: int): str {
    return "ku_result_link_layout_" + str(layout)
}

// Lower one direct same-module dependency as a link against its exact
// validated declaration. No handwritten error construction substitutes for
// a missing callee. An owner argument is made unavailable after transfer.
fn LowerStructResultLink(&named: NamedModule, &types: [TypeNameBinding], &layouts: [StructLayout],
                         bindings: [GuardBinding], statement_id: int): StructResultLink! {
    statement = named.parsed.arena.nodes[statement_id - 1].clone()
    if (statement.kind != "ExprStmt" || statement.edge_count != 1) {
        RejectLayout("unsupported_struct_result_link", "expected a checked dependency statement", DeclarationSpan(statement))?
    }
    propagate = named.parsed.arena.nodes[named.parsed.arena.edges[statement.first_edge] - 1].clone()
    if (propagate.kind != "TryUnwrap" || propagate.edge_count != 1) {
        RejectLayout("unsupported_struct_result_link", "expected a direct call followed by ?", DeclarationSpan(propagate))?
    }
    call = named.parsed.arena.nodes[named.parsed.arena.edges[propagate.first_edge] - 1].clone()
    if (call.kind != "Call" || call.edge_count == 0) {
        RejectLayout("unsupported_struct_result_link", "expected a direct checked call", DeclarationSpan(call))?
    }
    target = named.parsed.arena.nodes[named.parsed.arena.edges[call.first_edge] - 1].clone()
    id = resultFunctionNode(named, target.text)
    if (target.kind != "Variable" || target.edge_count != 0 || id == 0 || GuardBindingIndex(bindings, target.text) != 0) {
        RejectLayout("unknown_struct_result_link", "expected an unshadowed same-module function", DeclarationSpan(target))?
    }
    callee = named.parsed.arena.nodes[id - 1].clone()
    symbol = "ku_result_dependency_" + str(id)
    prototype = "extern KuBootstrapResultNull " + symbol.clone() + "("
    args = ""
    transfers = ""
    moved_scratch = ""
    parameters: [LinkPlanType] = []
    code = ManagedBlank()
    declarations = ""
    drops = ""
    clone_layouts: [int] = []
    available = bindings
    cursor = callee.first_edge
    end = cursor + callee.edge_count
    index = 1
    while (cursor < end && named.parsed.arena.nodes[named.parsed.arena.edges[cursor] - 1].kind == "Parameter") {
        parameter = named.parsed.arena.nodes[named.parsed.arena.edges[cursor] - 1].clone()
        if (index >= call.edge_count || parameter.edge_count != 1 || parameter.int_value != 0) {
            RejectLayout("struct_result_link_signature", "checked link needs matching by-value arguments", DeclarationSpan(call))?
        }
        parameter_id = named.parsed.arena.edges[parameter.first_edge]
        ty = GuardExplicitType(types, named.parsed.arena.nodes, layouts, parameter_id)?
        arg_id = named.parsed.arena.edges[call.first_edge + index]
        arg = named.parsed.arena.nodes[arg_id - 1].clone()
        subject = 0
        if (ty.kind == "struct") {
            subject = explicitCloneSource(named.parsed.arena.nodes, named.parsed.arena.edges, arg)
        }
        value_id = arg_id
        if (subject != 0) { value_id = subject }
        value = GuardExpression(named.parsed.arena.nodes, named.parsed.arena.edges, available, layouts, value_id, 0, "    ")?
        if (ty.kind != value.ty.kind || ty.layout != value.ty.layout || (value.view && subject == 0) ||
            (ty.kind == "str" && arg.kind != "String")) {
            RejectLayout("struct_result_link_argument", "expected matching by-value arguments and static str", DeclarationSpan(arg))?
        }
        c_type = GuardCType(ty, layouts)
        bound = ExplicitType(types, parameter_id, DeclarationSpan(parameter))?
        parameters = parameters.push(BoundLinkPlanType(bound, 1, c_type.clone(), false))
        sequential = "p" + str(statement_id) + "_" + str(index)
        if (index > 1) { prototype += ", " args += ", " }
        prototype += c_type.clone()
        args += sequential.clone()
        code = AddGuardCode(code, value)
        if (subject != 0) {
            if (named.parsed.arena.nodes[subject - 1].kind != "Variable") {
                RejectLayout("struct_result_link_owner", "explicit struct clone requires a bound value or View", DeclarationSpan(arg))?
            }
            prefix = ResultLinkClonePrefix(ty.layout)
            if (!ContainsIndex(clone_layouts, ty.layout)) { clone_layouts = clone_layouts.push(ty.layout) }
            declarations += "    " + c_type.clone() + " " + sequential.clone() + " = {0};\n"
            drops = "    " + prefix.clone() + "_element_drop(&" + sequential.clone() + ");\n" + drops
            reference = value.value
            if (!value.view) { reference = "&" + reference }
            code.text = code.text + "    if (!" + prefix + "_clone_element(" + reference + ", &" + sequential.clone() +
                ")) { out_of_memory = true; goto cleanup; }\n"
            // The callee will consume this clone, and no generated operation
            // can fail between call and clearing the moved scratch slot.
            moved_scratch += "    " + sequential + " = (" + c_type + "){0};\n"
        } else {
            code.text = code.text + "    " + c_type.clone() + " " + sequential + " = " + value.value + ";\n"
        }
        if (ty.kind == "struct" && subject == 0) {
            source = GuardBindingIndex(available, arg.text)
            if (arg.kind != "Variable" || source == 0) {
                RejectLayout("struct_result_link_owner", "checked link needs a distinct initialized struct owner", DeclarationSpan(arg))?
            }
            // Until every argument has been evaluated, the original frame
            // holds the owner. A later overflow then drops it at cleanup.
            transfers += "    " + GuardBindingName(available[source - 1]) + " = (" + c_type + "){0};\n"
            available = remainingBindings(available, source)
        }
        cursor = cursor + 1
        index = index + 1
    }
    if (index != call.edge_count) {
        RejectLayout("struct_result_link_signature", "checked link argument count does not match its declaration", DeclarationSpan(call))?
    }
    checkNullResultCallee(named.parsed.arena.nodes, named.parsed.arena.edges, types, callee, cursor)?
    if (args == "") { prototype += "void" }
    outcome = "dependency" + str(statement_id)
    code.text = code.text + transfers + "    KuBootstrapResultNull " + outcome.clone() + " = " + symbol.clone() + "(" + args + ");\n"
    code.text = code.text + moved_scratch
    code.text = code.text + "    if (!" + outcome.clone() + ".ok) {\n        result.error = " + outcome.clone() + ".error;\n"
    code.text = code.text + "        " + outcome + ".error = (KuBootstrapError){0};\n        goto cleanup;\n    }\n"
    plan = LinkPlanDeclaration { unit: 1, node: id, symbol: symbol.clone(),
        parameters: parameters, result: NullLinkPlanResult(), returns_result: true }
    return ok(StructResultLink { symbol: symbol, prototype: prototype + ");\n\n", remaining: available, code: code,
        declarations: declarations, drops: drops, clone_layouts: clone_layouts, plan: plan })
}
