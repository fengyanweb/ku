import { Node } from "../stage2/ast.ku"
import { DeclarationSpan, NamedModule } from "./names.ku"
import { ExplicitType, RejectLayout, StructLayout } from "./struct_layouts.ku"
import { TypeNameBinding } from "./type_names.ku"
import { GuardBinding, GuardBindingIndex, GuardBindingName, GuardBoundType, GuardCType, GuardExplicitType, GuardExpression, GuardLeaf } from "./guarded_struct_expr.ku"
import { GuardParameterType } from "./guarded_struct_c.ku"
import { BoundSameModuleFunction, ManagedClonedStringCall, ManagedDeferredMessageCalls, ManagedLiteralStringReturns, ManagedRecordStringMove } from "./guarded_string_parts.ku"
import { AddGuardCode, ManagedBlank, ManagedCode } from "./managed_array_values_c.ku"
import { ContainsIndex, ProjectionCloneSource } from "./struct_projection_c.ku"
import { BoundLinkPlanType, BuiltinLinkPlanType, LinkPlanDeclaration, LinkPlanType, NullLinkPlanResult, StrArrayViewLinkPlanType } from "./link_plan_c.ku"
import { ScalarSymbol } from "./scalar_int_emit.ku"

struct OwnedScalarLeaves {
    bindings: [GuardLeaf]
    declarations: str
    plan: [LinkPlanDeclaration]
    needs_clone: bool
}

struct StructResultLink {
    symbol: str
    prototype: str
    remaining: [GuardBinding]
    code: ManagedCode
    declarations: str
    drops: str
    clone_layouts: [int]
    plan: LinkPlanDeclaration
}

struct OwnedRecordCall {
    code: ManagedCode
    prototype: str
    payload_layout: int
    payload_type: str
    result_type: str
    name: str
    plan: LinkPlanDeclaration
}

fn LowerOwnedRecordCall(&named: NamedModule, &types: [TypeNameBinding], &layouts: [StructLayout],
                         &bindings: [GuardBinding], caller_id: int, call_id: int,
                         managed: bool, &indent: str): OwnedRecordCall! {
    call = named.parsed.arena.nodes[call_id - 1].clone()
    if (call.edge_count == 0) {
        RejectLayout("unsupported_record_call", "expected a direct checked record call", DeclarationSpan(call))?
    }
    target = named.parsed.arena.nodes[named.parsed.arena.edges[call.first_edge] - 1].clone()
    id = BoundSameModuleFunction(named, target.text)
    if (target.kind != "Variable" || target.edge_count != 0 || id == 0 || id == caller_id || GuardBindingIndex(bindings, target.text) != 0) {
        RejectLayout("unknown_record_call", "expected a distinct, unshadowed same-module function", DeclarationSpan(target))?
    }
    callee = named.parsed.arena.nodes[id - 1].clone()
    cursor = callee.first_edge
    end = cursor + callee.edge_count
    arguments: [LinkPlanType] = []
    code = ManagedBlank()
    signature = ""
    inputs = ""
    moved = ""
    while (cursor < end && named.parsed.arena.nodes[named.parsed.arena.edges[cursor] - 1].kind == "Parameter") {
        parameter = named.parsed.arena.nodes[named.parsed.arena.edges[cursor] - 1].clone()
        index = arguments.len() + 1
        if (index >= call.edge_count || parameter.edge_count != 1 || parameter.int_value < 0 || parameter.int_value > 1) {
            RejectLayout("record_call_signature", "checked record call requires matching typed parameters", DeclarationSpan(parameter))?
        }
        input = named.parsed.arena.edges[call.first_edge + index]
        input_node = named.parsed.arena.nodes[input - 1].clone()
        type_id = named.parsed.arena.edges[parameter.first_edge]
        view = parameter.int_value == 1
        ty = GuardParameterType(named.parsed.arena.nodes, named.parsed.arena.edges, types, layouts, type_id, view)?
        value = GuardExpression(named.parsed.arena.nodes, named.parsed.arena.edges, bindings, layouts, input, 0, indent)?
        borrow = managed && view && !value.view && ty.kind == "str_array" && input_node.kind == "Variable"
        consume = managed && !view && ty.kind == "str" && input_node.kind == "Variable"
        if (value.ty.kind != ty.kind || value.ty.layout != ty.layout || (!borrow && value.view != view) ||
            (view && (input_node.kind != "Variable" || (ty.kind != "str_array" && ty.kind != "struct"))) ||
            (!view && ty.kind != "int" && ty.kind != "bool" && (ty.kind != "str" || (input_node.kind != "String" && !consume)))) {
            RejectLayout("record_call_argument", "expected a matching Copy value, static str or existing View", DeclarationSpan(input_node))?
        }
        c_type = GuardCType(ty, layouts)
        if (view) { c_type = "const " + c_type + "*" }
        if (ty.kind == "str_array") { arguments = arguments.push(StrArrayViewLinkPlanType()) }
        else {
            bound = ExplicitType(types, type_id, DeclarationSpan(parameter))?
            arguments = arguments.push(BoundLinkPlanType(bound, 1, c_type.clone(), view))
        }
        if (signature != "") { signature += ", " inputs += ", " }
        signature += c_type.clone()
        temp = "record_arg" + str(call_id) + "_" + str(index)
        code = AddGuardCode(code, value)
        if (borrow) { value.value = "&" + value.value }
        code.text = code.text + indent.clone() + c_type + " " + temp.clone() + " = " + value.value + ";\n"
        if (consume) { moved += ManagedRecordStringMove(named, bindings, input_node, caller_id, indent)? }
        inputs += temp
        cursor = cursor + 1
    }
    if (arguments.len() + 1 != call.edge_count || cursor >= end - 1) {
        RejectLayout("record_call_signature", "expected the declared argument count and explicit record Result", DeclarationSpan(call))?
    }
    result = named.parsed.arena.nodes[named.parsed.arena.edges[cursor] - 1].clone()
    if (result.kind != "TypeResult" || result.edge_count != 1) {
        RejectLayout("record_call_result", "checked record call requires a named struct Result", DeclarationSpan(result))?
    }
    type_id = named.parsed.arena.edges[result.first_edge]
    payload = GuardExplicitType(types, named.parsed.arena.nodes, layouts, type_id)?
    if (payload.kind != "struct") {
        RejectLayout("record_call_result", "checked record call requires a named struct Result", DeclarationSpan(result))?
    }
    bound = ExplicitType(types, type_id, DeclarationSpan(result))?
    payload_type = GuardCType(payload, layouts)
    c_type = "KuBootstrapResult_" + payload_type.clone()
    symbol = "ku_struct_result_" + str(id)
    name = "record_result" + str(call_id)
    if (signature == "") { signature = "void" }
    prototype = "extern " + c_type.clone() + " " + symbol.clone() + "(" + signature + ");\n"
    plan = LinkPlanDeclaration { unit: 1, node: id, symbol: symbol.clone(), parameters: arguments,
        result: BoundLinkPlanType(bound, 1, c_type.clone(), false), returns_result: true }
    // A failed later argument still leaves the original string owner in
    // scope. Only hand over its already prepared carrier at the call.
    code.text = code.text + moved + indent.clone() + c_type.clone() + " " + name.clone() + " = " + symbol + "(" + inputs + ");\n"
    return ok(OwnedRecordCall { code: code, prototype: prototype, payload_layout: payload.layout,
        payload_type: payload_type, result_type: c_type, name: name, plan: plan })
}

fn ownedScalarLeafId(&named: NamedModule, &call: Node): int {
    if (call.kind != "Call" || call.edge_count < 2) { return 0 }
    target = named.parsed.arena.nodes[named.parsed.arena.edges[call.first_edge] - 1].clone()
    if (target.kind != "Variable" || target.edge_count != 0) { return 0 }
    return BoundSameModuleFunction(named, target.text)
}

fn ReadOwnedScalarLeaves(&named: NamedModule, &types: [TypeNameBinding], &layouts: [StructLayout],
                         &function: Node, managed: bool): OwnedScalarLeaves! {
    output = OwnedScalarLeaves { bindings: [], declarations: "", plan: [], needs_clone: false }
    calls: [int] = []
    if (managed) {
        calls = ManagedDeferredMessageCalls(named.parsed.arena.nodes, named.parsed.arena.edges, function)
    }
    emitted: [int] = []
    index = 0
    while (index < named.parsed.arena.nodes.len()) {
        index = index + 1
        call = named.parsed.arena.nodes[index - 1].clone()
        if (call.offset < function.offset || call.end_offset > function.end_offset) { continue }
        message = managed && ContainsIndex(calls, index)
        if (managed && !message && !ManagedClonedStringCall(named.parsed.arena.nodes, named.parsed.arena.edges, call)) { continue }
        id = ownedScalarLeafId(named, call)
        if (id == 0 || (!managed && ContainsIndex(emitted, id))) { continue }
        leaf = named.parsed.arena.nodes[id - 1].clone()
        position = call.edge_count - 1
        if (position >= leaf.edge_count - 1) { continue }
        result = named.parsed.arena.edges[leaf.first_edge + position]
        if (named.parsed.arena.nodes[result - 1].kind != "TypeName") { continue }
        selected = ExplicitType(types, result, DeclarationSpan(named.parsed.arena.nodes[result - 1]))?
        string_result = selected.name == "str"
        if (managed && !string_result && (message || selected.name != "bool")) { continue }
        if (selected.declaration_kind != "Builtin" || (!string_result && selected.name != "int" && selected.name != "bool")) { continue }
        view_predicate = false
        owned_string = false
        parameters: [LinkPlanType] = []
        kinds: [str] = []
        c_args = ""
        cursor = 0
        while (cursor < position) {
            parameter = named.parsed.arena.nodes[named.parsed.arena.edges[leaf.first_edge + cursor] - 1].clone()
            if (parameter.kind != "Parameter" || parameter.edge_count != 1 || parameter.int_value < 0 || parameter.int_value > 1) { break }
            view = parameter.int_value == 1
            type_id = named.parsed.arena.edges[parameter.first_edge]
            shape = named.parsed.arena.nodes[type_id - 1].kind.clone()
            if ((view && (shape != "TypeArray" || string_result)) || (!view && shape != "TypeName")) { break }
            input = GuardParameterType(named.parsed.arena.nodes, named.parsed.arena.edges, types, layouts, type_id, view)?
            c_type = GuardCType(input, layouts)
            if (view) {
                view_predicate = true
                c_type = "const " + c_type + "*"
                parameters = parameters.push(StrArrayViewLinkPlanType())
            } else {
                if (input.kind == "str" && (position == 1 || string_result)) { owned_string = true }
                else if (input.kind != "int" && (input.kind != "bool" || string_result)) { break }
                parameters = parameters.push(BuiltinLinkPlanType(input.kind.clone(), c_type.clone(), false))
            }
            if (cursor != 0) { c_args += ", " }
            c_args += c_type
            kinds = kinds.push(input.kind)
            cursor = cursor + 1
        }
        if (managed && !message && !owned_string) { continue }
        if (cursor != position || (!owned_string && !string_result && (!view_predicate || selected.name != "bool"))) { continue }
        if (managed && !message && string_result && !ManagedLiteralStringReturns(named.parsed.arena.nodes, named.parsed.arena.edges, leaf)) { continue }
        if (managed && !message) { output.needs_clone = true }
        if (ContainsIndex(emitted, id)) { continue }
        symbol = "ku_guarded_" + str(id)
        if (owned_string || string_result) {
            scalar_type = 1
            if (selected.name == "bool") { scalar_type = 3 }
            if (string_result) { scalar_type = 2 }
            symbol = ScalarSymbol(id, scalar_type)
        }
        ty = GuardBoundType(selected, layouts)?
        c_type = GuardCType(ty, layouts)
        output.declarations = output.declarations + "extern " + c_type.clone() + " " + symbol.clone() + "(" + c_args + ");\n"
        output.plan = output.plan.push(LinkPlanDeclaration { unit: 1, node: id, symbol: symbol.clone(),
            parameters: parameters,
            result: BuiltinLinkPlanType(ty.kind.clone(), c_type, false), returns_result: false })
        output.bindings = output.bindings.push(GuardLeaf { name: leaf.text, symbol: symbol, result_kind: ty.kind, parameters: kinds })
        emitted = emitted.push(id)
    }
    return ok(output)
}

fn WithoutOwnedBinding(&bindings: [GuardBinding], removed: int): [GuardBinding] {
    kept: [GuardBinding] = []
    index = 0
    while (index < bindings.len()) {
        if (index + 1 != removed) { kept = kept.push(bindings[index].clone()) }
        index = index + 1
    }
    return kept
}

fn checkNullResultCallee(&nodes: [Node], &edges: [int], &types: [TypeNameBinding],
                         &callee: Node, result_edge: int): null! {
    if (result_edge >= callee.first_edge + callee.edge_count) {
        RejectLayout("unsupported_struct_result_link", "checked call requires a declared null! result", DeclarationSpan(callee))?
    }
    signature = nodes[edges[result_edge] - 1].clone()
    if (signature.kind != "TypeResult" || signature.edge_count != 1) {
        RejectLayout("unsupported_struct_result_link", "checked call requires a declared null! result", DeclarationSpan(signature))?
    }
    bound = ExplicitType(types, edges[signature.first_edge], DeclarationSpan(signature))?
    if (bound.declaration_kind != "Builtin" || bound.name != "null") {
        RejectLayout("unsupported_struct_result_link", "checked dependency must return null!", bound.span)?
    }
    return ok(null)
}

fn ResultLinkClonePrefix(layout: int): str {
    return "ku_result_link_layout_" + str(layout)
}

// Lower one direct same-module dependency as a link against its exact
// validated declaration. No handwritten error construction substitutes for
// a missing callee. An owner argument is made unavailable after transfer.
fn LowerStructResultLink(&named: NamedModule, &types: [TypeNameBinding], &layouts: [StructLayout],
                         bindings: [GuardBinding], statement_id: int): StructResultLink! {
    statement = named.parsed.arena.nodes[statement_id - 1].clone()
    if (statement.kind != "ExprStmt" || statement.edge_count != 1) {
        RejectLayout("unsupported_struct_result_link", "expected a checked dependency statement", DeclarationSpan(statement))?
    }
    propagate = named.parsed.arena.nodes[named.parsed.arena.edges[statement.first_edge] - 1].clone()
    if (propagate.kind != "TryUnwrap" || propagate.edge_count != 1) {
        RejectLayout("unsupported_struct_result_link", "expected a direct call followed by ?", DeclarationSpan(propagate))?
    }
    call = named.parsed.arena.nodes[named.parsed.arena.edges[propagate.first_edge] - 1].clone()
    if (call.kind != "Call" || call.edge_count == 0) {
        RejectLayout("unsupported_struct_result_link", "expected a direct checked call", DeclarationSpan(call))?
    }
    target = named.parsed.arena.nodes[named.parsed.arena.edges[call.first_edge] - 1].clone()
    id = BoundSameModuleFunction(named, target.text)
    if (target.kind != "Variable" || target.edge_count != 0 || id == 0 || GuardBindingIndex(bindings, target.text) != 0) {
        RejectLayout("unknown_struct_result_link", "expected an unshadowed same-module function", DeclarationSpan(target))?
    }
    callee = named.parsed.arena.nodes[id - 1].clone()
    symbol = "ku_result_dependency_" + str(id)
    prototype = "extern KuBootstrapResultNull " + symbol.clone() + "("
    args = ""
    transfers = ""
    moved_scratch = ""
    parameters: [LinkPlanType] = []
    code = ManagedBlank()
    declarations = ""
    drops = ""
    clone_layouts: [int] = []
    available = bindings
    cursor = callee.first_edge
    end = cursor + callee.edge_count
    index = 1
    while (cursor < end && named.parsed.arena.nodes[named.parsed.arena.edges[cursor] - 1].kind == "Parameter") {
        parameter = named.parsed.arena.nodes[named.parsed.arena.edges[cursor] - 1].clone()
        if (index >= call.edge_count || parameter.edge_count != 1 || parameter.int_value != 0) {
            RejectLayout("struct_result_link_signature", "checked link needs matching by-value arguments", DeclarationSpan(call))?
        }
        parameter_id = named.parsed.arena.edges[parameter.first_edge]
        ty = GuardExplicitType(types, named.parsed.arena.nodes, layouts, parameter_id)?
        arg_id = named.parsed.arena.edges[call.first_edge + index]
        arg = named.parsed.arena.nodes[arg_id - 1].clone()
        subject = 0
        if (ty.kind == "struct") {
            subject = ProjectionCloneSource(named.parsed.arena.nodes, named.parsed.arena.edges, arg_id)
        }
        value_id = arg_id
        if (subject != 0) { value_id = subject }
        value = GuardExpression(named.parsed.arena.nodes, named.parsed.arena.edges, available, layouts, value_id, 0, "    ")?
        if (ty.kind != value.ty.kind || ty.layout != value.ty.layout || (value.view && subject == 0) ||
            (ty.kind == "str" && arg.kind != "String")) {
            RejectLayout("struct_result_link_argument", "expected matching by-value arguments and static str", DeclarationSpan(arg))?
        }
        c_type = GuardCType(ty, layouts)
        bound = ExplicitType(types, parameter_id, DeclarationSpan(parameter))?
        parameters = parameters.push(BoundLinkPlanType(bound, 1, c_type.clone(), false))
        sequential = "p" + str(statement_id) + "_" + str(index)
        if (index > 1) { prototype += ", " args += ", " }
        prototype += c_type.clone()
        args += sequential.clone()
        code = AddGuardCode(code, value)
        if (subject != 0) {
            if (named.parsed.arena.nodes[subject - 1].kind != "Variable") {
                RejectLayout("struct_result_link_owner", "explicit struct clone requires a bound value or View", DeclarationSpan(arg))?
            }
            prefix = ResultLinkClonePrefix(ty.layout)
            if (!ContainsIndex(clone_layouts, ty.layout)) { clone_layouts = clone_layouts.push(ty.layout) }
            declarations += "    " + c_type.clone() + " " + sequential.clone() + " = {0};\n"
            drops = "    " + prefix.clone() + "_element_drop(&" + sequential.clone() + ");\n" + drops
            reference = value.value
            if (!value.view) { reference = "&" + reference }
            code.text = code.text + "    if (!" + prefix + "_clone_element(" + reference + ", &" + sequential.clone() +
                ")) { out_of_memory = true; goto cleanup; }\n"
            // The callee will consume this clone, and no generated operation
            // can fail between call and clearing the moved scratch slot.
            moved_scratch += "    " + sequential + " = (" + c_type + "){0};\n"
        } else {
            code.text = code.text + "    " + c_type.clone() + " " + sequential + " = " + value.value + ";\n"
        }
        if (ty.kind == "struct" && subject == 0) {
            source = GuardBindingIndex(available, arg.text)
            if (arg.kind != "Variable" || source == 0) {
                RejectLayout("struct_result_link_owner", "checked link needs a distinct initialized struct owner", DeclarationSpan(arg))?
            }
            // Until every argument has been evaluated, the original frame
            // holds the owner. A later overflow then drops it at cleanup.
            transfers += "    " + GuardBindingName(available[source - 1]) + " = (" + c_type + "){0};\n"
            available = WithoutOwnedBinding(available, source)
        }
        cursor = cursor + 1
        index = index + 1
    }
    if (index != call.edge_count) {
        RejectLayout("struct_result_link_signature", "checked link argument count does not match its declaration", DeclarationSpan(call))?
    }
    checkNullResultCallee(named.parsed.arena.nodes, named.parsed.arena.edges, types, callee, cursor)?
    if (args == "") { prototype += "void" }
    outcome = "dependency" + str(statement_id)
    code.text = code.text + transfers + "    KuBootstrapResultNull " + outcome.clone() + " = " + symbol.clone() + "(" + args + ");\n"
    code.text = code.text + moved_scratch
    code.text = code.text + "    if (!" + outcome.clone() + ".ok) {\n        result.error = " + outcome.clone() + ".error;\n"
    code.text = code.text + "        " + outcome + ".error = (KuBootstrapError){0};\n        goto cleanup;\n    }\n"
    plan = LinkPlanDeclaration { unit: 1, node: id, symbol: symbol.clone(),
        parameters: parameters, result: NullLinkPlanResult(), returns_result: true }
    return ok(StructResultLink { symbol: symbol, prototype: prototype + ");\n\n", remaining: available, code: code,
        declarations: declarations, drops: drops, clone_layouts: clone_layouts, plan: plan })
}
