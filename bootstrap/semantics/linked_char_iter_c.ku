import { Node } from "../stage2/ast.ku"
import { DeclarationSpan, IsNamedFunction } from "./names.ku"
import { RejectLayout } from "./struct_layouts.ku"
import { LinkedNullBinding, LinkedNullExpression, LinkedNullIntArrayOwner, LinkedNullOwnedArray, LinkedNullRegion, LinkedNullSlot, LinkedNullState, LinkedNullValue,
    LinkedReadonlyExpression, PreserveLinkedOwners, RestoreLinkedNullSlots } from "./link_plan_c.ku"
import { LinkedBuiltin, LinkedCheckedResultCType, LinkedIntResult, LinkedNullChild, LinkedNullCType, LinkedNullNode,
    LinkedNullParameterType, LinkedNullProject, LinkedNullResultCleanupReference, LinkedNullType, LinkedStringResult,
    ReadLinkedResult, SameLinkedType } from "./linked_null_types_c.ku"
import { AddLinkedNullSlot, RegisterLinkedNullType, RequireLinkedArrayValidation } from "./linked_parameters_c.ku"
import { DropLinkedNullScope, LinkedLiveIntBinding } from "./linked_member_ownership.ku"
import { LowerLinkedNullValue } from "./linked_null_values_c.ku"
import { LowerLinkedNullRead } from "./linked_null_read_c.ku"
import { ContainsIndex } from "./struct_projection_c.ku"
import { TypeNameBinding } from "./type_names.ku"
import { FinishLinkedFunctionC } from "./guarded_struct_c.ku"
import { ManagedSourceCharactersErrors } from "./guarded_string_parts.ku"
import { LinkedForLoop, OpenLinkedCheckedRecordFor } from "./linked_owner_assignment_c.ku"

fn rejectLocalCapture(&node: Node, message: str): null! {
    return RejectLayout("unsupported_linked_local_capture", message, DeclarationSpan(node))
}

// The validated arena stores this function's subtree contiguously. A second
// function or a declaration that could shadow an outer slot needs its own
// binding rules before this restricted same-frame lowering can accept it.
fn readLinkedLocalCaptures(&project: LinkedNullProject, &state: LinkedNullState,
                           &function: Node, id: int): [int]! {
    first = LinkedNullNode(project, 1, LinkedNullChild(project, 1, function, 0))
    second = LinkedNullNode(project, 1, LinkedNullChild(project, 1, function, 1))
    cursor = LinkedNullChild(project, 1, function, 3)
    while (project.supplied[0].named.parsed.arena.nodes[cursor - 1].edge_count > 0) {
        cursor = project.supplied[0].named.parsed.arena.edges[
            project.supplied[0].named.parsed.arena.nodes[cursor - 1].first_edge]
    }
    slots: [int] = []
    while (cursor < id) {
        node = LinkedNullNode(project, 1, cursor)
        use = node.kind == "Variable" || node.kind == "Assign"
        if (IsNamedFunction(node.kind) || node.kind == "FunctionExpr" || (use && node.text == function.text)) {
            rejectLocalCapture(node, "a local callback cannot define or reference a nested callable")?
        }
        declares = node.kind == "VarDecl" || node.kind == "For" || node.kind == "CatchBinding" ||
            node.kind == "ObjectDestructureLocal" || node.kind == "ObjectDestructureRest"
        if ((use || declares) && node.text != first.text && node.text != second.text) {
            slot = LinkedNullBinding(state.slots, node.text)
            if (slot > 0 && declares) {
                rejectLocalCapture(node, "a local callback binding cannot shadow an outer capture")?
            }
            if (slot > 0 && !ContainsIndex(slots, slot)) { slots = slots.push(slot) }
        }
        cursor = cursor + 1
    }
    return ok(slots)
}

struct LinkedLocalThunk {
    state: LinkedNullState
    result: TypeNameBinding
    owners: [int]
    environment: str
    fields: str
    initializers: str
}

fn ReadLinkedLocalThunk(&project: LinkedNullProject, &parent: LinkedNullState,
                        &function: Node, id: int): LinkedLocalThunk! {
    // Retain shared C requirements and dependency identities, but start the
    // private function with its own automatic storage and error cleanup.
    body = parent.clone()
    body.slots = []
    body.declarations = ""
    body.code = ""
    body.drops = ""
    body.plain_value_result = false
    body.local_readers = []
    body.local_callbacks = []
    body.callback_owners = []
    body.append_slots = []
    body.catch_slot = 0
    body.catch_edges = false
    body.catch_moved = []
    body.moved_error_fields = []
    for index in [0, 1] {
        parameter = LinkedNullNode(project, 1, LinkedNullChild(project, 1, function, index))
        if (parameter.kind != "Parameter" || parameter.edge_count != 1 || parameter.int_value != 0 ||
            LinkedNullBinding(body.slots, parameter.text) > 0) {
            rejectLocalCapture(parameter, "a local callback needs two distinct typed Copy int parameters")?
        }
        ty = LinkedNullType(project, 1, LinkedNullChild(project, 1, parameter, 0))?
        if (!LinkedIntResult(ty)) { rejectLocalCapture(parameter, "a local callback requires Copy int parameters")? }
        bound = AddLinkedNullSlot(project, body, parameter.text, "a" + str(index), ty, true)?
        body = bound.state
        body.code += "    (void)" + bound.value.text + ";\n"
    }
    result = ReadLinkedResult(project, 1, LinkedNullChild(project, 1, function, 2), true)?
    if (result.declaration_kind != "Struct") { rejectLocalCapture(function, "a local callback requires a checked named result")? }
    body = RegisterLinkedNullType(project, body, result.clone())?
    environment = "ku_local_environment_" + str(id)
    body.code += "    " + environment.clone() + " *capture = raw;\n    (void)capture;\n"
    fields = ""
    initializers = ""
    owners: [int] = []
    for index in readLinkedLocalCaptures(project, parent, function, id)? {
        outer = parent.slots[index - 1].clone()
        owned_array = LinkedNullOwnedArray(outer.value.ty)
        array_view = owned_array || outer.value.ty.declaration_kind == "StructArray"
        copy = outer.value.ty.declaration_kind == "Builtin" && (outer.value.ty.name == "int" || outer.value.ty.name == "bool")
        if (!outer.live || outer.moved_members.len() > 0 || (!copy && !array_view)) {
            rejectLocalCapture(function, "local capture requires a live Copy scalar or readonly named array owner")?
        }
        ty = outer.value.ty.clone()
        if (array_view) { ty.declaration_kind = "StructArray" }
        field = "c" + str(index)
        text = "capture->" + field.clone()
        initializer = outer.value.text.clone()
        if (copy || owned_array) { initializer = "&(" + initializer + ")" }
        typedef = LinkedNullCType(ty)?
        if (copy) {
            typedef += " *"
            text = "(*" + text + ")"
        }
        if (owned_array) { owners = owners.push(index) }
        fields += " " + typedef + " " + field.clone() + ";"
        initializers += " ." + field + " = " + initializer + ","
        outer.value.ty = ty
        outer.value.text = text
        outer.value.slot = body.slots.len() + 1
        outer.value.borrowed = array_view
        outer.parameter = true
        body.slots = body.slots.push(outer)
    }
    if (fields == "") {
        fields = " bool active;"
        initializers = " .active = true,"
    }
    return ok(LinkedLocalThunk { state: body, result: result, owners: owners, environment: environment,
        fields: fields, initializers: initializers })
}

fn bindLinkedLocalCallback(state: LinkedNullState, name: str, ty: TypeNameBinding, text: str): LinkedNullState {
    next = state
    index = next.slots.len() + 1
    value = LinkedNullValue { ty: ty, text: text, slot: index, borrowed: true, member_path: "" }
    next.slots = next.slots.push(LinkedNullSlot { binding: name, value: value, parameter: false, live: true, moved_members: [] })
    next.local_callbacks = next.local_callbacks.push(index)
    return next
}

fn FinishLinkedLocalThunk(&parent: LinkedNullState, &thunk: LinkedLocalThunk,
                          lowered: LinkedNullRegion, &function: Node, id: int): LinkedNullState! {
    if (!lowered.terminal || lowered.state.append_slots.len() > 0) {
        rejectLocalCapture(function, "a local callback requires a checked exit and cannot append to an array")?
    }
    next = lowered.state
    symbol = "ku_local_callback_" + str(id)
    type = LinkedCheckedResultCType(thunk.result)?
    keep = LinkedNullResultCleanupReference(next.owning_layouts, thunk.result)
    char_errors = ""
    if (next.uses_chars) { char_errors = ManagedSourceCharactersErrors() }
    next.callback_helpers += "\ntypedef struct {" + thunk.fields.clone() + " } " + thunk.environment.clone() + ";\nstatic "
        + FinishLinkedFunctionC("", next, symbol, "void *raw, int64_t a0, int64_t a1", type, keep, char_errors)

    // Dependencies, layouts and C helpers are translation-unit requirements.
    // Bindings and failure cleanup below the thunk belong solely to it.
    next.slots = parent.slots.clone()
    next.code = parent.code.clone()
    next.drops = parent.drops.clone()
    next.local_readers = parent.local_readers.clone()
    next.local_callbacks = parent.local_callbacks.clone()
    next.callback_owners = parent.callback_owners.clone()
    next.append_slots = parent.append_slots.clone()
    next.plain_value_result = parent.plain_value_result
    next.catch_slot = parent.catch_slot
    next.catch_edges = parent.catch_edges
    next.catch_moved = parent.catch_moved.clone()
    next.moved_error_fields = parent.moved_error_fields.clone()
    for owner in thunk.owners.clone() {
        if (!ContainsIndex(next.callback_owners, owner)) { next.callback_owners = next.callback_owners.push(owner) }
    }
    callback = thunk.result.clone()
    callback.declaration_kind = "IntPairResultCallback"
    carrier = LinkedNullCType(callback)?
    frame = "environment" + str(id)
    descriptor = "callback" + str(id)
    next.declarations = parent.declarations.clone() + "    " + thunk.environment.clone() + " " + frame.clone() + " = {0};\n"
        + "    " + carrier.clone() + " " + descriptor.clone() + " = {0};\n"
    next.code += "    " + frame.clone() + " = (" + thunk.environment.clone() + "){" + thunk.initializers.clone() + " };\n"
        + "    " + descriptor.clone() + " = (" + carrier + "){" + symbol + ", &" + frame + "};\n"
        + "    (void)" + descriptor.clone() + ";\n"
    return ok(bindLinkedLocalCallback(next, function.text.clone(), callback, descriptor))
}

fn LowerLinkedLocalAlias(&project: LinkedNullProject, state: LinkedNullState, &statement: Node): LinkedNullState! {
    ty = LinkedNullParameterType(project, 1, LinkedNullChild(project, 1, statement, 0), false)?
    source = LinkedNullNode(project, 1, LinkedNullChild(project, 1, statement, 1))
    index = LinkedNullBinding(state.slots, source.text)
    if (source.kind != "Variable" || !ContainsIndex(state.local_callbacks, index) ||
        !state.slots[index - 1].live || !SameLinkedType(ty, state.slots[index - 1].value.ty) ||
        LinkedNullBinding(state.slots, statement.text) > 0) {
        rejectLocalCapture(statement, "a local callback alias requires a live local thunk with the declared checked signature")?
    }
    descriptor = state.slots[index - 1].value.text.clone()
    return ok(bindLinkedLocalCallback(state, statement.text.clone(), ty, descriptor))
}

fn LowerLinkedPredicate(&project: LinkedNullProject, state: LinkedNullState, id: int): LinkedNullExpression! {
    node = LinkedNullNode(project, 1, id)
    equality = node.text == "==" || node.text == "!="
    if (node.kind != "Binary" || node.edge_count != 2 || !equality) {
        return LowerLinkedNullRead(project, state, id, 0)
    }
    left_id = LinkedNullChild(project, 1, node, 0)
    if (LinkedNullNode(project, 1, left_id).kind != "TryUnwrap") {
        return LowerLinkedNullRead(project, state, id, 0)
    }
    before = state.slots.len()
    left = LowerLinkedNullValue(project, state, left_id, 0)?
    right = LowerLinkedNullRead(project, left.state, LinkedNullChild(project, 1, node, 1), 0)?
    at = DeclarationSpan(node)
    if (!LinkedStringResult(left.value.ty) || !LinkedStringResult(right.value.ty)) {
        RejectLayout("linked_checked_comparison", "expected a checked str and a readonly str", at.clone())?
    }
    compare = "ku_guard_string_equal(" + left.value.text + ", " + right.value.text + ")"
    if (node.text == "!=") { compare = "!" + compare }
    name = "predicate" + str(id)
    right.state.uses_string_equal = true
    right.state.code += "    const bool " + name.clone() + " = " + compare + ";\n"
    done = DropLinkedNullScope(right.state, before)
    return ok(LinkedReadonlyExpression(done, LinkedBuiltin("bool", at), name))
}

fn linkedCharacterSource(&project: LinkedNullProject, &state: LinkedNullState, &statement: Node): int! {
    at = DeclarationSpan(statement)
    call = LinkedNullNode(project, 1, LinkedNullChild(project, 1, statement, 0))
    if (call.kind == "Call" && call.edge_count == 2) {
        method = LinkedNullNode(project, 1, LinkedNullChild(project, 1, call, 0))
        if (method.kind == "Field" && method.text == "chars" && method.edge_count == 1) {
            namespace = LinkedNullNode(project, 1, LinkedNullChild(project, 1, method, 0))
            if (namespace.kind == "Variable" && namespace.edge_count == 0 &&
                LinkedNullBinding(state.slots, namespace.text) == 0) {
                for binding in project.binding.modules[0].imports.clone() {
                    if (binding.local_name == namespace.text && binding.module_index == 0 && binding.source_name == "string") {
                        return ok(LinkedNullChild(project, 1, call, 1))
                    }
                }
            }
        }
    }
    RejectLayout("unsupported_linked_for", "expected one argument to the bound std.string.chars", at)?
    return ok(0)
}

fn openLinkedCharacterLoop(&project: LinkedNullProject, state: LinkedNullState, &statement: Node, id: int, depth: int): LinkedForLoop! {
    at = DeclarationSpan(statement)
    if (statement.edge_count == 0 || depth >= 32) {
        RejectLayout("linked_control_depth", "expected a finite For within the linked control depth", at.clone())?
    }
    if (LinkedNullBinding(state.slots, statement.text) != 0) {
        RejectLayout("linked_binding_shadowed", "character iteration requires a fresh local binding", at.clone())?
    }
    before = state.slots.len()
    source = linkedCharacterSource(project, state, statement)?
    input = LowerLinkedNullValue(project, state, source, 0)?
    if (!LinkedStringResult(input.value.ty)) {
        RejectLayout("linked_chars_type", "string.chars requires a str input", input.value.ty.span.clone())?
    }

    ty = LinkedBuiltin("str", at.clone())
    array_type = ty.clone()
    array_type.declaration_kind = "OwnedStringArray"
    suffix = str(id) + "_chars"
    items = AddLinkedNullSlot(project, input.state, "", "a" + suffix.clone(), array_type, false)?
    array = items.value.text.clone()
    items.state.uses_chars = true
    items.state.slots[items.value.slot - 1].live = true
    items.state.code += "    source_status = ku_managed_source_chars(" + input.value.text + ", &" + array.clone() + ");\n"
        + "    if (source_status != KU_SOURCE_OK) goto cleanup;\n"
    outer = items.state.slots.clone()
    item = AddLinkedNullSlot(project, items.state, statement.text.clone(), "t" + suffix.clone(), ty, false)?
    item.state.slots[item.value.slot - 1].live = true
    name = item.value.text.clone()
    index = "i" + suffix
    source_item = array.clone() + ".data[" + index.clone() + "]"
    // The array is freshly materialized and holds independent strings. Move
    // each element into its iteration's slot before user code can fail.
    item.state.code += "    for (size_t " + index.clone() + " = 0; " + index.clone() + " < "
        + array + ".len; ++" + index + ") {\n"
        + "    " + name + " = " + source_item.clone() + ";\n"
        + "    " + source_item + " = (KuProjectionString){0};\n"
    return ok(LinkedForLoop { state: item.state, outer: outer, before: before })
}

fn openLinkedIntLoop(&project: LinkedNullProject, state: LinkedNullState, &statement: Node,
                      &source: LinkedNullSlot, id: int, depth: int): LinkedForLoop! {
    at = DeclarationSpan(statement)
    if (depth >= 32 || LinkedNullBinding(state.slots, statement.text) != 0) {
        RejectLayout("linked_int_for_scope", "integer-array iteration needs a fresh local binding within the control bound", at.clone())?
    }
    if (!source.live || source.value.borrowed) {
        RejectLayout("linked_int_for_source", "iteration requires an initialized owned [int] array", at.clone())?
    }
    before = state.slots.len()
    suffix = str(id) + "_ints"
    snapshot = AddLinkedNullSlot(project, state, "", "a" + suffix.clone(), source.value.ty.clone(), false)?
    array = snapshot.value.text.clone()
    input = "source" + suffix.clone()
    count = "count" + suffix.clone()
    // The source binding can grow or be replaced in the loop body. Only
    // this checked Copy buffer is read by the iteration.
    snapshot.state = RequireLinkedArrayValidation(snapshot.state, source.value.ty.clone())
    snapshot.state.uses_int_snapshot = true
    snapshot.state.slots[snapshot.value.slot - 1].live = true
    snapshot.state.code += "    const KuArrayInt *const " + input.clone() + " = &" + source.value.text.clone() + ";\n"
    snapshot.state.code += "    if (!ku_linked_view_int_array_valid(" + input.clone() + ") || " + input.clone()
        + "->len > SIZE_MAX / sizeof(int64_t)) { invalid_array = true; goto cleanup; }\n"
    snapshot.state.code += "    const size_t " + count.clone() + " = " + input.clone() + "->len;\n"
    snapshot.state.code += "    if (" + count.clone() + ") {\n"
        + "        int64_t *copy = malloc(" + count.clone() + " * sizeof(*copy));\n"
        + "        if (!copy) { out_of_memory = true; goto cleanup; }\n"
    snapshot.state.code += "        memcpy(copy, " + input + "->data, " + count.clone() + " * sizeof(*copy));\n"
    snapshot.state.code += "        " + array.clone() + " = (KuArrayInt){" + count.clone() + ", copy, " + count + "};\n    }\n"
    outer = snapshot.state.slots.clone()
    item = AddLinkedNullSlot(project, snapshot.state, statement.text.clone(), "t" + suffix.clone(), LinkedBuiltin("int", at), false)?
    item.state.slots[item.value.slot - 1].live = true
    index = "i" + suffix
    item.state.code += "    for (size_t " + index.clone() + " = 0; " + index.clone() + " < "
        + array.clone() + ".len; ++" + index.clone() + ") {\n"
        + "    " + item.value.text + " = " + array + ".data[" + index + "];\n"
    return ok(LinkedForLoop { state: item.state, outer: outer, before: before })
}

fn OpenLinkedForLoop(&project: LinkedNullProject, state: LinkedNullState, &statement: Node, id: int, depth: int): LinkedForLoop! {
    if (statement.edge_count != 0) {
        source_id = LinkedNullChild(project, 1, statement, 0)
        source = LinkedNullNode(project, 1, source_id)
        if (source.kind == "TryUnwrap") {
            return OpenLinkedCheckedRecordFor(project, state, statement, source_id, id, depth)
        }
        if (source.kind == "Variable" && source.edge_count == 0) {
            slot = LinkedNullBinding(state.slots, source.text)
            if (slot != 0) {
                input = state.slots[slot - 1].clone()
                if (LinkedNullIntArrayOwner(input.value.ty)) { return openLinkedIntLoop(project, state, statement, input, id, depth) }
                if (input.value.ty.declaration_kind == "BuiltinArray" && input.value.ty.name == "int") {
                    RejectLayout("linked_int_for_borrowed", "borrowed integer arrays cannot be iterated as owners", DeclarationSpan(source))?
                }
            }
        }
    }
    return openLinkedCharacterLoop(project, state, statement, id, depth)
}

fn CloseLinkedForLoop(loop: LinkedNullRegion, &outer: [LinkedNullSlot], before: int, &statement: Node): LinkedNullState! {
    body = loop
    if (body.terminal) {
        body.state = RestoreLinkedNullSlots(body.state, outer)
    } else {
        PreserveLinkedOwners(outer, body.state.slots, statement)?
        body.state = DropLinkedNullScope(body.state, outer.len())
    }
    body.state.code += "    }\n"
    return ok(DropLinkedNullScope(body.state, before))
}

fn ValidLinkedCountedStart(&project: LinkedNullProject, &state: LinkedNullState, id: int, slot: int, named_bound: bool): bool {
    initial = LinkedNullNode(project, 1, id)
    if (initial.kind == "Int" && initial.edge_count == 0 && initial.int_value == 0) { return true }
    if (!named_bound) { return false }
    if (initial.kind == "Binary" && initial.text == "+" && initial.edge_count == 2) {
        offset = LinkedNullNode(project, 1, LinkedNullChild(project, 1, initial, 1))
        if (offset.kind != "Int" || offset.edge_count != 0 || offset.int_value < 0) { return false }
        initial = LinkedNullNode(project, 1, LinkedNullChild(project, 1, initial, 0))
    }
    input = LinkedLiveIntBinding(state, initial)
    return input > 0 && input != slot
}
