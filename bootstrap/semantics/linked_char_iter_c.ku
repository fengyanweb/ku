import { LinkedCharacterSource, LinkedOwnedStringPredicate, MaterializeLinkedCharacters } from "./struct_string_calls.ku"
import { LinkedWhileCondition } from "./project_struct_string_c.ku"
import { Node } from "../stage2/ast.ku"
import { DeclarationSpan } from "./names.ku"
import { RejectLayout } from "./struct_layouts.ku"
import { BindLinkedLocalCallback, LinkedNullBinding, LinkedNullExpression, LinkedNullIntArrayOwner, LinkedNullOwnedArray, LinkedNullRegion, LinkedNullSlot, LinkedNullState, LinkedNullValue,
    LinkedReadonlyExpression, PreserveLinkedOwners, RestoreLinkedNullSlots } from "./link_plan_c.ku"
import { LinkedBuiltin, LinkedCheckedResultCType, LinkedIntResult, LinkedNullResultCleanupReference, LinkedNullChild, LinkedNullCType, LinkedNullNode,
    LinkedNullParameterType, LinkedNullProject, LinkedNullType, LinkedStringResult,
    ReadLinkedOwnedArray, ReadLinkedResult, SameLinkedType } from "./linked_null_types_c.ku"
import { AddLinkedNullSlot, CheckLinkedUnitDecrement, CloneLinkedIntArray, RegisterLinkedNullType } from "./linked_parameters_c.ku"
import { DropLinkedNullScope, LinkedIncreasingGuard, LinkedLiveIntBinding, RejectLinkedLoopWrite, RejectLinkedWriteRange } from "./linked_member_ownership.ku"
import { LowerLinkedNullValue } from "./linked_null_values_c.ku"
import { LowerLinkedNullRead } from "./linked_null_read_c.ku"
import { ContainsIndex, ProjectionCloneSource } from "./struct_projection_c.ku"
import { TypeNameBinding } from "./type_names.ku"
import { FinishLinkedFunctionC } from "./guarded_struct_c.ku"
import { ManagedSourceCharactersErrors } from "./guarded_string_parts.ku"
import { RestoreLinkedThunkFrame, StartLinkedThunkFrame } from "./link_plan_json_c.ku"
import { LinkedForLoop, OpenLinkedBooleanWhile, OpenLinkedRecordForLoop, ReadLinkedLocalCaptures, RejectLocalCapture, StoreLinkedCopyAssignment } from "./linked_owner_assignment_c.ku"

struct LinkedLocalThunk {
    result: TypeNameBinding
    owners: [int]
    environment: str
    fields: str
    initializers: str
}

struct LinkedLocalBody {
    state: LinkedNullState
    thunk: LinkedLocalThunk
}

fn ReadLinkedLocalThunk(&project: LinkedNullProject, &parent: LinkedNullState,
                        &function: Node, id: int): LinkedLocalBody! {
    body = StartLinkedThunkFrame(parent)
    for index in [0, 1] {
        parameter = LinkedNullNode(project, 1, LinkedNullChild(project, 1, function, index))
        if (parameter.kind != "Parameter" || parameter.edge_count != 1 || parameter.int_value != 0 ||
            LinkedNullBinding(body.slots, parameter.text) > 0) {
            RejectLocalCapture(parameter, "a local callback needs two distinct typed Copy int parameters")?
        }
        ty = LinkedNullType(project, 1, LinkedNullChild(project, 1, parameter, 0))?
        if (!LinkedIntResult(ty)) { RejectLocalCapture(parameter, "a local callback requires Copy int parameters")? }
        bound = AddLinkedNullSlot(project, body, parameter.text, "a" + str(index), ty, true)?
        body = bound.state
        body.code += "    (void)" + bound.value.text + ";\n"
    }
    result = ReadLinkedResult(project, 1, LinkedNullChild(project, 1, function, 2), true)?
    if (result.declaration_kind != "Struct") { RejectLocalCapture(function, "a local callback requires a checked named result")? }
    body = RegisterLinkedNullType(project, body, result.clone())?
    environment = "ku_local_environment_" + str(id)
    body.code += "    " + environment.clone() + " *capture = raw;\n    (void)capture;\n"
    fields = ""
    initializers = ""
    owners: [int] = []
    captures = ReadLinkedLocalCaptures(project, parent, function, id, 3)?
    for index in captures.slots {
        outer = parent.slots[index - 1].clone()
        owned_array = LinkedNullOwnedArray(outer.value.ty)
        array_view = owned_array || outer.value.ty.declaration_kind == "StructArray"
        copy = outer.value.ty.declaration_kind == "Builtin" && (outer.value.ty.name == "int" || outer.value.ty.name == "bool")
        if (!outer.live || outer.moved_members.len() > 0 || (!copy && !array_view)) {
            RejectLocalCapture(function, "local capture requires a live Copy scalar or readonly named array owner")?
        }
        ty = outer.value.ty.clone()
        if (array_view) { ty.declaration_kind = "StructArray" }
        field = "c" + str(index)
        text = "capture->" + field.clone()
        initializer = outer.value.text.clone()
        if (copy || owned_array) { initializer = "&(" + initializer + ")" }
        typedef = LinkedNullCType(ty)?
        if (copy) {
            typedef += " *"
            text = "(*" + text + ")"
        }
        if (owned_array) { owners = owners.push(index) }
        fields += " " + typedef + " " + field.clone() + ";"
        initializers += " ." + field + " = " + initializer + ","
        outer.value.ty = ty
        outer.value.text = text
        outer.value.slot = body.slots.len() + 1
        outer.value.borrowed = array_view
        outer.parameter = true
        body.slots = body.slots.push(outer)
    }
    if (fields == "") {
        fields = " bool active;"
        initializers = " .active = true,"
    }
    thunk = LinkedLocalThunk { result: result, owners: owners, environment: environment,
        fields: fields, initializers: initializers }
    return ok(LinkedLocalBody { state: body, thunk: thunk })
}

fn FinishLinkedLocalThunk(&parent: LinkedNullState, &thunk: LinkedLocalThunk,
                          lowered: LinkedNullRegion, &function: Node, id: int): LinkedNullState! {
    if (!lowered.terminal || lowered.state.append_slots.len() > 0) {
        RejectLocalCapture(function, "a local callback requires a checked exit and cannot append to an array")?
    }
    next = lowered.state
    symbol = "ku_local_callback_" + str(id)
    type = LinkedCheckedResultCType(thunk.result)?
    keep = LinkedNullResultCleanupReference(next.owning_layouts, thunk.result)
    char_errors = ""
    if (next.uses_chars) { char_errors = ManagedSourceCharactersErrors() }
    next.callback_helpers += "\ntypedef struct {" + thunk.fields.clone() + " } " + thunk.environment.clone() + ";\nstatic "
        + FinishLinkedFunctionC("", next, symbol, "void *raw, int64_t a0, int64_t a1", type, keep, char_errors, "")

    next = RestoreLinkedThunkFrame(next, parent)
    count = thunk.owners.len()
    cursor = 0
    while (cursor < count) {
        owner = thunk.owners[cursor]
        if (!ContainsIndex(next.callback_owners, owner)) { next.callback_owners = next.callback_owners.push(owner) }
        cursor = cursor + 1
    }
    callback = thunk.result.clone()
    callback.declaration_kind = "IntPairResultCallback"
    carrier = LinkedNullCType(callback)?
    frame = "environment" + str(id)
    descriptor = "callback" + str(id)
    next.declarations = parent.declarations.clone() + "    " + thunk.environment.clone() + " " + frame.clone() + " = {0};\n"
        + "    " + carrier.clone() + " " + descriptor.clone() + " = {0};\n"
    next.code += "    " + frame.clone() + " = (" + thunk.environment.clone() + "){" + thunk.initializers.clone() + " };\n"
        + "    " + descriptor.clone() + " = (" + carrier + "){" + symbol + ", &" + frame + "};\n"
        + "    (void)" + descriptor.clone() + ";\n"
    return ok(BindLinkedLocalCallback(next, function.text.clone(), callback, descriptor))
}

fn LowerLinkedLocalAlias(&project: LinkedNullProject, state: LinkedNullState, &statement: Node): LinkedNullState! {
    ty = LinkedNullParameterType(project, 1, LinkedNullChild(project, 1, statement, 0), false)?
    source = LinkedNullNode(project, 1, LinkedNullChild(project, 1, statement, 1))
    index = LinkedNullBinding(state.slots, source.text)
    if (source.kind != "Variable" || !ContainsIndex(state.local_callbacks, index) ||
        !state.slots[index - 1].live || !SameLinkedType(ty, state.slots[index - 1].value.ty) ||
        LinkedNullBinding(state.slots, statement.text) > 0) {
        RejectLocalCapture(statement, "a local callback alias requires a live local thunk with the declared checked signature")?
    }
    descriptor = state.slots[index - 1].value.text.clone()
    return ok(BindLinkedLocalCallback(state, statement.text.clone(), ty, descriptor))
}

fn LowerLinkedPredicate(&project: LinkedNullProject, state: LinkedNullState, id: int): LinkedNullExpression! {
    node = LinkedNullNode(project, 1, id)
    invocation = node.kind == "TryUnwrap"
    if (!invocation) { invocation = LinkedOwnedStringPredicate(project, state, node)? }
    if (invocation) {
        before = state.slots.len()
        value = LowerLinkedNullValue(project, state, id, 0)?
        result = value.value
        if (result.ty.declaration_kind != "Builtin" || result.ty.name != "bool") {
            RejectLayout("linked_guard_type", "expected a bool condition", DeclarationSpan(node))?
        }
        done = DropLinkedNullScope(value.state, before)
        return ok(LinkedReadonlyExpression(done, result.ty, result.text))
    }
    equality = node.text == "==" || node.text == "!="
    if (node.kind != "Binary" || node.edge_count != 2 || !equality) {
        return LowerLinkedNullRead(project, state, id, 0)
    }
    left_id = LinkedNullChild(project, 1, node, 0)
    checked = project.supplied[0].named.parsed.arena.nodes[left_id - 1].kind == "TryUnwrap"
    if (!checked && ProjectionCloneSource(project.supplied[0].named.parsed.arena.nodes,
        project.supplied[0].named.parsed.arena.edges, left_id) == 0) {
        return LowerLinkedNullRead(project, state, id, 0)
    }
    before = state.slots.len()
    left = LowerLinkedNullValue(project, state, left_id, 0)?
    right = LowerLinkedNullRead(project, left.state, LinkedNullChild(project, 1, node, 1), 0)?
    at = DeclarationSpan(node)
    if (!LinkedStringResult(left.value.ty) || !LinkedStringResult(right.value.ty)) {
        if (!checked) {
            RejectLayout("linked_cloned_comparison", "expected a cloned str and a readonly str", at.clone())?
        }
        RejectLayout("linked_checked_comparison", "expected a checked str and a readonly str", at.clone())?
    }
    compare = "ku_guard_string_equal(" + left.value.text + ", " + right.value.text + ")"
    if (node.text == "!=") { compare = "!" + compare }
    name = "predicate" + str(id)
    right.state.uses_string_equal = true
    right.state.code += "    const bool " + name.clone() + " = " + compare + ";\n"
    done = DropLinkedNullScope(right.state, before)
    return ok(LinkedReadonlyExpression(done, LinkedBuiltin("bool", at), name))
}

fn LowerLinkedCharacterLocal(&project: LinkedNullProject, state: LinkedNullState, &statement: Node,
                             id: int, source: int): LinkedNullState! {
    ty = ReadLinkedOwnedArray(project, 1, LinkedNullChild(project, 1, statement, 0), true, true)?
    if (ty.declaration_kind != "OwnedStringArray") {
        RejectLayout("linked_local_type", "string.chars initializes only a str array", ty.span.clone())?
    }
    if (LinkedNullBinding(state.slots, statement.text) != 0) {
        RejectLayout("linked_array_local", "expected a new typed array owner", DeclarationSpan(statement))?
    }
    input = LowerLinkedNullValue(project, state, source, 0)?
    items = MaterializeLinkedCharacters(project, input, "l" + str(id), statement.text.clone())?
    return ok(items.state)
}

fn openLinkedCharacterLoop(&project: LinkedNullProject, state: LinkedNullState, &statement: Node, id: int, depth: int): LinkedForLoop! {
    at = DeclarationSpan(statement)
    if (statement.edge_count == 0 || depth >= 32) {
        RejectLayout("linked_control_depth", "expected a finite For within the linked control depth", at.clone())?
    }
    if (LinkedNullBinding(state.slots, statement.text) != 0) {
        RejectLayout("linked_binding_shadowed", "character iteration requires a fresh local binding", at.clone())?
    }
    before = state.slots.len()
    source = LinkedCharacterSource(project, state, LinkedNullChild(project, 1, statement, 0), false)
    if (source == 0) {
        RejectLayout("unsupported_linked_for", "expected one argument to the bound std.string.chars", at.clone())?
    }
    input = LowerLinkedNullValue(project, state, source, 0)?
    suffix = str(id) + "_chars"
    items = MaterializeLinkedCharacters(project, input, "a" + suffix.clone(), "")?
    array = items.value.text.clone()
    ty = LinkedBuiltin("str", at)
    outer = items.state.slots.clone()
    item = AddLinkedNullSlot(project, items.state, statement.text.clone(), "t" + suffix.clone(), ty, false)?
    item.state.slots[item.value.slot - 1].live = true
    name = item.value.text.clone()
    index = "i" + suffix
    source_item = array.clone() + ".data[" + index.clone() + "]"
    // The array is freshly materialized and holds independent strings. Move
    // each element into its iteration's slot before user code can fail.
    item.state.code += "    for (size_t " + index.clone() + " = 0; " + index.clone() + " < "
        + array + ".len; ++" + index + ") {\n"
        + "    " + name + " = " + source_item.clone() + ";\n"
        + "    " + source_item + " = (KuProjectionString){0};\n"
    return ok(LinkedForLoop { state: item.state, outer: outer, before: before })
}

fn openLinkedIntLoop(&project: LinkedNullProject, state: LinkedNullState, &statement: Node,
                      slot: int, id: int, depth: int): LinkedForLoop! {
    at = DeclarationSpan(statement)
    if (depth >= 32 || LinkedNullBinding(state.slots, statement.text) != 0) {
        RejectLayout("linked_int_for_scope", "integer-array iteration needs a fresh local binding within the control bound", at.clone())?
    }
    if (!state.slots[slot - 1].live || state.slots[slot - 1].value.borrowed) {
        RejectLayout("linked_int_for_source", "iteration requires an initialized owned [int] array", at.clone())?
    }
    before = state.slots.len()
    suffix = str(id) + "_ints"
    // The source binding can grow or be replaced in the loop body.
    value = state.slots[slot - 1].value.clone()
    input = LinkedNullExpression { state: state, value: value }
    snapshot = CloneLinkedIntArray(project, input, "a" + suffix.clone())?
    array = snapshot.value.text.clone()
    outer = snapshot.state.slots.clone()
    item = AddLinkedNullSlot(project, snapshot.state, statement.text.clone(), "t" + suffix.clone(), LinkedBuiltin("int", at), false)?
    item.state.slots[item.value.slot - 1].live = true
    index = "i" + suffix
    item.state.code += "    for (size_t " + index.clone() + " = 0; " + index.clone() + " < "
        + array.clone() + ".len; ++" + index.clone() + ") {\n"
        + "    " + item.value.text + " = " + array + ".data[" + index + "];\n"
    return ok(LinkedForLoop { state: item.state, outer: outer, before: before })
}

fn OpenLinkedForLoop(&project: LinkedNullProject, state: LinkedNullState, &statement: Node, id: int, depth: int): LinkedForLoop! {
    if (statement.edge_count != 0) {
        source_id = LinkedNullChild(project, 1, statement, 0)
        source = LinkedNullNode(project, 1, source_id)
        if (source.kind == "Field" || source.kind == "TryUnwrap" || (source.kind == "Call" && ProjectionCloneSource(
            project.supplied[0].named.parsed.arena.nodes, project.supplied[0].named.parsed.arena.edges, source_id) != 0)) {
            return OpenLinkedRecordForLoop(project, state, statement, source_id, id, depth)
        }
        if (source.kind == "Variable" && source.edge_count == 0) {
            slot = LinkedNullBinding(state.slots, source.text)
            if (slot != 0) {
                if (LinkedNullOwnedArray(state.slots[slot - 1].value.ty)) {
                    return OpenLinkedRecordForLoop(project, state, statement, source_id, id, depth)
                }
                if (LinkedNullIntArrayOwner(state.slots[slot - 1].value.ty)) {
                    return openLinkedIntLoop(project, state, statement, slot, id, depth)
                }
                if (state.slots[slot - 1].value.ty.declaration_kind == "BuiltinArray" && state.slots[slot - 1].value.ty.name == "int") {
                    RejectLayout("linked_int_for_borrowed", "borrowed integer arrays cannot be iterated as owners", DeclarationSpan(source))?
                }
            }
        }
    }
    return openLinkedCharacterLoop(project, state, statement, id, depth)
}

fn OpenLinkedConditionalWhile(&project: LinkedNullProject, state: LinkedNullState, &statement: Node,
                              condition: LinkedWhileCondition, depth: int): LinkedForLoop! {
    if (condition.conjunction == 0) { return OpenLinkedBooleanWhile(state, statement, condition.local, depth) }
    opened = OpenLinkedBooleanWhile(state, statement, "true", depth)?
    // Emit the checked, short-circuit reads inside the loop, before each
    // entry into the body, so they observe the just-updated cursor.
    tested = LowerLinkedNullRead(project, opened.state, condition.conjunction, 0)?
    if (tested.value.ty.declaration_kind != "Builtin" || tested.value.ty.name != "bool") {
        RejectLayout("linked_while_condition", "while requires a readonly bool condition", tested.value.ty.span.clone())?
    }
    tested.state.code += "    if (!(" + tested.value.text + ")) break;\n"
    body = tested.state
    return ok(LinkedForLoop { state: body, outer: opened.outer, before: opened.before })
}

fn CloseLinkedForLoop(loop: LinkedNullRegion, &outer: [LinkedNullSlot], before: int, &statement: Node): LinkedNullState! {
    terminal = loop.terminal
    state = loop.state
    if (terminal) {
        state = RestoreLinkedNullSlots(state, outer)
    } else {
        PreserveLinkedOwners(outer, state.slots, statement)?
        state = DropLinkedNullScope(state, outer.len())
    }
    state.code += "    }\n"
    return ok(DropLinkedNullScope(state, before))
}

fn LinkedCountedInitial(&project: LinkedNullProject, &state: LinkedNullState, &region: Node,
                        &loop: Node, start: int, index: int): Node! {
    previous = LinkedNullChild(project, 1, region, index - 1)
    initial = LinkedNullNode(project, 1, previous)
    guard_id = LinkedNullChild(project, 1, loop, 0)
    guard = LinkedIncreasingGuard(project, loop)
    if (guard.kind != "Binary" || guard.text != "<" || guard.edge_count != 2) { return ok(initial) }
    bound = LinkedNullNode(project, 1, LinkedNullChild(project, 1, guard, 1))
    if (LinkedLiveIntBinding(state, bound) == 0) { return ok(initial) }
    cursor = LinkedNullNode(project, 1, LinkedNullChild(project, 1, guard, 0))
    if (LinkedLiveIntBinding(state, cursor) == 0 || (initial.kind == "Assign" && initial.text == cursor.text)) {
        return ok(initial)
    }

    // Only a preceding statement in the same lexical region can establish
    // the cursor. Nested statements may invalidate it rather than supply it.
    position = index - 2
    searching = position >= start
    while (searching) {
        id = LinkedNullChild(project, 1, region, position)
        candidate = LinkedNullNode(project, 1, id)
        if (candidate.kind == "Assign" && candidate.edge_count == 1 && candidate.text == cursor.text) {
            RejectLinkedWriteRange(project, id + 1, guard_id, cursor.text, "linked_loop_initial_write",
                "a counted loop cannot use an earlier cursor initializer after an intervening write")?
            return ok(candidate)
        }
        position = position - 1
        searching = position >= start
    }
    return ok(initial)
}

fn LinkedCountdownIndex(&project: LinkedNullProject, &state: LinkedNullState, &loop: Node, &step: Node): int! {
    guard = LinkedNullNode(project, 1, LinkedNullChild(project, 1, loop, 0))
    if (guard.kind != "Binary" || guard.text != ">" || guard.edge_count != 2) { return ok(0) }
    zero = LinkedNullNode(project, 1, LinkedNullChild(project, 1, guard, 1))
    if (zero.kind != "Int" || zero.int_value != 0 || zero.edge_count != 0) { return ok(0) }
    cursor = LinkedNullNode(project, 1, LinkedNullChild(project, 1, guard, 0))
    slot = LinkedLiveIntBinding(state, cursor)
    at = DeclarationSpan(step)
    if (slot == 0 || step.kind != "Assign" || step.edge_count != 1 || step.text != cursor.text) {
        RejectLayout("unsupported_linked_countdown", "countdown requires a live int cursor and its final assignment", at.clone())?
    }
    CheckLinkedUnitDecrement(project, step, cursor, at)?
    RejectLinkedLoopWrite(project, loop, cursor.text, "linked_loop_cursor_write", "countdown can change its cursor only at the end")?
    return ok(slot)
}

fn LowerLinkedCopyRebind(&project: LinkedNullProject, state: LinkedNullState, &assignment: Node, slot: int): LinkedNullState! {
    destination = state.slots[slot - 1].value.clone()
    live = state.slots[slot - 1].live
    id = LinkedNullChild(project, 1, assignment, 0)
    // A checked RHS branches to its existing Error continuation before
    // returning a value; only the successful path may write the binding.
    if (LinkedNullNode(project, 1, id).kind == "TryUnwrap") {
        return StoreLinkedCopyAssignment(destination, live, LowerLinkedNullValue(project, state, id, 0)?, assignment)
    }
    if (destination.ty.name == "bool") {
        return StoreLinkedCopyAssignment(destination, live, LowerLinkedPredicate(project, state, id)?, assignment)
    }
    return StoreLinkedCopyAssignment(destination, live, LowerLinkedNullRead(project, state, id, 0)?, assignment)
}
