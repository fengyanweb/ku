import { Node } from "../stage2/ast.ku"
import { DeclarationSpan } from "./names.ku"
import { TypeNameBinding, ScalarType } from "./type_names.ku"
import { EmitScalarStringJoinTo, ScalarIntParameter, ScalarStringPart } from "./scalar_int_emit.ku"
import { RejectScalarInt, ScalarParameterIndex, ScalarStringLiteral } from "./scalar_int_operands.ku"

fn isReplace(&nodes: [Node], &edges: [int], &value: Node): bool {
    if (value.kind != "Call" || value.edge_count == 0) { return false }
    callee = nodes[edges[value.first_edge] - 1].clone()
    return callee.kind == "Field" && callee.text == "replace" && callee.edge_count == 1
}

fn HasScalarOwnedStringBody(&nodes: [Node], &edges: [int], start: int, end: int): bool {
    first = nodes[edges[start] - 1].clone()
    if (first.kind == "Assign" || first.kind == "VarDecl") { return true }
    if (start + 1 != end || first.kind != "Return" || first.edge_count != 1) { return false }
    return isReplace(nodes, edges, nodes[edges[first.first_edge] - 1])
}

fn localIndex(&locals: [str], &name: str): int {
    index = 0
    while (index < locals.len()) {
        if (locals[index] == name) { return index }
        index = index + 1
    }
    return 0 - 1
}

fn namedOwner(&parameters: [ScalarIntParameter], &locals: [str], &moved: [str], &node: Node): str! {
    if (node.kind == "Variable" && node.edge_count == 0) {
        moved_index = localIndex(moved, node.text)
        if (moved_index >= 0) {
            RejectScalarInt("moved_scalar_string", "owned str was already consumed by an append", DeclarationSpan(node))?
        }
        local = localIndex(locals, node.text)
        if (local >= 0) { return ok("s" + str(local)) }
        parameter = ScalarParameterIndex(parameters, node.text)
        if (parameter >= 0 && parameters[parameter].string_mode == 1) { return ok("a" + str(parameter)) }
    }
    return ok("")
}

fn stringOperand(&parameters: [ScalarIntParameter], &locals: [str], &moved: [str], &node: Node): str! {
    if (node.kind == "String" && node.edge_count == 0) {
        return ok("(KuScalarString){(uint8_t*)" + ScalarStringLiteral(node)? + ", 0u, 0u}")
    }
    owner = namedOwner(parameters, locals, moved, node)?
    if (owner != "") { return ok(owner) }
    RejectScalarInt("unsupported_replace_operand", "expected an initialized str local, owned str parameter or str literal", DeclarationSpan(node))?
    return ok("")
}

fn emitReplace(&nodes: [Node], &edges: [int], &parameters: [ScalarIntParameter], &locals: [str], &moved: [str],
               &call: Node, &target: str): str! {
    replace = isReplace(nodes, edges, call)
    if (!replace || call.edge_count != 3) {
        RejectScalarInt("unsupported_replace_call", "expected str.replace with two str arguments", DeclarationSpan(call))?
    }
    callee = nodes[edges[call.first_edge] - 1].clone()
    receiver = stringOperand(parameters, locals, moved, nodes[edges[callee.first_edge] - 1])?
    needle = stringOperand(parameters, locals, moved, nodes[edges[call.first_edge + 1] - 1])?
    replacement = stringOperand(parameters, locals, moved, nodes[edges[call.first_edge + 2] - 1])?
    // All operands are read-only references or literals. Nothing is freed
    // before the new owner is complete, even when all inputs name the target.
    return ok("    {\n        KuScalarString next;\n        failure = ku_scalar_string_replace("
        + receiver + ", " + needle + ", " + replacement + ", &next);\n        if (failure) goto cleanup;\n"
        + "        ku_scalar_string_drop(" + target.clone() + ");\n        " + target.clone() + " = next;\n    }\n")
}

fn joinExpression(&node: Node): bool {
    return node.kind == "Binary" && node.text == "+" && node.edge_count == 2
}

fn ownerPart(&name: str): ScalarStringPart {
    return ScalarStringPart { source: name.clone() + ".ptr, " + name.clone() + ".len", integer: false }
}

fn joinParts(&nodes: [Node], &edges: [int], &parameters: [ScalarIntParameter], &locals: [str], &moved: [str],
             &value: Node, depth: int, parts: [ScalarStringPart]): [ScalarStringPart]! {
    if (depth >= 32) {
        RejectScalarInt("string_depth_limit", "standalone C string expressions accept at most 32 levels", DeclarationSpan(value))?
    }
    joined = joinExpression(value)
    if (joined) {
        left = joinParts(nodes, edges, parameters, locals, moved, nodes[edges[value.first_edge] - 1], depth + 1, parts)?
        return joinParts(nodes, edges, parameters, locals, moved, nodes[edges[value.first_edge + 1] - 1], depth + 1, left)
    }
    if (value.kind == "String" && value.edge_count == 0) {
        literal = ScalarStringLiteral(value)?
        part = ScalarStringPart { source: "(const uint8_t*)" + literal, integer: false }
        output: [ScalarStringPart] = parts
        output = output.push(part)
        return ok(output)
    }
    owner = namedOwner(parameters, locals, moved, value)?
    if (owner == "") {
        RejectScalarInt("unsupported_owned_string_operand", "expected a str literal or a live owned str binding", DeclarationSpan(value))?
    }
    part = ownerPart(owner)
    output: [ScalarStringPart] = parts
    output = output.push(part)
    return ok(output)
}

fn emitOwnedJoin(&parts: [ScalarStringPart], &target: str, &consumed: str): str {
    join = EmitScalarStringJoinTo(parts, "        ", "next")
    code = "    {\n        KuScalarString next;\n" + join.source + "        if (failure) goto cleanup;\n"
    if (consumed != "") {
        code += "        ku_scalar_string_drop(" + consumed.clone() + ");\n        " + consumed.clone() + " = (KuScalarString){0};\n"
    }
    return code + "        ku_scalar_string_drop(" + target.clone() + ");\n        " + target.clone() + " = next;\n    }\n"
}

fn ownedResult(&parameters: [ScalarIntParameter], &locals: [str], &moved: [str], &value: Node): str! {
    owner = namedOwner(parameters, locals, moved, value)?
    if (owner != "") {
        return ok("    result = " + owner.clone() + ";\n    " + owner + " = (KuScalarString){0};\n")
    }
    RejectScalarInt("unsupported_replace_return", "expected an owned str or a str.replace result", DeclarationSpan(value))?
    return ok("")
}

struct ScalarOwnedStringBody {
    source: str
    uses_join: bool
    uses_replace: bool
}

fn withoutMovedName(&moved: [str], &name: str): [str]! {
    rest: [str] = []
    index = 0
    while (index < moved.len()) {
        if (moved[index] != name) { rest = rest.push(moved[index].clone()) }
        index = index + 1
    }
    return ok(rest)
}

fn LowerScalarOwnedStringBody(&nodes: [Node], &edges: [int], &types: [TypeNameBinding],
                             &parameters: [ScalarIntParameter], start: int, end: int): ScalarOwnedStringBody! {
    locals: [str] = []
    moved: [str] = []
    uses_join = false
    uses_replace = false
    declarations = "    KuBootstrapString result = {0};\n    const char* failure = NULL;\n"
    code = ""
    drops = ""
    final_edge = end - 1
    cursor = start
    while (cursor < final_edge) {
        statement = nodes[edges[cursor] - 1].clone()
        if (statement.kind == "CompoundAssign" && statement.text == "+" && statement.edge_count == 2) {
            left = nodes[edges[statement.first_edge] - 1].clone()
            right = nodes[edges[statement.first_edge + 1] - 1].clone()
            target = namedOwner(parameters, locals, moved, left)?
            append_target = target != ""
            if (append_target) {
                target_local = localIndex(locals, left.text)
                append_target = target_local >= 0
            }
            if (!append_target) {
                RejectScalarInt("unsupported_owned_string_append", "expected a live owned str local before +=", DeclarationSpan(left))?
            }
            consumed = namedOwner(parameters, locals, moved, right)?
            if (consumed == target) {
                RejectScalarInt("moved_scalar_string", "cannot append a str local to itself by move", DeclarationSpan(right))?
            }
            part = ownerPart(target)
            prefix: [ScalarStringPart] = []
            prefix = prefix.push(part)
            parts = joinParts(nodes, edges, parameters, locals, moved, right, 0, prefix)?
            code += emitOwnedJoin(parts, target, consumed)
            if (consumed != "") {
                consumed_name = right.text
                moved = moved.push(consumed_name)
            }
            uses_join = true
        } else {
            explicit = statement.kind == "VarDecl" && statement.edge_count == 2
            if (!explicit && (statement.kind != "Assign" || statement.edge_count != 1)) {
                RejectScalarInt("unsupported_replace_statement", "expected a straight-line owned str assignment", DeclarationSpan(statement))?
            }
            local = localIndex(locals, statement.text)
            parameter = ScalarParameterIndex(parameters, statement.text)
            if (parameter >= 0 || (explicit && local >= 0)) {
                RejectScalarInt("unsupported_replace_binding", "expected a distinct str local", DeclarationSpan(statement))?
            }
            if (explicit) {
                type_id = edges[statement.first_edge]
                value_type = ScalarType(types, type_id, nodes[type_id - 1])
                if (value_type != 2) {
                    RejectScalarInt("unsupported_replace_binding", "explicit replacement locals require builtin str", DeclarationSpan(statement))?
                }
            }
            fresh = local < 0
            if (fresh) { local = locals.len() }
            target = "s" + str(local)
            value = nodes[edges[statement.first_edge + statement.edge_count - 1] - 1].clone()
            joined = joinExpression(value)
            if (joined) {
                initial_parts: [ScalarStringPart] = []
                parts = joinParts(nodes, edges, parameters, locals, moved, value, 0, initial_parts)?
                code += emitOwnedJoin(parts, target, "")
                uses_join = true
            } else {
                code += emitReplace(nodes, edges, parameters, locals, moved, value, target)?
                uses_replace = true
            }
            moved_index = localIndex(moved, statement.text)
            if (moved_index >= 0) { moved = withoutMovedName(moved, statement.text)? }
            if (fresh) {
                // The new name is not visible while lowering its initializer.
                binding = statement.text
                locals = locals.push(binding)
                declarations += "    KuScalarString " + target.clone() + " = {0};\n"
                drops = "    ku_scalar_string_drop(" + target + ");\n" + drops
            }
        }
        cursor = cursor + 1
    }
    final = nodes[edges[cursor] - 1].clone()
    if (final.kind != "Return" || final.edge_count != 1) {
        RejectScalarInt("unsupported_replace_return", "expected a final owned str return", DeclarationSpan(final))?
    }
    value = nodes[edges[final.first_edge] - 1].clone()
    joined = joinExpression(value)
    if (joined) {
        initial_parts: [ScalarStringPart] = []
        parts = joinParts(nodes, edges, parameters, locals, moved, value, 0, initial_parts)?
        code += emitOwnedJoin(parts, "result", "")
        uses_join = true
    } else {
        replace = isReplace(nodes, edges, value)
        if (replace) {
            code += emitReplace(nodes, edges, parameters, locals, moved, value, "result")?
            uses_replace = true
        } else {
            code += ownedResult(parameters, locals, moved, value)?
        }
    }
    return ok(ScalarOwnedStringBody { source: declarations + code + "cleanup:\n" + drops,
        uses_join: uses_join, uses_replace: uses_replace })
}

// Match Stage0's byte lengths and ownership. The helper publishes its output
// only on success so an allocation failure can unwind generated locals.
fn ScalarStringReplaceHelpers(): str {
    text = "#include <stdio.h>\n#include <string.h>\n\n"
    text += "static size_t ku_scalar_replace_chunk(KuScalarString s, size_t at) {\n"
    text += "    size_t next = at + 1;\n    while (next < s.len && (s.ptr[next] & 0xc0u) == 0x80u) ++next;\n"
    text += "    return next;\n}\n\n"
    text += "static int ku_scalar_replace_find(KuScalarString s, KuScalarString from, size_t i, size_t* at) {\n"
    text += "    if (from.len > s.len - i) return 0;\n    size_t last = s.len - from.len;\n"
    text += "    for (;; ++i) {\n        if (memcmp(s.ptr + i, from.ptr, from.len) == 0) { *at = i; return 1; }\n"
    text += "        if (i == last) return 0;\n    }\n}\n\n"
    text += "static const char* ku_scalar_replace_empty(KuScalarString s, KuScalarString to, KuScalarString* out) {\n"
    text += "    size_t chunks = 0;\n    for (size_t i = 0; i < s.len; i = ku_scalar_replace_chunk(s, i)) ++chunks;\n"
    text += "    if (chunks == SIZE_MAX || (to.len && chunks + 1 > (SIZE_MAX - s.len) / to.len))\n"
    text += "        return \"string replacement is too large\\n\";\n"
    text += "    size_t len = s.len + to.len * (chunks + 1);\n"
    text += "    if (len == 0) { *out = (KuScalarString){0}; return NULL; }\n"
    text += "    uint8_t* data = malloc(len);\n    if (!data) return \"out of memory\\n\";\n"
    text += "    size_t used = 0;\n    if (to.len) { memcpy(data, to.ptr, to.len); used += to.len; }\n"
    text += "    for (size_t i = 0; i < s.len;) {\n        size_t next = ku_scalar_replace_chunk(s, i);\n"
    text += "        memcpy(data + used, s.ptr + i, next - i); used += next - i;\n"
    text += "        if (to.len) { memcpy(data + used, to.ptr, to.len); used += to.len; }\n        i = next;\n    }\n"
    text += "    *out = (KuScalarString){data, len, len, 1u};\n    return NULL;\n}\n\n"
    text += "static const char* ku_scalar_string_replace(KuScalarString s, KuScalarString from, KuScalarString to, KuScalarString* out) {\n"
    text += "    if (from.len == 0) return ku_scalar_replace_empty(s, to, out);\n"
    text += "    size_t count = 0, at, i = 0;\n"
    text += "    while (ku_scalar_replace_find(s, from, i, &at)) { ++count; i = at + from.len; }\n"
    text += "    if (count == 0 && (s.storage == 0 || !s.ptr)) { *out = s.storage == 0 ? s : (KuScalarString){0}; return NULL; }\n"
    text += "    size_t kept = s.len - count * from.len;\n"
    text += "    if (to.len && count > (SIZE_MAX - kept) / to.len) return \"string replacement is too large\\n\";\n"
    text += "    size_t len = kept + count * to.len;\n"
    text += "    if (len == 0 && count != 0) { *out = (KuScalarString){0}; return NULL; }\n"
    text += "    size_t capacity = len ? len : 1u;\n"
    text += "    uint8_t* data = malloc(capacity);\n    if (!data) return \"out of memory\\n\";\n"
    text += "    size_t used = 0;\n    i = 0;\n"
    text += "    while (ku_scalar_replace_find(s, from, i, &at)) {\n"
    text += "        if (at > i) { memcpy(data + used, s.ptr + i, at - i); used += at - i; }\n"
    text += "        if (to.len) { memcpy(data + used, to.ptr, to.len); used += to.len; }\n        i = at + from.len;\n    }\n"
    text += "    if (s.len > i) memcpy(data + used, s.ptr + i, s.len - i);\n"
    return text + "    *out = (KuScalarString){data, len, capacity, 1u};\n    return NULL;\n}\n\n"
}
