import { Arena, Node } from "../stage2/ast.ku"
import { DeclarationSpan } from "./names.ku"
import { SuppliedModule } from "./imports.ku"
import { ProjectBindings } from "./project_bindings.ku"
import { GuardCType, GuardRead, GuardType, GuardValue } from "./guarded_struct_expr.ku"
import { OrderCStructLayouts } from "./nested_struct_c.ku"
import { ScalarFunctionNode } from "./scalar_int_calls.ku"
import { ScalarStringLiteral } from "./scalar_int_operands.ku"
import { ExplicitType, RejectLayout, StructLayout } from "./struct_layouts.ku"
import { BoundLinkPlanType, LinkedNullBinding, LinkedNullExpression, LinkedNullOwnedArray, LinkedNullState, LinkPlanDeclaration, LinkPlanType, NullLinkPlanResult } from "./link_plan_c.ku"
import { LinkedMemberUnavailable } from "./linked_member_ownership.ku"
import { AddLinkedNullSlot } from "./linked_parameters_c.ku"
import { LinkedBuiltin, LinkedIntResult, LinkedNullChild, LinkedNullNode, LinkedNullProject, LinkedNullView, LinkedStringResult, ResolveLinkedCall } from "./linked_null_types_c.ku"
import { TypeNameBindingWithKind } from "./type_names.ku"
import { FinishLinkedFieldRead, LowerLinkedNullRead, ReadLinkedArrayElementAfterBase } from "./linked_null_read_c.ku"

struct StructStringDependency {
    symbol: str
    module_index: int
    declaration: int
    source_name: str
    parameter: str
    argument_plan: LinkPlanType
    result_plan: LinkPlanType
}

struct StructStringTarget {
    unit: int
    node: int
    source_name: str
}

fn StructStringDependencyPlan(&dependency: StructStringDependency): LinkPlanDeclaration {
    return LinkPlanDeclaration { unit: dependency.module_index, node: dependency.declaration, symbol: dependency.symbol.clone(),
        parameters: [dependency.argument_plan.clone()], result: dependency.result_plan.clone(), returns_result: false }
}

fn importedFunctionIndex(&project: ProjectBindings, &name: str): int {
    index = 0
    while (index < project.modules[0].imports.len()) {
        if (project.modules[0].imports[index].local_name == name) { return index + 1 }
        index = index + 1
    }
    return 0
}

fn resolveStructStringTarget(&supplied: [SuppliedModule], &project: ProjectBindings, &target: Node): StructStringTarget! {
    if (target.kind != "Variable" || target.edge_count != 0) {
        RejectLayout("unsupported_struct_string_call", "expected a named direct string function", DeclarationSpan(target))?
    }
    index = importedFunctionIndex(project, target.text)
    if (index != 0) {
        link = project.modules[0].imports[index - 1].clone()
        if (link.module_index <= 0) {
            RejectLayout("unsupported_struct_string_call", "expected an explicit project module dependency", DeclarationSpan(target))?
        }
        return ok(StructStringTarget { unit: link.module_index, node: link.target_node, source_name: link.source_name })
    }
    node = ScalarFunctionNode(supplied[0].named.names.declarations, target.text)
    if (node == 0) {
        RejectLayout("unsupported_struct_string_call", "expected a named direct string function", DeclarationSpan(target))?
    }
    return ok(StructStringTarget { unit: 1, node: node, source_name: target.text.clone() })
}

// Both the declaration and the type identities are resolved in the callee's
// own module. A same-spelling local struct is not interchangeable with it.
fn BindStructStringCall(&supplied: [SuppliedModule], &project: ProjectBindings, &layouts: [StructLayout],
                        &target: Node, &argument: Node, &value: GuardValue, consume_element: bool): StructStringDependency! {
    link = resolveStructStringTarget(supplied, project, target)?
    module_slot = link.unit - 1
    function = supplied[module_slot].named.parsed.arena.nodes[link.node - 1].clone()
    if (function.kind != "Function" || function.edge_count < 3) {
        RejectLayout("struct_string_link_signature", "expected one typed argument and a str result", DeclarationSpan(target))?
    }
    parameter = supplied[module_slot].named.parsed.arena.nodes[supplied[module_slot].named.parsed.arena.edges[function.first_edge] - 1].clone()
    result_id = supplied[module_slot].named.parsed.arena.edges[function.first_edge + 1]
    returned = supplied[module_slot].named.parsed.arena.nodes[result_id - 1].clone()
    if (parameter.kind != "Parameter" || parameter.edge_count != 1 || parameter.int_value != 0 || returned.kind != "TypeName") {
        RejectLayout("struct_string_link_signature", "expected exactly one typed by-value argument and a str result", DeclarationSpan(target))?
    }
    type_id = supplied[module_slot].named.parsed.arena.edges[parameter.first_edge]
    declared = ExplicitType(project.modules[module_slot].types, type_id, DeclarationSpan(parameter))?
    result = ExplicitType(project.modules[module_slot].types, result_id, DeclarationSpan(returned))?
    projected = argument.kind == "Field"
    if (consume_element) { projected = argument.kind == "Variable" && value.ty.kind == "struct" }
    if (result.declaration_kind != "Builtin" || result.name != "str" || value.setup != "" || value.view || !projected) {
        RejectLayout("struct_string_link_argument", "expected a str return and one checked projected value", DeclarationSpan(argument))?
    }
    symbol = "ku_struct_string_link_m" + str(link.unit) + "_" + str(link.node)
    if (declared.declaration_kind == "Builtin" && declared.name == "str" && value.ty.kind == "str") {
        return ok(StructStringDependency { symbol: symbol,
            module_index: link.unit, declaration: link.node, source_name: link.source_name, parameter: "KuProjectionString",
            argument_plan: BoundLinkPlanType(declared, link.unit, "KuProjectionString", false),
            result_plan: BoundLinkPlanType(result, link.unit, "KuProjectionString", false) })
    }
    if (declared.declaration_kind == "Struct" && value.ty.kind == "struct") {
        layout = layouts[value.ty.layout - 1].clone()
        expected_module = declared.module_index
        if (expected_module == 0) { expected_module = link.unit }
        actual_module = layout.module_index
        if (actual_module == 0) { actual_module = 1 }
        if (expected_module == actual_module && declared.declaration_node == layout.node) {
            order = OrderCStructLayouts(layouts, layout.module_index, layout.node, DeclarationSpan(argument))?
            if (consume_element || !order.contains_string) {
                c_type = GuardCType(value.ty, layouts)
                return ok(StructStringDependency { symbol: symbol,
                    module_index: link.unit, declaration: link.node, source_name: link.source_name,
                    parameter: c_type.clone(), argument_plan: BoundLinkPlanType(declared, link.unit, c_type, false),
                    result_plan: BoundLinkPlanType(result, link.unit, "KuProjectionString", false) })
            }
        }
    }
    if (consume_element) {
        RejectLayout("struct_string_link_argument", "loop element must match the formatter's owned struct type", DeclarationSpan(argument))?
    }
    RejectLayout("struct_string_link_argument", "projected argument must match an owned str or the same Copy struct type", DeclarationSpan(argument))?
    return ok(StructStringDependency { symbol: "", module_index: 0, declaration: 0, source_name: "", parameter: "",
        argument_plan: NullLinkPlanResult(), result_plan: NullLinkPlanResult() })
}

struct StructStringFold {
    initial: str
    separator: str
    dependency: StructStringDependency
}

fn foldChild(&arena: Arena, &parent: Node, index: int): Node {
    return arena.nodes[arena.edges[parent.first_edge + index] - 1].clone()
}

fn foldNamed(&node: Node, &name: str): bool {
    return node.kind == "Variable" && node.edge_count == 0 && node.text == name
}

fn foldAppend(&arena: Arena, &statement: Node, &output: str): bool {
    if (statement.kind != "CompoundAssign" || statement.text != "+" || statement.edge_count != 2) { return false }
    return foldNamed(foldChild(arena, statement, 0), output)
}

fn rejectStringFold(&node: Node, message: str): null! {
    return RejectLayout("struct_string_fold_body", message, DeclarationSpan(node))
}

fn foldSeparator(&arena: Arena, &guard: Node, &output: str, &first: str): str! {
    if (guard.kind != "If" || guard.edge_count != 2 || guard.int_value != 1) {
        rejectStringFold(guard, "expected a first-element guard followed by one separator append")?
    }
    condition = foldChild(arena, guard, 0)
    append = foldChild(arena, guard, 1)
    if (condition.kind != "Unary" || condition.text != "!" || condition.edge_count != 1
        || !foldNamed(foldChild(arena, condition, 0), first) || !foldAppend(arena, append, output)) {
        rejectStringFold(guard, "expected the guard to append a separator except on the first element")?
    }
    value = foldChild(arena, append, 1)
    if (value.kind != "String" || value.edge_count != 0) {
        rejectStringFold(value, "expected a literal separator")?
    }
    return ScalarStringLiteral(value)
}

fn foldElementCall(&supplied: [SuppliedModule], &project: ProjectBindings, &layouts: [StructLayout],
                   &arena: Arena, &iteration: Node, &input: str, &output: str, &first: str, root: int): StructStringDependency! {
    line = foldChild(arena, iteration, 2)
    append = foldChild(arena, iteration, 3)
    next = foldChild(arena, iteration, 4)
    if (line.kind != "Assign" || line.edge_count != 1 || line.text == input || line.text == output
        || line.text == first || line.text == iteration.text || !foldAppend(arena, append, output)
        || !foldNamed(foldChild(arena, append, 1), line.text) || next.kind != "Assign"
        || next.edge_count != 1 || next.text != first) {
        rejectStringFold(iteration, "expected a formatted element, one append and the first-element update")?
    }
    advanced = foldChild(arena, next, 0)
    call = foldChild(arena, line, 0)
    if (advanced.kind != "Bool" || advanced.edge_count != 0 || advanced.text != "false"
        || call.kind != "Call" || call.edge_count != 2) {
        rejectStringFold(line, "expected a direct formatting call and first assigned false")?
    }
    target = foldChild(arena, call, 0)
    argument = foldChild(arena, call, 1)
    if (!foldNamed(argument, iteration.text) || target.text == input || target.text == output
        || target.text == first || target.text == iteration.text) {
        rejectStringFold(call, "expected a known formatter called with the owned loop element")?
    }
    value = GuardRead(GuardType { kind: "struct", layout: root }, "element", false)
    return BindStructStringCall(supplied, project, layouts, target, argument, value, true)
}

fn ReadStructStringFold(&supplied: [SuppliedModule], &project: ProjectBindings, &layouts: [StructLayout],
                        &arena: Arena, &function: Node, &param: Node, root: int): StructStringFold! {
    if (function.edge_count != 6) {
        rejectStringFold(function, "expected an initializer, first-element flag, consuming for and return")?
    }
    initial = foldChild(arena, function, 2)
    first = foldChild(arena, function, 3)
    iteration = foldChild(arena, function, 4)
    returned = foldChild(arena, function, 5)
    if (initial.kind != "Assign" || initial.edge_count != 1 || initial.text == param.text
        || first.kind != "Assign" || first.edge_count != 1 || first.text == param.text || first.text == initial.text
        || returned.kind != "Return" || returned.edge_count != 1
        || !foldNamed(foldChild(arena, returned, 0), initial.text)) {
        rejectStringFold(function, "expected distinct accumulator and first-element locals and a return of the accumulator")?
    }
    value = foldChild(arena, initial, 0)
    flag = foldChild(arena, first, 0)
    if (value.kind != "String" || value.edge_count != 0 || flag.kind != "Bool" || flag.edge_count != 0 || flag.text != "true") {
        rejectStringFold(initial, "expected a literal initial string and first assigned true")?
    }
    if (iteration.kind != "For" || iteration.edge_count != 5 || !foldNamed(foldChild(arena, iteration, 0), param.text)
        || iteration.text == param.text || iteration.text == initial.text || iteration.text == first.text) {
        rejectStringFold(iteration, "expected a consuming for over the owned array")?
    }
    separator = foldSeparator(arena, foldChild(arena, iteration, 1), initial.text, first.text)?
    call = foldElementCall(supplied, project, layouts, arena, iteration, param.text, initial.text, first.text, root)?
    return ok(StructStringFold { initial: ScalarStringLiteral(value)?, separator: separator, dependency: call })
}

fn LinkedCharacterSource(&project: LinkedNullProject, &state: LinkedNullState, id: int, method: bool): int {
    call = LinkedNullNode(project, 1, id)
    if (call.kind != "Call" || call.edge_count == 0) { return 0 }
    target = LinkedNullNode(project, 1, LinkedNullChild(project, 1, call, 0))
    if (target.kind != "Field" || target.text != "chars" || target.edge_count != 1) { return 0 }
    receiver_id = LinkedNullChild(project, 1, target, 0)
    receiver = LinkedNullNode(project, 1, receiver_id)
    local = receiver.kind == "Variable" && LinkedNullBinding(state.slots, receiver.text) != 0
    if (call.edge_count == 1 && method && (local || receiver.kind != "Variable")) { return receiver_id }
    if (call.edge_count == 2 && receiver.kind == "Variable" && !local) {
        count = project.binding.modules[0].imports.len()
        index = 0
        while (index < count) {
            if (project.binding.modules[0].imports[index].local_name == receiver.text &&
                project.binding.modules[0].imports[index].module_index == 0 &&
                project.binding.modules[0].imports[index].source_name == "string") {
                return LinkedNullChild(project, 1, call, 1)
            }
            index = index + 1
        }
    }
    return 0
}

fn MaterializeLinkedCharacters(&project: LinkedNullProject, input: LinkedNullExpression, name: str, binding: str): LinkedNullExpression! {
    if (!LinkedStringResult(input.value.ty)) {
        RejectLayout("linked_chars_type", "string.chars requires a str input", input.value.ty.span.clone())?
    }
    ty = TypeNameBindingWithKind(LinkedBuiltin("str", input.value.ty.span.clone()), "OwnedStringArray")
    output = AddLinkedNullSlot(project, input.state, binding, name, ty, false)?
    output.state.uses_chars = true
    output.state.slots[output.value.slot - 1].live = true
    output.state.code += "    source_status = ku_managed_source_chars(" + input.value.text + ", &" + output.value.text.clone() + ");\n"
        + "    if (source_status != KU_SOURCE_OK) goto cleanup;\n"
    return ok(output)
}

fn LinkedStringReplaceApplies(&project: LinkedNullProject, &state: LinkedNullState, &target: Node): bool {
    if (!state.plain_value_result || target.kind != "Field" || target.text != "replace" || target.edge_count != 1) {
        return false
    }
    receiver = LinkedNullNode(project, 1, LinkedNullChild(project, 1, target, 0))
    if (receiver.kind != "Variable") { return false }
    slot = LinkedNullBinding(state.slots, receiver.text)
    return slot > 0 && LinkedStringResult(state.slots[slot - 1].value.ty)
}

struct LinkedMemberPlace {
    place: LinkedNullExpression
    array_owner: int
}

fn ReadLinkedMemberPlace(&project: LinkedNullProject, state: LinkedNullState, &node: Node): LinkedMemberPlace! {
    id = LinkedNullChild(project, 1, node, 0)
    base = LinkedNullNode(project, 1, id)
    if (base.kind == "Index" && base.edge_count == 2) {
        array = LowerLinkedNullRead(project, state, LinkedNullChild(project, 1, base, 0), 2)?
        owner = 0
        if (LinkedNullOwnedArray(array.value.ty) && !array.value.borrowed &&
            !LinkedMemberUnavailable(array.state, array.value, true)) {
            owner = array.value.slot
        }
        item = ReadLinkedArrayElementAfterBase(project, array, base, id, 1)?
        return ok(LinkedMemberPlace { place: FinishLinkedFieldRead(project, item, node, true)?, array_owner: owner })
    }
    receiver = LowerLinkedNullRead(project, state, id, 1)?
    return ok(LinkedMemberPlace { place: FinishLinkedFieldRead(project, receiver, node, true)?, array_owner: 0 })
}

fn LowerLinkedStringReplace(&project: LinkedNullProject, state: LinkedNullState, &call: Node,
                            &target: Node, id: int, depth: int): LinkedNullExpression! {
    if (call.edge_count != 3) {
        RejectLayout("linked_replace_shape", "string.replace requires a string receiver and two arguments", DeclarationSpan(call))?
    }
    first = LowerLinkedNullRead(project, state, LinkedNullChild(project, 1, target, 0), depth + 1)?
    second = LowerLinkedNullRead(project, first.state, LinkedNullChild(project, 1, call, 1), depth + 1)?
    third = LowerLinkedNullRead(project, second.state, LinkedNullChild(project, 1, call, 2), depth + 1)?
    if (!LinkedStringResult(first.value.ty) || !LinkedStringResult(second.value.ty) || !LinkedStringResult(third.value.ty)) {
        RejectLayout("linked_replace_type", "string.replace requires three string values", DeclarationSpan(call))?
    }
    output = AddLinkedNullSlot(project, third.state, "", "t" + str(id), LinkedBuiltin("str", DeclarationSpan(call)), false)?
    output.state.uses_replace = true
    output.state.code += "    string_failure = ku_scalar_string_replace(" + first.value.text + ", "
        + second.value.text + ", " + third.value.text + ", &" + output.value.text.clone() + ");\n"
        + "    if (string_failure) goto cleanup;\n"
    output.state.slots[output.value.slot - 1].live = true
    return ok(output)
}

fn LinkedOwnedStringPredicate(&project: LinkedNullProject, &state: LinkedNullState, &call: Node): bool! {
    if (call.kind != "Call" || call.edge_count < 2 || call.edge_count > 9) { return ok(false) }
    target = LinkedNullNode(project, 1, LinkedNullChild(project, 1, call, 0))
    if (target.kind != "Variable" || target.edge_count != 0) { return ok(false) }
    callee = ResolveLinkedCall(project, state.slots, call, target, false)?
    if (callee.returns_result || callee.result.declaration_kind != "Builtin" || callee.result.name != "bool") {
        return ok(false)
    }
    owns_string = false
    for parameter in callee.parameters {
        if (LinkedStringResult(parameter)) { owns_string = true }
        else if (!LinkedNullView(parameter) && !LinkedIntResult(parameter) &&
            !(parameter.declaration_kind == "Builtin" && parameter.name == "bool")) { return ok(false) }
    }
    return ok(owns_string)
}

fn LinkedFieldAppendArgument(&project: LinkedNullProject, &target: Node, &root: Node, rhs: int): int {
    call = LinkedNullNode(project, 1, rhs)
    if (call.kind != "Call" || call.edge_count != 2) { return 0 }
    method = LinkedNullNode(project, 1, LinkedNullChild(project, 1, call, 0))
    if (method.kind != "Field" || method.edge_count != 1 || method.text != "push") { return 0 }
    field = LinkedNullNode(project, 1, LinkedNullChild(project, 1, method, 0))
    if (field.kind != "Field" || field.edge_count != 1 || field.text != target.text) { return 0 }
    receiver = LinkedNullNode(project, 1, LinkedNullChild(project, 1, field, 0))
    if (receiver.kind != "Variable" || receiver.edge_count != 0 || receiver.text != root.text) { return 0 }
    return LinkedNullChild(project, 1, call, 1)
}
