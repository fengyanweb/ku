import { LinkedLiveIntBinding, LinkedMemberUnavailable, LinkedNullDropC, RejectLinkedLoopWrite } from "./linked_member_ownership.ku"
import { BuildProjectOwningLayouts, OrderProjectOwningLayouts } from "./nested_struct_c.ku"
import { EmitScalarIntString } from "./scalar_int_emit.ku"
import { HasScalarBuiltin } from "./scalar_int_operands.ku"
import { Node } from "../stage2/ast.ku"
import { FindLinkedLocalRead, LinkedLocalReadBinding } from "./call_contracts.ku"
import { ContainsIndex, ProjectionCloneSource } from "./struct_projection_c.ku"
import { DeclarationSpan } from "./names.ku"
import { TypeNameBinding } from "./type_names.ku"
import { LayoutIndex, RejectLayout } from "./struct_layouts.ku"
import { LinkedLocalAppendIndex, LinkedNullBinding, LinkedNullFunction, LinkedNullExpression, LinkedNullReadableArray, LinkedNullIntArrayOwner, LinkedNullOwnedArray, LinkedNullSlot, LinkedNullState, LinkedNullValue, LinkedViewPointee, LinkPlanType, NewLinkedNullState, RegisterLinkedIntArray } from "./link_plan_c.ku"
import { LinkedBuiltin, LinkedIntResult, LinkedNullArrayElement, LinkedNullArrayPosition, LinkedNullArrayPrefix, LinkedNullChild, LinkedNullCType, LinkedNullHasResultValue, LinkedNullNode, LinkedNullParameterPlan,
         LinkedNullLayout, LinkedNullParameterType, LinkedNullProject, LinkedNullResultCleanupReference, LinkedNullType, LinkedNullView, LinkedStringResult, ReadLinkedResult, SameLinkedType } from "./linked_null_types_c.ku"

struct LinkedNullParameters {
    state: LinkedNullState
    signature: str
    body_start: int
    plan: [LinkPlanType]
    result: TypeNameBinding
}

fn LinkedCallableSlot(&state: LinkedNullState, slot: int): bool {
    return slot > 0 && state.slots[slot - 1].live &&
        (state.slots[slot - 1].parameter || ContainsIndex(state.local_callbacks, slot))
}

fn rejectLocalReader(&node: Node, message: str): null! {
    return RejectLayout("unsupported_linked_local_reader", message, DeclarationSpan(node))
}

fn CheckLinkedLocalFunctionName(&project: LinkedNullProject, &state: LinkedNullState, &function: Node): null! {
    if (function.text == "ok" || LinkedNullBinding(state.slots, function.text) != 0 ||
        FindLinkedLocalRead(state.local_readers, function.text) != 0 || LinkedLocalAppendIndex(state, function.text) != 0) {
        rejectLocalReader(function, "a local function needs a distinct local name")?
    }
    index = 0
    while (index < project.supplied[0].named.names.declarations.len()) {
        if (project.supplied[0].named.names.declarations[index].name == function.text) {
            rejectLocalReader(function, "a local reader may not shadow a module declaration")?
        }
        index = index + 1
    }
    index = 0
    while (index < project.binding.modules[0].imports.len()) {
        if (project.binding.modules[0].imports[index].local_name == function.text) {
            rejectLocalReader(function, "a local reader may not shadow an imported declaration")?
        }
        index = index + 1
    }
    return ok(null)
}

fn readLocalIndexShift(&project: LinkedNullProject, &index: Node, &name: str): int! {
    argument = index.clone()
    shift = 0
    if (index.kind == "Binary" && index.text == "-" && index.edge_count == 2) {
        argument = LinkedNullNode(project, 1, LinkedNullChild(project, 1, index, 0))
        constant = LinkedNullNode(project, 1, LinkedNullChild(project, 1, index, 1))
        if (constant.kind != "Int" || constant.edge_count != 0 || constant.int_value < 0) {
            rejectLocalReader(constant, "the local read index can subtract only a nonnegative int literal")?
        }
        shift = constant.int_value
    }
    if (argument.kind != "Variable" || argument.edge_count != 0 || argument.text != name) {
        rejectLocalReader(index, "the local read index must use the declared int parameter")?
    }
    return ok(shift)
}

fn RegisterLinkedLocalRead(&project: LinkedNullProject, state: LinkedNullState, &function: Node, id: int): LinkedNullState! {
    if (function.edge_count != 3) { rejectLocalReader(function, "a local reader needs one parameter and one return")? }
    CheckLinkedLocalFunctionName(project, state, function)?
    parameter = LinkedNullNode(project, 1, LinkedNullChild(project, 1, function, 0))
    exit = LinkedNullNode(project, 1, LinkedNullChild(project, 1, function, 2))
    if (parameter.kind != "Parameter" || parameter.edge_count != 1 || parameter.int_value != 0 ||
        exit.kind != "Return" || exit.edge_count != 1) {
        rejectLocalReader(function, "expected one typed Copy parameter and a direct return from the same frame")?
    }
    input = LinkedNullType(project, 1, LinkedNullChild(project, 1, parameter, 0))?
    if (input.declaration_kind != "Builtin" || input.name != "int") {
        rejectLocalReader(parameter, "a local reader requires a Copy int index parameter")?
    }
    subject = ProjectionCloneSource(project.supplied[0].named.parsed.arena.nodes,
        project.supplied[0].named.parsed.arena.edges, LinkedNullChild(project, 1, exit, 0))
    if (subject == 0) { rejectLocalReader(exit, "expected a local reader of a cloned array element")? }
    index = LinkedNullNode(project, 1, subject)
    if (index.kind != "Index" || index.edge_count != 2) {
        rejectLocalReader(index, "expected a local reader of a cloned array element")?
    }
    array = LinkedNullNode(project, 1, LinkedNullChild(project, 1, index, 0))
    capture = LinkedNullBinding(state.slots, array.text)
    if (array.kind != "Variable" || array.edge_count != 0 || array.text == parameter.text || capture == 0 ||
        !state.slots[capture - 1].live || !LinkedNullReadableArray(state.slots[capture - 1].value.ty)) {
        rejectLocalReader(array, "expected one initialized captured named array")?
    }
    element = LinkedNullArrayElement(state.slots[capture - 1].value.ty.clone())
    result = LinkedNullType(project, 1, LinkedNullChild(project, 1, function, 1))?
    if (result.declaration_kind != "Struct" || !SameLinkedType(result, element)) {
        rejectLocalReader(function, "local reader result must match the captured named array element")?
    }
    shift = readLocalIndexShift(project, LinkedNullNode(project, 1, LinkedNullChild(project, 1, index, 1)), parameter.text)?
    state.local_readers = state.local_readers.push(LinkedLocalReadBinding {
        name: function.text.clone(), node: id, captured_slot: capture, index_shift: shift })
    return ok(state)
}

fn CheckLinkedLocalAppendArguments(&callee: LinkedNullFunction, &call: Node, &unwrap: Node, owns_value: bool): null! {
    if (owns_value && !LinkedNullHasResultValue(callee.result)) {
        RejectLayout("linked_dependency_result", "expected a Result with a value payload", DeclarationSpan(unwrap))?
    }
    if (call.edge_count != callee.parameters.len() + 1) {
        RejectLayout("linked_local_append_arity", "direct local append call requires its declared arguments", DeclarationSpan(call))?
    }
    return ok(null)
}

fn ReadLinkedNullParameters(&project: LinkedNullProject, &function: Node): LinkedNullParameters! {
    return ReadLinkedNullParametersFrom(project, function, NewLinkedNullState())
}

fn ReadLinkedNullParametersFrom(&project: LinkedNullProject, &function: Node, seed: LinkedNullState): LinkedNullParameters! {
    state = seed
    signature = ""
    plan: [LinkPlanType] = []
    index = 0
    validation = ""
    while (index < function.edge_count) {
        node = LinkedNullNode(project, 1, LinkedNullChild(project, 1, function, index))
        if (node.kind != "Parameter") { break }
        if (node.edge_count != 1 || node.int_value < 0 || node.int_value > 1 || LinkedNullBinding(state.slots, node.text) != 0) {
            RejectLayout("linked_entry_parameter", "expected distinct explicitly typed parameters", DeclarationSpan(node))?
        }
        view = node.int_value == 1
        ty = LinkedNullParameterType(project, 1, LinkedNullChild(project, 1, node, 0), view)?
        name = "a" + str(index)
        if (index != 0) { signature += ", " }
        c_type = LinkedNullCType(ty)?
        signature += c_type.clone() + " " + name.clone()
        plan = plan.push(LinkedNullParameterPlan(ty, 1)?)
        if (ty.declaration_kind == "StringView") {
            validation += "    if (!" + name.clone() + " || (" + name.clone() + "->len && !" + name.clone()
                + "->ptr)) { invalid_str = true; goto cleanup; }\n"
        } else if (ty.declaration_kind == "StructView") {
            validation += "    if (!" + name.clone() + ") { invalid_struct_view = true; goto cleanup; }\n"
        } else if (LinkedNullIntArrayOwner(ty) || LinkedNullOwnedArray(ty)) {
            state = RequireLinkedArrayValidation(state, ty.clone())
            discard = ""
            if (LinkedNullOwnedArray(ty)) {
                // A malformed FFI header cannot be walked by the element destructor.
                discard = name.clone() + " = (" + c_type + "){0}; "
            }
            validation += "    if (!" + LinkedNullArrayPrefix(ty) + "_valid(&" + name.clone() + ") || (uintmax_t)"
                + name.clone() + ".len > (uintmax_t)INT64_MAX) { " + discard + "invalid_array = true; goto cleanup; }\n"
        } else if (view) {
            validation += "    if (!" + LinkedNullArrayPrefix(ty) + "_valid(" + name.clone() + ") || (uintmax_t)"
                + name.clone() + "->len > (uintmax_t)INT64_MAX) { invalid_array = true; goto cleanup; }\n"
        }
        slot = AddLinkedNullSlot(project, state, node.text, name.clone(), ty, true)?
        state = slot.state
        state.code = state.code + "    (void)" + name + ";\n"
        index = index + 1
    }
    if (index >= function.edge_count - 1) {
        RejectLayout("linked_null_signature", "entry requires a declared null! result and a body", DeclarationSpan(function))?
    }
    result_id = LinkedNullChild(project, 1, function, index)
    declared = LinkedNullNode(project, 1, result_id)
    plain_named = declared.kind == "TypeName"
    state.plain_value_result = declared.kind == "TypeArray" || plain_named
    result = ReadLinkedResult(project, 1, result_id, !state.plain_value_result)?
    copy = result.declaration_kind == "Builtin" && (result.name == "bool" || result.name == "int")
    if (plain_named && !copy && !LinkedStringResult(result) && result.declaration_kind != "Struct") {
        RejectLayout("linked_value_result", "a plain named result requires builtin int, bool, str or a bound struct", result.span.clone())?
    }
    if (index == 0) { signature = "void" }
    state.code = state.code + validation
    state = RegisterLinkedNullType(project, state, result.clone())?
    return ok(LinkedNullParameters { state: state, signature: signature, body_start: index + 1, plan: plan, result: result })
}

fn registerOwnedElement(&project: LinkedNullProject, state: LinkedNullState, &element: TypeNameBinding): LinkedNullState! {
    next = state
    try {
        next.layouts = LinkedNullLayout(project, element, next.layouts.clone(), 0)?
        return ok(next)
    } catch (err) {
        // A cached owning child can reach the scalar layout order check
        // before a new parent exposes the same array field to collection.
        if (err.code != "unsupported_layout_type" && err.code != "unsupported_nested_layout") { fail err }
    }
    unit = element.module_index
    node = element.declaration_node
    layout = BuildProjectOwningLayouts(project.supplied, project.binding, unit, node, element.span.clone())?
    order = OrderProjectOwningLayouts(layout, unit, node, element.span.clone())?
    next.owning_strings = next.owning_strings || order.contains_string
    for entry in order.entries {
        item = layout[entry.layout_index - 1].clone()
        if (LayoutIndex(next.owning_layouts, item.module_index, item.node) == 0) {
            next.owning_layouts = next.owning_layouts.push(item.clone())
        }
        if (LayoutIndex(next.layouts, item.module_index, item.node) == 0) {
            next.layouts = next.layouts.push(item)
        }
    }
    return ok(next)
}

fn RegisterLinkedNullType(&project: LinkedNullProject, state: LinkedNullState, ty: TypeNameBinding): LinkedNullState! {
    next = state
    if (ty.declaration_kind == "Builtin" && ty.name == "bytes") { next.owning_strings = true }
    if (ty.declaration_kind == "OwnedStringArray") {
        next.uses_str_array = true
        next.owning_strings = true
        if (LinkedNullArrayPosition(next.owned_arrays, ty) == 0) { next.owned_arrays = next.owned_arrays.push(ty) }
        return ok(next)
    }
    if (ty.declaration_kind == "BuiltinArray") {
        if (ty.name == "str") {
            next.uses_str_array = true
            next = RequireLinkedArrayValidation(next, ty.clone())
        }
        else { next = RequireLinkedArrayValidation(RegisterLinkedIntArray(next, ty.clone()), ty.clone()) }
    }
    if (LinkedNullIntArrayOwner(ty)) {
        carrier = ty.clone()
        carrier.declaration_kind = "BuiltinArray"
        next = RegisterLinkedIntArray(next, carrier)
        if (LinkedNullArrayPosition(next.owned_arrays, ty) == 0) { next.owned_arrays = next.owned_arrays.push(ty.clone()) }
    }
    if (ty.declaration_kind == "StringView") { next.uses_str_view = true }
    if (ty.declaration_kind == "StructView") { next.uses_struct_view = true }
    if (ty.declaration_kind == "StructArray" || LinkedNullOwnedArray(ty)) {
        element = LinkedNullArrayElement(ty.clone())
        next = registerOwnedElement(project, next, element)?
        if (LinkedNullOwnedArray(ty) && LinkedNullArrayPosition(next.owned_arrays, ty) == 0) {
            next.owned_arrays = next.owned_arrays.push(ty.clone())
        }
        carrier = ty.clone()
        carrier.declaration_kind = "StructArray"
        if (LinkedNullArrayPosition(next.arrays, carrier) == 0) { next.arrays = next.arrays.push(carrier) }
    } else if (ty.declaration_kind == "Struct" || ty.declaration_kind == "StructView") {
        next = registerOwnedElement(project, next, LinkedViewPointee(ty))?
    }
    return ok(next)
}

fn ValidateLinkedPayload(state: LinkedNullState, &result: TypeNameBinding, &payload: str): LinkedNullState {
    next = state
    prefix = "ku_linked_view_str_array"
    if (LinkedNullOwnedArray(result)) {
        prefix = LinkedNullArrayPrefix(result)
    } else if (result.declaration_kind != "OwnedStringArray") { return next }
    next = RequireLinkedArrayValidation(next, result.clone())
    next.code += "    if (!" + prefix + "_valid(&" + payload.clone() + ") || (uintmax_t)"
        + payload.clone() + ".len > (uintmax_t)INT64_MAX) { invalid_array = true; goto cleanup; }\n"
    return next
}

fn RequireLinkedArrayValidation(state: LinkedNullState, ty: TypeNameBinding): LinkedNullState {
    next = state
    carrier = ty
    if (LinkedNullIntArrayOwner(carrier) || carrier.declaration_kind == "OwnedStringArray") {
        carrier.declaration_kind = "BuiltinArray"
    }
    else if (carrier.declaration_kind != "BuiltinArray") { carrier.declaration_kind = "StructArray" }
    if (LinkedNullArrayPosition(next.validated_arrays, carrier) == 0) {
        next.validated_arrays = next.validated_arrays.push(carrier)
    }
    return next
}

fn AddLinkedNullSlot(&project: LinkedNullProject, state: LinkedNullState, binding: str,
                     name: str, ty: TypeNameBinding, parameter: bool): LinkedNullExpression! {
    next = RegisterLinkedNullType(project, state, ty.clone())?
    if (ty.declaration_kind == "IntPairResultCallback") {
        if (!parameter) {
            RejectLayout("linked_callback_escape", "a callback parameter can only be forwarded to a checked synchronous parameter", ty.span.clone())?
        }
        payload = ty.clone()
        payload.declaration_kind = "Struct"
        next = registerOwnedElement(project, next, payload)?
        next.code += LinkedNullResultCleanupReference(next.owning_layouts, payload)
    }
    view = LinkedNullView(ty)
    if (ty.declaration_kind == "StructArray") {
        next = RequireLinkedArrayValidation(next, ty.clone())
        element = LinkedNullArrayElement(ty.clone())
        next.code += LinkedNullResultCleanupReference(next.owning_layouts, element)
    }
    kind = LinkedNullCType(ty)?
    value = LinkedNullValue { ty: ty, text: name.clone(), slot: next.slots.len() + 1, borrowed: view, member_path: "" }
    if (value.ty.declaration_kind == "StringView" || value.ty.declaration_kind == "StructView") {
        value.ty = LinkedViewPointee(value.ty)
        value.text = "(*" + name.clone() + ")"
        next.code += LinkedNullResultCleanupReference(next.owning_layouts, value.ty)
    }
    next.slots = next.slots.push(LinkedNullSlot { binding: binding, value: value.clone(), parameter: parameter, live: parameter, moved_members: [] })
    if (!parameter) { next.declarations = next.declarations + "    " + kind + " " + name + " = {0};\n" }
    if (!view) { next.drops = LinkedNullDropC(next.layouts, next.owning_layouts, value.ty, value.text) + next.drops }
    return ok(LinkedNullExpression { state: next, value: value })
}

fn CloneLinkedStringSlot(&project: LinkedNullProject, source: LinkedNullExpression, name: str): LinkedNullExpression! {
    ty = source.value.ty.clone()
    output = AddLinkedNullSlot(project, source.state, "", name, ty, false)?
    output.state.code += "    if (!ku_linked_clone_string(" + source.value.text + ", &" + output.value.text.clone()
        + ")) { out_of_memory = true; goto cleanup; }\n"
    output.state.uses_clone = true
    output.state.slots[output.value.slot - 1].live = true
    return ok(output)
}

fn RestoreLinkedConcatPrefix(&project: LinkedNullProject, state: LinkedNullState, &left: LinkedNullValue,
                              before: str, id: int): LinkedNullExpression! {
    next = state
    if (!LinkedMemberUnavailable(next, left, true)) {
        if (next.code == "") { next.code = before }
        else { next.code = before + next.code }
        return ok(LinkedNullExpression { state: next, value: left.clone() })
    }
    // The code for the right operand has only been built, not executed.
    // Keep the old string live before the first emitted ownership transfer.
    after = next.code
    next.code = before
    saved = CloneLinkedStringSlot(project, LinkedNullExpression { state: next, value: left.clone() }, "lhs" + str(id))?
    saved.state.code += after
    return ok(saved)
}

fn IsLinkedIntConversion(&project: LinkedNullProject, &state: LinkedNullState, &target: Node, arity: int): bool {
    return target.kind == "Variable" && target.text == "str" && target.edge_count == 0 && arity == 1
        && LinkedNullBinding(state.slots, target.text) == 0 && HasScalarBuiltin(project.supplied[0].named, target.text)
}

fn LowerLinkedIntString(&project: LinkedNullProject, input: LinkedNullExpression, &node: Node, id: int): LinkedNullExpression! {
    at = DeclarationSpan(node)
    if (!LinkedIntResult(input.value.ty)) {
        RejectLayout("linked_int_format", "linked str conversion requires an int argument", at.clone())?
    }
    output = AddLinkedNullSlot(project, input.state, "", "t" + str(id), LinkedBuiltin("str", at), false)?
    output.state.code += EmitScalarIntString(input.value.text, output.value.text)
    output.state.uses_concat = true
    output.state.uses_int_format = true
    output.state.slots[output.value.slot - 1].live = true
    return ok(output)
}

fn LinkedCountdownIndex(&project: LinkedNullProject, &state: LinkedNullState, &loop: Node, &step: Node): int! {
    guard = LinkedNullNode(project, 1, LinkedNullChild(project, 1, loop, 0))
    if (guard.kind != "Binary" || guard.text != ">" || guard.edge_count != 2) { return ok(0) }
    zero = LinkedNullNode(project, 1, LinkedNullChild(project, 1, guard, 1))
    if (zero.kind != "Int" || zero.int_value != 0 || zero.edge_count != 0) { return ok(0) }
    cursor = LinkedNullNode(project, 1, LinkedNullChild(project, 1, guard, 0))
    slot = LinkedLiveIntBinding(state, cursor)
    at = DeclarationSpan(step)
    if (slot == 0 || step.kind != "Assign" || step.edge_count != 1 || step.text != cursor.text) {
        RejectLayout("unsupported_linked_countdown", "countdown requires a live int cursor and its final assignment", at.clone())?
    }
    changed = LinkedNullNode(project, 1, LinkedNullChild(project, 1, step, 0))
    if (changed.kind != "Binary" || changed.text != "-" || changed.edge_count != 2) {
        RejectLayout("unsupported_linked_countdown", "countdown must end with a unit decrement", at.clone())?
    }
    previous = LinkedNullNode(project, 1, LinkedNullChild(project, 1, changed, 0))
    one = LinkedNullNode(project, 1, LinkedNullChild(project, 1, changed, 1))
    if (previous.kind != "Variable" || previous.edge_count != 0 || previous.text != cursor.text
        || one.kind != "Int" || one.edge_count != 0 || one.int_value != 1) {
        RejectLayout("unsupported_linked_countdown", "countdown must end with a unit decrement", at.clone())?
    }
    RejectLinkedLoopWrite(project, loop, cursor.text, "linked_loop_cursor_write", "countdown can change its cursor only at the end")?
    return ok(slot)
}

fn ForwardLinkedCallback(&project: LinkedNullProject, &state: LinkedNullState, id: int,
                         &parameter: TypeNameBinding): str! {
    source = ProjectionCloneSource(project.supplied[0].named.parsed.arena.nodes,
        project.supplied[0].named.parsed.arena.edges, id)
    node = LinkedNullNode(project, 1, id)
    if (source != 0) { node = LinkedNullNode(project, 1, source) }
    slot = LinkedNullBinding(state.slots, node.text)
    if (node.kind != "Variable" || node.edge_count != 0 || !LinkedCallableSlot(state, slot) ||
        !SameLinkedType(state.slots[slot - 1].value.ty, parameter)) {
        RejectLayout("linked_callback_forward", "expected a live callback parameter with the same checked signature", DeclarationSpan(node))?
    }
    // Even an explicit clone keeps the same environment. Both descriptors
    // are borrowed from the invoking frame for this synchronous call.
    return ok(state.slots[slot - 1].value.text.clone())
}
