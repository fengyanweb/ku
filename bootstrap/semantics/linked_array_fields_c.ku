import { FindLinkedLocalRead, LinkedLocalReadBinding, RequireLinkedMutableName } from "./call_contracts.ku"
import { AddLinkedNullSlot, CheckLinkedLocalFunctionName, CloneLinkedIntArray, CloneLinkedRecord, CloneLinkedStringSlot, LinkedCallableSlot, RejectLocalReader, RequireLinkedArrayValidation } from "./linked_parameters_c.ku"
import { EmitLinkedIntAppend } from "./struct_array_c.ku"
import { LinkedScopedCallbackFunction, SameLinkedCallbackSignature } from "./link_plan_json_c.ku"
import { ContainsIndex, LinkedAppendFaultRelayCode, LinkedIntArrayCallbackFaultPending, ProjectionCloneSource } from "./struct_projection_c.ku"
import { Node } from "../stage2/ast.ku"
import { TypeNameBinding } from "./type_names.ku"
import { DeclarationSpan } from "./names.ku"
import { RejectLayout } from "./struct_layouts.ku"
import { IsLinkedScopedCallback,
    LinkedLocalAppendIndex, LinkedNullBinding, LinkedNullExpression, LinkedNullIntArrayOwner, LinkedNullOwnedArray,
    LinkedNullReadableArray, LinkedNullState, LinkedNullValue, LinkedReadonlyExpression, LinkedViewPointee, ReadLinkedNullBinding } from "./link_plan_c.ku"
import { LinkedIntResult, LinkedNullArrayElement, LinkedNullArrayPrefix, LinkedNullChild, LinkedNullCType, LinkedNullNode, LinkedNullProject, LinkedNullType, LinkedStringResult,
    ReadLinkedOwnedArray, ResolveLinkedCall, SameLinkedType } from "./linked_null_types_c.ku"
import { LinkedNullDropC, MoveLinkedNullSlot } from "./linked_member_ownership.ku"
import { CloneLinkedRecordArray, EmitLinkedAddition, LowerLinkedIntArrayLiteral, LowerLinkedNullRead } from "./linked_null_read_c.ku"

fn LinkedFieldAppendArgument(&project: LinkedNullProject, &target: Node, &root: Node, rhs: int): int {
    call = LinkedNullNode(project, 1, rhs)
    if (call.kind != "Call" || call.edge_count != 2) { return 0 }
    method = LinkedNullNode(project, 1, LinkedNullChild(project, 1, call, 0))
    if (method.kind != "Field" || method.edge_count != 1 || method.text != "push") { return 0 }
    field = LinkedNullNode(project, 1, LinkedNullChild(project, 1, method, 0))
    if (field.kind != "Field" || field.edge_count != 1 || field.text != target.text) { return 0 }
    receiver = LinkedNullNode(project, 1, LinkedNullChild(project, 1, field, 0))
    if (receiver.kind != "Variable" || receiver.edge_count != 0 || receiver.text != root.text) { return 0 }
    return LinkedNullChild(project, 1, call, 1)
}

fn LinkedAppendFailureRelay(&body: LinkedNullState): str {
    text = ""
    calls_append = body.local_appends.len() > 0
    if (calls_append || body.append_slots.len() > 0 || body.local_append_types.len() > 0) {
        text = "    failure->append_status = append_status;\n"
    }
    if (calls_append || body.uses_clone || body.uses_int_snapshot || body.element_clones.len() > 0) {
        text += "    failure->out_of_memory = out_of_memory;\n"
    }
    if (body.validated_arrays.len() > 0) {
        message = "invalid struct array ownership"
        if (body.uses_str_array) { message = "invalid array view" }
        text += "    if (invalid_array) failure->array_error = \"" + message + "\\n\";\n"
    }
    if (calls_append) { text += "    if (captured_array_failure) failure->array_error = captured_array_failure;\n" }
    if (calls_append || body.uses_add || body.uses_sub || body.uses_mul) { text += "    failure->overflow = overflow;\n" }
    if (calls_append || body.uses_index) {
        text += "    failure->index_failed = index_failed;\n    failure->index = failure_index;\n    failure->length = failure_length;\n"
    }
    return text
}

fn readLocalIndexShift(&project: LinkedNullProject, &index: Node, &name: str): int! {
    argument = index.clone()
    shift = 0
    if (index.kind == "Binary" && index.text == "-" && index.edge_count == 2) {
        argument = LinkedNullNode(project, 1, LinkedNullChild(project, 1, index, 0))
        constant = LinkedNullNode(project, 1, LinkedNullChild(project, 1, index, 1))
        if (constant.kind != "Int" || constant.edge_count != 0 || constant.int_value < 0) {
            RejectLocalReader(constant, "the local read index can subtract only a nonnegative int literal")?
        }
        shift = constant.int_value
    }
    if (argument.kind != "Variable" || argument.edge_count != 0 || argument.text != name) {
        RejectLocalReader(index, "the local read index must use the declared int parameter")?
    }
    return ok(shift)
}

fn RegisterLinkedLocalRead(&project: LinkedNullProject, state: LinkedNullState, &function: Node, id: int): LinkedNullState! {
    if (function.edge_count != 3) { RejectLocalReader(function, "a local reader needs one parameter and one return")? }
    CheckLinkedLocalFunctionName(project, state, function)?
    parameter = LinkedNullNode(project, 1, LinkedNullChild(project, 1, function, 0))
    exit = LinkedNullNode(project, 1, LinkedNullChild(project, 1, function, 2))
    if (parameter.kind != "Parameter" || parameter.edge_count != 1 || parameter.int_value != 0 ||
        exit.kind != "Return" || exit.edge_count != 1) {
        RejectLocalReader(function, "expected one typed Copy parameter and a direct return from the same frame")?
    }
    input = LinkedNullType(project, 1, LinkedNullChild(project, 1, parameter, 0))?
    if (input.declaration_kind != "Builtin" || input.name != "int") {
        RejectLocalReader(parameter, "a local reader requires a Copy int index parameter")?
    }
    expression = LinkedNullChild(project, 1, exit, 0)
    subject = ProjectionCloneSource(project.supplied[0].named.parsed.arena.nodes,
        project.supplied[0].named.parsed.arena.edges, expression)
    mapper = 0
    if (subject == 0) {
        call = LinkedNullNode(project, 1, expression)
        if (call.kind != "Call" || call.edge_count != 2) {
            RejectLocalReader(exit, "expected an array element clone or a direct readonly mapper")?
        }
        mapper = expression
        subject = LinkedNullChild(project, 1, call, 1)
    }
    index = LinkedNullNode(project, 1, subject)
    if (index.kind != "Index" || index.edge_count != 2) {
        RejectLocalReader(index, "expected a local reader of an indexed array element")?
    }
    array = LinkedNullNode(project, 1, LinkedNullChild(project, 1, index, 0))
    capture = LinkedNullBinding(state.slots, array.text)
    if (array.kind != "Variable" || array.edge_count != 0 || array.text == parameter.text || capture == 0 ||
        !state.slots[capture - 1].live || !LinkedNullReadableArray(state.slots[capture - 1].value.ty)) {
        RejectLocalReader(array, "expected one initialized captured named array")?
    }
    element = LinkedNullArrayElement(state.slots[capture - 1].value.ty.clone())
    result = LinkedNullType(project, 1, LinkedNullChild(project, 1, function, 1))?
    if (result.declaration_kind != "Struct" || (mapper == 0 && !SameLinkedType(result, element))) {
        RejectLocalReader(function, "local reader result must match the captured named array element")?
    }
    if (mapper != 0) {
        call = LinkedNullNode(project, 1, mapper)
        target = LinkedNullNode(project, 1, LinkedNullChild(project, 1, call, 0))
        if (target.kind != "Variable" || target.edge_count != 0 || target.text == parameter.text ||
            target.text == function.text || FindLinkedLocalRead(state.local_readers, target.text) != 0 ||
            LinkedLocalAppendIndex(state, target.text) != 0) {
            RejectLocalReader(target, "expected a statically bound readonly mapper")?
        }
        callee = ResolveLinkedCall(project, state.slots, call, target, false)?
        view = callee.parameters[0].clone()
        if (view.declaration_kind != "StructView" || !SameLinkedType(LinkedViewPointee(view), element) ||
            !SameLinkedType(callee.result, result)) {
            RejectLocalReader(call, "mapper must borrow one matching element and return the declared record")?
        }
    }
    shift = readLocalIndexShift(project, LinkedNullNode(project, 1, LinkedNullChild(project, 1, index, 1)), parameter.text)?
    state.local_readers = state.local_readers.push(LinkedLocalReadBinding {
        name: function.text.clone(), node: id, captured_slot: capture, index_shift: shift })
    return ok(state)
}

fn LowerLinkedArrayBinding(&project: LinkedNullProject, state: LinkedNullState, &statement: Node, id: int): LinkedNullState! {
    ty = ReadLinkedOwnedArray(project, 1, LinkedNullChild(project, 1, statement, 0), true, true)?
    value_id = LinkedNullChild(project, 1, statement, 1)
    value = LinkedNullNode(project, 1, value_id)
    if (LinkedNullBinding(state.slots, statement.text) != 0) {
        RejectLayout("linked_array_local", "expected a new typed array owner", DeclarationSpan(statement))?
    }
    if (value.kind == "Variable" && value.edge_count == 0) {
        input = ReadLinkedNullBinding(state, value)?
        if (!SameLinkedType(input.value.ty, ty) || input.value.borrowed) {
            RejectLayout("linked_array_local", "expected a matching named array owner", DeclarationSpan(value))?
        }
        local = AddLinkedNullSlot(project, input.state, statement.text.clone(), "l" + str(id), ty, false)?
        local.state.code += "    " + local.value.text + " = " + input.value.text.clone() + ";\n"
        local.state.slots[local.value.slot - 1].live = true
        return MoveLinkedNullSlot(local.state, input.value)
    }
    if (value.kind != "Array") {
        RejectLayout("linked_array_local", "expected an array literal or a matching named owner", DeclarationSpan(value))?
    }
    if (value.edge_count != 0) {
        if (!LinkedNullIntArrayOwner(ty)) {
            RejectLayout("linked_array_local", "a nonempty literal requires an int array", DeclarationSpan(value))?
        }
        literal = LowerLinkedIntArrayLiteral(project, state, value, value_id, statement.text.clone())?
        return ok(literal.state)
    }
    local = AddLinkedNullSlot(project, state, statement.text.clone(), "l" + str(id), ty, false)?
    local.state.slots[local.value.slot - 1].live = true
    return ok(local.state)
}

fn EmitLinkedClone(&project: LinkedNullProject, state: LinkedNullState, &target: Node, id: int, depth: int): LinkedNullExpression! {
    subject_id = LinkedNullChild(project, 1, target, 0)
    subject = LinkedNullNode(project, 1, subject_id)
    field = subject.kind == "Field" && subject.edge_count == 1
    if (!field && subject.kind != "Index" && (subject.kind != "Variable" || subject.edge_count != 0)) {
        RejectLayout("unsupported_linked_clone", "expected a bound variable, indexed element or field for clone", DeclarationSpan(subject))?
    }
    source = LowerLinkedNullRead(project, state, subject_id, depth + 1)?
    ty = source.value.ty.clone()
    if (LinkedStringResult(ty)) { return CloneLinkedStringSlot(project, source, "t" + str(id)) }
    if (LinkedNullIntArrayOwner(ty)) { return CloneLinkedIntArray(project, source, "t" + str(id)) }
    // A tracked owned field uses the same checked clone as a named array.
    if (LinkedNullOwnedArray(ty)) { return CloneLinkedRecordArray(project, source, id) }
    if (field && ty.declaration_kind != "Struct") {
        RejectLayout("unsupported_linked_clone", "field clone requires a bound str or finite struct", DeclarationSpan(subject))?
    }
    if (ty.declaration_kind != "Struct") {
        RejectLayout("unsupported_linked_clone", "expected str or a finite struct for clone", DeclarationSpan(subject))?
    }
    return CloneLinkedRecord(project, source, subject, id)
}

fn AppendLinkedArrayElement(state: LinkedNullState, &array: LinkedNullValue, &value: LinkedNullValue): LinkedNullState {
    next = RequireLinkedArrayValidation(state, array.ty.clone())
    if (array.member_path == "" && !ContainsIndex(next.append_slots, array.slot)) {
        next.append_slots = next.append_slots.push(array.slot)
    }
    if (LinkedNullIntArrayOwner(array.ty)) {
        next.code += EmitLinkedIntAppend(array.text, value.text)
        return next
    }
    prefix = LinkedNullArrayPrefix(array.ty)
    next.code += "    append_status = " + prefix + "_append_move(&" + array.text.clone()
        + ", &" + value.text.clone() + ");\n    if (append_status != KU_STRUCT_ARRAY_OK) goto cleanup;\n"
    // The C helper clears the element only after transfer. Cleanup keeps
    // ownership of the separate element and the initialized array prefix.
    next.slots[value.slot - 1].live = false
    return next
}

fn FinishLinkedFieldAppend(&project: LinkedNullProject, input: LinkedNullExpression, target: int, argument: int): LinkedNullState! {
    element = input
    copy_int = LinkedIntResult(element.value.ty) && !element.value.borrowed
    if (copy_int) {
        // A Copy expression can still name an lvalue. Read it before
        // selecting and validating the destination, and before realloc.
        item = "append_item" + str(argument)
        element.state.code += "    int64_t " + item.clone() + " = " + element.value.text + ";\n"
        element = LinkedReadonlyExpression(element.state, element.value.ty, item)
    }
    destination = LowerLinkedNullRead(project, element.state, target, 0)?
    array = destination.value.clone()
    item = element.value
    // Keep the same field owner across the checked append. Only a record
    // element transfers an owner; the int path passes its saved Copy value.
    if (LinkedNullIntArrayOwner(array.ty)) {
        if (array.borrowed || array.member_path == "" || !copy_int) {
            RejectLayout("linked_field_append", "append requires an owned int array field and one Copy int",
                         DeclarationSpan(LinkedNullNode(project, 1, argument)))?
        }
    } else if (!LinkedNullOwnedArray(array.ty) || array.borrowed || array.member_path == ""
        || item.borrowed || item.slot == 0 || item.member_path != ""
        || !SameLinkedType(LinkedNullArrayElement(array.ty.clone()), item.ty)) {
        RejectLayout("linked_field_append", "append requires an owned record array field and a separate owned element",
                     DeclarationSpan(LinkedNullNode(project, 1, argument)))?
    }
    for existing in destination.state.local_append_types.clone() {
        if (SameLinkedType(existing, array.ty)) { return ok(AppendLinkedArrayElement(destination.state, array, item)) }
    }
    destination.state.local_append_types = destination.state.local_append_types.push(array.ty.clone())
    return ok(AppendLinkedArrayElement(destination.state, array, item))
}

fn linkedStringAppendRoot(&project: LinkedNullProject, &target: Node, depth: int): str! {
    if (depth < 32) {
        if (target.kind == "Variable" && target.edge_count == 0) { return ok(target.text.clone()) }
        if (target.kind == "Field" && target.edge_count == 1) {
            root = LinkedNullNode(project, 1, LinkedNullChild(project, 1, target, 0))
            return linkedStringAppendRoot(project, root, depth + 1)
        }
    }
    RejectLayout("linked_append_target", "string append requires a named local or a direct field path", DeclarationSpan(target))?
    return ok("")
}

fn takeLinkedStringAppendOperand(&project: LinkedNullProject, state: LinkedNullState,
                                 &operand: LinkedNullValue, id: int): LinkedNullExpression! {
    taken = AddLinkedNullSlot(project, state, "", "append_rhs" + str(id), operand.ty.clone(), false)?
    taken.state.slots[taken.value.slot - 1].live = true
    taken.state.code += "    " + taken.value.text.clone() + " = " + operand.text.clone() + ";\n"
    taken.state = MoveLinkedNullSlot(taken.state, operand)?
    return ok(taken)
}

fn CheckLinkedStringAppendTarget(&project: LinkedNullProject, &state: LinkedNullState, &target: Node): int! {
    name = linkedStringAppendRoot(project, target, 0)?
    RequireLinkedMutableName(name, DeclarationSpan(target))?
    field = target.kind == "Field"
    slot = LinkedNullBinding(state.slots, name)
    if (field && (slot == 0 || state.slots[slot - 1].parameter || state.slots[slot - 1].value.borrowed ||
        state.slots[slot - 1].value.ty.declaration_kind != "Struct")) {
        RejectLayout("linked_append_target", "string member append requires a mutable owned local record", DeclarationSpan(target))?
    }

    return ok(slot)
}

fn FinishLinkedStringAppend(&project: LinkedNullProject, input: LinkedNullExpression, target_id: int, rhs_id: int,
                            slot: int, field: bool, &statement: Node, id: int): LinkedNullState! {
    right = input
    target = LinkedNullNode(project, 1, target_id)
    if (field && LinkedStringResult(right.value.ty)) {
        if (right.value.borrowed && right.value.member_path == "") {
            RejectLayout("linked_view_escape", "string member append needs an owned RHS; clone a readonly value explicitly",
                         right.value.ty.span.clone())?
        }
        rhs = LinkedNullNode(project, 1, rhs_id)
        if (right.value.slot != 0 && (rhs.kind == "Variable" || rhs.kind == "Field")) {
            operand = right.value.clone()
            right = takeLinkedStringAppendOperand(project, right.state, operand, id)?
        }
    }
    operand = right.value.clone()
    left = LowerLinkedNullRead(project, right.state, target_id, 0)?
    owner = left.value.clone()
    if (owner.slot == 0 || !LinkedStringResult(owner.ty) || (field && (owner.slot != slot || owner.member_path == "")) ||
        (!field && owner.borrowed)) {
        RejectLayout("linked_append_target", "string append requires a live owning str", DeclarationSpan(target))?
    }
    if (operand.slot == owner.slot && operand.member_path == owner.member_path) {
        RejectLayout("linked_append_target", "string append cannot move its own destination", DeclarationSpan(target))?
    }
    joined = EmitLinkedAddition(project, left.state, owner, operand, id, DeclarationSpan(statement))?
    drop = LinkedNullDropC(joined.state.layouts, joined.state.owning_layouts, owner.ty, owner.text)
    joined.state.code += drop + "    " + owner.text + " = " + joined.value.text.clone() + ";\n"
    replacement = joined.value.clone()
    return MoveLinkedNullSlot(joined.state, replacement)
}

struct LinkedScopedCallbackArgument {
    text: str
    setup: str
    relay: str
}

fn PrepareLinkedScopedCallbackArgument(&project: LinkedNullProject, &state: LinkedNullState, id: int,
                                       &parameter: TypeNameBinding, fault: str): LinkedScopedCallbackArgument! {
    source = ProjectionCloneSource(project.supplied[0].named.parsed.arena.nodes, project.supplied[0].named.parsed.arena.edges, id)
    node = LinkedNullNode(project, 1, id)
    if (source != 0) { node = LinkedNullNode(project, 1, source) }
    if (node.kind != "Variable" || node.edge_count != 0) {
        RejectLayout("linked_callback_forward", "expected a named synchronous array callback", DeclarationSpan(node))?
    }
    expected = LinkedScopedCallbackFunction(project, parameter)?
    carrier = LinkedNullCType(parameter)?
    slot = LinkedNullBinding(state.slots, node.text)
    if (slot != 0) {
        value = state.slots[slot - 1].value.clone()
        if (!LinkedCallableSlot(state, slot) || !IsLinkedScopedCallback(value.ty) ||
            !SameLinkedCallbackSignature(LinkedScopedCallbackFunction(project, value.ty)?, expected)) {
            RejectLayout("linked_callback_forward", "expected a live callback with the same checked signature", DeclarationSpan(node))?
        }
        name = value.text
        relay = "    if (" + LinkedIntArrayCallbackFaultPending(name.clone() + ".failure") + ") goto cleanup;\n"
        text = name.clone()
        if (carrier != LinkedNullCType(value.ty)?) {
            text = "(" + carrier + "){" + name.clone() + ".entry, " + name.clone() + ".environment, " + name + ".failure}"
        }
        return ok(LinkedScopedCallbackArgument { text: text, setup: "", relay: relay })
    }
    index = LinkedLocalAppendIndex(state, node.text)
    if (index == 0) {
        RejectLayout("linked_callback_forward", "expected a live checked local array callback", DeclarationSpan(node))?
    }
    local = state.local_appends[index - 1].clone()
    if (!SameLinkedCallbackSignature(local.function, expected)) {
        RejectLayout("linked_callback_forward", "local callback must match the declared checked signature", DeclarationSpan(node))?
    }
    text = "(" + carrier + "){" + local.function.symbol + ", " + local.environment
        + ", &" + fault.clone() + "}"
    setup = "    KuLocalAppendFailure " + fault.clone() + " = {0};\n"
    return ok(LinkedScopedCallbackArgument { text: text, setup: setup, relay: LinkedAppendFaultRelayCode(fault) })
}

fn LinkedBooleanWhileCondition(&state: LinkedNullState, &guard: Node): str {
    if (guard.kind != "Variable" || guard.edge_count != 0) { return "" }
    index = LinkedNullBinding(state.slots, guard.text)
    if (index == 0) { return "" }
    slot = state.slots[index - 1].clone()
    if (slot.parameter || !slot.live || slot.value.borrowed || slot.moved_members.len() != 0 ||
        slot.value.ty.declaration_kind != "Builtin" || slot.value.ty.name != "bool") { return "" }
    return slot.value.text
}
