import { Node } from "../stage2/ast.ku"
import { Span } from "../stage2/span.ku"
import { DeclarationSpan, NamedModule } from "./names.ku"
import { ImportBinding, SuppliedModule } from "./imports.ku"
import { TypeNameBinding } from "./type_names.ku"
import { RejectLayout, StructLayout } from "./struct_layouts.ku"
import { CStructOrder, OrderCStructLayouts } from "./nested_struct_c.ku"
import { ContainsIndex, EmitLayout, ProjectionHeaders } from "./struct_projection_c.ku"
import { EmitStructArrayOperations, EmitStructArrayResultHeader, EmitTryCloneString } from "./struct_array_c.ku"
import { GuardArithmetic, GuardArrayErrorC, GuardOwnedDrops, GuardStringArrayCloneC, GuardStringArrayEqualC, GuardStringEquality } from "./guarded_struct_c.ku"
import { ManagedExplicitType, ManagedSourceCharactersErrors, ManagedSourceCharactersRuntime, ManagedStringAppendRuntime } from "./guarded_string_parts.ku"
import { GuardBinding, GuardBindingIndex, GuardBindingName, GuardCType } from "./guarded_struct_expr.ku"
import { ManagedType } from "./managed_array_values_c.ku"
import { EmitManagedBlock, EmitManagedResultBlock, ManagedBlock } from "./managed_array_body_c.ku"
import { StructResultHeader, StructValueResultHeader } from "./struct_result_c.ku"
import { OwnedScalarLeaves, ReadOwnedScalarLeaves } from "./struct_result_link_c.ku"
import { BuiltinLinkPlanType, EmptyLinkPlanDeclaration, LinkPlanDeclaration, LinkPlanType } from "./link_plan_c.ku"

struct ManagedArrayC {
    symbol: str
    source: str
    entry_plan: LinkPlanDeclaration
    link_plan: [LinkPlanDeclaration]
}

struct ManagedLayoutOutput {
    text: str
    declared: [int]
    strings: bool
}

struct ManagedSignature {
    bindings: [GuardBinding]
    layouts: ManagedLayoutOutput
    parameters: str
    unused: str
    drops: str
    drop_strings: bool
    source_strings: bool
    body_start: int
}

fn appendLayouts(&layouts: [StructLayout], &order: CStructOrder, output: ManagedLayoutOutput): ManagedLayoutOutput! {
    next = output
    cursor = 0
    while (cursor < order.entries.len()) {
        index = order.entries[cursor].layout_index
        if (!ContainsIndex(next.declared, index)) {
            next.text = next.text + EmitLayout(layouts[index - 1], true, true)?
            next.declared = next.declared.push(index)
        }
        cursor = cursor + 1
    }
    next.strings = next.strings || order.contains_string
    return ok(next)
}

fn orderLayout(&layouts: [StructLayout], index: int, at: Span): CStructOrder! {
    return OrderCStructLayouts(layouts, layouts[index - 1].module_index, layouts[index - 1].node, at)
}

fn readParameters(&nodes: [Node], &edges: [int], &types: [TypeNameBinding], &layouts: [StructLayout],
                  &root: ManagedType, &ordered: CStructOrder, &function: Node, result_edge: int): ManagedSignature! {
    bindings: [GuardBinding] = []
    declarations = appendLayouts(layouts, ordered, ManagedLayoutOutput { text: "", declared: [], strings: false })?
    parameters = ""
    unused = ""
    drops = ""
    drop_strings = false
    source_strings = false
    cursor = function.first_edge
    while (cursor < result_edge) {
        parameter = nodes[edges[cursor] - 1].clone()
        at = DeclarationSpan(parameter)
        if (parameter.edge_count != 1 || parameter.int_value < 0 || parameter.int_value > 1 ||
            GuardBindingIndex(bindings, parameter.text) != 0) {
            RejectLayout("unsupported_managed_signature", "expected a distinct typed value or View parameter", at.clone())?
        }
        ty = ManagedExplicitType(types, nodes, edges, layouts, edges[parameter.first_edge])?
        view = parameter.int_value == 1
        if (ty.kind == "str_array" || (view && ty.kind != "array" && ty.kind != "struct") ||
            (ty.kind == "array" && ty.layout != root.layout)) {
            RejectLayout("unsupported_managed_signature", "expected Copy scalars, owned strings, known structs or matching arrays", at.clone())?
        }
        binding = GuardBinding { name: parameter.text, ty: ty, slot: bindings.len(), parameter: true, view: view }
        name = GuardBindingName(binding)
        c_type = GuardCType(binding.ty, layouts)
        if (view) { c_type = "const " + c_type + "*" }
        if (bindings.len() > 0) { parameters += ", " }
        parameters += c_type + " " + name.clone()
        unused += "    (void)" + name.clone() + ";\n"
        if (binding.ty.kind == "str") {
            source_strings = true
            drop_strings = true
            drops = "    ku_projection_string_drop(&" + name.clone() + ");\n" + drops
        } else if (binding.ty.kind == "struct") {
            dependencies = orderLayout(layouts, binding.ty.layout, at)?
            declarations = appendLayouts(layouts, dependencies, declarations)?
            if (!view && dependencies.contains_string) {
                drop_strings = true
                drops = GuardOwnedDrops(layouts, binding.ty.layout, name.clone()) + drops
            }
        }
        if (binding.ty.kind == "array" && !view) { drops = "    " + root.array.prefix.clone() + "_drop(&" + name + ");\n" + drops }
        bindings = bindings.push(binding)
        cursor = cursor + 1
    }
    if (parameters == "") { parameters = "void" }
    return ok(ManagedSignature { bindings: bindings, layouts: declarations, parameters: parameters,
        unused: unused, drops: drops, drop_strings: drop_strings, source_strings: source_strings, body_start: result_edge + 1 })
}

fn managedArrayErrors(): str {
    return "    if (array_status == KU_STRUCT_ARRAY_BOUNDS) {\n" +
        "        fprintf(stderr, \"array/index_out_of_bounds: index %lld out of bounds for length %zu\\n\", (long long)failure_index, failure_length);\n" +
        "        exit(EXIT_FAILURE);\n    }\n" +
        "    if (array_status) {\n" +
        "        const char *message = \"invalid struct array ownership\\n\";\n" +
        "        if (array_status == KU_STRUCT_ARRAY_CAPACITY) message = \"array allocation is too large\\n\";\n" +
        "        if (array_status == KU_STRUCT_ARRAY_OOM) message = \"array allocation failed\\n\";\n" +
        "        fputs(message, stderr);\n        exit(EXIT_FAILURE);\n    }\n"
}

fn resultEdge(&nodes: [Node], &edges: [int], &function: Node): int! {
    cursor = function.first_edge
    end = cursor + function.edge_count
    while (cursor < end && nodes[edges[cursor] - 1].kind == "Parameter") { cursor = cursor + 1 }
    if (cursor >= end - 1) {
        RejectLayout("unsupported_managed_signature", "expected an explicit struct array result and a body", DeclarationSpan(function))?
    }
    return ok(cursor)
}

fn managedDeclaration(&layout: StructLayout, kind: str, c_type: str, view: bool): LinkPlanType {
    unit = layout.module_index
    if (unit == 0) { unit = 1 }
    return LinkPlanType { kind: kind, name: layout.name.clone(), unit: unit, node: layout.node, c_type: c_type, view: view }
}

fn managedPlan(&layouts: [StructLayout], &signature: ManagedSignature, result_layout: int, result_type: str,
               symbol: str, node: int, checked: bool): LinkPlanDeclaration {
    parameters: [LinkPlanType] = []
    for binding in signature.bindings.clone() {
        c_type = GuardCType(binding.ty, layouts)
        if (binding.view) { c_type = "const " + c_type + "*" }
        if (binding.ty.kind == "struct" || binding.ty.kind == "array") {
            kind = "Struct"
            if (binding.ty.kind == "array") { kind = "StructArray" }
            parameters = parameters.push(managedDeclaration(layouts[binding.ty.layout - 1], kind, c_type, binding.view))
        } else {
            parameters = parameters.push(BuiltinLinkPlanType(binding.ty.kind, c_type, false))
        }
    }
    result = managedDeclaration(layouts[result_layout - 1], "StructArray", result_type, false)
    return LinkPlanDeclaration { unit: 1, node: node, symbol: symbol, parameters: parameters, result: result, returns_result: checked }
}

fn managedBody(&named: NamedModule, &types: [TypeNameBinding], &imports: [ImportBinding], &supplied: [SuppliedModule],
               &layouts: [StructLayout], &root: ManagedType, bindings: [GuardBinding], start: int, end: int, checked: bool): ManagedBlock! {
    if (checked) { return EmitManagedResultBlock(named, types, imports, supplied, layouts, root, bindings, start, end) }
    return EmitManagedBlock(named, types, imports, supplied, layouts, root, bindings, start, end, 0, "    ")
}

fn emitManagedFunction(&named: NamedModule, &types: [TypeNameBinding], &imports: [ImportBinding],
                       &supplied: [SuppliedModule], &layouts: [StructLayout], function_id: int): ManagedArrayC! {
    function = named.parsed.arena.nodes[function_id - 1].clone()
    edge = resultEdge(named.parsed.arena.nodes, named.parsed.arena.edges, function)?
    type_id = named.parsed.arena.edges[edge]
    declaration = named.parsed.arena.nodes[type_id - 1].clone()
    checked = declaration.kind == "TypeResult" && declaration.edge_count == 1
    if (checked) { type_id = named.parsed.arena.edges[declaration.first_edge] }
    result = ManagedExplicitType(types, named.parsed.arena.nodes, named.parsed.arena.edges, layouts, type_id)?
    if (result.kind != "array") {
        RejectLayout("unsupported_managed_signature", "expected a bound struct array result", DeclarationSpan(function))?
    }
    // Admit the result graph before either array policy or source generation.
    ordered = orderLayout(layouts, result.layout, DeclarationSpan(function))?
    array = EmitStructArrayOperations(layouts, result.layout)
    root = ManagedType { layout: result.layout, array: array, string_locals: false, source_strings: false,
        function_id: function_id, function_end: function.end_offset, leaves: [] }
    signature = readParameters(named.parsed.arena.nodes, named.parsed.arena.edges, types, layouts, root, ordered, function, edge)?
    root.source_strings = signature.source_strings
    leaves = OwnedScalarLeaves { bindings: [], declarations: "", plan: [], needs_clone: false }
    if (checked) { leaves = ReadOwnedScalarLeaves(named, types, layouts, function, true)? }
    clones = leaves.needs_clone
    root.leaves = leaves.bindings
    body = managedBody(named, types, imports, supplied, layouts, root, signature.bindings.clone(),
        signature.body_start, function.first_edge + function.edge_count, checked)?
    if (!body.returns) { RejectLayout("managed_fallthrough", "every path must return an array owner", DeclarationSpan(function))? }
    declarations = signature.layouts
    prototypes = leaves.declarations
    dependencies = leaves.plan
    result_headers = ""
    declared_results: [int] = []
    declared_calls: [int] = []
    for link in body.record_links {
        if (!ContainsIndex(declared_results, link.payload_layout)) {
            order = orderLayout(layouts, link.payload_layout, DeclarationSpan(function))?
            declarations = appendLayouts(layouts, order, declarations)?
            result_headers += StructValueResultHeader(link.payload_type)
            declared_results = declared_results.push(link.payload_layout)
        }
        if (!ContainsIndex(declared_calls, link.plan.node)) {
            prototypes += link.prototype
            declared_calls = declared_calls.push(link.plan.node)
            dependencies = dependencies.push(link.plan)
        }
    }
    symbol = "ku_managed_" + str(function_id)
    arithmetic = body.code.uses_add || body.code.uses_sub
    append = body.code.uses_string_append
    text = ProjectionHeaders(checked || declarations.strings || body.code.uses_eq || signature.source_strings, signature.drop_strings)
    text += "#include <stdio.h>\n#include <stdlib.h>\n\n"
    text += GuardArithmetic(body.code.uses_add, body.code.uses_sub) + GuardStringEquality(body.code.uses_eq)
    if (signature.source_strings) {
        text += ManagedSourceCharactersRuntime(true) + GuardStringArrayCloneC()
        if (body.code.uses_eq) { text += GuardStringArrayEqualC() }
    }
    if (clones) { text += EmitTryCloneString("ku_result_clone_string") }
    if (append) { text += ManagedStringAppendRuntime() }
    text += declarations.text + root.array.source
    result_type = root.array.array_type.clone()
    if (checked) {
        text += StructResultHeader() + EmitStructArrayResultHeader(root.array.array_type)
        result_type = "KuBootstrapResult_" + result_type
    }
    text += result_headers + prototypes + result_type.clone() + " " + symbol.clone() + "(" + signature.parameters.clone() + ") {\n"
    text += "    " + result_type.clone() + " result = {0};\n"
    text += "    int array_status = KU_STRUCT_ARRAY_OK;\n    int64_t failure_index = 0;\n    size_t failure_length = 0;\n"
    if (signature.source_strings) {
        text += "    int source_status = KU_SOURCE_OK;\n    KuGuardArrayFailure array_failure = {0};\n"
        text += "    (void)ku_managed_source_chars;\n    (void)ku_managed_source_drop;\n    (void)ku_guard_string_array_clone_at;\n"
        if (body.code.uses_eq) { text += "    (void)ku_guard_string_array_equal;\n" }
    }
    if (arithmetic) { text += "    bool overflow = false;\n" }
    if (clones || append) { text += "    bool out_of_memory = false;\n" }
    if (clones) { text += "    (void)ku_result_clone_string;\n" }
    if (append) { text += "    bool string_too_large = false;\n" }
    if (body.error_exits != "") { text += "    int record_error = 0;\n" }
    text += signature.unused + body.declarations + body.code.text
    text += "cleanup:\n" + body.drops + signature.drops
    if (signature.source_strings) { text += ManagedSourceCharactersErrors() + GuardArrayErrorC() }
    if (arithmetic) { text += "    if (overflow) { fputs(\"integer overflow\\n\", stderr); exit(EXIT_FAILURE); }\n" }
    if (append) { text += "    if (string_too_large) { fputs(\"string allocation is too large\\n\", stderr); exit(EXIT_FAILURE); }\n" }
    if (clones || append) { text += "    if (out_of_memory) { fputs(\"out of memory\\n\", stderr); exit(EXIT_FAILURE); }\n" }
    text += managedArrayErrors() + body.error_exits + "    return result;\n}\n"
    plan = managedPlan(layouts, signature, result.layout, result_type, symbol.clone(), function_id, checked)
    return ok(ManagedArrayC { symbol: symbol, source: text, entry_plan: plan, link_plan: dependencies })
}

fn EmitManagedArrayC(&named: NamedModule, &types: [TypeNameBinding], &imports: [ImportBinding],
                    &supplied: [SuppliedModule], &layouts: [StructLayout], &function_name: str): ManagedArrayC! {
    index = 0
    while (index < named.names.declarations.len()) {
        item = named.names.declarations[index].clone()
        if (item.kind == "Function" && item.name == function_name) {
            return emitManagedFunction(named, types, imports, supplied, layouts, item.node)
        }
        index = index + 1
    }
    start = Span { line: 1, column: 1, offset: 0, end_line: 1, end_column: 1, end_offset: 0 }
    RejectLayout("unknown_managed_function", "undefined managed function '" + function_name.clone() + "'", start)?
    return ok(ManagedArrayC { symbol: "", source: "", entry_plan: EmptyLinkPlanDeclaration(), link_plan: [] })
}
