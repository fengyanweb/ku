import { Node } from "../stage2/ast.ku"
import { Span } from "../stage2/span.ku"
import { DeclarationSpan } from "./names.ku"
import { SuppliedModule } from "./imports.ku"
import { BindProjectModules, ProjectBindings } from "./project_bindings.ku"
import { GuardBinding, GuardBindingIndex, GuardCType, GuardExplicitType, GuardExpression, GuardValue } from "./guarded_struct_expr.ku"
import { GuardOwnedDrops } from "./guarded_struct_c.ku"
import { CStructOrder, EmitOrderedStructLayouts, OrderCStructLayouts } from "./nested_struct_c.ku"
import { ProjectionHeaders } from "./struct_projection_c.ku"
import { CheckStructArrayType, EmitStructArrayHeader, EmitStructArrayReadValidation } from "./struct_array_c.ku"
import { BuildStructLayouts, ExplicitType, LayoutIndex, RejectLayout, StructLayout } from "./struct_layouts.ku"
import { BoundLinkPlanType, EmptyLinkPlanDeclaration, LinkPlanDeclaration } from "./link_plan_c.ku"
import { ScalarStringJoinHelpers } from "./scalar_int_emit.ku"
import { HasScalarBuiltin, ScalarStringLiteral } from "./scalar_int_operands.ku"
import { BindStructStringCall, ReadStructStringFold, StructStringDependency, StructStringFold } from "./struct_string_calls.ku"
import { TypeNameBinding } from "./type_names.ku"

import { DropLinkedNullScope } from "./linked_null_read_c.ku"
import { LinkedNullBinding, LinkedNullState } from "./link_plan_c.ku"
import { LinkedNullChild, LinkedNullNode, LinkedNullProject } from "./linked_null_types_c.ku"
import { LowerLinkedNullTry, LowerLinkedNullValue } from "./linked_null_values_c.ku"
fn linkedOutputBuiltin(&project: LinkedNullProject, &state: LinkedNullState, &target: Node): bool {
    if (target.kind != "Variable" || target.edge_count != 0 ||
        target.text != "println" ||
        LinkedNullBinding(state.slots, target.text) != 0) { return false }
    for declaration in project.supplied[0].named.names.declarations.clone() {
        if (declaration.name == target.text) { return false }
    }
    for binding in project.binding.modules[0].imports.clone() {
        if (binding.local_name == target.text) { return false }
    }
    return true
}

fn emitLinkedOutput(&text: str, newline: bool): str {
    code = "    {\n        KuProjectionString written_text = " + text.clone() + ";\n"
        + "        size_t offset = 0;\n        while (offset < written_text.len) {\n"
        + "            size_t count = fwrite(written_text.ptr + offset, 1, written_text.len - offset, stdout);\n"
        + "            if (!count) { output_failed = true; goto cleanup; }\n"
        + "            offset += count;\n        }\n"
    if (newline) { code += "        if (fputc('\\n', stdout) == EOF) { output_failed = true; goto cleanup; }\n" }
    return code + "        (void)fflush(stdout);\n    }\n"
}

fn lowerLinkedOutputValue(&project: LinkedNullProject, state: LinkedNullState, id: int,
                          newline: bool): LinkedNullState! {
    scope = state.slots.len()
    value = LowerLinkedNullValue(project, state, id, 0)?
    if (value.value.ty.declaration_kind != "Builtin" || value.value.ty.name != "str") {
        node = LinkedNullNode(project, 1, id)
        RejectLayout("linked_output_type", "expected a str argument for linked output", DeclarationSpan(node))?
    }
    value.state.uses_print = true
    value.state.code += emitLinkedOutput(value.value.text, newline)
    return ok(DropLinkedNullScope(value.state, scope))
}

fn LowerLinkedStatementCall(&project: LinkedNullProject, state: LinkedNullState, &statement: Node): LinkedNullState! {
    id = LinkedNullChild(project, 1, statement, 0)
    // Stage3 represents the print keyword separately from a println call.
    if (statement.kind == "Print") { return lowerLinkedOutputValue(project, state, id, false) }
    call = LinkedNullNode(project, 1, id)
    if (call.kind == "Call" && call.edge_count == 2) {
        target = LinkedNullNode(project, 1, LinkedNullChild(project, 1, call, 0))
        if (linkedOutputBuiltin(project, state, target)) {
            argument = LinkedNullChild(project, 1, call, 1)
            return lowerLinkedOutputValue(project, state, argument, true)
        }
    }
    return LowerLinkedNullTry(project, state, statement)
}

struct ProjectStructStringC {
    symbol: str
    dependencies: [StructStringDependency]
    source: str
    entry_plan: LinkPlanDeclaration
}

struct StructStringFlow {
    source: str
    slots: [int]
    dependencies: [StructStringDependency]
    moved_fields: [str]
    result: str
    leaves: int
    uses_join: bool
    uses_format: bool
}

fn hasMovedField(&moved: [str], &field: str): bool {
    index = 0
    while (index < moved.len()) {
        if (moved[index] == field) { return true }
        index = index + 1
    }
    return false
}

fn addStringDependency(dependencies: [StructStringDependency], dependency: StructStringDependency): [StructStringDependency] {
    index = 0
    while (index < dependencies.len()) {
        if (dependencies[index].module_index == dependency.module_index && dependencies[index].declaration == dependency.declaration) {
            return dependencies
        }
        index = index + 1
    }
    return dependencies.push(dependency)
}

fn moveStructStringField(&field: Node, &value: GuardValue, destination: str, flow: StructStringFlow): StructStringFlow! {
    if (field.kind != "Field" || value.ty.kind != "str" || value.setup != "" || value.view) {
        RejectLayout("struct_string_link_argument", "expected a checked owned str field", DeclarationSpan(field))?
    }
    current = flow
    if (hasMovedField(current.moved_fields, value.value)) {
        RejectLayout("reused_struct_string_owner", "owned field was already consumed by this expression", DeclarationSpan(field))?
    }
    current.source = current.source + "    " + destination + " = " + value.value.clone() + ";\n"
    current.source = current.source + "    " + value.value.clone() + " = (KuProjectionString){0};\n"
    current.moved_fields = current.moved_fields.push(value.value.clone())
    return ok(current)
}

fn formatStructIntField(&field: Node, &value: GuardValue, &output: str, flow: StructStringFlow): StructStringFlow! {
    if (field.kind != "Field" || value.ty.kind != "int" || value.setup != "" || value.view) {
        RejectLayout("struct_string_int_argument", "str requires a checked Copy int field", DeclarationSpan(field))?
    }
    current = flow
    // str allocates before this leaf's parent concatenation. Keep that
    // failure point and evaluate no later call when it fails.
    current.source = current.source + "    {\n        uint8_t digits[20];\n"
    current.source = current.source + "        KuScalarStringPart part = ku_scalar_string_int(" + value.value.clone() + ", digits);\n"
    current.source = current.source + "        failure = ku_scalar_string_join(&part, 1u, &" + output.clone() + ");\n"
    current.source = current.source + "        if (failure) goto cleanup;\n    }\n"
    current.uses_join = true
    current.uses_format = true
    return ok(current)
}

fn structStringCall(&supplied: [SuppliedModule], &project: ProjectBindings, &layouts: [StructLayout],
                    &bindings: [GuardBinding], &call: Node, &output: str, can_convert: bool, flow: StructStringFlow): StructStringFlow! {
    current = flow
    target = supplied[0].named.parsed.arena.nodes[supplied[0].named.parsed.arena.edges[call.first_edge] - 1].clone()
    if (GuardBindingIndex(bindings, target.text) != 0) {
        RejectLayout("shadowed_struct_string_call", "a local binding shadows the named string function", DeclarationSpan(target))?
    }
    arg_id = supplied[0].named.parsed.arena.edges[call.first_edge + 1]
    argument = supplied[0].named.parsed.arena.nodes[arg_id - 1].clone()
    value = GuardExpression(supplied[0].named.parsed.arena.nodes, supplied[0].named.parsed.arena.edges,
        bindings, layouts, arg_id, 0, "    ")?
    if (can_convert && target.kind == "Variable" && target.edge_count == 0 && target.text == "str") {
        return formatStructIntField(argument, value, output, current)
    }
    dependency = BindStructStringCall(supplied, project, layouts, target, argument, value, false)?
    argument_c = value.value.clone()
    if (value.ty.kind == "str") {
        held = "arg_" + output.clone()
        current = moveStructStringField(argument, value, "KuProjectionString " + held.clone(), current)?
        argument_c = held
    }
    current.source = current.source + "    " + output.clone() + " = " + dependency.symbol.clone() + "(" + argument_c + ");\n"
    current.dependencies = addStringDependency(current.dependencies, dependency)
    return ok(current)
}

fn lowerStructString(&supplied: [SuppliedModule], &project: ProjectBindings, &layouts: [StructLayout],
                     &bindings: [GuardBinding], id: int, depth: int, can_convert: bool, flow: StructStringFlow): StructStringFlow! {
    if (depth >= 32) {
        RejectLayout("struct_string_depth", "imported string expressions accept at most 32 levels",
            DeclarationSpan(supplied[0].named.parsed.arena.nodes[id - 1]))?
    }
    node = supplied[0].named.parsed.arena.nodes[id - 1].clone()
    current = flow
    output = "s" + str(id)
    if (node.kind == "Binary" && node.text == "+" && node.edge_count == 2) {
        lhs = supplied[0].named.parsed.arena.edges[node.first_edge]
        rhs = supplied[0].named.parsed.arena.edges[node.first_edge + 1]
        current = lowerStructString(supplied, project, layouts, bindings, lhs, depth + 1, can_convert, current)?
        left = current.result.clone()
        current = lowerStructString(supplied, project, layouts, bindings, rhs, depth + 1, can_convert, current)?
        right = current.result.clone()
        // Match the source tree's left/right evaluation and concatenation
        // boundaries. A join failure cannot run subsequent direct calls.
        current.source = current.source + "    {\n        KuScalarStringPart pair[2] = {{" + left.clone() + ".ptr, " + left.clone() + ".len}, {" +
            right.clone() + ".ptr, " + right.clone() + ".len}};\n        failure = ku_scalar_string_join(pair, 2u, &" + output.clone() + ");\n"
        current.source = current.source + "        if (failure) goto cleanup;\n    }\n"
        current.source = current.source + "    ku_projection_string_drop(&" + right + ");\n    ku_projection_string_drop(&" + left + ");\n"
        current.uses_join = true
    } else {
        if (current.leaves == 64) {
            RejectLayout("struct_string_parts", "imported string expressions accept at most 64 parts", DeclarationSpan(node))?
        }
        if (node.kind == "String" && node.edge_count == 0) {
            literal = ScalarStringLiteral(node)?
            current.source = current.source + "    " + output.clone() + " = (KuProjectionString){ (uint8_t*)" + literal +
                ", 0u, KU_PROJECTION_STRING_STATIC };\n"
        } else if (node.kind == "Call" && node.edge_count == 2) {
            current = structStringCall(supplied, project, layouts, bindings, node, output, can_convert, current)?
        } else if (node.kind == "Field" && node.edge_count == 1) {
            value = GuardExpression(supplied[0].named.parsed.arena.nodes, supplied[0].named.parsed.arena.edges,
                bindings, layouts, id, 0, "    ")?
            current = moveStructStringField(node, value, output.clone(), current)?
        } else {
            RejectLayout("unsupported_struct_string_part", "expected a string literal, owned field, or checked direct call", DeclarationSpan(node))?
        }
        current.leaves = current.leaves + 1
    }
    current.slots = current.slots.push(id)
    current.result = output
    return ok(current)
}

fn emitProjectStringFunction(&supplied: [SuppliedModule], &project: ProjectBindings, &layouts: [StructLayout],
                             function_id: int): ProjectStructStringC! {
    fn_node = supplied[0].named.parsed.arena.nodes[function_id - 1].clone()
    if (fn_node.edge_count != 3) {
        RejectLayout("struct_string_signature", "expected one owned struct parameter and one str return", DeclarationSpan(fn_node))?
    }
    param = supplied[0].named.parsed.arena.nodes[supplied[0].named.parsed.arena.edges[fn_node.first_edge] - 1].clone()
    if (param.kind != "Parameter" || param.edge_count != 1 || param.int_value != 0) {
        RejectLayout("struct_string_signature", "expected one typed by-value struct parameter", DeclarationSpan(param))?
    }
    input = GuardExplicitType(project.modules[0].types, supplied[0].named.parsed.arena.nodes, layouts,
        supplied[0].named.parsed.arena.edges[param.first_edge])?
    result = GuardExplicitType(project.modules[0].types, supplied[0].named.parsed.arena.nodes, layouts,
        supplied[0].named.parsed.arena.edges[fn_node.first_edge + 1])?
    returned = supplied[0].named.parsed.arena.nodes[supplied[0].named.parsed.arena.edges[fn_node.first_edge + 2] - 1].clone()
    if (input.kind != "struct" || result.kind != "str" || returned.kind != "Return" || returned.edge_count != 1) {
        RejectLayout("struct_string_signature", "expected one owned struct parameter and one str return", DeclarationSpan(fn_node))?
    }
    param_id = supplied[0].named.parsed.arena.edges[param.first_edge]
    result_id = supplied[0].named.parsed.arena.edges[fn_node.first_edge + 1]
    param_type = ExplicitType(project.modules[0].types, param_id, DeclarationSpan(param))?
    result_type = ExplicitType(project.modules[0].types, result_id, DeclarationSpan(fn_node))?
    order = OrderCStructLayouts(layouts, layouts[input.layout - 1].module_index, layouts[input.layout - 1].node, DeclarationSpan(param))?
    binding = GuardBinding { name: param.text, ty: input, slot: 0, parameter: true, view: false }
    initial = StructStringFlow { source: "", slots: [], dependencies: [], moved_fields: [], result: "", leaves: 0, uses_join: false, uses_format: false }
    can_convert = HasScalarBuiltin(supplied[0].named, "str")
    lowered = lowerStructString(supplied, project, layouts, [binding.clone()],
        supplied[0].named.parsed.arena.edges[returned.first_edge], 0, can_convert, initial)?
    symbol = "ku_struct_string_" + str(function_id)
    text = ProjectionHeaders(true, true) + "#include <stdio.h>\n\n" + EmitOrderedStructLayouts(layouts, order)?
    if (lowered.uses_join) {
        text += "#include <string.h>\n\ntypedef KuProjectionString KuBootstrapString;\n"
        text += ScalarStringJoinHelpers(lowered.uses_format)
    }
    for dependency in lowered.dependencies {
        text += "extern KuProjectionString " + dependency.symbol + "(" + dependency.parameter + ");\n"
    }
    text += "\nKuProjectionString " + symbol.clone() + "(" + GuardCType(binding.ty, layouts) + " a0) {\n"
    text += "    KuProjectionString result = {0};\n"
    if (lowered.uses_join) { text += "    const char* failure = NULL;\n" }
    drops = GuardOwnedDrops(layouts, binding.ty.layout, "a0")
    if (drops == "") { text += "    (void)a0;\n" }
    for slot in lowered.slots {
        temporary = "s" + str(slot)
        text += "    KuProjectionString " + temporary.clone() + " = {0};\n"
        drops = "    ku_projection_string_drop(&" + temporary + ");\n" + drops
    }
    text += lowered.source + "    result = " + lowered.result.clone() + ";\n    " + lowered.result + " = (KuProjectionString){0};\n"
    // The common cleanup label is only needed when an operation can fail.
    if (lowered.uses_join) { text += "cleanup:\n" }
    text += drops
    if (lowered.uses_join) { text += "    if (failure) { fputs(failure, stderr); exit(EXIT_FAILURE); }\n" }
    text += "    return result;\n}\n"
    plan = LinkPlanDeclaration { unit: 1, node: function_id, symbol: symbol.clone(),
        parameters: [BoundLinkPlanType(param_type, 1, GuardCType(binding.ty, layouts), false)],
        result: BoundLinkPlanType(result_type, 1, "KuProjectionString", false), returns_result: false }
    return ok(ProjectStructStringC { symbol: symbol, dependencies: lowered.dependencies, source: text, entry_plan: plan })
}

fn foldAppendC(): str {
    return "static const char *ku_string_fold_append(KuProjectionString *output, KuProjectionString part) {\n"
        + "    KuScalarStringPart parts[2] = {{output->ptr, output->len}, {part.ptr, part.len}};\n"
        + "    KuProjectionString next = {0};\n"
        + "    const char *failure = ku_scalar_string_join(parts, 2u, &next);\n"
        + "    if (failure) return failure;\n"
        + "    ku_projection_string_drop(output);\n    *output = next;\n    return NULL;\n}\n\n"
}

fn foldFunctionC(&fold: StructStringFold, &symbol: str, &element: str, &array: str, &drops: str): str {
    text = "\nKuProjectionString " + symbol.clone() + "(" + array.clone() + " a0) {\n"
    text += "    if (!ku_string_fold_array_valid(&a0)) { fputs(\"invalid struct array ownership\\n\", stderr); exit(EXIT_FAILURE); }\n"
    text += "    KuProjectionString result = {(uint8_t*)" + fold.initial.clone() + ", 0u, KU_PROJECTION_STRING_STATIC};\n"
    text += "    KuProjectionString separator = {(uint8_t*)" + fold.separator.clone() + ", 0u, KU_PROJECTION_STRING_STATIC};\n"
    text += "    KuProjectionString line = {0};\n    const char *failure = NULL;\n    size_t cursor = 0;\n"
    text += "    while (cursor < a0.len) {\n"
    text += "        if (cursor != 0) {\n            failure = ku_string_fold_append(&result, separator);\n"
    text += "            if (failure) break;\n        }\n"
    // Advancing transfers ownership. From then on only the formatter may
    // drop this element; the failure path drops the still-owned suffix.
    text += "        " + element.clone() + " element = a0.data[cursor++];\n"
    text += "        line = " + fold.dependency.symbol.clone() + "(element);\n"
    text += "        failure = ku_string_fold_append(&result, line);\n        if (failure) break;\n"
    text += "        ku_projection_string_drop(&line);\n    }\n"
    if (drops != "") { text += "    for (; cursor < a0.len; ++cursor) {\n" + drops.clone() + "    }\n" }
    text += "    free(a0.data);\n    ku_projection_string_drop(&line);\n"
    text += "    if (failure) { ku_projection_string_drop(&result); fputs(failure, stderr); exit(EXIT_FAILURE); }\n"
    return text + "    return result;\n}\n"
}

fn emitProjectStringFold(&supplied: [SuppliedModule], &project: ProjectBindings, &layouts: [StructLayout],
                         function_id: int, &function: Node, &param: Node): ProjectStructStringC! {
    if (param.int_value != 0 || function.edge_count < 2) {
        RejectLayout("struct_string_fold_signature", "expected one owned struct array and explicit str result", DeclarationSpan(function))?
    }
    param_id = supplied[0].named.parsed.arena.edges[param.first_edge]
    return_id = supplied[0].named.parsed.arena.edges[function.first_edge + 1]
    element = CheckStructArrayType(supplied[0].named.parsed.arena.nodes, supplied[0].named.parsed.arena.edges,
        project.modules[0].types, param_id)?
    result = ExplicitType(project.modules[0].types, return_id, DeclarationSpan(function))?
    if (result.declaration_kind != "Builtin" || result.name != "str") {
        RejectLayout("struct_string_fold_signature", "expected one owned struct array and explicit str result", DeclarationSpan(function))?
    }
    root = LayoutIndex(layouts, element.module_index, element.declaration_node)
    order = OrderCStructLayouts(layouts, element.module_index, element.declaration_node, DeclarationSpan(param))?
    fold = ReadStructStringFold(supplied, project, layouts, supplied[0].named.parsed.arena, function, param, root)?
    return emitCheckedStringFold(layouts, order, fold, element, result, root, function_id)
}

fn emitCheckedStringFold(&layouts: [StructLayout], &order: CStructOrder, &fold: StructStringFold,
                         &element: TypeNameBinding, &result: TypeNameBinding, root: int, function_id: int): ProjectStructStringC! {
    element_c = fold.dependency.parameter.clone()
    array = "KuArray_" + element_c.clone()
    symbol = "ku_struct_string_" + str(function_id)
    text = ProjectionHeaders(true, true) + "#include <stdio.h>\n#include <string.h>\n\n"
    text += EmitOrderedStructLayouts(layouts, order)? + EmitStructArrayHeader(element_c, array)
    text += EmitStructArrayReadValidation(element_c, array, "ku_string_fold_array")
    text += "\ntypedef KuProjectionString KuBootstrapString;\n" + ScalarStringJoinHelpers(false) + foldAppendC()
    text += "extern KuProjectionString " + fold.dependency.symbol.clone() + "(" + element_c.clone() + ");\n"
    drops = GuardOwnedDrops(layouts, root, "a0.data[cursor]")
    text += foldFunctionC(fold, symbol, element_c, array, drops)
    parameter = BoundLinkPlanType(element, 1, array, false)
    parameter.kind = "StructArray"
    plan = LinkPlanDeclaration { unit: 1, node: function_id, symbol: symbol.clone(), parameters: [parameter],
        result: BoundLinkPlanType(result, 1, "KuProjectionString", false), returns_result: false }
    return ok(ProjectStructStringC { symbol: symbol, dependencies: [fold.dependency.clone()], source: text, entry_plan: plan })
}

fn emitSelectedStringFunction(&supplied: [SuppliedModule], &project: ProjectBindings, &layouts: [StructLayout],
                              function_id: int): ProjectStructStringC! {
    function = supplied[0].named.parsed.arena.nodes[function_id - 1].clone()
    if (function.edge_count > 0) {
        param = supplied[0].named.parsed.arena.nodes[supplied[0].named.parsed.arena.edges[function.first_edge] - 1].clone()
        if (param.kind == "Parameter" && param.edge_count == 1
            && supplied[0].named.parsed.arena.nodes[supplied[0].named.parsed.arena.edges[param.first_edge] - 1].kind == "TypeArray") {
            return emitProjectStringFold(supplied, project, layouts, function_id, function, param)
        }
    }
    return emitProjectStringFunction(supplied, project, layouts, function_id)
}

fn EmitProjectStructStringC(&supplied: [SuppliedModule], &function: str): ProjectStructStringC! {
    start = Span { line: 1, column: 1, offset: 0, end_line: 1, end_column: 1, end_offset: 0 }
    if (supplied.len() == 0) { RejectLayout("unknown_struct_string_function", "expected a supplied project module", start.clone())? }
    index = 0
    while (index < supplied[0].named.names.declarations.len()) {
        entry = supplied[0].named.names.declarations[index].clone()
        if (entry.kind == "Function" && entry.name == function) {
            project = BindProjectModules(supplied)?
            layouts = BuildStructLayouts(supplied[0].named, project.modules[0].types, supplied)?
            return emitSelectedStringFunction(supplied, project, layouts, entry.node)
        }
        index = index + 1
    }
    RejectLayout("unknown_struct_string_function", "undefined struct-to-string function '" + function.clone() + "'", start)?
    return ok(ProjectStructStringC { symbol: "", dependencies: [], source: "", entry_plan: EmptyLinkPlanDeclaration() })
}
