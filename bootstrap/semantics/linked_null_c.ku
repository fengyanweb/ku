import { Node } from "../stage2/ast.ku"
import { Span } from "../stage2/span.ku"
import { DeclarationSpan } from "./names.ku"
import { SuppliedModule } from "./imports.ku"
import { BindProjectModules } from "./project_bindings.ku"
import { RejectLayout } from "./struct_layouts.ku"
import { CTypeName, ContainsType, EmitLayout, ProjectionHeaders } from "./struct_projection_c.ku"
import { EmitOwnedStructOperations, EmitStructArrayHeader, EmitStructArrayReadValidation, EmitTryCloneString } from "./struct_array_c.ku"
import { GuardArithmetic, GuardStringEquality } from "./guarded_struct_c.ku"
import { StructResultHeader } from "./struct_result_c.ku"
import { BoundLinkPlanType, LinkPlanDeclaration, LinkPlanType, NullLinkPlanResult } from "./link_plan_c.ku"
import { LinkedNullArrayPrefix, LinkedNullCType, LinkedNullChild, LinkedNullEntry, LinkedNullFunction, LinkedNullNode,
         LinkedNullOwner, LinkedNullParameterType, LinkedNullProject, LinkedNullPrototype, LinkedNullType } from "./linked_null_types_c.ku"
import { AddLinkedNullSlot, LinkedNullBinding, LinkedNullState, LowerLinkedNullRead,
         MoveLinkedNullSlot, NewLinkedNullState } from "./linked_null_read_c.ku"
import { LowerLinkedNullTry, LowerLinkedNullValue } from "./linked_null_values_c.ku"

struct LinkedNullC {
    symbol: str
    links: [LinkedNullFunction]
    source: str
    entry_plan: LinkPlanDeclaration
}

struct LinkedNullParameters {
    state: LinkedNullState
    signature: str
    body_start: int
    plan: [LinkPlanType]
}

fn readParameters(&project: LinkedNullProject, &function: Node): LinkedNullParameters! {
    state = NewLinkedNullState()
    signature = ""
    plan: [LinkPlanType] = []
    index = 0
    validation = ""
    while (index < function.edge_count) {
        node = LinkedNullNode(project, 1, LinkedNullChild(project, 1, function, index))
        if (node.kind != "Parameter") { break }
        if (node.edge_count != 1 || node.int_value < 0 || node.int_value > 1 || LinkedNullBinding(state.slots, node.text) != 0) {
            RejectLayout("linked_entry_parameter", "expected distinct explicitly typed parameters", DeclarationSpan(node))?
        }
        view = node.int_value == 1
        ty = LinkedNullParameterType(project, LinkedNullChild(project, 1, node, 0), view)?
        name = "a" + str(index)
        if (index != 0) { signature += ", " }
        c_type = LinkedNullCType(ty)?
        signature += c_type.clone() + " " + name.clone()
        plan = plan.push(BoundLinkPlanType(ty, 1, c_type, view))
        if (view) {
            validation += "    if (!" + LinkedNullArrayPrefix(ty) + "_valid(" + name.clone() + ") || (uintmax_t)"
                + name.clone() + "->len > (uintmax_t)INT64_MAX) { invalid_array = true; goto cleanup; }\n"
        }
        slot = AddLinkedNullSlot(project, state, node.text, name.clone(), ty, true)?
        state = slot.state
        state.code = state.code + "    (void)" + name + ";\n"
        index = index + 1
    }
    if (index >= function.edge_count - 1) {
        RejectLayout("linked_null_signature", "entry requires a declared null! result and a body", DeclarationSpan(function))?
    }
    result = LinkedNullNode(project, 1, LinkedNullChild(project, 1, function, index))
    if (result.kind != "TypeResult" || result.edge_count != 1) {
        RejectLayout("linked_null_signature", "expected an explicitly declared null! result", DeclarationSpan(result))?
    }
    inner = LinkedNullType(project, 1, LinkedNullChild(project, 1, result, 0))?
    if (inner.declaration_kind != "Builtin" || inner.name != "null") {
        RejectLayout("linked_null_signature", "expected a null! result", inner.span)?
    }
    if (index == 0) { signature = "void" }
    state.code = state.code + validation
    return ok(LinkedNullParameters { state: state, signature: signature, body_start: index + 1, plan: plan })
}

fn preserveLinkedOwners(&before: LinkedNullState, &after: LinkedNullState, &statement: Node): null! {
    index = 0
    while (index < before.slots.len()) {
        if (LinkedNullOwner(before.slots[index].value.ty) && before.slots[index].live != after.slots[index].live) {
            RejectLayout("linked_control_move", "conditional code cannot consume an outer owner", DeclarationSpan(statement))?
        }
        index = index + 1
    }
    return ok(null)
}

fn addGuardedCall(&project: LinkedNullProject, state: LinkedNullState, &statement: Node): LinkedNullState! {
    body = LinkedNullNode(project, 1, LinkedNullChild(project, 1, statement, 1))
    if (body.kind == "Assign") { return addGuardedAssignment(project, state, statement) }
    if (body.kind != "ExprStmt" || body.edge_count != 1) {
        RejectLayout("unsupported_linked_guard", "expected one checked call in the guard", DeclarationSpan(body))?
    }
    guard = LowerLinkedNullRead(project, state, LinkedNullChild(project, 1, statement, 0), 0)?
    if (guard.value.ty.declaration_kind != "Builtin" || guard.value.ty.name != "bool") {
        RejectLayout("linked_guard_type", "expected a readonly bool condition", DeclarationSpan(statement))?
    }
    guard.state.code = guard.state.code + "    if (" + guard.value.text + ") {\n"
    taken = LowerLinkedNullTry(project, guard.state.clone(), body)?
    preserveLinkedOwners(guard.state, taken, body)?
    taken.code = taken.code + "    }\n"
    return ok(taken)
}

fn isReadonlyArrayLimit(&project: LinkedNullProject, &state: LinkedNullState, node_id: int): bool {
    node = LinkedNullNode(project, 1, node_id)
    if (node.kind == "Binary" && node.text == "-" && node.edge_count == 2) {
        amount = LinkedNullNode(project, 1, LinkedNullChild(project, 1, node, 1))
        if (amount.kind != "Int" || amount.edge_count != 0 || amount.int_value < 0) { return false }
        node = LinkedNullNode(project, 1, LinkedNullChild(project, 1, node, 0))
    }
    if (node.kind != "Call" || node.edge_count != 1) { return false }
    target = LinkedNullNode(project, 1, LinkedNullChild(project, 1, node, 0))
    if (target.kind != "Field" || target.edge_count != 1 || target.text != "len") { return false }
    receiver = LinkedNullNode(project, 1, LinkedNullChild(project, 1, target, 0))
    if (receiver.kind != "Variable" || receiver.edge_count != 0) { return false }
    slot = LinkedNullBinding(state.slots, receiver.text)
    return slot > 0 && state.slots[slot - 1].value.ty.declaration_kind == "StructArray"
}

fn countedIndex(&project: LinkedNullProject, &state: LinkedNullState, &loop: Node, &initial: Node, &step: Node): int! {
    guard = LinkedNullNode(project, 1, LinkedNullChild(project, 1, loop, 0))
    if (guard.kind != "Binary" || guard.edge_count != 2 || guard.text != "<" ||
        !isReadonlyArrayLimit(project, state, LinkedNullChild(project, 1, guard, 1))) {
        RejectLayout("unsupported_linked_loop", "counted while requires a readonly array length bound", DeclarationSpan(guard))?
    }
    left = LinkedNullNode(project, 1, LinkedNullChild(project, 1, guard, 0))
    slot = LinkedNullBinding(state.slots, left.text)
    if (left.kind != "Variable" || left.edge_count != 0 || slot == 0 || state.slots[slot - 1].value.ty.name != "int" ||
        initial.kind != "Assign" || initial.edge_count != 1 || initial.text != left.text ||
        step.kind != "Assign" || step.edge_count != 1 || step.text != left.text) {
        RejectLayout("unsupported_linked_loop", "counted while requires one distinct int cursor", DeclarationSpan(loop))?
    }
    zero = LinkedNullNode(project, 1, LinkedNullChild(project, 1, initial, 0))
    rhs = LinkedNullNode(project, 1, LinkedNullChild(project, 1, step, 0))
    if (zero.kind != "Int" || zero.edge_count != 0 || zero.int_value != 0 || rhs.kind != "Binary" || rhs.edge_count != 2 || rhs.text != "+") {
        RejectLayout("unsupported_linked_loop", "counted while requires initialization to zero and a unit increment", DeclarationSpan(loop))?
    }
    cursor = LinkedNullNode(project, 1, LinkedNullChild(project, 1, rhs, 0))
    one = LinkedNullNode(project, 1, LinkedNullChild(project, 1, rhs, 1))
    if (cursor.kind != "Variable" || cursor.edge_count != 0 || cursor.text != left.text ||
        one.kind != "Int" || one.edge_count != 0 || one.int_value != 1) {
        RejectLayout("unsupported_linked_loop", "counted while must advance the cursor by one", DeclarationSpan(step))?
    }
    return ok(slot)
}

fn addCountedLoop(&project: LinkedNullProject, state: LinkedNullState, &statement: Node, &initial: Node): LinkedNullState! {
    step = LinkedNullNode(project, 1, LinkedNullChild(project, 1, statement, statement.edge_count - 1))
    cursor = countedIndex(project, state, statement, initial, step)?
    next = state
    next.code = next.code + "    while (true) {\n"
    guard = LowerLinkedNullRead(project, next, LinkedNullChild(project, 1, statement, 0), 0)?
    guard.state.code = guard.state.code + "    if (!(" + guard.value.text + ")) break;\n"
    next = guard.state
    index = 1
    while (index < statement.edge_count - 1) {
        item = LinkedNullNode(project, 1, LinkedNullChild(project, 1, statement, index))
        if (item.kind == "If" && item.edge_count == 2 && item.int_value == 1) {
            body = LinkedNullNode(project, 1, LinkedNullChild(project, 1, item, 1))
            if (body.kind != "ExprStmt") {
                RejectLayout("unsupported_linked_loop_body", "counted while may only guard checked calls", DeclarationSpan(body))?
            }
            next = addGuardedCall(project, next, item)?
        } else {
            RejectLayout("unsupported_linked_loop_body", "counted while may only guard checked calls", DeclarationSpan(item))?
        }
        index = index + 1
    }
    advanced = LowerLinkedNullRead(project, next, LinkedNullChild(project, 1, step, 0), 0)?
    advanced.state.code = advanced.state.code + "    " + advanced.state.slots[cursor - 1].value.text.clone() + " = " + advanced.value.text + ";\n    }\n"
    return ok(advanced.state)
}

fn addLocal(&project: LinkedNullProject, state: LinkedNullState, &statement: Node, id: int): LinkedNullState! {
    if (LinkedNullBinding(state.slots, statement.text) != 0) {
        RejectLayout("linked_binding_shadowed", "expected a new initialized local binding", DeclarationSpan(statement))?
    }
    value = LowerLinkedNullValue(project, state, LinkedNullChild(project, 1, statement, 0), 0)?
    ty = value.value.ty.clone()
    slot = AddLinkedNullSlot(project, value.state, statement.text.clone(), "l" + str(id), ty, false)?
    slot.state.code = slot.state.code + "    " + slot.value.text.clone() + " = " + value.value.text.clone() + ";\n"
    slot.state.slots[slot.value.slot - 1].live = true
    return MoveLinkedNullSlot(slot.state, value.value)
}

fn addGuardedAssignment(&project: LinkedNullProject, state: LinkedNullState, &statement: Node): LinkedNullState! {
    guard_id = LinkedNullChild(project, 1, statement, 0)
    guard_node = LinkedNullNode(project, 1, guard_id)
    if (guard_node.kind != "Variable" || guard_node.edge_count != 0) {
        RejectLayout("unsupported_linked_guard", "expected a bool binding in the guard", DeclarationSpan(guard_node))?
    }
    guard = LowerLinkedNullValue(project, state, guard_id, 0)?
    if (guard.value.ty.declaration_kind != "Builtin" || guard.value.ty.name != "bool") {
        RejectLayout("unsupported_linked_guard", "expected a bool binding in the guard", DeclarationSpan(guard_node))?
    }
    branch = LinkedNullNode(project, 1, LinkedNullChild(project, 1, statement, 1))
    if (branch.kind != "Assign" || branch.edge_count != 1) {
        RejectLayout("unsupported_linked_guard", "expected a single assignment in the guard", DeclarationSpan(branch))?
    }
    slot = LinkedNullBinding(guard.state.slots, branch.text)
    if (slot == 0 || !guard.state.slots[slot - 1].live || guard.state.slots[slot - 1].value.ty.name != "str"
        || guard.state.slots[slot - 1].value.ty.declaration_kind != "Builtin") {
        RejectLayout("unsupported_linked_guard", "expected an initialized str target in the guard", DeclarationSpan(branch))?
    }
    rhs = LinkedNullChild(project, 1, branch, 0)
    literal = LinkedNullNode(project, 1, rhs)
    if (literal.kind != "String" || literal.edge_count != 0) {
        RejectLayout("unsupported_linked_guard", "guarded str assignment requires a static literal", DeclarationSpan(literal))?
    }
    target = guard.state.slots[slot - 1].value.text.clone()
    value = LowerLinkedNullValue(project, guard.state, rhs, 0)?
    value.state.code = value.state.code + "    if (" + guard.value.text + ") {\n        ku_projection_string_drop(&" + target.clone() + ");\n"
        + "        " + target + " = " + value.value.text + ";\n    }\n"
    return ok(value.state)
}

fn lowerLinkedFailure(&project: LinkedNullProject, state: LinkedNullState, &statement: Node): LinkedNullState! {
    if (statement.kind != "Fail" || statement.edge_count != 1) {
        RejectLayout("unsupported_linked_terminal", "expected a final Error fail or return ok(null)", DeclarationSpan(statement))?
    }
    literal = LinkedNullNode(project, 1, LinkedNullChild(project, 1, statement, 0))
    if (literal.kind != "ObjectLiteral" || literal.edge_count != 3) {
        RejectLayout("unsupported_linked_error", "expected Error domain, code and message", DeclarationSpan(literal))?
    }
    next = state
    seen: [str] = []
    index = 0
    while (index < literal.edge_count) {
        field = LinkedNullNode(project, 1, LinkedNullChild(project, 1, literal, index))
        label = field.text.clone()
        if (field.kind != "ObjectLiteralField" || field.edge_count != 1 || (label != "domain" && label != "code" && label != "message")
            || ContainsType(seen, label)) {
            RejectLayout("invalid_linked_error_field", "expected each named Error field once", DeclarationSpan(field))?
        }
        item = LinkedNullChild(project, 1, field, 0)
        node = LinkedNullNode(project, 1, item)
        if ((node.kind != "Variable" && node.kind != "String") || node.edge_count != 0) {
            RejectLayout("unsupported_linked_error_field", "error fields require initialized str bindings or literals", DeclarationSpan(node))?
        }
        value = LowerLinkedNullValue(project, next.clone(), item, 0)?
        if (value.value.ty.declaration_kind != "Builtin" || value.value.ty.name != "str") {
            RejectLayout("unsupported_linked_error_field", "error fields require str", DeclarationSpan(node))?
        }
        value.state.code = value.state.code + "    result.error." + label.clone() + " = " + value.value.text.clone() + ";\n"
        owner = value.value.clone()
        next = MoveLinkedNullSlot(value.state, owner)?
        seen = seen.push(label)
        index = index + 1
    }
    next.code = next.code + "    goto cleanup;\n"
    return ok(next)
}

fn unshadowedOk(&project: LinkedNullProject, &state: LinkedNullState): bool {
    if (LinkedNullBinding(state.slots, "ok") != 0) { return false }
    for name in project.supplied[0].named.names.declarations.clone() {
        if (name.name == "ok") { return false }
    }
    for binding in project.binding[0].imports.clone() {
        if (binding.local_name == "ok") { return false }
    }
    return true
}

fn lowerLinkedSuccess(&project: LinkedNullProject, state: LinkedNullState, &statement: Node): LinkedNullState! {
    if (statement.edge_count != 1) {
        RejectLayout("unsupported_linked_success", "expected return ok(null)", DeclarationSpan(statement))?
    }
    call = LinkedNullNode(project, 1, LinkedNullChild(project, 1, statement, 0))
    if (call.kind != "Call" || call.edge_count != 2) {
        RejectLayout("unsupported_linked_success", "expected return ok(null)", DeclarationSpan(call))?
    }
    callee = LinkedNullNode(project, 1, LinkedNullChild(project, 1, call, 0))
    value = LinkedNullNode(project, 1, LinkedNullChild(project, 1, call, 1))
    if (callee.kind != "Variable" || callee.edge_count != 0 || callee.text != "ok"
        || value.kind != "Null" || value.edge_count != 0 || !unshadowedOk(project, state)) {
        RejectLayout("unsupported_linked_success", "expected builtin ok with literal null", DeclarationSpan(call))?
    }
    next = state
    next.code = next.code + "    result.ok = true;\n    goto cleanup;\n"
    return ok(next)
}

fn lowerLinkedBody(&project: LinkedNullProject, &function: Node, state: LinkedNullState, start: int): LinkedNullState! {
    next = state
    index = start
    while (index < function.edge_count) {
        id = LinkedNullChild(project, 1, function, index)
        statement = LinkedNullNode(project, 1, id)
        if (index == function.edge_count - 1) {
            if (statement.kind == "Return") { return lowerLinkedSuccess(project, next, statement) }
            return lowerLinkedFailure(project, next, statement)
        }
        if (statement.kind == "Assign" && statement.edge_count == 1) {
            next = addLocal(project, next, statement, id)?
        } else if (statement.kind == "If" && statement.edge_count == 2 && statement.int_value == 1) {
            next = addGuardedCall(project, next, statement)?
        } else if (statement.kind == "While" && statement.edge_count >= 2 && index > start) {
            initial = LinkedNullNode(project, 1, LinkedNullChild(project, 1, function, index - 1))
            next = addCountedLoop(project, next, statement, initial)?
        } else if (statement.kind == "ExprStmt" && statement.edge_count == 1) {
            next = LowerLinkedNullTry(project, next, statement)?
        } else {
            RejectLayout("unsupported_linked_statement", "expected a fresh local, guarded statement, counted while or checked call", DeclarationSpan(statement))?
        }
        index = index + 1
    }
    RejectLayout("unsupported_linked_terminal", "expected a final Error fail or return ok(null)", DeclarationSpan(function))?
    return ok(next)
}

fn linkedSource(&body: LinkedNullState, &symbol: str, &signature: str): str! {
    // Keep the external prototypes independent of the selected entry's C
    // name. The linker consumes declarations resolved from the source graph.
    text = ProjectionHeaders(true, body.drops != "") + GuardArithmetic(body.uses_add, body.uses_sub)
        + GuardStringEquality(body.uses_string_equal)
    if (body.arrays.len() > 0) { text += "#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n" }
    if (body.uses_clone) {
        text += "#include <stdio.h>\n#include <string.h>\n\n" + EmitTryCloneString("ku_linked_clone_string")
    }
    for layout in body.layouts.clone() { text += EmitLayout(layout, true, true)? }
    for array in body.arrays.clone() {
        element = CTypeName(array.module_index, array.declaration_node)
        array_type = "KuArray_" + element.clone()
        text += EmitStructArrayHeader(element, array_type) + EmitStructArrayReadValidation(element, array_type, LinkedNullArrayPrefix(array))
    }
    for layout in body.element_clones.clone() {
        text += EmitOwnedStructOperations(body.layouts, layout, "ku_linked_element_" + str(layout), true)
    }
    text += StructResultHeader()
    for dependency in body.links.clone() { text += LinkedNullPrototype(dependency)? }
    text += "\nKuBootstrapResultNull " + symbol.clone() + "(" + signature.clone() + ") {\n"
    text += "    KuBootstrapResultNull result = {0};\n"
    clone = body.uses_clone || body.element_clones.len() > 0
    if (clone) { text += "    bool out_of_memory = false;\n" }
    if (body.arrays.len() > 0) { text += "    bool invalid_array = false;\n" }
    if (body.uses_add || body.uses_sub) { text += "    bool overflow = false;\n" }
    if (body.uses_index) { text += "    bool index_failed = false;\n    int64_t failure_index = 0;\n    size_t failure_length = 0;\n" }
    text += body.declarations.clone() + body.code.clone() + "cleanup:\n" + body.drops.clone()
    if (clone) { text += "    if (out_of_memory) { fputs(\"out of memory\\n\", stderr); exit(EXIT_FAILURE); }\n" }
    if (body.arrays.len() > 0) { text += "    if (invalid_array) { fputs(\"invalid struct array ownership\\n\", stderr); exit(EXIT_FAILURE); }\n" }
    if (body.uses_add || body.uses_sub) { text += "    if (overflow) { fputs(\"integer overflow\\n\", stderr); exit(EXIT_FAILURE); }\n" }
    if (body.uses_index) {
        text += "    if (index_failed) { fprintf(stderr, \"array/index_out_of_bounds: index %lld out of bounds for length %zu\\n\", "
            + "(long long)failure_index, failure_length); exit(EXIT_FAILURE); }\n"
    }
    return ok(text + "    return result;\n}\n")
}

fn EmitLinkedNullC(&supplied: [SuppliedModule], &entry_name: str): LinkedNullC! {
    if (supplied.len() == 0) {
        point = Span { line: 1, column: 1, offset: 0, end_line: 1, end_column: 1, end_offset: 0 }
        RejectLayout("missing_linked_entry_module", "a selected source module is required", point)?
    }
    bound = BindProjectModules(supplied)?
    project = LinkedNullProject { supplied: supplied.clone(), binding: bound.modules }
    id = LinkedNullEntry(project, entry_name)?
    function = LinkedNullNode(project, 1, id)
    parameters = readParameters(project, function)?
    body = lowerLinkedBody(project, function, parameters.state, parameters.body_start)?
    symbol = "ku_linked_null_" + str(id)
    source = linkedSource(body, symbol, parameters.signature)?
    plan = LinkPlanDeclaration { unit: 1, node: id, symbol: symbol.clone(), parameters: parameters.plan,
        result: NullLinkPlanResult(), returns_result: true }
    return ok(LinkedNullC { symbol: symbol, links: body.links, source: source, entry_plan: plan })
}
