import { ReadLinkedNullParameters } from "./linked_parameters_c.ku"
import { ManagedSourceCharactersErrors } from "./guarded_string_parts.ku"
import { OpenLinkedCharacterLoop, CloseLinkedCharacterLoop } from "./linked_char_iter_c.ku"
import { BindLinkedCatch, CheckLinkedGuardOwners, DropLinkedNullScope, MoveLinkedNullSlot } from "./linked_member_ownership.ku"
import { EmitLinkedNullDeclarations, FinishLinkedFunctionC } from "./linked_function_c.ku"
import { Node } from "../stage2/ast.ku"
import { Span } from "../stage2/span.ku"
import { DeclarationSpan } from "./names.ku"
import { TypeNameBinding } from "./type_names.ku"
import { SuppliedModule } from "./imports.ku"
import { BindProjectModules } from "./project_bindings.ku"
import { ReadLinkedErrorInitializer, RejectLayout } from "./struct_layouts.ku"
import { LinkedReadonlyExpression, LinkedSlotPrefix, ExitLinkedFailure, LinkedFailureTarget, LinkedNullBinding, LinkedNullExpression, LinkedNullFunction, LinkedNullRegion, LinkedNullSlot, LinkedNullState, LinkPlanDeclaration, PreserveLinkedOwners, ReadLinkedCatchParts, RestoreLinkedNullSlots } from "./link_plan_c.ku"
import { LinkedBuiltin, LinkedCheckedResultCType, LinkedCheckedResultPlan, LinkedNullArrayLimitName, LinkedNullArrayPrefix, LinkedNullCType, LinkedNullChild, LinkedNullEntry,
         LinkedNullNode, LinkedNullProject, LinkedNullResultCleanupReference, LinkedNullType, LinkedStringResult, SameLinkedType } from "./linked_null_types_c.ku"
import { AddLinkedNullSlot, LowerLinkedArrayLocal, LowerLinkedNullRead,
         RegisterLinkedNullType } from "./linked_null_read_c.ku"
import { LowerLinkedArrayAppend, LowerLinkedSuccess,
         LowerLinkedNullValue, LowerLinkedStringRebind } from "./linked_null_values_c.ku"
import { LowerLinkedStatementCall } from "./project_struct_string_c.ku"

struct LinkedNullC {
    symbol: str
    links: [LinkedNullFunction]
    source: str
    entry_plan: LinkPlanDeclaration
}

fn lowerLinkedPredicate(&project: LinkedNullProject, state: LinkedNullState, id: int): LinkedNullExpression! {
    node = LinkedNullNode(project, 1, id)
    equality = node.text == "==" || node.text == "!="
    if (node.kind != "Binary" || node.edge_count != 2 || !equality) {
        return LowerLinkedNullRead(project, state, id, 0)
    }
    left_id = LinkedNullChild(project, 1, node, 0)
    if (LinkedNullNode(project, 1, left_id).kind != "TryUnwrap") {
        return LowerLinkedNullRead(project, state, id, 0)
    }
    before = state.slots.len()
    left = LowerLinkedNullValue(project, state, left_id, 0)?
    right = LowerLinkedNullRead(project, left.state, LinkedNullChild(project, 1, node, 1), 0)?
    at = DeclarationSpan(node)
    if (!LinkedStringResult(left.value.ty) || !LinkedStringResult(right.value.ty)) {
        RejectLayout("linked_checked_comparison", "expected a checked str and a readonly str", at.clone())?
    }
    compare = "ku_guard_string_equal(" + left.value.text + ", " + right.value.text + ")"
    if (node.text == "!=") { compare = "!" + compare }
    name = "predicate" + str(id)
    right.state.uses_string_equal = true
    right.state.code += "    const bool " + name.clone() + " = " + compare + ";\n"
    done = DropLinkedNullScope(right.state, before)
    return ok(LinkedReadonlyExpression(done, LinkedBuiltin("bool", at), name))
}

fn addGuardedRegion(&project: LinkedNullProject, state: LinkedNullState, &statement: Node,
                    &result: TypeNameBinding, depth: int): LinkedNullRegion! {
    if (depth >= 32) {
        RejectLayout("linked_control_depth", "linked control flow allows at most 32 levels", DeclarationSpan(statement))?
    }
    if (statement.int_value < 0 || statement.int_value >= statement.edge_count) {
        RejectLayout("unsupported_linked_guard", "expected valid then and else boundaries", DeclarationSpan(statement))?
    }
    guard_id = LinkedNullChild(project, 1, statement, 0)
    guard = lowerLinkedPredicate(project, state, guard_id)?
    if (guard.value.ty.declaration_kind != "Builtin" || guard.value.ty.name != "bool") {
        RejectLayout("linked_guard_type", "expected a readonly bool condition", DeclarationSpan(statement))?
    }
    outer = guard.state.slots.clone()
    guard.state.code += "    if (" + guard.value.text + ") {\n"
    split = statement.int_value + 1
    then_region = statement.clone()
    then_region.edge_count = split
    taken = lowerLinkedRegion(project, then_region, guard.state, 1, result, depth + 1)?
    if (split == statement.edge_count) {
        if (taken.terminal) { taken.state = RestoreLinkedNullSlots(taken.state, outer) }
        else {
            CheckLinkedGuardOwners(outer, taken.state, statement)?
            taken.state = DropLinkedNullScope(taken.state, outer.len())
        }
        taken.state.code += "    }\n"
        return ok(LinkedNullRegion { state: taken.state, terminal: false })
    }

    after_then: [LinkedNullSlot] = []
    if (!taken.terminal) {
        after_then = LinkedSlotPrefix(taken.state.slots, outer.len())
        taken.state = DropLinkedNullScope(taken.state, outer.len())
    }
    taken.state = RestoreLinkedNullSlots(taken.state, outer)
    taken.state.code += "    } else {\n"
    other = lowerLinkedRegion(project, statement, taken.state, split, result, depth + 1)?
    if (!other.terminal) {
        if (!taken.terminal) { PreserveLinkedOwners(after_then, other.state.slots, statement)? }
        other.state = DropLinkedNullScope(other.state, outer.len())
    } else if (!taken.terminal) {
        other.state = RestoreLinkedNullSlots(other.state, after_then)
    }
    other.state.code += "    }\n"
    return ok(LinkedNullRegion { state: other.state, terminal: taken.terminal && other.terminal })
}

fn isReadonlyArrayLimit(&project: LinkedNullProject, &state: LinkedNullState, node_id: int): bool {
    name = LinkedNullArrayLimitName(project, node_id)
    slot = LinkedNullBinding(state.slots, name)
    if (slot == 0) { return false }
    kind = state.slots[slot - 1].value.ty.declaration_kind.clone()
    return kind == "StructArray" || kind == "BuiltinArray"
}

fn countedIndex(&project: LinkedNullProject, &state: LinkedNullState, &loop: Node, &initial: Node, &step: Node): int! {
    guard = LinkedNullNode(project, 1, LinkedNullChild(project, 1, loop, 0))
    if (guard.kind != "Binary" || guard.edge_count != 2 || guard.text != "<" ||
        !isReadonlyArrayLimit(project, state, LinkedNullChild(project, 1, guard, 1))) {
        RejectLayout("unsupported_linked_loop", "counted while requires a readonly array length bound", DeclarationSpan(guard))?
    }
    left = LinkedNullNode(project, 1, LinkedNullChild(project, 1, guard, 0))
    slot = LinkedNullBinding(state.slots, left.text)
    if (left.kind != "Variable" || left.edge_count != 0 || slot == 0 || state.slots[slot - 1].value.ty.name != "int" ||
        initial.kind != "Assign" || initial.edge_count != 1 || initial.text != left.text ||
        step.kind != "Assign" || step.edge_count != 1 || step.text != left.text) {
        RejectLayout("unsupported_linked_loop", "counted while requires one distinct int cursor", DeclarationSpan(loop))?
    }
    zero = LinkedNullNode(project, 1, LinkedNullChild(project, 1, initial, 0))
    rhs = LinkedNullNode(project, 1, LinkedNullChild(project, 1, step, 0))
    if (zero.kind != "Int" || zero.edge_count != 0 || zero.int_value != 0 || rhs.kind != "Binary" || rhs.edge_count != 2 || rhs.text != "+") {
        RejectLayout("unsupported_linked_loop", "counted while requires initialization to zero and a unit increment", DeclarationSpan(loop))?
    }
    cursor = LinkedNullNode(project, 1, LinkedNullChild(project, 1, rhs, 0))
    one = LinkedNullNode(project, 1, LinkedNullChild(project, 1, rhs, 1))
    if (cursor.kind != "Variable" || cursor.edge_count != 0 || cursor.text != left.text ||
        one.kind != "Int" || one.edge_count != 0 || one.int_value != 1) {
        RejectLayout("unsupported_linked_loop", "counted while must advance the cursor by one", DeclarationSpan(step))?
    }
    return ok(slot)
}

fn addCountedLoop(&project: LinkedNullProject, state: LinkedNullState, &statement: Node, &initial: Node,
                  &result: TypeNameBinding, depth: int): LinkedNullState! {
    step = LinkedNullNode(project, 1, LinkedNullChild(project, 1, statement, statement.edge_count - 1))
    cursor = countedIndex(project, state, statement, initial, step)?
    outer = state.slots.clone()
    next = state
    next.code = next.code + "    while (true) {\n"
    guard = LowerLinkedNullRead(project, next, LinkedNullChild(project, 1, statement, 0), 0)?
    guard.state.code = guard.state.code + "    if (!(" + guard.value.text + ")) break;\n"
    next = guard.state
    locals = next.slots.len()
    index = 1
    while (index < statement.edge_count - 1) {
        id = LinkedNullChild(project, 1, statement, index)
        item = LinkedNullNode(project, 1, id)
        if (item.kind == "If" && item.edge_count == 2 && item.int_value == 1) {
            body = LinkedNullNode(project, 1, LinkedNullChild(project, 1, item, 1))
            if (body.kind != "ExprStmt") {
                RejectLayout("unsupported_linked_loop_body", "expected a guard of a checked call", DeclarationSpan(body))?
            }
            next = (addGuardedRegion(project, next, item, result, depth)?).state
        } else if (item.kind == "Assign" && item.edge_count == 1) {
            found = LinkedNullBinding(next.slots, item.text)
            if (found == 0) { next = addLocal(project, next, item, id)? }
            else { next = LowerLinkedArrayAppend(project, next, item, found)? }
        } else {
            RejectLayout("unsupported_linked_loop_body", "expected a guard, fresh local or move append", DeclarationSpan(item))?
        }
        index = index + 1
    }
    PreserveLinkedOwners(outer, next.slots, statement)?
    next = DropLinkedNullScope(next, locals)
    advanced = LowerLinkedNullRead(project, next, LinkedNullChild(project, 1, step, 0), 0)?
    advanced.state.code = advanced.state.code + "    " + advanced.state.slots[cursor - 1].value.text.clone() + " = " + advanced.value.text + ";\n    }\n"
    return ok(advanced.state)
}

fn addLocal(&project: LinkedNullProject, state: LinkedNullState, &statement: Node, id: int): LinkedNullState! {
    if (LinkedNullBinding(state.slots, statement.text) != 0) {
        RejectLayout("linked_binding_shadowed", "expected a new initialized local binding", DeclarationSpan(statement))?
    }
    initializer = statement.edge_count - 1
    value = LowerLinkedNullValue(project, state, LinkedNullChild(project, 1, statement, initializer), 0)?
    ty = value.value.ty.clone()
    if (initializer == 1) {
        declared = LinkedNullType(project, 1, LinkedNullChild(project, 1, statement, 0))?
        if (!SameLinkedType(declared, ty)) {
            RejectLayout("linked_local_type", "initializer must match the declared local type", ty.span.clone())?
        }
    }
    slot = AddLinkedNullSlot(project, value.state, statement.text.clone(), "l" + str(id), ty, false)?
    slot.state.code = slot.state.code + "    " + slot.value.text.clone() + " = " + value.value.text.clone() + ";\n"
    slot.state.slots[slot.value.slot - 1].live = true
    return MoveLinkedNullSlot(slot.state, value.value)
}

fn lowerLinkedFailure(&project: LinkedNullProject, state: LinkedNullState, &statement: Node): LinkedNullState! {
    if (statement.kind != "Fail" || statement.edge_count != 1) {
        RejectLayout("unsupported_linked_terminal", "expected a final Error fail or return ok(null)", DeclarationSpan(statement))?
    }
    id = LinkedNullChild(project, 1, statement, 0)
    literal = LinkedNullNode(project, 1, id)
    target = LinkedFailureTarget(state)
    if (literal.kind == "Variable" && literal.edge_count == 0) {
        error = LowerLinkedNullValue(project, state, LinkedNullChild(project, 1, statement, 0), 0)?
        if (error.value.ty.declaration_kind != "CaughtError") {
            RejectLayout("unsupported_linked_error", "expected a caught Error owner", DeclarationSpan(literal))?
        }
        error.state.code += "    " + target + " = " + error.value.text.clone() + ";\n"
        owner = error.value.clone()
        moved = MoveLinkedNullSlot(error.state, owner)?
        return ok(ExitLinkedFailure(moved, "    "))
    }
    plan = ReadLinkedErrorInitializer(project.supplied[0].named, literal)?
    next = state
    destination = target.clone()
    if (plan.scratch) {
        ty = LinkedBuiltin("Error", DeclarationSpan(literal))
        ty.declaration_kind = "CaughtError"
        scratch = AddLinkedNullSlot(project, next, "", "error" + str(id), ty, false)?
        next = scratch.state
        destination = scratch.value.text
    }
    for field in plan.fields {
        value = LowerLinkedNullValue(project, next, field.expression, 0)?
        if (value.value.ty.declaration_kind != "Builtin" || value.value.ty.name != "str") {
            RejectLayout("unsupported_linked_error_field", "error fields require str", value.value.ty.span.clone())?
        }
        value.state.code += "    " + destination.clone() + "." + field.name + " = " + value.value.text.clone() + ";\n"
        owner = value.value
        if (owner.borrowed) {
            if (owner.slot == 0 || value.state.catch_slot != 0
                || value.state.slots[owner.slot - 1].value.ty.declaration_kind != "CaughtError") {
                RejectLayout("linked_error_field_owner", "error fields require an owned str or a terminal caught field", owner.ty.span.clone())?
            }
            value.state.code += "    " + owner.text.clone() + " = (KuProjectionString){0};\n"
            value.state.moved_error_fields = value.state.moved_error_fields.push(owner.text)
            next = value.state
        } else {
            next = MoveLinkedNullSlot(value.state, owner)?
        }
    }
    if (plan.scratch) {
        next.code += "    " + target + " = " + destination.clone() + ";\n"
            + "    " + destination + " = (KuBootstrapError){0};\n"
        cleared: [str] = []
        next.moved_error_fields = cleared
    }
    return ok(ExitLinkedFailure(next, "    "))
}

fn lowerLinkedCatch(&project: LinkedNullProject, state: LinkedNullState, &node: Node, id: int,
                    &result: TypeNameBinding, depth: int): LinkedNullRegion! {
    if (state.catch_slot != 0 || node.edge_count != 2 || depth >= 8) {
        RejectLayout("unsupported_linked_catch", "expected one terminal try with a named catch", DeclarationSpan(node))?
    }
    clauses = ReadLinkedCatchParts(project.supplied[0].named, node)?
    outer = state.slots.clone()
    ty = LinkedBuiltin("Error", DeclarationSpan(clauses.binding))
    ty.declaration_kind = "CaughtError"
    slot = AddLinkedNullSlot(project, state, "", "caught" + str(id), ty, false)?
    slot.state.catch_slot = slot.value.slot
    body = lowerLinkedRegion(project, clauses.protected, slot.state, 0, result, depth + 1)?
    if (!body.terminal) {
        RejectLayout("unsupported_linked_catch", "the protected body must return or fail", DeclarationSpan(clauses.protected))?
    }
    resumed = BindLinkedCatch(body.state, clauses.binding.text.clone(), clauses.binding, outer)?
    handled = lowerLinkedRegion(project, clauses.recovery, resumed, 0, result, depth + 1)?
    if (!handled.terminal) {
        RejectLayout("unsupported_linked_catch", "the handler must return or fail", DeclarationSpan(clauses.recovery))?
    }
    return ok(handled)
}

fn lowerLinkedRegion(&project: LinkedNullProject, &region: Node, state: LinkedNullState, start: int,
                     &result: TypeNameBinding, depth: int): LinkedNullRegion! {
    next = state
    index = start
    while (index < region.edge_count) {
        id = LinkedNullChild(project, 1, region, index)
        statement = LinkedNullNode(project, 1, id)
        if (statement.kind == "Return" || statement.kind == "Fail") {
            if (index != region.edge_count - 1) {
                RejectLayout("unsupported_linked_terminal", "expected the terminal at the end of its block", DeclarationSpan(statement))?
            }
            if (statement.kind == "Return") { next = LowerLinkedSuccess(project, next, statement, result)? }
            else { next = lowerLinkedFailure(project, next, statement)? }
            return ok(LinkedNullRegion { state: next, terminal: true })
        }
        if (statement.kind == "Try" && index == region.edge_count - 1) {
            return lowerLinkedCatch(project, next, statement, id, result, depth)
        }
        if (statement.kind == "Assign" && statement.edge_count == 1) {
            if (LinkedNullBinding(next.slots, statement.text) == 0) { next = addLocal(project, next, statement, id)? }
            else { next = LowerLinkedStringRebind(project, next, statement)? }
        } else if (statement.kind == "VarDecl" && statement.edge_count == 2) {
            kind = LinkedNullNode(project, 1, LinkedNullChild(project, 1, statement, 0)).kind
            if (kind == "TypeArray") { next = LowerLinkedArrayLocal(project, next, statement, id)? }
            else { next = addLocal(project, next, statement, id)? }
        } else if (statement.kind == "If" && statement.edge_count > 1) {
            branch = addGuardedRegion(project, next, statement, result, depth)?
            if (branch.terminal) {
                if (index != region.edge_count - 1) {
                    RejectLayout("unsupported_linked_terminal", "expected the terminal at the end of its block", DeclarationSpan(statement))?
                }
                return ok(branch)
            }
            next = branch.state
        } else if (statement.kind == "For") {
            opened = OpenLinkedCharacterLoop(project, next, statement, id, depth)?
            stepped = lowerLinkedRegion(project, statement, opened.state, 1, result, depth + 1)?
            next = CloseLinkedCharacterLoop(stepped, opened.outer, opened.before, statement)?
        } else if (statement.kind == "While" && statement.edge_count >= 2 && index > start) {
            initial = LinkedNullNode(project, 1, LinkedNullChild(project, 1, region, index - 1))
            next = addCountedLoop(project, next, statement, initial, result, depth)?
        } else if ((statement.kind == "ExprStmt" || statement.kind == "Print") && statement.edge_count == 1) {
            next = LowerLinkedStatementCall(project, next, statement)?
        } else {
            RejectLayout("unsupported_linked_statement", "expected a fresh local, guarded statement, counted while or checked call", DeclarationSpan(statement))?
        }
        index = index + 1
    }
    return ok(LinkedNullRegion { state: next, terminal: false })
}

fn emitLinkedFunction(&body: LinkedNullState, &symbol: str, &signature: str, &payload: TypeNameBinding): str! {
    header = EmitLinkedNullDeclarations(body, payload)?
    result = LinkedCheckedResultCType(payload)?
    keep = LinkedNullResultCleanupReference(body.owning_layouts, payload)
    char_errors = ""
    if (body.uses_chars) { char_errors = ManagedSourceCharactersErrors() }
    return ok(FinishLinkedFunctionC(header, body, symbol, signature, result, keep, char_errors))
}

fn EmitLinkedNullC(&supplied: [SuppliedModule], &entry_name: str): LinkedNullC! {
    if (supplied.len() == 0) {
        point = Span { line: 1, column: 1, offset: 0, end_line: 1, end_column: 1, end_offset: 0 }
        RejectLayout("missing_linked_entry_module", "a selected source module is required", point)?
    }
    bound = BindProjectModules(supplied)?
    project = LinkedNullProject { supplied: supplied.clone(), binding: bound }
    id = LinkedNullEntry(project, entry_name)?
    function = LinkedNullNode(project, 1, id)
    parameters = ReadLinkedNullParameters(project, function)?
    result = parameters.result.clone()
    region = lowerLinkedRegion(project, function, parameters.state, parameters.body_start, result, 0)?
    if (!region.terminal) {
        RejectLayout("unsupported_linked_terminal", "expected a final Error fail or return ok(null)", DeclarationSpan(function))?
    }
    symbol = "ku_linked_null_" + str(id)
    source = emitLinkedFunction(region.state, symbol, parameters.signature, result)?
    plan = LinkPlanDeclaration { unit: 1, node: id, symbol: symbol.clone(), parameters: parameters.plan,
        result: LinkedCheckedResultPlan(result, 1)?, returns_result: true }
    return ok(LinkedNullC { symbol: symbol, links: region.state.links, source: source, entry_plan: plan })
}
