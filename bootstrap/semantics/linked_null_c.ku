fn addGuardedRegion(&project: LinkedNullProject, state: LinkedNullState, &statement: Node,
                    &result: TypeNameBinding, depth: int): LinkedNullRegion! {
    if (depth >= 32) {
        RejectLayout("linked_control_depth", "linked control flow allows at most 32 levels", DeclarationSpan(statement))?
    }
    if (statement.int_value < 0 || statement.int_value >= statement.edge_count) {
        RejectLayout("unsupported_linked_guard", "expected valid then and else boundaries", DeclarationSpan(statement))?
    }
    guard_id = LinkedNullChild(project, 1, statement, 0)
    guard = LowerLinkedPredicate(project, state, guard_id)?
    if (guard.value.ty.declaration_kind != "Builtin" || guard.value.ty.name != "bool") {
        RejectLayout("linked_guard_type", "expected a readonly bool condition", DeclarationSpan(statement))?
    }
    outer = guard.state.slots.clone()
    guard.state.code += "    if ((bool)(" + guard.value.text + ")) {\n"
    split = statement.int_value + 1
    then_region = statement.clone()
    then_region.edge_count = split
    taken = LowerLinkedRegion(project, then_region, guard.state, 1, result, depth + 1)?
    then_terminal = taken.terminal
    next = taken.state
    if (split == statement.edge_count) {
        if (then_terminal) { next = RestoreLinkedNullSlots(next, outer) }
        else {
            next = MergeLinkedGuardOwners(next, outer, statement)?
            next = DropLinkedNullScope(next, outer.len())
        }
        next.code += "    }\n"
        return ok(LinkedNullRegion { state: next, terminal: false })
    }

    after_then: [LinkedNullSlot] = []
    if (!then_terminal) {
        after_then = LinkedSlotPrefix(next.slots, outer.len())
        next = DropLinkedNullScope(next, outer.len())
    }
    next = RestoreLinkedNullSlots(next, outer)
    next.code += "    } else {\n"
    other = LowerLinkedRegion(project, statement, next, split, result, depth + 1)?
    else_terminal = other.terminal
    next = other.state
    if (!else_terminal) {
        if (!then_terminal) { next = MergeLinkedConditionalMembers(next, after_then, statement)? }
        next = DropLinkedNullScope(next, outer.len())
    } else if (!then_terminal) {
        next = RestoreLinkedNullSlots(next, after_then)
    }
    next.code += "    }\n"
    return ok(LinkedNullRegion { state: next, terminal: then_terminal && else_terminal })
}

fn addCountedLoop(&project: LinkedNullProject, state: LinkedNullState, &statement: Node, &initial: Node,
                  &result: TypeNameBinding, depth: int): LinkedNullState! {
    if (depth >= 32) {
        RejectLayout("linked_control_depth", "linked control flow allows at most 32 levels", DeclarationSpan(statement))?
    }
    step = LinkedNullNode(project, 1, LinkedNullChild(project, 1, statement, statement.edge_count - 1))
    countdown = LinkedCountdownIndex(project, state, statement, step)?
    cursor = countdown
    if (cursor == 0) { cursor = CheckLinkedCountedIndex(project, state, statement, initial, step)? }
    RequireLinkedMutableBinding(state.slots[cursor - 1].binding, state.slots[cursor - 1].source_parameter, DeclarationSpan(step))?
    outer = state.slots.clone()
    next = state
    next.code = next.code + "    while (true) {\n"
    guard = LowerLinkedNullRead(project, next, LinkedNullChild(project, 1, statement, 0), 0)?
    next = guard.state
    if (countdown == 0) { CheckLinkedCountedBoundWrites(project, next, statement)? }
    next.code += "    if (!(" + guard.value.text + ")) break;\n"
    locals = next.slots.len()
    body = statement.clone()
    body.edge_count = body.edge_count - 1
    lowered = LowerLinkedRegion(project, body, next, 1, result, depth + 1)?
    if (lowered.terminal) { RejectLinkedTerminalIteration(body, countdown)? }
    PreserveLinkedOwners(outer, lowered.state.slots, statement)?
    next = DropLinkedNullScope(lowered.state, locals)
    advanced = LowerLinkedNullRead(project, next, LinkedNullChild(project, 1, step, 0), 0)?
    next = advanced.state
    next.code += "    " + next.slots[cursor - 1].value.text.clone() + " = " + advanced.value.text + ";\n    }\n"
    return ok(next)
}

fn lowerLinkedFailure(&project: LinkedNullProject, state: LinkedNullState, &statement: Node): LinkedNullState! {
    if (statement.kind != "Fail" || statement.edge_count != 1) {
        RejectLayout("unsupported_linked_terminal", "expected a final Error fail or return ok(null)", DeclarationSpan(statement))?
    }
    id = LinkedNullChild(project, 1, statement, 0)
    literal = LinkedNullNode(project, 1, id)
    target = LinkedFailureTarget(state)
    if (literal.kind == "Variable" && literal.edge_count == 0) {
        error = LowerLinkedNullValue(project, state, LinkedNullChild(project, 1, statement, 0), 0)?
        if (error.value.ty.declaration_kind != "CaughtError") {
            RejectLayout("unsupported_linked_error", "expected a caught Error owner", DeclarationSpan(literal))?
        }
        error.state.code += "    " + target + " = " + error.value.text.clone() + ";\n"
        owner = error.value.clone()
        moved = MoveLinkedNullSlot(error.state, owner)?
        return ok(ExitLinkedFailure(moved, "    "))
    }
    plan = ReadLinkedErrorInitializer(project.supplied[0].named, literal)?
    next = state
    destination = target.clone()
    if (plan.scratch) {
        ty = TypeNameBinding { use_node: 0, name: "Error", declaration_kind: "CaughtError",
            module_index: 0, declaration_node: 0, span: DeclarationSpan(literal) }
        scratch = AddLinkedNullSlot(project, next, "", "error" + str(id), ty, false)?
        next = scratch.state
        destination = scratch.value.text
    }
    for field in plan.fields {
        value = LowerLinkedNullValue(project, next, field.expression, 0)?
        if (value.value.ty.declaration_kind != "Builtin" || value.value.ty.name != "str") {
            RejectLayout("unsupported_linked_error_field", "error fields require str", value.value.ty.span.clone())?
        }
        value.state.code += "    " + destination.clone() + "." + field.name + " = " + value.value.text.clone() + ";\n"
        owner = value.value
        if (owner.borrowed) {
            if (owner.slot == 0 || value.state.catch_slot != 0
                || value.state.slots[owner.slot - 1].value.ty.declaration_kind != "CaughtError") {
                RejectLayout("linked_error_field_owner", "error fields require an owned str or a terminal caught field", owner.ty.span.clone())?
            }
            value.state.code += "    " + owner.text.clone() + " = (KuProjectionString){0};\n"
            value.state.moved_error_fields = value.state.moved_error_fields.push(owner.text)
            next = value.state
        } else {
            next = MoveLinkedNullSlot(value.state, owner)?
        }
    }
    if (plan.scratch) {
        next.code += "    " + target + " = " + destination.clone() + ";\n"
            + "    " + destination + " = (KuBootstrapError){0};\n"
        cleared: [str] = []
        next.moved_error_fields = cleared
    }
    return ok(ExitLinkedFailure(next, "    "))
}

fn lowerLinkedFinally(&project: LinkedNullProject, state: LinkedNullState, &node: Node, id: int,
                      &result: TypeNameBinding, depth: int, last: bool): LinkedNullRegion! {
    if (depth != 0 || state.catch_slot != 0 || state.plain_value_result ||
        !(LinkedCopyResult(result) || LinkedStringResult(result) || !LinkedNullHasResultValue(result))) {
        RejectLayout("unsupported_linked_finally", "expected a top-level checked primitive try/finally", DeclarationSpan(node))?
    }
    protected = LinkedNullNode(project, 1, LinkedNullChild(project, 1, node, 0))
    cleanup = LinkedNullNode(project, 1, LinkedNullChild(project, 1, node, 1))
    count = protected.edge_count
    tail = ReadLinkedProtectedTail(project.supplied[0].named, protected)?
    returning = tail.kind == "Return"
    terminal = returning || tail.kind == "Fail"
    if (terminal && !last) {
        RejectLayout("unsupported_linked_terminal", "expected the terminal at the end of its block", DeclarationSpan(node))?
    }
    if (returning) { protected.edge_count = count - 1 }
    outer = state.slots.clone()
    opened = BeginLinkedFinally(project, state, node, result, "finally" + str(id), returning)?
    saved = 0
    if (returning && LinkedNullHasResultValue(result)) { saved = opened.slots.len() }
    lowered = LowerLinkedRegion(project, protected, opened, 0, result, depth + 1)?
    next = lowered.state
    if (returning) { next = StoreLinkedFinallyReturn(project, next, tail, result, saved)? }
    CheckLinkedFinallyMoves(outer, next, node)?
    next = FinishLinkedFinally(project, next, cleanup, saved, terminal, returning)?
    return ok(LinkedNullRegion { state: next, terminal: terminal })
}

fn lowerLinkedCatch(&project: LinkedNullProject, state: LinkedNullState, &node: Node, id: int,
                    &result: TypeNameBinding, depth: int, last: bool): LinkedNullRegion! {
    if (node.edge_count == 2 && LinkedChildKindIs(project, node, 1, "Finally")) {
        return lowerLinkedFinally(project, state, node, id, result, depth, last)
    }
    if (state.catch_slot != 0 || node.edge_count != 2 || depth >= 8) {
        RejectLayout("unsupported_linked_catch", "expected one terminal try with a named catch", DeclarationSpan(node))?
    }
    clauses = ReadLinkedCatchParts(project.supplied[0].named, node)?
    outer = state.slots.clone()
    ty = LinkedBuiltin("Error", DeclarationSpan(clauses.binding))
    ty.declaration_kind = "CaughtError"
    slot = AddLinkedNullSlot(project, state, "", "caught" + str(id), ty, false)?
    slot.state.catch_slot = slot.value.slot
    body = LowerLinkedRegion(project, clauses.protected, slot.state, 0, result, depth + 1)?
    if (!body.terminal) {
        RejectLayout("unsupported_linked_catch", "the protected body must return or fail", DeclarationSpan(clauses.protected))?
    }
    resumed = BindLinkedCatch(body.state, clauses.binding.text.clone(), clauses.binding, outer)?
    handled = LowerLinkedRegion(project, clauses.recovery, resumed, 0, result, depth + 1)?
    if (handled.terminal) {
        if (!last) {
            RejectLayout("unsupported_linked_terminal", "expected the terminal at the end of its block", DeclarationSpan(node))?
        }
        return ok(handled)
    }
    if (last) {
        RejectLayout("unsupported_linked_catch", "the handler must return or fail", DeclarationSpan(clauses.recovery))?
    }
    // The protected path has already returned or failed. Drop the
    // catch binding and its locals before continuing in the outer scope.
    return ok(LinkedNullRegion { state: DropLinkedNullScope(handled.state, outer.len()), terminal: false })
}

fn LowerLinkedRetainedPair(&project: LinkedNullProject, state: LinkedNullState, &region: Node,
                           &statement: Node, id: int, index: int, &plan: LinkedRetainedViewPlan): LinkedNullState! {
    next = state
    if (statement.kind == "Assign" || statement.kind == "VarDecl") {
        next = LowerLinkedLocal(project, next, statement, id, true)?
    } else {
        move = LinkedViewRetention { field: plan.field, whole_view: false }
        next = LowerLinkedRetainedTry(project, next, statement, move)?
    }
    limit = plan.end
    start = index + 1
    cursor = start
    while (cursor < limit) {
        output = LinkedNullNode(project, 1, LinkedNullChild(project, 1, region, cursor))
        next = LowerLinkedStatementCall(project, next, output)?
        cursor = cursor + 1
    }
    call = LinkedNullNode(project, 1, LinkedNullChild(project, 1, region, limit))
    view = LinkedViewRetention { field: 0, whole_view: true }
    return LowerLinkedRetainedTry(project, next, call, view)
}

fn LowerLinkedRegion(&project: LinkedNullProject, &region: Node, state: LinkedNullState, start: int,
                     &result: TypeNameBinding, depth: int): LinkedNullRegion! {
    next = state
    index = start
    limit = region.edge_count
    next_statement = start
    while (index < limit) {
        id = LinkedNullChild(project, 1, region, index)
        statement = LinkedNullNode(project, 1, id)
        plan = LinkedRetainedViewPlan { field: 0, end: index }
        if (depth == 0 && index >= next_statement) {
            plan = PlanLinkedRetainedView(project, next, region, statement, index)
        }
        if (plan.field != 0) {
            next = LowerLinkedRetainedPair(project, next, region, statement, id, index, plan)?
            next_statement = plan.end + 1
        } else if (index >= next_statement) {
            if (statement.kind == "Return" || statement.kind == "Fail") {
                if (index != limit - 1) {
                    RejectLayout("unsupported_linked_terminal", "expected the terminal at the end of its block", DeclarationSpan(statement))?
                }
                if (statement.kind == "Fail") {
                    if (next.plain_value_result && next.catch_slot == 0) {
                        RejectLayout("linked_value_failure", "a plain value result cannot propagate an Error", DeclarationSpan(statement))?
                    }
                    next = lowerLinkedFailure(project, next, statement)?
                } else { next = LowerLinkedReturn(project, next, statement, result)? }
                return ok(LinkedNullRegion { state: next, terminal: true })
            }
            if (statement.kind == "Try") {
                caught = lowerLinkedCatch(project, next, statement, id, result, depth, index == limit - 1)?
                if (caught.terminal) { return ok(caught) }
                next = caught.state
            } else if (statement.kind == "Assign" && statement.edge_count == 1) {
                slot = LinkedNullBinding(next.slots, statement.text)
                if (slot != 0) {
                    RequireLinkedMutableBinding(statement.text, next.slots[slot - 1].source_parameter, DeclarationSpan(statement))?
                }
                if (ContainsIndex(next.callback_owners, slot)) {
                    RejectLayout("linked_callback_owner", "a captured array must remain readable by its local callback", DeclarationSpan(statement))?
                }
                if (slot == 0 && depth == 0 && result.declaration_kind == "NullableRecordViewReader" && LinkedChildKindIs(project, statement, 0, "FunctionExpr")) {
                    end = LinkedNullChild(project, 1, region, limit - 1)
                    prepared = ReadLinkedOwnedReader(project, next, statement, result, id, end)?
                    function_id = prepared.function
                    capture = prepared.capture
                    body_start = prepared.start
                    reader_result = prepared.result
                    function = LinkedNullNode(project, 1, function_id)
                    body = LowerLinkedRegion(project, function, prepared.state, body_start, reader_result, 1)?
                    next = FinishLinkedOwnedReader(project, next, body, statement, result, capture, function_id)?
                } else if (slot == 0) { next = LowerLinkedLocal(project, next, statement, id, false)? }
                else if (LinkedNullIntArrayOwner(next.slots[slot - 1].value.ty) || LinkedNullOwnedArray(next.slots[slot - 1].value.ty)
                    || next.slots[slot - 1].value.ty.declaration_kind == "OwnedStringArray") {
                    next = LowerLinkedArrayAppend(project, next, statement, slot)?
                } else if (next.slots[slot - 1].value.ty.declaration_kind == "Builtin"
                    && (next.slots[slot - 1].value.ty.name == "int" || next.slots[slot - 1].value.ty.name == "bool")) {
                    next = LowerLinkedCopyRebind(project, next, statement, slot)?
                } else {
                    next = LowerLinkedOwnerRebind(project, next, statement)?
                }
            } else if (statement.kind == "CompoundAssign" && statement.text == "+" && statement.edge_count == 2) {
                target = LinkedNullNode(project, 1, LinkedNullChild(project, 1, statement, 0))
                if (target.kind == "Variable") {
                    slot = LinkedNullBinding(next.slots, target.text)
                    if (slot > 0 && next.slots[slot - 1].source_parameter) {
                        RequireLinkedMutableBinding(target.text, true, DeclarationSpan(statement))?
                    }
                }
                next = LowerLinkedStringAppend(project, next, statement, id)?
            } else if (statement.kind == "AssignTarget" && statement.edge_count == 2) {
                next = LowerLinkedTargetSet(project, next, statement, id, depth)?
            } else if (statement.kind == "ObjectDestructureAssign") {
                next = LowerLinkedOwnedDestructure(project, next, statement)?
            } else if (statement.kind == "VarDecl" && statement.edge_count == 2) {
                type_node = LinkedNullNode(project, 1, LinkedNullChild(project, 1, statement, 0))
                if (type_node.kind == "TypeArray") {
                    source = LinkedCharacterSource(project, next, LinkedNullChild(project, 1, statement, 1), true)
                    if (source == 0) { next = LowerLinkedTypedArrayLocal(project, next, statement, id)? }
                    else { next = LowerLinkedCharacterLocal(project, next, statement, id, source)? }
                }
                else if (type_node.kind == "TypeFunction") { next = LowerLinkedLocalAlias(project, next, statement)? }
                else { next = LowerLinkedLocal(project, next, statement, id, false)? }
            } else if (statement.kind == "Function" && depth == 0) {
                if (IsLinkedAppendThunk(project, statement)) {
                    CheckLinkedLocalFunctionName(project, next, statement)?
                    prepared = ReadLinkedAppendThunk(project, next, statement, id)?
                    thunk = prepared.thunk
                    body = LowerLinkedRegion(project, statement, prepared.state, thunk.body_start, thunk.result, 1)?
                    next = FinishLinkedAppendThunk(next, thunk, body, statement, id)?
                } else if (statement.edge_count >= 4 && LinkedChildKindIs(project, statement, 1, "Parameter")) {
                    CheckLinkedLocalFunctionName(project, next, statement)?
                    prepared = ReadLinkedLocalThunk(project, next, statement, id)?
                    thunk = prepared.thunk
                    body = LowerLinkedRegion(project, statement, prepared.state, 3, thunk.result, 1)?
                    next = FinishLinkedLocalThunk(next, thunk, body, statement, id)?
                } else { next = RegisterLinkedLocalRead(project, next, statement, id)? }
            } else if (statement.kind == "If" && statement.edge_count > 1) {
                branch = addGuardedRegion(project, next, statement, result, depth)?
                if (branch.terminal) {
                    if (index != limit - 1) {
                        RejectLayout("unsupported_linked_terminal", "expected the terminal at the end of its block", DeclarationSpan(statement))?
                    }
                    return ok(branch)
                }
                next = branch.state
            } else if (statement.kind == "For") {
                opened = OpenLinkedForLoop(project, next, statement, id, depth)?
                stepped = LowerLinkedRegion(project, statement, opened.state, 1, result, depth + 1)?
                next = CloseLinkedForLoop(stepped, opened.outer, opened.before, statement)?
            } else if (statement.kind == "While" && statement.edge_count >= 2) {
                condition = ReadLinkedWhileCondition(project, next, statement)
                if (condition.local != "" || condition.conjunction != 0) {
                    opened = OpenLinkedConditionalWhile(project, next, statement, condition, depth)?
                    loop = LowerLinkedRegion(project, statement, opened.state, 1, result, depth + 1)?
                    next = CloseLinkedForLoop(loop, opened.outer, opened.before, statement)?
                } else {
                    if (index <= start) {
                        RejectLayout("unsupported_linked_statement", "expected a fresh local, guarded statement, counted while or checked call", DeclarationSpan(statement))?
                    }
                    initial = LinkedCountedInitial(project, next, region, statement, start, index)?
                    next = addCountedLoop(project, next, statement, initial, result, depth)?
                }
            } else if ((statement.kind == "ExprStmt" || statement.kind == "Print") && statement.edge_count == 1) {
                next = LowerLinkedStatementCall(project, next, statement)?
            } else {
                RejectLayout("unsupported_linked_statement", "expected a fresh local, guarded statement, counted while or checked call", DeclarationSpan(statement))?
            }
        }
        index = index + 1
    }
    return ok(LinkedNullRegion { state: next, terminal: false })
}
