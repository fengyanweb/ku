import { Span } from "../stage2/span.ku"
import { Node } from "../stage2/ast.ku"
import { DeclarationSpan, IsNamedFunction, NamedModule, RejectName } from "./names.ku"
import { ImportBinding, ReadImportNode, SuppliedModule } from "./imports.ku"
import { TypeNameBinding } from "./type_names.ku"
import { ExplicitType, RejectLayout } from "./struct_layouts.ku"
import { GuardBinding, GuardBindingIndex, GuardBindingName } from "./guarded_struct_expr.ku"
import { ScalarStringLiteral } from "./scalar_int_operands.ku"

struct LinkedLocalReadBinding {
    name: str
    node: int
    captured_slot: int
    index_shift: int
}

fn FindLinkedLocalRead(&bindings: [LinkedLocalReadBinding], &name: str): int {
    index = 0
    while (index < bindings.len()) {
        if (bindings[index].name == name) { return index + 1 }
        index = index + 1
    }
    return 0
}

fn LinkedLocalReadCaptures(&bindings: [LinkedLocalReadBinding], slot: int): bool {
    index = 0
    while (index < bindings.len()) {
        if (bindings[index].captured_slot == slot) { return true }
        index = index + 1
    }
    return false
}

fn RejectMissingLinkedValue(&bindings: [LinkedLocalReadBinding], &node: Node): null! {
    if (FindLinkedLocalRead(bindings, node.text) != 0) {
        RejectLayout("linked_local_callable_escape", "a local reader is only available as a direct call in its defining frame", DeclarationSpan(node))?
    }
    return RejectLayout("unavailable_linked_binding", "expected an initialized, unconsumed binding", DeclarationSpan(node))
}

struct InactiveMoveBranch { start: int, stop: int }

fn ManagedMethodReceiver(&nodes: [Node], &edges: [int], &call: Node): int {
    return edges[nodes[edges[call.first_edge] - 1].first_edge]
}

fn IsManagedMethod(&nodes: [Node], &edges: [int], &value: Node, &name: str, arity: int): bool {
    if (value.kind != "Call" || value.edge_count != arity + 1) { return false }
    method = nodes[edges[value.first_edge] - 1].clone()
    return method.kind == "Field" && method.text == name && method.edge_count == 1
}

fn StructResultEdge(&named: NamedModule, &function: Node): int! {
    cursor = function.first_edge
    end = cursor + function.edge_count
    while (cursor < end && named.parsed.arena.nodes[named.parsed.arena.edges[cursor] - 1].kind == "Parameter") {
        cursor = cursor + 1
    }
    if (cursor >= end - 1) {
        RejectLayout("unsupported_struct_result_signature", "expected parameters, a struct! result and a body", DeclarationSpan(function))?
    }
    return ok(cursor)
}

fn CheckNullResultCallee(&nodes: [Node], &edges: [int], &types: [TypeNameBinding],
                         &callee: Node, result_edge: int): null! {
    if (result_edge >= callee.first_edge + callee.edge_count) {
        RejectLayout("unsupported_struct_result_link", "checked call requires a declared null! result", DeclarationSpan(callee))?
    }
    signature = nodes[edges[result_edge] - 1].clone()
    if (signature.kind != "TypeResult" || signature.edge_count != 1) {
        RejectLayout("unsupported_struct_result_link", "checked call requires a declared null! result", DeclarationSpan(signature))?
    }
    bound = ExplicitType(types, edges[signature.first_edge], DeclarationSpan(signature))?
    if (bound.declaration_kind != "Builtin" || bound.name != "null") {
        RejectLayout("unsupported_struct_result_link", "checked dependency must return null!", bound.span)?
    }
    return ok(null)
}

fn RecordResultCallId(&named: NamedModule, statement_id: int): int {
    statement = named.parsed.arena.nodes[statement_id - 1].clone()
    if (statement.kind != "Assign" || statement.edge_count != 1) { return 0 }
    source = named.parsed.arena.nodes[named.parsed.arena.edges[statement.first_edge] - 1].clone()
    if (source.kind != "TryUnwrap" || source.edge_count != 1) { return 0 }
    call = named.parsed.arena.edges[source.first_edge]
    if (named.parsed.arena.nodes[call - 1].kind != "Call") { return 0 }
    return call
}

fn inactiveMoveBranches(&nodes: [Node], &edges: [int], &operand: Node, stop: int): [InactiveMoveBranch] {
    inactive: [InactiveMoveBranch] = []
    index = 0
    while (index < nodes.len()) {
        if (nodes[index].kind == "If" && nodes[index].offset < operand.offset && nodes[index].end_offset <= stop &&
            nodes[index].end_offset >= operand.end_offset) {
            first = nodes[index].first_edge
            then_count = nodes[index].int_value
            final = first + nodes[index].edge_count - 1
            if (then_count > 0 && first + then_count < final && nodes[edges[first + 1] - 1].offset <= operand.offset &&
                nodes[edges[first + then_count] - 1].end_offset >= operand.end_offset) {
                other = nodes[edges[first + then_count + 1] - 1].offset
                inactive = inactive.push(InactiveMoveBranch { start: other, stop: nodes[edges[final] - 1].end_offset })
            }
        }
        index = index + 1
    }
    return inactive
}

fn reachableMoveUse(&node: Node, &operand: Node, stop: int, &inactive: [InactiveMoveBranch]): bool {
    if (node.kind != "Variable" || node.offset < operand.end_offset || node.end_offset > stop || node.text != operand.text) {
        return false
    }
    index = 0
    while (index < inactive.len()) {
        if (node.offset >= inactive[index].start && node.end_offset <= inactive[index].stop) { return false }
        index = index + 1
    }
    return true
}

fn CheckManagedCallMove(&nodes: [Node], &edges: [int], &operand: Node, born: int, function_end: int): null! {
    stop = function_end
    index = 0
    while (index < nodes.len()) {
        if (nodes[index].kind == "While" && nodes[index].offset < operand.offset && nodes[index].end_offset >= operand.end_offset) {
            if (born <= nodes[index].offset) {
                RejectLayout("managed_call_move", "a repeated call cannot consume an owner created outside the loop", DeclarationSpan(operand))?
            }
            if (nodes[index].end_offset < stop) { stop = nodes[index].end_offset }
        }
        index = index + 1
    }
    inactive = inactiveMoveBranches(nodes, edges, operand, stop)
    index = 0
    while (index < nodes.len()) {
        if (reachableMoveUse(nodes[index], operand, stop, inactive)) {
            RejectLayout("managed_call_move", "checked call consumes the local string before this reference", DeclarationSpan(nodes[index]))?
        }
        index = index + 1
    }
    return ok(null)
}

fn ManagedConsumedString(&named: NamedModule, &locals: [GuardBinding], &operand: Node,
                         caller_id: int): GuardBinding! {
    found = GuardBindingIndex(locals, operand.text)
    if (found == 0 || locals[found - 1].ty.kind != "str" || locals[found - 1].view || locals[found - 1].parameter) {
        RejectLayout("managed_call_move", "expected a distinct owned local string", DeclarationSpan(operand))?
    }
    binding = locals[found - 1].clone()
    born = named.parsed.arena.nodes[binding.slot - 1].offset
    stop = named.parsed.arena.nodes[caller_id - 1].end_offset
    CheckManagedCallMove(named.parsed.arena.nodes, named.parsed.arena.edges, operand, born, stop)?
    return ok(binding)
}

fn ManagedLiteralConcat(&nodes: [Node], &edges: [int], &expression: Node): bool {
    return expression.kind == "Binary" && expression.text == "+" && expression.edge_count == 2 &&
        nodes[edges[expression.first_edge] - 1].kind == "String" && nodes[edges[expression.first_edge + 1] - 1].kind == "Variable"
}

fn ManagedLiteralConcatSetup(&named: NamedModule, &locals: [GuardBinding], &expression: Node,
                             caller_id: int, &target: str, &indent: str): str! {
    prefix = named.parsed.arena.nodes[named.parsed.arena.edges[expression.first_edge] - 1].clone()
    suffix = named.parsed.arena.nodes[named.parsed.arena.edges[expression.first_edge + 1] - 1].clone()
    binding = ManagedConsumedString(named, locals, suffix, caller_id)?
    source = GuardBindingName(binding)
    literal = "((KuProjectionString){ (uint8_t*)" + ScalarStringLiteral(prefix)? + ", 0u, KU_PROJECTION_STRING_STATIC })"
    return ok(indent.clone() + target.clone() + " = " + literal + ";\n" + indent.clone() +
        "if (!ku_managed_string_append(&" + target.clone() + ", " + source.clone() +
        ", &string_too_large)) { out_of_memory = !string_too_large; goto cleanup; }\n" +
        indent.clone() + "ku_projection_string_drop(&" + source + ");\n")
}

struct DirectSignature {
    name: str
    parameters: [ScalarAnnotation]
}

struct ScalarAnnotation {
    scalars: [str]
}

fn scalarType(&name: str): bool {
    return name == "int" || name == "float" || name == "bool" || name == "str" || name == "null"
}

// Use only exact primitive annotations and their finite unions. Generic,
// unannotated and other types are left to contextual type checking.
fn scalarAnnotation(&nodes: [Node], &edges: [int], &annotation: Node): ScalarAnnotation {
    scalars: [str] = []
    if (annotation.kind == "TypeName" && scalarType(annotation.text)) {
        scalars = scalars.push(annotation.text.clone())
    } else if (annotation.kind == "TypeUnion") {
        cursor = annotation.first_edge
        stop = cursor + annotation.edge_count
        while (cursor < stop) {
            item = nodes[edges[cursor] - 1].clone()
            if (item.kind != "TypeName" || !scalarType(item.text)) {
                return ScalarAnnotation { scalars: [] }
            }
            scalars = scalars.push(item.text)
            cursor = cursor + 1
        }
    }
    return ScalarAnnotation { scalars: scalars }
}

fn parameterAnnotation(&nodes: [Node], &edges: [int], &parameter: Node): ScalarAnnotation {
    if (parameter.edge_count != 1) { return ScalarAnnotation { scalars: [] } }
    return scalarAnnotation(nodes, edges, nodes[edges[parameter.first_edge] - 1])
}

fn directSignature(&nodes: [Node], &edges: [int], &function: Node, name: str): DirectSignature {
    parameters: [ScalarAnnotation] = []
    cursor = function.first_edge
    stop = cursor + function.edge_count
    while (cursor < stop && nodes[edges[cursor] - 1].kind == "Parameter") {
        parameters = parameters.push(parameterAnnotation(nodes, edges, nodes[edges[cursor] - 1]))
        cursor = cursor + 1
    }
    return DirectSignature { name: name, parameters: parameters }
}

fn directSignatures(&named: NamedModule, &imports: [ImportBinding], &supplied: [SuppliedModule]): [DirectSignature]! {
    signatures: [DirectSignature] = []
    index = 0
    while (index < named.names.declarations.len()) {
        if (IsNamedFunction(named.names.declarations[index].kind)) {
            id = named.names.declarations[index].node
            signature = directSignature(named.parsed.arena.nodes, named.parsed.arena.edges, named.parsed.arena.nodes[id - 1],
                                        named.names.declarations[index].name.clone())
            signatures = signatures.push(signature)
        }
        index = index + 1
    }
    index = 0
    while (index < imports.len()) {
        module_index = imports[index].module_index
        if (module_index > 0) {
            source = ReadImportNode(supplied[module_index - 1].named.parsed.arena.nodes,
                                    imports[index].target_node, imports[index].span.clone())?
            if (IsNamedFunction(source.kind)) {
                signature = directSignature(supplied[module_index - 1].named.parsed.arena.nodes,
                                            supplied[module_index - 1].named.parsed.arena.edges, source,
                                            imports[index].local_name.clone())
                signatures = signatures.push(signature)
            }
        }
        index = index + 1
    }
    return ok(signatures)
}

fn directSignatureIndex(&signatures: [DirectSignature], &name: str): int {
    index = 0
    while (index < signatures.len()) {
        if (signatures[index].name == name) { return index }
        index = index + 1
    }
    return -1
}

fn containsName(&names: [str], &name: str): bool {
    index = 0
    while (index < names.len()) {
        if (names[index] == name) { return true }
        index = index + 1
    }
    return false
}

fn couldBindLocal(&kind: str): bool {
    return kind == "Parameter" || kind == "VarDecl" || kind == "Assign"
        || kind == "For" || kind == "CatchBinding" || IsNamedFunction(kind)
        || kind == "ObjectDestructureLocal" || kind == "ObjectDestructureRest"
}

fn firstSubtreeNode(&nodes: [Node], &edges: [int], root: int): int {
    // The accepted arena uses contiguous post-order subtrees. Follow strictly
    // decreasing IDs to the leftmost node instead of copying a function AST.
    node = root
    while (nodes[node - 1].edge_count > 0) {
        node = edges[nodes[node - 1].first_edge]
    }
    return node
}

fn scalarLiteral(&node: Node): str {
    if (node.edge_count != 0) { return "" }
    if (node.kind == "Int") { return "int" }
    if (node.kind == "Float") { return "float" }
    if (node.kind == "Bool") { return "bool" }
    if (node.kind == "String") { return "str" }
    if (node.kind == "Null") { return "null" }
    return ""
}

fn checkLiteralType(&annotation: ScalarAnnotation, &nodes: [Node], &edges: [int], &argument: Node, error_code: str): null! {
    if (annotation.scalars.len() == 0) { return ok(null) }
    actual = scalarLiteral(argument)
    if (argument.kind == "Unary" && argument.edge_count == 1 && argument.text == "-") {
        operand = scalarLiteral(nodes[edges[argument.first_edge] - 1])
        if (operand == "int" || operand == "float") { actual = operand }
    }
    if (actual == "") { return ok(null) }
    if (containsName(annotation.scalars, actual)) { return ok(null) }
    expected = annotation.scalars[0].clone()
    cursor = 1
    while (cursor < annotation.scalars.len()) {
        expected += " | " + annotation.scalars[cursor].clone()
        cursor = cursor + 1
    }
    RejectName(error_code, "expected " + expected + " but got " + actual, DeclarationSpan(argument))?
    return ok(null)
}

fn checkFunctionCalls(&nodes: [Node], &edges: [int], &signatures: [DirectSignature], function: int): null! {
    start = firstSubtreeNode(nodes, edges, function)
    // This pass proves direct targets. Defer potentially shadowed names,
    // including local functions/captures, to a later lexical binding pass.
    shadowed: [str] = []
    index = start
    while (index < function) {
        if (couldBindLocal(nodes[index - 1].kind) && directSignatureIndex(signatures, nodes[index - 1].text) >= 0
            && !containsName(shadowed, nodes[index - 1].text)) {
            shadowed = shadowed.push(nodes[index - 1].text.clone())
        }
        index = index + 1
    }

    index = start
    while (index < function) {
        if (nodes[index - 1].kind == "Call" && nodes[index - 1].edge_count > 0) {
            target = edges[nodes[index - 1].first_edge]
            if (nodes[target - 1].kind == "Variable" && !containsName(shadowed, nodes[target - 1].text)) {
                signature = directSignatureIndex(signatures, nodes[target - 1].text)
                if (signature >= 0) {
                    arity = signatures[signature].parameters.len()
                    count = nodes[index - 1].edge_count - 1
                    if (count != arity) {
                        RejectName("call_arity", "function '" + nodes[target - 1].text.clone() + "' expects "
                                   + str(arity) + " arguments but got " + str(count), DeclarationSpan(nodes[index - 1]))?
                    }
                    argument = 0
                    while (argument < count) {
                        node = edges[nodes[index - 1].first_edge + argument + 1]
                        checkLiteralType(signatures[signature].parameters[argument], nodes, edges, nodes[node - 1], "call_argument_type")?
                        argument = argument + 1
                    }
                }
            }
        }
        index = index + 1
    }
    return ok(null)
}

fn checkReturnsInStatement(&nodes: [Node], &edges: [int], &result: ScalarAnnotation, &statement: Node): null! {
    if (statement.kind == "Return" && statement.edge_count == 1) {
        value = edges[statement.first_edge]
        return checkLiteralType(result, nodes, edges, nodes[value - 1], "return_type")
    }
    // These blocks share the current function's result type. Declaration,
    // expression and nested function nodes establish no returns in this scope.
    if (statement.kind == "If" || statement.kind == "While" || statement.kind == "For" ||
        statement.kind == "Try" || statement.kind == "TryBody" ||
        statement.kind == "Catch" || statement.kind == "CatchBody") {
        cursor = statement.first_edge
        stop = cursor + statement.edge_count
        while (cursor < stop) {
            checkReturnsInStatement(nodes, edges, result, nodes[edges[cursor] - 1])?
            cursor = cursor + 1
        }
    }
    return ok(null)
}

fn checkLiteralReturns(&nodes: [Node], &edges: [int], &function: Node): null! {
    cursor = function.first_edge
    stop = cursor + function.edge_count
    while (cursor < stop && nodes[edges[cursor] - 1].kind == "Parameter") {
        cursor = cursor + 1
    }
    if (cursor == stop) { return ok(null) }
    // Return annotations follow the parameters. An omitted annotation
    // begins directly with a statement and yields the empty scalar set.
    annotation = scalarAnnotation(nodes, edges, nodes[edges[cursor] - 1])
    if (annotation.scalars.len() == 0) { return ok(null) }
    cursor = cursor + 1
    while (cursor < stop) {
        checkReturnsInStatement(nodes, edges, annotation, nodes[edges[cursor] - 1])?
        cursor = cursor + 1
    }
    return ok(null)
}

// Use the arenas and import identities from the declaration/explicit type pass.
// Leave the project's AST IDs and successful output unchanged.
fn CheckDirectCallContracts(&named: NamedModule, &imports: [ImportBinding], &supplied: [SuppliedModule]): null! {
    signatures = directSignatures(named, imports, supplied)?
    if (signatures.len() == 0) { return ok(null) }
    index = 0
    while (index < named.names.declarations.len()) {
        if (IsNamedFunction(named.names.declarations[index].kind)) {
            function = named.names.declarations[index].node
            checkFunctionCalls(named.parsed.arena.nodes, named.parsed.arena.edges, signatures, function)?
        }
        index = index + 1
    }
    return ok(null)
}

fn CheckLiteralResultContracts(&named: NamedModule): null! {
    index = 0
    while (index < named.parsed.arena.nodes.len()) {
        node = named.parsed.arena.nodes[index].clone()
        if (IsNamedFunction(node.kind) || node.kind == "FunctionExpr") {
            checkLiteralReturns(named.parsed.arena.nodes, named.parsed.arena.edges, node)?
        }
        index = index + 1
    }
    return ok(null)
}

fn linkedConstantBinding(&name: str): bool {
    letter = false
    for char in name.clone().chars() {
        if ("ABCDEFGHIJKLMNOPQRSTUVWXYZ".contains(char.clone())) { letter = true }
        else if (!"_0123456789".contains(char)) { return false }
    }
    return letter
}

fn RequireLinkedMutableName(&name: str, &at: Span): null! {
    if (linkedConstantBinding(name)) {
        RejectLayout("linked_immutable_binding", "cannot assign to an immutable local", at.clone())?
    }
    return ok(null)
}
