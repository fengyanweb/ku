import "std.string"
import { Span } from "../stage2/span.ku"
import { FirstSubtreeNode, Node } from "../stage2/ast.ku"
import { CheckDirectMoveRead, DeclarationSpan, DirectMoveFlow, DirectMovePath, DirectMovePlace, FindDirectMoveBinding, IsNamedFunction, JoinDirectMoves, NamedModule, ParameterEnd, ProvesDirectFieldTransfer, RejectName, ResetDirectMove } from "./names.ku"
import { TypeNameBinding } from "./type_names.ku"
import { ExplicitType, RejectLayout } from "./struct_layouts.ku"
import { GuardBinding, GuardBindingIndex, GuardBindingName } from "./guarded_struct_expr.ku"
import { ScalarStringLiteral } from "./scalar_int_operands.ku"

fn RejectLocalCapture(&node: Node, message: str): null! {
    return RejectLayout("unsupported_linked_local_capture", message, DeclarationSpan(node))
}

struct LinkedLocalReadBinding {
    name: str
    node: int
    captured_slot: int
    index_shift: int
}

fn FindLinkedLocalRead(&bindings: [LinkedLocalReadBinding], &name: str): int {
    index = 0
    while (index < bindings.len()) {
        if (bindings[index].name == name) { return index + 1 }
        index = index + 1
    }
    return 0
}

fn linkedModuleFunctionSite(&named: NamedModule, site: int): bool {
    // The nearest enclosing function ends after its postorder argument node.
    cursor = site + 1
    limit = named.parsed.arena.nodes.len() + 1
    while (cursor < limit) {
        kind = named.parsed.arena.nodes[cursor - 1].kind.clone()
        if ((IsNamedFunction(kind) || kind == "FunctionExpr") &&
            FirstSubtreeNode(named.parsed.arena.nodes, named.parsed.arena.edges, cursor) <= site) {
            if (kind != "Function") { return false }
            index = 0
            declaration_count = named.names.declarations.len()
            while (index < declaration_count) {
                if (named.names.declarations[index].node == cursor) { return true }
                index = index + 1
            }
            return false
        }
        cursor = cursor + 1
    }
    return false
}

fn CheckLinkedStaticReaderSite(&named: NamedModule, &node: Node, id: int, selected: bool): bool! {
    if (selected && !linkedModuleFunctionSite(named, id)) {
        RejectLayout("linked_static_reader_scope", "a static reader argument requires a module function scope", DeclarationSpan(node))?
    }
    return ok(selected)
}

fn LinkedLocalReadCaptures(&bindings: [LinkedLocalReadBinding], slot: int): bool {
    index = 0
    while (index < bindings.len()) {
        if (bindings[index].captured_slot == slot) { return true }
        index = index + 1
    }
    return false
}

fn RejectMissingLinkedValue(&bindings: [LinkedLocalReadBinding], &node: Node): null! {
    if (FindLinkedLocalRead(bindings, node.text) != 0) {
        RejectLayout("linked_local_callable_escape", "a local reader is only available as a direct call in its defining frame", DeclarationSpan(node))?
    }
    return RejectLayout("unavailable_linked_binding", "expected an initialized, unconsumed binding", DeclarationSpan(node))
}

struct InactiveMoveBranch { start: int, stop: int }

fn ManagedMethodReceiver(&nodes: [Node], &edges: [int], &call: Node): int {
    return edges[nodes[edges[call.first_edge] - 1].first_edge]
}

fn IsManagedMethod(&nodes: [Node], &edges: [int], &value: Node, &name: str, arity: int): bool {
    if (value.kind != "Call" || value.edge_count != arity + 1) { return false }
    method = nodes[edges[value.first_edge] - 1].clone()
    return method.kind == "Field" && method.text == name && method.edge_count == 1
}

fn StructResultEdge(&named: NamedModule, &function: Node): int! {
    cursor = function.first_edge
    end = cursor + function.edge_count
    while (cursor < end && named.parsed.arena.nodes[named.parsed.arena.edges[cursor] - 1].kind == "Parameter") {
        cursor = cursor + 1
    }
    if (cursor >= end - 1) {
        RejectLayout("unsupported_struct_result_signature", "expected parameters, a struct! result and a body", DeclarationSpan(function))?
    }
    return ok(cursor)
}

fn CheckNullResultCallee(&nodes: [Node], &edges: [int], &types: [TypeNameBinding],
                         &callee: Node, result_edge: int): null! {
    if (result_edge >= callee.first_edge + callee.edge_count) {
        RejectLayout("unsupported_struct_result_link", "checked call requires a declared null! result", DeclarationSpan(callee))?
    }
    signature = nodes[edges[result_edge] - 1].clone()
    if (signature.kind != "TypeResult" || signature.edge_count != 1) {
        RejectLayout("unsupported_struct_result_link", "checked call requires a declared null! result", DeclarationSpan(signature))?
    }
    bound = ExplicitType(types, edges[signature.first_edge], DeclarationSpan(signature))?
    if (bound.declaration_kind != "Builtin" || bound.name != "null") {
        RejectLayout("unsupported_struct_result_link", "checked dependency must return null!", bound.span)?
    }
    return ok(null)
}

fn RecordResultCallId(&named: NamedModule, statement_id: int): int {
    statement = named.parsed.arena.nodes[statement_id - 1].clone()
    if (statement.kind != "Assign" || statement.edge_count != 1) { return 0 }
    source = named.parsed.arena.nodes[named.parsed.arena.edges[statement.first_edge] - 1].clone()
    if (source.kind != "TryUnwrap" || source.edge_count != 1) { return 0 }
    call = named.parsed.arena.edges[source.first_edge]
    if (named.parsed.arena.nodes[call - 1].kind != "Call") { return 0 }
    return call
}

fn inactiveMoveBranches(&nodes: [Node], &edges: [int], &operand: Node, stop: int): [InactiveMoveBranch] {
    inactive: [InactiveMoveBranch] = []
    index = 0
    while (index < nodes.len()) {
        if (nodes[index].kind == "If" && nodes[index].offset < operand.offset && nodes[index].end_offset <= stop &&
            nodes[index].end_offset >= operand.end_offset) {
            first = nodes[index].first_edge
            then_count = nodes[index].int_value
            final = first + nodes[index].edge_count - 1
            if (then_count > 0 && first + then_count < final && nodes[edges[first + 1] - 1].offset <= operand.offset &&
                nodes[edges[first + then_count] - 1].end_offset >= operand.end_offset) {
                other = nodes[edges[first + then_count + 1] - 1].offset
                inactive = inactive.push(InactiveMoveBranch { start: other, stop: nodes[edges[final] - 1].end_offset })
            }
        }
        index = index + 1
    }
    return inactive
}

fn reachableMoveUse(&node: Node, &operand: Node, stop: int, &inactive: [InactiveMoveBranch]): bool {
    if (node.kind != "Variable" || node.offset < operand.end_offset || node.end_offset > stop || node.text != operand.text) {
        return false
    }
    index = 0
    while (index < inactive.len()) {
        if (node.offset >= inactive[index].start && node.end_offset <= inactive[index].stop) { return false }
        index = index + 1
    }
    return true
}

fn CheckManagedCallMove(&nodes: [Node], &edges: [int], &operand: Node, born: int, function_end: int): null! {
    stop = function_end
    index = 0
    while (index < nodes.len()) {
        if (nodes[index].kind == "While" && nodes[index].offset < operand.offset && nodes[index].end_offset >= operand.end_offset) {
            if (born <= nodes[index].offset) {
                RejectLayout("managed_call_move", "a repeated call cannot consume an owner created outside the loop", DeclarationSpan(operand))?
            }
            if (nodes[index].end_offset < stop) { stop = nodes[index].end_offset }
        }
        index = index + 1
    }
    inactive = inactiveMoveBranches(nodes, edges, operand, stop)
    index = 0
    while (index < nodes.len()) {
        if (reachableMoveUse(nodes[index], operand, stop, inactive)) {
            RejectLayout("managed_call_move", "checked call consumes the local string before this reference", DeclarationSpan(nodes[index]))?
        }
        index = index + 1
    }
    return ok(null)
}

fn ManagedConsumedString(&named: NamedModule, &locals: [GuardBinding], &operand: Node,
                         caller_id: int): GuardBinding! {
    found = GuardBindingIndex(locals, operand.text)
    if (found == 0 || locals[found - 1].ty.kind != "str" || locals[found - 1].view || locals[found - 1].parameter) {
        RejectLayout("managed_call_move", "expected a distinct owned local string", DeclarationSpan(operand))?
    }
    binding = locals[found - 1].clone()
    born = named.parsed.arena.nodes[binding.slot - 1].offset
    stop = named.parsed.arena.nodes[caller_id - 1].end_offset
    CheckManagedCallMove(named.parsed.arena.nodes, named.parsed.arena.edges, operand, born, stop)?
    return ok(binding)
}

fn ManagedLiteralConcat(&nodes: [Node], &edges: [int], &expression: Node): bool {
    return expression.kind == "Binary" && expression.text == "+" && expression.edge_count == 2 &&
        nodes[edges[expression.first_edge] - 1].kind == "String" && nodes[edges[expression.first_edge + 1] - 1].kind == "Variable"
}

fn ManagedLiteralConcatSetup(&named: NamedModule, &locals: [GuardBinding], &expression: Node,
                             caller_id: int, &target: str, &indent: str): str! {
    prefix = named.parsed.arena.nodes[named.parsed.arena.edges[expression.first_edge] - 1].clone()
    suffix = named.parsed.arena.nodes[named.parsed.arena.edges[expression.first_edge + 1] - 1].clone()
    binding = ManagedConsumedString(named, locals, suffix, caller_id)?
    source = GuardBindingName(binding)
    literal = "((KuProjectionString){ (uint8_t*)" + ScalarStringLiteral(prefix)? + ", 0u, KU_PROJECTION_STRING_STATIC })"
    return ok(indent.clone() + target.clone() + " = " + literal + ";\n" + indent.clone() +
        "if (!ku_managed_string_append(&" + target.clone() + ", " + source.clone() +
        ", &string_too_large)) { out_of_memory = !string_too_large; goto cleanup; }\n" +
        indent.clone() + "ku_projection_string_drop(&" + source + ");\n")
}

fn linkedConstantBinding(&name: str): bool {
    letter = false
    for char in string.chars(name.clone()) {
        candidate = char.clone()
        if ("ABCDEFGHIJKLMNOPQRSTUVWXYZ".contains(candidate)) { letter = true }
        else if (!"_0123456789".contains(char)) { return false }
    }
    return letter
}

fn RequireLinkedMutableName(&name: str, &at: Span): null! {
    if (linkedConstantBinding(name)) {
        RejectLayout("linked_immutable_binding", "cannot assign to an immutable local", at.clone())?
    }
    return ok(null)
}

fn RequireLinkedMutableBinding(&name: str, source_parameter: bool, &at: Span): null! {
    if (source_parameter) {
        RejectLayout("linked_immutable_binding", "cannot assign to immutable parameter '" + name.clone() + "'", at.clone())?
    }
    return RequireLinkedMutableName(name, at)
}

fn directMoveEvent(&transfers: [int], id: int): bool {
    index = 0
    while (index < transfers.len()) {
        if (transfers[index] == id) { return true }
        index = index + 1
    }
    return false
}

fn checkDirectMoveExpression(&nodes: [Node], &edges: [int], &transfers: [int], flow: DirectMoveFlow,
                             id: int, depth: int, scope_start: int): DirectMoveFlow! {
    if (depth >= 32 || scope_start == 1) { return ok(flow) }
    state = flow
    item = nodes[id - 1].clone()
    if (item.kind == "Variable" || item.kind == "Field") {
        transferred = directMoveEvent(transfers, id)
        if (state.moved.len() > 0 || transferred) {
            place = DirectMovePath(nodes, edges, state.bindings, id)
            if (place.binding != 0) {
                if (nodes[place.binding - 1].offset < scope_start) { return ok(state) }
                CheckDirectMoveRead(nodes, state.moved, place, id)?
                if (transferred && (item.kind == "Variable" || ProvesDirectFieldTransfer(nodes, edges, place.binding, item))) {
                    binding = place.binding - 1
                    if (nodes[binding].kind == "Parameter" && nodes[binding].int_value == 1) {
                        RejectName("owned_transfer_from_view", "cannot transfer an owning string from a View", DeclarationSpan(item))?
                    }
                    state.moved = state.moved.push(place)
                }
                return ok(state)
            }
        }
    }
    start = item.first_edge
    stop = start + item.edge_count
    if (item.kind == "Call" && start < stop) {
        callee = nodes[edges[start] - 1].clone()
        if (callee.kind == "Field") {
            state = checkDirectMoveExpression(nodes, edges, transfers, state, edges[callee.first_edge], depth + 1, scope_start)?
            start = start + 1
        }
    }
    scanning = start < stop
    while (scanning) {
        state = checkDirectMoveExpression(nodes, edges, transfers, state, edges[start], depth + 1, scope_start)?
        start = start + 1
        scanning = start < stop
    }
    return ok(state)
}

fn joinedDirectMoveFlow(bindings: [int], yes: DirectMoveFlow, no: DirectMoveFlow): DirectMoveFlow {
    if (yes.terminal) { return DirectMoveFlow { bindings: bindings, moved: no.moved, terminal: no.terminal } }
    if (no.terminal) { return DirectMoveFlow { bindings: bindings, moved: yes.moved, terminal: false } }
    moved = JoinDirectMoves(yes.moved, no.moved)
    return DirectMoveFlow { bindings: bindings, moved: moved, terminal: false }
}

fn checkDirectMoveBlock(&nodes: [Node], &edges: [int], &transfers: [int], flow: DirectMoveFlow,
                        first: int, end: int, depth: int, scope_start: int): DirectMoveFlow! {
    if (depth >= 32) { return ok(flow) }
    next = flow
    cursor = first
    while (cursor < end && !next.terminal) {
        id = edges[cursor]
        item = nodes[id - 1].clone()
        start = item.first_edge
        stop = start + item.edge_count
        if (item.kind == "If") {
            next = checkDirectMoveExpression(nodes, edges, transfers, next, edges[start], 0, scope_start)?
            outer = next.bindings.clone()
            split = start + 1 + item.int_value
            before = DirectMoveFlow { bindings: next.bindings.clone(), moved: next.moved.clone(), terminal: false }
            yes = checkDirectMoveBlock(nodes, edges, transfers, before, start + 1, split, depth + 1, scope_start)?
            no = checkDirectMoveBlock(nodes, edges, transfers, next, split, stop, depth + 1, scope_start)?
            next = joinedDirectMoveFlow(outer, yes, no)
        } else if (item.kind == "For") {
            // Resolve visible names, but start a fresh ownership state for this
            // iteration. The iterable is the first edge, before the iterator is
            // in scope. Leave it, the iterator and outer transfers unproved.
            bindings = next.bindings.clone()
            bindings = bindings.push(id)
            moved: [DirectMovePlace] = []
            iteration = DirectMoveFlow { bindings: bindings, moved: moved, terminal: false }
            checkDirectMoveBlock(nodes, edges, transfers, iteration, start + 1, stop, depth + 1, item.offset + 1)?
        } else if (item.kind == "VarDecl" || item.kind == "Assign") {
            next = checkDirectMoveExpression(nodes, edges, transfers, next, edges[stop - 1], 0, scope_start)?
            binding = FindDirectMoveBinding(nodes, next.bindings, item.text)
            if (item.kind == "VarDecl" || binding == 0) { next.bindings = next.bindings.push(id) }
            else {
                place = DirectMovePlace { binding: binding, path: "" }
                next.moved = ResetDirectMove(next.moved, place)
            }
        } else if (item.kind == "AssignTarget" && scope_start != 1) {
            next = checkDirectMoveExpression(nodes, edges, transfers, next, edges[start + 1], 0, scope_start)?
            target = DirectMovePath(nodes, edges, next.bindings, edges[start])
            if (target.binding != 0) { next.moved = ResetDirectMove(next.moved, target) }
            else { next = checkDirectMoveExpression(nodes, edges, transfers, next, edges[start], 0, scope_start)? }
        } else {
            next = checkDirectMoveExpression(nodes, edges, transfers, next, id, 0, scope_start)?
            next.terminal = item.kind == "Return" || item.kind == "Fail" || item.kind == "Panic"
        }
        cursor = cursor + 1
    }
    return ok(next)
}

fn CheckDirectOwnedMoves(&nodes: [Node], &edges: [int], &transfers: [int], first: int, function: int): null! {
    // Only one For may use the iteration-local proof. More loop regions,
    // early loop exits, recovery and captures keep their existing lowering gates.
    cursor = first
    has_for = false
    while (cursor < function) {
        kind = nodes[cursor - 1].kind.clone()
        if (kind == "For") {
            if (has_for) { return ok(null) }
            has_for = true
        }
        if (kind == "While" || kind == "Break" || kind == "Continue" || kind == "Try" || kind == "FunctionExpr" || IsNamedFunction(kind) ||
            kind == "CompoundAssign" || kind == "ObjectDestructureAssign" || kind == "Match") { return ok(null) }
        cursor = cursor + 1
    }
    cursor = nodes[function - 1].first_edge
    stop = cursor + nodes[function - 1].edge_count
    start = ParameterEnd(nodes, edges, cursor, stop)
    bindings: [int] = []
    reading_parameters = cursor < start
    while (reading_parameters) {
        bindings = bindings.push(edges[cursor])
        cursor = cursor + 1
        reading_parameters = cursor < start
    }
    moved: [DirectMovePlace] = []
    flow = DirectMoveFlow { bindings: bindings, moved: moved, terminal: false }
    // An enclosing function with a loop supplies lexical bindings only.
    // Zero checks every binding; one disables ownership checks. Body offsets
    // after a For header always exceed both sentinel values.
    scope_start = 0
    if (has_for) { scope_start = 1 }
    checkDirectMoveBlock(nodes, edges, transfers, flow, start, stop, 0, scope_start)?
    return ok(null)
}
