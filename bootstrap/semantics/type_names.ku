import { Node } from "../stage2/ast.ku"
import { DiagnosticCanonical, MakeDiagnostic } from "../stage2/diagnostic.ku"
import { Span } from "../stage2/span.ku"
import { DeclarationSpan, NamedModule, TopLevelName } from "./names.ku"
import { BindSuppliedImports, ImportBinding, ReadImportNode, SuppliedModule } from "./imports.ku"

// Node IDs are local to the relevant AST. Module 0 denotes the source module;
// supplied modules are one-based. Built-ins have no declaration node.
struct TypeNameBinding {
    use_node: int
    name: str
    declaration_kind: str
    module_index: int
    declaration_node: int
    span: Span
}

fn TypeNameBindingWithKind(&binding: TypeNameBinding, kind: str): TypeNameBinding {
    return TypeNameBinding {
        use_node: binding.use_node, name: binding.name.clone(), declaration_kind: kind,
        module_index: binding.module_index, declaration_node: binding.declaration_node,
        span: binding.span.clone()
    }
}

fn IsBuiltinType(&name: str): bool {
    return name == "int" || name == "float" || name == "bool" || name == "str" || name == "null"
}

fn ResolveTypeName(&use: Node, use_index: int, &local: [TopLevelName],
                   &imports: [ImportBinding], &supplied: [SuppliedModule]): TypeNameBinding! {
    at = DeclarationSpan(use)
    name = use.text.clone()
    if (IsBuiltinType(name)) {
        return ok(TypeNameBinding {
            use_node: use_index, name: name, declaration_kind: "Builtin",
            module_index: 0, declaration_node: 0, span: at
        })
    }
    index = 0
    while (index < local.len()) {
        declaration = local[index].clone()
        if (declaration.name == name && (declaration.kind == "Struct" || declaration.kind == "Enum")) {
            return ok(TypeNameBinding {
                use_node: use_index, name: name, declaration_kind: declaration.kind,
                module_index: 0, declaration_node: declaration.node, span: at
            })
        }
        index = index + 1
    }
    index = 0
    while (index < imports.len()) {
        entry = imports[index].clone()
        if (entry.module_index > 0 && entry.local_name == name) {
            target = ReadImportNode(supplied[entry.module_index - 1].named.parsed.arena.nodes,
                                    entry.target_node, at.clone())?
            if (target.kind == "Struct" || target.kind == "Enum") {
                return ok(TypeNameBinding {
                    use_node: use_index, name: name, declaration_kind: target.kind,
                    module_index: entry.module_index, declaration_node: entry.target_node, span: at
                })
            }
        }
        index = index + 1
    }
    if (name == "KuValue" || name == "HttpRequest" || name == "HttpResponse") {
        return ok(TypeNameBinding {
            use_node: use_index, name: name, declaration_kind: "Builtin",
            module_index: 0, declaration_node: 0, span: at
        })
    }
    diagnostic = MakeDiagnostic("error", "bootstrap.semantics.types", "undefined_type",
                                "undefined type '" + name + "'", "<source>", at)
    fail { domain: "bootstrap.semantics.types", code: "undefined_type", message: DiagnosticCanonical(diagnostic) }
}

fn CollectTypeNames(&nodes: [Node], &local: [TopLevelName],
                    &imports: [ImportBinding], &supplied: [SuppliedModule]): [TypeNameBinding]! {
    bindings: [TypeNameBinding] = []
    index = 0
    while (index < nodes.len()) {
        node = nodes[index].clone()
        if (node.kind == "TypeName") {
            binding = ResolveTypeName(node, index + 1, local, imports, supplied)?
            bindings = bindings.push(binding)
        }
        index = index + 1
    }
    return ok(bindings)
}

// Bind explicit names on the validated Stage 3 graph. Container and union
// shapes remain in the graph; this pass does not infer expression types.
fn BindTypeNames(&named: NamedModule, &supplied: [SuppliedModule]): [TypeNameBinding]! {
    imports = BindSuppliedImports(named, supplied)?
    return BindImportedTypeNames(named, imports, supplied)
}

fn BindImportedTypeNames(&named: NamedModule, &imports: [ImportBinding],
                         &supplied: [SuppliedModule]): [TypeNameBinding]! {
    return CollectTypeNames(named.parsed.arena.nodes, named.names.declarations, imports, supplied)
}

fn SameBoundTypeIdentity(&a: TypeNameBinding, &b: TypeNameBinding): bool {
    return a.declaration_kind == b.declaration_kind && a.module_index == b.module_index
        && a.declaration_node == b.declaration_node
        && ((a.declaration_kind != "Builtin" && a.declaration_kind != "BuiltinArray") || a.name == b.name)
}

fn LinkedCopyResult(&binding: TypeNameBinding): bool {
    return binding.declaration_kind == "Builtin" && (binding.name == "int" || binding.name == "bool")
}

fn RetagTypeNameBinding(binding: TypeNameBinding, kind: str): TypeNameBinding {
    return TypeNameBinding {
        use_node: binding.use_node, name: binding.name, declaration_kind: kind,
        module_index: binding.module_index, declaration_node: binding.declaration_node, span: binding.span
    }
}

fn IsLinkedDescendant(&path: str, &parent: str): bool {
    if (path.byte_len() <= parent.byte_len() || !path.starts_with(parent)) { return false }
    // A decimal ordinal can be the prefix of a different sibling ordinal.
    prefix = parent + "."
    if (path.starts_with(prefix)) { return true }
    return false
}

fn SameRecordArrayElement(&array: TypeNameBinding, &element: TypeNameBinding): bool {
    // The caller has established that the array owns this nominal element.
    return element.declaration_kind == "Struct" && array.module_index == element.module_index
        && array.declaration_node == element.declaration_node
}

fn sameNamedFieldPlace(&nodes: [Node], &edges: [int], left: int, right: int): bool {
    source = left
    target = right
    limit = 32
    depth = 0
    while (depth < limit) {
        a = nodes[source - 1].clone()
        b = nodes[target - 1].clone()
        if (a.kind != b.kind || a.edge_count != b.edge_count || a.text != b.text) { return false }
        if (a.kind == "Variable") { return a.edge_count == 0 }
        if (a.kind != "Field" || a.edge_count != 1) { return false }
        source = edges[a.first_edge]
        target = edges[b.first_edge]
        depth = depth + 1
    }
    return false
}

fn NamedFieldPushArgument(&nodes: [Node], &edges: [int], target: int, rhs: int): int {
    call = nodes[rhs - 1].clone()
    if (call.kind != "Call" || call.edge_count != 2) { return 0 }
    method = nodes[edges[call.first_edge] - 1].clone()
    if (method.kind != "Field" || method.edge_count != 1 || method.text != "push") { return 0 }
    if (!sameNamedFieldPlace(nodes, edges, target, edges[method.first_edge])) { return 0 }
    return edges[call.first_edge + 1]
}
