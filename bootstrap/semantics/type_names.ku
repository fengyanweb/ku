import "std.string"
import { Node } from "../stage2/ast.ku"
import { DiagnosticCanonical, MakeDiagnostic } from "../stage2/diagnostic.ku"
import { Span } from "../stage2/span.ku"
import { DeclarationSpan, NamedModule, TopLevelName } from "./names.ku"
import { BindSuppliedImports, ImportBinding, ReadImportNode, ResolveSuppliedExport, SuppliedModule } from "./imports.ku"

// Node IDs are local to the relevant AST. Module 0 denotes the source module;
// supplied modules are one-based. Built-ins have no declaration node.
struct TypeNameBinding {
    use_node: int
    name: str
    declaration_kind: str
    module_index: int
    declaration_node: int
    span: Span
}

fn TypeNameBindingWithKind(&binding: TypeNameBinding, kind: str): TypeNameBinding {
    return TypeNameBinding {
        use_node: binding.use_node, name: binding.name.clone(), declaration_kind: kind,
        module_index: binding.module_index, declaration_node: binding.declaration_node,
        span: binding.span.clone()
    }
}

fn IsBuiltinType(&name: str): bool {
    return name == "int" || name == "float" || name == "bool" || name == "str" || name == "null"
}

fn ResolveTypeName(&use: Node, use_index: int, &local: [TopLevelName],
                   &imports: [ImportBinding], &supplied: [SuppliedModule]): TypeNameBinding! {
    at = DeclarationSpan(use)
    name = use.text.clone()
    if (IsBuiltinType(name)) {
        return ok(TypeNameBinding {
            use_node: use_index, name: name, declaration_kind: "Builtin",
            module_index: 0, declaration_node: 0, span: at
        })
    }
    index = 0
    while (index < local.len()) {
        declaration = local[index].clone()
        if (declaration.name == name && (declaration.kind == "Struct" || declaration.kind == "Enum")) {
            return ok(TypeNameBinding {
                use_node: use_index, name: name, declaration_kind: declaration.kind,
                module_index: 0, declaration_node: declaration.node, span: at
            })
        }
        index = index + 1
    }
    index = 0
    while (index < imports.len()) {
        entry = imports[index].clone()
        target_node = 0
        if (entry.module_index > 0) {
            if (entry.target_node > 0 && entry.local_name == name) {
                target_node = entry.target_node
            } else if ((use.kind == "TypeName" || use.kind == "StructLiteral") &&
                entry.target_node == 0 && entry.local_name != "") {
                start = entry.local_name.len() + 1
                if (name.starts_with(entry.local_name + ".")) {
                    member = string.slice(name.clone(), start, name.len())?
                    target_node = ResolveSuppliedExport(supplied[entry.module_index - 1].named, member, at.clone())?
                }
            }
        }
        if (target_node > 0) {
            target = ReadImportNode(supplied[entry.module_index - 1].named.parsed.arena.nodes, target_node, at.clone())?
            if (target.kind == "Struct" || target.kind == "Enum") {
                return ok(TypeNameBinding {
                    use_node: use_index, name: name, declaration_kind: target.kind,
                    module_index: entry.module_index, declaration_node: target_node, span: at
                })
            }
        }
        index = index + 1
    }
    if (name == "KuValue" || name == "HttpRequest" || name == "HttpResponse") {
        return ok(TypeNameBinding {
            use_node: use_index, name: name, declaration_kind: "Builtin",
            module_index: 0, declaration_node: 0, span: at
        })
    }
    diagnostic = MakeDiagnostic("error", "bootstrap.semantics.types", "undefined_type",
                                "undefined type '" + name + "'", "<source>", at)
    fail { domain: "bootstrap.semantics.types", code: "undefined_type", message: DiagnosticCanonical(diagnostic) }
}

fn CollectTypeNames(&nodes: [Node], &local: [TopLevelName],
                    &imports: [ImportBinding], &supplied: [SuppliedModule]): [TypeNameBinding]! {
    bindings: [TypeNameBinding] = []
    index = 0
    while (index < nodes.len()) {
        node = nodes[index].clone()
        if (node.kind == "TypeName") {
            binding = ResolveTypeName(node, index + 1, local, imports, supplied)?
            bindings = bindings.push(binding)
        }
        index = index + 1
    }
    return ok(bindings)
}

// Bind explicit names on the validated Stage 3 graph. Container and union
// shapes remain in the graph; this pass does not infer expression types.
fn BindTypeNames(&named: NamedModule, &supplied: [SuppliedModule]): [TypeNameBinding]! {
    imports = BindSuppliedImports(named, supplied)?
    return BindImportedTypeNames(named, imports, supplied)
}

fn BindImportedTypeNames(&named: NamedModule, &imports: [ImportBinding],
                         &supplied: [SuppliedModule]): [TypeNameBinding]! {
    return CollectTypeNames(named.parsed.arena.nodes, named.names.declarations, imports, supplied)
}

fn SameBoundTypeIdentity(&a: TypeNameBinding, &b: TypeNameBinding): bool {
    return a.declaration_kind == b.declaration_kind && a.module_index == b.module_index
        && a.declaration_node == b.declaration_node
        && ((a.declaration_kind != "Builtin" && a.declaration_kind != "BuiltinArray") || a.name == b.name)
}

fn rejectedUnitEnum(code: str, reason: str, at: Span): null! {
    diagnostic = MakeDiagnostic("error", "bootstrap.semantics.types", code.clone(), reason, "<source>", at)
    fail { domain: "bootstrap.semantics.types", code: code, message: DiagnosticCanonical(diagnostic) }
}

fn RequireUnitEnum(&supplied: [SuppliedModule], binding: TypeNameBinding, local_unit: int): TypeNameBinding! {
    resolved = binding
    if (resolved.module_index == 0) { resolved.module_index = local_unit }
    unit = resolved.module_index - 1
    declaration = ReadImportNode(supplied[unit].named.parsed.arena.nodes, resolved.declaration_node, resolved.span.clone())?
    if (declaration.kind != "Enum" || declaration.edge_count == 0) {
        rejectedUnitEnum("linked_enum_layout", "expected a nonempty enum declaration", resolved.span.clone())?
    }
    names: [str] = []
    index = 0
    while (index < declaration.edge_count) {
        id = supplied[unit].named.parsed.arena.edges[declaration.first_edge + index]
        variant = ReadImportNode(supplied[unit].named.parsed.arena.nodes, id, resolved.span.clone())?
        if (variant.kind != "EnumVariant" || variant.edge_count != 0) {
            rejectedUnitEnum("linked_enum_layout", "every variant of a linked enum must have no payload", DeclarationSpan(variant))?
        }
        prior = 0
        while (prior < names.len()) {
            if (names[prior] == variant.text) {
                rejectedUnitEnum("linked_enum_layout", "duplicate unit enum variant", DeclarationSpan(variant))?
            }
            prior = prior + 1
        }
        names = names.push(variant.text)
        index = index + 1
    }
    resolved.declaration_kind = "UnitEnum"
    return ok(resolved)
}

fn UnitEnumTypeName(&binding: TypeNameBinding): str {
    return "KuEnum_m" + str(binding.module_index) + "_" + str(binding.declaration_node)
}

fn EmitUnitEnumHeader(&binding: TypeNameBinding): str {
    name = UnitEnumTypeName(binding)
    return "typedef struct " + name.clone()
        + " { int32_t tag; union { unsigned char empty; } payload; } " + name + ";\n"
}

fn BoundArrayTypePosition(&arrays: [TypeNameBinding], &type_name: TypeNameBinding): int {
    index = 0
    while (index < arrays.len()) {
        if (SameBoundTypeIdentity(arrays[index], type_name)) { return index + 1 }
        index = index + 1
    }
    return 0
}

fn FindUnitEnumType(&named: NamedModule, &imports: [ImportBinding], &supplied: [SuppliedModule],
                    &qualifier: Node): TypeNameBinding! {
    try {
        resolved = ResolveTypeName(qualifier, 0, named.names.declarations, imports, supplied)?
        if (resolved.declaration_kind == "Enum") { return RequireUnitEnum(supplied, resolved, 1) }
        return ok(resolved)
    } catch (err) {
        if (err.code != "undefined_type") { fail err }
    }
    return ok(TypeNameBinding { use_node: 0, name: "", declaration_kind: "Unresolved",
        module_index: 0, declaration_node: 0, span: DeclarationSpan(qualifier) })
}

fn ReadUnitEnumVariant(&supplied: [SuppliedModule], &binding: TypeNameBinding, &name: str, at: Span): int! {
    unit = binding.module_index - 1
    declaration = ReadImportNode(supplied[unit].named.parsed.arena.nodes, binding.declaration_node, at.clone())?
    index = 0
    while (index < declaration.edge_count) {
        id = supplied[unit].named.parsed.arena.edges[declaration.first_edge + index]
        variant = ReadImportNode(supplied[unit].named.parsed.arena.nodes, id, at.clone())?
        if (variant.text == name) { return ok(index) }
        index = index + 1
    }
    rejectedUnitEnum("linked_enum_variant", "unknown variant '" + name.clone() + "'", at)?
    return ok(0)
}

// This linked carrier is defined only for the closed union of the two core
// scalar types. Container layout and general union inference remain separate.
fn IsLinkedNullableIntType(&named: NamedModule, &annotation: Node): bool {
    if (annotation.kind != "TypeUnion" || annotation.edge_count != 2) { return false }
    edges = annotation.first_edge
    left = named.parsed.arena.edges[edges] - 1
    right = named.parsed.arena.edges[edges + 1] - 1
    if (named.parsed.arena.nodes[left].kind != "TypeName" || named.parsed.arena.nodes[right].kind != "TypeName") { return false }
    first = named.parsed.arena.nodes[left].text.clone()
    second = named.parsed.arena.nodes[right].text.clone()
    return first == "int" && second == "null" || first == "null" && second == "int"
}

fn LinkedCopyResult(&binding: TypeNameBinding): bool {
    return binding.declaration_kind == "Builtin" && (binding.name == "int" || binding.name == "bool")
}

fn LinkedPlainCopyResult(&binding: TypeNameBinding): bool {
    return LinkedCopyResult(binding) || (binding.declaration_kind == "Builtin" && binding.name == "null")
}

fn RetagTypeNameBinding(binding: TypeNameBinding, kind: str): TypeNameBinding {
    return TypeNameBinding {
        use_node: binding.use_node, name: binding.name, declaration_kind: kind,
        module_index: binding.module_index, declaration_node: binding.declaration_node, span: binding.span
    }
}

fn IsLinkedDescendant(&path: str, &parent: str): bool {
    if (path.byte_len() <= parent.byte_len() || !path.starts_with(parent)) { return false }
    // A decimal ordinal can be the prefix of a different sibling ordinal.
    prefix = parent + "."
    if (path.starts_with(prefix)) { return true }
    return false
}

fn SameRecordArrayElement(&array: TypeNameBinding, &element: TypeNameBinding): bool {
    // The caller has established that the array owns this nominal element.
    return element.declaration_kind == "Struct" && array.module_index == element.module_index
        && array.declaration_node == element.declaration_node
}

fn sameNamedFieldPlace(&nodes: [Node], &edges: [int], left: int, right: int): bool {
    source = left
    target = right
    limit = 32
    depth = 0
    while (depth < limit) {
        a = nodes[source - 1].clone()
        b = nodes[target - 1].clone()
        if (a.kind != b.kind || a.edge_count != b.edge_count || a.text != b.text) { return false }
        if (a.kind == "Variable") { return a.edge_count == 0 }
        if (a.kind != "Field" || a.edge_count != 1) { return false }
        source = edges[a.first_edge]
        target = edges[b.first_edge]
        depth = depth + 1
    }
    return false
}

fn NamedFieldPushArgument(&nodes: [Node], &edges: [int], target: int, rhs: int): int {
    call = nodes[rhs - 1].clone()
    if (call.kind != "Call" || call.edge_count != 2) { return 0 }
    method = nodes[edges[call.first_edge] - 1].clone()
    if (method.kind != "Field" || method.edge_count != 1 || method.text != "push") { return 0 }
    if (!sameNamedFieldPlace(nodes, edges, target, edges[method.first_edge])) { return 0 }
    return edges[call.first_edge + 1]
}

fn ScalarType(&bindings: [TypeNameBinding], use_node: int, &ty: Node): int {
    lo = 0
    hi = bindings.len()
    // Each step at least halves the remaining range of a signed int length.
    max_steps = 64
    step = 0
    while (step < max_steps && lo < hi) {
        middle = lo + (hi - lo) / 2
        if (bindings[middle].use_node < use_node) { lo = middle + 1 }
        else { hi = middle }
        step = step + 1
    }
    if (ty.kind == "TypeName" && lo < bindings.len() && bindings[lo].use_node == use_node
        && bindings[lo].declaration_kind == "Builtin") {
        if (bindings[lo].name == "int") { return 1 }
        if (bindings[lo].name == "str") { return 2 }
        if (bindings[lo].name == "bool") { return 3 }
        if (bindings[lo].name == "null") { return 4 }
    }
    return 0
}

// Plain null is not a return type of this scalar emitter.
fn ScalarReturnType(&nodes: [Node], &edges: [int], &bindings: [TypeNameBinding], type_id: int): int {
    ty = nodes[type_id - 1].clone()
    if (ty.kind == "TypeResult" && ty.edge_count == 1) {
        inner_id = edges[ty.first_edge]
        inner = ScalarType(bindings, inner_id, nodes[inner_id - 1])
        if (inner == 4) { return 4 }
    }
    plain = ScalarType(bindings, type_id, ty)
    if (plain < 4) { return plain }
    return 0
}

fn LinkedNullableReaderParameter(&named: NamedModule, &annotation: Node): int {
    if (annotation.kind != "TypeFunction" || annotation.edge_count != 2) { return 0 }
    start = annotation.first_edge
    parameter = named.parsed.arena.nodes[named.parsed.arena.edges[start] - 1].clone()
    if (parameter.kind != "TypeParameter" || parameter.edge_count != 1 || parameter.text != "&") { return 0 }
    result = named.parsed.arena.edges[start + 1]
    if (!IsLinkedNullableIntType(named, named.parsed.arena.nodes[result - 1])) { return 0 }
    return named.parsed.arena.edges[parameter.first_edge]
}

fn LinkedNominalReaderPrefix(&kind: str): str {
    if (kind == "IntArrayResultCallback") { return "KuBootstrapIntArrayCallback_" }
    if (kind == "IntRecordReaderCallback") { return "KuBootstrapIntReaderCallback_" }
    if (kind == "IntPairResultCallback") { return "KuBootstrapIntPairCallback_" }
    if (kind == "NullableRecordViewReader") { return "KuBootstrapNullableRecordViewReader_" }
    return ""
}

fn IsLinkedReaderParameter(&ty: TypeNameBinding): bool {
    return ty.declaration_kind == "IntRecordReaderCallback" || ty.declaration_kind == "NullableRecordViewReader"
}

fn MatchesLinkedStructArrayOwner(&target: TypeNameBinding, &origin: TypeNameBinding): bool {
    return target.declaration_kind == "StructArray" && origin.declaration_kind == "OwnedStructArray"
        && target.module_index == origin.module_index && target.declaration_node == origin.declaration_node
}
