         LinkedOkAvailable, LinkedRecordFields, ReadLinkedNullBinding } from "./link_plan_c.ku"

fn LinkedNullPrototype(&callee: LinkedNullFunction): str! {
    if (callee.unit == 0 && callee.node == 1) { return ok(LinkedFsReadReference(callee.symbol)) }
    text = "extern " + LinkedNullResultType(callee)? + " " + callee.symbol.clone() + "("
    if (callee.parameters.len() == 0) { text += "void" }
    index = 0
    while (index < callee.parameters.len()) {
        if (index > 0) { text += ", " }
        text += LinkedNullCType(callee.parameters[index])?
        index = index + 1
    }
    return ok(text + ");\n")
}

fn EmitLinkedNullPrototypes(&links: [LinkedNullFunction], &slots: [LinkedNullSlot],
                            &payload: TypeNameBinding, checked: bool): str! {
    text = ""
    records: [str] = []
    string_result = LinkedBufferResult(payload)
    index = 0
    while (!string_result && index < links.len()) {
        string_result = links[index].returns_result && LinkedBufferResult(links[index].result)
        index = index + 1
    }
    if (string_result) { text = StructValueResultHeader("KuProjectionString") }
    if (payload.declaration_kind == "Struct" || (checked && LinkedIntResult(payload))) {
        root = LinkedNullCType(payload)?
        text += StructValueResultHeader(root)
        records = records.push(root)
    }
    index = 0
    while (index < slots.len()) {
        if (slots[index].value.ty.declaration_kind == "IntPairResultCallback") {
            callback = slots[index].value.ty.clone()
            carrier = LinkedNullCType(callback)?
            if (!ContainsType(records, carrier)) {
                callback.declaration_kind = "Struct"
                result = LinkedNullCType(callback)?
                if (!ContainsType(records, result)) {
                    text += StructValueResultHeader(result)
                    records = records.push(result.clone())
                }
                text += "typedef struct { KuBootstrapResult_" + result + " (*entry)(void*, int64_t, int64_t); "
                    + "void *environment; } " + carrier.clone() + ";\n"
                records = records.push(carrier)
            }
        }
        index = index + 1
    }
    for dependency in links.clone() {
        if (dependency.returns_result && (dependency.result.declaration_kind == "Struct" || LinkedIntResult(dependency.result))) {
            kind = LinkedNullCType(dependency.result)?
            if (!ContainsType(records, kind)) {
                text += StructValueResultHeader(kind)
                records = records.push(kind)
            }
        }
        text += LinkedNullPrototype(dependency)?
    }
    return ok(text)
}

fn EmitLinkedNullDeclarations(&body: LinkedNullState, &result: TypeNameBinding): str! {
    ops = GuardArithmetic(body.uses_add, body.uses_sub)
    if (body.uses_mul || body.uses_div) { ops += "#include <stdio.h>\n#include <stdlib.h>\n\n" }
    if (body.uses_mul) { ops += ScalarCheckedMultiplyC() }
    if (body.uses_string_contains) {
        ops += ScalarStringHelpers(false, false, true, false, false, false, false)
        ops += "static bool ku_linked_string_contains(KuProjectionString hay, KuProjectionString needle) {\n"
            + "    return ku_scalar_string_contains(hay.ptr, hay.len, needle.ptr, needle.len);\n}\n\n"
    }
    header = LinkedCPrelude(body, ops + GuardStringEquality(body.uses_string_equal))
    declarations = EmitLinkedArrayBody(body, header, StructResultHeader())?
    checked = !body.plain_value_result
    return ok(declarations + EmitLinkedNullPrototypes(body.links, body.slots, result, checked)?)
}

fn EmitLinkedFunction(&body: LinkedNullState, &symbol: str, &signature: str, &payload: TypeNameBinding): str! {
    header = EmitLinkedNullDeclarations(body, payload)?
    result = ""
    if (body.plain_value_result) { result = LinkedNullCType(payload)? }
    else { result = LinkedCheckedResultCType(payload)? }
    keep = LinkedNullResultCleanupReference(body.owning_layouts, payload)
    char_errors = ""
    if (body.uses_chars) { char_errors = ManagedSourceCharactersErrors() }
    return ok(FinishLinkedFunctionC(header + body.callback_helpers.clone(), body, symbol, signature, result, keep, char_errors, ""))
}

fn LowerLinkedArrayLocal(&project: LinkedNullProject, state: LinkedNullState, &statement: Node, id: int): LinkedNullState! {
    ty = ReadLinkedOwnedArray(project, 1, LinkedNullChild(project, 1, statement, 0), true, true)?
    value_id = LinkedNullChild(project, 1, statement, 1)
    value = LinkedNullNode(project, 1, value_id)
    if (LinkedNullBinding(state.slots, statement.text) != 0) {
        RejectLayout("linked_array_local", "expected a new typed array owner", DeclarationSpan(statement))?
    }
    if (value.kind == "Variable" && value.edge_count == 0) {
        input = ReadLinkedNullBinding(state, value)?
        if (!SameLinkedType(input.value.ty, ty) || input.value.borrowed) {
            RejectLayout("linked_array_local", "expected a matching named array owner", DeclarationSpan(value))?
        }
        local = AddLinkedNullSlot(project, input.state, statement.text.clone(), "l" + str(id), ty, false)?
        local.state.code += "    " + local.value.text + " = " + input.value.text.clone() + ";\n"
        local.state.slots[local.value.slot - 1].live = true
        return MoveLinkedNullSlot(local.state, input.value)
    }
    if (value.kind != "Array") {
        RejectLayout("linked_array_local", "expected an array literal or a matching named owner", DeclarationSpan(value))?
    }
    if (value.edge_count != 0) {
        if (!LinkedNullIntArrayOwner(ty)) {
            RejectLayout("linked_array_local", "a nonempty literal requires an int array", DeclarationSpan(value))?
        }
        literal = LowerLinkedIntArrayLiteral(project, state, value, value_id, statement.text.clone())?
        return ok(literal.state)
    }
    local = AddLinkedNullSlot(project, state, statement.text.clone(), "l" + str(id), ty, false)?
    local.state.slots[local.value.slot - 1].live = true
    return ok(local.state)
}

fn LowerLinkedTargetSet(&project: LinkedNullProject, state: LinkedNullState, &statement: Node,
                       id: int, depth: int): LinkedNullState! {
    target_id = LinkedNullChild(project, 1, statement, 0)
    target = LinkedNullNode(project, 1, target_id)
    if (target.kind == "Index" && target.edge_count == 2) {
        root = LinkedNullNode(project, 1, LinkedNullChild(project, 1, target, 0))
        slot = LinkedNullBinding(state.slots, root.text)
        if (root.kind != "Variable" || root.edge_count != 0 || slot == 0 || state.slots[slot - 1].parameter ||
            state.slots[slot - 1].value.borrowed || ContainsIndex(state.append_captures, slot) ||
            state.slots[slot - 1].value.ty.declaration_kind != "OwnedIntArray") {
            RejectLayout("linked_index_target", "assignment requires an owning local int array", DeclarationSpan(root))?
        }
        RequireLinkedMutableName(root.text, DeclarationSpan(root))?
        rhs = LowerLinkedNullValue(project, state, LinkedNullChild(project, 1, statement, 1), 0)?
        if (rhs.value.ty.declaration_kind != "Builtin" || rhs.value.ty.name != "int") {
            RejectLayout("linked_index_value", "assignment requires an int value", DeclarationSpan(statement))?
        }
        stored = "stored" + str(id)
        rhs.state.code += "    int64_t " + stored.clone() + " = " + rhs.value.text + ";\n"
        destination = LowerLinkedNullRead(project, rhs.state, target_id, 0)?
        destination.state.code += "    " + destination.value.text + " = " + stored + ";\n"
        return ok(destination.state)
    }
    return LowerLinkedLocalMemberSet(project, state, statement, depth != 0)
}

fn LowerLinkedLocalMemberSet(&project: LinkedNullProject, state: LinkedNullState, &statement: Node, guarded: bool): LinkedNullState! {
    target_id = LinkedNullChild(project, 1, statement, 0)
    target = LinkedNullNode(project, 1, target_id)
    if (target.kind != "Field" || target.edge_count != 1) {
        RejectLayout("linked_member_target", "assignment requires a direct field of a mutable local record", DeclarationSpan(target))?
    }
    root = LinkedNullNode(project, 1, LinkedNullChild(project, 1, target, 0))
    slot = LinkedNullBinding(state.slots, root.text)
    if (root.kind != "Variable" || root.edge_count != 0 || slot == 0 || state.slots[slot - 1].parameter ||
        state.slots[slot - 1].value.borrowed || state.slots[slot - 1].value.ty.declaration_kind != "Struct") {
        RejectLayout("linked_member_target", "assignment requires a direct field of a mutable local record", DeclarationSpan(root))?
    }

    RequireLinkedMutableName(root.text, DeclarationSpan(root))?

    rhs_id = LinkedNullChild(project, 1, statement, 1)
    argument = LinkedFieldAppendArgument(project, target, root, rhs_id)
    if (argument > 0) { return LowerLinkedFieldAppend(project, state, target_id, argument) }
    // Generate the RHS and finish its fallible work before selecting the
    // target in the resulting state. The old member still belongs to cleanup
    // if the RHS fails or consumes its record.
    rhs = LowerLinkedNullValue(project, state, rhs_id, 0)?
    replacement = rhs.value.clone()
    place = LowerLinkedNullRead(project, rhs.state, target_id, 0)?
    ty = place.value.ty.clone()
    string = LinkedStringResult(ty)
    copy = ty.declaration_kind == "Builtin" && (ty.name == "int" || ty.name == "bool")
    if (guarded && !copy) {
        RejectLayout("linked_member_target", "guarded record assignment requires a Copy int or bool field of a mutable local", DeclarationSpan(target))?
    }
    if (!SameLinkedType(ty, replacement.ty) || (!copy && (!string || replacement.borrowed))) {
        RejectLayout("linked_member_rebind_type", "replacement requires a matching Copy field or separate str owner", DeclarationSpan(target))?
    }
    if (string) { place.state.code += LinkedNullDropC(place.state.layouts, place.state.owning_layouts, ty, place.value.text) }
    place.state.code += "    " + place.value.text + " = " + replacement.text.clone() + ";\n"
    if (string) { return MoveLinkedNullSlot(place.state, replacement) }
    return ok(place.state)
}

fn LowerLinkedStringAppend(&project: LinkedNullProject, state: LinkedNullState, &statement: Node, id: int): LinkedNullState! {
    target_id = LinkedNullChild(project, 1, statement, 0)
    target = LinkedNullNode(project, 1, target_id)
    if (target.kind != "Variable" || target.edge_count != 0) {
        RejectLayout("linked_append_target", "string append requires a named local", DeclarationSpan(target))?
    }
    RequireLinkedMutableName(target.text, DeclarationSpan(target))?
    // Ku evaluates the right operand before reading the destination. If that
    // operand consumed the destination, the normal live-binding check refuses it.
    right = LowerLinkedNullValue(project, state, LinkedNullChild(project, 1, statement, 1), 0)?
    operand = right.value.clone()
    left = LowerLinkedNullRead(project, right.state, target_id, 0)?
    owner = left.value.clone()
    if (owner.slot == 0 || owner.borrowed || !LinkedStringResult(owner.ty)) {
        RejectLayout("linked_append_target", "string append requires a live owning str", DeclarationSpan(target))?
    }
    joined = EmitLinkedAddition(project, left.state, owner, operand, id, DeclarationSpan(statement))?
    drop = LinkedNullDropC(joined.state.layouts, joined.state.owning_layouts, owner.ty, owner.text)
    joined.state.code += drop + "    " + owner.text + " = " + joined.value.text.clone() + ";\n"
    replacement = joined.value.clone()
    return MoveLinkedNullSlot(joined.state, replacement)
}

fn LowerLinkedPlainReturn(&project: LinkedNullProject, state: LinkedNullState,
                          &statement: Node, &result: TypeNameBinding): LinkedNullState! {
    if (statement.edge_count != 1) {
        RejectLayout("linked_value_return", "expected one value", DeclarationSpan(statement))?
    }
    id = LinkedNullChild(project, 1, statement, 0)
    value = LowerLinkedNullValue(project, state, id, 0)?
    copy = result.declaration_kind == "Builtin" && (result.name == "bool" || result.name == "int")
    static_string = LinkedStringResult(result) && LinkedNullNode(project, 1, id).kind == "String"
    if (!SameLinkedType(value.value.ty, result) || (!copy && !static_string && (value.value.borrowed || value.value.slot == 0))) {
        RejectLayout("linked_value_return", "expected a value matching the declared result and ownership", DeclarationSpan(statement))?
    }
    value.state.code += "    result = " + value.value.text.clone() + ";\n"
    next = value.state
    if (!copy && !static_string) {
        owner = value.value.clone()
        next = MoveLinkedNullSlot(next, owner)?
    }
    next.code += "    goto cleanup;\n"
    return ok(next)
}

fn putLinkedDestructuredField(&project: LinkedNullProject, state: LinkedNullState, &local: Node,
                              id: int, &field: LinkedNullValue): LinkedNullState! {
    target = LinkedNullBinding(state.slots, local.text)
    next = state
    if (target == 0) {
        place = AddLinkedNullSlot(project, next, local.text.clone(), "d" + str(id), field.ty.clone(), false)?
        target = place.value.slot
        next = place.state
    } else {
        old = next.slots[target - 1].value.clone()
        if (target == field.slot || next.slots[target - 1].parameter || old.borrowed || !SameLinkedType(old.ty, field.ty) ||
            LinkedLocalReadCaptures(next.local_readers, target) || ContainsIndex(next.append_captures, target)) {
            RejectLayout("linked_destructure_target", "replacement requires a distinct mutable local of the same type", DeclarationSpan(local))?
        }
        RequireLinkedMutableName(local.text, DeclarationSpan(local))?
        next.code += LinkedNullDropC(next.layouts, next.owning_layouts, old.ty, old.text)
    }
    next.code += "    " + next.slots[target - 1].value.text.clone() + " = " + field.text.clone() + ";\n"
    next.slots[target - 1].live = true
    next.slots[target - 1].moved_members = []
    return MoveLinkedNullSlot(next, field)
}

fn LowerLinkedOwnedDestructure(&project: LinkedNullProject, state: LinkedNullState, &statement: Node): LinkedNullState! {
    count = statement.int_value
    at = DeclarationSpan(statement)
    if (count <= 0 || statement.edge_count != count + 1) {
        RejectLayout("linked_destructure_shape", "expected an exact record pattern without rest", at.clone())?
    }
    input = LowerLinkedNullValue(project, state, LinkedNullChild(project, 1, statement, count), 0)?
    owner = input.value
    next = input.state
    if (owner.ty.declaration_kind != "Struct" || owner.slot == 0 || owner.borrowed || owner.member_path != "" ||
        LinkedMemberUnavailable(next, owner, true)) {
        RejectLayout("linked_destructure_source", "expected a complete owning record", at.clone())?
    }
    fields = LinkedRecordFields(next.layouts, next.owning_layouts, owner.ty)?
    if (fields.len() != count) {
        RejectLayout("linked_destructure_shape", "expected all fields of the record", at.clone())?
    }

    seen_fields: [int] = []
    seen_locals: [int] = []
    index = 0
    while (index < count) {
        binding = LinkedNullNode(project, 1, LinkedNullChild(project, 1, statement, index))
        if (binding.kind != "ObjectDestructureBinding" || binding.edge_count != 1) {
            RejectLayout("linked_destructure_shape", "expected a field binding without a default", DeclarationSpan(binding))?
        }
        local_id = LinkedNullChild(project, 1, binding, 0)
        local = LinkedNullNode(project, 1, local_id)
        ordinal = FieldIndex(fields, binding.text)
        target = LinkedNullBinding(next.slots, local.text)
        if (ordinal == 0 || ContainsIndex(seen_fields, ordinal) || local.kind != "ObjectDestructureLocal" ||
            local.text == "" || local.edge_count != 0 || ContainsIndex(seen_locals, target) ||
            FindLinkedLocalRead(next.local_readers, local.text) != 0) {
            RejectLayout("linked_destructure_field", "expected a distinct named field and local", DeclarationSpan(binding))?
        }
        ty = fields[ordinal - 1].resolved.clone()
        if (ty.declaration_kind == "StructArray") { ty.declaration_kind = "OwnedStructArray" }
        else if (ty.declaration_kind == "BuiltinArray" && ty.name == "int") { ty.declaration_kind = "OwnedIntArray" }
        else if (ty.declaration_kind == "BuiltinArray") {
            RejectLayout("linked_destructure_field_type", "unsupported owning array field", DeclarationSpan(binding))?
        }
        member = LinkedNullValue { ty: ty, text: owner.text.clone() + ".f" + str(ordinal - 1),
            slot: owner.slot, borrowed: false, member_path: LinkedMemberPath(owner, ordinal) }
        next = putLinkedDestructuredField(project, next, local, local_id, member)?
        seen_fields = seen_fields.push(ordinal)
        seen_locals = seen_locals.push(LinkedNullBinding(next.slots, local.text))
        index = index + 1
    }
    // The fields that need destruction were zeroed by their moves. Copy
    // fields do not carry resources, and the source no longer has a binding.
    next.slots[owner.slot - 1].live = false
    return ok(next)
}

fn LowerLinkedSuccess(&project: LinkedNullProject, state: LinkedNullState, &statement: Node, &result: TypeNameBinding): LinkedNullState! {
    if (statement.edge_count != 1) {
        RejectLayout("unsupported_linked_success", "expected return ok(null)", DeclarationSpan(statement))?
    }
    call = LinkedNullNode(project, 1, LinkedNullChild(project, 1, statement, 0))
    if (call.kind != "Call" || call.edge_count < 1) {
        RejectLayout("unsupported_linked_success", "expected return ok or a bound Result call", DeclarationSpan(call))?
    }
    callee = LinkedNullNode(project, 1, LinkedNullChild(project, 1, call, 0))
    if ((callee.kind == "Variable" && callee.edge_count == 0 && callee.text != "ok")
        || (callee.kind == "Field" && callee.edge_count == 1)) {
        target = ResolveLinkedCall(project, state.slots, call, callee, true)?
        if (!SameLinkedType(target.result, result)) {
            RejectLayout("linked_tail_result", "forwarded Result must match the entry's declared payload", DeclarationSpan(call))?
        }
        call_id = LinkedNullChild(project, 1, statement, 0)
        arguments = LowerLinkedArguments(project, state, call, target, call_id, 0, true)?
        arguments.state.code = arguments.state.code + "    result = " + LinkedNullCallSymbol(target) + "(" + arguments.args
            + ");\n" + arguments.handoff + "    goto cleanup;\n"
        return ok(arguments.state)
    }
    if (call.edge_count != 2 || callee.kind != "Variable" || callee.edge_count != 0 || callee.text != "ok" || !LinkedOkAvailable(project.supplied[0].named.names.declarations, project.binding.modules[0].imports, state.slots)) {
        RejectLayout("unsupported_linked_success", "expected builtin ok with the declared payload", DeclarationSpan(call))?
    }
    id = LinkedNullChild(project, 1, call, 1)
    node = LinkedNullNode(project, 1, id)
    next = state
    if (LinkedNullHasResultValue(result)) {
        value = LowerLinkedExpectedValue(project, next, result, id, 0)?
        copy = LinkedIntResult(result)
        static_string = LinkedStringResult(result) && node.kind == "String" && node.edge_count == 0
        if (!SameLinkedType(value.value.ty, result) || (!copy && !static_string && (value.value.borrowed || value.value.slot == 0))) {
            RejectLayout("linked_result_return", "return needs a matching Copy int or an initialized matching owner", DeclarationSpan(node))?
        }
        value.state.code = value.state.code + "    result.value = " + value.value.text.clone() + ";\n"
        if (copy || static_string) { next = value.state }
        else {
            owner = value.value.clone()
            next = MoveLinkedNullSlot(value.state, owner)?
        }
    } else if (node.kind != "Null" || node.edge_count != 0) {
        RejectLayout("unsupported_linked_success", "expected builtin ok with literal null", DeclarationSpan(call))?
    }
    next.code = next.code + "    result.ok = true;\n    goto cleanup;\n"
    return ok(next)
}
