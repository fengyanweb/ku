import { GuardArithmetic, GuardStringEquality } from "./guarded_struct_c.ku"
import { ScalarCheckedMultiplyC } from "./scalar_int_emit.ku"
import { StructResultHeader } from "./struct_result_c.ku"
import { EmitLinkedArrayBody } from "./struct_array_c.ku"
import { TypeNameBinding } from "./type_names.ku"
import { Node } from "../stage2/ast.ku"
import { ManagedSourceCharactersErrors } from "./guarded_string_parts.ku"
import { DeclarationSpan } from "./names.ku"
import { RejectLayout } from "./struct_layouts.ku"
import { MoveLinkedNullSlot } from "./linked_member_ownership.ku"
import { EmitLinkedNullPrototypes, LinkedCheckedResultCType, LinkedNullChild, LinkedNullCType, LinkedNullProject,
         LinkedNullResultCleanupReference, SameLinkedType } from "./linked_null_types_c.ku"
import { LowerLinkedNullValue } from "./linked_null_values_c.ku"
import { LinkedCPrelude, LinkedNullState } from "./link_plan_c.ku"

fn FinishLinkedFunctionC(header: str, &body: LinkedNullState, &symbol: str, &signature: str,
                         &result_type: str, &payload_cleanup: str, char_errors: str): str {
    text = header
    array_checks = body.validated_arrays.len() > 0 || body.uses_str_array
    arithmetic = body.uses_add || body.uses_sub || body.uses_mul || body.uses_div
    text += "\n" + result_type.clone() + " " + symbol.clone() + "(" + signature.clone() + ") {\n"
    text += "    " + result_type.clone() + " result = {0};\n"
    text += payload_cleanup.clone()
    if (body.append_slots.len() > 0) { text += "    int append_status = KU_STRUCT_ARRAY_OK;\n" }
    clone = body.uses_clone || body.element_clones.len() > 0
    if (clone) { text += "    bool out_of_memory = false;\n" }
    if (array_checks) { text += "    bool invalid_array = false;\n" }
    if (body.uses_print) { text += "    bool output_failed = false;\n" }
    if (body.uses_str_view) { text += "    bool invalid_str = false;\n" }
    if (body.uses_struct_view) { text += "    bool invalid_struct_view = false;\n" }
    if (arithmetic) { text += "    bool overflow = false;\n" }
    if (body.uses_div) { text += "    bool division_by_zero = false;\n" }
    if (body.uses_index) { text += "    bool index_failed = false;\n    int64_t failure_index = 0;\n    size_t failure_length = 0;\n" }
    if (body.uses_concat) { text += "    const char* string_failure = NULL;\n" }
    if (body.uses_chars) { text += "    int source_status = KU_SOURCE_OK;\n" }
    text += body.declarations.clone() + body.code.clone() + "cleanup:\n" + body.drops.clone()
    if (body.uses_print) { text += "    if (output_failed) { fputs(\"output write failed\\n\", stderr); exit(EXIT_FAILURE); }\n" }
    if (clone) { text += "    if (out_of_memory) { fputs(\"out of memory\\n\", stderr); exit(EXIT_FAILURE); }\n" }
    if (array_checks) {
        message = "invalid struct array ownership"
        if (body.uses_str_array) { message = "invalid array view" }
        text += "    if (invalid_array) { fputs(\"" + message + "\\n\", stderr); exit(EXIT_FAILURE); }\n"
    }
    if (body.append_slots.len() > 0) {
        text += "    if (append_status != KU_STRUCT_ARRAY_OK) {\n"
            + "        const char *message = \"invalid struct array ownership\\n\";\n"
            + "        if (append_status == KU_STRUCT_ARRAY_CAPACITY) message = \"array allocation is too large\\n\";\n"
            + "        if (append_status == KU_STRUCT_ARRAY_OOM) message = \"array allocation failed\\n\";\n"
            + "        fputs(message, stderr); exit(EXIT_FAILURE);\n    }\n"
    }
    if (body.uses_str_view) { text += "    if (invalid_str) { fputs(\"invalid str view\\n\", stderr); exit(EXIT_FAILURE); }\n" }
    if (body.uses_struct_view) { text += "    if (invalid_struct_view) { fputs(\"invalid struct view\\n\", stderr); exit(EXIT_FAILURE); }\n" }
    if (body.uses_concat) { text += "    if (string_failure) { fputs(string_failure, stderr); exit(EXIT_FAILURE); }\n" }
    if (body.uses_chars) { text += char_errors }
    if (body.uses_div) { text += "    if (division_by_zero) { fputs(\"division by zero\\n\", stderr); exit(EXIT_FAILURE); }\n" }
    if (arithmetic) { text += "    if (overflow) { fputs(\"integer overflow\\n\", stderr); exit(EXIT_FAILURE); }\n" }
    if (body.uses_index) {
        text += "    if (index_failed) { fprintf(stderr, \"array/index_out_of_bounds: index %lld out of bounds for length %zu\\n\", "
            + "(long long)failure_index, failure_length); exit(EXIT_FAILURE); }\n"
    }
    return text + "    return result;\n}\n"
}

fn EmitLinkedNullDeclarations(&body: LinkedNullState, &result: TypeNameBinding): str! {
    ops = GuardArithmetic(body.uses_add, body.uses_sub)
    if (body.uses_mul || body.uses_div) { ops += "#include <stdio.h>\n#include <stdlib.h>\n\n" }
    if (body.uses_mul) { ops += ScalarCheckedMultiplyC() }
    header = LinkedCPrelude(body, ops + GuardStringEquality(body.uses_string_equal))
    declarations = EmitLinkedArrayBody(body, header, StructResultHeader())?
    return ok(declarations + EmitLinkedNullPrototypes(body.links, result)?)
}

fn EmitLinkedFunction(&body: LinkedNullState, &symbol: str, &signature: str, &payload: TypeNameBinding): str! {
    header = EmitLinkedNullDeclarations(body, payload)?
    result = ""
    if (body.plain_value_result) { result = LinkedNullCType(payload)? }
    else { result = LinkedCheckedResultCType(payload)? }
    keep = LinkedNullResultCleanupReference(body.owning_layouts, payload)
    char_errors = ""
    if (body.uses_chars) { char_errors = ManagedSourceCharactersErrors() }
    return ok(FinishLinkedFunctionC(header, body, symbol, signature, result, keep, char_errors))
}

fn LowerLinkedPlainReturn(&project: LinkedNullProject, state: LinkedNullState,
                          &statement: Node, &result: TypeNameBinding): LinkedNullState! {
    if (statement.edge_count != 1) {
        RejectLayout("linked_value_return", "expected one value", DeclarationSpan(statement))?
    }
    value = LowerLinkedNullValue(project, state, LinkedNullChild(project, 1, statement, 0), 0)?
    copy = result.declaration_kind == "Builtin" && result.name == "bool"
    if (!SameLinkedType(value.value.ty, result) || (!copy && (value.value.borrowed || value.value.slot == 0))) {
        RejectLayout("linked_value_return", "expected a value matching the declared result and ownership", DeclarationSpan(statement))?
    }
    value.state.code += "    result = " + value.value.text.clone() + ";\n"
    owner = value.value.clone()
    next = MoveLinkedNullSlot(value.state, owner)?
    next.code += "    goto cleanup;\n"
    return ok(next)
}
