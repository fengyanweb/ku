import { fs, string } from "std"
import { Node } from "../../stage2/ast.ku"
import { ParseProgram } from "../../stage3/parser.ku"
import { Collect } from "./collect.ku"

fn Select(prefix: str): fn(&Node): int | null {
    read = fn(&node: Node) {
        if (node.kind != "Function" || !node.text.starts_with(prefix)) { return null }
        return node.line
    }
    reader = read
    return reader
}

fn main(): null! {
    prefix = string.trim(fs.read("prefix.txt")?)
    if (prefix.len() == 0) {
        fail { domain: "inventory", code: "empty_prefix", message: "prefix.txt is empty" }
    }
    filter = Select(prefix)
    source = fs.read("source.ku")?
    declarations = Collect(ParseProgram(source)?, filter)?
    for declaration in declarations {
        println(declaration)
    }
    return ok(null)
}
