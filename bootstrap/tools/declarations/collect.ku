import { Node, ParseOutput } from "../../stage2/ast.ku"

fn Collect(output: ParseOutput, location: fn(&Node): int | null): [str]! {
    arena = output.arena
    nodes = arena.nodes
    edges = arena.edges
    module_node = nodes[output.root - 1].clone()
    inventory: [str] = []
    index = 0
    while (index < module_node.edge_count) {
        node = nodes[edges[module_node.first_edge + index] - 1].clone()
        line = location(node)
        if (line != null) {
            inventory = inventory.push(str(line) + ":" + str(node.column) + " " + node.text)
        }
        index = index + 1
    }
    return ok(inventory)
}
