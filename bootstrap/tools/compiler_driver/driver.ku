import "std.fs"
import { Span } from "../../stage2/span.ku"
import { ParseModule } from "../../stage3/parser.ku"
import { ImportBinding, SuppliedModule } from "../../semantics/imports.ku"
import { EmitLinkedUnit } from "../../semantics/linked_unit.ku"
import { BuildNameTable } from "../../semantics/names.ku"
import { BindProjectModules, CheckDirectCallContracts, CheckLiteralResultContracts } from "../../semantics/project_bindings.ku"
import { ManifestPaths, ReadProjectModulesAt } from "../../semantics/project_manifest.ku"
import { ProjectParent } from "../../semantics/project_paths.ku"
import { EmitScalarIntC, ScalarIntC } from "../../semantics/scalar_int_c.ku"
import { EmitScalarProjectC, EmitScalarProjectProgramC } from "../../semantics/scalar_project_c.ku"
import { BindTypeNames } from "../../semantics/type_names.ku"

fn readProject(&manifest: str): [SuppliedModule]! {
    at = Span { line: 1, column: 1, offset: 0, end_line: 1, end_column: 1, end_offset: 0 }
    paths = ManifestPaths(fs.read(manifest.clone())?, at)?
    prefix = ProjectParent(manifest)? + "/"
    return ReadProjectModulesAt(paths, prefix)
}

fn writeScalarC(generated: ScalarIntC): null! {
    println("/* " + generated.symbol + " */")
    print(generated.source)
    return ok(null)
}

fn BootstrapEntry(&command: str, &path: str, &symbol: str): null! {
    if (command == "emit-unit" || command == "emit-unit-plan") {
        print(EmitLinkedUnit(readProject(path)?, symbol, command == "emit-unit-plan")?)
        return ok(null)
    }
    if (command == "check-project" || command == "emit-project" || command == "emit-program") {
        project = readProject(path)?
        if (command == "emit-project") {
            return writeScalarC(EmitScalarProjectC(project, symbol)?)
        }
        if (command == "emit-program") {
            print(EmitScalarProjectProgramC(project)?)
            return ok(null)
        }
        BindProjectModules(project)?
        return ok(null)
    }
    input = BuildNameTable(ParseModule(fs.read(path.clone())?)?)?
    supplied: [SuppliedModule] = []
    imports: [ImportBinding] = []
    types = BindTypeNames(input, supplied)?
    CheckDirectCallContracts(input, imports, supplied)?
    CheckLiteralResultContracts(input)?
    if (command == "check") { return ok(null) }
    if (command == "emit") {
        return writeScalarC(EmitScalarIntC(input, types, symbol)?)
    }
    fail { domain: "bootstrap.cli", code: "command", message: "unknown compiler command" }
}

// The stage-0 checker still requires the ordinary zero-argument entry.
fn main(): null! { return ok(null) }
