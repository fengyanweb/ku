import { fs, json, string } from "std"
import { Node } from "../stage2/ast.ku"
import { Span } from "../stage2/span.ku"
import { DeclarationSpan } from "../semantics/names.ku"
import { BindProjectModules } from "../semantics/project_bindings.ku"
import { ManifestPaths, ReadProjectModulesAt } from "../semantics/project_manifest.ku"
import { RejectLayout } from "../semantics/struct_layouts.ku"
import { LinkedNullChild, LinkedNullNode, LinkedNullProject,
    LinkedNullType, LinkedStringResult } from "../semantics/linked_null_types_c.ku"
import { RequireProjectionLocalFunction } from "../semantics/struct_projection_c.ku"
import { BuiltinLinkPlanType, LinkPlanDeclaration } from "../semantics/link_plan_c.ku"
import { EmitLinkPlan } from "../semantics/link_plan_json_c.ku"
import { EmitStaticJsonString } from "../semantics/scalar_int_emit.ku"
import { ScalarStringLiteral } from "../semantics/scalar_int_operands.ku"

fn child(&project: LinkedNullProject, &parent: Node, index: int): Node {
    return LinkedNullNode(project, 1, LinkedNullChild(project, 1, parent, index))
}

fn require(valid: bool, &node: Node, message: str): null! {
    if (!valid) { RejectLayout("unsupported_json_literal_string", message, DeclarationSpan(node))? }
    return ok(null)
}

fn method(&project: LinkedNullProject, &call: Node, &name: str, arguments: int): Node! {
    require(call.kind == "Call" && call.edge_count == arguments + 1, call, "expected one direct method call")?
    target = child(project, call, 0)
    require(target.kind == "Field" && target.edge_count == 1 && target.text == name, target, "expected method " + name.clone())?
    receiver = child(project, target, 0)
    require(receiver.kind == "Variable" && receiver.edge_count == 0, receiver, "expected a direct binding")?
    return ok(receiver)
}

fn readLiteral(&project: LinkedNullProject, &entry: Node): Node! {
    require(entry.kind == "Function" && entry.edge_count == 3, entry,
        "expected a synchronous zero-argument function with a checked literal and a return")?
    result = child(project, entry, 0)
    require(result.kind == "TypeResult" && result.edge_count == 1, result, "expected explicit str!")?
    ty = LinkedNullType(project, 1, LinkedNullChild(project, 1, result, 0))?
    require(LinkedStringResult(ty), result, "expected a standard str result")?

    binding = child(project, entry, 1)
    require(binding.kind == "Assign" && binding.edge_count == 1, binding, "expected one fresh local binding")?
    checked = child(project, binding, 0)
    require(checked.kind == "TryUnwrap" && checked.edge_count == 1, checked, "expected a checked JSON parse")?
    parse = child(project, checked, 0)
    namespace = method(project, parse, "parse", 1)?
    require(namespace.text != binding.text, namespace, "the local must not shadow the JSON namespace")?
    standard = false
    for entry_binding in project.binding.modules[0].imports.clone() {
        if (entry_binding.local_name == namespace.text && entry_binding.source_name == "json" &&
            entry_binding.module_index == 0 && (entry_binding.path == "std" || entry_binding.path == "std.json")) {
            standard = true
        }
    }
    require(standard, namespace, "expected the bound std.json namespace")?
    literal = child(project, parse, 1)
    require(literal.kind == "String" && literal.edge_count == 0, literal, "JSON input must be a static str literal")?

    returned = child(project, entry, 2)
    require(returned.kind == "Return" && returned.edge_count == 1, returned, "expected the conversion's checked result")?
    converted = method(project, child(project, returned, 0), "as_str", 0)?
    require(converted.text == binding.text, converted, "conversion must read the parsed local binding")?
    return ok(literal)
}

fn decodeLiteral(&literal: Node): str! {
    try {
        decoded = json.parse(literal.text.clone())?
        value = decoded.as_str()?
        return ok(value)
    } catch (_error) {
        RejectLayout("unsupported_json_literal_string", "expected a valid JSON string literal", DeclarationSpan(literal))?
    }
    return ok("")
}

fn emitLiteral(&literal: Node, &symbol: str): str! {
    value = decodeLiteral(literal)?
    length = value.byte_len()
    require(length <= 64, literal, "decoded JSON string must fit the first 64-byte escape buffer")?
    rendered = literal.clone()
    rendered.text = value
    bytes = ScalarStringLiteral(rendered)?
    return ok(EmitStaticJsonString(symbol, bytes, length, literal.text.contains("\\")))
}

fn main(): null! {
    at = Span { line: 1, column: 1, offset: 0, end_line: 1, end_column: 1, end_offset: 0 }
    supplied = ReadProjectModulesAt(ManifestPaths(fs.read("modules.txt")?, at)?, "")?
    binding = BindProjectModules(supplied)?
    project = LinkedNullProject { supplied: supplied.clone(), binding: binding }
    name = string.trim(fs.read("function.txt")?)
    entry = RequireProjectionLocalFunction(project.supplied, name)?
    literal = readLiteral(project, LinkedNullNode(project, 1, entry))?
    symbol = "ku_json_literal_str_" + str(entry)
    source = emitLiteral(literal, symbol)?
    if (fs.exists("plan.txt")) {
        declaration = LinkPlanDeclaration { unit: 1, node: entry, symbol: symbol,
            parameters: [], result: BuiltinLinkPlanType("str", "KuBootstrapResult_KuProjectionString", false), returns_result: true }
        print(EmitLinkPlan(supplied, "json-literal-str", declaration, [])?)
    } else { print(source) }
    return ok(null)
}
