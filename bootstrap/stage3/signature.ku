import { Token } from "../stage1/token.ku"
import { Span, SpanFromToken, SpanMerge } from "../stage2/span.ku"
import { Node } from "../stage2/ast.ku"
import { RejectAt, RejectAtPoint } from "./support.ku"

// Type parts form a bounded, append-only post-order plan. Child NodeIds refer
// to earlier parts through the separate edge table, matching the final AST
// arena without introducing recursive values or a second type representation.
struct TypePart {
    kind: str
    text: str
    span: Span
    first_edge: int
    edge_count: int
    depth: int
}

struct SignatureType {
    parts: [TypePart]
    edges: [int]
    root: int
    consumed: int
    work: int
}

struct TypeValueEntry {
    node: int
    previous: int
}

struct TypeFrame {
    opener: Token
    previous: int
    value_base: int
    outer_member_count: int
    param_index: int
    param_top: int
    param_count: int
    returning: bool
}

fn NewTypeFrame(opener: Token, previous: int, value_base: int, outer_count: int, param_index: int): TypeFrame {
    return TypeFrame { opener: opener, previous: previous, value_base: value_base, outer_member_count: outer_count, param_index: param_index, param_top: 0, param_count: 0, returning: false }
}

fn TypeNamePart(text: str, start: Token, end: Token): TypePart {
    return TypePart {
        kind: "TypeName",
        text: text,
        span: Span { line: start.line, column: start.column, offset: start.offset, end_line: end.end_line, end_column: end.end_column, end_offset: end.end_offset },
        first_edge: 0,
        edge_count: 0,
        depth: 0
    }
}

fn TypeArrayPart(start: Token, end: Token, first_edge: int, depth: int): TypePart {
    return TypePart {
        kind: "TypeArray",
        text: "",
        span: Span { line: start.line, column: start.column, offset: start.offset, end_line: end.end_line, end_column: end.end_column, end_offset: end.end_offset },
        first_edge: first_edge,
        edge_count: 1,
        depth: depth
    }
}

fn TypeResultPart(inner: Span, bang: Token, first_edge: int, depth: int): TypePart {
    return TypePart {
        kind: "TypeResult",
        text: "",
        span: Span { line: inner.line, column: inner.column, offset: inner.offset, end_line: bang.end_line, end_column: bang.end_column, end_offset: bang.end_offset },
        first_edge: first_edge,
        edge_count: 1,
        depth: depth
    }
}

fn TypeUnionPart(first: Span, last: Span, first_edge: int, edge_count: int, depth: int): TypePart {
    return TypePart {
        kind: "TypeUnion",
        text: "",
        span: Span { line: first.line, column: first.column, offset: first.offset, end_line: last.end_line, end_column: last.end_column, end_offset: last.end_offset },
        first_edge: first_edge,
        edge_count: edge_count,
        depth: depth
    }
}

fn CheckTypeArenaCapacity(node_count: int, edge_count: int, additional_edges: int, error_token: Token): null! {
    if (node_count >= 4096) { RejectAt(error_token.clone(), "node_limit", "stage-3 parser accepts at most 4096 AST nodes")? }
    if (additional_edges < 0 || edge_count < 0 || edge_count > 8192 || additional_edges > 8192 - edge_count) {
        RejectAt(error_token, "edge_limit", "stage-3 parser accepts at most 8192 AST edges")?
    }
    return ok(null)
}

fn TypePartToNode(part: TypePart, first_edge: int): Node {
    return Node {
        kind: part.kind,
        text: part.text,
        int_value: 0,
        line: part.span.line,
        column: part.span.column,
        offset: part.span.offset,
        end_line: part.span.end_line,
        end_column: part.span.end_column,
        end_offset: part.span.end_offset,
        first_edge: first_edge,
        edge_count: part.edge_count
    }
}

fn CheckTypeDepth(depth: int, token: Token): null! {
    if (depth > 32) { RejectAt(token, "type_depth_exceeded", "stage-3 type nesting exceeds 32 levels")? }
    return ok(null)
}

fn CheckUnionWidth(count: int, token: Token): null! {
    if (count > 64) { RejectAt(token, "type_union_limit", "stage-3 union types accept at most 64 members")? }
    return ok(null)
}

fn FunctionReturnStart(&tokens: [Token], close: int): int! {
    colon = tokens[close + 1].clone()
    if (colon.kind != "Colon") {
        RejectAt(colon.clone(), "unexpected_token", "expected ':' before function type return")?
    }
    return ok(close + 2)
}

// Parse one type from a caller-owned declaration window. Return delimiters
// to the caller; commas inside callable parameters stay in the type grammar.
fn ReadSignatureTypeAt(&tokens: [Token], start: int): SignatureType! {
    if (tokens.len() > 512) {
        RejectAtPoint("invalid_token_stream", "type window accepts at most 512 tokens")?
    }
    if (start < 0 || start >= tokens.len() || tokens[tokens.len() - 1].kind != "Eof") {
        RejectAtPoint("invalid_token_stream", "type inspection escaped its bounded token window")?
    }

    work = 0
    cursor = start
    parts: [TypePart] = []
    edges: [int] = []
    values: [TypeValueEntry] = []
    frames: [TypeFrame] = []
    value_top = 0
    frame_top = 0
    frame_depth = 0
    member_count = 0
    expect_atom = true
    root = 0
    parsing = true

    while (parsing) {
        token = tokens[cursor].clone()
        member_root = 0
        member_origin = token.clone()
        if (expect_atom) {
            if (token.kind == "LBracket" || token.kind == "Fn") {
                if (frame_depth >= 32) { RejectAt(token.clone(), "type_depth_exceeded", "stage-3 type nesting exceeds 32 levels")? }
                opener = cursor
                cursor = cursor + 1
                if (token.kind == "Fn") {
                    if (tokens[cursor].kind != "LParen") {
                        RejectAt(tokens[cursor].clone(), "unexpected_token", "expected '(' after 'fn' in function type")?
                    }
                    cursor = cursor + 1
                }
                type_frame = NewTypeFrame(token, frame_top, value_top, member_count, cursor)
                if (type_frame.opener.kind == "Fn" && tokens[cursor].kind == "RParen") {
                    cursor = FunctionReturnStart(tokens, cursor)?
                    type_frame.returning = true
                }
                work = work + cursor - opener
                frames = frames.push(type_frame)
                frame_top = frames.len()
                frame_depth = frame_depth + 1
                member_count = 0
            } else if (token.kind == "Ampersand") {
                valid_mode = false
                if (frame_top > 0) {
                    mode_frame = frames[frame_top - 1].clone()
                    valid_mode = mode_frame.opener.kind == "Fn" && !mode_frame.returning && cursor == mode_frame.param_index
                }
                if (!valid_mode) {
                    RejectAt(token.clone(), "unexpected_token", "single '&' is only allowed before a function parameter; Ku does not provide reference types")?
                }
                cursor = cursor + 1
                work = work + 1
            } else {
                atom = token.clone()
                name = ""
                end = atom.clone()
                custom = false
                if (atom.kind == "Ident" && (atom.lexeme == "int" || atom.lexeme == "float" || atom.lexeme == "bool" || atom.lexeme == "str")) { name = atom.lexeme.clone() }
                else if (atom.kind == "Null") { name = "null" }
                else if (atom.kind == "Ident" && (atom.lexeme == "string" || atom.lexeme == "nil")) { RejectAt(atom.clone(), "unexpected_token", "expected type name")? }
                else if (atom.kind == "Ident") { name = atom.lexeme.clone(); custom = true }
                else if (atom.kind == "Async") { RejectAt(atom.clone(), "unsupported_type", "stage-3 async function types are not supported")? }
                else { RejectAt(atom.clone(), "unexpected_token", "expected type name")? }
                cursor = cursor + 1
                work = work + 1
                if (!custom && tokens[cursor].kind == "Dot") { RejectAt(tokens[cursor].clone(), "unsupported_type", "dotted type names must start with a custom identifier")? }
                while (custom && tokens[cursor].kind == "Dot") {
                    cursor = cursor + 1
                    work = work + 1
                    part = tokens[cursor].clone()
                    if (part.kind != "Ident") { RejectAt(part.clone(), "unexpected_token", "expected type name after '.'")? }
                    name = name + "." + part.lexeme.clone()
                    end = part
                    cursor = cursor + 1
                    work = work + 1
                }

                CheckTypeArenaCapacity(parts.len(), edges.len(), 0, atom.clone())?
                name_part = TypeNamePart(name, atom.clone(), end)
                parts = parts.push(name_part)
                member_root = parts.len()
            }
        } else if (token.kind == "Pipe") {
            cursor = cursor + 1
            work = work + 1
            expect_atom = true
        } else {
            value_base = 0
            frame = NewTypeFrame(token.clone(), 0, 0, 0, 0)
            if (frame_top > 0) {
                frame = frames[frame_top - 1].clone()
                value_base = frame.value_base
                if (frame.opener.kind == "LBracket" && token.kind != "RBracket") {
                    RejectAt(token.clone(), "unexpected_token", "expected ']' after array type")?
                }
                if (frame.opener.kind == "Fn" && !frame.returning && token.kind != "Comma" && token.kind != "RParen") {
                    RejectAt(token.clone(), "unexpected_token", "expected ')' after function type parameters")?
                }
            }

            reversed: [int] = []
            walk = value_top
            remaining = member_count
            while (remaining > 0) {
                if (walk == 0 || walk == value_base) { RejectAt(token.clone(), "invalid_node_id", "type value stack lost its level boundary")? }
                entry = values[walk - 1].clone()
                if (entry.node <= 0 || entry.node > parts.len()) { RejectAt(token.clone(), "invalid_node_id", "type value stack contains an invalid NodeId")? }
                reversed = reversed.push(entry.node)
                walk = entry.previous
                remaining = remaining - 1
                work = work + 1
            }
            if (walk != value_base || reversed.len() == 0) { RejectAt(token.clone(), "invalid_node_id", "type value stack does not match its level")? }

            level_root = reversed[0]
            if (reversed.len() > 1) {
                CheckTypeArenaCapacity(parts.len(), edges.len(), reversed.len(), token.clone())?
                union_first_edge = edges.len()
                reverse_index = reversed.len()
                union_depth = 0
                first_child = 0
                last_child = 0
                while (reverse_index > 0) {
                    reverse_index = reverse_index - 1
                    child = reversed[reverse_index]
                    if (first_child == 0) { first_child = child }
                    last_child = child
                    child_depth = parts[child - 1].depth
                    if (child_depth > union_depth) { union_depth = child_depth }
                    edges = edges.push(child)
                    work = work + 1
                }
                first_span = parts[first_child - 1].span.clone()
                last_span = parts[last_child - 1].span.clone()
                union_part = TypeUnionPart(first_span, last_span, union_first_edge, reversed.len(), union_depth)
                parts = parts.push(union_part)
                level_root = parts.len()
            }

            if (frame_top == 0) {
                root = level_root
                parsing = false
            } else if (frame.opener.kind == "Fn" && !frame.returning) {
                parameter = tokens[frame.param_index].clone()
                mode = ""
                if (parameter.kind == "Ampersand") { mode = "&" }
                param_span = SpanMerge(SpanFromToken(parameter.clone()), parts[level_root - 1].span.clone())
                CheckTypeArenaCapacity(parts.len(), edges.len(), 1, parameter)?
                parameter_part = TypePart { kind: "TypeParameter", text: mode, span: param_span, first_edge: edges.len(), edge_count: 1, depth: parts[level_root - 1].depth }
                edges = edges.push(level_root)
                parts = parts.push(parameter_part)
                param_entry = TypeValueEntry { node: parts.len(), previous: frame.param_top }
                values = values.push(param_entry)
                frame.param_top = values.len()
                frame.param_count = frame.param_count + 1
                if (token.kind == "Comma") {
                    cursor = cursor + 1
                    work = work + 1
                    frame.param_index = cursor
                } else {
                    cursor = FunctionReturnStart(tokens, cursor)?
                    work = work + 2
                    frame.returning = true
                }
                value_top = value_base
                member_count = 0
                expect_atom = true
                // Retain immutable parent links while replacing this frame.
                frames = frames.push(frame)
                frame_top = frames.len()
            } else {
                value_top = value_base
                frame_top = frame.previous
                frame_depth = frame_depth - 1
                member_count = frame.outer_member_count
                member_origin = frame.opener.clone()
                node_depth = parts[level_root - 1].depth + 1
                if (frame.opener.kind == "LBracket") {
                    CheckTypeDepth(node_depth, member_origin.clone())?
                    CheckTypeArenaCapacity(parts.len(), edges.len(), 1, member_origin.clone())?
                    first_edge = edges.len()
                    edges = edges.push(level_root)
                    array_part = TypeArrayPart(member_origin.clone(), token, first_edge, node_depth)
                    parts = parts.push(array_part)
                    cursor = cursor + 1
                    work = work + 1
                } else {
                    parameters: [int] = []
                    param_link = frame.param_top
                    while (param_link > 0) {
                        param = values[param_link - 1].clone()
                        parameters = parameters.push(param.node)
                        child_depth = parts[param.node - 1].depth + 1
                        if (child_depth > node_depth) { node_depth = child_depth }
                        param_link = param.previous
                        work = work + 1
                    }
                    CheckTypeDepth(node_depth, member_origin.clone())?
                    CheckTypeArenaCapacity(parts.len(), edges.len(), frame.param_count + 1, member_origin.clone())?
                    first_edge = edges.len()
                    param_index = parameters.len()
                    while (param_index > 0) {
                        param_index = param_index - 1
                        edges = edges.push(parameters[param_index])
                        work = work + 1
                    }
                    edges = edges.push(level_root)
                    span = SpanMerge(SpanFromToken(member_origin.clone()), parts[level_root - 1].span.clone())
                    callable = TypePart { kind: "TypeFunction", text: "", span: span, first_edge: first_edge, edge_count: frame.param_count + 1, depth: node_depth }
                    parts = parts.push(callable)
                }
                member_root = parts.len()
            }
        }
        if (member_root > 0) {
            if (tokens[cursor].kind == "Bang") {
                bang = tokens[cursor].clone()
                result_depth = parts[member_root - 1].depth + 1
                CheckTypeDepth(result_depth, bang.clone())?
                CheckTypeArenaCapacity(parts.len(), edges.len(), 1, bang.clone())?
                first_edge = edges.len()
                edges = edges.push(member_root)
                inner_span = parts[member_root - 1].span.clone()
                result_part = TypeResultPart(inner_span, bang, first_edge, result_depth)
                parts = parts.push(result_part)
                member_root = parts.len()
                cursor = cursor + 1
                work = work + 1
            }
            value_entry = TypeValueEntry { node: member_root, previous: value_top }
            values = values.push(value_entry)
            value_top = values.len()
            member_count = member_count + 1
            CheckUnionWidth(member_count, member_origin)?
            expect_atom = false
        }
    }

    if (root <= 0 || root > parts.len()) { RejectAt(tokens[cursor].clone(), "invalid_node_id", "type plan root is invalid")? }
    consumed = cursor - start
    // Retain the admission charge for the previous scan and validation passes
    // (including their boundary token), even though this pass borrows tokens.
    work = work + 2 * (consumed + 1)
    return ok(SignatureType { parts: parts, edges: edges, root: root, consumed: consumed, work: work })
}

// The exact-window entry retains its validation and single-pass work charge.
// Declaration readers instead use the bounded borrowed entry above.
fn ParseTypeWindow(tokens: [Token]): SignatureType! {
    if (tokens.len() == 0) {
        RejectAtPoint("invalid_token_stream", "type window must contain one final non-type boundary token")?
    }
    if (tokens.len() > 512) {
        RejectAt(tokens[0].clone(), "invalid_token_stream", "type window accepts at most 512 tokens")?
    }
    last_index = tokens.len() - 1
    terminal = tokens[last_index].clone()
    kind = terminal.kind.clone()
    if (kind == "LBracket" || kind == "RBracket" || kind == "Ident" || kind == "Null" || kind == "Dot" || kind == "Bang" || kind == "Pipe" || kind == "Fn" || kind == "Async") {
        RejectAt(terminal.clone(), "invalid_token_stream", "type window is missing its final non-type boundary")?
    }
    index = 0
    while (index < last_index) {
        if (tokens[index].kind == "Eof") {
            RejectAt(tokens[index].clone(), "invalid_token_stream", "type window boundary must be final")?
        }
        index = index + 1
    }
    window: [Token] = tokens
    if (kind != "Eof") {
        delimited: [Token] = []
        index = 0
        while (index < last_index) {
            delimited = delimited.push(window[index].clone())
            index = index + 1
        }
        terminal.kind = "Eof"
        window = delimited.push(terminal)
    }
    parsed = ReadSignatureTypeAt(window, 0)?
    if (parsed.consumed != last_index) {
        RejectAt(window[parsed.consumed].clone(), "invalid_token_stream", "type window boundary must be final")?
    }
    parsed.work = parsed.work - window.len()
    return ok(parsed)
}
