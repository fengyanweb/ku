import { Token } from "../stage1/token.ku"
import { Span, SpanFromToken, SpanMerge } from "../stage2/span.ku"
import { Node } from "../stage2/ast.ku"
import { RejectAt, RejectAtPoint, RejectAtSpan } from "./support.ku"
import { FunctionReturnStart, ReadTypeOpening, ReadTypeToken, ReadTypeTokenKind } from "./signature_tokens.ku"

// Type parts form a bounded, append-only post-order plan. Child NodeIds refer
// to earlier parts through the separate edge table, matching the final AST
// arena without introducing recursive values or a second type representation.
struct TypePart {
    kind: str
    text: str
    span: Span
    first_edge: int
    edge_count: int
    depth: int
}

struct SignatureType {
    parts: [TypePart]
    edges: [int]
    root: int
    consumed: int
    work: int
}

struct TypeValueEntry {
    node: int
    previous: int
}

struct TypeFrame {
    opener: Token
    previous: int
    value_base: int
    outer_member_count: int
    param_index: int
    param_top: int
    param_count: int
    returning: bool
}

fn NewTypeFrame(opener: Token, previous: int, value_base: int, outer_count: int, param_index: int, returning: bool): TypeFrame {
    return TypeFrame { opener: opener, previous: previous, value_base: value_base, outer_member_count: outer_count, param_index: param_index, param_top: 0, param_count: 0, returning: returning }
}

fn TypeNamePart(text: str, start: Token, end: Token): TypePart {
    return TypePart {
        kind: "TypeName",
        text: text,
        span: Span { line: start.line, column: start.column, offset: start.offset, end_line: end.end_line, end_column: end.end_column, end_offset: end.end_offset },
        first_edge: 0,
        edge_count: 0,
        depth: 0
    }
}

fn TypeArrayPart(start: Token, end: Token, first_edge: int, depth: int): TypePart {
    return TypePart {
        kind: "TypeArray",
        text: "",
        span: Span { line: start.line, column: start.column, offset: start.offset, end_line: end.end_line, end_column: end.end_column, end_offset: end.end_offset },
        first_edge: first_edge,
        edge_count: 1,
        depth: depth
    }
}

fn TypeResultPart(inner: Span, bang: Token, first_edge: int, depth: int): TypePart {
    return TypePart {
        kind: "TypeResult",
        text: "",
        span: Span { line: inner.line, column: inner.column, offset: inner.offset, end_line: bang.end_line, end_column: bang.end_column, end_offset: bang.end_offset },
        first_edge: first_edge,
        edge_count: 1,
        depth: depth
    }
}

fn TypeUnionPart(first: Span, last: Span, first_edge: int, edge_count: int, depth: int): TypePart {
    return TypePart {
        kind: "TypeUnion",
        text: "",
        span: Span { line: first.line, column: first.column, offset: first.offset, end_line: last.end_line, end_column: last.end_column, end_offset: last.end_offset },
        first_edge: first_edge,
        edge_count: edge_count,
        depth: depth
    }
}

fn CheckTypeArenaCapacity(node_count: int, edge_count: int, additional_edges: int, error_token: Token): null! {
    if (node_count >= 4096) { RejectAt(error_token.clone(), "node_limit", "stage-3 parser accepts at most 4096 AST nodes")? }
    if (additional_edges < 0 || edge_count < 0 || edge_count > 8192 || additional_edges > 8192 - edge_count) {
        point = Span {
            line: error_token.line, column: error_token.column, offset: error_token.offset,
            end_line: error_token.end_line, end_column: error_token.end_column, end_offset: error_token.end_offset
        }
        RejectAtSpan(point, "edge_limit", "stage-3 parser accepts at most 8192 AST edges")?
    }
    return ok(null)
}

fn TypePartToNode(part: TypePart, first_edge: int): Node {
    return Node {
        kind: part.kind,
        text: part.text,
        int_value: 0,
        line: part.span.line,
        column: part.span.column,
        offset: part.span.offset,
        end_line: part.span.end_line,
        end_column: part.span.end_column,
        end_offset: part.span.end_offset,
        first_edge: first_edge,
        edge_count: part.edge_count
    }
}

fn CheckTypeDepth(depth: int, token: Token): null! {
    if (depth > 32) { RejectAt(token, "type_depth_exceeded", "stage-3 type nesting exceeds 32 levels")? }
    return ok(null)
}

fn CheckUnionWidth(count: int, token: Token): null! {
    if (count > 64) { RejectAt(token, "type_union_limit", "stage-3 union types accept at most 64 members")? }
    return ok(null)
}

struct TypeMembers {
    reversed: [int]
    depth: int
    first: int
    last: int
}

struct TypeChildren {
    reversed: [int]
    depth: int
}

fn CheckTypeParameterMode(&frames: [TypeFrame], frame_top: int, cursor: int, &token: Token): null! {
    if (frame_top > 0) {
        frame = frames[frame_top - 1].clone()
        if (frame.opener.kind == "Fn" && !frame.returning && cursor == frame.param_index) { return ok(null) }
    }
    RejectAt(token.clone(), "unexpected_token", "single '&' is only allowed before a function parameter; Ku does not provide reference types")?
    return ok(null)
}

// Validate the borrowed token range first. A separate constructor can then
// return the owned name directly, without cloning a TypePart out of a result.
fn ReadTypeAtomEnd(&tokens: [Token], start: int, window_end: int, type_last: int, &atom: Token): int! {
    custom = false
    if (atom.kind == "Ident") {
        if (atom.lexeme == "string" || atom.lexeme == "nil") {
            RejectAt(atom.clone(), "unexpected_token", "expected type name")?
        }
        custom = atom.lexeme != "int" && atom.lexeme != "float" && atom.lexeme != "bool" && atom.lexeme != "str"
    } else if (atom.kind == "Async") {
        RejectAt(atom.clone(), "unsupported_type", "stage-3 async function types are not supported")?
    } else if (atom.kind != "Null") {
        RejectAt(atom.clone(), "unexpected_token", "expected type name")?
    }

    cursor = start + 1
    kind = ReadTypeTokenKind(tokens, cursor, window_end, type_last)?
    if (!custom && kind == "Dot") {
        RejectAt(ReadTypeToken(tokens, cursor, window_end, type_last)?, "unsupported_type", "dotted type names must start with a custom identifier")?
    }
    while (custom && kind == "Dot") {
        part_kind = ReadTypeTokenKind(tokens, cursor + 1, window_end, type_last)?
        if (part_kind != "Ident") {
            RejectAt(ReadTypeToken(tokens, cursor + 1, window_end, type_last)?, "unexpected_token", "expected type name after '.'")?
        }
        cursor = cursor + 2
        kind = ReadTypeTokenKind(tokens, cursor, window_end, type_last)?
    }
    return ok(cursor)
}

fn TypeNameFromTokens(&tokens: [Token], start: int, end: int, atom: Token,
                       node_count: int, edge_count: int): TypePart! {
    CheckTypeArenaCapacity(node_count, edge_count, 0, atom.clone())?
    name = atom.lexeme.clone()
    if (atom.kind == "Null") { name = "null" }
    last = atom.clone()
    cursor = start + 2
    while (cursor < end) {
        part = tokens[cursor].clone()
        name = name + "." + part.lexeme.clone()
        last = part
        cursor = cursor + 2
    }
    return ok(TypeNamePart(name, atom, last))
}

fn CheckTypeLevelDelimiter(&frame: TypeFrame, &token: Token): null! {
    if (frame.opener.kind == "LBracket" && token.kind != "RBracket") {
        RejectAt(token.clone(), "unexpected_token", "expected ']' after array type")?
    }
    if (frame.opener.kind == "Fn" && !frame.returning && token.kind != "Comma" && token.kind != "RParen") {
        RejectAt(token.clone(), "unexpected_token", "expected ')' after function type parameters")?
    }
    return ok(null)
}

fn ReadTypeLevelChildren(&values: [TypeValueEntry], &parts: [TypePart], top: int, base: int, count: int, &token: Token): TypeMembers! {
    reversed: [int] = []
    walk = top
    remaining = count
    depth = 0
    while (remaining > 0) {
        if (walk == 0 || walk == base) { RejectAt(token.clone(), "invalid_node_id", "type value stack lost its level boundary")? }
        entry = values[walk - 1].clone()
        if (entry.node <= 0 || entry.node > parts.len()) { RejectAt(token.clone(), "invalid_node_id", "type value stack contains an invalid NodeId")? }
        reversed = reversed.push(entry.node)
        if (count > 1) {
            child_depth = parts[entry.node - 1].depth
            if (child_depth > depth) { depth = child_depth }
        }
        walk = entry.previous
        remaining = remaining - 1
    }
    if (walk != base || reversed.len() == 0) { RejectAt(token.clone(), "invalid_node_id", "type value stack does not match its level")? }
    first_index = reversed.len() - 1
    first = reversed[first_index]
    last = reversed[0]
    return ok(TypeMembers { reversed: reversed, depth: depth, first: first, last: last })
}

fn ReadCallableTypeChildren(&values: [TypeValueEntry], &parts: [TypePart], top: int, return_depth: int): TypeChildren {
    reversed: [int] = []
    walk = top
    depth = return_depth
    while (walk > 0) {
        parameter = values[walk - 1].clone()
        reversed = reversed.push(parameter.node)
        child_depth = parts[parameter.node - 1].depth + 1
        if (child_depth > depth) { depth = child_depth }
        walk = parameter.previous
    }
    return TypeChildren { reversed: reversed, depth: depth }
}

// The caller transfers the existing edge owner. The temporary child list
// remains borrowed and is traversed in source order by reading it backwards.
fn AppendReversedTypeEdges(input_edges: [int], &reversed: [int]): [int] {
    edges = input_edges
    index = reversed.len()
    while (index > 0) {
        index = index - 1
        edges = edges.push(reversed[index])
    }
    return edges
}

fn ReadTypeParameterPart(&tokens: [Token], &child: TypePart, parameter_index: int, window_end: int,
                         type_last: int, node_count: int, edge_count: int): TypePart! {
    parameter = ReadTypeToken(tokens, parameter_index, window_end, type_last)?
    mode = ""
    if (parameter.kind == "Ampersand") { mode = "&" }
    span = SpanMerge(SpanFromToken(parameter.clone()), child.span.clone())
    CheckTypeArenaCapacity(node_count, edge_count, 1, parameter)?
    return ok(TypePart { kind: "TypeParameter", text: mode, span: span, first_edge: edge_count, edge_count: 1, depth: child.depth })
}

fn CheckedArrayTypePart(&origin: Token, closing: Token, node_count: int, edge_count: int, depth: int): TypePart! {
    CheckTypeDepth(depth, origin.clone())?
    CheckTypeArenaCapacity(node_count, edge_count, 1, origin.clone())?
    return ok(TypeArrayPart(origin.clone(), closing, edge_count, depth))
}

fn CheckedCallableTypePart(&origin: Token, &result: TypePart, node_count: int, first_edge: int,
                           parameter_count: int, depth: int): TypePart! {
    CheckTypeDepth(depth, origin.clone())?
    CheckTypeArenaCapacity(node_count, first_edge, parameter_count + 1, origin.clone())?
    span = SpanMerge(SpanFromToken(origin.clone()), result.span.clone())
    return ok(TypePart { kind: "TypeFunction", text: "", span: span, first_edge: first_edge, edge_count: parameter_count + 1, depth: depth })
}

fn CheckedResultTypePart(&child: TypePart, bang: Token, node_count: int, edge_count: int): TypePart! {
    depth = child.depth + 1
    CheckTypeDepth(depth, bang.clone())?
    CheckTypeArenaCapacity(node_count, edge_count, 1, bang.clone())?
    return ok(TypeResultPart(child.span.clone(), bang, edge_count, depth))
}

// Parse one type from a caller-owned declaration window. Return delimiters
// to the caller; commas inside callable parameters stay in the type grammar.
fn ReadSignatureTypeAt(&tokens: [Token], start: int): SignatureType! {
    if (tokens.len() > 512) {
        RejectAtPoint("invalid_token_stream", "type window accepts at most 512 tokens")?
    }
    return ReadSignatureTypePrefix(tokens, start, tokens.len() - 1)
}

fn ReadSignatureTypePrefix(&tokens: [Token], start: int, window_end: int): SignatureType! {
    if (start < 0 || start > window_end || window_end >= tokens.len() || tokens.len() > 4096 || tokens[tokens.len() - 1].kind != "Eof") {
        RejectAtPoint("invalid_token_stream", "type inspection escaped its bounded token window")?
    }
    // A type may use 511 source tokens and its boundary, independently of
    // the size of the enclosing declaration or module.
    type_last = start + 511

    work = 0
    cursor = start
    parts: [TypePart] = []
    edges: [int] = []
    values: [TypeValueEntry] = []
    frames: [TypeFrame] = []
    value_top = 0
    frame_top = 0
    frame_depth = 0
    member_count = 0
    expect_atom = true
    root = 0
    parsing = true

    while (parsing) {
        token = ReadTypeToken(tokens, cursor, window_end, type_last)?
        member_root = 0
        member_origin = token.clone()
        if (expect_atom) {
            if (token.kind == "LBracket" || token.kind == "Fn") {
                opening = ReadTypeOpening(tokens, cursor, window_end, type_last, frame_depth, token)?
                type_frame = NewTypeFrame(token, frame_top, value_top, member_count, opening.parameter_index, opening.returning)
                work = work + opening.cursor - cursor
                cursor = opening.cursor
                frames = frames.push(type_frame)
                frame_top = frames.len()
                frame_depth = frame_depth + 1
                member_count = 0
            } else if (token.kind == "Ampersand") {
                CheckTypeParameterMode(frames, frame_top, cursor, token)?
                cursor = cursor + 1
                work = work + 1
            } else {
                next = ReadTypeAtomEnd(tokens, cursor, window_end, type_last, token)?
                part = TypeNameFromTokens(tokens, cursor, next, token, parts.len(), edges.len())?
                parts = parts.push(part)
                work = work + next - cursor
                cursor = next
                member_root = parts.len()
            }
        } else if (token.kind == "Pipe") {
            cursor = cursor + 1
            work = work + 1
            expect_atom = true
        } else {
            value_base = 0
            frame = NewTypeFrame(token.clone(), 0, 0, 0, 0, false)
            if (frame_top > 0) {
                frame = frames[frame_top - 1].clone()
                value_base = frame.value_base
                CheckTypeLevelDelimiter(frame, token)?
            }

            members = ReadTypeLevelChildren(values, parts, value_top, value_base, member_count, token)?
            work = work + members.reversed.len()
            level_root = members.last
            if (members.reversed.len() > 1) {
                count = members.reversed.len()
                CheckTypeArenaCapacity(parts.len(), edges.len(), count, token.clone())?
                first = parts[members.first - 1].span.clone()
                last = parts[level_root - 1].span.clone()
                part = TypeUnionPart(first, last, edges.len(), count, members.depth)
                edges = AppendReversedTypeEdges(edges, members.reversed)
                work = work + count
                parts = parts.push(part)
                level_root = parts.len()
            }

            if (frame_top == 0) {
                root = level_root
                parsing = false
            } else if (frame.opener.kind == "Fn" && !frame.returning) {
                parameter_part = ReadTypeParameterPart(tokens, parts[level_root - 1], frame.param_index, window_end, type_last, parts.len(), edges.len())?
                edges = edges.push(level_root)
                parts = parts.push(parameter_part)
                param_entry = TypeValueEntry { node: parts.len(), previous: frame.param_top }
                values = values.push(param_entry)
                frame.param_top = values.len()
                frame.param_count = frame.param_count + 1
                if (token.kind == "Comma") {
                    cursor = cursor + 1
                    work = work + 1
                    frame.param_index = cursor
                } else {
                    cursor = FunctionReturnStart(tokens, cursor, window_end, type_last)?
                    work = work + 2
                    frame.returning = true
                }
                value_top = value_base
                member_count = 0
                expect_atom = true
                // Retain immutable parent links while replacing this frame.
                frames = frames.push(frame)
                frame_top = frames.len()
            } else {
                value_top = value_base
                frame_top = frame.previous
                frame_depth = frame_depth - 1
                member_count = frame.outer_member_count
                member_origin = frame.opener.clone()
                node_depth = parts[level_root - 1].depth + 1
                if (frame.opener.kind == "LBracket") {
                    array_part = CheckedArrayTypePart(member_origin, token, parts.len(), edges.len(), node_depth)?
                    edges = edges.push(level_root)
                    parts = parts.push(array_part)
                    cursor = cursor + 1
                    work = work + 1
                } else {
                    parameters = ReadCallableTypeChildren(values, parts, frame.param_top, node_depth)
                    count = parameters.reversed.len()
                    callable = CheckedCallableTypePart(member_origin, parts[level_root - 1], parts.len(), edges.len(), frame.param_count, parameters.depth)?
                    edges = AppendReversedTypeEdges(edges, parameters.reversed)
                    work = work + 2 * count
                    edges = edges.push(level_root)
                    parts = parts.push(callable)
                }
                member_root = parts.len()
            }
        }
        if (member_root > 0) {
            bang = ReadTypeToken(tokens, cursor, window_end, type_last)?
            if (bang.kind == "Bang") {
                result_part = CheckedResultTypePart(parts[member_root - 1], bang, parts.len(), edges.len())?
                edges = edges.push(member_root)
                parts = parts.push(result_part)
                member_root = parts.len()
                cursor = cursor + 1
                work = work + 1
            }
            value_entry = TypeValueEntry { node: member_root, previous: value_top }
            values = values.push(value_entry)
            value_top = values.len()
            member_count = member_count + 1
            CheckUnionWidth(member_count, member_origin)?
            expect_atom = false
        }
    }

    if (root <= 0 || root > parts.len()) { RejectAt(ReadTypeToken(tokens, cursor, window_end, type_last)?, "invalid_node_id", "type plan root is invalid")? }
    consumed = cursor - start
    // Retain the admission charge for the previous scan and validation passes
    // (including their boundary token), even though this pass borrows tokens.
    work = work + 2 * (consumed + 1)
    return ok(SignatureType { parts: parts, edges: edges, root: root, consumed: consumed, work: work })
}

// The exact-window entry retains its validation and single-pass work charge.
// Declaration readers instead use the bounded borrowed entry above.
fn ParseTypeWindow(tokens: [Token]): SignatureType! {
    if (tokens.len() == 0) {
        RejectAtPoint("invalid_token_stream", "type window must contain one final non-type boundary token")?
    }
    if (tokens.len() > 512) {
        RejectAt(tokens[0].clone(), "invalid_token_stream", "type window accepts at most 512 tokens")?
    }
    last_index = tokens.len() - 1
    terminal = tokens[last_index].clone()
    kind = terminal.kind.clone()
    if (kind == "LBracket" || kind == "RBracket" || kind == "Ident" || kind == "Null" || kind == "Dot" || kind == "Bang" || kind == "Pipe" || kind == "Fn" || kind == "Async") {
        RejectAt(terminal.clone(), "invalid_token_stream", "type window is missing its final non-type boundary")?
    }
    index = 0
    while (index < last_index) {
        if (tokens[index].kind == "Eof") {
            RejectAt(tokens[index].clone(), "invalid_token_stream", "type window boundary must be final")?
        }
        index = index + 1
    }
    window: [Token] = tokens
    if (kind != "Eof") {
        delimited: [Token] = []
        index = 0
        while (index < last_index) {
            delimited = delimited.push(window[index].clone())
            index = index + 1
        }
        terminal.kind = "Eof"
        window = delimited.push(terminal)
    }
    parsed = ReadSignatureTypeAt(window, 0)?
    if (parsed.consumed != last_index) {
        RejectAt(window[parsed.consumed].clone(), "invalid_token_stream", "type window boundary must be final")?
    }
    parsed.work = parsed.work - window.len()
    return ok(parsed)
}
