import { Token } from "../stage1/token.ku"
import { SpanFromToken, SpanMerge } from "../stage2/span.ku"
import { Node, Arena, ParseOutput, ValidateParseOutput } from "../stage2/ast.ku"
import { TypeWindowContinues, PushTypeToken, ParseTypeWindow, CheckTypeArenaCapacity, TypePartToNode } from "./signature.ku"
import { RejectAt, RejectAtPoint } from "./support.ku"

struct StructRead {
    start: Token
    output: ParseOutput
    consumed: int
    work: int
}

// Kept beside the other top-level declaration reader so parser.ku remains
// below the Stage-1 per-file token ceiling. The caller still owns delimiter
// handling; a module declaration consumes only these two tokens.
fn ReadModule(start: Token, name: Token): ParseOutput! {
    if (start.kind != "Module") {
        RejectAt(start.clone(), "invalid_token_stream", "module reader must start with module")?
    }
    if (name.kind == "Eof") {
        RejectAt(start.clone(), "unexpected_token", "expected module name")?
    }
    if (name.kind != "Ident") {
        RejectAt(name.clone(), "unexpected_token", "expected module name")?
    }
    node = Node {
        kind: "Module",
        text: name.lexeme.clone(),
        int_value: 0,
        line: start.line,
        column: start.column,
        offset: start.offset,
        end_line: name.end_line,
        end_column: name.end_column,
        end_offset: name.end_offset,
        first_edge: 0,
        edge_count: 0
    }
    return ValidateParseOutput(ParseOutput { arena: Arena { nodes: [node], edges: [] }, root: 1 })
}

// The caller supplies exactly one struct declaration followed by one EOF
// sentinel. Keeping declarations in disjoint windows means a module with many
// structs is still scanned linearly instead of cloning each remaining tail.
fn ReadStruct(tokens: [Token]): StructRead! {
    // Bound the independently importable entry point before any token clone or
    // index. ParseProgram enforces the same limit on the complete module.
    if (tokens.len() > 512) {
        RejectAtPoint("invalid_token_stream", "struct window accepts at most 512 tokens")?
    }
    if (tokens.len() == 0) {
        RejectAtPoint("invalid_token_stream", "struct window must start with struct and end with EOF")?
    }
    last = tokens[tokens.len() - 1].clone()
    if (last.kind != "Eof" || tokens[0].kind != "Struct") {
        RejectAt(tokens[0].clone(), "invalid_token_stream", "struct window must start with struct and end with EOF")?
    }
    validation_index = 0
    while (validation_index < tokens.len() - 1) {
        if (tokens[validation_index].kind == "Eof") {
            RejectAt(tokens[validation_index].clone(), "invalid_token_stream", "EOF must be final in struct window")?
        }
        validation_index = validation_index + 1
    }

    arena_nodes: [Node] = []
    arena_edges: [int] = []

    start = tokens[0].clone()
    cursor = 1
    name = tokens[cursor].clone()
    if (name.kind == "Eof") {
        RejectAt(start.clone(), "unexpected_token", "expected struct name")?
    }
    if (name.kind != "Ident") {
        RejectAt(name.clone(), "unexpected_token", "expected struct name")?
    }
    cursor = cursor + 1
    if (tokens[cursor].kind != "LBrace") {
        RejectAt(tokens[cursor].clone(), "unexpected_token", "expected '{' after struct name")?
    }
    cursor = cursor + 1
    fields: [int] = []
    work = validation_index
    while (tokens[cursor].kind != "RBrace" && tokens[cursor].kind != "Eof") {
        work = work + 1
        if (work > 16384) {
            RejectAt(tokens[cursor].clone(), "work_limit", "stage-3 parser work budget exceeded")?
        }
        field_name = tokens[cursor].clone()
        if (field_name.kind != "Ident") {
            RejectAt(field_name.clone(), "unexpected_token", "expected struct field name")?
        }
        cursor = cursor + 1
        if (tokens[cursor].kind != "Colon") {
            RejectAt(tokens[cursor].clone(), "unexpected_token", "expected ':' after struct field name")?
        }
        cursor = cursor + 1
        // Commas are optional. Once a complete top-level type atom has been
        // read, Ident Colon belongs to the next field. Only the Colon is copied
        // as this type window's final boundary; dotted, union and array states
        // suppress that shortcut. Keeping this loop here avoids capturing and
        // repeatedly cloning the complete struct token window per field.
        type_tokens: [Token] = []
        probe = cursor
        bracket_depth = 0
        expect_atom = true
        expect_component = false
        scan_work = 0
        complete = false
        while (!complete) {
            if (probe >= tokens.len()) {
                RejectAt(last.clone(), "invalid_token_stream", "struct type inspection escaped its bounded token window")?
            }
            token = tokens[probe].clone()
            next_field = bracket_depth == 0 && !expect_atom && !expect_component && token.kind == "Ident" && probe + 1 < tokens.len() && tokens[probe + 1].kind == "Colon"
            window_token: Token = token.clone()
            if (next_field) {
                window_token = tokens[probe + 1].clone()
                scan_work = scan_work + 2
            } else {
                scan_work = scan_work + 1
            }
            continues = TypeWindowContinues(window_token.kind.clone())
            type_tokens = PushTypeToken(type_tokens, window_token)?
            if (!continues) {
                complete = true
            } else if (!next_field) {
                if (token.kind == "LBracket") {
                    bracket_depth = bracket_depth + 1
                    expect_atom = true
                    expect_component = false
                } else if (token.kind == "RBracket") {
                    if (bracket_depth > 0) { bracket_depth = bracket_depth - 1 }
                    expect_atom = false
                    expect_component = false
                } else if (token.kind == "Pipe") {
                    expect_atom = true
                    expect_component = false
                } else if (token.kind == "Dot") {
                    expect_component = true
                } else if (token.kind == "Ident" || token.kind == "Null" || token.kind == "Fn" || token.kind == "Async") {
                    expect_atom = false
                    expect_component = false
                }
                probe = probe + 1
            }
        }
        parsed_type = ParseTypeWindow(type_tokens)?
        parsed_type.work = parsed_type.work + scan_work
        if (parsed_type.consumed <= 0 || parsed_type.consumed > tokens.len() - 1 - cursor) {
            RejectAt(tokens[cursor].clone(), "invalid_token_stream", "struct type parser did not advance within its bounded window")?
        }
        cursor = cursor + parsed_type.consumed
        work = work + parsed_type.work
        if (work > 16384) {
            RejectAt(field_name.clone(), "work_limit", "stage-3 parser work budget exceeded")?
        }
        parsed_root = parsed_type.root
        parsed_parts = parsed_type.parts
        parsed_edges = parsed_type.edges
        node_base = arena_nodes.len()
        part_index = 0
        while (part_index < parsed_parts.len()) {
            part = parsed_parts[part_index].clone()
            CheckTypeArenaCapacity(arena_nodes.len(), arena_edges.len(), part.edge_count, field_name.clone())?
            first_edge = arena_edges.len()
            edge_index = 0
            while (edge_index < part.edge_count) {
                plan_edge = part.first_edge + edge_index
                if (plan_edge < 0 || plan_edge >= parsed_edges.len()) {
                    RejectAt(field_name.clone(), "invalid_node_id", "type plan edge lies outside its arena")?
                }
                child = parsed_edges[plan_edge]
                if (child <= 0 || child > part_index) {
                    RejectAt(field_name.clone(), "invalid_node_id", "type plan edge must reference an earlier NodeId")?
                }
                arena_edges = arena_edges.push(node_base + child)
                edge_index = edge_index + 1
            }
            type_node = TypePartToNode(part, first_edge)
            arena_nodes = arena_nodes.push(type_node)
            part_index = part_index + 1
        }
        if (parsed_root <= 0 || parsed_root > parsed_parts.len()) {
            RejectAt(field_name.clone(), "invalid_node_id", "type plan root is invalid")?
        }
        field_type = node_base + parsed_root
        CheckTypeArenaCapacity(arena_nodes.len(), arena_edges.len(), 1, field_name.clone())?
        field_first_edge = arena_edges.len()
        arena_edges = arena_edges.push(field_type)
        field_span = SpanFromToken(field_name.clone())
        field_node = Node {
            kind: "StructField",
            text: field_name.lexeme.clone(),
            int_value: 0,
            line: field_span.line,
            column: field_span.column,
            offset: field_span.offset,
            end_line: field_span.end_line,
            end_column: field_span.end_column,
            end_offset: field_span.end_offset,
            first_edge: field_first_edge,
            edge_count: 1
        }
        arena_nodes = arena_nodes.push(field_node)
        field = arena_nodes.len()
        fields = fields.push(field)
        if (tokens[cursor].kind == "Comma") { cursor = cursor + 1 }
    }
    end = tokens[cursor].clone()
    if (end.kind != "RBrace") {
        RejectAt(end.clone(), "unexpected_token", "expected '}' after struct fields")?
    }
    cursor = cursor + 1
    if (cursor != tokens.len() - 1) {
        RejectAt(tokens[cursor].clone(), "invalid_token_stream", "struct window must contain exactly one declaration before EOF")?
    }
    CheckTypeArenaCapacity(arena_nodes.len(), arena_edges.len(), fields.len(), start.clone())?
    first_edge = arena_edges.len()
    for field in fields {
        if (field <= 0 || field > arena_nodes.len()) {
            RejectAt(start.clone(), "invalid_node_id", "AST edge references an invalid NodeId")?
        }
        arena_edges = arena_edges.push(field)
    }
    struct_span = SpanMerge(SpanFromToken(start.clone()), SpanFromToken(end))
    struct_node = Node {
        kind: "Struct",
        text: name.lexeme.clone(),
        int_value: 0,
        line: struct_span.line,
        column: struct_span.column,
        offset: struct_span.offset,
        end_line: struct_span.end_line,
        end_column: struct_span.end_column,
        end_offset: struct_span.end_offset,
        first_edge: first_edge,
        edge_count: arena_edges.len() - first_edge
    }
    arena_nodes = arena_nodes.push(struct_node)
    root = arena_nodes.len()
    output = ValidateParseOutput(ParseOutput {
        arena: Arena { nodes: arena_nodes, edges: arena_edges },
        root: root
    })?
    return ok(StructRead { start: start, output: output, consumed: cursor, work: work })
}
