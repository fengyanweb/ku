import { Token } from "../stage1/token.ku"
import { Arena, Node, ParseOutput, ValidateParseOutput } from "../stage2/ast.ku"
import { Span, SpanFromToken, SpanMerge } from "../stage2/span.ku"
import { AfterOptionalSemicolon, RejectAt, WindowKind, WindowToken } from "./support.ku"
import { ControlFrame, RejectFinally, StatementLink, RejectBodyWorkLimit, RejectStatementLink, RejectStatementNode, RejectStatementLength,
         RejectBodyNodeLimit, RejectBodyEdgeLimit, RejectNestedRoot, ExpectTryToken, NextBodyWork,
         IsControlStatement, ReadExpressionEnd, RejectStatementLimit, RejectWhileBody } from "./body_support.ku"
import { ReadSimpleBodyStatement } from "./simple_statements.ku"

struct AppendedStatements {
    children: [int]
    work: int
}

struct BodyAttachment {
    arena: Arena
    node_count: int
    root: int
}

struct ControlBodyStart {
    binding: str
    condition: int
    next: int
    work: int
    inline_statement: int
}

fn RejectControlOpen(is_while: bool, error_token: Token): null! {
    if (!is_while) { RejectAt(error_token.clone(), "unexpected_token", "expected '(' after 'if'")? }
    RejectAt(error_token, "unexpected_token", "expected '(' after 'while'")?
    return ok(null)
}

fn RejectControlClose(is_while: bool, error_token: Token): null! {
    if (!is_while) { RejectAt(error_token.clone(), "unexpected_token", "expected ')' after if condition")? }
    RejectAt(error_token, "unexpected_token", "expected ')' after while condition")?
    return ok(null)
}

struct ControlHeader {
    binding: str
    expression_start: int
    expression_end: int
    body_open: int
    work: int
}

fn ReadControlHeader(&tokens: [Token], start: int, window_end: int, initial_work: int): ControlHeader! {
    kind = WindowKind(tokens, start, window_end)
    cursor = start + 1
    if (kind == "For") {
        name = WindowToken(tokens, cursor, window_end)
        if (name.kind != "Ident") { RejectAt(name.clone(), "unexpected_token", "expected loop variable after 'for'")? }
        cursor = cursor + 1
        if (WindowKind(tokens, cursor, window_end) != "In") { RejectAt(WindowToken(tokens, cursor, window_end), "unexpected_token", "expected 'in' after loop variable")? }
        expression_start = cursor + 1
        expression_end = ReadExpressionEnd(tokens, expression_start, window_end, "for_header")?
        work = NextBodyWork(initial_work, expression_end - start, name.clone())?
        if (WindowKind(tokens, expression_end, window_end) != "LBrace") {
            RejectAt(WindowToken(tokens, expression_end, window_end), "unsupported_statement", "stage-3 for bodies must use braces")?
        }
        return ok(ControlHeader { binding: name.lexeme, expression_start: expression_start, expression_end: expression_end, body_open: expression_end, work: work })
    }

    is_while = kind == "While"
    if (WindowKind(tokens, cursor, window_end) != "LParen") {
        RejectControlOpen(is_while, WindowToken(tokens, cursor, window_end))?
    }
    cursor = cursor + 1
    condition_start = cursor
    condition_depth = 0
    reading_condition = true
    work = initial_work
    while (reading_condition) {
        work = NextBodyWork(work, 1, WindowToken(tokens, cursor, window_end))?
        condition_token = WindowToken(tokens, cursor, window_end)
        missing_close = condition_token.kind == "Eof" || condition_token.kind == "RBrace" || condition_token.kind == "LBrace" || condition_token.kind == "Semicolon"
        if (missing_close) {
            RejectControlClose(is_while, condition_token.clone())?
        }
        if (condition_token.kind == "RParen") {
            if (condition_depth == 0) { reading_condition = false }
            else {
                condition_depth = condition_depth - 1
                cursor = cursor + 1
            }
        } else {
            if (condition_token.kind == "LParen") { condition_depth = condition_depth + 1 }
            cursor = cursor + 1
        }
    }
    return ok(ControlHeader { binding: "", expression_start: condition_start, expression_end: cursor, body_open: cursor + 1, work: work })
}

fn ReadControlBodyStart(&tokens: [Token], &kind: str, start: int, last: int, token_base: int, work: int,
                        statement_count: int, awaiting_else_if: bool,
                        parse_expression: fn(int, int): ParseOutput!,
                        add_arena: fn(ParseOutput, Token, bool): int!,
                        add_node: fn(str, str, int, Span, [int], Token): int!,
                        read_node: fn(int): Node, read_span: fn(int): Span): ControlBodyStart! {
    if (kind == "Try") {
        body_open = start + 1
        ExpectTryToken(WindowToken(tokens, body_open, last), "LBrace", "expected '{' before try body")?
        next_work = NextBodyWork(work, 1, WindowToken(tokens, start, last))?
        return ok(ControlBodyStart { binding: "", condition: 0, next: body_open + 1, work: next_work, inline_statement: 0 })
    }
    header = ReadControlHeader(tokens, start, last, work)?
    origin = WindowToken(tokens, header.expression_start, last)
    parsed = parse_expression(token_base + header.expression_start, token_base + header.expression_end)?
    condition = add_arena(parsed, origin, false)?
    if (WindowKind(tokens, header.body_open, last) == "LBrace") {
        return ok(ControlBodyStart { binding: header.binding, condition: condition,
                                     next: header.body_open + 1, work: header.work, inline_statement: 0 })
    }
    body = WindowToken(tokens, header.body_open, last)
    if (kind == "While") { RejectWhileBody(body.clone())? }
    return ReadSimpleIf(tokens, start, header.body_open, last, token_base, header.work, condition,
                        statement_count, awaiting_else_if, body, parse_expression, add_arena, add_node, read_node, read_span)
}

fn ReadSimpleIf(&tokens: [Token], start: int, body_start: int, last: int, token_base: int, work: int,
                condition: int, statement_count: int, awaiting_else_if: bool, body: Token,
                parse_expression: fn(int, int): ParseOutput!, add_arena: fn(ParseOutput, Token, bool): int!,
                add_node: fn(str, str, int, Span, [int], Token): int!,
                read_node: fn(int): Node, read_span: fn(int): Span): ControlBodyStart! {
    if (body.kind == "Eof" || body.kind == "Else") {
        RejectAt(body.clone(), "unexpected_token", "expected '{' or statement after 'if'")?
    }
    if (awaiting_else_if || IsControlStatement(body.kind)) {
        RejectAt(body.clone(), "unsupported_statement", "stage-3 nested if bodies must use braces")?
    }
    if (statement_count >= 128) { RejectStatementLimit(body.clone())? }
    body_work = NextBodyWork(work, 1, body.clone())?
    parsed = ReadSimpleBodyStatement(tokens, body_start, last, token_base, body_work, body, true,
                                     parse_expression, add_arena, add_node.clone(), read_node, read_span.clone())?
    following = WindowToken(tokens, parsed.cursor, last)
    if (parsed.initializer_type != 0) {
        RejectAt(following.clone(), "unsupported_statement", "stage-3 inline if cannot contain a function body")?
    }
    // Leave dangling-else cases unsupported until both arms can close
    // through the same control stack without changing which If owns Else.
    if (following.kind == "Else") {
        RejectAt(following, "unsupported_statement", "stage-3 if with else requires a braced then body")?
    }
    opener = WindowToken(tokens, start, last)
    span = SpanMerge(SpanFromToken(opener.clone()), read_span(parsed.node))
    node = add_node("If", "", 1, span, [condition, parsed.node], opener)?
    next = AfterOptionalSemicolon(tokens, parsed.cursor, last)
    return ok(ControlBodyStart { binding: "", condition: 0, next: next, work: parsed.work, inline_statement: node })
}

// For a local signature only the synthetic root is skipped; the forest of
// parameter/type children still passes the ordinary arena validation.
fn PrepareBodyAttachment(parsed: ParseOutput, header: bool, available_nodes: int,
                         available_edges: int, origin: Token): BodyAttachment! {
    validated = ValidateParseOutput(parsed)?
    root = validated.root
    arena = validated.arena
    count = arena.nodes.len()
    edge_count = arena.edges.len()
    if (header) {
        if (arena.nodes[root - 1].kind != "FunctionHeaderTransport") { RejectNestedRoot(origin.clone())? }
        edge_count = arena.nodes[root - 1].first_edge
        count = count - 1
        root = 0
    }
    if (count > available_nodes) { RejectBodyNodeLimit(origin.clone())? }
    if (edge_count > available_edges) { RejectBodyEdgeLimit(origin)? }
    return ok(BodyAttachment { arena: arena, node_count: count, root: root })
}

// Statement links are newest-first. Validate their bounded chain before
// appending the referenced arena nodes in source order.
fn AppendStatementLinks(children: [int], &links: [StatementLink], top: int, count: int,
                        node_count: int, initial_work: int, error_token: Token): AppendedStatements! {
    output = children
    reversed: [int] = []
    walk = top
    remaining = count
    work = initial_work
    while (remaining > 0) {
        work = work + 1
        if (work > 16384) { RejectBodyWorkLimit(error_token.clone())? }
        if (walk <= 0 || walk > links.len()) { RejectStatementLink(error_token.clone())? }
        entry = links[walk - 1].clone()
        if (entry.node <= 0 || entry.node > node_count) { RejectStatementNode(error_token.clone())? }
        reversed = reversed.push(entry.node)
        walk = entry.previous
        remaining = remaining - 1
    }
    if (walk != 0) { RejectStatementLength(error_token.clone())? }
    reverse_index = reversed.len()
    reversing = reverse_index > 0
    while (reversing) {
        reverse_index = reverse_index - 1
        output = output.push(reversed[reverse_index])
        reversing = reverse_index > 0
    }
    return ok(AppendedStatements { children: output, work: work })
}

// Preserve catch-body/list charging before either of its two nodes is added.
// A finally clause remains unsupported at this boundary.
fn BuildCatchClause(&tokens: [Token], next: int, last: int, &frame: ControlFrame, &end: Token,
                    append: fn([int], int, int, Token): [int]!,
                    add_node: fn(str, str, int, Span, [int], Token): int!): int! {
    RejectFinally(WindowToken(tokens, next, last))?
    catch_start = WindowToken(tokens, frame.catch_start, last)
    catch_open = WindowToken(tokens, frame.catch_start + 4, last)
    children = append([], frame.else_top, frame.else_count, catch_open.clone())?
    end_span = SpanFromToken(end.clone())
    body_span = SpanMerge(SpanFromToken(catch_open.clone()), end_span.clone())
    catch_body = add_node("CatchBody", "", 0, body_span, children, catch_open)?
    clause_span = SpanMerge(SpanFromToken(catch_start.clone()), end_span)
    return add_node("Catch", "", 0, clause_span, [frame.catch_binding, catch_body], catch_start)
}


// Match the ordinary function diagnostic for every incomplete function body.
fn FunctionEofKind(&kind: str): str {
    if (kind == "AsyncFunction" || kind == "FunctionExpr") { return "Function" }
    return kind.clone()
}

fn LocalFunctionNodeKind(&start_kind: str): str {
    if (start_kind == "Ident") { return "FunctionExpr" }
    if (start_kind == "Async") { return "AsyncFunction" }
    return "Function"
}

fn BuildControlStatement(&tokens: [Token], next: int, last: int, &frame: ControlFrame, value: int,
                         function_start: int, declared_type: int, children: [int], start: Token, &closing: Token,
                         add_node: fn(str, str, int, Span, [int], Token): int!): int! {
    end_span = SpanFromToken(closing.clone())
    statement_span = SpanMerge(SpanFromToken(start.clone()), end_span.clone())
    if (frame.kind != "FunctionExpr") {
        return add_node(frame.kind.clone(), frame.binding.clone(), value, statement_span, children, start)
    }

    // Only complete function initializers use this path. A group,
    // index or unary minus can otherwise look like a second statement.
    following = WindowToken(tokens, next, last)
    if (following.kind == "LParen" || following.kind == "LBracket" || following.kind == "Minus"
        || following.kind == "Dot" || following.kind == "Question") {
        RejectAt(following, "unsupported_expression", "stage-3 anonymous function assignments require a complete right-hand side")?
    }
    opener = WindowToken(tokens, function_start, last)
    span = SpanMerge(SpanFromToken(opener.clone()), end_span)
    expression = add_node("FunctionExpr", "", 0, span, children, opener)?
    if (declared_type != 0) {
        return add_node("VarDecl", frame.binding.clone(), 0, statement_span, [declared_type, expression], start)
    }
    return add_node("Assign", frame.binding.clone(), 0, statement_span, [expression], start)
}
