import { Token } from "../stage1/token.ku"
import { Span, SpanFromToken, SpanMerge } from "../stage2/span.ku"
import { Node, ParseOutput } from "../stage2/ast.ku"
import { ExpressionSpan } from "../stage2/expression_support.ku"
import { NextBodyWork, ReadExpressionEnd, AssignmentOperator, RejectLetStatement,
         SignatureTypeOutput } from "./body_support.ku"
import { ReadTypedInitializer } from "./function_header.ku"
import { ReadSignatureTypePrefix } from "./signature.ku"
import { AfterOptionalSemicolon, ObjectDestructureClose, RejectAt, RejectAtSpan, SpanFromNode, WindowKind, WindowToken } from "./support.ku"

struct SimpleStatementRead {
    node: int
    cursor: int
    work: int
    initializer_type: int
}

// Read and append one non-control statement with the owner’s arena
// operations. Callable handles are retained only for this call.
fn ReadSimpleBodyStatement(&tokens: [Token], first: int, last_index: int, token_base: int,
                           initial_work: int, statement_start: Token, inline_if: bool,
                           parse_expression: fn(int, int): ParseOutput!,
                           add_arena: fn(ParseOutput, Token, bool): int!,
                           add_node: fn(str, str, int, Span, [int], Token): int!,
                           read_node: fn(int): Node, read_span: fn(int): Span): SimpleStatementRead! {
    cursor = first
    parse_steps = initial_work
    statement = 0
    value_context = "value"
    target_context = "assignment_target"
    if (inline_if) { value_context = "inline_if_value" target_context = "inline_if_target" }
    if (statement_start.kind == "LBrace") {
        closing = ObjectDestructureClose(tokens, first, last_index)
        if (closing != 0) {
            work = NextBodyWork(initial_work, closing - first + 1, statement_start.clone())?
            return readObjectDestructure(tokens, first, last_index, token_base, work, statement_start,
                                         parse_expression, add_arena, add_node, read_span)
        }
    }
    assignment_operator = ""
    if (statement_start.kind == "Ident") { assignment_operator = AssignmentOperator(WindowKind(tokens, cursor + 1, last_index)) }
    if (statement_start.kind == "Let") {
        RejectLetStatement(statement_start)?
    } else if (statement_start.kind == "Break" || statement_start.kind == "Continue") {
        // Like Stage0, record only the keyword span. The checker validates
        // whether the current function has an enclosing loop.
        kind = statement_start.kind.clone()
        statement = add_node(kind, "", 0, SpanFromToken(statement_start.clone()), [], statement_start)?
        cursor = cursor + 1
    } else if (statement_start.kind == "Print") {
        cursor = cursor + 1
        wrapped = WindowKind(tokens, cursor, last_index) == "LParen"
        context = value_context
        if (wrapped) { cursor = cursor + 1 context = "print_argument" }
        origin = WindowToken(tokens, cursor, last_index)
        if (wrapped && origin.kind == "Ampersand") {
            RejectAt(origin.clone(), "unexpected_token", "'&' is not written at the call site")?
        }
        expression_end = ReadExpressionEnd(tokens, cursor, last_index, context)?
        if (expression_end == cursor) {
            RejectAt(origin.clone(), "unexpected_token", "expected expression")?
        }
        parsed = parse_expression(token_base + cursor, token_base + expression_end)?
        cursor = expression_end
        if (wrapped) {
            closing = WindowToken(tokens, cursor, last_index)
            if (closing.kind != "RParen") {
                RejectAt(closing, "unexpected_token", "expected ')' after print argument")?
            }
            parse_steps = NextBodyWork(parse_steps, 2, statement_start.clone())?
            cursor = cursor + 1
        }
        expression = add_arena(parsed, origin, false)?
        span = SpanMerge(SpanFromToken(statement_start.clone()), read_span(expression))
        statement = add_node("Print", "", 0, span, [expression], statement_start)?
    } else if (statement_start.kind == "Return" || statement_start.kind == "Fail") {
        kind = statement_start.kind.clone()
        requires_value = kind == "Fail"
        cursor = cursor + 1
        children: [int] = []
        end_span = SpanFromToken(statement_start.clone())
        if (!requires_value && WindowKind(tokens, cursor, last_index) == "Semicolon") {
            end_span = SpanFromToken(WindowToken(tokens, cursor, last_index))
        } else if (requires_value || WindowKind(tokens, cursor, last_index) != "RBrace") {
            expression_end = ReadExpressionEnd(tokens, cursor, last_index, value_context)?
            value_origin = WindowToken(tokens, cursor, last_index)
            value_parsed = parse_expression(token_base + cursor, token_base + expression_end)?
            expression = add_arena(value_parsed, value_origin, false)?
            children = children.push(expression)
            expression_node = read_node(expression)
            end_span = SpanFromNode(expression_node)
            cursor = expression_end
        }
        statement = add_node(kind, "", 0, SpanMerge(SpanFromToken(statement_start.clone()), end_span), children, statement_start.clone())?
    } else if (statement_start.kind == "Ident" && WindowKind(tokens, cursor + 1, last_index) == "Colon") {
        name = statement_start.lexeme.clone()
        cursor = cursor + 2
        parsed_type = ReadSignatureTypePrefix(tokens, cursor, last_index)?
        parse_steps = NextBodyWork(parse_steps, parsed_type.work, WindowToken(tokens, cursor, last_index))?
        type_consumed = parsed_type.consumed
        type_output = SignatureTypeOutput(parsed_type, WindowToken(tokens, cursor, last_index))?
        type_node = add_arena(type_output, WindowToken(tokens, cursor, last_index), false)?
        cursor = cursor + type_consumed
        if (WindowKind(tokens, cursor, last_index) != "Equal") {
            declared = read_node(type_node)
            statement = defaultDeclaration(declared, type_node, statement_start, add_node)?
            return ok(SimpleStatementRead { node: statement, cursor: AfterOptionalSemicolon(tokens, cursor, last_index),
                                            work: parse_steps, initializer_type: 0 })
        }
        cursor = cursor + 1
        if (WindowKind(tokens, cursor, last_index) == "Fn") {
            // The body reader owns nested function frames. The declared
            // type is already attached, and the cursor stays on the Fn.
            return ok(SimpleStatementRead { node: 0, cursor: cursor, work: parse_steps, initializer_type: type_node })
        }
        initialized = ReadTypedInitializer(tokens, cursor, last_index, token_base, parse_steps, value_context,
                                           parse_expression, add_arena, add_node.clone(), read_span.clone())?
        span = SpanMerge(SpanFromToken(statement_start.clone()), read_span(initialized.expression))
        statement = add_node("VarDecl", name, 0, span, [type_node, initialized.expression], statement_start.clone())?
        cursor = initialized.cursor
        parse_steps = initialized.work
    } else if (assignment_operator != "") {
        name = statement_start.lexeme.clone()
        target = 0
        if (assignment_operator != "=") {
            target = add_node("Variable", name.clone(), 0, SpanFromToken(statement_start.clone()), [], statement_start.clone())?
        }
        cursor = cursor + 2
        expression_end = ReadExpressionEnd(tokens, cursor, last_index, value_context)?
        assignment_origin = WindowToken(tokens, cursor, last_index)
        assignment_parsed = parse_expression(token_base + cursor, token_base + expression_end)?
        expression = add_arena(assignment_parsed, assignment_origin, false)?
        expression_node = read_node(expression)
        statement_span = SpanMerge(SpanFromToken(statement_start.clone()), SpanFromNode(expression_node))
        if (assignment_operator == "=") {
            statement = add_node("Assign", name, 0, statement_span, [expression], statement_start.clone())?
        } else {
            statement = add_node("CompoundAssign", assignment_operator, 0, statement_span, [target, expression], statement_start.clone())?
        }
        cursor = expression_end
    } else {
        expression_end = ReadExpressionEnd(tokens, cursor, last_index, target_context)?
        statement_origin = WindowToken(tokens, cursor, last_index)
        statement_parsed = parse_expression(token_base + cursor, token_base + expression_end)?
        expression = add_arena(statement_parsed, statement_origin, false)?
        expression_node = read_node(expression)
        span = ExpressionSpan(expression_node)
        cursor = expression_end
        kind = "ExprStmt"
        children: [int] = [expression]
        assignment_operator = AssignmentOperator(WindowKind(tokens, cursor, last_index))
        if (assignment_operator != "") {
            if (expression_node.kind != "Field" && expression_node.kind != "Index") {
                RejectAtSpan(span.clone(), "invalid_assignment_target", "invalid assignment target")?
            }
            cursor = cursor + 1
            expression_end = ReadExpressionEnd(tokens, cursor, last_index, value_context)?
            value = parse_expression(token_base + cursor, token_base + expression_end)?
            rhs = add_arena(value, WindowToken(tokens, cursor, last_index), false)?
            span = SpanMerge(span, read_span(rhs))
            children = children.push(rhs)
            kind = "CompoundAssign"
            if (assignment_operator == "=") { kind = "AssignTarget" assignment_operator = "" }
            cursor = expression_end
        }
        statement = add_node(kind, assignment_operator, 0, span, children, statement_start.clone())?
    }
    if (WindowKind(tokens, cursor, last_index) == "Semicolon") { cursor = cursor + 1 }
    return ok(SimpleStatementRead { node: statement, cursor: cursor, work: parse_steps, initializer_type: 0 })
}

fn defaultDeclaration(&declared: Node, type_node: int, origin: Token,
                      add_node: fn(str, str, int, Span, [int], Token): int!): int! {
    // Stage0 uses a point at the binding's start for both synthesized nodes.
    // The real declaration type keeps the span of its source tokens.
    point = Span { line: origin.line, column: origin.column, offset: origin.offset,
                  end_line: origin.line, end_column: origin.column, end_offset: origin.offset }
    kind = "Null"
    text = ""
    if (declared.kind == "TypeName") {
        if (declared.text == "int") { kind = "Int" }
        else if (declared.text == "float") { kind = "Float" text = "0.0" }
        else if (declared.text == "bool") { kind = "Bool" text = "false" }
        else if (declared.text == "str") { kind = "String" }
    } else if (declared.kind == "TypeArray") {
        kind = "Array"
    } else if (declared.kind != "TypeUnion" && declared.kind != "TypeResult" && declared.kind != "TypeFunction") {
        RejectAtSpan(ExpressionSpan(declared), "unsupported_statement", "no stage-3 default initializer for this type")?
    }
    value = add_node(kind, text, 0, point.clone(), [], origin.clone())?
    return add_node("VarDecl", origin.lexeme.clone(), 0, point, [type_node, value], origin)
}

fn expectPatternToken(&token: Token, kind: str, message: str): null! {
    if (token.kind != kind) { RejectAt(token.clone(), "unexpected_token", message)? }
    return ok(null)
}

fn patternBinding(
    kind: str, name: str, span: Span, origin: Token,
    add_node: fn(str, str, int, Span, [int], Token): int!
): int! {
    if (name == "_") { return add_node(kind, "", 0, span, [], origin) }
    return add_node(kind, name, 1, span, [], origin)
}

fn checkPatternField(&seen: [str], &field: Token, initial_work: int): int! {
    index = 0
    work = initial_work
    while (index < seen.len()) {
        work = NextBodyWork(work, 1, field.clone())?
        if (seen[index] == field.lexeme) {
            RejectAt(field.clone(), "unexpected_token", "duplicate object destructuring field '" + field.lexeme.clone() + "'")?
        }
        index = index + 1
    }
    return ok(work)
}

fn readObjectDestructureField(
    &tokens: [Token], cursor: int, last_index: int, token_base: int, initial_work: int, field: Token,
    parse_expression: fn(int, int): ParseOutput!, add_arena: fn(ParseOutput, Token, bool): int!,
    add_node: fn(str, str, int, Span, [int], Token): int!
): SimpleStatementRead! {
    next = cursor
    work = initial_work
    local = field.lexeme.clone()
    span = SpanFromToken(field.clone())
    if (WindowKind(tokens, next, last_index) == "Colon") {
        alias = WindowToken(tokens, next + 1, last_index)
        expectPatternToken(alias, "Ident", "expected local binding name after ':'")?
        local = alias.lexeme
        work = NextBodyWork(work, 2, field.clone())?
        next = next + 2
    }
    binding = patternBinding("ObjectDestructureLocal", local, span.clone(), field.clone(), add_node.clone())?
    children: [int] = [binding]
    if (WindowKind(tokens, next, last_index) == "Equal") {
        start = next + 1
        origin = WindowToken(tokens, start, last_index)
        end = ReadExpressionEnd(tokens, start, last_index, "destructure_default")?
        work = NextBodyWork(work, end - next, origin.clone())?
        parsed = parse_expression(token_base + start, token_base + end)?
        value = add_arena(parsed, origin, false)?
        children = children.push(value)
        next = end
    }
    node = add_node("ObjectDestructureBinding", field.lexeme.clone(), 0, span, children, field)?
    return ok(SimpleStatementRead { node: node, cursor: next, work: work, initializer_type: 0 })
}

fn readObjectDestructure(
    &tokens: [Token], first: int, last_index: int, token_base: int, initial_work: int, opener: Token,
    parse_expression: fn(int, int): ParseOutput!, add_arena: fn(ParseOutput, Token, bool): int!,
    add_node: fn(str, str, int, Span, [int], Token): int!, read_span: fn(int): Span
): SimpleStatementRead! {
    cursor = first + 1
    work = initial_work
    fields: [str] = []
    children: [int] = []
    while (WindowKind(tokens, cursor, last_index) != "RBrace") {
        field = WindowToken(tokens, cursor, last_index)
        work = NextBodyWork(work, 1, field.clone())?
        cursor = cursor + 1
        if (field.kind == "Ellipsis") {
            local = WindowToken(tokens, cursor, last_index)
            expectPatternToken(local, "Ident", "expected rest binding name after '...'")?
            rest = patternBinding("ObjectDestructureRest", local.lexeme.clone(), SpanFromToken(local.clone()), local, add_node.clone())?
            children = children.push(rest)
            cursor = cursor + 1
            if (WindowKind(tokens, cursor, last_index) == "Comma") {
                cursor = cursor + 1
                if (WindowKind(tokens, cursor, last_index) != "RBrace") {
                    RejectAt(WindowToken(tokens, cursor, last_index), "unexpected_token", "object destructuring rest binding must be last")?
                }
            }
            break
        }
        if (field.kind != "Ident" && field.kind != "String") {
            RejectAt(field.clone(), "unexpected_token", "expected object destructuring field name")?
        }
        work = checkPatternField(fields, field, work)?
        fields = fields.push(field.lexeme.clone())
        binding = readObjectDestructureField(tokens, cursor, last_index, token_base, work, field,
            parse_expression.clone(), add_arena.clone(), add_node.clone())?
        work = binding.work
        cursor = binding.cursor
        children = children.push(binding.node)
        if (WindowKind(tokens, cursor, last_index) != "Comma") { break }
        cursor = cursor + 1
    }
    expectPatternToken(WindowToken(tokens, cursor, last_index), "RBrace", "expected '}' after object destructuring pattern")?
    expectPatternToken(WindowToken(tokens, cursor + 1, last_index), "Equal", "expected '=' after object destructuring pattern")?
    start = cursor + 2
    end = ReadExpressionEnd(tokens, start, last_index, "value")?
    origin = WindowToken(tokens, start, last_index)
    work = NextBodyWork(work, end - start, origin.clone())?
    rhs = add_arena(parse_expression(token_base + start, token_base + end)?, origin, false)?
    children = children.push(rhs)
    span = SpanMerge(SpanFromToken(opener.clone()), read_span(rhs))
    node = add_node("ObjectDestructureAssign", "", fields.len(), span, children, opener)?
    return ok(SimpleStatementRead { node: node, cursor: AfterOptionalSemicolon(tokens, end, last_index), work: work, initializer_type: 0 })
}
