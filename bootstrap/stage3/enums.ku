import { Token } from "../stage1/token.ku"
import { Span, SpanFromToken, SpanMerge } from "../stage2/span.ku"
import { Node, Arena, ParseOutput, ValidateParseOutput } from "../stage2/ast.ku"
import { TypeWindowContinues, PushTypeToken, ParseTypeWindow, CheckTypeArenaCapacity, TypePartToNode } from "./signature.ku"
import { RejectAt, RejectAtPoint } from "./support.ku"
import { DeclarationRead, ReadStruct } from "./structs.ku"

// Read exactly one production enum declaration followed by exactly one EOF.
// Variant and payload-field counts have no independent limit: the shared
// token, work, node, edge, type-depth and union-width bounds are authoritative.
fn ReadEnum(tokens: [Token]): DeclarationRead! {
    // The direct helper is independently safe: reject its complete input before
    // any clone or index, then prove the unique EOF sentinel is final.
    if (tokens.len() > 512) {
        RejectAtPoint("invalid_token_stream", "enum window accepts at most 512 tokens")?
    }
    if (tokens.len() == 0) {
        RejectAtPoint("invalid_token_stream", "enum window must start with enum and end with EOF")?
    }
    last = tokens[tokens.len() - 1].clone()
    if (last.kind != "Eof" || tokens[0].kind != "Enum") {
        RejectAt(tokens[0].clone(), "invalid_token_stream", "enum window must start with enum and end with EOF")?
    }
    validation_index = 0
    while (validation_index < tokens.len() - 1) {
        if (tokens[validation_index].kind == "Eof") {
            RejectAt(tokens[validation_index].clone(), "invalid_token_stream", "EOF must be final in enum window")?
        }
        validation_index = validation_index + 1
    }

    arena_nodes: [Node] = []
    arena_edges: [int] = []
    start = tokens[0].clone()
    cursor = 1
    name = tokens[cursor].clone()
    if (name.kind != "Ident") {
        RejectAt(name.clone(), "unexpected_token", "expected enum name")?
    }
    cursor = cursor + 1
    if (tokens[cursor].kind != "LBrace") {
        RejectAt(tokens[cursor].clone(), "unexpected_token", "expected '{' after enum name")?
    }
    cursor = cursor + 1
    variants: [int] = []
    work = validation_index

    while (tokens[cursor].kind != "RBrace" && tokens[cursor].kind != "Eof") {
        work = work + 1
        if (work > 16384) {
            RejectAt(tokens[cursor].clone(), "work_limit", "stage-3 parser work budget exceeded")?
        }
        variant_name = tokens[cursor].clone()
        if (variant_name.kind != "Ident") {
            RejectAt(variant_name.clone(), "unexpected_token", "expected enum variant name")?
        }
        cursor = cursor + 1
        fields: [int] = []
        variant_span: Span = SpanFromToken(variant_name.clone())

        if (tokens[cursor].kind == "LParen") {
            cursor = cursor + 1
            reading_fields = tokens[cursor].kind != "RParen"
            while (reading_fields) {
                work = work + 1
                if (work > 16384) {
                    RejectAt(tokens[cursor].clone(), "work_limit", "stage-3 parser work budget exceeded")?
                }
                field_name = tokens[cursor].clone()
                if (field_name.kind != "Ident") {
                    RejectAt(field_name.clone(), "unexpected_token", "expected enum variant field name")?
                }
                cursor = cursor + 1
                if (tokens[cursor].kind != "Colon") {
                    RejectAt(tokens[cursor].clone(), "unexpected_token", "expected ':' after variant field name")?
                }
                cursor = cursor + 1

                // Keep the scan in this frame: a nested reader that captures
                // tokens would clone the complete enum window once per field.
                // An adjacent top-level atom is not part of the type grammar;
                // use the cached EOF only as ParseTypeWindow's boundary and let
                // the enclosing ')' check diagnose the still-unconsumed token.
                type_tokens: [Token] = []
                probe = cursor
                bracket_depth = 0
                expect_atom = true
                expect_component = false
                scan_work = 0
                complete = false
                while (!complete) {
                    if (probe >= tokens.len()) {
                        RejectAt(last.clone(), "invalid_token_stream", "enum type inspection escaped its bounded token window")?
                    }
                    token = tokens[probe].clone()
                    adjacent_atom = bracket_depth == 0 && !expect_atom && !expect_component && (token.kind == "Ident" || token.kind == "Null" || token.kind == "Fn" || token.kind == "Async" || token.kind == "LBracket")
                    window_token: Token = token.clone()
                    if (adjacent_atom) { window_token = last.clone() }
                    scan_work = scan_work + 1
                    continues = TypeWindowContinues(window_token.kind.clone())
                    type_tokens = PushTypeToken(type_tokens, window_token)?
                    if (!continues) {
                        complete = true
                    } else if (!adjacent_atom) {
                        if (token.kind == "LBracket") {
                            bracket_depth = bracket_depth + 1
                            expect_atom = true
                            expect_component = false
                        } else if (token.kind == "RBracket") {
                            if (bracket_depth > 0) { bracket_depth = bracket_depth - 1 }
                            expect_atom = false
                            expect_component = false
                        } else if (token.kind == "Pipe") {
                            expect_atom = true
                            expect_component = false
                        } else if (token.kind == "Dot") {
                            expect_component = true
                        } else if (token.kind == "Ident" || token.kind == "Null" || token.kind == "Fn" || token.kind == "Async") {
                            expect_atom = false
                            expect_component = false
                        }
                        probe = probe + 1
                    }
                }
                parsed_type = ParseTypeWindow(type_tokens)?
                parsed_type.work = parsed_type.work + scan_work
                if (parsed_type.consumed <= 0 || parsed_type.consumed > tokens.len() - 1 - cursor) {
                    RejectAt(tokens[cursor].clone(), "invalid_token_stream", "enum type parser did not advance within its bounded window")?
                }
                cursor = cursor + parsed_type.consumed
                work = work + parsed_type.work
                if (work > 16384) {
                    RejectAt(field_name.clone(), "work_limit", "stage-3 parser work budget exceeded")?
                }

                // Flatten the owned type plan once; repeated field projections
                // would otherwise copy the growing plan on the interpreter path.
                parsed_root = parsed_type.root
                parsed_parts = parsed_type.parts
                parsed_edges = parsed_type.edges
                node_base = arena_nodes.len()
                part_index = 0
                while (part_index < parsed_parts.len()) {
                    part = parsed_parts[part_index].clone()
                    CheckTypeArenaCapacity(arena_nodes.len(), arena_edges.len(), part.edge_count, field_name.clone())?
                    first_edge = arena_edges.len()
                    edge_index = 0
                    while (edge_index < part.edge_count) {
                        plan_edge = part.first_edge + edge_index
                        if (plan_edge < 0 || plan_edge >= parsed_edges.len()) {
                            RejectAt(field_name.clone(), "invalid_node_id", "type plan edge lies outside its arena")?
                        }
                        child = parsed_edges[plan_edge]
                        if (child <= 0 || child > part_index) {
                            RejectAt(field_name.clone(), "invalid_node_id", "type plan edge must reference an earlier NodeId")?
                        }
                        arena_edges = arena_edges.push(node_base + child)
                        edge_index = edge_index + 1
                    }
                    type_node = TypePartToNode(part, first_edge)
                    arena_nodes = arena_nodes.push(type_node)
                    part_index = part_index + 1
                }
                if (parsed_root <= 0 || parsed_root > parsed_parts.len()) {
                    RejectAt(field_name.clone(), "invalid_node_id", "type plan root is invalid")?
                }
                field_type = node_base + parsed_root
                CheckTypeArenaCapacity(arena_nodes.len(), arena_edges.len(), 1, field_name.clone())?
                field_first_edge = arena_edges.len()
                arena_edges = arena_edges.push(field_type)
                field_span = SpanFromToken(field_name.clone())
                field_node = Node {
                    kind: "EnumVariantField",
                    text: field_name.lexeme.clone(),
                    int_value: 0,
                    line: field_span.line,
                    column: field_span.column,
                    offset: field_span.offset,
                    end_line: field_span.end_line,
                    end_column: field_span.end_column,
                    end_offset: field_span.end_offset,
                    first_edge: field_first_edge,
                    edge_count: 1
                }
                arena_nodes = arena_nodes.push(field_node)
                field = arena_nodes.len()
                fields = fields.push(field)

                reading_fields = false
                if (tokens[cursor].kind == "Comma") {
                    cursor = cursor + 1
                    reading_fields = true
                }
            }
            variant_end = tokens[cursor].clone()
            if (variant_end.kind != "RParen") {
                RejectAt(variant_end.clone(), "unexpected_token", "expected ')' after enum variant fields")?
            }
            variant_span = SpanMerge(variant_span, SpanFromToken(variant_end))
            cursor = cursor + 1
        }

        CheckTypeArenaCapacity(arena_nodes.len(), arena_edges.len(), fields.len(), variant_name.clone())?
        variant_first_edge = arena_edges.len()
        for field in fields {
            if (field <= 0 || field > arena_nodes.len()) {
                RejectAt(variant_name.clone(), "invalid_node_id", "AST edge references an invalid NodeId")?
            }
            arena_edges = arena_edges.push(field)
        }
        variant_node = Node {
            kind: "EnumVariant",
            text: variant_name.lexeme.clone(),
            int_value: 0,
            line: variant_span.line,
            column: variant_span.column,
            offset: variant_span.offset,
            end_line: variant_span.end_line,
            end_column: variant_span.end_column,
            end_offset: variant_span.end_offset,
            first_edge: variant_first_edge,
            edge_count: arena_edges.len() - variant_first_edge
        }
        arena_nodes = arena_nodes.push(variant_node)
        variant = arena_nodes.len()
        variants = variants.push(variant)
        if (tokens[cursor].kind == "Comma") { cursor = cursor + 1 }
    }

    end = tokens[cursor].clone()
    if (end.kind != "RBrace") {
        RejectAt(end.clone(), "unexpected_token", "expected '}' after enum variants")?
    }
    cursor = cursor + 1
    if (cursor != tokens.len() - 1) {
        RejectAt(tokens[cursor].clone(), "invalid_token_stream", "enum window must contain exactly one declaration before EOF")?
    }
    CheckTypeArenaCapacity(arena_nodes.len(), arena_edges.len(), variants.len(), start.clone())?
    first_edge = arena_edges.len()
    for variant in variants {
        if (variant <= 0 || variant > arena_nodes.len()) {
            RejectAt(start.clone(), "invalid_node_id", "AST edge references an invalid NodeId")?
        }
        arena_edges = arena_edges.push(variant)
    }
    enum_span = SpanMerge(SpanFromToken(start.clone()), SpanFromToken(end))
    enum_node = Node {
        kind: "Enum",
        text: name.lexeme.clone(),
        int_value: 0,
        line: enum_span.line,
        column: enum_span.column,
        offset: enum_span.offset,
        end_line: enum_span.end_line,
        end_column: enum_span.end_column,
        end_offset: enum_span.end_offset,
        first_edge: first_edge,
        edge_count: arena_edges.len() - first_edge
    }
    arena_nodes = arena_nodes.push(enum_node)
    root = arena_nodes.len()
    output = ValidateParseOutput(ParseOutput {
        arena: Arena { nodes: arena_nodes, edges: arena_edges },
        root: root
    })?
    return ok(DeclarationRead { start: start, output: output, consumed: cursor, work: work })
}

// Parser supplies one bounded braced declaration and one final EOF sentinel.
// Dispatching after the window is built keeps the large module token array out
// of this function and avoids duplicating that loop in parser.ku.
fn ReadBracedDeclaration(tokens: [Token]): DeclarationRead! {
    if (tokens.len() > 512) {
        RejectAtPoint("invalid_token_stream", "braced declaration window accepts at most 512 tokens")?
    }
    if (tokens.len() == 0) {
        RejectAtPoint("invalid_token_stream", "braced declaration window must start with struct or enum")?
    }
    start = tokens[0].clone()
    if (start.kind == "Struct") { return ReadStruct(tokens) }
    if (start.kind != "Enum") {
        RejectAt(start, "invalid_token_stream", "braced declaration window must start with struct or enum")?
    }
    return ReadEnum(tokens)
}
