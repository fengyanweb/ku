import { Token } from "../stage1/token.ku"
import { Scan } from "../stage1/lexer.ku"
import { Span, SpanFromToken, SpanMerge } from "../stage2/span.ku"
import { Node, Arena, ParseOutput, ValidateParseOutput } from "../stage2/ast.ku"
import { RejectAt, RejectAtPoint, ParseExpressionAt, CanEndExpression, EmptyExpressionBoundary, PushExpressionBoundary, MapTokenCharacters, SpanFromNode } from "./support.ku"
import { SignatureType, TypeWindowContinues, PushTypeToken, ParseTypeWindow, CheckTypeArenaCapacity, TypePartToNode } from "./signature.ku"
import { ReadImport } from "./imports.ku"
import { ReadModule } from "./structs.ku"
import { ReadBracedDeclaration } from "./enums.ku"

// Stage 3 is intentionally a strict, useful subset of the production Rust
// parser. It accepts top-level module/struct/enum declarations and ordinary functions whose
// bodies contain explicitly typed declarations, variable assignments,
// expression statements and return statements.
// Parameters may be untyped; parameter, return and local-declaration types share
// source-positioned TypeName, TypeArray, TypeResult and TypeUnion arena nodes. Statement
// boundaries follow the production token
// grammar, including Ku's ordinary newline/whitespace-separated style; an
// existing optional semicolon is also accepted. Unsupported production syntax
// is rejected explicitly rather than guessed at or given a second interpretation.
//
// The complete module is scanned once. Token byte offsets are mapped to
// Unicode-scalar slice indexes in one monotonic pass. Stage 2 then re-scans
// each bounded, already lexically-valid expression window with a structured
// origin/boundary context, so it relocates both AST and parser-error spans
// before returning them to this module's fixed NodeId/edge arenas.

fn ParseProgram(source: str): ParseOutput! {
    tokens = Scan(source.clone())?
    if (tokens.len() == 0) {
        RejectAtPoint("invalid_token_stream", "token stream must contain exactly one final EOF")?
    }
    // Stage 3 still stores token-to-character indexes in captured bounded
    // arrays. Keep this first module slice below Stage 2's expression-only
    // ceiling until Ku has an in-place arena builder.
    if (tokens.len() > 512) {
        RejectAt(tokens[0].clone(), "invalid_token_stream", "stage-3 parser accepts at most 512 tokens")?
    }
    token_index = 0
    while (token_index < tokens.len() - 1) {
        if (tokens[token_index].kind == "Eof") {
            RejectAt(tokens[token_index].clone(), "invalid_token_stream", "EOF must be the final token")?
        }
        token_index = token_index + 1
    }
    eof = tokens[tokens.len() - 1].clone()
    if (eof.kind != "Eof") {
        RejectAt(eof.clone(), "invalid_token_stream", "token stream is missing EOF")?
    }

    // The source moves through the mapper and back; only the bounded token
    // array is cloned once so the main parser can keep its cursor.
    mapped = MapTokenCharacters(source, tokens.clone())?
    token_char_starts: [int] = mapped.starts
    token_char_ends: [int] = mapped.ends
    source_chars: [str] = mapped.characters
    expression_source_text: str = mapped.source

    arena_nodes: [Node] = []
    arena_edges: [int] = []
    cursor = 0
    items: [int] = []
    import_count = 0
    function_count = 0
    parse_steps = 0
    slice_work = 0

    fn AddNode(kind: str, text: str, int_value: int, span: Span, children: [int], error_token: Token): int! {
        if (arena_nodes.len() >= 4096) {
            RejectAt(error_token.clone(), "node_limit", "stage-3 parser accepts at most 4096 AST nodes")?
        }
        if (children.len() > 8192 - arena_edges.len()) {
            RejectAt(error_token.clone(), "edge_limit", "stage-3 parser accepts at most 8192 AST edges")?
        }
        first_edge = arena_edges.len()
        for child in children {
            if (child <= 0 || child > arena_nodes.len()) {
                RejectAt(error_token.clone(), "invalid_node_id", "AST edge references an invalid NodeId")?
            }
            arena_edges = arena_edges.push(child)
        }
        node = Node {
            kind: kind,
            text: text,
            int_value: int_value,
            line: span.line,
            column: span.column,
            offset: span.offset,
            end_line: span.end_line,
            end_column: span.end_column,
            end_offset: span.end_offset,
            first_edge: first_edge,
            edge_count: arena_edges.len() - first_edge
        }
        arena_nodes = arena_nodes.push(node)
        return ok(arena_nodes.len())
    }

    fn AddArena(parsed: ParseOutput, origin: Token): int! {
        // Owned field reads clone today. Flatten the Stage 2 result once before
        // walking it so repeated nested projections cannot copy the whole arena.
        parsed_root = parsed.root
        parsed_arena = parsed.arena
        parsed_nodes = parsed_arena.nodes
        parsed_edges = parsed_arena.edges
        if (parsed_nodes.len() > 4096 - arena_nodes.len()) {
            RejectAt(origin.clone(), "node_limit", "stage-3 parser accepts at most 4096 AST nodes")?
        }
        if (parsed_edges.len() > 8192 - arena_edges.len()) {
            RejectAt(origin.clone(), "edge_limit", "stage-3 parser accepts at most 8192 AST edges")?
        }
        node_base = arena_nodes.len()
        index = 0
        while (index < parsed_nodes.len()) {
            input = parsed_nodes[index].clone()
            first_edge = arena_edges.len()
            edge_index = 0
            while (edge_index < input.edge_count) {
                child = parsed_edges[input.first_edge + edge_index]
                if (child <= 0 || child > parsed_nodes.len()) {
                    RejectAt(origin.clone(), "invalid_node_id", "nested AST contains an invalid NodeId")?
                }
                arena_edges = arena_edges.push(node_base + child)
                edge_index = edge_index + 1
            }
            relocated = Node {
                kind: input.kind,
                text: input.text,
                int_value: input.int_value,
                line: input.line,
                column: input.column,
                offset: input.offset,
                end_line: input.end_line,
                end_column: input.end_column,
                end_offset: input.end_offset,
                first_edge: first_edge,
                edge_count: arena_edges.len() - first_edge
            }
            arena_nodes = arena_nodes.push(relocated)
            index = index + 1
        }
        if (parsed_root <= 0 || parsed_root > parsed_nodes.len()) {
            RejectAt(origin, "invalid_node_id", "nested AST root is invalid")?
        }
        return ok(node_base + parsed_root)
    }
    append_arena: fn(ParseOutput, Token): int! = AddArena

    fn AddExpression(start: int, end: int): int! {
        if (start > end || start < 0 || end > tokens.len() - 1) {
            diagnostic_index = tokens.len() - 1
            if (start >= 0 && start < tokens.len()) { diagnostic_index = start }
            RejectAt(tokens[diagnostic_index].clone(), "invalid_expression_range", "statement expression token range is invalid")?
        }
        origin = tokens[start].clone()
        boundary = tokens[end].clone()
        // string.slice may scan the complete source. Keep an explicit aggregate
        // budget so comment-heavy modules cannot multiply that scan by every
        // statement. This also avoids interpreter per-character concatenation.
        source_length = source_chars.len()
        if (source_length > 131072 - slice_work) {
            RejectAt(origin.clone(), "work_limit", "stage-3 expression slicing budget exceeded")?
        }
        slice_work = slice_work + source_length
        slice_end = token_char_starts[start]
        if (end > start) { slice_end = token_char_ends[end - 1] }
        expression_source = expression_source_text.slice(token_char_starts[start], slice_end)?
        parsed = ParseExpressionAt(expression_source, origin.clone(), boundary)?
        return append_arena(parsed, origin)
    }

    fn ReadTypeAt(start: int): SignatureType! {
        type_tokens: [Token] = []
        probe = start
        complete = false
        while (!complete) {
            if (probe >= tokens.len()) { RejectAt(tokens[tokens.len() - 1].clone(), "invalid_token_stream", "type inspection escaped its bounded token window")? }
            type_token = tokens[probe].clone()
            complete = !TypeWindowContinues(type_token.kind.clone())
            type_tokens = PushTypeToken(type_tokens, type_token)?
            probe = probe + 1
        }
        parsed = ParseTypeWindow(type_tokens)?
        parsed.work = parsed.work + probe - start
        return ok(parsed)
    }

    fn AddParsedType(parsed: SignatureType, error_token: Token): int! {
        parsed_root = parsed.root
        parsed_parts = parsed.parts
        parsed_edges = parsed.edges
        node_base = arena_nodes.len()
        part_index = 0
        while (part_index < parsed_parts.len()) {
            part = parsed_parts[part_index].clone()
            CheckTypeArenaCapacity(arena_nodes.len(), arena_edges.len(), part.edge_count, error_token.clone())?
            first_edge = arena_edges.len()
            edge_index = 0
            while (edge_index < part.edge_count) {
                plan_edge = part.first_edge + edge_index
                if (plan_edge < 0 || plan_edge >= parsed_edges.len()) {
                    RejectAt(error_token.clone(), "invalid_node_id", "type plan edge lies outside its arena")?
                }
                child = parsed_edges[plan_edge]
                if (child <= 0 || child > part_index) {
                    RejectAt(error_token.clone(), "invalid_node_id", "type plan edge must reference an earlier NodeId")?
                }
                arena_edges = arena_edges.push(node_base + child)
                edge_index = edge_index + 1
            }
            type_node = TypePartToNode(part, first_edge)
            arena_nodes = arena_nodes.push(type_node)
            part_index = part_index + 1
        }
        if (parsed_root <= 0 || parsed_root > parsed_parts.len()) {
            RejectAt(error_token, "invalid_node_id", "type plan root is invalid")?
        }
        return ok(node_base + parsed_root)
    }

    fn ExpressionEnd(start: int): int! {
        probe = start
        boundary = EmptyExpressionBoundary()
        while (!boundary.complete) {
            if (probe >= tokens.len()) { RejectAt(tokens[tokens.len() - 1].clone(), "unexpected_eof", "expression is missing a terminator")? }
            previous_can_end = probe > start && CanEndExpression(tokens[probe - 1].kind.clone())
            boundary = PushExpressionBoundary(boundary, tokens[probe].clone(), previous_can_end)?
            if (!boundary.complete) { probe = probe + 1 }
        }
        return ok(probe)
    }

    while (tokens[cursor].kind != "Eof") {
        parse_steps = parse_steps + 1
        if (parse_steps > 16384) {
            RejectAt(tokens[cursor].clone(), "work_limit", "stage-3 parser work budget exceeded")?
        }
        if (tokens[cursor].kind == "Import") {
            if (import_count >= 64) {
                RejectAt(tokens[cursor].clone(), "import_limit", "stage-3 parser accepts at most 64 imports")?
            }
            import_window: [Token] = []
            window_cursor = cursor
            collecting_import = true
            after_path = false
            window_is_eof = false
            while (collecting_import) {
                if (window_cursor >= tokens.len()) {
                    RejectAt(tokens[tokens.len() - 1].clone(), "invalid_token_stream", "import inspection escaped the token stream")?
                }
                // 265 source tokens cover the complete 65-name all-alias
                // boundary; one appended EOF sentinel keeps every lookahead
                // safe while the 64-name grammar limit remains authoritative.
                if (import_window.len() >= 265) {
                    RejectAt(tokens[window_cursor].clone(), "work_limit", "stage-3 import inspection budget exceeded")?
                }
                window_token = tokens[window_cursor].clone()
                window_is_eof = window_token.kind == "Eof"
                window_is_string = window_token.kind == "String"
                import_window = import_window.push(window_token)
                window_cursor = window_cursor + 1
                if (after_path || window_is_eof) {
                    collecting_import = false
                } else if (window_is_string) {
                    after_path = true
                }
            }
            if (!window_is_eof) {
                import_eof = eof.clone()
                import_window = import_window.push(import_eof)
            }
            parsed = ReadImport(import_window)?
            parse_steps = parse_steps + parsed.work
            if (parse_steps > 16384) {
                RejectAt(parsed.start.clone(), "work_limit", "stage-3 parser work budget exceeded")?
            }
            import_children: [int] = []
            if (parsed.has_namespace) {
                namespace = AddNode("ImportNamespace", parsed.namespace.lexeme.clone(), 0, SpanFromToken(parsed.namespace.clone()), [], parsed.namespace.clone())?
                import_children = import_children.push(namespace)
            }
            imported_names = parsed.names.clone()
            for imported in imported_names {
                imported_has_alias = imported.has_alias
                name_children: [int] = []
                if (imported_has_alias) {
                    alias = AddNode("ImportAlias", imported.alias.lexeme.clone(), 0, SpanFromToken(imported.alias.clone()), [], imported.alias.clone())?
                    name_children = name_children.push(alias)
                }
                name = AddNode("ImportName", imported.source.lexeme.clone(), 0, SpanFromToken(imported.source.clone()), name_children, imported.source.clone())?
                import_children = import_children.push(name)
            }
            cursor = cursor + parsed.consumed
            import_node = AddNode("Import", parsed.path.lexeme.clone(), 0, SpanMerge(SpanFromToken(parsed.start.clone()), SpanFromToken(parsed.path.clone())), import_children, parsed.start.clone())?
            items = items.push(import_node)
            import_count = import_count + 1
        } else if (tokens[cursor].kind == "Module") {
            module_start = tokens[cursor].clone()
            module_node = append_arena(ReadModule(module_start.clone(), tokens[cursor + 1].clone())?, module_start)?
            items = items.push(module_node)
            cursor = cursor + 2
            if (tokens[cursor].kind == "Semicolon") { cursor = cursor + 1 }
        } else if (tokens[cursor].kind == "Struct" || tokens[cursor].kind == "Enum") {
            declaration_window: [Token] = []
            window_cursor = cursor
            while (tokens[window_cursor].kind != "RBrace" && tokens[window_cursor].kind != "Eof") {
                declaration_token = tokens[window_cursor].clone()
                declaration_window = declaration_window.push(declaration_token)
                window_cursor = window_cursor + 1
            }
            declaration_token = tokens[window_cursor].clone()
            needs_sentinel = declaration_token.kind != "Eof"
            declaration_window = declaration_window.push(declaration_token)
            if (needs_sentinel) {
                declaration_eof = eof.clone()
                declaration_window = declaration_window.push(declaration_eof)
            }
            declaration_read = ReadBracedDeclaration(declaration_window)?
            parse_steps = parse_steps + declaration_read.work
            if (parse_steps > 16384) {
                RejectAt(declaration_read.start.clone(), "work_limit", "stage-3 parser work budget exceeded")?
            }
            declaration_start = declaration_read.start.clone()
            cursor = cursor + declaration_read.consumed
            declaration_node = append_arena(declaration_read.output, declaration_start)?
            items = items.push(declaration_node)
        } else {
        if (tokens[cursor].kind == "Return") {
            RejectAt(tokens[cursor].clone(), "return_outside_function", "return outside function")?
        }
        if (tokens[cursor].kind == "Async") {
            RejectAt(tokens[cursor].clone(), "unsupported_item", "stage-3 supports import, module, struct, enum, and ordinary function items only")?
        }
        if (tokens[cursor].kind != "Fn") {
            RejectAt(tokens[cursor].clone(), "expected_item", "expected top-level item: import, fn, struct, enum, or module")?
        }
        if (function_count >= 64) {
            RejectAt(tokens[cursor].clone(), "function_limit", "stage-3 parser accepts at most 64 functions")?
        }
        function_start = tokens[cursor].clone()
        cursor = cursor + 1
        if (tokens[cursor].kind != "Ident") {
            RejectAt(tokens[cursor].clone(), "unexpected_token", "expected function name")?
        }
        function_name = tokens[cursor].lexeme.clone()
        cursor = cursor + 1
        if (tokens[cursor].kind != "LParen") {
            RejectAt(tokens[cursor].clone(), "unexpected_token", "expected '(' after function name")?
        }
        cursor = cursor + 1
        parameters: [int] = []
        parameter_count = 0
        while (tokens[cursor].kind != "RParen") {
            parse_steps = parse_steps + 1
            if (parse_steps > 16384) {
                RejectAt(tokens[cursor].clone(), "work_limit", "stage-3 parser work budget exceeded")?
            }
            if (parameter_count >= 32) {
                RejectAt(tokens[cursor].clone(), "parameter_limit", "stage-3 functions accept at most 32 parameters")?
            }
            parameter_token = tokens[cursor].clone()
            if (parameter_token.kind != "Ident") {
                RejectAt(parameter_token.clone(), "unexpected_token", "expected parameter name")?
            }
            cursor = cursor + 1
            parameter_children: [int] = []
            if (tokens[cursor].kind == "Colon") {
                parsed_type = ReadTypeAt(cursor + 1)?
                parse_steps = parse_steps + parsed_type.work
                if (parse_steps > 16384) {
                    RejectAt(tokens[cursor + 1].clone(), "work_limit", "stage-3 parser work budget exceeded")?
                }
                cursor = cursor + 1 + parsed_type.consumed
                type_node = AddParsedType(parsed_type, parameter_token.clone())?
                parameter_children = parameter_children.push(type_node)
            }
            parameter = AddNode("Parameter", parameter_token.lexeme.clone(), 0, SpanFromToken(parameter_token.clone()), parameter_children, parameter_token.clone())?
            parameters = parameters.push(parameter)
            parameter_count = parameter_count + 1
            if (tokens[cursor].kind == "Comma") {
                cursor = cursor + 1
                if (tokens[cursor].kind == "RParen") {
                    RejectAt(tokens[cursor].clone(), "unexpected_token", "expected parameter name")?
                }
            } else if (tokens[cursor].kind != "RParen") {
                RejectAt(tokens[cursor].clone(), "unexpected_token", "expected ')' after parameters")?
            }
        }
        cursor = cursor + 1
        return_type = 0
        has_return_type = false
        if (tokens[cursor].kind == "Colon") {
            parsed_type = ReadTypeAt(cursor + 1)?
            parse_steps = parse_steps + parsed_type.work
            if (parse_steps > 16384) {
                RejectAt(tokens[cursor + 1].clone(), "work_limit", "stage-3 parser work budget exceeded")?
            }
            has_return_type = true
            cursor = cursor + 1 + parsed_type.consumed
            return_type = AddParsedType(parsed_type, tokens[cursor - 1].clone())?
        }
        if (tokens[cursor].kind != "LBrace") {
            RejectAt(tokens[cursor].clone(), "unexpected_token", "expected '{'")?
        }
        cursor = cursor + 1
        statements: [int] = []
        statement_count = 0
        while (tokens[cursor].kind != "RBrace") {
            parse_steps = parse_steps + 1
            if (parse_steps > 16384) {
                RejectAt(tokens[cursor].clone(), "work_limit", "stage-3 parser work budget exceeded")?
            }
            if (tokens[cursor].kind == "Eof") {
                RejectAt(tokens[cursor].clone(), "unexpected_eof", "expected '}' after function body")?
            }
            if (statement_count >= 128) {
                RejectAt(tokens[cursor].clone(), "statement_limit", "stage-3 parser accepts at most 128 statements per function")?
            }
            statement_start = tokens[cursor].clone()
            statement = 0
            if (statement_start.kind == "Let") {
                RejectAt(statement_start, "unsupported_statement", "'let' is not supported in Ku; use a typed declaration or assignment")?
            } else if (statement_start.kind == "Return") {
                cursor = cursor + 1
                children: [int] = []
                end_span = SpanFromToken(statement_start.clone())
                if (tokens[cursor].kind == "Semicolon") {
                    end_span = SpanFromToken(tokens[cursor].clone())
                    cursor = cursor + 1
                } else if (tokens[cursor].kind != "RBrace") {
                    expression_end = ExpressionEnd(cursor)?
                    expression = AddExpression(cursor, expression_end)?
                    children = children.push(expression)
                    expression_node = arena_nodes[expression - 1].clone()
                    end_span = SpanFromNode(expression_node)
                    cursor = expression_end
                    if (tokens[cursor].kind == "Semicolon") { cursor = cursor + 1 }
                }
                statement = AddNode("Return", "", 0, SpanMerge(SpanFromToken(statement_start.clone()), end_span), children, statement_start.clone())?
            } else if (statement_start.kind == "Ident" && tokens[cursor + 1].kind == "Colon") {
                name = statement_start.lexeme.clone()
                cursor = cursor + 2
                parsed_type = ReadTypeAt(cursor)?
                parse_steps = parse_steps + parsed_type.work
                if (parse_steps > 16384) {
                    RejectAt(tokens[cursor].clone(), "work_limit", "stage-3 parser work budget exceeded")?
                }
                type_consumed = parsed_type.consumed
                type_node = AddParsedType(parsed_type, tokens[cursor].clone())?
                cursor = cursor + type_consumed
                if (tokens[cursor].kind != "Equal") {
                    RejectAt(tokens[cursor].clone(), "unsupported_statement", "stage-3 typed declarations require an initializer")?
                }
                cursor = cursor + 1
                expression_end = ExpressionEnd(cursor)?
                expression = AddExpression(cursor, expression_end)?
                expression_node = arena_nodes[expression - 1].clone()
                statement = AddNode("VarDecl", name, 0, SpanMerge(SpanFromToken(statement_start.clone()), SpanFromNode(expression_node)), [type_node, expression], statement_start.clone())?
                cursor = expression_end
                if (tokens[cursor].kind == "Semicolon") { cursor = cursor + 1 }
            } else if (statement_start.kind == "Ident" && tokens[cursor + 1].kind == "Equal") {
                name = statement_start.lexeme.clone()
                cursor = cursor + 2
                expression_end = ExpressionEnd(cursor)?
                expression = AddExpression(cursor, expression_end)?
                expression_node = arena_nodes[expression - 1].clone()
                statement = AddNode("Assign", name, 0, SpanMerge(SpanFromToken(statement_start.clone()), SpanFromNode(expression_node)), [expression], statement_start.clone())?
                cursor = expression_end
                if (tokens[cursor].kind == "Semicolon") { cursor = cursor + 1 }
            } else {
                expression_end = ExpressionEnd(cursor)?
                expression = AddExpression(cursor, expression_end)?
                expression_node = arena_nodes[expression - 1].clone()
                statement = AddNode("ExprStmt", "", 0, SpanFromNode(expression_node), [expression], statement_start.clone())?
                cursor = expression_end
                if (tokens[cursor].kind == "Semicolon") { cursor = cursor + 1 }
            }
            statements = statements.push(statement)
            statement_count = statement_count + 1
        }
        function_end = tokens[cursor].clone()
        cursor = cursor + 1
        function_children: [int] = parameters
        if (has_return_type) { function_children = function_children.push(return_type) }
        for statement in statements { function_children = function_children.push(statement) }
        function = AddNode("Function", function_name, 0, SpanMerge(SpanFromToken(function_start.clone()), SpanFromToken(function_end)), function_children, function_start.clone())?
        items = items.push(function)
        function_count = function_count + 1
        }
    }

    program_span = SpanFromToken(eof.clone())
    if (items.len() > 0) {
        first = arena_nodes[items[0] - 1].clone()
        last = arena_nodes[items[items.len() - 1] - 1].clone()
        program_span = SpanMerge(SpanFromNode(first), SpanFromNode(last))
    }
    root = AddNode("Program", "", 0, program_span, items, eof.clone())?
    // Local helpers retain the shared cells until this frame exits. Clone each
    // completed flat arena once; self-push no longer clones per node.
    return ValidateParseOutput(ParseOutput {
        arena: Arena { nodes: arena_nodes.clone(), edges: arena_edges.clone() },
        root: root
    })
}
