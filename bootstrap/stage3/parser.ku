import { Token } from "../stage1/token.ku"
import { Scan } from "../stage1/lexer.ku"
import { SpanFromToken, SpanMerge } from "../stage2/span.ku"
import { EmptyArena, ParseOutput, ValidateParseOutput } from "../stage2/ast.ku"
import { ParseTokenWindow } from "../stage2/parser.ku"
import { AppendStage3Arena, AppendStage3Node, ReadStage3ProgramSpan, RejectAt, RejectAtPoint, WindowToken } from "./support.ku"
import { ReadModuleImport } from "./imports.ku"
import { DeclarationRead, ReadModule } from "./structs.ku"
import { ReadBracedDeclaration } from "./enums.ku"
import { ModuleFunctionEnd, ReadFunction, ReadCompilerFunction } from "./functions.ku"

// Stage 3 is intentionally a strict, useful subset of the production Rust
// parser. It accepts top-level module/struct/enum declarations and named
// functions, with a separate AsyncFunction node for async declarations.
// Function bodies share the same bounded syntax: typed declarations, variable
// assignments, expression statements, return statements and braced if/else.
// Parameters may be untyped; parameter, return and local-declaration types share
// source-positioned TypeName, TypeArray, TypeResult and TypeUnion arena nodes.
// Statement boundaries follow the production token grammar, including Ku's
// ordinary newline/whitespace-separated style; an
// existing optional semicolon is also accepted. Unsupported production syntax
// is rejected explicitly rather than guessed at or given a second interpretation.
//
// Stage 2 consumes bounded windows of the original tokens. Their absolute
// source positions also locate expression errors without a second lexer pass.

fn ReadTokenWindow(&tokens: [Token], start: int, end: int, work_cost: int,
                   work_remaining: int, compiler_input: bool): [Token]! {
    if (tokens.len() == 0) {
        RejectAtPoint("invalid_token_stream", "token stream must contain exactly one final EOF")?
    }
    if (start > end || start < 0 || end > tokens.len() - 1) {
        code = "invalid_expression_range"
        message = "statement expression token range is invalid"
        if (start >= 0 && start < tokens.len()) {
            RejectAt(tokens[start].clone(), code, message)?
        } else {
            RejectAt(tokens[tokens.len() - 1].clone(), code, message)?
        }
    }
    if (work_cost > work_remaining) {
        if (compiler_input) {
            RejectAt(tokens[start].clone(), "work_limit", "stage-3 token window work budget exceeded")?
        }
        RejectAt(tokens[start].clone(), "work_limit", "stage-3 expression slicing budget exceeded")?
    }
    window: [Token] = []
    index = start
    while (index < end) {
        token = tokens[index].clone()
        window = window.push(token)
        index = index + 1
    }
    boundary = WindowToken(tokens, end, end)
    window = window.push(boundary)
    return ok(window)
}

fn ParseProgram(source: str): ParseOutput! {
    return ParseBoundedModule(source, false)
}

// Compiler input uses the scanner's file ceiling and charges each actual
// expression window. Keep the original script entry's legacy ceilings.
fn ParseModule(source: str): ParseOutput! {
    return ParseBoundedModule(source, true)
}

fn CopyFunctionWindow(&tokens: [Token], first: int, end: int): [Token] {
    window: [Token] = []
    index = first
    while (index < end) {
        item = tokens[index].clone()
        window = window.push(item)
        index = index + 1
    }
    closing = tokens[tokens.len() - 1].clone()
    window = window.push(closing)
    return window
}

fn ReadModuleFunction(&tokens: [Token], first: int, end: int, compiler_input: bool,
                      parse_expression: fn(int, int): ParseOutput!): DeclarationRead! {
    if (compiler_input) { return ReadCompilerFunction(tokens, first, end, parse_expression) }
    return ReadFunction(CopyFunctionWindow(tokens, first, end), 0, parse_expression)
}

fn CopyBracedDeclarationWindow(&tokens: [Token], cursor: int, &eof: Token): [Token] {
    declaration_window: [Token] = []
    limit = tokens.len()
    window_cursor = cursor
    while (window_cursor < limit &&
        (tokens[window_cursor].kind != "RBrace" && tokens[window_cursor].kind != "Eof")) {
        declaration_token = tokens[window_cursor].clone()
        declaration_window = declaration_window.push(declaration_token)
        window_cursor = window_cursor + 1
    }
    declaration_token = tokens[window_cursor].clone()
    needs_sentinel = declaration_token.kind != "Eof"
    declaration_window = declaration_window.push(declaration_token)
    // A closed declaration still needs the scanner's real EOF coordinates.
    if (needs_sentinel) {
        declaration_eof = eof.clone()
        declaration_window = declaration_window.push(declaration_eof)
    }
    return declaration_window
}

fn ParseBoundedModule(source: str, compiler_input: bool): ParseOutput! {
    source_length = source.len()
    tokens = Scan(source)?
    if (tokens.len() == 0) {
        RejectAtPoint("invalid_token_stream", "token stream must contain exactly one final EOF")?
    }
    if (!compiler_input && tokens.len() > 512) {
        RejectAt(tokens[0].clone(), "invalid_token_stream", "stage-3 parser accepts at most 512 tokens")?
    }
    token_index = 0
    while (token_index < tokens.len() - 1) {
        if (tokens[token_index].kind == "Eof") {
            RejectAt(tokens[token_index].clone(), "invalid_token_stream", "EOF must be the final token")?
        }
        token_index = token_index + 1
    }
    eof = tokens[tokens.len() - 1].clone()
    if (eof.kind != "Eof") {
        RejectAt(eof.clone(), "invalid_token_stream", "token stream is missing EOF")?
    }

    arena = EmptyArena()
    cursor = 0
    items: [int] = []
    import_count = 0
    function_count = 0
    parse_steps = 0
    expression_work = 0
    expression_base = 0

    // After token/EOF preflight, keep one callback-owned snapshot so
    // the outer scanner's tokens binding is not retained by this closure.
    expression_tokens = tokens.clone()
    fn ParseExpressionWindow(start: int, end: int): ParseOutput! {
        cost = source_length
        limit = 131072
        if (compiler_input) {
            cost = end - start + 1
            limit = 16384
        }
        // Borrow the scanner array once so a
        // captured field read cannot clone it for each appended expression token.
        window = ReadTokenWindow(expression_tokens, expression_base + start, expression_base + end,
                                 cost, limit - expression_work, compiler_input)?
        expression_work = expression_work + cost
        return ParseTokenWindow(window, true)
    }
    parse_expression: fn(int, int): ParseOutput! = ParseExpressionWindow

    // Each successful declaration advances the scanner cursor. The file's
    // token count bounds those visits while the original EOF check retains
    // its bounds and diagnostic order.
    declaration_limit = tokens.len()
    declaration_index = 0
    while (declaration_index < declaration_limit && tokens[cursor].kind != "Eof") {
        parse_steps = parse_steps + 1
        if (parse_steps > 16384) {
            RejectAt(tokens[cursor].clone(), "work_limit", "stage-3 parser work budget exceeded")?
        }
        if (tokens[cursor].kind == "Import") {
            if (import_count >= 64) {
                RejectAt(tokens[cursor].clone(), "import_limit", "stage-3 parser accepts at most 64 imports")?
            }
            parsed = ReadModuleImport(tokens, cursor, eof)?
            parse_steps = parse_steps + parsed.work
            if (parse_steps > 16384) {
                RejectAt(parsed.start.clone(), "work_limit", "stage-3 parser work budget exceeded")?
            }
            import_children: [int] = []
            if (parsed.has_namespace) {
                { arena, root: namespace } = AppendStage3Node("ImportNamespace", parsed.namespace.lexeme.clone(), 0, SpanFromToken(parsed.namespace.clone()), [], parsed.namespace.clone(), arena)?
                import_children = import_children.push(namespace)
            }
            for imported in parsed.names.clone() {
                imported_has_alias = imported.has_alias
                name_children: [int] = []
                if (imported_has_alias) {
                    { arena, root: alias } = AppendStage3Node("ImportAlias", imported.alias.lexeme.clone(), 0, SpanFromToken(imported.alias.clone()), [], imported.alias.clone(), arena)?
                    name_children = name_children.push(alias)
                }
                { arena, root: name } = AppendStage3Node("ImportName", imported.source.lexeme.clone(), 0, SpanFromToken(imported.source.clone()), name_children, imported.source.clone(), arena)?
                import_children = import_children.push(name)
            }
            cursor = cursor + parsed.consumed
            { arena, root: import_node } = AppendStage3Node("Import", parsed.path.lexeme.clone(), 0, SpanMerge(SpanFromToken(parsed.start.clone()), SpanFromToken(parsed.path.clone())), import_children, parsed.start.clone(), arena)?
            items = items.push(import_node)
            import_count = import_count + 1
        } else if (tokens[cursor].kind == "Module") {
            module_start = tokens[cursor].clone()
            { arena, root: module_node } = AppendStage3Arena(ReadModule(module_start.clone(), tokens[cursor + 1].clone())?, module_start, arena)?
            items = items.push(module_node)
            cursor = cursor + 2
            if (tokens[cursor].kind == "Semicolon") { cursor = cursor + 1 }
        } else if (tokens[cursor].kind == "Struct" || tokens[cursor].kind == "Enum") {
            declaration_window = CopyBracedDeclarationWindow(tokens, cursor, eof)
            declaration_read = ReadBracedDeclaration(declaration_window)?
            parse_steps = parse_steps + declaration_read.work
            if (parse_steps > 16384) {
                RejectAt(declaration_read.start.clone(), "work_limit", "stage-3 parser work budget exceeded")?
            }
            declaration_start = declaration_read.start.clone()
            cursor = cursor + declaration_read.consumed
            { arena, root: declaration_node } = AppendStage3Arena(declaration_read.output, declaration_start, arena)?
            items = items.push(declaration_node)
        } else {
        if (tokens[cursor].kind == "Return") {
            RejectAt(tokens[cursor].clone(), "return_outside_function", "return outside function")?
        }
        if (tokens[cursor].kind != "Fn" && tokens[cursor].kind != "Async") {
            RejectAt(tokens[cursor].clone(), "expected_item", "expected top-level item: import, fn, struct, enum, or module")?
        }
        if (function_count >= 64) {
            RejectAt(tokens[cursor].clone(), "function_limit", "stage-3 parser accepts at most 64 functions")?
        }
        function_base = cursor
        function_end = ModuleFunctionEnd(tokens, function_base, eof)?
        // The compiler reader and callback use absolute scanner indexes. The
        // standalone reader still uses its original local 512-token contract.
        expression_base = function_base
        if (compiler_input) {
            expression_base = 0
            parse_steps = parse_steps + function_end - function_base
            if (parse_steps > 16384) {
                RejectAt(tokens[function_base].clone(), "work_limit", "stage-3 parser work budget exceeded")?
            }
        }
        function_read = ReadModuleFunction(tokens, function_base, function_end, compiler_input, parse_expression.clone())?
        parse_steps = parse_steps + function_read.work
        if (parse_steps > 16384) {
            RejectAt(function_read.start.clone(), "work_limit", "stage-3 parser work budget exceeded")?
        }
        function_consumed = function_read.consumed
        function_start = function_read.start.clone()
        function_output = function_read.output
        cursor = cursor + function_consumed
        { arena, root: function } = AppendStage3Arena(function_output, function_start, arena)?
        items = items.push(function)
        function_count = function_count + 1
        }
        declaration_index = declaration_index + 1
    }

    program_span = SpanFromToken(eof.clone())
    if (items.len() > 0) {
        program_span = ReadStage3ProgramSpan(arena.nodes, items)
    }
    { arena, root } = AppendStage3Node("Program", "", 0, program_span, items, eof.clone(), arena)?
    return ValidateParseOutput(ParseOutput { arena: arena, root: root })
}
