import { Token } from "../stage1/token.ku"
import { Node, Arena, ParseOutput } from "../stage2/ast.ku"
import { SpanFromToken, SpanMerge } from "../stage2/span.ku"
import { RejectAt, RejectAtPoint } from "./support.ku"
import { SignatureType, CheckTypeArenaCapacity, TypePartToNode } from "./signature.ku"

struct StatementLink {
    node: int
    previous: int
}

struct ControlFrame {
    is_while: bool
    start: int
    condition: int
    body_top: int
    body_count: int
    else_top: int
    else_count: int
    phase: int
    previous: int
}

fn NewControlFrame(is_while: bool, start: int, condition: int, previous: int): ControlFrame {
    return ControlFrame { is_while: is_while, start: start, condition: condition, body_top: 0, body_count: 0, else_top: 0, else_count: 0, phase: 0, previous: previous }
}

fn NextBodyWork(current: int, amount: int, error_token: Token): int! {
    if (current < 0 || current > 16384 || amount < 0 || amount > 16384 - current) {
        RejectAt(error_token, "work_limit", "stage-3 parser work budget exceeded")?
    }
    return ok(current + amount)
}

fn RejectBodyEof(control_depth: int, is_while: bool, phase: int, error_token: Token): null! {
    if (control_depth > 0 && is_while) {
        RejectAt(error_token.clone(), "unexpected_eof", "expected '}' after while body")?
    }
    if (control_depth > 0 && phase == 0) {
        RejectAt(error_token.clone(), "unexpected_eof", "expected '}' after if body")?
    }
    if (control_depth > 0) {
        RejectAt(error_token.clone(), "unexpected_eof", "expected '}' after else body")?
    }
    RejectAt(error_token, "unexpected_eof", "expected '}' after function body")?
    return ok(null)
}

fn RejectControlOpen(is_while: bool, error_token: Token): null! {
    if (!is_while) { RejectAt(error_token.clone(), "unexpected_token", "expected '(' after 'if'")? }
    RejectAt(error_token, "unexpected_token", "expected '(' after 'while'")?
    return ok(null)
}

fn RejectControlClose(is_while: bool, error_token: Token): null! {
    if (!is_while) { RejectAt(error_token.clone(), "unexpected_token", "expected ')' after if condition")? }
    RejectAt(error_token, "unexpected_token", "expected ')' after while condition")?
    return ok(null)
}

fn RejectControlBody(is_while: bool, error_token: Token): null! {
    if (!is_while) { RejectAt(error_token.clone(), "unsupported_statement", "stage-3 if bodies must use braces")? }
    RejectAt(error_token, "unsupported_statement", "stage-3 while bodies must use braces")?
    return ok(null)
}

fn RejectBodyNodeLimit(token: Token): null! { RejectAt(token, "node_limit", "stage-3 parser accepts at most 4096 AST nodes")? return ok(null) }
fn RejectBodyEdgeLimit(token: Token): null! { RejectAt(token, "edge_limit", "stage-3 parser accepts at most 8192 AST edges")? return ok(null) }
fn RejectBodyEdgeId(token: Token): null! { RejectAt(token, "invalid_node_id", "AST edge references an invalid NodeId")? return ok(null) }
fn RejectNestedNodeId(token: Token): null! { RejectAt(token, "invalid_node_id", "nested AST contains an invalid NodeId")? return ok(null) }
fn RejectNestedRoot(token: Token): null! { RejectAt(token, "invalid_node_id", "nested AST root is invalid")? return ok(null) }
fn RejectTypeInspection(token: Token): null! { RejectAt(token, "invalid_token_stream", "type inspection escaped its bounded token window")? return ok(null) }
fn RejectExpressionTerminator(token: Token): null! { RejectAt(token, "unexpected_eof", "expression is missing a terminator")? return ok(null) }
fn RejectBodyWorkLimit(token: Token): null! { RejectAt(token, "work_limit", "stage-3 parser work budget exceeded")? return ok(null) }
fn RejectStatementLink(token: Token): null! { RejectAt(token, "invalid_node_id", "statement list contains an invalid link")? return ok(null) }
fn RejectStatementNode(token: Token): null! { RejectAt(token, "invalid_node_id", "statement list contains an invalid NodeId")? return ok(null) }
fn RejectStatementLength(token: Token): null! { RejectAt(token, "invalid_node_id", "statement list length is inconsistent")? return ok(null) }
fn RejectElseIf(token: Token): null! { RejectAt(token, "unsupported_statement", "stage-3 does not support else-if yet; use 'else { if (...) { ... } }'")? return ok(null) }
fn RejectElseBody(token: Token): null! { RejectAt(token, "unsupported_statement", "stage-3 else bodies must use braces")? return ok(null) }
fn RejectStrayElse(token: Token): null! { RejectAt(token, "unsupported_statement", "stage-3 else must immediately follow an if body")? return ok(null) }
fn RejectStatementLimit(token: Token): null! { RejectAt(token, "statement_limit", "stage-3 parser accepts at most 128 statements per function")? return ok(null) }
fn RejectStatementDepth(token: Token): null! { RejectAt(token, "statement_depth_exceeded", "stage-3 statement nesting exceeds 32 levels")? return ok(null) }
fn RejectLetStatement(token: Token): null! { RejectAt(token, "unsupported_statement", "'let' is not supported in Ku; use a typed declaration or assignment")? return ok(null) }
fn RejectDeclarationInitializer(token: Token): null! { RejectAt(token, "unsupported_statement", "stage-3 typed declarations require an initializer")? return ok(null) }
fn RejectTrailingDeclaration(token: Token): null! { RejectAt(token, "invalid_token_stream", "function window must contain exactly one declaration before EOF")? return ok(null) }

// Finish the internal body transport in one owned transfer. Keeping this cold
// path outside statements.ku preserves lexer headroom without wrapping each
// parsed node or token at a module boundary.
fn FinishFunctionBodyOutput(input_nodes: [Node], input_edges: [int], parse_steps: int, body_open: Token, function_end: Token, statements: [int]): ParseOutput! {
    nodes: [Node] = input_nodes
    edges: [int] = input_edges
    if (parse_steps < 0 || parse_steps > 16384) {
        RejectAt(body_open.clone(), "work_limit", "stage-3 parser work budget exceeded")?
    }
    if (nodes.len() >= 4096) {
        RejectAt(body_open.clone(), "node_limit", "stage-3 parser accepts at most 4096 AST nodes")?
    }
    if (statements.len() > 8192 - edges.len()) {
        RejectAt(body_open.clone(), "edge_limit", "stage-3 parser accepts at most 8192 AST edges")?
    }
    first_edge = edges.len()
    for child in statements {
        if (child <= 0 || child > nodes.len()) {
            RejectAt(body_open.clone(), "invalid_node_id", "AST edge references an invalid NodeId")?
        }
        edges = edges.push(child)
    }
    span = SpanMerge(SpanFromToken(body_open), SpanFromToken(function_end))
    transport = Node {
        kind: "FunctionBodyTransport",
        text: "",
        int_value: parse_steps,
        line: span.line,
        column: span.column,
        offset: span.offset,
        end_line: span.end_line,
        end_column: span.end_column,
        end_offset: span.end_offset,
        first_edge: first_edge,
        edge_count: edges.len() - first_edge
    }
    nodes = nodes.push(transport)
    root = nodes.len()
    return ok(ParseOutput { arena: Arena { nodes: nodes, edges: edges }, root: root })
}

// Validate and return the owned token window so the body reader never needs a
// full-array clone merely to cross this internal module boundary.
fn ValidateFunctionBodyWindow(input_tokens: [Token], body_start: int, token_base: int, initial_work: int): [Token]! {
    tokens: [Token] = input_tokens
    if (tokens.len() > 512) {
        RejectAtPoint("invalid_token_stream", "function body window accepts at most 512 tokens")?
    }
    if (tokens.len() == 0) {
        RejectAtPoint("invalid_token_stream", "function body window must start with fn and end with EOF")?
    }
    if (token_base < 0 || token_base > 512 - tokens.len()) {
        RejectAtPoint("invalid_token_stream", "function body token base lies outside stage-3 token bounds")?
    }
    if (initial_work < 0 || initial_work > 16384) {
        RejectAtPoint("work_limit", "stage-3 parser work budget exceeded")?
    }
    last_index = tokens.len() - 1
    last = tokens[last_index].clone()
    if (last.kind != "Eof" || tokens[0].kind != "Fn") {
        RejectAt(tokens[0].clone(), "invalid_token_stream", "function body window must start with fn and end with EOF")?
    }
    validation_index = 0
    while (validation_index < last_index) {
        if (tokens[validation_index].kind == "Eof") {
            RejectAt(tokens[validation_index].clone(), "invalid_token_stream", "EOF must be final in function body window")?
        }
        validation_index = validation_index + 1
    }
    if (body_start < 1 || body_start > last_index) {
        RejectAt(last.clone(), "invalid_token_stream", "function body start lies outside its bounded token window")?
    }
    body_open = tokens[body_start - 1].clone()
    if (body_open.kind != "LBrace") {
        RejectAt(body_open.clone(), "invalid_token_stream", "function body start must immediately follow '{'")?
    }
    return ok(tokens)
}

// Materialize a bounded signature plan as an internal subtree. The body reader's
// AddArena consumer validates it before relocation, keeping one NodeId contract
// for both expression callbacks and declaration types without a duplicate pass.
fn SignatureTypeOutput(parsed: SignatureType, error_token: Token): ParseOutput! {
    parsed_root = parsed.root
    parsed_parts = parsed.parts
    parsed_edges = parsed.edges
    nodes: [Node] = []
    edges: [int] = []
    part_index = 0
    while (part_index < parsed_parts.len()) {
        part = parsed_parts[part_index].clone()
        CheckTypeArenaCapacity(nodes.len(), edges.len(), part.edge_count, error_token.clone())?
        first_edge = edges.len()
        edge_index = 0
        while (edge_index < part.edge_count) {
            plan_edge = part.first_edge + edge_index
            if (plan_edge < 0 || plan_edge >= parsed_edges.len()) {
                RejectAt(error_token.clone(), "invalid_node_id", "type plan edge lies outside its arena")?
            }
            child = parsed_edges[plan_edge]
            if (child <= 0 || child > part_index) {
                RejectAt(error_token.clone(), "invalid_node_id", "type plan edge must reference an earlier NodeId")?
            }
            edges = edges.push(child)
            edge_index = edge_index + 1
        }
        nodes = nodes.push(TypePartToNode(part, first_edge))
        part_index = part_index + 1
    }
    if (parsed_root <= 0 || parsed_root > parsed_parts.len()) {
        RejectAt(error_token, "invalid_node_id", "type plan root is invalid")?
    }
    return ok(ParseOutput { arena: Arena { nodes: nodes, edges: edges }, root: parsed_root })
}
