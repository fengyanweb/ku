import { Token } from "../stage1/token.ku"
import { Span, SpanFromToken, SpanMerge } from "../stage2/span.ku"
import { Arena, Node, ParseOutput } from "../stage2/ast.ku"
import { MakeExpressionNode } from "../stage2/expression_support.ku"
import { NextBodyWork, ReadExpressionEnd } from "./body_support.ku"
import { TypePart, ReadSignatureTypePrefix, CheckTypeArenaCapacity, TypePartToNode } from "./signature.ku"
import { AppendStage3Node, RejectAt, RejectAtSpan, Stage3ArenaAppend, WindowKind, WindowToken } from "./support.ku"

struct FunctionHeader {
    name: str
    arena: Arena
    children: [int]
    body_open: int
    work: int
}

struct LocalFunctionScope {
    children: [int]
    parent_statement_count: int
    function_start: int
    declared_type: int
}

struct LocalFunctionHeader {
    name: str
    output: ParseOutput
    scope: LocalFunctionScope
    body_open: int
    work: int
}

struct TypedInitializerRead {
    expression: int
    cursor: int
    work: int
}

fn ReadTypedInitializer(&tokens: [Token], first: int, last: int, token_base: int, initial_work: int,
                        &context: str, parse_expression: fn(int, int): ParseOutput!,
                        add_arena: fn(ParseOutput, Token, bool): int!,
                        add_node: fn(str, str, int, Span, [int], Token): int!,
                        read_span: fn(int): Span): TypedInitializerRead! {
    arrow = WindowKind(tokens, first, last) == "LParen" && WindowKind(tokens, first + 1, last) == "RParen"
        && WindowKind(tokens, first + 2, last) == "Arrow"
    start = first
    work = initial_work
    if (arrow) {
        start = first + 3
        work = NextBodyWork(work, 3, WindowToken(tokens, first, last))?
        if (WindowKind(tokens, start, last) == "LBrace") {
            RejectAt(WindowToken(tokens, start, last), "unsupported_expression", "stage-3 arrow initializer requires an expression body")?
        }
    }
    end = ReadExpressionEnd(tokens, start, last, context)?
    origin = WindowToken(tokens, start, last)
    parsed = parse_expression(token_base + start, token_base + end)?
    expression = add_arena(parsed, origin.clone(), false)?
    if (arrow) {
        // Stage0 represents an expression body as one implicit Return.
        body_span = read_span(expression)
        returned = add_node("Return", "", 0, body_span.clone(), [expression], origin)?
        opener = WindowToken(tokens, first, last)
        function_span = SpanMerge(SpanFromToken(opener.clone()), body_span)
        expression = add_node("FunctionExpr", "", 0, function_span, [returned], opener)?
    }
    return ok(TypedInitializerRead { expression: expression, cursor: end, work: work })
}

// Parse one ordinary named function signature against an existing bounded
// token window. The returned forest is consumed by the function/body reader.
fn ReadFunctionHeader(&tokens: [Token], first: int, last_index: int, initial_work: int): FunctionHeader! {
    return ReadFunctionHeaderMode(tokens, first, last_index, initial_work, false)
}

fn FunctionHeaderOrigin(&token: Token): Span {
    return Span {
        line: token.line, column: token.column, offset: token.offset,
        end_line: token.end_line, end_column: token.end_column, end_offset: token.end_offset
    }
}

fn ChargeFunctionHeaderWork(current: int, amount: int, error_token: Token): int! {
    next = current + amount
    if (next > 16384) {
        RejectAtSpan(FunctionHeaderOrigin(error_token), "work_limit", "stage-3 parser work budget exceeded")?
    }
    return ok(next)
}

fn AppendFunctionHeaderType(parsed_parts: [TypePart], parsed_edges: [int], parsed_root: int, error_token: Token,
                            arena: Arena): Stage3ArenaAppend! {
    { nodes: arena_nodes, edges: arena_edges } = arena
    node_base = arena_nodes.len()
    part_index = 0
    while (part_index < parsed_parts.len()) {
        part = parsed_parts[part_index].clone()
        CheckTypeArenaCapacity(arena_nodes.len(), arena_edges.len(), part.edge_count, error_token.clone())?
        first_edge = arena_edges.len()
        edge_index = 0
        while (edge_index < part.edge_count) {
            plan_edge = part.first_edge + edge_index
            if (plan_edge < 0 || plan_edge >= parsed_edges.len()) {
                RejectAt(error_token.clone(), "invalid_node_id", "type plan edge lies outside its arena")?
            }
            child = parsed_edges[plan_edge]
            if (child <= 0 || child > part_index) {
                RejectAt(error_token.clone(), "invalid_node_id", "type plan edge must reference an earlier NodeId")?
            }
            arena_edges = arena_edges.push(node_base + child)
            edge_index = edge_index + 1
        }
        type_node = TypePartToNode(part, first_edge)
        arena_nodes = arena_nodes.push(type_node)
        part_index = part_index + 1
    }
    if (parsed_root <= 0 || parsed_root > parsed_parts.len()) {
        RejectAtSpan(FunctionHeaderOrigin(error_token), "invalid_node_id", "type plan root is invalid")?
    }
    return ok(Stage3ArenaAppend { arena: Arena { nodes: arena_nodes, edges: arena_edges },
                                 root: node_base + parsed_root })
}

fn ReadFunctionHeaderMode(&tokens: [Token], first: int, last_index: int, initial_work: int, anonymous: bool): FunctionHeader! {
    arena_nodes: [Node] = []
    arena_edges: [int] = []
    arena = Arena { nodes: arena_nodes, edges: arena_edges }
    parse_steps = initial_work

    function_start = WindowToken(tokens, first, last_index)
    cursor = first + 1
    function_name = ""
    open_error = "expected '(' after 'fn'"
    parameter_error = "expected anonymous function parameter"
    close_error = "expected ')' after anonymous function parameters"
    if (!anonymous) {
        if (function_start.kind == "Async") {
            after_async = WindowKind(tokens, cursor, last_index)
            if (after_async != "Fn") {
                RejectAt(WindowToken(tokens, cursor, last_index), "unexpected_token", "expected 'fn' after 'async'")?
            }
            after_async_work = ChargeFunctionHeaderWork(parse_steps, 1, function_start.clone())?
            parse_steps = after_async_work
            cursor = cursor + 1
        }
        before_name = WindowKind(tokens, cursor, last_index)
        if (before_name != "Ident") {
            RejectAt(WindowToken(tokens, cursor, last_index), "unexpected_token", "expected function name")?
        }
        function_name = tokens[cursor].lexeme.clone()
        cursor = cursor + 1
        open_error = "expected '(' after function name"
        parameter_error = "expected parameter name"
        close_error = "expected ')' after parameters"
    }
    before_parameters = WindowKind(tokens, cursor, last_index)
    if (before_parameters != "LParen") {
        RejectAt(WindowToken(tokens, cursor, last_index), "unexpected_token", open_error)?
    }
    cursor = cursor + 1
    parameters: [int] = []
    parameter_count = 0
    first_parameter_kind = WindowKind(tokens, cursor, last_index)
    has_parameter = first_parameter_kind != "RParen"
    while (has_parameter) {
        parse_steps = ChargeFunctionHeaderWork(parse_steps, 1, WindowToken(tokens, cursor, last_index))?
        if (parameter_count >= 32) {
            RejectAt(WindowToken(tokens, cursor, last_index), "parameter_limit", "stage-3 functions accept at most 32 parameters")?
        }
        parameter_start = WindowToken(tokens, cursor, last_index)
        parameter_mode = 0
        parameter_kind = WindowKind(tokens, cursor, last_index)
        if (parameter_kind == "Ampersand") {
            parameter_mode = 1
            cursor = cursor + 1
            parse_steps = ChargeFunctionHeaderWork(parse_steps, 1, parameter_start.clone())?
        }
        parameter_token = WindowToken(tokens, cursor, last_index)
        if (parameter_token.kind != "Ident") {
            RejectAt(parameter_token.clone(), "unexpected_token", parameter_error.clone())?
        }
        cursor = cursor + 1
        parameter_children: [int] = []
        before_type = WindowKind(tokens, cursor, last_index)
        if (before_type == "Colon") {
            type_start = cursor + 1
            parsed_type = ReadSignatureTypePrefix(tokens, type_start, last_index)?
            { parts, edges, root, consumed, work } = parsed_type
            parse_steps = ChargeFunctionHeaderWork(parse_steps, work, WindowToken(tokens, type_start, last_index))?
            cursor = cursor + 1 + consumed
            { arena, root: type_node } = AppendFunctionHeaderType(parts, edges, root, parameter_token.clone(), arena)?
            parameter_children = parameter_children.push(type_node)
        }
        parameter_span = SpanMerge(SpanFromToken(parameter_start), SpanFromToken(parameter_token.clone()))
        { arena, root: parameter } = AppendStage3Node("Parameter", parameter_token.lexeme.clone(), parameter_mode,
            parameter_span, parameter_children, parameter_token.clone(), arena)?
        parameters = parameters.push(parameter)
        parameter_count = parameter_count + 1
        before_comma = WindowKind(tokens, cursor, last_index)
        if (before_comma == "Comma") {
            cursor = cursor + 1
            after_comma = WindowKind(tokens, cursor, last_index)
            if (after_comma == "RParen") {
                RejectAt(WindowToken(tokens, cursor, last_index), "unexpected_token", parameter_error.clone())?
            }
        } else {
            before_close = WindowKind(tokens, cursor, last_index)
            if (before_close != "RParen") {
                RejectAt(WindowToken(tokens, cursor, last_index), "unexpected_token", close_error.clone())?
            }
        }
        next_parameter_kind = WindowKind(tokens, cursor, last_index)
        has_parameter = next_parameter_kind != "RParen"
    }
    cursor = cursor + 1
    return_type = 0
    has_return_type = false
    before_return_type = WindowKind(tokens, cursor, last_index)
    if (before_return_type == "Colon") {
        type_start = cursor + 1
        parsed_type = ReadSignatureTypePrefix(tokens, type_start, last_index)?
        { parts, edges, root, consumed, work } = parsed_type
        parse_steps = ChargeFunctionHeaderWork(parse_steps, work, WindowToken(tokens, type_start, last_index))?
        has_return_type = true
        cursor = cursor + 1 + consumed
        { arena, root: return_type } = AppendFunctionHeaderType(parts, edges, root, WindowToken(tokens, cursor - 1, last_index), arena)?
    }
    before_body = WindowKind(tokens, cursor, last_index)
    if (before_body != "LBrace") {
        RejectAt(WindowToken(tokens, cursor, last_index), "unexpected_token", "expected '{'")?
    }
    if (has_return_type) { parameters = parameters.push(return_type) }
    return ok(FunctionHeader {
        name: function_name, arena: arena,
        children: parameters, body_open: cursor, work: parse_steps
    })
}

// A local function header travels through the same validated arena boundary
// as expressions. Its synthetic root is never published in the program AST.
fn PackFunctionHeader(arena: Arena, &children: [int], span: Span, origin: Token): ParseOutput! {
    nodes = arena.nodes
    edges = arena.edges
    CheckTypeArenaCapacity(nodes.len(), edges.len(), children.len(), origin)?
    first_edge = edges.len()
    index = 0
    while (index < children.len()) {
        child = children[index]
        edges = edges.push(child)
        index = index + 1
    }
    node = MakeExpressionNode("FunctionHeaderTransport", "", 0, span, first_edge, children.len())
    nodes = nodes.push(node)
    root = nodes.len()
    return ok(ParseOutput { arena: Arena { nodes: nodes, edges: edges }, root: root })
}

fn ReadLocalFunctionHeader(&tokens: [Token], first: int, header_start: int, last: int, work: int,
                           node_base: int, parent_statement_count: int, declared_type: int): LocalFunctionHeader! {
    anonymous_assignment = first != header_start
    header = ReadFunctionHeaderMode(tokens, header_start, last, work, anonymous_assignment)?
    origin = WindowToken(tokens, header_start, last)
    span = SpanMerge(SpanFromToken(origin.clone()), SpanFromToken(WindowToken(tokens, header.body_open, last)))
    children = header.children
    packed = PackFunctionHeader(header.arena, children, span, origin)?
    relocated: [int] = []
    for child in children {
        next = node_base + child
        relocated = relocated.push(next)
    }
    scope = LocalFunctionScope { children: relocated, parent_statement_count: parent_statement_count,
                                 function_start: header_start, declared_type: declared_type }
    name = header.name
    if (anonymous_assignment) {
        target = WindowToken(tokens, first, last)
        name = target.lexeme
    }
    return ok(LocalFunctionHeader { name: name, output: packed, scope: scope,
                                    body_open: header.body_open, work: header.work })
}
