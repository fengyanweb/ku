import { Token } from "../stage1/token.ku"
import { Span, SpanFromToken, SpanMerge } from "../stage2/span.ku"
import { Node, ParseOutput, ValidateParseOutput } from "../stage2/ast.ku"
import { SpanFromNode } from "./support.ku"
import { StatementLink, ControlFrame, NewControlFrame, NextBodyWork, ReadControlHeader, ReadCatchBinding, ReadTypeAt, ReadExpressionEnd, LocalAssignmentOperator, RejectBodyEof, RejectControlBody, RejectBodyNodeLimit, RejectBodyEdgeLimit, RejectBodyEdgeId, RejectNestedNodeId, RejectNestedRoot, RejectBodyWorkLimit, RejectStatementLink, RejectStatementNode, RejectStatementLength, ReadElsePhase, CheckStrayClause, RejectFinally, ExpectTryToken, RejectStatementLimit, RejectStatementDepth, RejectLetStatement, RejectDeclarationInitializer, RejectTrailingDeclaration, FinishFunctionBodyOutput, ValidateFunctionBodyWindow, SignatureTypeOutput } from "./body_support.ku"

// Read the remainder of one bounded ordinary-function window, starting at the
// first token after its opening brace. ValidateFunctionBodyWindow runs before
// any indexed read or callback. The returned ParseOutput is an internal
// transport tree: its final FunctionBodyTransport node joins the body
// statement forest so functions.ku's consumer-side ValidateParseOutput proves
// every NodeId/edge before relocating real nodes and discarding the root.
// That root's int_value carries the aggregate parser work count supplied by
// the caller. No transport node is part of the public Stage-3 AST.
fn ReadFunctionBody(input_tokens: [Token], body_start: int, token_base: int, initial_work: int, parse_expression: fn(int, int): ParseOutput!): ParseOutput! {
    tokens = ValidateFunctionBodyWindow(input_tokens, body_start, token_base, initial_work)?
    last_index = tokens.len() - 1
    body_open = tokens[body_start - 1].clone()

    arena_nodes: [Node] = []
    arena_edges: [int] = []
    parse_steps = initial_work
    statement_links: [StatementLink] = []
    control_frames: [ControlFrame] = []
    root_top = 0
    root_count = 0
    control_depth = 0
    frame_top = 0
    current = NewControlFrame("", "", 0, 0, 0)

    fn AddNode(kind: str, text: str, int_value: int, span: Span, children: [int], error_token: Token): int! {
        if (arena_nodes.len() >= 4096) {
            RejectBodyNodeLimit(error_token.clone())?
        }
        if (children.len() > 8192 - arena_edges.len()) {
            RejectBodyEdgeLimit(error_token.clone())?
        }
        first_edge = arena_edges.len()
        for child in children {
            if (child <= 0 || child > arena_nodes.len()) {
                RejectBodyEdgeId(error_token.clone())?
            }
            arena_edges = arena_edges.push(child)
        }
        node = Node {
            kind: kind,
            text: text,
            int_value: int_value,
            line: span.line,
            column: span.column,
            offset: span.offset,
            end_line: span.end_line,
            end_column: span.end_column,
            end_offset: span.end_offset,
            first_edge: first_edge,
            edge_count: arena_edges.len() - first_edge
        }
        arena_nodes = arena_nodes.push(node)
        return ok(arena_nodes.len())
    }

    fn AddArena(parsed: ParseOutput, origin: Token): int! {
        validated = ValidateParseOutput(parsed)?
        parsed_root = validated.root
        parsed_arena = validated.arena
        parsed_nodes = parsed_arena.nodes
        parsed_edges = parsed_arena.edges
        if (parsed_nodes.len() > 4096 - arena_nodes.len()) {
            RejectBodyNodeLimit(origin.clone())?
        }
        if (parsed_edges.len() > 8192 - arena_edges.len()) {
            RejectBodyEdgeLimit(origin.clone())?
        }
        node_base = arena_nodes.len()
        index = 0
        while (index < parsed_nodes.len()) {
            input = parsed_nodes[index].clone()
            first_edge = arena_edges.len()
            edge_index = 0
            while (edge_index < input.edge_count) {
                child = parsed_edges[input.first_edge + edge_index]
                if (child <= 0 || child > parsed_nodes.len()) {
                    RejectNestedNodeId(origin.clone())?
                }
                arena_edges = arena_edges.push(node_base + child)
                edge_index = edge_index + 1
            }
            relocated = Node {
                kind: input.kind,
                text: input.text,
                int_value: input.int_value,
                line: input.line,
                column: input.column,
                offset: input.offset,
                end_line: input.end_line,
                end_column: input.end_column,
                end_offset: input.end_offset,
                first_edge: first_edge,
                edge_count: arena_edges.len() - first_edge
            }
            arena_nodes = arena_nodes.push(relocated)
            index = index + 1
        }
        if (parsed_root <= 0 || parsed_root > parsed_nodes.len()) {
            RejectNestedRoot(origin)?
        }
        return ok(node_base + parsed_root)
    }
    fn AppendStatementList(children: [int], top: int, count: int, error_token: Token): [int]! {
        output: [int] = children
        reversed: [int] = []
        walk = top
        remaining = count
        while (remaining > 0) {
            // Keep this increment inline. Calling the sibling local
            // ChargeWork closure from this captured helper would make their
            // environments retain each other in native lowering.
            parse_steps = parse_steps + 1
            if (parse_steps > 16384) {
                RejectBodyWorkLimit(error_token.clone())?
            }
            if (walk <= 0 || walk > statement_links.len()) {
                RejectStatementLink(error_token.clone())?
            }
            entry = statement_links[walk - 1].clone()
            if (entry.node <= 0 || entry.node > arena_nodes.len()) {
                RejectStatementNode(error_token.clone())?
            }
            reversed = reversed.push(entry.node)
            walk = entry.previous
            remaining = remaining - 1
        }
        if (walk != 0) { RejectStatementLength(error_token.clone())? }
        reverse_index = reversed.len()
        while (reverse_index > 0) {
            reverse_index = reverse_index - 1
            output = output.push(reversed[reverse_index])
        }
        return ok(output)
    }

    fn RecordStatement(statement: int): null! {
        previous = root_top
        if (control_depth > 0) {
            previous = current.body_top
            if (current.phase != 0) { previous = current.else_top }
        }
        link = StatementLink { node: statement, previous: previous }
        statement_links = statement_links.push(link)
        new_top = statement_links.len()
        if (control_depth == 0) {
            root_top = new_top
            root_count = root_count + 1
        } else if (current.phase == 0) {
            current.body_top = new_top
            current.body_count = current.body_count + 1
        } else {
            current.else_top = new_top
            current.else_count = current.else_count + 1
        }
        return ok(null)
    }

    cursor = body_start
    statement_count = 0
    reading_body = true
    function_end = body_open.clone()
    while (reading_body) {
        parse_steps = NextBodyWork(parse_steps, 1, tokens[cursor].clone())?
        if (tokens[cursor].kind == "Eof") {
            RejectBodyEof(control_depth, current.kind.clone(), current.phase, tokens[cursor].clone())?
        }
        if (tokens[cursor].kind == "RBrace") {
            block_end = tokens[cursor].clone()
            cursor = cursor + 1
            if (control_depth == 0) {
                function_end = block_end
                reading_body = false
            } else if (current.kind == "If" && current.phase == 0 && tokens[cursor].kind == "Else") {
                cursor = cursor + 1
                // Phase 2 leaves the nested If for the next iteration.
                current.phase = ReadElsePhase(tokens[cursor])?
                if (current.phase == 1) { cursor = cursor + 1 }
            } else if (current.kind == "Try" && current.phase == 0) {
                binding = ReadCatchBinding(tokens, cursor)?
                parse_steps = NextBodyWork(parse_steps, 5, tokens[cursor].clone())?
                try_open = tokens[current.start + 1].clone()
                body_children = AppendStatementList([], current.body_top, current.body_count, try_open.clone())?
                current.condition = AddNode("TryBody", "", 0, SpanMerge(SpanFromToken(try_open.clone()), SpanFromToken(block_end)), body_children, try_open)?
                current.catch_start = cursor
                current.catch_binding = AddNode("CatchBinding", binding.lexeme.clone(), 0, SpanFromToken(binding.clone()), [], binding)?
                current.phase = 1
                cursor = cursor + 5
            } else {
                allow_semicolon = current.kind != "Try"
                closing_frames = true
                while (closing_frames) {
                    control_start = tokens[current.start].clone()
                    control_children: [int] = [current.condition]
                    control_value = 0
                    if (current.kind == "Try") {
                        RejectFinally(tokens[cursor])?
                        catch_start = tokens[current.catch_start].clone()
                        catch_open = tokens[current.catch_start + 4].clone()
                        catch_children = AppendStatementList([], current.else_top, current.else_count, catch_open.clone())?
                        catch_body = AddNode("CatchBody", "", 0, SpanMerge(SpanFromToken(catch_open.clone()), SpanFromToken(block_end.clone())), catch_children, catch_open)?
                        catch_clause = AddNode("Catch", "", 0, SpanMerge(SpanFromToken(catch_start.clone()), SpanFromToken(block_end.clone())), [current.catch_binding, catch_body], catch_start)?
                        control_children = control_children.push(catch_clause)
                    } else {
                        control_children = AppendStatementList(control_children, current.body_top, current.body_count, control_start.clone())?
                        if (current.kind == "If") {
                            control_value = current.body_count
                            control_children = AppendStatementList(control_children, current.else_top, current.else_count, control_start.clone())?
                        }
                    }
                    statement = AddNode(current.kind.clone(), current.binding.clone(), control_value, SpanMerge(SpanFromToken(control_start.clone()), SpanFromToken(block_end.clone())), control_children, control_start)?
                    control_depth = control_depth - 1
                    if (control_depth > 0) {
                        // Every nested open appends exactly one parent frame.
                        frame = control_frames[frame_top - 1].clone()
                        frame_top = frame.previous
                        current = frame
                    }
                    RecordStatement(statement)?
                    // A completed nested If is the whole else arm. It and
                    // the parents waiting for it share the same end token.
                    closing_frames = control_depth > 0 && current.phase == 2
                    if (closing_frames) {
                        parse_steps = NextBodyWork(parse_steps, 1, block_end.clone())?
                    }
                }
                if (allow_semicolon && tokens[cursor].kind == "Semicolon") { cursor = cursor + 1 }
            }
        } else {
            CheckStrayClause(tokens[cursor])?
            if (statement_count >= 128) {
                RejectStatementLimit(tokens[cursor].clone())?
            }
            statement_start_index = cursor
            statement_start = tokens[statement_start_index].clone()
            statement_count = statement_count + 1
            control_kind = statement_start.kind.clone()
            if (control_kind == "If" || control_kind == "While" || control_kind == "For" || control_kind == "Try") {
                if (control_depth >= 32) {
                    RejectStatementDepth(statement_start.clone())?
                }
                condition = 0
                binding = ""
                if (control_kind == "Try") {
                    cursor = cursor + 1
                    ExpectTryToken(tokens[cursor], "LBrace", "expected '{' before try body")?
                    parse_steps = NextBodyWork(parse_steps, 1, statement_start.clone())?
                } else {
                    header = ReadControlHeader(tokens, statement_start_index, parse_steps)?
                    parse_steps = header.work
                    condition_origin = tokens[header.expression_start].clone()
                    condition_parsed = parse_expression(token_base + header.expression_start, token_base + header.expression_end)?
                    condition = AddArena(condition_parsed, condition_origin)?
                    binding = header.binding
                    cursor = header.body_open
                    if (tokens[cursor].kind != "LBrace") {
                        RejectControlBody(control_kind == "While", tokens[cursor].clone())?
                    }
                }
                if (control_depth > 0) {
                    parent_frame = current.clone()
                    control_frames = control_frames.push(parent_frame)
                    frame_top = control_frames.len()
                }
                current = NewControlFrame(control_kind, binding, statement_start_index, condition, frame_top)
                control_depth = control_depth + 1
                cursor = cursor + 1
            } else {
                statement = 0
                assignment_operator = ""
                if (statement_start.kind == "Ident") { assignment_operator = LocalAssignmentOperator(tokens[cursor + 1]) }
                if (statement_start.kind == "Let") {
                    RejectLetStatement(statement_start)?
                } else if (statement_start.kind == "Return" || statement_start.kind == "Fail") {
                    kind = statement_start.kind.clone()
                    requires_value = kind == "Fail"
                    cursor = cursor + 1
                    children: [int] = []
                    end_span = SpanFromToken(statement_start.clone())
                    if (!requires_value && tokens[cursor].kind == "Semicolon") {
                        end_span = SpanFromToken(tokens[cursor].clone())
                        cursor = cursor + 1
                    } else if (requires_value || tokens[cursor].kind != "RBrace") {
                        expression_end = ReadExpressionEnd(tokens, cursor, false)?
                        value_origin = tokens[cursor].clone()
                        value_parsed = parse_expression(token_base + cursor, token_base + expression_end)?
                        expression = AddArena(value_parsed, value_origin)?
                        children = children.push(expression)
                        expression_node = arena_nodes[expression - 1].clone()
                        end_span = SpanFromNode(expression_node)
                        cursor = expression_end
                        if (tokens[cursor].kind == "Semicolon") { cursor = cursor + 1 }
                    }
                    statement = AddNode(kind, "", 0, SpanMerge(SpanFromToken(statement_start.clone()), end_span), children, statement_start.clone())?
                } else if (statement_start.kind == "Ident" && tokens[cursor + 1].kind == "Colon") {
                    name = statement_start.lexeme.clone()
                    cursor = cursor + 2
                    parsed_type = ReadTypeAt(tokens, cursor, tokens[last_index])?
                    parse_steps = NextBodyWork(parse_steps, parsed_type.work, tokens[cursor].clone())?
                    type_consumed = parsed_type.consumed
                    type_output = SignatureTypeOutput(parsed_type, tokens[cursor].clone())?
                    type_node = AddArena(type_output, tokens[cursor].clone())?
                    cursor = cursor + type_consumed
                    if (tokens[cursor].kind != "Equal") {
                        RejectDeclarationInitializer(tokens[cursor].clone())?
                    }
                    cursor = cursor + 1
                    expression_end = ReadExpressionEnd(tokens, cursor, false)?
                    declaration_origin = tokens[cursor].clone()
                    declaration_parsed = parse_expression(token_base + cursor, token_base + expression_end)?
                    expression = AddArena(declaration_parsed, declaration_origin)?
                    expression_node = arena_nodes[expression - 1].clone()
                    statement = AddNode("VarDecl", name, 0, SpanMerge(SpanFromToken(statement_start.clone()), SpanFromNode(expression_node)), [type_node, expression], statement_start.clone())?
                    cursor = expression_end
                    if (tokens[cursor].kind == "Semicolon") { cursor = cursor + 1 }
                } else if (assignment_operator != "") {
                    name = statement_start.lexeme.clone()
                    target = 0
                    if (assignment_operator != "=") {
                        target = AddNode("Variable", name.clone(), 0, SpanFromToken(statement_start.clone()), [], statement_start.clone())?
                    }
                    cursor = cursor + 2
                    expression_end = ReadExpressionEnd(tokens, cursor, false)?
                    assignment_origin = tokens[cursor].clone()
                    assignment_parsed = parse_expression(token_base + cursor, token_base + expression_end)?
                    expression = AddArena(assignment_parsed, assignment_origin)?
                    expression_node = arena_nodes[expression - 1].clone()
                    statement_span = SpanMerge(SpanFromToken(statement_start.clone()), SpanFromNode(expression_node))
                    if (assignment_operator == "=") {
                        statement = AddNode("Assign", name, 0, statement_span, [expression], statement_start.clone())?
                    } else {
                        statement = AddNode("CompoundAssign", assignment_operator, 0, statement_span, [target, expression], statement_start.clone())?
                    }
                    cursor = expression_end
                    if (tokens[cursor].kind == "Semicolon") { cursor = cursor + 1 }
                } else {
                    expression_end = ReadExpressionEnd(tokens, cursor, false)?
                    statement_origin = tokens[cursor].clone()
                    statement_parsed = parse_expression(token_base + cursor, token_base + expression_end)?
                    expression = AddArena(statement_parsed, statement_origin)?
                    expression_node = arena_nodes[expression - 1].clone()
                    statement = AddNode("ExprStmt", "", 0, SpanFromNode(expression_node), [expression], statement_start.clone())?
                    cursor = expression_end
                    if (tokens[cursor].kind == "Semicolon") { cursor = cursor + 1 }
                }
                RecordStatement(statement)?
            }
        }
    }
    if (cursor != last_index) {
        RejectTrailingDeclaration(tokens[cursor].clone())?
    }
    statements = AppendStatementList([], root_top, root_count, body_open.clone())?
    return FinishFunctionBodyOutput(arena_nodes.clone(), arena_edges.clone(), parse_steps, body_open, function_end, statements)
}
