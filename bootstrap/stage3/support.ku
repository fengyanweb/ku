import { Token } from "../stage1/token.ku"
import { Span, SpanFromToken } from "../stage2/span.ku"
import { MakeDiagnostic, DiagnosticCanonical } from "../stage2/diagnostic.ku"
import { Node, ParseOutput } from "../stage2/ast.ku"
import { ParseWithContext } from "../stage2/parser.ku"
import { ParseContext } from "../stage2/context.ku"

struct SourceMap {
    source: str
    characters: [str]
    starts: [int]
    ends: [int]
}

fn SpanFromNode(node: Node): Span {
    return Span {
        line: node.line,
        column: node.column,
        offset: node.offset,
        end_line: node.end_line,
        end_column: node.end_column,
        end_offset: node.end_offset
    }
}

// Pure Stage 3 helpers live outside parser.ku so each self-hosted source file
// remains below Stage 1's fixed per-file token ceiling.
fn RejectAt(token: Token, code: str, message: str): null! {
    diagnostic = MakeDiagnostic("error", "bootstrap.parser.stage3", code.clone(), message, "<source>", SpanFromToken(token))
    canonical = DiagnosticCanonical(diagnostic)
    fail { domain: "bootstrap.parser.stage3", code: code, message: canonical }
}

fn RejectAtPoint(code: str, message: str): null! {
    point = Token { kind: "Eof", lexeme: "", int_value: 0, line: 1, column: 1, offset: 0, end_line: 1, end_column: 1, end_offset: 0 }
    RejectAt(point, code, message)?
    return ok(null)
}

fn ParseExpressionAt(source: str, origin: Token, boundary: Token): ParseOutput! {
    return ok(ParseWithContext(source, ParseContext {
        diagnostic_domain: "bootstrap.parser.stage3",
        origin: SpanFromToken(origin),
        boundary: SpanFromToken(boundary),
        has_boundary: true
    })?)
}

fn CanEndExpression(kind: str): bool {
    return kind == "Ident" || kind == "Int" || kind == "Float" || kind == "String" || kind == "TemplateString" || kind == "True" || kind == "False" || kind == "Null" || kind == "RParen" || kind == "RBracket" || kind == "Question"
}

fn CanStartStatement(kind: str): bool {
    return kind == "Ident" || kind == "Int" || kind == "Float" || kind == "String" || kind == "TemplateString" || kind == "True" || kind == "False" || kind == "Null" || kind == "Bang" || kind == "Return" || kind == "Let" || kind == "If" || kind == "While" || kind == "For" || kind == "Break" || kind == "Continue" || kind == "Try" || kind == "Async" || kind == "Fn" || kind == "Fail" || kind == "Panic" || kind == "Print"
}

struct ExpressionBoundary {
    paren_depth: int
    bracket_depth: int
    steps: int
    complete: bool
}

fn EmptyExpressionBoundary(): ExpressionBoundary {
    return ExpressionBoundary { paren_depth: 0, bracket_depth: 0, steps: 0, complete: false }
}

fn PushExpressionBoundary(state: ExpressionBoundary, token: Token, previous_can_end: bool): ExpressionBoundary! {
    complete = state.paren_depth == 0 && state.bracket_depth == 0 && ((token.kind == "Semicolon" || token.kind == "RBrace" || token.kind == "Eof") || (previous_can_end && CanStartStatement(token.kind.clone())))
    paren_depth = state.paren_depth
    bracket_depth = state.bracket_depth
    if (!complete) {
        if (token.kind == "LParen") { paren_depth = paren_depth + 1 }
        else if (token.kind == "RParen" && paren_depth > 0) { paren_depth = paren_depth - 1 }
        if (token.kind == "LBracket") { bracket_depth = bracket_depth + 1 }
        else if (token.kind == "RBracket" && bracket_depth > 0) { bracket_depth = bracket_depth - 1 }
        if (token.kind == "LBrace") { RejectAt(token.clone(), "unsupported_expression", "brace expressions are outside the stage-3 subset")? }
    }
    steps = state.steps + 1
    if (steps > 4096) { RejectAt(token, "work_limit", "stage-3 expression boundary budget exceeded")? }
    return ok(ExpressionBoundary { paren_depth: paren_depth, bracket_depth: bracket_depth, steps: steps, complete: complete })
}

fn MapTokenCharacters(source: str, tokens: [Token]): SourceMap! {
    // Match the source and token bounds enforced by Scan + ParseProgram even
    // when this helper is imported directly. The byte check is the cheap
    // UTF-8 prefilter; source.len() is bounded by it and does not materialize
    // the character array. Do all guards before source.chars() or the mapping
    // loop's first token clone.
    if (source.byte_len() > 131072) {
        RejectAtPoint("work_limit", "stage-3 token mapping budget exceeded")?
    }
    if (source.len() > 32768) {
        RejectAtPoint("work_limit", "stage-3 token mapping budget exceeded")?
    }
    if (tokens.len() > 512) {
        RejectAt(tokens[0].clone(), "invalid_token_stream", "stage-3 parser accepts at most 512 tokens")?
    }
    characters: [str] = source.chars()
    starts: [int] = []
    ends: [int] = []
    char_index = 0
    byte_offset = 0
    token_index = 0
    map_steps = 0
    while (token_index < tokens.len()) {
        token = tokens[token_index].clone()
        while (byte_offset < token.offset) {
            if (char_index >= characters.len()) {
                RejectAt(token.clone(), "invalid_token_span", "token start lies outside source")?
            }
            byte_offset = byte_offset + characters[char_index].byte_len()
            char_index = char_index + 1
            map_steps = map_steps + 1
            if (map_steps > 36864) {
                RejectAt(token.clone(), "work_limit", "stage-3 token mapping budget exceeded")?
            }
        }
        if (byte_offset != token.offset) {
            RejectAt(token.clone(), "invalid_token_span", "token start splits a UTF-8 scalar")?
        }
        starts = starts.push(char_index)
        while (byte_offset < token.end_offset) {
            if (char_index >= characters.len()) {
                RejectAt(token.clone(), "invalid_token_span", "token end lies outside source")?
            }
            byte_offset = byte_offset + characters[char_index].byte_len()
            char_index = char_index + 1
            map_steps = map_steps + 1
            if (map_steps > 36864) {
                RejectAt(token.clone(), "work_limit", "stage-3 token mapping budget exceeded")?
            }
        }
        if (byte_offset != token.end_offset) {
            RejectAt(token.clone(), "invalid_token_span", "token end splits a UTF-8 scalar")?
        }
        ends = ends.push(char_index)
        token_index = token_index + 1
    }
    return ok(SourceMap { source: source, characters: characters, starts: starts, ends: ends })
}
