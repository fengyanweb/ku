import { Token } from "../stage1/token.ku"
import { Span, SpanFromToken, SpanMerge } from "../stage2/span.ku"
import { MakeDiagnostic, DiagnosticCanonical } from "../stage2/diagnostic.ku"
import { Arena, Node, ParseOutput } from "../stage2/ast.ku"
import { ParseWithContext } from "../stage2/parser.ku"
import { ParseContext } from "../stage2/context.ku"

struct SourceMap {
    source: str
    characters: [str]
    starts: [int]
    ends: [int]
}

// Read from an admitted scanner interval without copying it. Its exclusive
// end acts as EOF, even when another declaration follows in the source.
fn WindowToken(&tokens: [Token], index: int, end: int): Token {
    if (index < end) { return tokens[index].clone() }
    boundary = tokens[end].clone()
    boundary.kind = "Eof"
    boundary.lexeme = ""
    boundary.int_value = 0
    return boundary
}

fn WindowKind(&tokens: [Token], index: int, end: int): str {
    if (index >= end) { return "Eof" }
    return tokens[index].kind.clone()
}

fn AfterOptionalSemicolon(&tokens: [Token], index: int, end: int): int {
    if (WindowKind(tokens, index, end) == "Semicolon") { return index + 1 }
    return index
}

fn SpanFromNode(node: Node): Span {
    return Span {
        line: node.line,
        column: node.column,
        offset: node.offset,
        end_line: node.end_line,
        end_column: node.end_column,
        end_offset: node.end_offset
    }
}

// Pure Stage 3 helpers live outside parser.ku so each self-hosted source file
// remains below Stage 1's fixed per-file token ceiling.
fn RejectAt(token: Token, code: str, message: str): null! {
    return RejectAtSpan(SpanFromToken(token), code, message)
}

fn RejectAtSpan(span: Span, code: str, message: str): null! {
    diagnostic = MakeDiagnostic("error", "bootstrap.parser.stage3", code.clone(), message, "<source>", span)
    canonical = DiagnosticCanonical(diagnostic)
    fail { domain: "bootstrap.parser.stage3", code: code, message: canonical }
}

fn RejectAtPoint(code: str, message: str): null! {
    point = Token { kind: "Eof", lexeme: "", int_value: 0, line: 1, column: 1, offset: 0, end_line: 1, end_column: 1, end_offset: 0 }
    RejectAt(point, code, message)?
    return ok(null)
}

fn ParseExpressionAt(source: str, origin: Token, boundary: Token): ParseOutput! {
    return ok(ParseWithContext(source, ParseContext {
        diagnostic_domain: "bootstrap.parser.stage3",
        origin: SpanFromToken(origin),
        boundary: SpanFromToken(boundary),
        has_boundary: true
    })?)
}

fn CanEndExpression(kind: str): bool {
    return kind == "Ident" || kind == "Int" || kind == "Float" || kind == "String" || kind == "TemplateString" || kind == "True" || kind == "False" || kind == "Null" || kind == "RParen" || kind == "RBracket" || kind == "RBrace" || kind == "Question"
}

fn CanStartStatement(kind: str): bool {
    return kind == "Ident" || kind == "Int" || kind == "Float" || kind == "String" || kind == "TemplateString" || kind == "True" || kind == "False" || kind == "Null" || kind == "Bang" || kind == "Return" || kind == "Let" || kind == "If" || kind == "While" || kind == "For" || kind == "Break" || kind == "Continue" || kind == "Try" || kind == "Async" || kind == "Fn" || kind == "Fail" || kind == "Panic" || kind == "Print" || kind == "Await"
}

// Like Stage0, select an object pattern only when the outer delimiter
// closes immediately before an assignment. Parsing the pattern itself
// diagnoses the spelling and type of each delimiter.
fn ObjectDestructureClose(&tokens: [Token], first: int, window_end: int): int {
    if (WindowKind(tokens, first, window_end) != "LBrace") { return 0 }
    cursor = first
    depth = 0
    while (cursor < window_end) {
        kind = WindowKind(tokens, cursor, window_end)
        if (kind == "LBrace" || kind == "LParen" || kind == "LBracket") {
            depth = depth + 1
        } else if (kind == "RBrace" || kind == "RParen" || kind == "RBracket") {
            depth = depth - 1
            if (depth == 0) {
                if (WindowKind(tokens, cursor + 1, window_end) == "Equal") { return cursor }
                return 0
            }
        } else if (kind == "Eof") {
            return 0
        }
        cursor = cursor + 1
    }
    return 0
}

fn EndsAtExpressionSeparator(&tokens: [Token], cursor: int, window_end: int, &context: str, &kind: str,
                           previous_can_end: bool, named_struct_open: bool): bool {
    if (context == "print_argument") { return kind == "RParen" || kind == "Comma" }
    if (context == "destructure_default") { return kind == "Comma" || kind == "RBrace" }
    inline_if = context == "inline_if_value" || context == "inline_if_target"
    if (inline_if && kind == "Else") { return true }
    return (context == "value" || context == "assignment_target" || inline_if) && previous_can_end &&
        kind == "LBrace" && !named_struct_open && ObjectDestructureClose(tokens, cursor, window_end) != 0
}

struct ExpressionBoundary {
    paren_depth: int
    bracket_depth: int
    brace_depth: int
    steps: int
    complete: bool
}

fn EmptyExpressionBoundary(): ExpressionBoundary {
    return ExpressionBoundary { paren_depth: 0, bracket_depth: 0, brace_depth: 0, steps: 0, complete: false }
}

fn PushExpressionBoundary(state: ExpressionBoundary, token: Token, previous_can_end: bool, named_struct_open: bool): ExpressionBoundary! {
    complete = state.paren_depth == 0 && state.bracket_depth == 0 && state.brace_depth == 0 && ((token.kind == "Semicolon" || token.kind == "RBrace" || token.kind == "Eof") || (previous_can_end && CanStartStatement(token.kind.clone())))
    paren_depth = state.paren_depth
    bracket_depth = state.bracket_depth
    brace_depth = state.brace_depth
    if (!complete) {
        if (token.kind == "LParen") { paren_depth = paren_depth + 1 }
        else if (token.kind == "RParen" && paren_depth > 0) { paren_depth = paren_depth - 1 }
        if (token.kind == "LBracket") { bracket_depth = bracket_depth + 1 }
        else if (token.kind == "RBracket" && bracket_depth > 0) { bracket_depth = bracket_depth - 1 }
        if (token.kind == "LBrace") {
            // An operand can start with an anonymous object. A brace after
            // a complete value still needs the named-struct lookahead.
            if (!named_struct_open && previous_can_end) { RejectAt(token.clone(), "unsupported_expression", "brace expressions are outside the stage-3 subset")? }
            brace_depth = brace_depth + 1
        } else if (token.kind == "RBrace" && brace_depth > 0) { brace_depth = brace_depth - 1 }
    }
    steps = state.steps + 1
    if (steps > 4096) { RejectAt(token, "work_limit", "stage-3 expression boundary budget exceeded")? }
    return ok(ExpressionBoundary { paren_depth: paren_depth, bracket_depth: bracket_depth, brace_depth: brace_depth, steps: steps, complete: complete })
}

fn MapTokenCharacters(source: str, tokens: [Token]): SourceMap! {
    // Match the source and token bounds enforced by Scan + ParseProgram even
    // when this helper is imported directly. The byte check is the cheap
    // UTF-8 prefilter; source.len() is bounded by it and does not materialize
    // the character array. Do all guards before source.chars() or the mapping
    // loop's first token clone.
    if (source.byte_len() > 131072) {
        RejectAtPoint("work_limit", "stage-3 token mapping budget exceeded")?
    }
    if (source.len() > 32768) {
        RejectAtPoint("work_limit", "stage-3 token mapping budget exceeded")?
    }
    if (tokens.len() > 512) {
        RejectAt(tokens[0].clone(), "invalid_token_stream", "stage-3 parser accepts at most 512 tokens")?
    }
    characters: [str] = source.chars()
    starts: [int] = []
    ends: [int] = []
    char_index = 0
    byte_offset = 0
    token_index = 0
    map_steps = 0
    while (token_index < tokens.len()) {
        token = tokens[token_index].clone()
        while (byte_offset < token.offset) {
            if (char_index >= characters.len()) {
                RejectAt(token.clone(), "invalid_token_span", "token start lies outside source")?
            }
            byte_offset = byte_offset + characters[char_index].byte_len()
            char_index = char_index + 1
            map_steps = map_steps + 1
            if (map_steps > 36864) {
                RejectAt(token.clone(), "work_limit", "stage-3 token mapping budget exceeded")?
            }
        }
        if (byte_offset != token.offset) {
            RejectAt(token.clone(), "invalid_token_span", "token start splits a UTF-8 scalar")?
        }
        starts = starts.push(char_index)
        while (byte_offset < token.end_offset) {
            if (char_index >= characters.len()) {
                RejectAt(token.clone(), "invalid_token_span", "token end lies outside source")?
            }
            byte_offset = byte_offset + characters[char_index].byte_len()
            char_index = char_index + 1
            map_steps = map_steps + 1
            if (map_steps > 36864) {
                RejectAt(token.clone(), "work_limit", "stage-3 token mapping budget exceeded")?
            }
        }
        if (byte_offset != token.end_offset) {
            RejectAt(token.clone(), "invalid_token_span", "token end splits a UTF-8 scalar")?
        }
        ends = ends.push(char_index)
        token_index = token_index + 1
    }
    return ok(SourceMap { source: source, characters: characters, starts: starts, ends: ends })
}

fn CheckFunctionBodySpan(&tokens: [Token], body_start: int, last_index: int, token_base: int, initial_work: int): null! {
    if (tokens.len() > 4096 || body_start < 1 || body_start > last_index || last_index >= tokens.len()
        || token_base < 0 || token_base > 4096 - tokens.len() || initial_work < 0 || initial_work > 16384
        || tokens[tokens.len() - 1].kind != "Eof" || tokens[body_start - 1].kind != "LBrace") {
        RejectAtPoint("invalid_token_stream", "function body interval lies outside the scanner window")?
    }
    return ok(null)
}

struct Stage3ArenaAppend {
    arena: Arena
    root: int
}

// Take the arena only after the original node arguments have been evaluated.
// Callers propagate every Error, so both owners can be released on failure.
fn AppendStage3Node(kind: str, text: str, int_value: int, span: Span, children: [int], error_token: Token, arena: Arena): Stage3ArenaAppend! {
    { nodes: arena_nodes, edges: arena_edges } = arena
    if (arena_nodes.len() >= 4096) {
        RejectAt(error_token.clone(), "node_limit", "stage-3 parser accepts at most 4096 AST nodes")?
    }
    if (children.len() > 8192 - arena_edges.len()) {
        RejectAt(error_token.clone(), "edge_limit", "stage-3 parser accepts at most 8192 AST edges")?
    }
    first_edge = arena_edges.len()
    for child in children {
        if (child <= 0 || child > arena_nodes.len()) {
            RejectAt(error_token.clone(), "invalid_node_id", "AST edge references an invalid NodeId")?
        }
        arena_edges = arena_edges.push(child)
    }
    node = Node {
        kind: kind,
        text: text,
        int_value: int_value,
        line: span.line,
        column: span.column,
        offset: span.offset,
        end_line: span.end_line,
        end_column: span.end_column,
        end_offset: span.end_offset,
        first_edge: first_edge,
        edge_count: arena_edges.len() - first_edge
    }
    arena_nodes = arena_nodes.push(node)
    root = arena_nodes.len()
    return ok(Stage3ArenaAppend { arena: Arena { nodes: arena_nodes, edges: arena_edges }, root: root })
}

fn AppendStage3Arena(parsed: ParseOutput, origin: Token, arena: Arena): Stage3ArenaAppend! {
    { root: parsed_root, arena: parsed_arena } = parsed
    { nodes: parsed_nodes, edges: parsed_edges } = parsed_arena
    { nodes: arena_nodes, edges: arena_edges } = arena
    if (parsed_nodes.len() > 4096 - arena_nodes.len()) {
        RejectAt(origin.clone(), "node_limit", "stage-3 parser accepts at most 4096 AST nodes")?
    }
    if (parsed_edges.len() > 8192 - arena_edges.len()) {
        RejectAt(origin.clone(), "edge_limit", "stage-3 parser accepts at most 8192 AST edges")?
    }
    node_base = arena_nodes.len()
    index = 0
    while (index < parsed_nodes.len()) {
        input = parsed_nodes[index].clone()
        first_edge = arena_edges.len()
        edge_index = 0
        while (edge_index < input.edge_count) {
            child = parsed_edges[input.first_edge + edge_index]
            if (child <= 0 || child > parsed_nodes.len()) {
                RejectAt(origin.clone(), "invalid_node_id", "nested AST contains an invalid NodeId")?
            }
            arena_edges = arena_edges.push(node_base + child)
            edge_index = edge_index + 1
        }
        relocated = Node {
            kind: input.kind,
            text: input.text,
            int_value: input.int_value,
            line: input.line,
            column: input.column,
            offset: input.offset,
            end_line: input.end_line,
            end_column: input.end_column,
            end_offset: input.end_offset,
            first_edge: first_edge,
            edge_count: arena_edges.len() - first_edge
        }
        arena_nodes = arena_nodes.push(relocated)
        index = index + 1
    }
    if (parsed_root <= 0 || parsed_root > parsed_nodes.len()) {
        RejectAt(origin, "invalid_node_id", "nested AST root is invalid")?
    }
    root = node_base + parsed_root
    return ok(Stage3ArenaAppend { arena: Arena { nodes: arena_nodes, edges: arena_edges }, root: root })
}

fn ReadStage3ProgramSpan(&nodes: [Node], &items: [int]): Span {
    first = nodes[items[0] - 1].clone()
    last = nodes[items[items.len() - 1] - 1].clone()
    return SpanMerge(SpanFromNode(first), SpanFromNode(last))
}
