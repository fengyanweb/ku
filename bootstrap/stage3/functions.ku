import { Token } from "../stage1/token.ku"
import { Span, SpanFromToken, SpanMerge } from "../stage2/span.ku"
import { Node, Arena, ParseOutput, ValidateParseOutput } from "../stage2/ast.ku"
import { RejectAt, RejectAtPoint, SpanFromNode, WindowToken } from "./support.ku"
import { ReadFunctionHeader } from "./function_header.ku"
import { DeclarationRead } from "./structs.ku"
import { ReadFunctionBodySpan } from "./statements.ku"

// Find the exclusive end of one module-level function, including its
// nested blocks. An unfinished declaration stops at the scanner EOF.
fn ModuleFunctionEnd(&tokens: [Token], first: int, &eof: Token): int! {
    window_limit = tokens.len()
    function_depth = 0
    seen_body = false
    window_cursor = first
    while (window_cursor < window_limit) {
        kind = tokens[window_cursor].kind.clone()
        if (kind == "Eof") { return ok(window_cursor) }
        if (kind == "LBrace") {
            seen_body = true
            function_depth = function_depth + 1
        } else if (seen_body && kind == "RBrace") {
            function_depth = function_depth - 1
            if (function_depth == 0) { return ok(window_cursor + 1) }
        }
        window_cursor = window_cursor + 1
    }
    RejectAt(eof.clone(), "invalid_token_stream", "function inspection escaped the token stream")?
    return ok(window_cursor)
}

// Read one named function declaration followed by exactly one EOF sentinel.
// A shared signature reader builds the header; statements.ku owns the function-body
// state machine and returns an internal synthetic transport tree. The original
// token window stays owned by the reader while its body borrows that interval.
// AttachFunctionBody validates the transport at its consumer boundary before
// reading metadata; expression/type outputs are likewise validated by their
// immediate consumers before relocation. Calls remain synchronous and
// non-transactional, so bootstrap callers supply only the deterministic parser
// callback rather than an effectful application callback.
fn ReadFunction(input_tokens: [Token], token_base: int, parse_expression: fn(int, int): ParseOutput!): DeclarationRead! {
    tokens: [Token] = input_tokens
    if (tokens.len() > 512) {
        RejectAtPoint("invalid_token_stream", "function window accepts at most 512 tokens")?
    }
    if (tokens.len() == 0) {
        RejectAtPoint("invalid_token_stream", "function window must start with fn and end with EOF")?
    }
    if (token_base < 0 || token_base > 512 - tokens.len()) {
        RejectAtPoint("invalid_token_stream", "function token base lies outside stage-3 token bounds")?
    }
    last_index = tokens.len() - 1
    last = tokens[last_index].clone()
    if (last.kind != "Eof" || (tokens[0].kind != "Fn" && tokens[0].kind != "Async")) {
        RejectAt(tokens[0].clone(), "invalid_token_stream", "function window must start with fn and end with EOF")?
    }
    validation_index = 0
    while (validation_index < last_index) {
        if (tokens[validation_index].kind == "Eof") {
            RejectAt(tokens[validation_index].clone(), "invalid_token_stream", "EOF must be final in function window")?
        }
        validation_index = validation_index + 1
    }

    return ReadFunctionSpan(tokens, 0, last_index, token_base, parse_expression)
}

// Compiler entry for an interval of the Stage-1 admitted module. No token
// slice is constructed; last_index is an exclusive boundary acting as EOF.
fn ReadCompilerFunction(&tokens: [Token], first: int, last_index: int, parse_expression: fn(int, int): ParseOutput!): DeclarationRead! {
    if (tokens.len() > 4096 || first < 0 || first >= last_index || last_index >= tokens.len()) {
        RejectAtPoint("invalid_token_stream", "compiler function interval lies outside the scanner window")?
    }
    if ((tokens[first].kind != "Fn" && tokens[first].kind != "Async") || tokens[tokens.len() - 1].kind != "Eof") {
        RejectAt(tokens[first].clone(), "invalid_token_stream", "compiler function interval must start with fn in a scanner window ending at EOF")?
    }
    index = first
    while (index < last_index) {
        if (tokens[index].kind == "Eof") {
            RejectAt(tokens[index].clone(), "invalid_token_stream", "EOF must be final in function window")?
        }
        index = index + 1
    }
    return ReadFunctionSpan(tokens, first, last_index, 0, parse_expression)
}

fn ReadFunctionSpan(&tokens: [Token], first: int, last_index: int, token_base: int, parse_expression: fn(int, int): ParseOutput!): DeclarationRead! {
    function_start = WindowToken(tokens, first, last_index)
    header = ReadFunctionHeader(tokens, first, last_index, 0)?
    header_arena = header.arena
    arena_nodes = header_arena.nodes
    arena_edges = header_arena.edges
    parse_steps = header.work
    body_work = 0
    body_span = SpanFromToken(WindowToken(tokens, last_index, last_index))
    body_statements: [int] = []

    fn AddNode(kind: str, text: str, int_value: int, span: Span, children: [int], error_token: Token): int! {
        if (arena_nodes.len() >= 4096) {
            RejectAt(error_token.clone(), "node_limit", "stage-3 parser accepts at most 4096 AST nodes")?
        }
        if (children.len() > 8192 - arena_edges.len()) {
            RejectAt(error_token.clone(), "edge_limit", "stage-3 parser accepts at most 8192 AST edges")?
        }
        first_edge = arena_edges.len()
        for child in children {
            if (child <= 0 || child > arena_nodes.len()) {
                RejectAt(error_token.clone(), "invalid_node_id", "AST edge references an invalid NodeId")?
            }
            arena_edges = arena_edges.push(child)
        }
        node = Node {
            kind: kind,
            text: text,
            int_value: int_value,
            line: span.line,
            column: span.column,
            offset: span.offset,
            end_line: span.end_line,
            end_column: span.end_column,
            end_offset: span.end_offset,
            first_edge: first_edge,
            edge_count: arena_edges.len() - first_edge
        }
        arena_nodes = arena_nodes.push(node)
        return ok(arena_nodes.len())
    }

    fn AttachFunctionBody(parsed: ParseOutput, origin: Token): null! {
        // The body reader is an independently importable producer. Validate
        // before using its transport metadata or any edge index.
        validated = ValidateParseOutput(parsed)?
        parsed_root = validated.root
        parsed_arena = validated.arena
        parsed_nodes = parsed_arena.nodes
        parsed_edges = parsed_arena.edges
        if (parsed_root <= 0 || parsed_root != parsed_nodes.len()) {
            RejectAt(origin.clone(), "invalid_node_id", "function body transport root is invalid")?
        }
        transport = parsed_nodes[parsed_root - 1].clone()
        if (transport.kind != "FunctionBodyTransport" || transport.text != "") {
            RejectAt(origin.clone(), "invalid_node_id", "function body transport root has an invalid kind")?
        }
        if (transport.int_value < parse_steps || transport.int_value > 16384) {
            RejectAt(origin.clone(), "work_limit", "stage-3 parser work budget exceeded")?
        }
        if (transport.edge_count > 128) {
            RejectAt(origin.clone(), "statement_limit", "stage-3 parser accepts at most 128 statements per function")?
        }
        body_node_count = parsed_nodes.len() - 1
        body_edge_count = transport.first_edge
        if (body_node_count > 4096 - arena_nodes.len()) {
            RejectAt(origin.clone(), "node_limit", "stage-3 parser accepts at most 4096 AST nodes")?
        }
        if (body_edge_count > 8192 - arena_edges.len()) {
            RejectAt(origin.clone(), "edge_limit", "stage-3 parser accepts at most 8192 AST edges")?
        }
        node_base = arena_nodes.len()
        node_index = 0
        while (node_index < body_node_count) {
            input = parsed_nodes[node_index].clone()
            first_edge = arena_edges.len()
            edge_index = 0
            while (edge_index < input.edge_count) {
                child = parsed_edges[input.first_edge + edge_index]
                if (child <= 0 || child > body_node_count) {
                    RejectAt(origin.clone(), "invalid_node_id", "function body contains an invalid NodeId")?
                }
                arena_edges = arena_edges.push(node_base + child)
                edge_index = edge_index + 1
            }
            relocated = Node {
                kind: input.kind,
                text: input.text,
                int_value: input.int_value,
                line: input.line,
                column: input.column,
                offset: input.offset,
                end_line: input.end_line,
                end_column: input.end_column,
                end_offset: input.end_offset,
                first_edge: first_edge,
                edge_count: arena_edges.len() - first_edge
            }
            arena_nodes = arena_nodes.push(relocated)
            node_index = node_index + 1
        }
        statement_index = 0
        while (statement_index < transport.edge_count) {
            child = parsed_edges[transport.first_edge + statement_index]
            if (child <= 0 || child > body_node_count) {
                RejectAt(origin.clone(), "invalid_node_id", "function body transport contains an invalid statement NodeId")?
            }
            body_statements = body_statements.push(node_base + child)
            statement_index = statement_index + 1
        }
        body_work = transport.int_value
        body_span = SpanFromNode(transport)
        return ok(null)
    }

    body_start = header.body_open + 1
    body_output = ReadFunctionBodySpan(tokens, body_start, last_index, token_base, parse_steps, parse_expression)?
    AttachFunctionBody(body_output, function_start.clone())?
    parse_steps = body_work

    function_children = header.children
    for statement in body_statements { function_children = function_children.push(statement) }
    function_kind = "Function"
    if (function_start.kind == "Async") { function_kind = "AsyncFunction" }
    function = AddNode(function_kind, header.name, 0, SpanMerge(SpanFromToken(function_start.clone()), body_span.clone()), function_children, function_start.clone())?
    output = ValidateParseOutput(ParseOutput {
        arena: Arena { nodes: arena_nodes.clone(), edges: arena_edges.clone() },
        root: function
    })?
    return ok(DeclarationRead { output: output, consumed: last_index - first, work: parse_steps, start: function_start })
}
