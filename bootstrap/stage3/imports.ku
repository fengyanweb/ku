import { Token } from "../stage1/token.ku"
import { RejectAt, RejectAtPoint } from "./support.ku"

struct ImportNameRead {
    source: Token
    alias: Token
    has_alias: bool
}

struct ImportRead {
    start: Token
    path: Token
    namespace: Token
    has_namespace: bool
    names: [ImportNameRead]
    consumed: int
    work: int
}

fn ConsumedImportToken(tokens: [Token], index: int): Token {
    if (tokens[index].kind == "Eof" && index > 0) {
        return tokens[index - 1].clone()
    }
    return tokens[index].clone()
}

// The caller supplies one bounded import window ending at EOF or one token
// after the first string. Every accepted grammar path therefore has the path
// token and optional semicolon lookahead without copying the complete module.
fn ReadImport(tokens: [Token]): ImportRead! {
    // ParseProgram can hand this helper at most 265 source tokens plus its
    // appended EOF sentinel. Keep the independently importable entry point on
    // the same boundary before its validation walk or any prefix-copying
    // helper call. Token 265 is the token ParseProgram would reject while
    // attempting to grow an already-full source window.
    if (tokens.len() > 266) {
        RejectAt(tokens[265].clone(), "work_limit", "stage-3 import inspection budget exceeded")?
    }
    if (tokens.len() == 0) {
        RejectAtPoint("invalid_token_stream", "import window must start with import and end with EOF")?
    }
    if (tokens.len() < 2 || tokens[0].kind != "Import" || tokens[tokens.len() - 1].kind != "Eof") {
        RejectAt(tokens[0].clone(), "invalid_token_stream", "import window must start with import and end with EOF")?
    }
    check_index = 0
    while (check_index < tokens.len() - 1) {
        if (tokens[check_index].kind == "Eof") {
            RejectAt(tokens[check_index].clone(), "invalid_token_stream", "EOF must be final in import window")?
        }
        check_index = check_index + 1
    }
    start = tokens[0].clone()
    cursor = 1
    names: [ImportNameRead] = []
    namespace = start.clone()
    has_namespace = false
    work = 0
    if (tokens[cursor].kind == "LBrace") {
        cursor = cursor + 1
        if (tokens[cursor].kind == "RBrace") {
            RejectAt(tokens[cursor].clone(), "unexpected_token", "expected imported name inside '{ }'")?
        }
        reading_names = true
        while (reading_names) {
            work = work + 1
            if (work > 64) {
                RejectAt(tokens[cursor].clone(), "import_name_limit", "stage-3 named imports accept at most 64 names")?
            }
            source = tokens[cursor].clone()
            if (source.kind != "Ident") {
                RejectAt(ConsumedImportToken(tokens.clone(), cursor), "unexpected_token", "expected imported name")?
            }
            cursor = cursor + 1
            alias = source.clone()
            has_alias = false
            if (tokens[cursor].kind == "Ident" && tokens[cursor].lexeme == "as") {
                cursor = cursor + 1
                alias = tokens[cursor].clone()
                if (alias.kind != "Ident") {
                    if (alias.kind == "Eof" && cursor > 0) {
                        alias = tokens[cursor - 1].clone()
                    } else {
                        RejectAt(alias.clone(), "unexpected_token", "expected import alias")?
                    }
                }
                has_alias = true
                if (tokens[cursor].kind != "Eof") { cursor = cursor + 1 }
            }
            import_name = ImportNameRead { source: source, alias: alias, has_alias: has_alias }
            names = names.push(import_name)
            if (tokens[cursor].kind == "Comma") {
                cursor = cursor + 1
            } else {
                reading_names = false
            }
        }
        if (tokens[cursor].kind != "RBrace") {
            RejectAt(tokens[cursor].clone(), "unexpected_token", "expected '}' after imported names")?
        }
        cursor = cursor + 1
        if (tokens[cursor].kind != "From") {
            RejectAt(tokens[cursor].clone(), "unexpected_token", "expected 'from' after imported names")?
        }
        cursor = cursor + 1
    } else if (tokens[cursor].kind == "From") {
        RejectAt(tokens[cursor].clone(), "unexpected_token", "use 'import \"./xxx.ku\"' instead of 'import from \"./xxx.ku\"'")?
    } else if (tokens[cursor].kind != "String") {
        namespace = tokens[cursor].clone()
        if (namespace.kind != "Ident") {
            RejectAt(ConsumedImportToken(tokens.clone(), cursor), "unexpected_token", "expected import namespace or path")?
        }
        has_namespace = true
        cursor = cursor + 1
        if (tokens[cursor].kind != "From") {
            RejectAt(tokens[cursor].clone(), "unexpected_token", "expected 'from' after import namespace")?
        }
        cursor = cursor + 1
    }
    path = tokens[cursor].clone()
    if (path.kind != "String") {
        RejectAt(ConsumedImportToken(tokens.clone(), cursor), "unexpected_token", "expected import path string")?
    }
    cursor = cursor + 1
    if (tokens[cursor].kind == "Semicolon") { cursor = cursor + 1 }
    return ok(ImportRead {
        start: start,
        path: path,
        namespace: namespace,
        has_namespace: has_namespace,
        names: names,
        consumed: cursor,
        work: work
    })
}
