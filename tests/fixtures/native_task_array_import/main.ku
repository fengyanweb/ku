
import array from "./worker.ku"

async fn main(): null! {
    reply = (await array.Pick(["整理" + "🙂"]))?
    println(reply.text)
    empty: [str] = []
    missing = (await array.Pick(empty))?
    if (missing.text == null) { println("missing") }
    local = (await array.Local(["本地" + "🙂"]))?
    println(local.text)
    try { (await array.Lookup(["ignored"], -1))? }
    catch (issue) { println(issue.domain + "/" + issue.code) }
    println((await array.Lookup(["继续" + "🙂"], 0))?)
    return ok(null)
}
