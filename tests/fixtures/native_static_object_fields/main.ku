fn Take(value: str): null! { println(value); return ok(null) }
fn StoreWithSameLocalName(): null! {
    item = { text: "before" }
    key = "text"
    item[key] = 3
    println(item["text"]?.as_int()?)
    return ok(null)
}
fn main(): null! {
    StoreWithSameLocalName()?
    item = { text: "清单" + "🙂", sibling: "independent", done: false, zero: 0, empty: "", absent: null }
    Take(item.text)?
    Take(item.text)?
    println(item.text)
    println(item.sibling)
    println(item.zero)
    println(item.empty)
    println(item.absent)
    previous = item.text
    item.text = "完成🙂"
    item.done = true
    Take(item.text)?
    println(previous)
    println(item.done)
    return ok(null)
}
