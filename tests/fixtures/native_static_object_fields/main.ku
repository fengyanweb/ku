fn Take(value: str): null! { println(value); return ok(null) }
fn MakeTitle(value: str): str {
    println("prepare title")
    return "标题 " + value
}
fn Done(): bool {
    println("prepare flag")
    return true
}
fn StoreWithSameLocalName(): null! {
    item = { text: "before" }
    key = "text"
    item[key] = 3
    println(item["text"]?.as_int()?)
    return ok(null)
}
fn main(): null! {
    StoreWithSameLocalName()?
    item = { text: "清单" + "🙂", sibling: "before", done: false, zero: 0, empty: "", absent: null }
    Take(item.text)?
    Take(item.text)?
    println(item.text)
    item.sibling = "independent"
    println(item.sibling)
    println(item.zero)
    println(item.empty)
    println(item.absent)
    previous = item.text
    readPrevious = fn(): str { return previous.clone() }
    replacement = MakeTitle("完成🙂")
    item.text = replacement
    item.done = Done()
    Take(item.text)?
    println(item.text.len())
    println(readPrevious())
    println(item.done)
    return ok(null)
}
