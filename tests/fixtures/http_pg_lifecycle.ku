// Isolated acceptance fixture. The driver creates its own PostgreSQL cluster,
// db.conn and http.addr in a private temporary working directory.
import http from "std.http"
import pg from "std.pg"
import json from "std.json"
import "std.fs"

fn main(): null! {
    conninfo = fs.read("db.conn")?
    address = fs.read("http.addr")?
    client = pg.client({conninfo: conninfo, max_connections: 4, max_waiters: 8,
        connect_timeout_ms: 2000, acquire_timeout_ms: 100, query_timeout_ms: 150})?
    app = http.service()
    app.handler_timeout_ms = 2000
    app.max_connections = 64
    app.max_active_requests = 16
    app.max_pending_requests = 32
    app.get("/health", fn() { return http.text("ready") })
    app.get("/read", fn() {
        body = ""
        try {
            result = client.query("SELECT $1::text, 42::text, NULL::text", ["中文🙂 ' \\"])?
            body = json.encode({text: result.value(0, 0)?, number: result.value(0, 1)?,
                absent: result.is_null(0, 2)?, rows: result.rows(), cols: result.cols()})?
        } catch(err) { body = "error:" + err.code.clone() }
        return http.text(body)
    })
    app.get("/insert/{id}", fn(req) {
        body = ""
        try {
            result = client.query("INSERT INTO ku_events(id, payload) VALUES($1, $2) RETURNING payload",
                [req.params.id.clone(), "中文🙂 payload"])?
            body = result.value(0, 0)?
        } catch(err) { body = "error:" + err.code.clone() }
        return http.text(body)
    })
    app.get("/slow", fn() {
        body = "unexpected success"
        try { result = client.query("SELECT pg_sleep(0.6)", [])? }
        catch(err) { body = "error:" + err.code.clone() }
        return http.text(body)
    })
    app.get("/rows", fn() {
        body = ""
        try {
            result = client.query("SELECT i::text, repeat('x', 64) FROM generate_series(1, 10000) AS i", [])?
            body = str(result.rows()) + ":" + result.value(9999, 0)?
        } catch(err) { body = "error:" + err.code.clone() }
        return http.text(body)
    })
    app.listen(address)?
    return ok(null)
}
