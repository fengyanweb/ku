// Permanent full-stack benchmark. The runner writes an isolated config.json;
// no production database, cached JSON, or replacement JSON library is used.
import { http, json, fs, time, net, bytes } from "std"
import pg from "std.pg"

async fn digits(number: int): str! {
    value = number
    d0 = 48 + value % 10
    value = value / 10
    d1 = 48 + value % 10
    value = value / 10
    d2 = 48 + value % 10
    value = value / 10
    d3 = 48 + value % 10
    encoded = bytes.from_array([d3, d2, d1, d0])?
    return ok(encoded.to_str()?)
}

async fn ready(req: HttpRequest): HttpResponse! {
    return ok(http.text("ok:" + req.query.rid))
}

// Native async frames do not currently accept KuValue locals. JSON therefore
// uses the existing bounded synchronous HTTP path, just like database handlers.
fn encode(req: HttpRequest): HttpResponse! {
    decoded = json.decode(req.body)?
    counter = decoded["counter"]?.as_int()?
    data = decoded["data"]?
    body = json.encode({id: req.query.rid.clone(), counter: counter + 1, data: data})?
    return ok(http.text(body))
}

async fn work(req: HttpRequest): HttpResponse! {
    iterations = req.query.work.len() * 1000
    seed = req.query.seed.len()
    if (iterations < 1000 || iterations > 1000000 || seed < 1 || seed > 1024) {
        fail "CPU fixture input outside common integer range"
    }
    total = seed
    i = 0
    while (i < iterations) {
        total = (total * 33 + i + seed) % 100000000
        i = i + 1
    }
    return (await work_response(req, total))
}

// Split only the formatting step to stay within the existing 64-slot Task ABI.
async fn work_response(req: HttpRequest, total: int): HttpResponse! {
    left = (await digits(total / 10000))?
    right = (await digits(total % 10000))?
    return ok(http.text(req.query.rid + ":" + left + right))
}

async fn timer(req: HttpRequest): HttpResponse! {
    time.sleep(25)?
    return ok(http.text("timer:" + req.query.rid))
}

async fn waiting(req: HttpRequest): HttpResponse! {
    time.sleep(35000)?
    return ok(http.text("wait:" + req.query.rid))
}

// The build runner replaces this port, exactly as in multicore_capacity.ku.
// Native async HTTP handlers are named functions rather than captured closures.
async fn network(req: HttpRequest): HttpResponse! {
    socket = net.client({host: "127.0.0.1", port: __PEER_PORT__, tls: false,
        connect_timeout_ms: 3000, read_timeout_ms: 40000})?
    socket.write(bytes.from_str("K")?)?
    reply = socket.read(1)?
    code = reply.get(0)?
    socket.close()
    if (code != 75) { fail "incorrect controlled TCP reply" }
    return ok(http.text("tcp:" + req.query.rid))
}

fn main(): null! {
    // All other stacks receive the corresponding BENCH_* environment values.
    // Ku uses its existing filesystem/config API rather than a benchmark-only API.
    config = json.decode(fs.read("config.json")?)?
    address = config["addr"]?.as_str()?
    db_url = config["db_url"]?.as_str()?
    active_limit = config["max_active_requests"]?.as_int()?
    connection_limit = config["max_connections"]?.as_int()?
    pending_limit = config["max_pending_requests"]?.as_int()?
    client = pg.client({conninfo: db_url, max_connections: 16, max_waiters: 128,
        connect_timeout_ms: 2000, acquire_timeout_ms: 250, query_timeout_ms: 2000})?
    app = http.server({max_connections: connection_limit, max_active_requests: active_limit,
        max_pending_requests: pending_limit, max_buffer_bytes: 67108864,
        max_header_bytes: 4096, max_body_bytes: 65536,
        handler_timeout_ms: 45000, idle_timeout_ms: 5000,
        read_header_timeout_ms: 3000, read_body_timeout_ms: 3000,
        write_timeout_ms: 3000})
    app.get("/ok", ready)
    app.post("/json", encode)
    app.get("/work", work)
    app.get("/timer", timer)
    app.get("/wait", waiting)
    app.get("/tcp", network)
    // The ordinary synchronous handler uses Ku's bounded HTTP background pool.
    // Database operations are never retried or replayed by this benchmark.
    app.get("/db", fn(req) {
        body = "database_error"
        status = 500
        try {
            result = client.query("SELECT id,label,score FROM cross_stack_items WHERE id=$1",
                [req.query.key.clone()])?
            if (result.rows() != 1) { fail "database key missing" }
            key_value = json.decode(result.value(0, 0)?)?
            key = key_value.as_int()?
            label = result.value(0, 1)?
            score_value = json.decode(result.value(0, 2)?)?
            score = score_value.as_int()?
            body = json.encode({id: key, label: label, score: score, rid: req.query.rid.clone()})?
            status = 200
        } catch (error) { body = "database_error:" + error.code.clone() }
        return http.text(status, body)
    })
    app.listen(address)?
    return ok(null)
}
