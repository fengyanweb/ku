// MySQL 示例(native-only:ku build --native)
//
// 准备:
//   1. 把下面的 HOST / PORT / USER / DB 改成你的 MySQL 连接信息(非机密)。
//   2. 在“运行目录”放一个 mysql.pw 文件,内容是 MySQL 密码(已在 .gitignore)。
//   3. 运行时需要 libmysql.dll 在 PATH(MySQL 安装目录里的 lib/bin)。
//
// 构建运行:
//   ku build --native examples/mysql_demo.ku -o mysql_demo.exe
//   ./mysql_demo.exe
//
// 演示要点:统一 client、内部有界池、MYSQL_STMT 服务端参数绑定、读取结果和自动关闭。

import mysql from "std.mysql"
import "std.fs"

fn main(): null! {
    pw = fs.read("mysql.pw")?
    client = mysql.client({
        host: "127.0.0.1",
        port: 3306,
        user: "root",
        password: pw,
        database: "mysql",
        max_connections: 8,
        max_waiters: 64,
        connect_timeout_ms: 5000,
        acquire_timeout_ms: 5000,
        query_timeout_ms: 30000
    })?

    // 所有 SQL 都走同一个 prepared 路径,无参数时传 []
    res = client.query("SELECT VERSION(), DATABASE(), 1 + 1", [])?
    println("version = " + res.value(0, 0)?)
    println("database = " + res.value(0, 1)?)
    println("calc = " + res.value(0, 2)?)

    // 参数化查询:? 占位由 MYSQL_STMT 绑定,注入 payload 只会被当作纯文本
    payload = "x'; DROP TABLE users; --"
    res2 = client.query("SELECT CONCAT('[', ?, ']')", [payload])?
    println("echoed = " + res2.value(0, 0)?)   // [x'; DROP TABLE users; --]

    client.close()
    return ok(null)
}
