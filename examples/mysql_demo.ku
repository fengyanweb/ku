// MySQL 示例(native-only:ku build --native)
//
// 准备:
//   1. 把下面的 HOST / PORT / USER / DB 改成你的 MySQL 连接信息(非机密)。
//   2. 在“运行目录”放一个 mysql.pw 文件,内容是 MySQL 密码(已在 .gitignore)。
//   3. 运行时需要 libmysql.dll 在 PATH(MySQL 安装目录里的 lib/bin)。
//
// 构建运行:
//   ku build --native examples/mysql_demo.ku -o mysql_demo.exe
//   ./mysql_demo.exe
//
// 演示要点:连接、查询、参数化查询(mysql_real_escape_string 防注入)、读取结果、自动关闭。

import mysql from "std.mysql"
import "std.fs"

fn main(): null! {
    pw = fs.read("mysql.pw")
    conn = mysql.connect("127.0.0.1", 3306, "root", pw, "mysql")?

    // 普通查询
    res = mysql.query(conn, "SELECT VERSION(), DATABASE(), 1 + 1")?
    println("version = " + mysql.value(res, 0, 0))
    println("database = " + mysql.value(res, 0, 1))
    println("calc = " + mysql.value(res, 0, 2))

    // 参数化查询:? 占位,值经转义,注入 payload 只会被当作纯文本
    payload = "x'; DROP TABLE users; --"
    res2 = mysql.query_params(conn, "SELECT CONCAT('[', ?, ']')", [payload])?
    println("echoed = " + mysql.value(res2, 0, 0))   // [x'; DROP TABLE users; --]

    mysql.close(conn)
    return ok(null)
}
