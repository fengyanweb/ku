// Native C backend, PostgreSQL listening locally; no schema or table required.
// ku build --native pg_typed_http.ku && ./pg_typed_http
// curl 'http://127.0.0.1:8091/typed?key=hello'
import http from "std.http"
import pg from "std.pg"

fn main(): null! {
    client = pg.client({conninfo: "host=127.0.0.1 dbname=ku user=ku", max_connections: 4})?
    async fn typed(req: HttpRequest): HttpResponse! {
        key = req.query.key.clone()
        size = key.byte_len()
        row = client.query_one_typed(
            "SELECT $1::int8,$2::bool,$3::text,$4::text",
            [size, true, key, null],
            ["int8", "bool", "text", "text?"],
            ["int8", "bool", "text", "text?"])?
        actual_size = row.value_int(0, 0)?
        flag = row.value_bool(0, 1)?
        label = row.value(0, 2)?
        missing = row.is_null(0, 3)?
        if (actual_size != size || !flag || !missing) { fail "typed result mismatch" }
        return ok(http.text(str(actual_size) + ":" + label))
    }
    app = http.server()
    app.get("/typed", typed)
    app.listen("127.0.0.1:8091")?
    return ok(null)
}
