import { http, time } from "std"

fn main(): null! {
    app = http.service
    app.max_connections = 1024
    app.max_active_requests = 256
    app.max_pending_requests = 1024
    app.handler_timeout_ms = 5000
    app.idle_timeout_ms = 3000
    app.max_body_bytes = 1000000

    app.get("/", (req, res) => {
        return http.text("Ku HTTP OK")
    })
    app.get("/json", (req, res) => {
        return http.json({
            ok: true,
            path: req.path.clone(),
            now_ms: time.millis()
        })
    })
    app.get("/user/{id}", (req, res) => {
        return http.json({
            id: req.params.id.clone(),
            q: req.query["q"]?,
            method: req.method.clone()
        })
    })
    app.post("/echo", (req, res) => {
        return http.text(req.body.clone())
    })

    println("Ku HTTP server listening on http://127.0.0.1:8080")
    println("Try: GET /, GET /json, GET /user/42?q=ku, POST /echo")
    app.listen("127.0.0.1:8080")?
    return ok(null)
}
