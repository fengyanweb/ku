import { http, time } from "std"

fn ret(req, res) {
    return http.text("Ku HTTP OK")
}

fn main(): null! {
    app = http.service()

    app.get("/", ret)
    app.get("/index", fn(req, res) {
        return http.json({
            code: 0,
            msg: "成功",
            data: {
                name: "张三",
                age: 18,
                aihao: ["打羽毛球", "吃饭"]
            }
        })
    })
    app.get("/json", (req, res) => {
        return http.json({
            code: 0,
            msg: "ok",
            data: {
                path: req.path.clone(),
                now_ms: time.millis()
            }
        })
    })
    app.get("/created", (req, res) => {
        return http.json(http.status.created, {
            code: 0,
            msg: "created",
            data: null
        })
    })
    app.get("/user/{id}", (req, res) => {
        return http.json({
            code: 0,
            msg: "ok",
            data: {
                id: req.params.id.clone(),
                q: req.query["q"]?,
                method: req.method.clone()
            }
        })
    })
    app.post("/echo", (req, res) => {
        return http.text(req.body.clone())
    })
    app.get("/empty", (req, res) => {
        return http.empty()
    })

    println("Ku HTTP server listening on http://127.0.0.1:8080")
    println("Try: GET /, GET /index, GET /json, GET /created, GET /user/42?q=ku, GET /empty, POST /echo")
    app.listen("127.0.0.1:8080")?
    return ok(null)
}
