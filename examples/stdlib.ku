import { time } from "std"

fn main(): null! {
    text = string.trim("  Ku Lang  ")
    println(string.upper(text))
    println(string.replace(text, "Lang", "0.0.8"))

    nums:[int] = [1, 2]
    nums = array.push(nums, 3)
    nums = array.concat(nums, [4])
    println(array.len(nums))
    println(array.first(nums))
    println(array.last(nums))

    data = { name: "Ku", version: 6, ok: true }
    json_text = json.stringify(data)?
    println(json_text)
    println(json.stringify(json.parse(json_text)?)?)

    println(time.now())
    instant = time.instant()
    println(time.elapsed(instant))
    return ok(null)
}
