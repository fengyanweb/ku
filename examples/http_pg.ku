// HTTP + PostgreSQL 端到端示例(native-only:ku build --native)
//
// 一个用纯 Ku 写、编译成 native 可执行文件的 Web 服务:
//   浏览器 → HTTP → Ku 服务 → libpq → PostgreSQL → JSON → 前端渲染
//
// 准备(与 pg_demo 相同):
//   1. 在仓库根目录放一个 db.conn 文件,内容是 libpq 连接串(已在 .gitignore)。
//   2. 运行时需要同一 PostgreSQL 安装目录中的 libpq.dll 及其依赖 DLL 在 PATH。
//
// 构建运行(从仓库根目录运行,以便读到 examples/http_pg_frontend.html):
//   ku build --native examples/http_pg.ku -o http_pg.exe
//   ./http_pg.exe
//   然后浏览器打开 http://127.0.0.1:8090/
//
// 说明:http.text 只负责响应类型，JSON 内容统一由 json.stringify 生成，不能把数据库
// 文本直接拼进 JSON。数据库查询失败时返回固定错误 JSON；查询只读元数据。

import http from "std.http"
import pg from "std.pg"
import json from "std.json"
import "std.fs"

fn frontend_html(): str {
    body = "frontend file error"
    try {
        body = fs.read("examples/http_pg_frontend.html")?
    } catch (err) {
        body = "frontend file error"
    }
    return body
}

fn main(): null! {
    conninfo = fs.read("db.conn")?
    db_client = pg.client({
        conninfo: conninfo,
        max_connections: 16,
        max_waiters: 256,
        connect_timeout_ms: 5000,
        acquire_timeout_ms: 5000,
        query_timeout_ms: 30000
    })?
    app = http.service()

    // 前端页面
    app.get("/", fn() {
        return http.html(frontend_html())
    })

    // 所有 handler 共享线程安全的有界 client；每次查询自动借还连接。
    app.get("/db/info", fn() {
        body = "{\"code\":1,\"msg\":\"db error\"}"
        try {
            res = db_client.query("SELECT version(), current_database(), now()::text, (SELECT count(*)::text FROM information_schema.tables WHERE table_schema = 'public')", [])?
            ver = res.value(0, 0)?
            database = res.value(0, 1)?
            now = res.value(0, 2)?
            count = res.value(0, 3)?
            body = json.stringify({
                code: 0,
                msg: "ok",
                data: {
                    version: ver,
                    database: database,
                    now: now,
                    public_tables: count
                }
            })?
        } catch (err) {
            body = "{\"code\":1,\"msg\":\"db error\"}"
        }
        return http.text(body)
    })

    println("Ku HTTP+PG demo listening on http://127.0.0.1:8090")
    println("Open http://127.0.0.1:8090/  in a browser")
    app.listen("127.0.0.1:8090")?
    return ok(null)
}
