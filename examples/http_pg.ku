// HTTP + PostgreSQL 任务清单。启动和建表见 http_pg.README.md。

import http from "std.http"
import pg from "std.pg"
import json from "std.json"
import string from "std.string"
import "std.fs"

fn frontend_html(): str {
    body = "frontend file error"
    try {
        body = fs.read("http_pg_frontend.html")?
    } catch (err) {
        body = "frontend file error"
    }
    return body
}

fn read_config(path: str, message: str): str! {
    text = ""
    try {
        text = string.trim(fs.read(path)?)
    } catch (err) {
        fail message
    }
    if (text == "") fail message
    return ok(text)
}

fn task_id(text: str): int! {
    value = json.decode(text.clone())?
    id = value.as_int()?
    if (id < 1 || str(id) != text) fail "id must be a positive decimal integer"
    return ok(id)
}

fn serve(conninfo: str, address: str): null! {
    db_client = pg.client({
        conninfo: conninfo,
        max_connections: 4,
        max_waiters: 8,
        connect_timeout_ms: 5000,
        acquire_timeout_ms: 5000,
        query_timeout_ms: 30000
    })?
    app = http.service()

    // 前端页面
    app.get("/", fn() {
        return http.html(frontend_html())
    })

    app.post("/tasks", fn(req: HttpRequest): HttpResponse {
        title = ""
        try {
            input = json.decode(req.body.clone())?
            title = input["title"]?.as_str()?
            nul_value = json.decode("\"\\u0000\"")?
            nul = nul_value.as_str()?
            if (title.byte_len() == 0 || title.byte_len() > 800 || title.contains(nul)) {
                return http.json(400, {error: "invalid_title"})
            }
        } catch (err) {
            return http.json(400, {error: "invalid_title"})
        }
        try {
            row = db_client.query(
                "INSERT INTO ku_tasks (title) VALUES ($1) RETURNING id, title",
                [title])?
            return http.json(201, {id: row.value_int(0, 0)?, title: row.value(0, 1)?})
        } catch (err) {}
        // An unconfirmed response never triggers a second INSERT.
        return http.json(503, {error: "database_error"})
    })

    app.get("/tasks", fn(): HttpResponse {
        return http.json(400, {error: "invalid_id"})
    })
    app.get("/tasks/{id}", fn(req: HttpRequest): HttpResponse {
        id = 0
        try {
            id = task_id(req.params.id.clone())?
        } catch (err) {
            return http.json(400, {error: "invalid_id"})
        }
        try {
            row = db_client.query("SELECT id, title FROM ku_tasks WHERE id = $1::bigint", [str(id)])?
            if (row.rows() == 0) return http.json(404, {error: "not_found"})
            return http.json(200, {id: row.value_int(0, 0)?, title: row.value(0, 1)?})
        } catch (err) {}
        return http.json(503, {error: "database_error"})
    })

    // 所有 handler 共享线程安全的有界 client；每次查询自动借还连接。
    app.get("/db/info", fn() {
        body = "{\"code\":1,\"msg\":\"db error\"}"
        try {
            res = db_client.query("SELECT version(), current_database(), now()::text, (SELECT count(*)::text FROM information_schema.tables WHERE table_schema = 'public')", [])?
            ver = res.value(0, 0)?
            database = res.value(0, 1)?
            now = res.value(0, 2)?
            count = res.value(0, 3)?
            body = json.stringify({
                code: 0,
                msg: "ok",
                data: {
                    version: ver,
                    database: database,
                    now: now,
                    public_tables: count
                }
            })?
        } catch (err) {
            body = "{\"code\":1,\"msg\":\"db error\"}"
        }
        return http.text(body)
    })

    app.listen(address)?
    return ok(null)
}

fn main(): null! {
    conninfo = read_config("db.conn", "Provide a non-empty db.conn beside the executable")?
    address = read_config("http.addr", "Provide a listen address in http.addr beside the executable")?
    try {
        serve(conninfo, address)?
    } catch (err) {
        fail "Could not start HTTP + PostgreSQL; check db.conn, http.addr and libpq"
    }
    return ok(null)
}
