// HTTP + PostgreSQL 端到端示例(native-only:ku build --native)
//
// 一个用纯 Ku 写、编译成 native 可执行文件的 Web 服务:
//   浏览器 → HTTP → Ku 服务 → libpq → PostgreSQL → JSON → 前端渲染
//
// 准备(与 pg_demo 相同):
//   1. 在“运行目录”放一个 db.conn 文件,内容是 libpq 连接串(已在 .gitignore)。
//   2. 运行时需要 libpq.dll 在 PATH。
//
// 构建运行(从仓库根目录运行,以便读到 examples/http_pg_frontend.html):
//   ku build --native examples/http_pg.ku -o http_pg.exe
//   ./http_pg.exe
//   然后浏览器打开 http://127.0.0.1:8090/
//
// 说明:当前 native 后端的 http.json 尚不可用,这里用 http.text 返回手工拼的 JSON 字符串;
// 数据库查询会失败时,返回一个错误 JSON。查询只读元数据,不碰任何业务表。

import http from "std.http"
import pg from "std.pg"
import "std.fs"

// 连 PostgreSQL 查一行元数据(只读),拼成 JSON 字符串;出错返回错误 JSON。
// DB 逻辑放在返回 str 的顶层函数里,handler 只负责 return http.text(...)。
fn db_json(): str {
    body = "{\"code\":1,\"msg\":\"init\"}"
    try {
        conninfo = fs.read("db.conn")
        conn = pg.connect(conninfo)?
        res = pg.query(conn, "SELECT version(), current_database(), now()::text, (SELECT count(*)::text FROM information_schema.tables WHERE table_schema = 'public')")?
        ver = pg.value(res, 0, 0)
        db = pg.value(res, 0, 1)
        now = pg.value(res, 0, 2)
        cnt = pg.value(res, 0, 3)
        body = "{\"code\":0,\"msg\":\"ok\",\"data\":{\"version\":\"" + ver + "\",\"database\":\"" + db + "\",\"now\":\"" + now + "\",\"public_tables\":" + cnt + "}}"
    } catch (err) {
        body = "{\"code\":1,\"msg\":\"db error\"}"
    }
    return body
}

fn main(): null! {
    app = http.service()

    // 前端页面
    app.get("/", fn() {
        return http.html(fs.read("examples/http_pg_frontend.html"))
    })

    // 收到 HTTP 请求 → 连 PostgreSQL → 查数据 → JSON 返回给前端
    app.get("/db/info", fn() {
        return http.text(db_json())
    })

    println("Ku HTTP+PG demo listening on http://127.0.0.1:8090")
    println("Open http://127.0.0.1:8090/  in a browser")
    app.listen("127.0.0.1:8090")?
    return ok(null)
}
