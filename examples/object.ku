fn main() {
    user = { name: "Ku", age: 1, city: "Hangzhou" }
    { name, age: years, missing = "fallback", ...rest } = user.clone()

    println(user.name)
    println(user["name"])
    println(str(user["missing"]?))
    println(name)
    println(years)
    println(missing)
    println(rest.city)
}
