 #ifdef USE_LDAP
 
+/* Isolated Linux/OpenLDAP SONAME-2 candidate; shared library only. */
+#ifdef USE_DYNAMIC_LDAP
+#if !defined(__linux__) || defined(WIN32)
+#error USE_DYNAMIC_LDAP is supported only by the isolated Linux candidate
+#endif
+#include <dlfcn.h>
+
+/* Keep declarations and every matching release operation in one library. */
+typedef struct
+{
+	LDAP *(*init) (const char *, int);
+	int (*set_option) (LDAP *, int, const void *);
+	int (*simple_bind) (LDAP *, const char *, const char *);
+	int (*result) (LDAP *, int, int, struct timeval *, LDAPMessage **);
+	int (*msgfree) (LDAPMessage *);
+	int (*search_st) (LDAP *, const char *, int, const char *, char **, int,
+					 struct timeval *, LDAPMessage **);
+	char *(*err2string) (int);
+	int (*unbind) (LDAP *);
+	int (*count_entries) (LDAP *, LDAPMessage *);
+	LDAPMessage *(*first_entry) (LDAP *, LDAPMessage *);
+	struct berval **(*get_values_len) (LDAP *, LDAPMessage *, const char *);
+	void (*value_free_len) (struct berval **);
+} LibpqLdapAPI;
+
+static LibpqLdapAPI libpq_ldap_api;
+static void *libpq_ldap_module;
+static pthread_mutex_t libpq_ldap_mutex = PTHREAD_MUTEX_INITIALIZER;
+
+static bool
+libpq_ldap_load(PQExpBuffer errorMessage)
+{
+	LibpqLdapAPI next = {0};
+	void *module;
+	int lockerr;
+
+	lockerr = pthread_mutex_lock(&libpq_ldap_mutex);
+	if (lockerr != 0)
+	{
+		libpq_append_error(errorMessage, "could not lock LDAP loader (%d)", lockerr);
+		return false;
+	}
+	if (libpq_ldap_module != NULL)
+	{
+		pthread_mutex_unlock(&libpq_ldap_mutex);
+		return true;
+	}
+
+	/* Preserve normal constructors and global symbol scope after first use. */
+	module = dlopen("libldap.so.2", RTLD_NOW | RTLD_GLOBAL);
+	if (module == NULL)
+	{
+		libpq_append_error(errorMessage, "could not load LDAP library libldap.so.2");
+		pthread_mutex_unlock(&libpq_ldap_mutex);
+		return false;
+	}
+#define LOAD_LDAP(member, symbol) \
+	do { \
+		if ((next.member = dlsym(module, symbol)) == NULL) \
+		{ \
+			libpq_append_error(errorMessage, "LDAP library lacks required symbol %s", symbol); \
+			goto fail; \
+		} \
+	} while (0)
+	LOAD_LDAP(init, "ldap_init");
+	LOAD_LDAP(set_option, "ldap_set_option");
+	LOAD_LDAP(simple_bind, "ldap_simple_bind");
+	LOAD_LDAP(result, "ldap_result");
+	LOAD_LDAP(msgfree, "ldap_msgfree");
+	LOAD_LDAP(search_st, "ldap_search_st");
+	LOAD_LDAP(err2string, "ldap_err2string");
+	LOAD_LDAP(unbind, "ldap_unbind");
+	LOAD_LDAP(count_entries, "ldap_count_entries");
+	LOAD_LDAP(first_entry, "ldap_first_entry");
+	LOAD_LDAP(get_values_len, "ldap_get_values_len");
+	LOAD_LDAP(value_free_len, "ldap_value_free_len");
+#undef LOAD_LDAP
+
+	/* Publish only a complete table, retaining its DSO for process lifetime. */
+	libpq_ldap_api = next;
+	libpq_ldap_module = module;
+	pthread_mutex_unlock(&libpq_ldap_mutex);
+	return true;
+
+fail:
+	dlclose(module);
+	pthread_mutex_unlock(&libpq_ldap_mutex);
+	return false;
+}
+
+#define ldap_init (*libpq_ldap_api.init)
+#define ldap_set_option (*libpq_ldap_api.set_option)
+#define ldap_simple_bind (*libpq_ldap_api.simple_bind)
+#define ldap_result (*libpq_ldap_api.result)
+#define ldap_msgfree (*libpq_ldap_api.msgfree)
+#define ldap_search_st (*libpq_ldap_api.search_st)
+#define ldap_err2string (*libpq_ldap_api.err2string)
+#define ldap_unbind (*libpq_ldap_api.unbind)
+#define ldap_count_entries (*libpq_ldap_api.count_entries)
+#define ldap_first_entry (*libpq_ldap_api.first_entry)
+#define ldap_get_values_len (*libpq_ldap_api.get_values_len)
+#define ldap_value_free_len (*libpq_ldap_api.value_free_len)
+#endif /* USE_DYNAMIC_LDAP */
+
 #define LDAP_URL	"ldap://"
 #define LDAP_DEF_PORT	389
 #define PGLDAP_TIMEOUT 2
