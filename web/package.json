{
  "name": "ku-website",
  "version": "0.0.20",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "postinstall": "node scripts/patch-versioning.mjs",
    "dev": "astro dev --host 127.0.0.1",
    "lint": "prettier --check .",
    "format": "prettier --write .",
    "check": "astro check",
    "wasm": "node scripts/build-wasm.mjs",
    "predev": "npm run wasm",
    "prebuild:preview": "npm run wasm",
    "prebuild:production": "npm run wasm",
    "postbuild:production": "node scripts/verify-wasm-dist.mjs",
    "postbuild:preview": "node scripts/verify-wasm-dist.mjs",
    "build": "node scripts/build-site.mjs",
    "build:preview": "astro build",
    "build:production": "node scripts/require-production.mjs && astro build",
    "preview": "node scripts/preview.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.3.3",
    "@astrojs/sitemap": "3.7.4",
    "@astrojs/starlight": "0.42.6",
    "@codemirror/autocomplete": "6.20.4",
    "@codemirror/commands": "6.11.1",
    "@codemirror/language": "6.13.1",
    "@codemirror/lint": "6.9.7",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@lezer/highlight": "1.2.5",
    "astro": "7.4.0",
    "codemirror": "6.0.2",
    "starlight-versions": "0.10.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.1",
    "typescript": "5.9.3"
  },
  "overrides": {
    "postcss-selector-parser": "7.1.6"
  },
  "license": "Apache-2.0"
}
