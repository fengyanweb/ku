---
import messages from '../i18n/language-preferences.json';
import type { Locale } from '../i18n/locales';
interface Props {
  locale: Locale;
  fallback?: boolean;
  documentFallback?: boolean;
}
const { locale, fallback = false, documentFallback = false } = Astro.props;
---

{fallback || documentFallback ? (
  <p
    id="ku-language-fallback"
    class="fallback"
    role="status"
    data-pagefind-ignore
    data-ku-language-fallback
  >
    {documentFallback
      ? messages[locale].documentFallback
      : messages[locale].fallback}
  </p>
) : (
  <p class="notice">{messages[locale].notice}</p>
)}
<style>
  .notice {
    color: var(--ku-muted);
    font-size: 0.75rem;
    line-height: 1.7;
    margin-block: 1rem;
    max-width: 55rem;
  }
  .fallback {
    display: none;
    border: 1px solid var(--ku-line);
    padding: 1rem;
    margin-block: 1rem;
    color: var(--ku-ink);
    font-size: 0.9rem;
  }
  .fallback:target,
  .fallback.is-fallback {
    display: block;
  }
</style>

<script>
  function showFallbackNotice() {
    const active =
      new URL(location.href).searchParams.get('ku_language_fallback') === '1';
    document
      .querySelectorAll<HTMLElement>('[data-ku-language-fallback]')
      .forEach((notice) => {
        notice.classList.toggle('is-fallback', active);
      });
  }
  showFallbackNotice();
  window.addEventListener('pageshow', showFallbackNotice);
</script>
