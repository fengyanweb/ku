---
import Default from '@astrojs/starlight/components/PageTitle.astro';
import { localeFromPath, translate } from '../i18n/locales';
import { archiveFromPath } from '../data/versions';
const locale = localeFromPath(Astro.url.pathname);
const t = translate(locale);
const archive = archiveFromPath(Astro.url.pathname);
---

<Default />
<div class="ku-page-meta">
  <span>
    {archive ? t.snapshot.replace('{version}', archive.label) : t.next}
  </span>
  <a href={`/${locale}/${archive ? `${archive.slug}/` : ''}docs/support/`}>
    {t.limitations} ↗
  </a>
</div>
