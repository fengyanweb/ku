---
import Default from '@astrojs/starlight/components/PageTitle.astro';
import VersionNotice from 'starlight-versions/components/VersionNotice.astro';
import VersionNavigation from './VersionNavigation.astro';
import LanguageNotice from './LanguageNotice.astro';
import { localeFromPath } from '../i18n/locales';
import { archiveFromPath } from '../data/versions';
const archive = archiveFromPath(Astro.url.pathname);
---

<Default />
<LanguageNotice locale={localeFromPath(Astro.url.pathname)} documentFallback />
{archive && (
  <VersionNavigation>
    <VersionNotice />
  </VersionNavigation>
)}
