---
import { locales, localeDefinitions, type Locale } from '../i18n/locales';
import { translationsForPath } from '../i18n/routes';
interface Props {
  title: string;
  description: string;
  locale: Locale;
}
const { title, description, locale } = Astro.props;
const path = Astro.url.pathname;
const localized = locales.includes(path.split('/')[1] as Locale);
const indexable =
  import.meta.env.INDEXABLE === 'true' && !!Astro.site && localized;
---

<meta name="description" content={description} />
<meta
  name="robots"
  content={indexable ? 'index, follow' : 'noindex, nofollow'}
/>
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:type" content="website" />
<meta
  property="og:locale"
  content={localeDefinitions[locale].lang.replace('-', '_')}
/>
{Astro.site && localized && (
  <>
    <link rel="canonical" href={new URL(path, Astro.site)} />
    {translationsForPath(path).map(({ locale: key, path: translatedPath }) => (
      <link
        rel="alternate"
        hreflang={localeDefinitions[key].lang}
        href={new URL(translatedPath, Astro.site)}
      />
    ))}
    <meta property="og:url" content={new URL(path, Astro.site)} />
  </>
)}
{Astro.site && path === `/${locale}/` && (
  <script
    type="application/ld+json"
    set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'WebSite',
      name: 'Ku',
      description,
      url: new URL(path, Astro.site).href,
      inLanguage: localeDefinitions[locale].lang,
      sameAs: 'https://github.com/fengyanweb/ku',
    }).replace(/</g, '\\u003c')}
  />
)}
