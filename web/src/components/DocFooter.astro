---
import Default from '@astrojs/starlight/components/Footer.astro';
import { localeFromPath, translate } from '../i18n/locales';
import { project } from '../data/site';
const locale = localeFromPath(Astro.url.pathname);
const t = translate(locale);
---

<Default />
<nav class="community-links" aria-label={t.footer}>
  <a href={`/${locale}/support/`}>{t.supportKu}</a>
  <a href={`${project.repository}/issues`}>{t.reportIssue}</a>
  <a href={`mailto:${project.feedbackEmail}`}>{t.emailFeedback}</a>
</nav>

<style>
  .community-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.5rem;
    margin-top: 1.5rem;
    font-size: 0.875rem;
  }
</style>
