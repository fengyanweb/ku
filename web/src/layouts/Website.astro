---
import '../styles/tokens.css';
import '../styles/website.css';
import Seo from '../components/Seo.astro';
import Theme from '../components/Theme.astro';
import LanguageSwitch from '../components/LanguageSwitch.astro';
import LanguageNotice from '../components/LanguageNotice.astro';
import { project } from '../data/site';
import {
  localeDefinitions,
  locales,
  translate,
  type Locale,
} from '../i18n/locales';
interface Props {
  title: string;
  description: string;
  locale: Locale;
}
const { title, description, locale } = Astro.props;
const t = translate(locale);
const language = localeDefinitions[locale];
const localized = locales.includes(Astro.url.pathname.split('/')[1] as Locale);
const links = [
  [t.documentation, `/${locale}/docs/getting-started/`],
  [t.languageGuide, `/${locale}/docs/guide/language/`],
  [t.libraryGroup, `/${locale}/docs/stdlib/`],
  [t.releases, `/${locale}/releases/`],
  [t.supportKu, `/${locale}/support/`],
];
const messages = {
  searchEmpty: t.searchEmpty,
  searching: t.searching,
  searchNoResults: t.searchNoResults,
  searchUnavailable: t.searchUnavailable,
};
---

<!doctype html>
<html lang={language.lang} dir={language.dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
    <Seo title={title} description={description} locale={locale} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <Theme />
  </head>
  <body
    data-locale={locale}
    data-search-ui={JSON.stringify(messages)}
    data-pagefind-ignore={localized ? undefined : 'all'}
  >
    <a class="skip-link" href="#main">
      {t.skip}
    </a>
    <header class="site-header shell">
      <a class="wordmark" href={`/${locale}/`} aria-label={t.home} dir="ltr">
        ku<span class="wordmark-dot">.</span>
      </a>
      <nav class="desktop-nav" aria-label={t.navigation}>
        {links.map(([label, href]) => (
          <a href={href}>{label}</a>
        ))}
      </nav>
      <div class="header-tools">
        <button
          class="search-trigger"
          data-open-search
          aria-label={t.searchDocs}
        >
          <svg viewBox="0 0 24 24" width="17" height="17" aria-hidden="true">
            <circle cx="10.5" cy="10.5" r="6.5" />
            <path d="m16 16 4 4" />
          </svg>
          <span>{t.search}</span>
          <kbd dir="ltr">⌘ K</kbd>
        </button>
        <LanguageSwitch locale={locale} />
        <label class="theme-label">
          <span class="sr-only">{t.theme}</span>
          <select data-ku-theme aria-label={t.theme}>
            <option value="auto">◐</option>
            <option value="light">☀</option>
            <option value="dark">☾</option>
          </select>
        </label>
        <a
          class="github-link"
          href={project.repository}
          aria-label="Ku on GitHub"
        >
          <svg
            viewBox="0 0 24 24"
            width="20"
            height="20"
            fill="currentColor"
            aria-hidden="true"
          >
            <path d="M12 2a10 10 0 0 0-3.16 19.49c.5.09.68-.22.68-.48v-1.69c-2.78.6-3.37-1.18-3.37-1.18-.45-1.16-1.11-1.47-1.11-1.47-.91-.62.07-.61.07-.61 1 .07 1.53 1.03 1.53 1.03.89 1.52 2.34 1.08 2.91.83.09-.65.35-1.09.64-1.34-2.22-.25-4.56-1.11-4.56-4.94 0-1.09.39-1.98 1.03-2.68-.1-.25-.45-1.27.1-2.65 0 0 .84-.27 2.75 1.03A9.6 9.6 0 0 1 12 6.97a9.6 9.6 0 0 1 2.5.34c1.91-1.3 2.75-1.03 2.75-1.03.55 1.38.2 2.4.1 2.65.64.7 1.03 1.59 1.03 2.68 0 3.84-2.34 4.69-4.57 4.94.36.31.68.92.68 1.85v2.61c0 .27.18.58.69.48A10 10 0 0 0 12 2z" />
          </svg>
        </a>
        <details class="mobile-menu">
          <summary aria-label={t.menu}>☰</summary>
          <nav>
            {links.map(([label, href]) => (
              <a href={href}>{label}</a>
            ))}
          </nav>
        </details>
      </div>
    </header>
    <main id="main" data-pagefind-body data-pagefind-filter="version:current">
      <div class="shell" data-pagefind-ignore>
        <LanguageNotice locale={locale} fallback />
      </div>
      <slot />
    </main>
    <footer class="site-footer shell">
      <div>
        <a class="wordmark" href={`/${locale}/`} dir="ltr">
          ku<span class="wordmark-dot">.</span>
        </a>
        <p>{t.tagline}</p>
      </div>
      <nav aria-label={t.footer}>
        <a href={`/${locale}/docs/project/`}>{t.project}</a>
        <a href={`/${locale}/docs/support/`}>{t.support}</a>
        <a href={`${project.repository}/issues`}>{t.reportIssue} ↗</a>
        <a href={`mailto:${project.feedbackEmail}`}>{t.emailFeedback}</a>
      </nav>
      <div class="footer-note">
        {t.experimental}
        <br />
        <span>
          {project.version} ·{' '}
          <a href={`/${locale}/docs/project/`}>{t.sourceAvailable}</a>
        </span>
      </div>
    </footer>
    <dialog class="search-dialog" data-search-dialog aria-label={t.searchDocs}>
      <form method="dialog" class="search-top">
        <label for="ku-search">{t.searchTitle}</label>
        <button aria-label="Escape">Esc</button>
      </form>
      <input
        id="ku-search"
        type="search"
        placeholder={t.searchPlaceholder}
        autocomplete="off"
      />
      <div
        class="search-results"
        data-search-results
        role="status"
        aria-live="polite"
      >
        {t.searchEmpty}
      </div>
    </dialog>
    <script>
      const theme =
        document.querySelector<HTMLSelectElement>('[data-ku-theme]');
      if (theme) {
        try {
          theme.value = localStorage.getItem('starlight-theme') || 'auto';
        } catch {
          theme.value = 'auto';
        }
        theme.addEventListener('change', () => {
          const dark =
            theme.value === 'dark' ||
            (theme.value === 'auto' &&
              matchMedia('(prefers-color-scheme: dark)').matches);
          document.documentElement.dataset.theme = dark ? 'dark' : 'light';
          try {
            localStorage.setItem(
              'starlight-theme',
              theme.value === 'auto' ? '' : theme.value,
            );
          } catch {
            /* Theme still works without persistence. */
          }
        });
        matchMedia('(prefers-color-scheme: dark)').addEventListener(
          'change',
          (event) => {
            if (theme.value === 'auto')
              document.documentElement.dataset.theme = event.matches
                ? 'dark'
                : 'light';
          },
        );
      }
      const dialog = document.querySelector<HTMLDialogElement>(
        '[data-search-dialog]',
      );
      const input = document.querySelector<HTMLInputElement>('#ku-search');
      const results = document.querySelector<HTMLElement>(
        '[data-search-results]',
      );
      const locale = document.body.dataset.locale!;
      const messages: Record<string, string> = JSON.parse(
        document.body.dataset.searchUi!,
      );
      let pagefindPromise: Promise<any> | undefined;
      let sequence = 0;
      let timer: ReturnType<typeof setTimeout>;
      const open = () => {
        dialog?.showModal();
        input?.focus();
      };
      document
        .querySelector('[data-open-search]')
        ?.addEventListener('click', open);
      document.addEventListener('keydown', (event) => {
        if ((event.metaKey || event.ctrlKey) && event.key === 'k') {
          event.preventDefault();
          open();
        }
      });
      dialog?.addEventListener('click', (event) => {
        if (event.target === dialog) {
          const rect = dialog.getBoundingClientRect();
          if (
            event.clientX < rect.left ||
            event.clientX > rect.right ||
            event.clientY < rect.top ||
            event.clientY > rect.bottom
          )
            dialog.close();
        }
      });
      input?.addEventListener('input', () => {
        clearTimeout(timer);
        const request = ++sequence;
        timer = setTimeout(async () => {
          if (!results) return;
          const query = input.value.trim();
          if (!query) {
            results.textContent = messages.searchEmpty;
            return;
          }
          results.textContent = messages.searching;
          try {
            const bundlePath = '/pagefind/pagefind.js';
            pagefindPromise ??= import(/* @vite-ignore */ bundlePath);
            const pagefind = await pagefindPromise;
            const response = await pagefind.search(query, {
              filters: { version: 'current' },
            });
            const entries = await Promise.all(
              response.results.slice(0, 30).map((entry: any) => entry.data()),
            );
            if (request !== sequence) return;
            results.replaceChildren();
            for (const entry of entries
              .filter((entry: any) => entry.url.startsWith(`/${locale}/`))
              .slice(0, 8)) {
              const link = document.createElement('a');
              link.href = entry.url;
              link.textContent = entry.meta.title;
              results.append(link);
            }
            if (!results.children.length)
              results.textContent = messages.searchNoResults;
          } catch {
            if (request === sequence)
              results.textContent = messages.searchUnavailable;
            pagefindPromise = undefined;
          }
        }, 180);
      });
    </script>
  </body>
</html>
