---
import Website from '../../layouts/Website.astro';
import Playground from '../../components/Playground.astro';
import { locales, type Locale } from '../../i18n/locales';
import { playgroundMessages } from '../../playground/messages';
export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Locale;
const { page } = playgroundMessages(lang);
---

<Website locale={lang} title={page.metaTitle} description={page.description}>
  <Playground locale={lang} />
</Website>
