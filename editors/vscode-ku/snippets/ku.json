{
  "fn main": {
    "prefix": "main",
    "body": ["fn main() {", "    $0", "}"],
    "description": "Ku main function"
  },
  "async fn main": {
    "prefix": "amain",
    "body": ["async fn main(): null! {", "    $0", "    return ok(null)", "}"],
    "description": "Ku async main function"
  },
  "async function": {
    "prefix": "afn",
    "body": ["async fn ${1:name}(${2:arg}:${3:int}): ${4:int}! {", "    return ok(${5:${2:arg}})", "}"],
    "description": "Ku async function returning Result"
  },
  "await task": {
    "prefix": "await",
    "body": ["${1:value} = await ${2:task}?"],
    "description": "Await a one-use async fn task and propagate its Result error"
  },
  "function": {
    "prefix": "fn",
    "body": ["fn ${1:name}(${2:arg}:${3:int})${4:: int} {", "    $0", "}"],
    "description": "Ku function"
  },
  "typed arrow function": {
    "prefix": "arrow",
    "body": ["${1:add} = (${2:a}:int, ${3:b}:int): int => ${2:a} + ${3:b}"],
    "description": "Typed first-class arrow function"
  },
  "strict object index": {
    "prefix": "obj.index",
    "body": ["${1:value} = ${2:object}[${3:\"key\"}]"],
    "description": "Strict object lookup; missing keys are errors"
  },
  "optional object index": {
    "prefix": "obj.index?",
    "body": ["${1:value} = ${2:object}[${3:\"key\"}]?"],
    "description": "Optional object lookup; missing keys return null"
  },
  "object destructuring": {
    "prefix": "obj.destructure",
    "body": ["{ ${1:name}, ${2:field}: ${3:local}, ${4:missing} = ${5:null}, ...${6:rest} } = ${7:object}"],
    "description": "Destructure object fields with rename, default, and rest"
  },
  "generic function": {
    "prefix": "fng",
    "body": ["fn ${1:id}<${2:T}>(${3:value}:${2:T}): ${2:T} {", "    return ${3:value}", "}"],
    "description": "Ku generic function"
  },
  "struct": {
    "prefix": "struct",
    "body": ["struct ${1:Name} {", "    ${2:field}: ${3:str}", "}"],
    "description": "Ku struct"
  },
  "enum": {
    "prefix": "enum",
    "body": ["enum ${1:Result} {", "    ${2:Ok}(value: ${3:int})", "    ${4:Err}(message: str)", "}"],
    "description": "Ku enum"
  },
  "match": {
    "prefix": "match",
    "body": ["match ${1:value} {", "    ${2:_} => ${3:null}", "}"],
    "description": "Ku match expression"
  },
  "try catch finally": {
    "prefix": "try",
    "body": ["try {", "    ${1:value} = ${2:work}()?", "} catch (${3:err}) {", "    $0", "} finally {", "    ${4:println(\"done\")}", "}"],
    "description": "Ku try/catch/finally"
  },
  "catch error message": {
    "prefix": "err.message",
    "body": ["${1:message} = ${2:err}.message"],
    "description": "Use structured Ku Error message"
  },
  "import std.fs": {
    "prefix": "std.fs",
    "body": ["import \"std.fs\""],
    "description": "Import std.fs"
  },
  "import std.http": {
    "prefix": "std.http",
    "body": ["import \"std.http\""],
    "description": "Import std.http"
  },
  "import std modules": {
    "prefix": "std",
    "body": ["import { ${1:fs}, ${2:http} } from \"std\""],
    "description": "Import multiple standard library modules"
  },
  "import std.config": {
    "prefix": "std.config",
    "body": ["import \"std.config\""],
    "description": "Import std.config"
  },
  "import std.task": {
    "prefix": "std.task",
    "body": ["import \"std.task\""],
    "description": "Import std.task diagnostics"
  },
  "task stress": {
    "prefix": "task.stress",
    "body": [
      "started = time.millis()",
      "report = task.stress(${1:1000000}, ${2:15}, ${3:250})",
      "finished = time.millis()",
      "println(`耗时(ms): {finished - started}`)",
      "println(`峰值 active: {report.peak_active}`)"
    ],
    "description": "Run bounded runtime task demand stress test"
  },
  "http get": {
    "prefix": "http.get",
    "body": ["res = http.get(${1:\"https://example.com\"})?", "println(res.status)", "println(res.body)"],
    "description": "HTTP GET response"
  },
  "http client": {
    "prefix": "http.client",
    "body": ["client = http.client({ timeout_ms: ${1:5000}, max_body_bytes: ${2:1000000}, max_idle_connections: ${3:128} })"],
    "description": "HTTP client config"
  },
  "http response text": {
    "prefix": "http.text",
    "body": ["return http.text(${1:\"ok\"})"],
    "description": "HTTP text response helper"
  },
  "http response json": {
    "prefix": "http.json",
    "body": ["return http.json(${1:http.status.ok}, { ${2:code}: 0, ${3:msg}: \"ok\", ${4:data}: null })"],
    "description": "HTTP JSON response helper"
  },
  "http empty response": {
    "prefix": "http.empty",
    "body": ["return http.empty(${1:http.status.noContent})"],
    "description": "HTTP empty response helper"
  },
  "http status text": {
    "prefix": "http.statusText",
    "body": ["${1:text} = http.statusText(${2:http.status.notFound})"],
    "description": "HTTP status reason phrase"
  },
  "http service": {
    "prefix": "http.service",
    "body": [
      "service = http.service()",
      "println(service.max_active_requests)",
      "println(service.max_pending_requests)",
      "println(service.max_body_bytes)"
    ],
    "description": "HTTP service default limits"
  },
  "http server app": {
    "prefix": "http.server",
    "body": [
      "import { http } from \"std\"",
      "",
      "fn health() {",
      "    return http.text(\"ok\")",
      "}",
      "",
      "fn index() {",
      "    return http.text(\"Ku HTTP 123\")",
      "}",
      "",
      "fn main(): null! {",
      "    app = http.service()",
      "",
      "    app.get(\"/\", health)",
      "    app.get(\"/index\", index)",
      "    app.get(\"/json\", fn(req) {",
      "        return http.json({",
      "            code: 0,",
      "            msg: \"ok\",",
      "            data: { path: req.path.clone() }",
      "        })",
      "    })",
      "",
      "    println(\"Ku HTTP server listening on http://127.0.0.1:8080\")",
      "    app.listen(\"127.0.0.1:8080\")?",
      "    return ok(null)",
      "}"
    ],
    "description": "Runnable Ku HTTP server"
  },
  "array map": {
    "prefix": "map",
    "body": ["${1:result} = ${2:nums}.map(${3:x} => ${3:x} * 2)"],
    "description": "Array map"
  },
  "string method": {
    "prefix": "str.trim",
    "body": ["${1:text}.trim()"],
    "description": "String instance method"
  },
  "array try_get": {
    "prefix": "try_get",
    "body": ["${1:value} = ${2:values}.try_get(${3:0})?"],
    "description": "Array safe index with Result"
  },
  "array concat": {
    "prefix": "array.concat",
    "body": ["${1:combined} = ${2:left}.concat(${3:right})"],
    "description": "Return a new array; both inputs remain readable"
  },
  "array nullable first": {
    "prefix": "array.first",
    "body": ["${1:first} = ${2:values}.first()", "if (${1:first} != null) {", "    $0", "}"],
    "description": "First returns an element or null, not Result"
  },
  "nullable member": {
    "prefix": "optional.member",
    "body": ["${1:value} = (${2:reply}?.${3:meta}?.${4:title}).clone()"],
    "description": "Copy an optional member projection through nullable values without moving from its owner"
  },
  "time date": {
    "prefix": "time.date",
    "body": ["${1:today} = time.date()", "println(${1:today}.year)", "println(${1:today}.month)", "println(${1:today}.day)"],
    "description": "Local Date fields; zero-argument time.date is not Result"
  },
  "time duration": {
    "prefix": "time.duration",
    "body": ["${1:pause} = time.duration(${2:250}, \"${3:ms}\")?", "time.sleep(${1:pause})?"],
    "description": "Construct a bounded nonnegative Duration and sleep; use in Result-returning code"
  },
  "async HTTP handler": {
    "prefix": "http.async",
    "body": ["async fn ${1:handle}(req: HttpRequest): HttpResponse! {", "    ${2:body} = req.body.clone()", "    return ok(http.text(${2:body}))", "}", "${3:app}.post(\"${4:/echo}\", ${1:handle})"],
    "description": "Register an async Result-returning handler on an existing HTTP service"
  },
  "ordinary PG query": {
    "prefix": "pg.query",
    "body": ["${1:rows} = ${2:client}.query(\"SELECT \\$1::text AS value\", [${3:\"value\"}])?", "${4:value} = ${1:rows}.value(0, 0)?"],
    "description": "Parameterized query on an existing pooled PG client; also usable inside async fn"
  },
  "typed PG single row": {
    "prefix": "pg.query_one_typed",
    "body": ["${1:row} = ${2:client}.query_one_typed(", "    \"SELECT \\$1::int4 AS id, \\$2::bool AS enabled\",", "    [${3:17}, ${4:true}],", "    [\"int4\", \"bool\"],", "    [\"int4\", \"bool\"]", ")?", "${5:id} = ${1:row}.value_int(0, 0)?", "${6:enabled} = ${1:row}.value_bool(0, 1)?"],
    "description": "Exactly one typed PG row; explicit parameter/result schemas, no implicit retry"
  },
  "bounded native compression": {
    "prefix": "zstd.compress",
    "body": ["${1:compressed} = ${2:zstd}.compress(${3:data}, ${4:4096})?"],
    "description": "Compress bytes with an explicit max_output_bytes limit; also available in gzip/deflate"
  }
}
