{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Ku",
  "scopeName": "source.ku",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#functions" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#operators" },
    { "include": "#constants" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        { "name": "comment.line.double-slash.ku", "match": "//.*$" },
        { "name": "comment.block.ku", "begin": "/\\*", "end": "\\*/" }
      ]
    },
    "strings": {
      "patterns": [
        { "name": "string.quoted.double.ku", "begin": "\"", "end": "\"", "patterns": [{ "name": "constant.character.escape.ku", "match": "\\\\." }] },
        { "name": "string.quoted.single.ku", "begin": "'", "end": "'", "patterns": [{ "name": "constant.character.escape.ku", "match": "\\\\." }] },
        { "name": "string.template.ku", "begin": "`", "end": "`", "patterns": [{ "name": "constant.character.escape.ku", "match": "\\\\." }, { "name": "meta.interpolation.ku", "begin": "\\{", "end": "\\}" }] }
      ]
    },
    "numbers": {
      "patterns": [
        { "name": "constant.numeric.float.ku", "match": "\\b[0-9]+\\.[0-9]+\\b" },
        { "name": "constant.numeric.integer.ku", "match": "\\b[0-9]+\\b" }
      ]
    },
    "keywords": {
      "patterns": [
        { "name": "keyword.control.ku", "match": "\\b(async|await|fn|struct|enum|module|import|from|if|else|while|for|in|break|continue|match|try|catch|finally|fail|panic|return|print)\\b" },
        { "name": "invalid.deprecated.ku", "match": "\\b(let|mut|const)\\b" }
      ]
    },
    "types": {
      "patterns": [
        { "name": "storage.type.ku", "match": "\\b(int|float|bool|str|null|Task|Result|Error|HttpRequest|HttpResponse)\\b" }
      ]
    },
    "operators": {
      "patterns": [
        { "name": "keyword.operator.optional.ku", "match": "\\?\\.|\\?(?!\\.)" },
        { "name": "keyword.operator.rest.ku", "match": "\\.\\.\\." },
        { "name": "keyword.operator.result.ku", "match": "!(?!=)" },
        { "name": "keyword.operator.arrow.ku", "match": "=>" },
        { "name": "keyword.operator.union.ku", "match": "(?<!\\|)\\|(?!\\|)" }
      ]
    },
    "functions": {
      "patterns": [
        { "match": "\\b(fn)\\s+([A-Za-z_][A-Za-z0-9_]*)", "captures": { "1": { "name": "storage.type.function.ku" }, "2": { "name": "entity.name.function.ku" } } },
        { "match": "\\b(struct|enum)\\s+([A-Za-z_][A-Za-z0-9_]*)", "captures": { "1": { "name": "storage.type.ku" }, "2": { "name": "entity.name.type.ku" } } },
        { "name": "support.function.builtin.ku", "match": "\\b(len|str|ok|err|println)\\b(?=\\s*\\()" },
        { "name": "support.function.stdlib.ku", "match": "\\b(string|array|object|json|time|lexer|parser|fs|http|config|task|pg|redis|mysql|bytes|net|zstd|gzip|deflate)\\.[A-Za-z_][A-Za-z0-9_]*\\b" }
      ]
    },
    "constants": {
      "patterns": [
        { "name": "constant.language.ku", "match": "\\b(true|false|null)\\b" }
      ]
    }
  }
}
